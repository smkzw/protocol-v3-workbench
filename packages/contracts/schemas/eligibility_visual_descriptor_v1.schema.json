{
  "$defs": {
    "EligibilityVlmCaptureQuality": {
      "additionalProperties": false,
      "properties": {
        "flags": {
          "items": {
            "$ref": "#/$defs/EligibilityVlmCaptureQualityFlag"
          },
          "title": "Flags",
          "type": "array"
        },
        "overall": {
          "$ref": "#/$defs/EligibilityVlmCaptureQualityOverall"
        }
      },
      "required": [
        "overall",
        "flags"
      ],
      "title": "EligibilityVlmCaptureQuality",
      "type": "object"
    },
    "EligibilityVlmCaptureQualityFlag": {
      "enum": [
        "none",
        "blur",
        "glare",
        "underexposed",
        "overexposed",
        "low_resolution",
        "partial_crop",
        "obstruction",
        "perspective_distortion",
        "compression_artifact",
        "orientation_uncertain",
        "text_too_small"
      ],
      "title": "EligibilityVlmCaptureQualityFlag",
      "type": "string"
    },
    "EligibilityVlmCaptureQualityOverall": {
      "enum": [
        "adequate_for_human_qc",
        "limited",
        "unusable"
      ],
      "title": "EligibilityVlmCaptureQualityOverall",
      "type": "string"
    },
    "EligibilityVlmDocumentType": {
      "enum": [
        "not_applicable",
        "medical_record",
        "laboratory_report",
        "prescription_or_medication_record",
        "imaging_report",
        "consent_or_signature_page",
        "identity_or_administrative_page",
