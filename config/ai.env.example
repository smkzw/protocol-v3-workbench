# Product AI provider/model selection is persisted by the system-wide AI
# selector. The launcher does not pin a supplier or require an unused key.
WORKBENCH_AI_DEPLOYMENT_PROFILE=local_private_clinical
WORKBENCH_AI_TIMEOUT_SECONDS=300

# Provider credentials are stored by the selector or injected through that
# profile's api_key_env. Do not copy Hermes configuration into product runtime.
