{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-3-1-2-2:v2\",\n  \"node_id\": \"v2_n_3_1_2_2\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"blocks\": [\n    {\n      \"block_id\": \"p_v2_n_3_1_2_2_001\",\n      \"kind\": \"paragraph\",\n      \"text\": \"研究变量（估计目标属性二）\",\n      \"evidence_refs\": []\n    },\n    {\n      \"block_id\": \"p_v2_n_3_1_2_2_002\",\n      \"kind\": \"paragraph\",\n      \"text\": \"主要估计目标的研究变量为：从基线至第12周FVC%predicted（FVC%predicted=用力肺活量占预计值百分比；FVC=用力肺活量）的绝对变化（百分点）。研究变量不应仅以“疗效”等标签表示，也不应仅以统计方法名称代替；应同时覆盖测量、聚合与时间点/时间窗三类要素。\",\n      \"evidence_refs\": []\n    },\n    {\n      \"block_id\": \"tbl_v2_n_3_1_2_2_001\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [],\n      \"table\": {\n        \"table_id\": \"table:v2-n-3-1-2-2:variable-attributes\",\n        \"block_id\": \"tbl_v2_n_3_1_2_2_001\",\n        \"title\": \"研究变量属性表\",\n        \"domain\": \"objectives_endpoints\",\n        \"role\": \"body_content\",\n        \"header_row_count\": 1,\n        \"review_state\": \"ai_draft\",\n        \"schema_version\": \"structured_table_v1\",\n        \"columns\": [\n          {\n            \"column_id\": \"variable:col:element\",\n            \"order\": 0,\n            \"label\": \"属性要素\",\n            \"semantic_role\": \"attribute_element\",\n            \"style_role\": \"header\"\n          },\n          {\n            \"column_id\": \"variable:col:specification\",\n            \"order\": 1,\n            \"label\": \"方案规定/待确认信息\",\n            \"semantic_role\": \"specification\",\n            \"style_role\": \"body\"\n          },\n          {\n            \"column_id\": \"variable:col:check\",\n            \"order\": 2,\n            \"label\": \"核对要点\",\n            \"semantic_role\": \"verification\",\n            \"style_role\": \"body\"\n          }\n        ],\n        \"rows\": [\n          {\n            \"row_id\": \"variable:row:variable\",\n            \"order\": 0,\n            \"label\": \"研究变量\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"variable:cell:element:variable\",\n                \"row_id\": \"variable:row:variable\",\n                \"column_id\": \"variable:col:element\",\n                \"text\": \"研究变量\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"variable:cell:variable\",\n                \"row_id\": \"variable:row:variable\",\n                \"column_id\": \"variable:col:specification\",\n                \"text\": \"从基线至第12周FVC%predicted（FVC%predicted=用力肺活量占预计值百分比；FVC=用力肺活量）的绝对变化（百分点）。\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"variable:cell:check:variable\",\n                \"row_id\": \"variable:row:variable\",\n                \"column_id\": \"variable:col:check\",\n                \"text\": \"已确认；用于与“疗效”标签区分。\",\n                \"style_role\": \"body\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"variable:row:measurement\",\n            \"order\": 1,\n            \"label\": \"测量\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"variable:cell:element:measurement\",\n                \"row_id\": \"variable:row:measurement\",\n                \"column_id\": \"variable:col:element\",\n                \"text\": \"测量\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"variable:cell:measurement\",\n                \"row_id\": \"variable:row:measurement\",\n                \"column_id\": \"variable:col:specification\",\n                \"text\": \"【待补充：主要研究变量的具体测量方式：该项待研究团队确认后补充】\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"variable:cell:check:measurement\",\n                \"row_id\": \"variable:row:measurement\",\n                \"column_id\": \"variable:col:check\",\n                \"text\": \"必须给出如何测量；只给变量标签或统计方法名不满足要求。\",\n                \"style_role\": \"body\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"variable:row:aggregation\",\n            \"order\": 2,\n            \"label\": \"聚合\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"variable:cell:element:aggregation\",\n                \"row_id\": \"variable:row:aggregation\",\n                \"column_id\": \"variable:col:element\",\n                \"text\": \"聚合\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"variable:cell:aggregation\",\n                \"row_id\": \"variable:row:aggregation\",\n                \"column_id\": \"variable:col:specification\",\n                \"text\": \"【待补充：主要研究变量的绝对变化如何聚合到个体层：该项待研究团队确认后补充】\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"variable:cell:check:aggregation\",\n                \"row_id\": \"variable:row:aggregation\",\n                \"column_id\": \"variable:col:check\",\n                \"text\": \"必须给出如何汇总到个体层；只给变量标签或统计方法名不满足要求。\",\n                \"style_role\": \"body\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"variable:row:timepoint\",\n            \"order\": 3,\n            \"label\": \"时间点/时间窗\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"variable:cell:element:timepoint\",\n                \"row_id\": \"variable:row:timepoint\",\n                \"column_id\": \"variable:col:element\",\n                \"text\": \"时间点/时间窗\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"variable:cell:timepoint\",\n                \"row_id\": \"variable:row:timepoint\",\n                \"column_id\": \"variable:col:specification\",\n                \"text\": \"研究变量表述包含从基线至第12周；【待补充：完整的时间点/时间窗定义：该项待研究团队确认后补充】。\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"variable:cell:check:timepoint\",\n                \"row_id\": \"variable:row:timepoint\",\n                \"column_id\": \"variable:col:check\",\n                \"text\": \"必须给出何时评价及时间窗；只给变量标签或统计方法名不满足要求。\",\n                \"style_role\": \"body\"\n              }\n            ]\n          }\n        ],\n        \"notes\": [],\n        \"source_locator\": \"\",\n        \"version\": 0,\n        \"word_layout\": {}\n      }\n    },\n    {\n      \"block_id\": \"p_v2_n_3_1_2_2_003\",\n      \"kind\": \"paragraph\",\n      \"text\": \"仅写“研究变量：疗效”不能满足本节属性要求；仅写统计方法名称亦不能替代研究变量属性。测量、聚合与时间点/时间窗三项中尚未确认的内容应按上表显式标注，并在研究团队确认后补充。\",\n      \"evidence_refs\": []\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"c94470d9f1abe1dd6bc98d4bae83993624c04e2dcf89f8022c953eecdbb1efaa"}],"logical_call_id":"call:chapter-draft:2039b5b3793f10c8ca0ba2f19e91dc4752628e7fc93f2c6b358a8fa4166e63aa:chapter-generate","node_execution_contract_id":"nec:chapter-draft:2039b5b3793f10c8ca0ba2f19e91dc4752628e7fc93f2c6b358a8fa4166e63aa:chapter-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/ordered-chapter-draft-candidate.v1.json","output_sha256":"15fe2c48f139438fa272e32273dfada19b8e2ca01a71120009c04e6252ddb8a6","prompt_sha256":"5322c0235bbedc2213b004747cbd757992154e907fd360b9bf7be0e09db8863e","provider_session_id":"99b3e677-0237-49fb-9d49-7ae30ce5b44f","requested_reasoning_effort":"max"},"schema":"model_response.v1"}