{"content":"{\n  \"coverage\": [\n    {\n      \"field\": \"anticipated_dose\",\n      \"index\": 0,\n      \"destination\": \"regimen.schedule.experimental_k.cycle_28d.step.k_day1\",\n      \"relation\": \"component\",\n      \"reason\": \"合成药K起始剂量5 mg/kg、Q4W第1天静脉输注约2小时且不设负荷剂量，已作为试验臂基础给药步骤。\"\n    },\n    {\n      \"field\": \"anticipated_dose\",\n      \"index\": 1,\n      \"destination\": \"regimen.dose_adjustment.k\",\n      \"relation\": \"refinement\",\n      \"reason\": \"4 mg/kg与3 mg/kg为≥3级毒性恢复后的逐级下调剂量，最低3 mg/kg且不可再上调；不是与5 mg/kg互斥的起始方案。\"\n    },\n    {\n      \"field\": \"anticipated_dose\",\n      \"index\": 2,\n      \"destination\": \"study.treatment_discontinuation.k\",\n      \"relation\": \"refinement\",\n      \"reason\": \"统一永久终止规则按第13条表述登记为合成药K治疗终止条件。\"\n    },\n    {\n      \"field\": \"anticipated_dose\",\n      \"index\": 3,\n      \"destination\": \"regimen.schedule.control_rd.cycle_28d.step.rd\",\n      \"relation\": \"component\",\n      \"reason\": \"对照臂Rd起始剂量与日程：来那度胺25 mg第1-21天，地塞米松40 mg第1、8、15、22天，每28天周期。\"\n    },\n    {\n      \"field\": \"anticipated_dose\",\n      \"index\": 4,\n      \"destination\": \"regimen.dose_adjustment.lenalidomide.hematologic\",\n      \"relation\": \"refinement\",\n      \"reason\": \"来那度胺血液学毒性暂停后依次恢复/下调至15、10、5 mg qd；为条件性剂量调整层级，非互斥起始方案。\"\n    },\n    {\n      \"field\": \"anticipated_dose\",\n      \"index\": 5,\n      \"destination\": \"regimen.dose_adjustment.lenalidomide.renal\",\n      \"relation\": \"refinement\",\n      \"reason\": \"按肌酐清除率调整来那度胺剂量，属条件性肾功能剂量细化。\"\n    },\n    {\n      \"field\": \"anticipated_dose\",\n      \"index\": 6,\n      \"destination\": \"regimen.dose_adjustment.dexamethasone\",\n      \"relation\": \"refinement\",\n      \"reason\": \"地塞米松40 mg可减至20 mg、再减至10 mg，为条件性减量层级。\"\n    },\n    {\n      \"field\": \"clinical_phase\",\n      \"index\": 0,\n      \"destination\": \"study.phase\",\n      \"relation\": \"context\",\n      \"reason\": \"II期临床研究为研究期别，不进入给药步骤。\"\n    },\n    {\n      \"field\": \"comparator\",\n      \"index\": 0,\n      \"destination\": \"study.design\",\n      \"relation\": \"context\",\n      \"reason\": \"随机、双盲、阳性对照为标准研究设计属性。\"\n    },\n    {\n      \"field\": \"comparator\",\n      \"index\": 1,\n      \"destination\": \"study.design.superiority\",\n      \"relation\": \"context\",\n      \"reason\": \"优效性设计及ORR主比较属研究设计/终点，不塞入给药方案。\"\n    },\n    {\n      \"field\": \"comparator\",\n      \"index\": 2,\n      \"destination\": \"regimen.schedule.control_rd.cycle_28d.step.rd\",\n      \"relation\": \"duplicate\",\n      \"reason\": \"与anticipated_dose[3]的Rd剂量日程重复，指向同一对照臂给药步骤。\"\n    },\n    {\n      \"field\": \"comparator\",\n      \"index\": 3,\n      \"destination\": \"regimen.arm.control_rd\",\n      \"relation\": \"component\",\n      \"reason\": \"对照臂组成明确为合成药K匹配静脉输注安慰剂加活性Rd；活性Rd已入schedule，安慰剂参数见待决问题。\"\n    },\n    {\n      \"field\": \"comparator\",\n      \"index\": 4,\n      \"destination\": \"study.design.double_dummy\",\n      \"relation\": \"context\",\n      \"reason\": \"双模拟设计为盲态设计属性。\"\n    },\n    {\n      \"field\": \"comparator\",\n      \"index\": 5,\n      \"destination\": \"study.treatment_duration.rd\",\n      \"relation\": \"context\",\n      \"reason\": \"Rd持续至PD或不可耐受毒性及允许按说明书调整，属对照臂治疗持续时间/调整原则。\"\n    },\n    {\n      \"field\": \"comparator\",\n      \"index\": 6,\n      \"destination\": \"study.blinding.placebo_allocation\",\n      \"relation\": \"context\",\n      \"reason\": \"合成药K与匹配静脉输注安慰剂按1:1使用，属盲态分配设计。\"\n    },\n    {\n      \"field\": \"comparator\",\n      \"index\": 7,\n      \"destination\": \"study.randomization.ratio\",\n      \"relation\": \"context\",\n      \"reason\": \"随机化比例1:1属研究随机化设计，不进入给药步骤。\"\n    },\n    {\n      \"field\": \"dosage_form_and_route\",\n      \"index\": 0,\n      \"destination\": \"regimen.schedule.experimental_k.cycle_28d.step.k_day1.route\",\n      \"relation\": \"component\",\n      \"reason\": \"合成药K静脉输注途径已作为试验臂给药步骤的route。\"\n    },\n    {\n      \