ion\": \"regimen.schedules[synthetic_k].steps[0].route\",\n      \"relation\": \"component\",\n      \"reason\": \"合成药K给药途径为静脉输注，写入K步骤route。\"\n    },\n    {\n      \"field\": \"dosage_form_and_route\",\n      \"index\": 1,\n      \"destination\": \"regimen.schedules[synthetic_k].steps[0].products[0].volume + steps[0].timing\",\n      \"relation\": \"refinement\",\n      \"reason\": \"最终体积250 mL写入产品volume；0.9%氯化钠稀释、室温4小时内输注以及4/3 mg/kg同样250 mL保留在步骤timing，未换算。\"\n    },\n    {\n      \"field\": \"dosage_form_and_route\",\n      \"index\": 2,\n      \"destination\": \"regimen.schedules[synthetic_k].steps[0].frequency/timing\",\n      \"relation\": \"refinement\",\n      \"reason\": \"每次输注约2小时写入K步骤frequency/timing。\"\n    },\n    {\n      \"field\": \"dosage_form_and_route\",\n      \"index\": 3,\n      \"destination\": \"regimen.schedules[synthetic_k].steps[0].timing\",\n      \"relation\": \"refinement\",\n      \"reason\": \"下调至4或3 mg/kg仍约2小时并调整输注速率写入K步骤timing。\"\n    },\n    {\n      \"field\": \"indication\",\n      \"index\": 0,\n      \"destination\": \"study_context.indication\",\n      \"relation\": \"context\",\n      \"reason\": \"多发性骨髓瘤为适应症背景，不写入给药步骤；confirmed_study确认。\"\n    },\n    {\n      \"field\": \"populations\",\n      \"index\": 0,\n      \"destination\": \"study_context.population\",\n      \"relation\": \"context\",\n      \"reason\": \"既往至少一线系统治疗为入组人群条件，不进入给药方案。\"\n    },\n    {\n      \"field\": \"populations\",\n      \"index\": 1,\n      \"destination\": \"study_context.population\",\n      \"relation\": \"context\",\n      \"reason\": \"来那度胺敏感为总体入组条件并适用于试验/对照臂；作为人群背景，不进入给药步骤。\"\n    },\n    {\n      \"field\": \"populations\",\n      \"index\": 2,\n      \"destination\": \"study_context.randomization_stratification\",\n      \"relation\": \"context\",\n      \"reason\": \"既往治疗线数和ISS分期为分层因素，不塞进给药方案。\"\n    },\n    {\n      \"field\": \"research_drug\",\n      \"index\": 0,\n      \"destination\": \"regimen.schedules[synthetic_k].steps[0].produ