{"content":"{\n  \"status\": \"needs_information\",\n  \"objectives\": {\n    \"primary\": [\n      {\n        \"text\": \"评估U2 6 mg每日一次和U2 12 mg每日一次相对于安慰剂在第52周达到SRI-4应答的优效性。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"基于用户简报中52周治疗期、主要终点为第52周SRI-4应答率以及两个U2剂量组与安慰剂对照的设计，推荐将两个U2剂量组分别与安慰剂比较作为主要目标；具体主次比较顺序和多重性策略由下游人审确认。\",\n        \"references\": []\n      }\n    ],\n    \"secondary\": [\n      {\n        \"text\": \"评估U2对第52周BICLA应答率的影响。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"BICLA是SLE试验中常用的补充复合终点，可与SRI-4共同表征多器官疾病活动改善；本推荐以SRI-4为主要终点为前提。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"评估U2对第52周SLEDAI-2K自基线变化的影响。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"SLEDAI-2K是SLE疾病活动度的核心指标，适合作为关键次要终点支持主要终点结果。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"评估U2对第52周PGA自基线变化的影响。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"PGA是SLE应答指数和临床重要改善的组成部分，推荐作为疾病活动度的次要终点。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"评估U2对第52周糖皮质激素剂量较基线降低的受试者比例的影响。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"SLE试验中激素减量是重要的临床获益维度，推荐作为次要终点以评估U2的激素节省效应。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"评估U2的安全性和耐受性，包括AE、SAE、感染、实验室异常、生命体征和ECG参数。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"II期试验必须评估试验药物的安全性特征，为后续研究提供依据。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"评估U2的暴露-效应关系（如数据允许）。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"TYK2抑制剂II期剂量选择可受益于暴露-效应分析；该终点取决于稀疏PK采样可行性。\",\n        \"references\": []\n      }\n    ],\n    \"questions\": []\n  },\n  \"endpoint\": {\n    \"primary_endpoint\": {\n      \"text\": \"第52周SRI-4应答率。SRI-4应答定义为：SLEDAI-2K较基线降低≥4分；无新的BILAG A或2个以上BILAG B器官系统受累；PGA较基线增加≤0.3分；且未使用方案禁用的救援治疗。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"用户简报明确主要终点为第52周SRI-4应答率；SRI-4的具体组成采用SLE试验常用定义，推荐在方案中固定并与统计分析计划一致。\",\n      \"references\": []\n    },\n    \"key_secondary\": [\n      {\n        \"text\": \"第52周BICLA应答率。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"BICLA可补充评估多器官系统改善，且与SRI-4互补，推荐作为关键次要终点。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"第52周SLEDAI-2K自基线变化。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"SLEDAI-2K是SLE疾病活动度的标准指标，推荐作为关键次要终点。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"第52周PGA自基线变化。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"PGA是SLE应答指数和临床重要改善的组成部分，推荐作为关键次要终点。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"第52周糖皮质激素剂量较基线降低≥25%且泼尼松≤7.5 mg/日的受试者比例。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"激素减量是SLE的重要临床获益，推荐作为关键次要终点；具体阈值可在方案定稿时调整。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"第52周安全性指标：AE、SAE、感染和实验室异常的发生率。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"安全性是II期试验的必要评估内容，推荐作为关键次要终点。\",\n        \"references\": []\n      }\n    ],\n    \"measurement_details\": \"SRI-4在第52周访视时评估；SLEDAI-2K、BILAG 2004和PGA由经培训且盲态的研究者或独立评估者评估。缺失数据、提前停用研究药物和使用救援治疗按estimand中规定的ICE策略处理。\",\n    \"questions\": []\n  },\n  \"estimand\": {\n    \"treatment\": {\n      \"text\": \"U2 6 mg每日一次（1片U2 6 mg片剂+1片安慰剂）、U2 12 mg每日一次（2片U2 6 mg片剂）或安慰剂每日一次（2片安慰剂），联合稳定的背景标准治疗，包括稳定剂量的RAS抑制剂（按受试者实际处方）。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"基于用户简报中给药方案和背景治疗描述，推荐将背景标准治疗作为共同允许治疗，不作为试验干预给药步骤。\",\n      \"references\": []\n    },\n    \"population\": {\n      \"text\": \"18至75岁、符合2019年EULAR/ACR SLE分类标准、基线SLEDAI-2K≥6且临床SLEDAI-2K≥4的活动性SLE成人患者。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"用户简报明确研究人群和活动性定义，推荐作为主要estimand的目标人群。\",\n      \"references\": []\n    },\n    \"variable\": {\n      \"text\": \"第52周SRI-4应答（二元变量：是/否）。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"与主要终点一致，推荐将第52周SRI-4应答作为主要estimand的变量。\",\n      \"references\": []\n    },\n    \"ice_events\": [\n      \"提前停用研究药物\",\n      \"使用方案禁用的救援治疗或新增免疫抑制剂\",\n      \"死亡\",\n      \"失访或第52周SRI-4评估缺失\"\n    ],\n    \"ice_strategy\": {\n      \"text\": \"对提前停用研究药物采用治疗政策策略，继续随访并纳入主要分析；对使用禁用救援治疗或新增免疫抑制剂采用复合策略，视为SRI-4无应答；死亡视为无应答；失访或第52周评估缺失按治疗政策策略处理，并用非应答插补进行敏感性分析。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"在缺乏申办方指定ICE策略时，推荐兼顾治疗政策效应和临床可解释性的常用策略；该策略需在方案和统计分析计划中预先规定并经人审确认。\",\n      \"references\": []\n    },\n    \"summary_measure\": {\n      \"text\": \"U2各剂量组与安慰剂组第52周SRI-4应答率差值（U2组－安慰剂组），附95%置信区间和双侧p值；主要分析采用logistic回归或CMH检验，调整随机分层因素。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"二分类主要终点通常以率差和回归调整估计治疗效应，推荐作为主要summary measure。\",\n      \"references\": []\n    },\n    \"questions\": []\n  },\n  \"sample_size\": {\n    \"assumptions\": [\n      \"设计：随机、双盲、安慰剂对照，1:1:1，约360例（每组约120例）。\",\n      \"主要终点：第52周SRI-4应答率。\",\n      \"预期应答率：安慰剂组40%，U2 6 mg组62%，U2 12 mg组67%。\",\n      \"检验水准：双侧α=0.05；两个U2剂量组分别与安慰剂比较，采用Hochberg法控制总体I类错误。\",\n      \"把握度：至少90%。\",\n      \"失访/中断率：10%。\",\n      \"分析模型：logistic回归或CMH检验，调整随机分层因素。\"\n    ],\n    \"alpha\": \"双侧α=0.05（采用Hochberg法控制两个U2剂量组与安慰剂比较的总体I类错误）\",\n    \"power\": \"90%\",\n    \"model\": \"主要分析采用logistic回归或CMH检验，调整随机分层因素；样本量按两样本比例比较估算。\",\n    \"planned_n\": \"约360例（1:1:1，每组约120例）\",\n    \"attrition\": \"10%\",\n    \"justification\": \"在安慰剂组第52周SRI-4应答率40%、U2 6 mg组62%、U2 12 mg组67%的假设下，每组120例考虑10%失访后约108例可评价，双侧α=0.05、Hochberg控制FWER时可提供至少90%把握度。该样本量与用户简报的约360例一致。\",\n    \"references\": [],\n    \"questions\": []\n  },\n  \"interim_planning\": null,\n  \"non_inferiority_margin\": null,\n  \"questions\": [],\n  \"unresolved_questions\": [\n    \"设计方案未说明是否计划期中分析。若计划期中分析，请提供信息分数、目的（无效性/优效性/样本量重估等）、决策规则、独立数据监查委员会职责及对最终分析alpha的影响；若不计划，请确认无期中分析。\"\n  ]\n}","receipt":{"idempotency_key":"design-elements.generate.v1","input_artifacts":[{"ref":"design-elements-intake","sha256":"7867ba0dd19f8480eff49041deef7ef80115de32672f89b3541d2ab408afbea0"}],"logical_call_id":"call:design-elements:8569974b6739518c