"cells\": [\n              {\n                \"cell_id\": \"cell_field_starting\",\n                \"row_id\": \"row_starting\",\n                \"column_id\": \"col_field\",\n                \"text\": \"起始剂量\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"dose:starting\",\n                \"row_id\": \"row_starting\",\n                \"column_id\": \"col_value\",\n                \"text\": \"【待补充：起始剂量：该项待研究团队确认后补充】\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row_maximum\",\n            \"order\": 5,\n            \"label\": \"最大剂量\",\n            \"style_role\": \"body\",\n            \"source_locator\": \"\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell_field_maximum\",\n                \"row_id\": \"row_maximum\",\n                \"column_id\": \"col_field\",\n                \"text\": \"最大剂量\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"dose:maximum\",\n                \"row_id\": \"row_maximum\",\n                \"column_id\": \"col_value\",\n                \"text\": \"【待补充：最大剂量：该项待研究团队确认后补充】\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          }\n        ],\n        \"schema_version\": \"structured_table_v1\",\n        \"source_locator\": \"\"\n      }\n    },\n    {\n      \"block_id\": \"blk_v2_n_4_3_regimen_detail\",\n      \"kind\": \"paragraph\",\n      \"text\": \"根据已确认的项目事实，U2 6 mg组在52周治疗期内每日1次口服1片U2（6 mg片剂）加1片安慰剂片；U2 12 mg组在52周治疗期内每日1次口服2片U2（6 mg片剂）；安慰剂组在52周治疗期内每日1次口服2片安慰剂片。研究药物给药途径的独立结构化确认【待补充：研究药物给药途径：该项待研究团队确认后补充】；对照药给药途径的独立结构化确认【待补充：对照药给药途径：该项待研究团队确认后补充】；对照药给药方案的项目字段确认【待补充：对照药给药方案：该项待研究团队确认后补充】。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk_v2_n_4_3_rationale_gaps\",\n      \"kind\": \"paragraph\",\n      \"text\": \"剂量方案依据应结合项目主要来源证据说明U2 6 mg与12 mg每日一次给药方案的选择理由，并与对照药方案进行匹配。当前未提供剂量方案依据的项目主要来源证据【待补充：剂量方案依据的项目主要来源证据：该项待研究团队确认后补充】；剂量安全边际的监管或指南依据【待补充：剂量安全边际的监管或指南依据：该项待研究团队确认后补充】；对照药方案匹配证据【待补充：对照药方案匹配证据：该项待研究团队确认后补充】。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk_v2_n_4_3_confirmation_gaps\",\n      \"kind\": \"paragraph\",\n      \"text\": \"起始剂量、最大计划给药量及适用人群联系应以项目确认值为准，不得以药物名称、模板示例或通用默认值替代。起始剂量【待补充：起始剂量：该项待研究团队确认后补充】；最大剂量【待补充：最大剂量：该项待研究团队确认后补充】；适用人群联系（与试验参与者人群的关系）【待补充：适用人群联系（与试验参与者人群的关系）：该项待研究团队确认后补充】。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"23e4825f7ea02ef0b6668af7bb50815d8e311107e769e6d504923d7984b229ef"}],"logical_call_id":"call:chapter-draft:834ad608db73c9a495d938e4eabf522086fee9ad95fe426150e5dd788214551e:chapter-generate","node_execution_contract_id":"nec:chapter-draft:834ad608db73c9a495d938e4eabf522086fee9ad95fe426150e5dd788214551e:chapter-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/ordered-chapter-draft-candidate.v1.json","output_sha256":"b3e076008f13388ff03eed1a17c6884b8cd2bb59be6268801aa08a5ae582d04e","prompt_sha256":"5322c0235bbedc2213b004747cbd757992154e907fd360b9bf7be0e09db8863e","provider_session_id":"3f73f1af-27cb-4e01-bcc8-10dd72b1f3a0","requested_reasoning_effort":"max"},"schema":"model_response.v1"}