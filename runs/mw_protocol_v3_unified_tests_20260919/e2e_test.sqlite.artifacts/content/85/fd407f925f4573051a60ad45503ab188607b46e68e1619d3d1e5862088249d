                \"text\": \"【待补充：合成药K计划最大剂量及其依据：该项待研究团队确认后补充】\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"maximum:control\",\n                \"row_id\": \"row_maximum\",\n                \"column_id\": \"col_control_arm\",\n                \"text\": \"当前计划中来那度胺为25 mg/日、地塞米松为40 mg/给药日；对照药计划最大剂量尚未确认。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"maximum:note\",\n                \"row_id\": \"row_maximum\",\n                \"column_id\": \"col_note\",\n                \"text\": \"当前输入未提供最大剂量字段；不得以模板示例或同药名替代。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row_duration\",\n            \"order\": 4,\n            \"label\": \"周期与持续时间\",\n            \"style_role\": \"body\",\n            \"source_locator\": \"\",\n            \"cells\": [\n              {\n                \"cell_id\": \"duration:item\",\n                \"row_id\": \"row_duration\",\n                \"column_id\": \"col_parameter\",\n                \"text\": \"周期与持续时间\",\n                \"style_role\": \"label\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"duration:test\",\n                \"row_id\": \"row_duration\",\n                \"column_id\": \"col_test_arm\",\n                \"text\": \"每28天为一周期（Q4W）；试验臂最多24个周期，或至PD、不可耐受毒性、撤回知情同意或研究者判断退出。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n       