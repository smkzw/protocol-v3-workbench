{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-3-1-2-2:v2\",\n  \"node_id\": \"v2_n_3_1_2_2\",\n  \"known_evidence_ids\": [],\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"blocks\": [\n    {\n      \"block_id\": \"blk:v2_n_3_1_2_2:p1\",\n      \"kind\": \"paragraph\",\n      \"text\": \"缩写定义如下：IRC=独立评审委员会，CR=完全缓解，PR=部分缓解。研究变量属性应同时给出测量、聚合与时间点/窗口三类要素，仅给出变量标签或统计方法名称不足以描述主要研究变量。本章所述主要研究变量为IRC评估的确认最佳总体疗效为CR或PR的二分类变量。主要变量的测量方式、聚合方式及评价时间点/时间窗尚待研究团队确认，具体见研究变量属性表。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:v2_n_3_1_2_2:t1\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [],\n      \"table\": {\n        \"table_id\": \"tbl:v2_n_3_1_2_2:variable-attributes\",\n        \"block_id\": \"blk:v2_n_3_1_2_2:t1\",\n        \"title\": \"研究变量属性表\",\n        \"domain\": \"objectives_endpoints\",\n        \"role\": \"body_content\",\n        \"header_row_count\": 1,\n        \"columns\": [\n          {\n            \"column_id\": \"col:element\",\n            \"order\": 0,\n            \"label\": \"要素\",\n            \"semantic_role\": \"attribute\",\n            \"style_role\": \"header\"\n          },\n          {\n            \"column_id\": \"col:content\",\n            \"order\": 1,\n            \"label\": \"内容\",\n            \"semantic_role\": \"value\",\n            \"style_role\": \"header\"\n          }\n        ],\n        \"rows\": [\n          {\n            \"row_id\": \"row:variable\",\n            \"order\": 0,\n            \"cells\": [\n              {\n                \"cell_id\": \"variable:cell:variable_label\",\n                \"row_id\": \"row:variable\",\n                \"column_id\": \"col:element\",\n                \"text\": \"主要变量\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": []\n              },\n              {\n                \"cell_id\": \"variable:cell:variable\",\n                \"row_id\": \"row:variable\",\n