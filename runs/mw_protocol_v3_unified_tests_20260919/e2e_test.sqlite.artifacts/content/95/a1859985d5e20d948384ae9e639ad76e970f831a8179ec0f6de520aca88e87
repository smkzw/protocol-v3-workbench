{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-3-2-1:v2\",\n  \"node_id\": \"v2_n_3_2_1\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"kind\": \"paragraph\",\n      \"block_id\": \"blk:v2_n_3_2_1:intro\",\n      \"text\": \"本试验的次要目的应逐项评价并映射至已定义的次要终点，用于补充主要复合终点在不同时点和不同维度的疾病活动度信息，支持剂量选择和后续III期设计。缩略语：SLE=系统性红斑狼疮；BILAG=不列颠群岛狼疮评估组；SRI-4=SLE应答指数4；BICLA=基于BILAG的复合狼疮评估；SLEDAI-2K=系统性红斑狼疮疾病活动指数2000；PGA=医师总体评估；AE=不良事件；SAE=严重不良事件；SAP=统计分析计划。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"kind\": \"table\",\n      \"block_id\": \"blk:v2_n_3_2_1:table_secondary_map\",\n      \"table\": {\n        \"table_id\": \"tbl:v2_n_3_2_1:secondary_objective_endpoint_map\",\n        \"block_id\": \"blk:v2_n_3_2_1:table_secondary_map\",\n        \"title\": \"次要目的与次要终点映射\",\n        \"domain\": \"objectives_endpoints\",\n        \"role\": \"body_content\",\n        \"header_row_count\": 1,\n        \"columns\": [\n          {\n            \"column_id\": \"secondary:cell:objective\",\n            \"label\": \"次要目的\",\n            \"order\": 0,\n            \"semantic_role\": \"objective\",\n            \"style_role\": \"body\",\n            \"source_locator\": \"\"\n          },\n          {\n            \"column_id\": \"secondary:cell:endpoint\",\n            \"label\": \"对应次要终点\",\n            \"order\": 1,\n            \"semantic_role\": \"endpoint\",\n            \"style_role\": \"body\",\n            \"source_locator\": \"\"\n          }\n        ],\n        \"rows\": [\n          {\n            \"row_id\": \"row:v2_n_3_2_1:secondary:1\",\n            \"order\": 0,\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:v2_n_3_2_1:secondary:1:objective\",\n                \"row_id\": \"row:v2_n_3_2_1:secondary:1\",\n                \"column_id\": \"secondary:cell:objective\",\n                \"text\": \"评价U2对SLE疾病活动度的其他影响。\",\n    