       {\n                \"cell_id\": \"dose:comparator-regimen\",\n                \"row_id\": \"row_regimen\",\n                \"column_id\": \"placebo\",\n                \"text\": \"第1天至第24周连续给药；每日两次（早晨、晚间各一次）；每例固定2处治疗区域；与R2组同法同量，即每区域每次约0.5 FTU；剂量固定，24周内不调整，无负荷期或维持期。该给药方案的结构化确认信息【待补充：对照药给药方案的结构化确认信息：该项待研究团队确认后补充】。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [\n                  \"evidence:source:97bed8108bac56a5c29e10f868e9760ed3d2ac8a67e4e3846c8aeb6718dd098e\",\n                  \"evidence:source:9e2e17d609b2e2e8d61f45b9aa630042e87e5c1e3fbfa74f023cad3783db0081\"\n                ],\n                \"source_locator\": \"word/document.xml/body/4:p\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row_starting\",\n            \"order\": 3,\n            \"cells\": [\n              {\n                \"cell_id\": \"starting-parameter\",\n                \"row_id\": \"row_starting\",\n                \"column_id\": \"parameter\",\n                \"text\": \"起始剂量\",\n                \"style_role\": \"label\",\n                \"provenance_lineage\": []\n              },\n              {\n                \"cell_id\": \"dose:starting\",\n                \"row_id\": \"row_starting\",\n                \"column_id\": \"r2\",\n                \"column_span\": 2,\n                \"text\": \"R2软膏：每区域每次约0.5 FTU，每日两次；安慰剂软膏：与R2组同法同量，每区域每次约0.5 FTU。起始剂量的结构化确认信息【待补充：起始剂量：该项待研究团队确认后补充】。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [\n                  \"evidence:source:9e2e17d609b2e2e8d61f45b9aa630042e87e5c1e3fbfa74f023cad3783db0081\",\n                  \"evidence:source:97bed8108bac56a5c29e10f868e9760ed3d2ac8a67e4e3846c8aeb6718dd098e\"\n                ],\n                \"source_locator\": \"word/document.xml/body/2:p\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row_maximum\",\n            \"order\": 4,\n            \"cells\": [\n              {\n                \"cell_id\": \"maximum-parameter\",\n                \"row_id\": \"row_maximum\",\n                \"column_id\": \"parameter\",\n                \"text\": \"最大剂量/安全性上限\",\n                \"style_role\": \"label\",\n                \"provenance_lineage\": []\n              },\n              {\n                \"cell_id\": \"dose:maximum\",\n                \"row_id\": \"row_maximum\",\n                \"column_id\": \"r2\",\n                \"column_span\": 2,\n                \"text\": \"计划最大给药量/最大剂量【待补充：计划最大给药量或最大剂量：该项待研究团队确认后补充】。每日4 g为独立的安全性上限（防过量），不是处方目标，不按FTU换算处方量；按固定2处区域给药（每日约2.0 FTU）远低于该上限。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [\n                  \"evidence:source:5b3aa77ddd0e596a38e3f76192a3d79dcbeb77469a2258d9aa6e06fc3de69cd8\",\n                  \"evidence:source:9e2e17d609b2e2e8d61f45b9aa630042e87e5c1e3fbfa74f023cad3783db0081\"\n                ],\n                \"source_locator\": \"word/document.xml/body/3:p\"\n              }\n            ]\n          }\n        ],\n        \"notes\": [\n          {\n            \"note_id\": \"note-ftu\",\n            \"note_type\": \"definition\",\n            \"marker\": \"\",\n            \"marker_source_locator\": \"word/document.xml/body/2:p\",\n            \"text\": \"FTU=指尖单位（fingertip unit）。\",\n            \"source_refs\": [\n              \"evidence:source:9e2e17d609b2e2e8d61f45b9aa630042e87e5c1e3fbfa74f023cad3783db0081\"\n            ],\n            \"target_ids\": [\n              \"dose:investigational-regimen\",\n              \"dose:comparator-regimen\",\n              \"dose:starting\"\n            ],\n            \"association_reason\": \"定义表内使用的剂量单位\",\n            \"review_status\": \"ai_draft\",\n            \"source_kind\": \"project_primary\",\n            \"module_ref\": \"dose-selection\"\n          },\n          {\n            \"note_id\": \"note-safety-cap\",\n            \"note_type\": \"operational\",\n            \"marker\": \"\",\n            \"marker_source_locator\": \"word/document.xml/body/3:p\",\n            \"text\": \"每日4 g为独立的安全性上限（防过量），不是处方目标，不按FTU换算处方量。\",\n            \"source_refs\": [\n              \"evidence:source:5b3aa77ddd0e596a38e3f76192a3d79dcbeb77469a2258d9aa6e06fc3de69cd8\"\n            ],\n            \"target_ids\": [\n              \"dose:maximum\"\n            ],\n            \"association_reason\": \"说明最大剂量单元格中的安全性上限\",\n            \"review_status\": \"ai_draft\",\n            \"source_kind\": \"project_primary\",\n            \"module_ref\": \"dose-selection\"\n          },\n          {\n            \"note_id\": \"note-gaps\",\n            \"note_type\": \"operational\",\n            \"marker\": \"\",\n            \"marker_source_locator\": \"\",\n            \"text\": \"表中【待补充：…：该项待研究团队确认后补充】为已确认缺失的结构化项目事实，待研究团队确认后补充；不得以模板示例或参考资料数值替代。\",\n            \"source_refs\": [],\n            \"target_ids\": [\n              \"dose:investigational-route\",\n              \"dose:comparator-route\",\n              \"dose:comparator-regimen\",\n              \"dose:starting\",\n              \"dose:maximum\"\n            ],\n            \"association_reason\": \"标识结构化项目事实缺口\",\n            \"review_status\": \"ai_draft\",\n            \"source_kind\": \"\",\n            \"module_ref\": \"dose-selection\"\n          },\n          {\n            \"note_id\": \"note-source-appendix\",\n            \"note_type\": \"operational\",\n            \"marker\": \"\",\n            \"marker_source_locator\": \"word/document.xml/body/5:p\",\n            \"text\": \"本表给药描述依据方案v0.1附录A（起草阶段权威给药描述来源）。\",\n            \"source_refs\": [\n              \"evidence:source:5f24a7eb6e284afdaa11c3944a1b46ccb73a2598c81de673ddb4ede130b2a172\",\n              \"evidence:source:b1d9ad239a9b5caac9aa829d31d627f38db2df2d7505c034163803cca089e22a\"\n            ],\n            \"target_ids\": [],\n            \"association_reason\": \"说明来源\",\n            \"r