{"content":"{\n  \"status\": \"needs_information\",\n  \"objectives\": {\n    \"primary\": [\n      {\n        \"text\": \"评价合成药K相比标准治疗方案在既往至少接受过一线系统治疗的多发性骨髓瘤患者中的疗效，主要疗效目标为总缓解率（ORR，按IMWG标准）。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户简报明确研究人群、对照、主要终点为ORR并按IMWG标准；本建议直接采纳该已确认设计事实。\",\n        \"references\": []\n      }\n    ],\n    \"secondary\": [\n      {\n        \"text\": \"评价合成药K相比标准治疗方案的安全性，包括治疗中出现的不良事件、严重不良事件、实验室异常、输液相关反应、周围神经病变及因不良事件导致的剂量调整或停药。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"BCMA靶向ADC静脉输注治疗多发性骨髓瘤，安全性是II期随机对照研究的重要次要目标；具体AE列表需按方案定义。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"评价缓解持续时间（DoR）。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"ORR为二分类终点，DoR可反映缓解持久性，是多发性骨髓瘤疗效评价的常用关键次要终点。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"评价无进展生存期（PFS）。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"PFS可支持后续确证性研究设计；II期随机对照研究常探索PFS作为关键次要终点。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"评价总生存期（OS）。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"OS是肿瘤研究的最终终点，随机双盲设计下可作为长期随访次要目标。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"评价微小残留病（MRD）阴性率（按IMWG标准）。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"MRD阴性在多发性骨髓瘤中与长期结局相关，可作为探索性/关键次要终点。\",\n        \"references\": []\n      }\n    ],\n    \"questions\": []\n  },\n  \"endpoint\": {\n    \"primary_endpoint\": {\n      \"text\": \"总缓解率（ORR）：达到部分缓解（PR）或更好缓解（sCR/CR/VGPR/PR）的受试者比例，按IMWG疗效评价标准。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户简报明确主要终点为ORR，按IMWG疗效评价标准。\",\n      \"references\": []\n    },\n    \"key_secondary\": [\n      {\n        \"text\": \"缓解持续时间（DoR）：自首次达到PR或更好缓解至疾病进展或死亡的时间，按IMWG标准。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"补充ORR的持久性信息，是多发性骨髓瘤常用关键次要终点。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"无进展生存期（PFS）：自随机化至首次疾病进展或任何原因死亡的时间，按IMWG标准。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"随机对照II期研究常以PFS评估疾病控制，支持后续研究决策。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"总生存期（OS）：自随机化至任何原因死亡的时间。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"最终生存获益终点，适合长期随访。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"MRD阴性率：在达到CR或更好缓解的受试者中，按IMWG标准经骨髓检测确认的MRD阴性比例。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"MRD阴性在多发性骨髓瘤中与预后相关，可作为关键次要或探索性终点。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"安全性终点：TEAE、SAE、特别关注不良事件、因AE停药或剂量调整的发生率。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"ADC安全性评价是II期研究必要组成部分。\",\n        \"references\": []\n      }\n    ],\n    \"measurement_details\": \"推荐ORR采用盲态独立中心评估（BICR）或至少盲态研究者评估，按IMWG 2016标准；应答需在方案规定时间窗内由连续两次评估确认。主要分析将缺失或不可评估的应答按非应答处理，并进行敏感性分析。具体评估时间窗、确认间隔和是否采用BICR需在方案中预先规定。\",\n    \"questions\": []\n  },\n  \"estimand\": {\n    \"treatment\": {\n      \"text\": \"试验组接受合成药K（BCMA靶向抗体偶联药物，静脉输注）；对照组接受标准治疗方案。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户简报明确试验药物、给药途径、靶点机制及对照组为标准治疗方案。\",\n      \"references\": []\n    },\n    \"population\": {\n      \"text\": \"随机化人群为既往至少接受过一线系统治疗的多发性骨髓瘤患者；主要分析采用意向性治疗（ITT）人群，即所有随机化受试者按随机分组分析。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"人群来自用户已确认事实；ITT用于保持随机化，符合随机双盲阳性对照II期ORR分析常规。\",\n      \"references\": []\n    },\n    \"variable\": {\n      \"text\": \"二分类变量：受试者在研究期间是否达到IMWG定义的PR或更好缓解。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"与主要终点ORR一致，二分类变量可直接比较组间缓解率。\",\n      \"references\": []\n    },\n    \"ice_strategy\": {\n      \"text\": \"对治疗中止采用治疗政策策略，所有随机化受试者纳入主要分析；对开始后续抗骨髓瘤治疗前未达到PR者，后续治疗开始后的应答不计入主要ORR；死亡或疾病进展前无缓解者计为无缓解；缺失或不可评估的缓解评估按无缓解处理，并用多重插补、tipping point等敏感性分析评估。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"在保持ITT的同时避免后续抗骨髓瘤治疗对ORR的混杂；二分类ORR终点常用该策略，但需方案预先规定。\",\n      \"references\": []\n    },\n    \"ice_events\": [\n      \"因毒性或其他原因停止研究治疗\",\n      \"开始后续抗骨髓瘤治疗\",\n      \"疾病进展或死亡\",\n      \"缺失或不可评估的疗效评估\"\n    ],\n    \"summary_measure\": {\n      \"text\": \"试验组与对照组ORR的绝对差异（率差），并报告各臂ORR及95%置信区间；检验采用卡方/Fisher或分层CMH方法，视随机分层因素而定。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"ORR为二分类主要终点，率差易于临床解释；分层方法可保持随机化分层因素。\",\n      \"references\": []\n    },\n    \"questions\": [\n      \"合成药K是单药还是联合标准治疗方案？若是联合，需明确联合方案及对应估计目标。\"\n    ]\n  },\n  \"sample_size\": {\n    \"assumptions\": [\n      \"随机、双盲、阳性对照II期设计，1:1随机，主要终点为ORR。\",\n      \"假设标准治疗方案ORR=40%，合成药K ORR=65%，绝对差异=25个百分点；该假设为推荐值，需按实际目标人群和标准治疗更新。\",\n      \"采用双侧α=0.10（单侧0.05），把握度80%，两样本比例检验或分层CMH检验。\",\n      \"按上述假设，每臂约需47例可评估，共约94例可评估；计划随机约100例（每组约50例），可覆盖约5%失访/不可评估。\"\n    ],\n    \"alpha\": \"双侧α=0.10（单侧0.05）；若下游确认采用双侧α=0.05或需多重性控制，需重新计算。\",\n    \"power\": \"80%\",\n    \"model\": \"两样本比例检验；若存在随机分层因素，采用分层CMH检验或logistic回归校正分层因素。\",\n    \"planned_n\": \"约100例随机（每组约50例）\",\n    \"attrition\": \"预计5%失访/主要ORR不可评估；若失访或不可评估率达10%，可评估约90例，按上述假设把握度约79%，需重算或增加样本量。\",\n    \"justification\": \"基于40% vs 65%、双侧α=0.10、80%把握度的两样本比例检验，每臂需约47例可评估，共约94例；计划100例随机可覆盖约5%缺失。用户简报已给出约100例，故按推荐采纳；最终样本量取决于对照ORR、目标差异、α、把握度、分层因素和分析人群。\",\n    \"questions\": [\n      \"请提供标准治疗方案在目标人群中的预期ORR和合成药K预期ORR或目标绝对差异；若与40% vs 65%假设不同，需复算约100例的把握度或样本量。\"\n    ],\n    \"references\": []\n  },\n  \"interim_planning\": null,\n  \"non_inferiority_margin\": null,\n  \"questions\": [\n    \"随机阳性对照比较的目标是优效性、非劣效性还是其他？若为非劣效，需提供非劣效界值、临床可接受最大疗效损失及依据。\",\n    \"是否计划期中分析？如计划，需提供时点/信息分数、目的、决策规则、alpha消耗、对最终分析影响和决策责任。\",\n    \"对照组“标准治疗方案”的具体药物、剂量、给药周期和既往治疗线次定义是什么？\",\n    \"合成药K是单药还是联合标准治疗方案？若是联合，联合方案是什么？\",\n    \"请提供标准治疗方案在目标人群中的预期ORR、合成药K预期ORR或目标绝对差异，以复算样本量。\",\n    \"计划随机化比例和分层因素是什么？\"\n  ],\n  \"unresolved_questions\": [\n    \"随机阳性对照比较的目标是优效性、非劣效性还是其他？若为非劣效，需提供非劣效界值、临床可接受最大疗效损失及依据。\",\n    \"是否计划期中分析？如计划，需提供时点/信息分数、目的、决策规则、alpha消耗、对最终分析影响和决策责任。\",\n    \"对照组“标准治疗方案”的具体药物、剂量、给药周期和既往治疗线次定义是什么？\",\n    \"合成药K是单药还是联合标准治疗方案？若是联合，联合方案是什么？\",\n    \"请提供标准治疗方案在目标人群中的预期ORR、合成药K预期ORR或目标绝对差异，以复算样本量。\",\n    \"计划随机化比例和分层因素是什么？\"\n  ]\n}","receipt":{"idempotency_key":"design-elements.generate.v1","input_artifacts":[{"ref":"design-elements-intake","sha256":"7f366b98d07115344925413285eb8fa325fe66b9381ac3ce2de09e1d929fe1e1"}],"logical_call_id":"call:design-elements:5ca6a1bc6abc70a703c6d9f1cce7351c86a521cd8ba2452500fb89a5ae4f47d6:design-generate","node_execution_contract_id":"nec:design-elements:5ca6a1bc6abc70a703c6d9f1cce7351c86a521cd8ba2452500fb89a5ae4f47d6:design-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/design-elements-output.v1.json","output_sha256":"4e42efaed52f82504f21a2afa6ce2b16fdcf7381f5aaec85e1911ba50a122747","prompt_sha256":"21bf2955294ee9cc2fd35ad41a9fec8e8279bf3e566b47d7babf7c624d527a38","provider_session_id":"c7c96886-6a28-478b-8dbf-d130ede652ba","requested_reasoning_effort":"max"},"schema":"model_response.v1"}