{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-13-4:v2\",\n  \"node_id\": \"v2_n_13_4\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"blocks\": [\n    {\n      \"block_id\": \"block:compensation:title\",\n      \"kind\": \"paragraph\",\n      \"text\": \"试验参与者的补偿、赔偿与保险\"\n    },\n    {\n      \"block_id\": \"block:compensation:intro\",\n      \"kind\": \"paragraph\",\n      \"text\": \"本章明确试验参与者补偿、赔偿与保险的项目安排、责任/控制边界和待补/建议解决路径；具体安排应以已确认的项目事实为准，不得将模板示例、未确认安排或审批结论转写为项目事实。\"\n    },\n    {\n      \"block_id\": \"block:compensation:arrangement\",\n      \"kind\": \"paragraph\",\n      \"text\": \"试验相关损害应由申办方依法承担赔偿责任并提供相应补偿。\"\n    },\n    {\n      \"block_id\": \"block:compensation:injury\",\n      \"kind\": \"paragraph\",\n      \"text\": \"研究者应立即处置并记录试验相关损害；申办方应承担治疗费用并依法补偿。\"\n    },\n    {\n      \"block_id\": \"block:compensation:insurance\",\n      \"kind\": \"paragraph\",\n      \"text\": \"申办方应为本试验购买临床试验责任保险。\"\n    },\n    {\n      \"block_id\": \"block:compensation:contact\",\n      \"kind\": \"paragraph\",\n      \"text\": \"责任联系为申办方医学监察员及药物安全负责人（联系方式见中心启动资料）。\"\n    },\n    {\n      \"block_id\": \"block:compensation:missing\",\n      \"kind\": \"paragraph\",\n      \"text\": \"补偿与损害处理条款应以临床试验协议为准。\"\n    },\n    {\n      \"block_id\": \"block:compensation:table\",\n      \"kind\": \"table\",\n      \"table\": {\n        \"table_id\": \"table:compensation:arrangements\",\n        \"block_id\": \"block:compensation:table\",\n        \"title\": \"试验参与者补偿、赔偿与保险安排\",\n        \"domain\": \"generic\",\n        \"role\": \"body_content\",\n        \"header_row_count\": 1,\n        \"version\": 0,\n        \"schema_version\": \"structured_table_v1\",\n        \"review_state\": \"ai_draft\",\n        \"columns\": [\n          {\n            \"column_id\": \"col:compensation:item\",\n            \"order\": 0,\n            \"label\": \"项目\",\n            \"semantic_role\": \"item\",\n            \"style_role\": \"header\"\n          },\