",\n                \"row_id\": \"row:compensation:insurance\",\n                \"column_id\": \"col:compensation:boundary\",\n                \"text\": \"保险安排由申办方提供；具体条款应以临床试验协议为准。\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:compensation:resolution:insurance\",\n                \"row_id\": \"row:compensation:insurance\",\n                \"column_id\": \"col:compensation:resolution\",\n                \"text\": \"保险具体条款如需补充，按临床试验协议与中心流程核对更新。\",\n                \"style_role\": \"body\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:compensation:contact\",\n            \"order\": 4,\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:compensation:item:contact\",\n                \"row_id\": \"row:compensation:contact\",\n                \"column_id\": \"col:compensation:item\",\n                \"text\": \"责任联系\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"compensation:cell:contact\",\n                \"row_id\": \"row:compensation:contact\",\n                \"column_id\": \"col:compensation:content\",\n                \"text\": \"责任联系为申办方医学监察员及药物安全负责人（联系方式见中心启动资料）。\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:compensation:boundary:contact\",\n                \"row_id\": \"row:compensation:contact\",\n                \"column_id\": \"col:compensation:boundary\",\n                \"text\": \"联系职责限于申办方医学监察与药物安全联络；不替代知情同意、伦理审查或法定索赔程序。\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:compensation:resolution:contact\",\n                \"row_id\": \"row:compensation:contact\",\n                \"column_id\": \"col:compensation:resolution\",\n                \"text\": \"具体联系方式见中心启动资料；如需更新