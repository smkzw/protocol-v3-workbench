 \"row:secondary:6mwd\",\n                \"column_id\": \"col:endpoint\",\n                \"text\": \"6 分钟步行距离变化。\",\n                \"provenance_lineage\": [\n                  \"evidence:source:f51011f85a2bea698ff3b96318145bf9359cf91d77a6713ac8c773748b59932c\"\n                ],\n                \"source_locator\": \"word/document.xml/body/7:p\"\n              },\n              {\n                \"cell_id\": \"efficacy:cell:estimand:secondary_6mwd\",\n                \"row_id\": \"row:secondary:6mwd\",\n                \"column_id\": \"col:estimand\",\n                \"text\": \"【待补充：该关键次要终点的估计目标：该项待研究团队确认后补充】\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:secondary:pfs\",\n            \"order\": 3,\n            \"label\": \"关键次要终点（候选）：无进展生存期\",\n            \"source_locator\": \"word/document.xml/body/7:p\",\n            \"cells\": [\n              {\n                \"cell_id\": \"efficacy:cell:objective:secondary_pfs\",\n                \"row_id\": \"row:secondary:pfs\",\n                \"column_id\": \"col:objective\",\n                \"text\": \"【待补充：该关键次要终点对应的次要目的：该项待研究团队确认后补充】\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"efficacy:cell:endpoint:secondary_pfs\",\n                \"row_id\": \"row:secondary:pfs\",\n                \"column_id\": \"col:endpoint\",\n                \"text\": \"无进展生存期（疾病进展或死亡）。\",\n                \"provenance_lineage\": [\n                  \"evidence:source:f51011f85a2bea698ff3b96318145bf9359cf91d77a6713ac8c773748b59932c\"\n                ],\n                \"source_locator\": \"word/document.xml/body/7:p\"\n              },\n              {\n                \"cell_id\": \"efficacy:cell:estimand:secondary_pfs\",\n                \"row_id\": \"row:secondary:pfs\",\n             