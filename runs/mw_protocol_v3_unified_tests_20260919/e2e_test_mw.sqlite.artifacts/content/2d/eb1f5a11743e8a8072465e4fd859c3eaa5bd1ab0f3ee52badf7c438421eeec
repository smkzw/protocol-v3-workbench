{"content":"{\n  \"chapters\": {\n    \"v2_n_9_1\": {\n      \"efficacy.assessment_instrument_or_scale\": {\n        \"primary\": \"盆腔疼痛VAS评分（0-100mm视觉模拟评分尺，0mm无痛，100mm极度剧痛）\",\n        \"secondary\": [\n          \"第4、8周盆腔疼痛VAS评分\",\n          \"痛经评分\",\n          \"非经期盆腔疼痛评分\",\n          \"性交痛评分\",\n          \"抢救性止痛药使用量及完全缓解率\",\n          \"EHP-30生活质量量表评分\"\n        ],\n        \"diary\": \"电子日记卡记录每日盆腔疼痛VAS评分及止痛药用量\"\n      },\n      \"efficacy.assessment_timing_reference\": {\n        \"screening\": \"筛选期最长4周\",\n        \"baseline\": \"随机前连续28天筛选期内电子日记卡记录的每日盆腔疼痛VAS评分平均值\",\n        \"primary_endpoint\": \"治疗第12周（Day 84±3天）评估前7天每日VAS评分均值作为第12周终点值\",\n        \"secondary\": \"第4周和第8周\",\n        \"follow_up\": \"安全随访期4周\"\n      },\n      \"efficacy.primary_endpoint_measurement\": {\n        \"description\": \"治疗第12周时盆腔疼痛VAS评分较基线的变化值\",\n        \"instrument\": \"0-100mm VAS\",\n        \"baseline_definition\": \"随机前连续28天筛选期内电子日记卡每日盆腔疼痛VAS评分平均值\",\n        \"endpoint_definition\": \"第12周（Day 84±3天）评估前7天每日VAS评分均值\"\n      },\n      \"efficacy.primary_estimand_link\": {\n        \"population\": \"所有随机受试者\",\n        \"strategy\": \"主要估计目标采用治疗策略（Treatment Policy Strategy）分析所有随机受试者\",\n        \"intercurrent_event\": \"治疗期间使用抢救性止痛药（限定布洛芬片，每次不超过400mg，每日最高不超过1200mg）\",\n        \"ice_handling\": \"主要估计目标对治疗期间使用抢救性止痛药采用治疗策略并记录伴发事件发生；敏感性分析采用假想策略（Hypothetical Strategy）\"\n      },\n      \"evaluation.framework_scope\": {\n        \"design\": \"随机、双盲、安慰剂对照、多中心II期临床研究\",\n        \"primary_objective\": \"评价合成药E1 10mg口服每日一次与外观匹配安慰剂相比，在确诊为子宫内膜异位症伴中重度盆腔疼痛的育龄期女性患者中，治疗第12周时盆腔疼痛VAS评分较基线变化的有效性。\",\n        \"secondary_objectives\": [\n          \"评价第4周和第8周盆腔疼痛VAS评分较基线变化。\",\n          \"评价痛经评分变化、非经期盆腔疼痛评分、性交痛评分。\",\n          \"评价抢救性止痛药使用量及完全缓解率。\",\n          \"评价EHP-30生活质量量表评分。\",\n          \"评价安全性与耐受性。\"\n        ]\n      }\n    },\n    \"v2_n_9_2\": {\n      \"safety.assessment_restrictions\": {\n        \"rescue_medication\": \"治疗期间限制常规镇痛药物，仅允许使用指定背景抢救性止痛药（布洛芬片每次不超过400mg，每