{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-3-1-2-2:v2\",\n  \"node_id\": \"v2_n_3_1_2_2\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"block_id\": \"p1\",\n      \"kind\": \"paragraph\",\n      \"text\": \"本节明确主要估计目标的研究变量属性。研究变量为第24周sUA（血清尿酸）<5 mg/dL的二分类指标（是/否）。根据本章合同要求，研究变量应同时给出测量、聚合与时间点/窗口；以下表格逐项列示。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"tbl1\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [],\n      \"table\": {\n        \"table_id\": \"table:variable-attribute\",\n        \"block_id\": \"tbl1\",\n        \"title\": \"研究变量属性表\",\n        \"role\": \"body_content\",\n        \"domain\": \"objectives_endpoints\",\n        \"header_row_count\": 1,\n        \"columns\": [\n          {\n            \"column_id\": \"col:element\",\n            \"label\": \"属性要素\",\n            \"order\": 0,\n            \"semantic_role\": \"attribute\",\n            \"style_role\": \"body\"\n          },\n          {\n            \"column_id\": \"col:content\",\n            \"label\": \"内容\",\n            \"order\": 1,\n            \"semantic_role\": \"content\",\n            \"style_role\": \"body\"\n          }\n        ],\n        \"rows\": [\n          {\n            \"row_id\": \"row:variable\",\n            \"order\": 0,\n            \"cells\": [\n              {\n                \"cell_id\": \"variable:cell:element\",\n                \"row_id\": \"row:variable\",\n                \"column_id\": \"col:element\",\n                \"text\": \"研究变量\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"variable:cell:content\",\n                \"row_id\": \"row:variable\",\n                \"column_id\": \"col:content\",\n                \"text\": \"第24周sUA（血清尿酸）<5 mg/dL的二分类指标（是/否）。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:measurement\",\n            \"order\": 1,\n            \"cells\": [\n              {\n                \"cell_id\": \"variable:cell:measurement-label\",\n                \"row_id\": \"row:measurement\",\n                \"column_id\": \"col:element\",\n                \"text\": \"测量\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"variable:cell:measurement\",\n                \"row_id\": \"row:measurement\",\n                \"column_id\": \"col:content\",\n                \"text\": \"【待补充：研究变量的测量方式（如何测定sUA及如何判定<5 mg/dL）：该项待研究团队确认后补充】\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:aggregation\",\n            \"order\": 2,\n            \"cells\": [\n              {\n                \"cell_id\": \"variable:cell:aggregation-label\",\n                \"row_id\": \"row:aggregation\",\n                \"column_id\": \"col:element\",\n                \"text\": \"聚合\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"variable:cell:aggregation\",\n                \"row_id\": \"row:aggregation\",\n                \"column_id\": \"col:content\",\n                \"text\": \"【待补充：研究变量的聚合方式（如何从重复测量或多次访视汇总到个体层）：该项待研究团队确认后补充】\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:timepoint\",\n            \"order\": 3,\n            \"cells\": [\n              {\n                \"cell_id\": \"variable:cell:timepoint-label\",\n                \"row_id\": \"row:timepoint\",\n                \"column_id\": \"col:element\",\n                \"text\": \"时间点/窗口\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"variable:cell:timepoint\",\n                \"row_id\": \"row:timepoint\",\n                \"column_id\": \"col:content\",\n                \"text\": \"【待补充：研究变量的时间点/时间窗（包括第24周评价窗口的定义与允许窗口）：该项待研究团队确认后补充】\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          }\n        ],\n        \"notes\": [\n          {\n            \"note_id\": \"note:variable-attribute\",\n            \"note_type\": \"definition\",\n            \"text\": \"研究变量属性应同时给出测量、聚合与时间点/窗口；仅写“疗效”等标签或只给统计方法名不满足要求。\",\n            \"source_refs\": [],\n            \"target_ids\": [\n              \"variable:cell:measurement\",\n              \"variable:cell:aggregation\",\n              \"variable:cell:timepoint\"\n            ],\n            \"review_status\": \"ai_draft\"\n          }\n        ],\n        \"source_locator\": \"\",\n        \"review_state\": \"ai_draft\",\n        \"schema_version\": \"structured_table_v1\",\n        \"version\": 0,\n        \"word_layout\": {}\n      }\n    },\n    {\n      \"block_id\": \"p2\",\n      \"kind\": \"paragraph\",\n      \"text\": \"仅写“疗效”等标签或仅给统计方法名不构成研究变量属性；研究变量必须逐项明确测量、聚合与时间点/窗口，不得只保留变量名称。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"e5a9dafadd1866f927959a9a64a