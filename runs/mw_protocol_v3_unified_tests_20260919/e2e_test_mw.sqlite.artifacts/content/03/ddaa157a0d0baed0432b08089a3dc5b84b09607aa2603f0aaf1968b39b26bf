{"content":"{\"chapters\":{\"v2_n_5_3\":{\"population.lifestyle.scope\":{\"description\":\"适用于双盲治疗期内所有随机受试者的合并用药、抢救止痛药使用及疼痛评估前用药限制。\",\"applies_to\":\"所有随机受试者\"},\"population.lifestyle.timing\":{\"restriction_period\":\"自随机化进入双盲治疗期开始至第12周双盲治疗期结束\",\"pain_assessment_restriction\":\"每次访视疼痛评估前48小时内禁止服用抢救止痛药\"},\"population.lifestyle.constraints\":[\"治疗期间限制常规镇痛药物。\",\"仅允许使用指定背景抢救性止痛药布洛芬片，且每次不超过400mg、每日最高不超过1200mg。\",\"每次访视疼痛评估前48小时内禁止服用抢救止痛药。\",\"禁止使用其他激素类药物，如GnRH激动剂、孕激素、口服避孕药等。\",\"受试者每日通过电子日记卡记录止痛药用量与疼痛评分。\"],\"population.lifestyle.exceptions\":[\"在限定剂量内允许使用指定背景抢救性止痛药布洛芬片（每次≤400mg，每日≤1200mg）。\"]},\"v2_n_5_4\":{},\"v2_n_5_5\":{\"picos.population_summary\":{\"population\":\"确诊为子宫内膜异位症伴中重度盆腔疼痛的育龄期女性患者\",\"planned_enrollment\":\"约150例\",\"randomization\":\"按1:1随机分配至合成药E1组（约75例）或安慰剂组（约75例）\",\"study_design\":\"随机、双盲、安慰剂对照、多中心II期临床研究\"},\"population.recruitment.target\":{\"target_population\":\"确诊为子宫内膜异位症伴中重度盆腔疼痛的育龄期女性患者\",\"planned_enrollment\":\"约150例\",\"allocation\":\"1:1随机分配至合成药E1组约75例、安慰剂组约75例\"},\"population.retention.follow_up\":{\"screening_period\":\"最长4周\",\"double_blind_treatment_period\":\"12周\",\"safety_follow_up_period\":\"4周\"}},\"v2_n_6_1_1\":{\"intervention.product_identity\":{\"investigational_product\":\"合成药E1片（口服GnRH受体拮抗剂）\",\"comparator\":\"外观匹配安慰剂片\"},\"intervention.formulation\":{\"investigational_product\":\"片剂，规格10mg/片\",\"comparator\":\"外观匹配安慰剂片，每次1片\"},\"intervention.exposure_dose\":{\"investigational_product\":\"合成药E1 10mg，口服，每日一次，每次1片\",\"comparator\":\"安慰剂片，口服，每日一次，每次1片\"},\"intervention.route_of_administration\":{\"route\":\"口服\"}},\"v2_n_6_1_2\":{\"intervention.dose_regimen\":{\"investigational_product\":\"合成药E1片10mg，口服，每日一次（QD），每次1片\",\"comparator\":\"外观匹配安慰剂片，口服，每日一次（QD），每次1片\",\"duration\":\"双盲治疗期12周\"},\"intervention.administration_instructions\":{\"instructions\":\"在双盲治疗期12周内每日口服一次，每次1片；合成药E1片与安慰剂片外观、包装完全一致，实施严格双盲对照。\"},\"intervention.dose_consistency_with_design\":{\"description\":\"固定剂量10mg每日一次，与随机、双盲、安慰剂对照II期设计一致；未设定剂量递增。\"},\"interv