{"content":"{\n  \"chapters\": {\n    \"v2_n_10_2_2\": {\n      \"sae_reporting.first_awareness_reference\": {\"text\": \"研究者首次获知严重不良事件（SAE）的日期和时间，作为向申办者报告时限的起算点。\"},\n      \"sae_reporting.investigator_clock\": {\"text\": \"研究者应在获知 SAE 后立即评估，并尽快且不迟于24小时向申办者报告；致死或危及生命的 SAE 还应按法规和伦理委员会要求报告。\"},\n      \"sae_reporting.investigator_recipient\": {\"text\": \"申办者或其指定的药物警戒/安全性报告接收部门，同时按法规和伦理委员会要求报告伦理委员会。\"},\n      \"sae_reporting.investigator_record\": {\"text\": \"研究者应在原始病历、CRF 和 SAE 报告表中记录 SAE 的临床表现、发生时间、严重程度、处理措施、因果关系判断、报告时间、接收人及随访信息。\"}\n    },\n    \"v2_n_10_2_3\": {\n      \"sae_followup.new_information_reporting\": {\"text\": \"研究者获知 SAE 相关新信息后，应在24小时内更新并报告申办者；在 SAE 报告表/CRF 中记录新信息、报告日期和接收人。\"},\n      \"sae_followup.outcome_documentation\": {\"text\": \"随访并记录 SAE 的转归，包括恢复、好转、稳定、死亡、失访等，记录结局日期、严重性变化、采取措施及与试验药物的关系。\"},\n      \"sae_followup.scope\": {\"text\": \"对所有 SAE 进行医学随访，直至事件解决或稳定、结局明确，或达到方案规定的随访截止；研究结束后发生的与试验药物相关的 SAE 也应按法规随访。\"}\n    },\n    \"v2_n_10_3_1\": {\n      \"susar.chapter_area_framing\": {\"text\": \"本章规定本试验中可疑非预期严重不良反应（SUSAR）的定义、预期性判断和快速报告标准，适用于合成药E1 II期临床试验。\"},\n      \"susar.definition\": {\"text\": \"SUSAR 指可疑且非预期严重不良反应，即符合严重不良反应标准、与试验药物存在合理可能因果关系，且其性质、严重程度、频率或结局与研究者手册等安全性参考信息不一致的不良反应。\"},\n      \"susar.expectedness_reference\": {\"text\": \"预期性判断以试验药物现行研究者手册（IB）为主要参考，并结合方案、知情同意书和已批准说明书等安全性参考信息；若出现新的安全性信息应及时更新判断依据。\"},\n      \"susar.reportability_criteria\": {\"text\": \"同时满足严重性、与试验药物存在合理可能因果关系（可疑）以及非预期性三个条件时，应按 SUSAR 快速报告；仅严重但可预期或因果关系不支持者不按 SUSAR 报告。\"}\n    },\n    \"v2_n_10_3_2\": {\n      \"susar_reporting.authority_and_ethics_communications\": {\"text\": \"申办者应将 SUSAR 快速报告给药品监督管理部门、卫生健康主管部门、伦理委员会以及所有参加试验的研究者和临床试验机构。\"},\n      \"susar_reporting.awareness_reference\": {\"text\": \"以申办者首次获知符合 SUSAR 报告标准信息的日期和时间，作为快速报告时限的起算点。\"},\n      \"susar_reporting.sponsor_clock\": {\"text\": \"致死或危及生命的 SUSAR，申办者应在首次获知后尽快报告，不迟于7日；非致死或危及生命的 SUSAR，应在首次获知后尽快报告，不迟于15日。\"},\n      \"susar_reporting.sponsor_followup_clock\": {\"text\": \"致死或危及生命的 SUSAR，申办者应在8日内提交相关随访信息；非致死或危及生命的 SUSAR，应在15日内提交相关随访信息。\"},\n      \"susar_reporting.sponsor_recipient\": {\"text\": \"药品监督管理部门、卫生健康主管部门、伦理委员会，以及所有参加试验的研究者和临床试验机构。\"}\n    },\n    \"v2_n_10_3_3\": {\n      \"susar_followup.causality_disagreement_retention\": {\"text\": \"如申办者与研究者对 SUSAR 因果关系判断不一致，应保留双方判断意见和依据，不因分歧而更改原始记录。\"},\n      \"susar_followup.documentation\": {\"text\": \"记录 SUSAR 随访过程中的新信息、报告日期、接收方、因果关系再评估、严重性变化、结局和处理措施。\"},\n      \"susar_followup.new_information_clock\": {\"text\": \"获得 SUSAR 新信息后，致死或危及生命的应在8日内、其他 SUSAR 应在15日内提交随访快速报告。\"},\n      \"susar_followup.recipients\": {\"text\": \"随访快速报告的接收方与初始 SUSAR 报告一致，包括药品监督管理部门、卫生健康主管部门、伦理委员会及所有参加试验的研究者和临床试验机构。\"}\n    },\n    \"v2_n_10_4\": {\n      \"other_ssi.recipient_and_clock\": {\"text\": \"申办者应将其他潜在的严重安全性风险信息及时报告给药品监督管理部门、卫生健康主管部门、伦理委员会及参加试验的研究者和临床试验机构；具体时限按适用法规和监管要求执行。\"},\n      \"other_ssi.reporting_criteria\": {\"text\": \"报告标准为非 SUSAR 但提示潜在严重安全性风险的信息，如非临床安全性发现、临床显著毒性、药物相互作用、同类药物风险、安全性研究结果或已知风险的重要变化等。\"},\n      \"other_ssi.review_responsibility\": {\"text\": \"申办者药物警戒/安全性部门负责识别、评估和决定是否报告其他潜在的严重安全性风险信息；研究者、伦理委员会和监管机构按职责接收和审查。\"},\n      \"other_ssi.signal_definition\": {\"text\": \"信号指来自临床试验、自发报告、文献、流行病学或非临床研究的信息，提示试验药物与不良事件之间存在新的潜在因果关系或已知关联的新方面，需要进一步评估。\"}\n    },\n    \"v2_n_10_5\": {\n      \"aesi.definition\": {\"text\": \"特殊关注不良事件（AESI）是根据试验药物作用机制、非临床或临床数据、同类药物风险等确定的，需在试验中特别监测和报告的不良事件或医学事件。\"},\n      \"aesi.monitoring_and_reporting\": {\"text\": \"AESI 应按方案规定进行监测、记录和报告；其中符合严重标准的 AESI 应按 SAE/SUSAR 报告流程处理，非严重 AESI 按方案规定记录并随访。\"},\n      \"aesi.thresholds\": {\"text\": \"当 AESI 达到方案预设的发生率、严重程度或特定实验室异常阈值时，应触发加强监测、安全性评估、暂停给药或快速报告等预设措施。\"},\n      \"picos.aesi_definitions\": {\"text\": \"AESI 定义为需特别关注的医学事件，依据试验药物机制、非临床/临床数据和同类药物风险确定；本试验中具体 AESI 清单及定义按方案安全性监测要求执行。\"}\n    },\n    \"v2_n_10_6\": {\n      \"pregnancy.abnormal_outcome_reporting\": {\"text\": \"妊娠异常结局，如自然流产、人工流产、死胎、新生儿死亡或先天畸形等，应按 SAE 或方案规定快速报告申办者。\"},\n      \"pregnancy.continued_collection_arrangement\": {\"text\": \"对妊娠暴露病例继续收集安全性信息，随访孕妇至妊娠终止，并收集新生儿结局，直至结局明确或按方案规定结束。\"},\n      \"pregnancy.exposure_reporting\": {\"text\": \"受试者或其伴侣在试验期间发生妊娠暴露，无论是否与试验药物相关，均应尽快且不迟于24小时报告申办者。\"},\n      \"pregnancy.outcome_followup\": {\"text\": \"对妊娠结局进行随访，记录分娩、流产、死胎、先天异常、新生儿健康状况及与试验药物的关系。\"},\n      \"pregnancy.partner_consent\": {\"text\": \"若受试者伴侣发生妊娠，应在获得伴侣知情同意后收集妊娠和新生儿结局信息，并保护其隐私。\"},\n      \"pregnancy.prevention_requirements\": {\"text\": \"育龄期女性受试者及其伴侣应在研究期间及方案规定的末次给药后期间采取有效的非激素类避孕措施，因试验期间禁用其他激素类药物。\"},\n      \"pregnancy.testing_requirements\": {\"text\": \"育龄期女性受试者在筛选期及研究期间应按方案进行妊娠试验，通常包括筛选期和必要时血清或尿妊娠试验。\"},\n      \"pregnancy.withdrawal_arrangement\": {\"text\": \"确认妊娠后，受试者应暂停试验药物，并按方案和伦理要求决定是否退出研究；同时继续随访至妊娠结局明确。\"}\n    }\n  }\n}","receipt":{"idempotency_key":"chapter-facts.derive.v1","input_artifacts":[{"ref":"chapter-facts-input","sha256":"7ef9fa643f6c276484cdea2a4b2b8f239cad0a6b64dadadd27c7d71e15e29838"}],"logical_call_id":"call:chapter-facts:7ef9fa643f6c276484cdea2a4b2b8f239cad0a6b64dadadd27c7d71e15e29838","node_execution_contract_id":"nec:chapter-facts:7ef9fa643f6c276484cdea2a4b2b8f239cad0a6b64dadadd27c7d71e15e29838","observed_model":"deepseek-latest-cloud","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/chapter-facts-output.v1.json","output_sha256":"3686ea2818116e1557a4fce1bccc8b88c38f3b24bd8b7e4a9d0c1e1d7babe258","prompt_sha256":"81a4f629a6890c6f801162e4a74b9ab00ea246faf6b827f82fb3d8a5fee50daf","provider_session_id":"39026b3d-8645-4f5f-bc90-2e87ba0dc10c","requested_reasoning_effort":"max"},"schema":"model_response.v1"}