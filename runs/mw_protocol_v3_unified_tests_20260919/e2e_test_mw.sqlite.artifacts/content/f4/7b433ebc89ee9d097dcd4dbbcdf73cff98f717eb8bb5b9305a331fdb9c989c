{"content":"{\"chapters\":{\"v2_n_6_4_1\":{\"intervention.prohibited_treatments\":{\"description\":\"治疗期间禁止使用其他激素类药物（如GnRH激动剂、孕激素、口服避孕药等）；除方案指定的背景抢救性止痛药布洛芬外，限制常规镇痛药物。\"},\"intervention.prohibited_window\":{\"description\":\"双盲治疗期12周内。\"}},\"v2_n_6_4_2\":{\"intervention.allowed_timing\":{\"description\":\"双盲治疗期12周内可按需使用指定背景抢救性止痛药布洛芬；每次访视疼痛评估前48小时内禁止服用抢救止痛药。\"},\"intervention.allowed_treatments\":{\"description\":\"仅允许使用指定背景抢救性止痛药布洛芬片，每次不超过400mg，每日最高不超过1200mg。\"},\"intervention.background_therapy_applicable\":{\"applicable\":true,\"description\":\"治疗期间允许使用指定背景抢救性止痛药布洛芬，但需遵守剂量上限和疼痛评估前48小时禁用限制。\"}},\"v2_n_6_4_3\":{\"intervention.rescue_estimand_linkage\":{\"description\":\"主要估计目标对治疗期间使用抢救性止痛药这一伴发事件采用治疗策略（Treatment Policy Strategy），即无论是否发生该伴发事件，均按随机分组分析所有随机受试者并记录伴发事件发生；敏感性分析对该伴发事件采用假想策略（Hypothetical Strategy）。\"},\"intervention.rescue_permitted\":{\"description\":\"允许使用指定背景抢救性止痛药布洛芬片，每次不超过400mg，每日最高不超过1200mg。\"},\"intervention.rescue_records\":{\"description\":\"受试者每日通过电子日记卡记录止痛药用量与疼痛评分。\"},\"intervention.rescue_timing\":{\"description\":\"双盲治疗期12周内按需使用；每次访视疼痛评估前48小时内禁止服用抢救止痛药。\"}},\"v2_n_7_1\":{\"procedure.baseline_assessments\":{\"description\":\"基线为随机前连续28天筛选期内电子日记卡记录的每日盆腔疼痛VAS评分平均值；VAS采用0-100mm视觉模拟评分尺。\"},\"procedure.screening_period_definition\":{\"description\":\"筛选期最长4周（28天），用于确认合格性并收集随机前连续28天电子日记卡每日盆腔疼痛VAS评分以定义基线。\"}},\"v2_n_7_2\":{\"diagram.randomized\":{\"description\":\"计划入组约150例，按1:1随机分配至合成药E1组（约75例）或安慰剂组（约75例）。\"},\"procedure.blinded_treatment_handling\":{\"description\":\"合成药E1片（10mg/片）与外观匹配安慰剂片均每日口服一次，每次1片，外观、包装完全一致，实施严格双盲。\"},\"procedure.dosing_start_rules\":{\"description\":\"双盲治疗期12周内每日口服一次，每次1片；合成药E1为10mg/片或匹配安慰剂1片。\"},\"procedure.treatment_period_definition\":{\"description\":\"双盲治疗期为12周；第12周访视时间窗为Day 84±3天。\"},\"procedure.treatment_visit_procedures\":{\"description\":\"第4周、第8周、第12周评估盆腔疼痛VAS较基线变化；第12周终点为Day 84±3天评估前7天每日VAS评分均值；每次访视疼痛评估前48小时内禁止服用抢救止痛药；受试者每日记录电子日记卡疼痛评分与止痛药用量。\"}},\"v2_n_7_3\":{\"procedure.followup_period_definition\":{\"description\":\"安全随访期为4周。\"}}}}","receipt":{"idempotency_key":"chapter-facts.derive.v1","input_artifacts":[{"ref":"chapter-facts-input","sha256":"927d6c2b1682d46442cd09e5e77fe3370a7331f8e77dae72375b6a12e5f902c1"}],"logical_call_id":"call:chapter-facts:927d6c2b1682d46442cd09e5e77fe3370a7331f8e77dae72375b6a12e5f902c1","node_execution_contract_id":"nec:chapter-facts:927d6c2b1682d46442cd09e5e77fe3370a7331f8e77dae72375b6a12e5f902c1","observed_model":"deepseek-latest-cloud","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/chapter-facts-output.v1.json","output_sha256":"712346ef635090e5f21114080160f69552509a6a2362c302c79ad0e05f369fbf","prompt_sha256":"81a4f629a6890c6f801162e4a74b9ab00ea246faf6b827f82fb3d8a5fee50daf","provider_session_id":"1de51216-9750-4bb4-857e-7f07f7260679","requested_reasoning_effort":"max"},"schema":"model_response.v1"}