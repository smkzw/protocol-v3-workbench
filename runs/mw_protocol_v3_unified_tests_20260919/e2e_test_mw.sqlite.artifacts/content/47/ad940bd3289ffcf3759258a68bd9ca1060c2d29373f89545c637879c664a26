{"content":"{\n  \"status\": \"needs_information\",\n  \"objectives\": {\n    \"primary\": [\n      {\n        \"text\": \"在活动性中重度甲状腺眼病（TED）受试者中开展II期试验，评价T1 10 mg/kg静脉输注每4周一次相比安慰剂，在第24周降低突眼（突眼回退≥2 mm）的优效性。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户明确研究为随机双盲安慰剂对照、治疗24周、主要终点为第24周突眼回退≥2mm受试者比例。\"\n      }\n    ],\n    \"secondary\": [\n      {\n        \"text\": \"评价T1对TED其他临床活动性/严重度指标的影响（如CAS、复视、眼球运动、GO-QoL等）。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"II期TED试验常用次要终点以支持获益-风险评估；具体指标需根据方案确认。\"\n      },\n      {\n        \"text\": \"评价T1的安全性与耐受性（AE/SAE、输注相关反应、感染、听力/血糖等抗IGF-1R相关风险）。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"抗IGF-1R单克隆抗体需关注安全性与耐受性；当前输入未列具体安全终点。\"\n      }\n    ],\n    \"questions\": [\n      \"需确认次要终点的具体指标、测量时点和分析次序（如CAS、复视、GO-QoL、影像学指标、安全终点）。\"\n    ]\n  },\n  \"endpoint\": {\n    \"primary_endpoint\": {\n      \"text\": \"第24周突眼回退≥2 mm的受试者比例。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户明确主要终点为第24周突眼回退≥2mm受试者比例。\"\n    },\n    \"key_secondary\": [\n      {\n        \"text\": \"第24周CAS较基线改善≥2分或CAS=0/1的受试者比例。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"CAS是TED活动性的常用指标；但当前输入未确认，需作为建议备选。\"\n      },\n      {\n        \"text\": \"第24周复视改善或复视消失的受试者比例。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"复视是TED重要临床负担，常作为关键次要终点；需方案确认。\"\n      },\n      {\n        \"text\": \"第24周GO-QoL生活质量评分较基线变化。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"患者报告结局可补充临床终点；需确认量表版本和分析方式。\"\n      }\n    ],\n    \"measurement_details\": \"建议主要终点采用标准化Hertel突眼计，固定眼别、参照点和测量者，并在盲态下由经过培训的评估者测量；若采用影像学（CT/MRI）需预先规定阅片和阈值。具体测量方法尚需确认。\",\n    \"questions\": [\n      \"需确认突眼测量的具体方法（Hertel exophthalmometry vs 影像学）、眼别定义、测量时间窗及中心/盲态阅片流程。\"\n    ]\n  },\n  \"estimand\": {\n    \"treatment\": {\n      \"text\": \"随机分配至T1 10 mg/kg静脉输注每4周一次或匹配安慰剂静脉输注每4周一次（输注体积与外观匹配以保持双盲）；两臂允许背景稳定糖皮质激素维持原方案，试验期间原则上不新启或加量；戒烟辅导两臂一致。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户明确给药方案、安慰剂匹配方式、背景稳定糖皮质激素和戒烟辅导两臂一致。\"\n    },\n    \"population\": {\n      \"text\": \"活动性中重度甲状腺眼病（TED）患者，具体入组标准需按方案确认。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户明确研究人群为活动性中重度TED。\"\n    },\n    \"variable\": {\n      \"text\": \"从基线至第24周突眼回退≥2 mm的二分变量（是/否）。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户明确主要终点为第24周突眼回退≥2mm受试者比例。\"\n    },\n    \"ice_strategy\": {\n      \"text\": \"建议主要估计目标对研究治疗停药、背景糖皮质激素方案外新启/加量、抢救治疗等采用治疗政策（treatment policy）策略，即无论是否发生这些事件均按随机分组分析第24周主要终点；对直接改变眼眶解剖的手术等事件，预设为不可评价或采用假想策略，并开展敏感性分析。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"当前输入未规定intercurrent events处理策略；治疗政策策略通常最接近随机化所定义的意向性治疗效应，但需结合TED抢救/手术的临床影响确认。\"\n    },\n    \"ice_events\": [\n      \"因缺乏疗效或疾病进展接受抢救治疗\",\n      \"研究药物提前停用\",\n      \"背景糖皮质激素方案外新启或加量\",\n      \"接受TED相关手术或放疗\",\n      \"失访或主要终点缺失\"\n    ],\n    \"summary_measure\": {\n      \"text\": \"T1组与安慰剂组第24周突眼回退≥2 mm受试者比例的组间差异（风险差），报告95%置信区间和双侧p值。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"主要终点为二分比例且比较安慰剂，组间风险差直观且可用于优效性检验；具体模型需确认。\"\n    },\n    \"questions\": [\n      \"需确认intercurrent events定义及其处理策略，尤其是抢救治疗、手术、糖皮质激素加量和停药后主要终点如何采集与判定。\",\n      \"需确认主要分析人群（ITT/mITT/PP）及其与估计目标的一致性。\"\n    ]\n  },\n  \"sample_size\": {\n    \"assumptions\": [\n      \"安慰剂组第24周突眼回退≥2 mm比例约20%\",\n      \"T1组第24周突眼回退≥2 mm比例约50%\",\n      \"双侧α=0.05\",\n      \"检验效能80%\",\n      \"1:1随机分配\",\n      \"预计失访/不可评价约10%\",\n      \"本样本量计算暂未计入期中分析；若计划期中分析需重新计算\"\n    ],\n    \"alpha\": \"双侧α=0.05\",\n    \"power\": \"80%\",\n    \"model\": \"两独立比例比较，主要采用风险差（T1−安慰剂）及95%置信区间，可选用Z检验、Fisher精确检验或CMH检验；分层因素需确认。\",\n    \"planned_n\": \"约80例（计划1:1随机，T1组约40例，安慰剂组约40例）\",\n    \"attrition\": \"预计10%失访/不可评价，样本量按可评价例数向上调整。\",\n    \"justification\": \"在安慰剂组应答率20%、T1组应答率50%、双侧α=0.05、power=80%、1:1随机、失访10%的假设下，每组约需40例，总约80例，与计划约80例一致；若预期应答率、效应量或分析模型变化，需重新估计。\",\n    \"references\": [],\n    \"questions\": [\n      \"需确认样本量假设中的安慰剂组和T1组第24周应答率（20% vs 50%）是否合理。\",\n      \"需确认主要分析模型、分层因素、随机化比例和失访率假设。\"\n    ]\n  },\n  \"interim_planning\": null,\n  \"non_inferiority_margin\": null,\n  \"questions\": [\n    \"需确认是否计划期中分析；若计划，需提供信息分数、目的、决策规则、职责及对最终分析的影响。\",\n    \"需确认活动性中重度TED的具体诊断和入组标准（CAS阈值、突眼程度、病程、甲状腺功能状态、既往治疗/糖皮质激素使用限制）。\",\n    \"需确认主要终点突眼测量的具体方法、眼别定义、测量时间窗及中心/盲态阅片流程。\",\n    \"需确认主要分析估计目标中的intercurrent events及处理策略。\",\n    \"需确认样本量假设、主要分析模型、随机化比例、分层因素和失访率。\"\n  ],\n  \"unresolved_questions\": []\n}","receipt":{"idempotency_key":"design-elements.generate.v1","input_artifacts":[{"ref":"design-elements-intake","sha256":"b55ebe1965c8ad509bff77c60e12075ad946e91ff4f2daf42f1f5b72e7886798"}],"logical_call_id":"call:design-elements:fcb7f1a34f68008ce57aa3e6fb1b011ab01d4cdd6971bf31f4a7f7da34db9ebb:design-generate","node_execution_contract_id":"nec:design-elements:fcb7f1a34f68008ce57aa3e6fb1b011ab01d4cdd6971bf31f4a7f7da34db9ebb:design-generate","observed_model":"deepseek-latest-cloud","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/design-elements-output.v1.json","output_sha256":"f9245f4bb6f0346855d29a9590c85339d6aad36d6a12f82490e49d3f257b53cc","prompt_sha256":"21bf2955294ee9cc2fd35ad41a9fec8e8279bf3e566b47d7babf7c624d527a38","provider_session_id":"d95b2204-1c26-4b4a-83cb-ebfcb3fc52b5","requested_reasoning_effort":"max"},"schema":"model_response.v1"}