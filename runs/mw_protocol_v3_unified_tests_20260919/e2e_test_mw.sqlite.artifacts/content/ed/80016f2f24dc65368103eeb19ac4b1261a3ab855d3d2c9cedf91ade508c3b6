{"content":"{\"chapters\":{\"v2_front_block\":{\"framing.document_title\":{\"title\":\"评价合成药E1治疗子宫内膜异位症相关盆腔疼痛的有效性和安全性的随机、双盲、安慰剂对照、多中心II期临床研究\"}},\"v2_n_10_1_1\":{\"ae.chapter_scope_framing\":{\"description\":\"本章适用于本研究中不良事件的识别、记录、评估和报告。\"},\"ae.definition\":{\"description\":\"不良事件指受试者接受试验用药品后出现的任何不良医学事件，不一定与试验用药品有因果关系。\"},\"ae.oncology_progression_exception_applicable\":false,\"ae.pre_existing_condition_handling\":{\"description\":\"签署知情同意书前已存在的症状、疾病或病史，若在知情后无变化，不作为不良事件；若知情后加重或出现新发事件，应作为不良事件记录。\"},\"ae.teaee_derivation\":{\"description\":\"治疗期出现的不良事件定义为首次给予试验用药品后至安全随访期结束期间新发生或加重的不良事件。\"},\"ae.temporal_window_definition\":{\"description\":\"治疗期出现的不良事件时间窗为首次给予试验用药品至安全随访期结束。\"}},\"v2_n_10_1_2\":{\"ae.severity_grading_definition\":{\"description\":\"不良事件严重程度按NCI CTCAE标准进行分级，1级为轻度，2级为中度，3级为重度，4级为危及生命，5级为死亡。\"},\"ae.severity_seriousness_distinctness\":{\"description\":\"严重程度与严重性不同；严重程度描述事件的强度，严重性按严重不良事件标准判断。\"}},\"v2_n_10_1_3\":{\"causality.five_level_terminology\":{\"levels\":[\"肯定相关\",\"很可能相关\",\"可能相关\",\"可能无关\",\"无关\"]},\"causality.judgment_method\":{\"description\":\"由研究者根据时间关系、药理学机制、既往史、停药后反应、再次用药反应等综合判断。\"}},\"v2_n_10_1_4\":{\"ae.ae_collection_not_teaee_classification\":{\"description\":\"收集所有不良事件，不限于治疗期出现的不良事件；治疗期出现的不良事件另行归类。\"},\"ae.collection_period_definition\":{\"description\":\"自受试者签署知情同意书开始，至安全随访期结束（末次访视）为止收集不良事件。\"},\"ae.collection_period_start_reference\":{\"reference\":\"签署知情同意书\"},\"ae.collection_stop_reference\":{\"reference\":\"安全随访期结束（末次访视）\"},\"ae.consent_history_distinction\":{\"description\":\"签署知情同意书前已存在的症状、疾病或病史，若在知情后无变化，不作为不良事件；若知情后加重或出现新发事件，应作为不良事件记录。\"}},\"v2_n_10_1_5\":{\"ae.recording_requirements\":{\"description\":\"记录不良事件名称、发生时间、严重程度、与试验用药品相关性、采取措施、结局等。\"},\"ae.report_time_selection_rule\":{\"description\":\"以不良事件初次发生时间作为报告时间选择依据。\"},\"ae.separate_times\":{\"description\":\"区分不良事件开始日期、报告日期及方案规定的评估时间点。\"}},\"v2_n_10_1_6\":{\"ae.followup_duration_or_end\":{\"description\":\"随访至不良事件解决、恢复至基线或稳定，或至安全随访期结束，以先发生者为准。\"},\"ae.followup_scope\":{\"description\":\"对所有不良事件进行随访；严重不良事件及导致停药的不良事件应随访至事件解决或稳定。\"},\"ae.ongoing_event_handling\":{\"description\":\"若末次访视时不良事件仍未解决，应在安全随访期结束后继续随访，直至事件解决或稳定，或由研究者判断无需继续随访。\"}},\"v2_n_10_2_1\":{\"sae.definition\":{\"description\":\"严重不良事件指在试验过程中发生的任何不良医学事件，满足以下一项或多项标准：死亡、危及生命、需要住院或延长住院、持续或严重残疾/失能、先天性异常/出生缺陷、其他重要医学事件。\"},\"sae.seriousness_criteria\":{\"criteria\":[\"死亡\",\"危及生命\",\"需要住院或延长住院\",\"持续或严重残疾/失能\",\"先天性异常/出生缺陷\",\"其他重要医学事件\"]},\"sae.severity_seriousness_distinctness\":{\"description\":\"严重程度与严重性不同；严重程度描述事件的强度，严重性按严重不良事件标准判断。\"}}}}","receipt":{"idempotency_key":"chapter-facts.derive.v1","input_artifacts":[{"ref":"chapter-facts-input","sha256":"971fac0acf92c66fd0f3f189684431572d61c96c4e70720ba3f646782f630317"}],"logical_call_id":"call:chapter-facts:971fac0acf92c66fd0f3f189684431572d61c96c4e70720ba3f646782f630317","node_execution_contract_id":"nec:chapter-facts:971fac0acf92c66fd0f3f189684431572d61c96c4e70720ba3f646782f630317","observed_model":"deepseek-latest-cloud","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/chapter-facts-output.v1.json","output_sha256":"8b3d62eab6da0519c45f20456a7aad71bf01cd27dda71705da7b88d20c43f2ac","prompt_sha256":"81a4f629a6890c6f801162e4a74b9ab00ea246faf6b827f82fb3d8a5fee50daf","provider_session_id":"0504e16a-9a6b-4e89-bbef-09bcba184453","requested_reasoning_effort":"max"},"schema":"model_response.v1"}