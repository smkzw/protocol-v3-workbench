{"content":"{\n  \"status\": \"ready_for_review\",\n  \"objectives\": {\n    \"primary\": [\n      {\n        \"text\": \"在活动性中重度TED受试者中，评估T1 10 mg/kg每4周静脉输注相较于匹配安慰剂在第24周对突眼回退的优效性，主要比较第24周研究眼突眼回退≥2 mm的受试者比例。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户资料明确主要终点为第24周突眼回退≥2 mm受试者比例，并采用随机双盲安慰剂对照、1:1随机化。\",\n        \"references\": []\n      }\n    ],\n    \"secondary\": [\n      {\n        \"text\": \"评估T1相较于安慰剂在第24周研究眼突眼回退量的连续变化。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"作为主要二元应答终点的补充，可反映突眼回退幅度；与已确认主要终点测量方式一致。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"评估T1相较于安慰剂在第24周临床活动评分（CAS）的应答或变化。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"TED活动性是确认人群的核心特征，CAS变化可作为次要疗效维度。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"评估T1相较于安慰剂在第24周复视、生活质量及总体临床应答的变化。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"中重度TED患者常伴复视和生活质量受损，可作为支持性疗效终点。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"评估T1的安全性和耐受性，包括治疗中出现的不良事件、输液相关反应和甲状腺功能变化。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"II期试验需同步评估试验药物安全性和耐受性。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"评估T1的免疫原性（抗药抗体）及必要的药代动力学特征。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"抗IGF-1R单克隆抗体静脉输注的II期研究通常需评估免疫原性和暴露特征。\",\n        \"references\": []\n      }\n    ],\n    \"questions\": []\n  },\n  \"endpoint\": {\n    \"primary_endpoint\": {\n      \"text\": \"第24周（±7天）研究眼（基线突眼较大眼）突眼回退≥2 mm的受试者比例。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户资料明确主要终点为第24周突眼回退≥2 mm受试者比例，研究眼为基线突眼较大眼。\",\n      \"references\": []\n    },\n    \"measurement_details\": \"使用Hertel突眼计测量研究眼；第24周±7天；由同一经过培训且对治疗分配保持盲态的测量者测量；主要分析为第24周研究眼突眼回退≥2 mm应答率的组间比较。\",\n    \"key_secondary\": [\n      {\n        \"text\": \"第24周研究眼突眼回退量较基线的变化（mm）。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"连续突眼变化可补充二元应答率，反映回退幅度。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"第24周CAS应答率或CAS较基线变化。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"CAS是TED活动性的核心指标，可作为次要疗效终点。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"第24周复视应答或复视较基线变化。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"复视是中重度TED的重要临床负担，可作为支持性疗效终点。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"第24周生活质量评分较基线变化。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"生活质量可反映患者感知获益，常用于TED临床试验次要终点。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"安全性和耐受性指标，包括不良事件、输液相关反应、甲状腺功能及实验室异常。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"II期试验需评估安全性，尤其是静脉输注单克隆抗体的输液相关反应。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"免疫原性（抗药抗体）及药代动力学特征。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"抗IGF-1R单克隆抗体的免疫原性和暴露特征有助于解释疗效与安全性。\",\n        \"references\": []\n      }\n    ],\n    \"questions\": []\n  },\n  \"estimand\": {\n    \"treatment\": {\n      \"text\": \"T1 10 mg/kg静脉输注，每4周一次，至第24周；对照为同途径、同频次静脉输注的匹配安慰剂，输注体积与外观匹配。两臂允许入组前已稳定的背景糖皮质激素且维持一致，戒烟辅导一致提供。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户资料明确剂量、途径、频次、匹配安慰剂、背景糖皮质激素和戒烟辅导要求。\",\n      \"references\": []\n    },\n    \"population\": {\n      \"text\": \"活动性中重度TED患者，符合7分CAS≥3（不含突眼项）、研究眼突眼较同种族正常值≥3 mm、活动期病程≤9个月、甲状腺功能正常或药物控制稳定；允许入组前已稳定的背景糖皮质激素，试验期间两臂一致维持，原则上不新启或加量。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户资料明确入组标准和背景糖皮质激素要求。\",\n      \"references\": []\n    },\n    \"variable\": {\n      \"text\": \"第24周研究眼突眼回退≥2 mm的二元应答指标；研究眼为基线突眼较大眼，使用Hertel突眼计测量。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户资料明确主要终点变量、研究眼和测量工具。\",\n      \"references\": []\n    },\n    \"ice_strategy\": {\n      \"text\": \"对提前停药：采用治疗策略，提前停药后仍尽量完成第24周评估并纳入主要分析；对补救治疗（全身激素冲击、眼眶减压等）：采用复合策略，发生后该受试者主要终点计为未应答；若试验期间新启或加量背景糖皮质激素，建议按方案预先定义的补救治疗同类处理（计为未应答），否则按方案偏离记录并继续随访。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"用户资料明确提前停药治疗策略和补救治疗后计为未应答；对新启或加量背景糖皮质激素的ICE处理资料未明确，故给出与补救治疗一致的保护性推荐。\",\n      \"references\": []\n    },\n    \"ice_events\": [\n      \"提前停药\",\n      \"补救治疗（全身激素冲击、眼眶减压等）\",\n      \"背景糖皮质激素新启或加量（若发生）\"\n    ],\n    \"summary_measure\": {\n      \"text\": \"第24周应答率的组间差值（T1组 - 安慰剂组），采用风险差及95%置信区间，并进行优效性检验。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"用户资料明确主要分析为第24周应答率的组间比较；风险差是二元终点常用的汇总指标，便于临床解释。\",\n      \"references\": []\n    },\n    \"questions\": []\n  },\n  \"interim_planning\": null,\n  \"non_inferiority_margin\": null,\n  \"sample_size\": {\n    \"assumptions\": [\n      \"主要终点第24周研究眼突眼回退≥2 mm应答率：安慰剂组约20%，T1组约50%。\",\n      \"双侧α=0.05。\",\n      \"把握度=80%。\",\n      \"随机化比例1:1，按吸烟状态分层。\",\n      \"失访率约10%。\",\n      \"主要分析模型：两独立样本比例比较（风险差），可辅以Cochran-Mantel-Haenszel检验或Logistic回归调整吸烟状态分层。\"\n    ],\n    \"alpha\": \"0.05（双侧）\",\n    \"power\": \"80%\",\n    \"model\": \"两独立样本比例比较（风险差）；主要分析可采用Cochran-Mantel-Haenszel检验或Logistic回归调整吸烟状态分层；样本量按两比例比较公式计算。\",\n    \"planned_n\": \"约80例，每臂约40例（随机化）；按10%失访，预计每臂约36例可评价，共约72例。\",\n    \"attrition\": \"约10%\",\n    \"justification\": \"基于安慰剂组应答率20%、T1组应答率50%、双侧α=0.05、把握度80%、1:1随机化，两比例比较每臂需约36例可评价；按10%失访需随机化每臂约40例，共约80例。该样本量与计划约80例一致。若真实安慰剂应答率更高或T1应答率更低，把握度下降，需重新评估样本量。\",\n    \"references\": [],\n    \"questions\": []\n  },\n  \"questions\": [],\n  \"unresolved_questions\": []\n}","receipt":{"idempotency_key":"design-elements.generate.v1","input_artifacts":[{"ref":"design-elements-intake","sha256":"f971217906817108c09b1f79390320a80dac5e2dc4f1a5a3a99e24731f3e163e"}],"logical_call_id":"call:design-elements:caecc39d07434bbd0400f41102b580044948aa2069e3106dc2b71b7e2ff313f2:design-generate","node_execution_contract_id":"nec:design-elements:caecc39d07434bbd0400f41102b580044948aa2069e3106dc2b71b7e2ff313f2:design-generate","observed_model":"deepseek-latest-cloud","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/design-elements-output.v1.json","output_sha256":"b83e12198926fbc6fb36547e7d8fc