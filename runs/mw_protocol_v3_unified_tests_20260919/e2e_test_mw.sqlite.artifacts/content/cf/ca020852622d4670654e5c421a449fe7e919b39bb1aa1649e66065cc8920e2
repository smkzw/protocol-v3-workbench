{"content":"{\n  \"chapters\": {\n    \"v2_n_12_4\": {\n      \"corrections.audit_trail\": {\n        \"description\": \"计算机化系统应开启并保存不可篡改的审计轨迹，记录数据修改前值、修改后值、修改人、修改日期和时间、修改原因及审核状态；原始记录不得被覆盖或删除。\",\n        \"requirements\": [\n          \"修改前后值可追溯\",\n          \"修改人身份和时间戳\",\n          \"修改原因\",\n          \"审核/批准记录\"\n        ]\n      },\n      \"corrections.procedure\": {\n        \"description\": \"数据修改应通过受控流程执行：由授权人员提出修改申请，提供源数据或质疑依据，经数据管理员或研究者审核批准后实施，并在EDC或源文件中保留修改记录和复核确认。\",\n        \"steps\": [\n          \"提出修改申请\",\n          \"提供修改依据\",\n          \"授权人员审核\",\n          \"实施修改\",\n          \"复核确认\"\n        ]\n      },\n      \"corrections.reason_record\": {\n        \"description\": \"每次数据修改必须记录具体原因，包括但不限于数据录入错误、源数据核对、质疑解答、方案偏离更正、医学审核意见或系统迁移；原因应清晰、可审计。\"\n      },\n      \"corrections.review_approval\": {\n        \"description\": \"修改后数据须经研究者/授权人员及数据管理员审核批准；关键数据修改可能需医学监查员或申办方审核。审核人、批准日期和意见应记录在审计轨迹中。\"\n      }\n    },\n    \"v2_n_12_5\": {\n      \"lock_export.export_format\": {\n        \"description\": \"数据导出格式按申办方数据管理计划和监管提交要求确定，可使用CDISC SDTM/ADaM、SAS数据集、CSV或XML等受控格式，并附数据说明文件；导出文件应带版本和校验信息。\",\n        \"examples\": [\n          \"CDISC SDTM/ADaM\",\n          \"SAS XPT\",\n          \"CSV\",\n          \"XML\"\n        ]\n      },\n      \"lock_export.export_receipt\": {\n        \"description\": \"数据接收方应在接收后核对导出的完整性、可读性和版本，并签署或记录接收回执；回执应包括导出日期、数据范围、格式、校验结果和接收人。\"\n      },\n      \"lock_export.lock_authority\": {\n        \"description\": \"数据库锁定由申办方数据管理部门负责人或其授权人批准；锁定前应完成数据清理、质疑关闭、方案偏离审核和医学审核，相关角色包括数据管理员、研究者、统计师和医学监查员。\"\n      },\n      \"lock_export.lock_criteria\": {\n        \"description\": \"数据库锁定标准包括：所有受试者数据录入完成、质疑关闭、严重不良事件和方案偏离已审核、数据修改已批准、统计分析计划定稿并签署、必要时的盲态审核完成。\"\n      }\n    },\n    \"v2_n_12_6\": {\n      \"data_governance.access_controls\": {\n        \"description\": \"计算机化系统按角色分配最小必要权限，使用唯一账户和强密码或双因素认证；访问权限经授权、定期复核，人员离职或角色变更时及时撤销；生产环境与测试环境分离。\"\n      },\n      \"data_governance.change_management\": {\n        \"description\": \"系统变更应通过受控变更管理流程，评估影响、测试、批准、实施和记录；变更前后版本可追溯，关键变更需再验证。\"\n      },\n      \"data_governance.record_integrity\": {\n        \"description\": \"遵循ALCOA+原则确保电子记录完整、准确、一致、持久和可用；电子签名和记录符合适用法规（如21 CFR Part 11、EU Annex 11），审计轨迹开启且不可停用。\"\n      },\n      \"data_governance.system_roles\": {\n        \"description\": \"系统角色包括系统管理员、数据管理员、研究者/授权研究者、监查员、统计师、稽查员和只读用户等；角色职责在权限矩阵中定义，关键操作职责分离。\"\n      },\n      \"data_governance.validation_status\": {\n        \"description\": \"用于关键数据采集和管理的计算机化系统应经过验证，验证状态在系统生命周期内保持；验证包括用户需求、风险评估、安装/运行/性能确认、变更控制和定期回顾。\"\n      }\n    },\n    \"v2_n_12_7\": {},\n    \"v2_n_12_8\": {\n      \"retention.custody\": {\n        \"description\": \"研究者/试验机构负责保存试验相关记录，申办方负责保存其控制的试验文件；双方在合同或协议中明确保管责任和转移交接。\"\n      },\n      \"retention.disposition\": {\n        \"description\": \"保存期满后，按申办方SOP和适用法规进行销毁或去标识化处理；销毁需经授权并记录，确保保密性；如涉及法规稽查或诉讼，应暂停销毁。\"\n      },\n      \"retention.duration\": {\n        \"description\": \"根据适用的药品监管法规和机构政策保存；通常自临床试验终止后至少保存至上市许可申请获批后若干年或按ICH E6(R2)/当地法规要求，具体期限在协议或数据管理计划中规定。\"\n      },\n      \"retention.record_types\": {\n        \"description\": \"包括但不限于方案及修正案、伦理批件、知情同意文件、源数据、病例报告表/eCRF、电子日记卡数据、药物管理记录、监查记录、不良事件/严重不良事件记录、统计分析文件、数据锁定和导出记录。\"\n      },\n      \"retention.storage_location\": {\n        \"description\": \"保存在符合保密、防火、防潮、防未授权访问的受控场所；电子记录保存在经过验证的计算机化系统中，并有备份和灾难恢复措施。\"\n      },\n      \"retention.trigger\": {\n        \"description\": \"保存期限自临床试验终止或相关法规规定的事件（如末例受试者末次访视、研究结束、上市申请获批）发生时开始计算，具体以适用法规和协议为准。\"\n      }\n    },\n    \"v2_n_12_9\": {\n      \"publication.actual_agreements\": {\n        \"description\": \"发表和数据共享安排应在相关合同或协议中事先明确；研究者、申办方和合作方之间签署的协议应规定发表审查、作者资格、数据共享和保密条款。\"\n      },\n      \"publication.authorship_roles\": {\n        \"description\": \"作者资格按ICMJE标准确定，基于实质性贡献、起草或修改、最终批准和同意负责；角色包括第一作者、通讯作者、共同作者和申办方资助角色，贡献在投稿时声明。\"\n      },\n      \"publication.data_sharing_conditions\": {\n        \"description\": \"数据共享需在保护受试者隐私、遵守知情同意、伦理批件、法规和合同的前提下进行；共享去标识化数据需经申办方/研究者和数据管理/法务审核，并签署数据共享协议。\"\n      },\n      \"publication.disclosure_plan\": {\n        \"description\": \"研究结果应在试验完成后按适用法规和申办方政策公开披露，包括在公共注册平台更新结果、发表论文或报告；披露时间和方式遵循ICH E6(R2)、ICMJE和当地要求。\"\n      },\n      \"publication.recipient_controls\": {\n        \"description\": \"数据接收方须经批准并签署保密和数据使用协议，限定使用目的、安全保存、不得再共享或重新识别受试者；违反者按协议和法规处理。\"\n      }\n    },\n    \"v2_n_13_1\": {\n      \"ethics.approval_status\": {\n        \"description\": \"研究方案、知情同意书、招募材料和任何修正案须在实施前获得独立伦理委员会/机构审查委员会批准；未获批准不得入组受试者或实施相关程序。\"\n      },\n      \"ethics.before_procedure_confirmation\": {\n        \"description\": \"在受试者接受任何筛选或研究相关程序前，须确认伦理批件有效、知情同意已签署、受试者符合入排标准，并完成授权和培训。\"\n      },\n      \"ethics.new_information_handling\": {\n        \"description\": \"出现可能影响受试者安全或继续参加研究意愿的新信息时，应及时报告伦理委员会，必要时修改方案或知情同意书并重新获取同意。\"\n      },\n      \"ethics.prospective_review_procedure\": {\n        \"description\": \"前瞻性审查包括方案初次审查和修正案审查；申办方/研究者提交审查材料，伦理委员会出具批件、意见或否决，研究按批件和法规执行。\"\n      },\n      \"ethics.responsible_role\": {\n        \"description\": \"主要研究者负责确保研究符合伦理、法规和方案；申办方负责质量管理、监查和稽查；伦理委员会负责审查和监督；受试者安全相关决策由研究者或医学监查员按方案处理。\"\n      },\n      \"ethics.version_control\": {\n        \"description\": \"方案、知情同意书和其他伦理文件使用版本号和日期控制；只有当前批准的版本可使用，旧版本存档，变更记录可追溯。\"\n      }\n    },\n    \"v2_n_13_2\": {\n      \"consent.before_relevant_procedure\": {\n        \"description\": \"在受试者接受任何研究相关程序（包括筛选、停药、采样、影像或研究用药）前，必须获得签署并注明日期的知情同意书。\"\n      },\n      \"consent.capacity_or_representative\": {\n        \"description\": \"受试者须具备自主知情同意能力；如适用，对无同意能力者由法定代理人或法定监护人代表同意，并在受试者恢复能力后重新获取同意；具体按当地法规和伦理要求。\"\n      },\n      \"consent.new_information_handling\": {\n        \"description\": \"当出现可能影响受试者继续参加意愿的新信息时，应及时告知受试者，必要时重新签署知情同意书；已入组受试者应获知并记录。\"\n      },\n      \"consent.procedure\": {\n        \"description\": \"知情同意过程包括研究者或授权人员以受试者能理解的语言提供研究目的、程序、风险、受益、替代治疗、保密、补偿、数据使用和自愿退出等信息；给受试者充分时间提问，签署并注明日期，双方各留一份。\"\n      },\n      \"consent.responsible_role\": {\n        \"description\": \"知情同意由主要研究者或其授权的具备资质的研究人员获取；研究者负责确保过程符合法规、方案和伦理要求，并确保受试者自愿同意。\"\n      },\n      \"consent.version\": {\n        \"description\": \"使用伦理委员会批准的当前版本知情同意书，包含版本号和日期；更新后仅使用新批准版本，旧版本存档。\"\n      },\n      \"consent.witness_if_applicable\": {\n        \"description\": \"如受试者或法定代理人不能阅读，应使用公正见证人；见证人见证知情同意过程并在知情同意书上签名和注明日期。如适用，按伦理委员会和当地法规要求执行。\"\n      }\n    }\n  }\n}","receipt":{"idempotency_key":"chapter-facts.derive.v1","input_artifacts":[{"ref":"chapter-facts-input","sha256":"6260830a3c4d5cc7236a3febd6c7d1036979a36d34b5c866eb00fd5fabeca017"}],"logical_call_id":"call:chapter-facts:6260830a3c4d5cc7236a3febd6c7d1036979a36d34b5c866eb00fd5fabeca017","node_execution_contract_id":"nec:chapter-facts:6260830a3c4d5cc7236a3febd6c7d1036979a36d34b5c866eb00fd5fabeca017","observed_model":"deepseek-latest-cloud","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/chapter-facts-output.v1.json","output_sha256":"0cea270ada1b563e75ae104bdd851589a8f56a59806ac1997d5215042e7f453e","prompt_sha256":"81a4f629a6890c6f801162e4a74b9ab00ea246faf6b827f82fb3d8a5fee50daf","provider_session_id":"ef2ff8cd-f2cc-4684-9137-9ea172742d3d","requested_reasoning_effort":"max"},"schema":"model_response.v1"}