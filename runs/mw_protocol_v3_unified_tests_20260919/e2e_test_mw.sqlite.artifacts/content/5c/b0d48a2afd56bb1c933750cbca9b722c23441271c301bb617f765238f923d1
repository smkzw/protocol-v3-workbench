{"content":"{\"chapters\":{\"v2_n_11_1\":{\"framing.structured_design.allocation_ratio\":{\"ratio\":\"1:1\",\"experimental_group\":\"合成药E1组约75例\",\"control_group\":\"安慰剂组约75例\",\"total\":\"计划入组约150例\"},\"framing.structured_design.hypothesis\":{\"type\":\"差异性/优效性检验\",\"null_hypothesis\":\"第12周盆腔疼痛VAS评分较基线变化值的组间均值差异为0，即合成药E1组与安慰剂组相同。\",\"alternative_hypothesis\":\"第12周盆腔疼痛VAS评分较基线变化值的组间均值差异为15mm，即合成药E1组较安慰剂组多降低15mm。\",\"alpha\":\"双侧检验水准alpha=0.05\",\"power\":\"90%\"},\"statistics.sample_size.dose_alignment\":{\"dose\":\"合成药E1片10mg口服每日一次，每次1片；安慰剂为外观匹配片，口服每日一次，每次1片。\",\"alignment\":\"样本量估算基于该给药方案及第12周主要终点。\"},\"statistics.sample_size.interim_applicable\":false,\"statistics.sample_size.reproducible_result\":{\"software\":\"PASS 15\",\"inputs\":{\"between_group_difference_mm\":15,\"common_sd_mm\":25,\"alpha\":0.05,\"power\":0.9,\"allocation_ratio\":\"1:1\",\"attrition\":\"约20%\"},\"result\":\"每组约需60例可评价病例；考虑约20%脱落后，每组约75例，总计约150例。\"},\"statistics.sample_size.sidedness\":{\"sidedness\":\"双侧检验\",\"alpha\":\"0.05\"},\"statistics.sample_size.soa_alignment\":{\"primary_endpoint\":\"治疗第12周时盆腔疼痛VAS评分较基线的变化值\",\"baseline_definition\":\"随机前连续28天筛选期内电子日记卡记录的每日盆腔疼痛VAS评分平均值\",\"week12_definition\":\"第12周（Day 84±3天）评估前7天每日VAS评分均值\",\"alignment\":\"样本量估算与主要终点定义及SoA第12周访视一致。\"},\"statistics.sample_size.software_version\":{\"software\":\"PASS 15\"},\"statistics.sample_size.test_model\":{\"model\":\"两样本均数比较（双侧t检验）或等价的两组独立样本均值差异检验；主要分析可推荐采用ANCOVA调整基线VAS，但样本量按PASS 15中两组均值差异检验计算。\"}},\"v2_n_11_2\":{\"statistics.analysis_sets.available_assessments\":{\"definition\":\"在指定访视具有可评价盆腔疼痛VAS日记卡数据或其他相应终点评估的受试者集合；用于描述性统计和敏感性分析中实际可获得评估的汇总，不替代主要疗效分析集。\"},\"statistics.analysis_sets.grouping_rules\":{\"efficacy\":\"按随机分组分析，即合成药E1 10mg QD组与安慰剂组。\",\"safety\":\"按实际接受的治疗分组进行安全性汇总。\"},\"statistics.analysis_sets.handling_rules\":{\"intercurrent_events\":\"治疗期间使用抢救性止痛药者仍保留在随机分组中，主要分析记录该伴发事件并采用治疗策略；敏感性分析采用假想策略。\",\"missing_data\":\"按统计分析计划预先规定的缺失数据处理规则执行，主要疗效分析纳入所有随机受试者。\"},\"statistics.analysis_sets.inclusion_rules\":{\"full_analysis_set\":\"所有经随机化分配并接受随机编号的受试者均纳入主要疗效分析，不因依从性、合并用药或治疗期间使用抢救性止痛药而排除。\",\"safety_set\":\"所有至少接受一剂研究药物（合成药E1或安慰剂）的受试者纳入安全性分析。\"},\"statistics.analysis_sets.randomized\":{\"name\":\"全分析集/意向性分析集\",\"definition\":\"所有随机受试者，按随机分组进行分析；主要疗效分析使用该分析集。\",\"size\":\"计划约150例，合成药E1组约75例，安慰剂组约75例。\"},\"statistics.analysis_sets.rescue_treated_handling\":{\"definition\":\"治疗期间使用指定抢救性止痛药（布洛芬片，每次不超过400mg，每日最高不超过1200mg）的受试者。\",\"primary_strategy\":\"治疗策略：不排除，按随机分组分析并记录伴发事件发生。\",\"sensitivity_strategy\":\"假想策略：在敏感性分析中评估未使用该抢救性止痛药情形下的治疗效应。\"},\"statistics.analysis_sets.treated\":{\"name\":\"安全性分析集\",\"definition\":\"所有至少接受一剂研究药物的受试者，按实际接受治疗分组进行安全性分析。\"}},\"v2_n_11_3\":{\"statistics.descriptive.intercurrent_event_distinction\":{\"definition\":\"描述性分析中应区分治疗期间使用抢救性止痛药等伴发事件与主要疗效终点变化；伴发事件发生单独汇总，不作为剔除受试者的依据。\",\"primary_ice\":\"治疗期间使用抢救性止痛药，限定布洛芬片，每次不超过400mg，每日最高不超过1200mg。\"},\"statistics.descriptive.missing_denominator_rules\":{\"continuous\":\"连续变量以该访视具有非缺失评估值的受试者为分母。\",\"categorical\":\"分类变量以该访视具有非缺失分类结果的受试者为分母。\",\"primary_analysis\":\"主要疗效分析的分母为所有随机受试者，缺失结局按主要估计目标对应规则处理。\"},\"statistics.descriptive.missing_outcome_handling\":{\"primary\":\"主要分析采用治疗策略，所有随机受试者纳入，不因治疗期间使用抢救性止痛药而剔除；缺失基线后VAS按统计分析计划预先规定的方法处理。\",\"sensitivity\":\"敏感性分析采用假想策略处理伴发事件及相应缺失结局。\"},\"statistics.descriptive.summary_conventions\":{\"continuous\":\"报告n、均值、标准差、中位数、最小值和最大值。\",\"categorical\":\"报告频数和百分比。\",\"safety\":\"不良事件和合并用药按例数、例次和百分比汇总。\"},\"statistics.descriptive.variable_types\":{\"continuous\":[\"盆腔疼痛VAS评分\",\"痛经评分\",\"非经期盆腔疼痛评分\",\"性交痛评分\",\"EHP-30生活质量量表评分\",\"年龄\",\"身高\",\"体重\",\"BMI\",\"生命体征\"],\"categorical\":[\"不良事件\",\"合并用药\",\"抢救性止痛药使用\",\"完全缓解率\",\"治疗依从性分类\"],\"time_to_event\":[\"首次使用抢救性止痛药时间\"]},\"statistics.sap.analysis_unblinding_alignment\":{\"alignment\":\"统计分析计划在数据库锁定和揭盲前定稿；分析按随机分组进行，本研究不计划期中分析，不进行期中揭盲。\"},\"statistics.sap.revision_linkage\":{\"linkage\":\"统计分析计划版本与方案版本关联；任何修订均记录修订历史，并说明对分析集、终点定义和统计方法的影响。\"},\"statistics.sap.status\":{\"status\":\"在数据库锁定和揭盲前定稿；不设立独立数据监查委员会，不进行期中分析，不消耗alpha。\"},\"statistics.sap.timing\":{\"primary_analysis\":\"在双盲治疗期第12周主要终点数据完成后、数据库锁定后进行主要分析。\",\"final_safety_analysis\":\"在4周安全随访期完成后进行最终安全性分析。\"}},\"v2_n_11_4_1\":{\"statistics.demographics.baseline_variables\":{\"variables\":[\"年龄\",\"身高\",\"体重\",\"BMI\",\"生命体征\",\"子宫内膜异位症诊断信息\",\"基线盆腔疼痛VAS评分\",\"基线痛经评分\",\"基线非经期盆腔疼痛评分\",\"基线性交痛评分\",\"基线EHP-30评分\",\"既往用药史\",\"合并疾病\"]},\"statistics.demographics.data_definition\":{\"baseline_vas\":\"随机前连续28天筛选期内电子日记卡记录的每日盆腔疼痛VAS评分平均值。\",\"other_baseline\":\"随机前最后一次非缺失评估值。\"},\"statistics.demographics.summary_methods\":{\"continuous\":\"按治疗组汇总n、均值、标准差、中位数、最小值和最大值。\",\"categorical\":\"按治疗组汇总频数和百分比。\"},\"statistics.demographics.variable_types\":{\"continuous\":[\"年龄\",\"身高\",\"体重\",\"BMI\",\"VAS评分\",\"痛经评分\",\"非经期盆腔疼痛评分\",\"性交痛评分\",\"EHP-30评分\"],\"categorical\":[\"诊断信息\",\"既往用药史\",\"合并疾病\",\"生命体征异常\"]}},\"v2_n_11_4_2\":{\"statistics.adherence.data_definition\":{\"definition\":\"依从性基于双盲治疗期12周内研究药物给药记录，计划给药为每日一次、每次1片。\",\"calculation\":\"实际服用片数与计划服用片数的比例。\"},\"statistics.adherence.definition\":{\"definition\":\"受试者在双盲治疗期实际服用研究药物剂量占计划剂量的比例。\"},\"statistics.adherence.denominator\":{\"denominator\":\"安全性分析集中至少接受一剂研究药物且有给药记录的受试者。\"},\"statistics.adherence.measurement_method\":{\"method\":\"通过药物发放/回收计数、受试者日记卡或电子给药记录计算。\"},\"statistics.concomitant_treatment.definition\":{\"definition\":\"除研究药物外，在筛选期至安全随访期结束期间使用的任何药物或治疗，包括指定抢救性止痛药、背景治疗及其他允许或禁止用药。\"},\"statistics.concomitant_treatment.timing\":{\"recording_window\":\"从签署知情同意至安全随访期结束。\",\"rescue_analgesic\":\"治疗期间仅允许布洛芬片作为抢救性止痛药，每次不超过400mg，每日最高不超过1200mg；受试者每日电子日记卡记录用量；每次访视疼痛评估前48小时内禁止服用抢救止痛药。\",\"prohibited\":\"禁止使用其他激素类药物，如GnRH激动剂、孕激素、口服避孕药等。\"}},\"v2_n_11_4_3_1\":{\"estimand.primary.intercurrent_events\":{\"event\":\"治疗期间使用抢救性止痛药\",\"details\":\"限定布洛芬片，每次不超过400mg，每日最高不超过1200mg。\",\"primary_strategy\":\"治疗策略：无论是否发生该伴发事件，均按随机分组分析所有随机受试者并记录伴发事件发生。\",\"sensitivity_strategy\":\"假想策略。\"},\"estimand.primary.population\":{\"population\":\"确诊为子宫内膜异位症伴中重度盆腔疼痛的育龄期女性患者。\",\"randomization\":\"计划入组约150例，按1:1随机分配至合成药E1组（约75例）或安慰剂组（约75例）。\",\"analysis_population\":\"主要估计目标分析所有随机受试者。\"},\"estimand.primary.treatment_condition\":{\"experimental\":\"合成药E1片10mg，口服，每日一次，每次1片。\",\"control\":\"外观匹配安慰剂片，口服，每日一次，每次1片。\",\"blinding\":\"双盲。\"},\"statistics.primary_analysis.analysis_set\":{\"analysis_set\":\"所有随机受试者，即全分析集/意向性分析集，按随机分组。\"},\"statistics.primary_analysis.dose_consistency\":{\"consistency\":\"合成药E1为10mg/片，每日一次，每次1片；安慰剂为外观匹配模拟片，每日一次，每次1片；与样本量假设和给药方案一致。\"},\"statistics.primary_analysis.effect_measure\":{\"effect_measure\":\"第12周时盆腔疼痛VAS评分较基线变化值的组间均值差异，即合成药E1组减安慰剂组。\"},\"statistics.primary_analysis.estimand_linkage\":{\"linkage\":\"主要分析对应主要估计目标：人群为所有随机受试者，变量为第12周VAS较基线变化值，伴发事件采用治疗策略，效应量为组间均值差异。\"},\"statistics.primary_analysis.method\":{\"method\":\"主要分析可采用ANCOVA调整基线VAS，治疗组为固定效应，基线VAS为协变量；样本量按PASS 15中两组均值差异检验计算。\"},\"statistics.primary_analysis.missing_data\":{\"handling\":\"主要分析纳入所有随机受试者，采用治疗策略；缺失基线后VAS按统计分析计划预先规定的方法处理，不因治疗期间使用抢救性止痛药而剔除受试者。\"},\"statistics.primary_analysis.soa_consistency\":{\"consistency\":\"基线定义为随机前连续28天筛选期内电子日记卡每日盆腔疼痛VAS评分平均值；第12周终点为Day 84±3天评估前7天每日VAS评分均值；与SoA一致。\"}},\"v2_n_11_4_3_2\":{\"statistics.sensitivity_analysis.assumption\":{\"assumption\":\"敏感性分析对治疗期间使用抢救性止痛药这一伴发事件采用假想策略，评估未使用该抢救性止痛药情形下的治疗效应。\"},\"statistics.sensitivity_analysis.estimand_alignment\":{\"alignment\":\"与主要估计目标具有相同人群、变量、治疗条件和效应量，仅伴发事件处理策略由治疗策略改为假想策略。\"},\"statistics.sensitivity_analysis.method\":{\"method\":\"采用与主要分析平行的敏感性分析方法，在假想策略框架下估计第12周VAS较基线变化值的组间均值差异。\"},\"statistics.sensitivity_analysis.missing_data_handling\":{\"handling\":\"按假想策略处理治疗期间使用抢救性止痛药及相关缺失结局，不将该伴发事件发生后的数据直接按治疗策略纳入主要估计。\"},\"statistics.sensitivity_analysis.primary_method_link\":{\"linkage\":\"与主要分析（ANCOVA调整基线VAS或等价均值差异检验）平行，改变伴发事件处理策略以评估主要结果的稳健性。\"},\"statistics.sensitivity_analysis.result_interpretation\":{\"interpretation\":\"若敏感性分析与主要分析结论一致，支持主要结果对伴发事件处理假设稳健；若不一致，应结合抢救性止痛药使用情况解释差异。\"}},\"v2_n_11_4_4\":{\"statistics.secondary_analysis.analysis_set\":{\"efficacy\":\"次要疗效终点使用所有随机受试者，即全分析集/意向性分析集。\",\"safety\":\"安全性与耐受性终点使用安全性分析集，即至少接受一剂研究药物的受试者。\"},\"statistics.secondary_analysis.data_definition\":{\"data_sources\":\"电子日记卡、访视评估、EHP-30生活质量量表、抢救性止痛药记录、不良事件和实验室/生命体征等安全性评估。\"},\"statistics.secondary_analysis.endpoint_definitions\":{\"endpoints\":[\"第4周盆腔疼痛VAS评分较基线变化值\",\"第8周盆腔疼痛VAS评分较基线变化值\",\"痛经评分变化\",\"非经期盆腔疼痛评分\",\"性交痛评分\",\"抢救性止痛药使用量及完全缓解率\",\"EHP-30生活质量量表评分\",\"安全性与耐受性评价\"]},\"statistics.secondary_analysis.methods\":{\"method\":\"次要终点均进行描述性统计分析和未校正的标称P值报告，不进行多重性调整和I类错误控制。\",\"continuous\":\"连续变量报告n、均值、标准差、中位数、最小值和最大值。\",\"categorical\":\"分类变量报告频数和百分比。\"},\"statistics.secondary_analysis.missing_data\":{\"handling\":\"次要终点缺失数据按统计分析计划预先规定的描述性分析规则处理；主要使用可获得的评估进行汇总，不进行多重性调整。\"}}}}","receipt":{"idempotency_key":"chapter-facts.derive.v1","input_artifacts":[{"ref":"chapter-facts-input","sha256":"3ecbfca915c49b89fde6e3211e53fdee05a9e84647e07a1cb4f48272c1520008"}],"logical_call_id":"call:chapter-facts:3ecbfca915c49b89fde6e3211e53fdee05a9e84647e07a1cb4f48272c1520008","node_execution_contract_id":"nec:chapter-facts:3ecbfca915c49b89fde6e3211e53fdee05a9e84647e07a1cb4f48272c1520008","observed_model":"deepseek-latest-cloud","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/chapter-facts-output.v1.json","output_sha256":"f7b973b606f1cff9036c0bff3477f5c78afedfee801e67acae3a38b68880da05","prompt_sha256":"81a4f629a6890c6f801162e4a74b9ab00ea246faf6b827f82fb3d8a5fee50daf","provider_session_id":"e18c49c5-201e-40a7-8183-03a07d86b967","requested_reasoning_effort":"max"},"schema":"model_response.v1"}