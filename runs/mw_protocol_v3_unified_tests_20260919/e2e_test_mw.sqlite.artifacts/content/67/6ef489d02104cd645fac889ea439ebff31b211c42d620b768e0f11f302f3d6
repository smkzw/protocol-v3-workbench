{"content":"{\"chapters\":{\"v2_n_1_1\":{\"framing.document_title\":{\"title\":\"评价合成药E1治疗子宫内膜异位症相关盆腔疼痛有效性和安全性的随机、双盲、安慰剂对照、多中心II期临床研究\"},\"synopsis.comparator_drug\":{\"name\":\"外观匹配安慰剂片\",\"dosage_form\":\"片剂\",\"route\":\"口服\",\"dose\":\"每次1片，每日一次（QD）\",\"matching\":\"与合成药E1片外观、包装完全一致\"},\"synopsis.design\":{\"type\":\"随机、双盲、安慰剂对照、多中心II期临床研究\",\"randomization\":\"按1:1随机分配至合成药E1组或安慰剂组\",\"blinding\":\"双盲\",\"control\":\"外观匹配安慰剂对照\",\"duration\":\"筛选期最长4周，双盲治疗期12周，安全随访期4周\",\"interim_analysis\":\"不计划进行期中分析，不设立独立数据监查委员会（IDMC），不消耗alpha\"},\"synopsis.interventions\":{\"experimental\":\"合成药E1片10mg，口服，每日一次，每次1片，双盲治疗期12周\",\"control\":\"外观匹配安慰剂片，口服，每日一次，每次1片，双盲治疗期12周\",\"rescue_analgesia\":\"仅允许布洛芬片作为抢救性止痛药，每次不超过400mg，每日最高不超过1200mg；每次访视疼痛评估前48小时内禁止服用；禁止使用其他激素类药物\"},\"synopsis.investigational_drug\":{\"name\":\"合成药E1\",\"mechanism\":\"GnRH受体拮抗剂\",\"dosage_form\":\"片剂\",\"strength\":\"10mg/片\",\"route\":\"口服\",\"dose\":\"10mg 每日一次（QD），每次1片\"},\"synopsis.overall_duration\":{\"value\":\"约20周\",\"detail\":\"筛选期最长4周、双盲治疗期12周、安全随访期4周\"},\"synopsis.participation_duration\":{\"value\":\"最长约20周\",\"detail\":\"筛选期最长4周、双盲治疗期12周、安全随访期4周\"},\"synopsis.population_eligibility\":{\"population\":\"确诊为子宫内膜异位症伴中重度盆腔疼痛的育龄期女性患者\",\"planned_enrollment\":\"约150例\",\"allocation\":\"按1:1随机分配至合成药E1组约75例或安慰剂组约75例\"},\"synopsis.sample_size\":{\"planned_total\":150,\"experimental_group\":75,\"control_group\":75,\"evaluable_per_group\":60,\"assumptions\":{\"between_group_difference\":\"15mm\",\"pooled_sd\":\"25mm\",\"alpha\":\"双侧0.05\",\"power\":\"90%\",\"allocation\":\"1:1\",\"dropout\":\"约20%\",\"software\":\"PASS 15\"}},\"synopsis.statistical_methods\":{\"primary_estimand\":\"主要估计目标采用治疗策略分析所有随机受试者；对治疗期间使用抢救性止痛药采用治疗策略并记录伴发事件，敏感性分析采用假想策略\",\"primary_analysis\":\"第12周盆腔疼痛VAS评分较基线变化值的组间均值差异（E1组减安慰剂组）\",\"secondary_analysis\":\"描述性统计分析和未校正标称P值，不进行多重性调整和I类错误控制\",\"interim_analysis\":\"不计划期中分析，不设立IDMC，不消耗alpha\"},\"synopsis.trial_institutions\":{\"scope\":\"多中心\",\"details\":\"多中心临床研究\"}},\"v2_n_1_2\":{\"d