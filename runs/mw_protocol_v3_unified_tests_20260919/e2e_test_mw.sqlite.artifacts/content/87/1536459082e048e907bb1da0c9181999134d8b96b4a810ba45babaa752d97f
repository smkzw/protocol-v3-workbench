{"content":"{\n  \"status\": \"ready_for_review\",\n  \"objectives\": {\n    \"primary\": [\n      {\n        \"text\": \"评价合成药E1 10mg口服每日一次与外观匹配安慰剂相比，在确诊为子宫内膜异位症伴中重度盆腔疼痛的育龄期女性患者中，治疗第12周时盆腔疼痛VAS评分较基线变化的有效性。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户简报明确本研究为随机、双盲、安慰剂对照II期临床研究，主要终点为治疗第12周时盆腔疼痛VAS评分较基线的变化值。\"\n      }\n    ],\n    \"secondary\": [\n      {\n        \"text\": \"评价第4周和第8周盆腔疼痛VAS评分较基线变化。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户简报将第4、8周盆腔疼痛VAS评分变化列为次要终点。\"\n      },\n      {\n        \"text\": \"评价痛经评分变化、非经期盆腔疼痛评分、性交痛评分。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户简报将这些疼痛相关评分列为次要终点。\"\n      },\n      {\n        \"text\": \"评价抢救性止痛药使用量及完全缓解率。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户简报将抢救性止痛药使用量及完全缓解率列为次要终点。\"\n      },\n      {\n        \"text\": \"评价EHP-30生活质量量表评分。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户简报将EHP-30生活质量量表评分列为次要终点。\"\n      },\n      {\n        \"text\": \"评价安全性与耐受性。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户简报将安全性与耐受性评价列为次要终点，并说明研究目的包括评价安全性。\"\n      },\n      {\n        \"text\": \"次要终点均进行描述性统计分析和未校正的标称P值报告，不进行多重性调整和I类错误控制。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户简报明确本研究为II期探索性临床试验，次要终点不进行多重性调整和I类错误控制。\"\n      }\n    ],\n    \"questions\": []\n  },\n  \"endpoint\": {\n    \"primary_endpoint\": {\n      \"text\": \"治疗第12周时盆腔疼痛VAS评分较基线的变化值。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户简报明确主要终点为治疗第12周时盆腔疼痛视觉模拟评分（VAS评分）较基线的变化值。\"\n    },\n    \"key_secondary\": [\n      {\n        \"text\": \"第4、8周盆腔疼痛VAS评分较基线变化。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户简报列出第4、8周盆腔疼痛VAS评分变化为次要终点。\"\n      },\n      {\n        \"text\": \"痛经评分变化。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户简报列出痛经评分变化为次要终点。\"\n      },\n      {\n        \"text\": \"非经期盆腔疼痛评分。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户简报列出非经期盆腔疼痛评分为次要终点。\"\n      },\n      {\n        \"text\": \"性交痛评分。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户简报列出性交痛评分为次要终点。\"\n      },\n      {\n        \"text\": \"抢救性止痛药使用量及完全缓解率。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户简报列出抢救性止痛药使用量及完全缓解率为次要终点。\"\n      },\n      {\n        \"text\": \"EHP-30生活质量量表评分。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户简报列出EHP-30生活质量量表评分为次要终点。\"\n      },\n      {\n        \"text\": \"安全性与耐受性评价。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户简报列出安全性与耐受性评价为次要终点。\"\n      }\n    ],\n    \"measurement_details\": \"采用0-100mm视觉模拟评分尺（VAS，0mm无痛，100mm极度剧痛）；基线定义为随机前连续28天筛选期内电子日记卡记录的每日盆腔疼痛VAS评分平均值；第12周访视时间窗为第12周（Day 84）±3天，评估前7天每日VAS评分均值作为第12周终点值。受试者每日记录电子日记卡记录止痛药用量与疼痛评分。\",\n    \"questions\": []\n  },\n  \"estimand\": {\n    \"treatment\": {\n      \"text\": \"合成药E1片，规格10mg，口服，每日一次（QD），每次1片，双盲治疗12周；对照为外观匹配安慰剂片，口服，每日一次（QD），每次1片，双盲治疗12周。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户简报明确试验药物与对照组用法用量、双盲治疗期12周及严格双盲对照。\"\n    },\n    \"population\": {\n      \"text\": \"确诊为子宫内膜异位症伴中重度盆腔疼痛的育龄期女性患者；计划入组约150例，按1:1随机分配至合成药E1组（约75例）或安慰剂组（约75例）；主要估计目标分析所有随机受试者。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户简报明确适应症与人群、随机分配比例和例数，以及主要估计目标采用治疗策略分析所有随机受试者。\"\n    },\n    \"variable\": {\n      \"text\": \"治疗第12周时盆腔疼痛VAS评分较基线的变化值；VAS为0-100mm，基线为随机前连续28天筛选期内电子日记卡每日盆腔疼痛VAS评分平均值，第12周终点为Day 84±3天评估前7天每日VAS评分均值。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户简报明确主要终点变量及其VAS量尺、基线和第12周终点定义。\"\n    },\n    \"ice_events\": [\n      \"治疗期间使用抢救性止痛药（限定布洛芬片，每次不超过400mg，每日最高不超过1200mg）\"\n    ],\n    \"ice_strategy\": {\n      \"text\": \"主要估计目标对治疗期间使用抢救性止痛药这一伴发事件采用治疗策略（Treatment Policy Strategy），即无论是否发生该伴发事件，均按随机分组分析所有随机受试者并记录伴发事件发生；敏感性分析对该伴发事件采用假想策略（Hypothetical Strategy）。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户简报明确主要估计目标采用治疗策略分析所有随机受试者，对治疗期间使用抢救性止痛药采用治疗策略并记录伴发事件，敏感性分析采用假想策略。\"\n    },\n    \"summary_measure\": {\n      \"text\": \"第12周时合成药E1组与安慰剂组之间盆腔疼痛VAS评分较基线变化值的组间均值差异（E1组减安慰剂组）。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"基于主要终点为连续变量、样本量假设为组间VAS评分降幅差异15mm且为安慰剂对照优效性比较，推荐采用组间均值差异作为主要估计量；适用前提为按治疗策略分析所有随机受试者并采用优效性检验。\"\n    },\n    \"questions\": []\n  },\n  \"sample_size\": {\n    \"assumptions\": [\n      \"主要终点为第12周盆腔疼痛VAS评分较基线变化值。\",\n      \"假定治疗第12周时合成药E1组VAS评分较基线降幅较安慰剂组组间差异为15mm。\",\n      \"合并标准差假定为25mm。\",\n      \"双侧检验水准alpha=0.05。\",\n      \"把握度Power=90%。\",\n      \"按1:1随机分配。\",\n      \"考虑约20%脱落率。\",\n      \"采用PASS 15软件计算。\"\n    ],\n    \"alpha\": \"双侧检验水准alpha=0.05\",\n    \"power\": \"90%\",\n    \"model\": \"两样本均数比较（双侧t检验）或等价的两组独立样本均值差异检验；主要分析可推荐采用ANCOVA调整基线VAS，但样本量按PASS 15中两组均值差异检验计算。\",\n    \"planned_n\": \"每组约60例可评价病例，考虑约20%脱落率后计划入组约150例（每组75例）。\",\n    \"attrition\": \"约20%脱落率，按每组60例可评价病例对应每组75例随机入组。\",\n    \"justification\": \"基于15mm组间差异、25mm合并标准差、双侧alpha=0.05、Power=90%、1:1随机分配，PASS 15计算每组约需60例可评价病例；考虑约20%脱落率后，最终计划入组约150例（每组75例）。该样本量假设与用户简报一致。\",\n    \"questions\": [],\n    \"references\": []\n  },\n  \"interim_planning\": null,\n  \"non_inferiority_margin\": null,\n  \"questions\": [],\n  \"unresolved_questions\": []\n}","receipt":{"idempotency_key":"design-elements.generate.v1","input_artifacts":[{"ref":"design-elements-intake","sha256":"921af2e66227678dc9b91652a746fc19e11f7ca8577c15d35ed99b0d37db386e"}],"logical_call_id":"call:design-elements:39fd219ce82fdac6844f85c766cf1334c6094df2a693a19d67337ff1feb7722d:design-generate","node_execution_contract_id":"nec:design-elements:39fd219ce82fdac6844f85c766cf1334c6094df2a693a19d67337ff1feb7722d:design-generate","observed_model":"deepseek-latest-cloud","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/design-elements-output.v1.json","output_sha256":"861df8ddd0c8128a6fd30eaed53dfb28c56d7b1a62cdfbe42bc8a49539f71f61","prompt_sha256":"21bf2955294ee9cc2fd35ad41a9fec8e8279bf3e566b47d7babf7c624d527a38","provider_session_id":"9a2fac54-5765-47d9-924e-e4d5f7c9d955","requested_reasoning_effort":"max"},"schema":"model_response.v1"}