{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-3-1-2-2:v2\",\n  \"node_id\": \"v2_n_3_1_2_2\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [\n    \"evidence:source:2e8603b57f20519f04494375af65e08e6a5fb34d72223b6debf0a5439685ee52\"\n  ],\n  \"blocks\": [\n    {\n      \"block_id\": \"block:p:estimand-variable:intro\",\n      \"kind\": \"paragraph\",\n      \"text\": \"本节应界定主要估计目标的研究变量，并逐项给出测量、聚合与时间点/窗口三类属性，避免仅以“疗效”等标签替代变量定义。已确认的研究变量为：第52周 FVC（用力肺活量）较基线绝对变化值（mL，毫升），采用符合 ATS/ERS（美国胸科学会/欧洲呼吸学会）标准的标准化肺量计并由中心化判读。仅写“研究变量：疗效”不能满足本节要求。\",\n      \"evidence_refs\": [\n        \"evidence:source:2e8603b57f20519f04494375af65e08e6a5fb34d72223b6debf0a5439685ee52\"\n      ],\n      \"source_locator\": \"word/document.xml/body/6:p\"\n    },\n    {\n      \"block_id\": \"block:table:estimand-variable:attributes\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [\n        \"evidence:source:2e8603b57f20519f04494375af65e08e6a5fb34d72223b6debf0a5439685ee52\"\n      ],\n      \"table\": {\n        \"table_id\": \"table:estimand:primary:variable\",\n        \"block_id\": \"block:table:estimand-variable:attributes\",\n        \"title\": \"主要估计目标的研究变量属性表\",\n        \"role\": \"body_content\",\n        \"domain\": \"objectives_endpoints\",\n        \"header_row_count\": 1,\n        \"columns\": [\n          {\n            \"column_id\": \"col:attribute\",\n            \"label\": \"属性\",\n            \"order\": 0,\n            \"semantic_role\": \"attribute\",\n            \"style_role\": \"header\"\n          },\n          {\n            \"column_id\": \"col:content\",\n            \"label\": \"内容\",\n            \"order\": 1,\n            \"semantic_role\": \"content\",\n            \"style_role\": \"body\"\n          },\n          {\n            \"column_id\": \"col:note\",\n            \"label\": \"备注\",\n            \"order\": 2,\n            \"semantic_role\": \"note\",\n            \"style_role\": \"body\"\n          }\n        ],\n        \"rows\": [\n          {\n            \"row_id\": \"row:variable\",\n            \"order\": 0,\n            \"cells\": [\n              {\n                \"cell_id\": \"variable:cell:attribute\",\n                \"row_id\": \"row:variable\",\n                \"column_id\": \"col:attribute\",\n                \"text\": \"研究变量\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"variable:cell:content\",\n                \"row_id\": \"row:variable\",\n                \"column_id\": \"col:content\",\n                \"text\": \"第52周 FVC（用力肺活量）较基线绝对变化值（mL，毫升），采用符合 ATS/ERS（美国胸科学会/欧洲呼吸学会）标准的标准化肺量计并由中心化判读。\",\n                \"provenance_lineage\": [\n                  \"evidence:source:2e8603b57f20519f04494375af65e08e6a5fb34d72223b6debf0a5439685ee52\"\n                ],\n                \"source_locator\": \"word/document.xml/body/6:p\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"variable:cell:note\",\n                \"row_id\": \"row:variable\",\n                \"column_id\": \"col:note\",\n                \"text\": \"已确认研究变量事实；证据支持 FVC 较基线绝对变化值（mL）与第52周。\",\n                \"style_role\": \"body\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:measurement\",\n            \"order\": 1,\n            \"cells\": [\n              {\n                \"cell_id\": \"variable:row:measurement:attribute\",\n                \"row_id\": \"row:measurement\",\n                \"column_id\": \"col:attribute\",\n                \"text\": \"测量\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"variable:cell:measurement\",\n                \"row_id\": \"row:measurement\",\n                \"column_id\": \"col:content\",\n                \"text\": \"已确认研究变量事实中描述为采用符合 ATS/ERS 标准的标准化肺量计并由中心化判读。【待补充：研究变量测量方式的独立属性确认（设备型号、校准、操作与判读流程等）：该项待研究团队确认后补充】\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"variable:row:measurement:note\",\n                \"row_id\": \"row:measurement\",\n                \"column_id\": \"col:note\",\n                \"text\": \"独立测量属性事实未绑定，故按缺口标注。\",\n                \"style_role\": \"body\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:aggregation\",\n            \"order\": 2,\n            \"cells\": [\n              {\n                \"cell_id\": \"variable:row:aggregation:attribute\",\n                \"row_id\": \"row:aggregation\",\n                \"column_id\": \"col:attribute\",\n                \"text\": \"聚合\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"variable:cell:aggregation\",\n                \"row_id\": \"row:aggregation\",\n                \"column_id\": \"col:content\",\n                \"text\": \"【待补充：研究变量如何汇总到个体层（如多次测量取均值、最差值或其他聚合规则）：该项待研究团队确认后补充】\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"variable:row:aggregation:note\",\n                \"row_id\": \"row:aggregation\",\n                \"column_id\": \"col:note\",\n                \"text\": \"聚合属性事实未确认。\",\n                \"style_role\": \"body\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:timepoint\",\n            \"order\": 3,\n            \"cells\": [\n              {\n                \"cell_id\": \"variable:row:timepoint:attribute\",\n                \"row_id\": \"row:timepoint\",\n                \"column_id\": \"col:attribute\",\n                \"text\": \"时间点/窗口\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"variable:cell:timepoint\",\n                \"row_id\": \"row:timepoint\",\n                \"column_id\": \"col:content\",\n                \"text\": \"第52周（来自已确认研究变量事实）。【待补充：第52周评价对应的允许访视窗口（时间窗）：该项待研究团队确认后补充】\",\n                \"provenance_lineage\": [\n                  \"evidence:source:2e8603b57f20519f04494375af65e08e6a5fb34d72223b6debf0a5439685ee52\"\n                ],\n                \"source_locator\": \"word/document.xml/body/6:p\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"variable:row:timepoint:note\",\n                \"row_id\": \"row:timepoint\",\n                \"column_id\": \"col:note\",\n                \"text\": \"独立时间窗属性事实未绑定，故按缺口标注。\",\n                \"style_role\": \"body\"\n              }\n            ]\n          }\n        ],\n        \"notes\": [],\n        \"review_state\": \"ai_draft\",\n        \"version\": 0,\n        \"source_locator\": \"word/document.xml/body/6:p\"\n      }\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"97cdf0a9591e2523537b861f95857cd1cb0a994bba917ba5300dcd81e1dd8dc2"}],"logical_call_id":"call:chapter-draft:810ab358b6094e70a2f894965a93b293b99685695af1059dcf86332e8108340a:chapter-generate","node_execution_contract_id":"nec:chapter-draft:810ab358b6094e70a2f894965a93b293b99685695af1059dcf86332e8108340a:chapter-generate","observed_model":"deepseek-latest-cloud","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/ordered-chapter-draft-candidate.v1.json","output_sha256":"6a5e2609224c7cff9c464b8e89caf53ecbcaa083ddfeba5faf44800a606c52dc","prompt_sha256":"5322c0235bbedc2213b004747cbd757992154e907fd360b9bf7be0e09db8863e","provider_session_id":"ca2fe836-d52e-4703-be8a-ae2569e90015","requested_reasoning_effort":"max"},"schema":"model_response.v1"}