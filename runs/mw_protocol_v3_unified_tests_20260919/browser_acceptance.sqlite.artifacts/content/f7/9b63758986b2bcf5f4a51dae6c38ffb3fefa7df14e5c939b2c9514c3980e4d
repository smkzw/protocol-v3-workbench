       \"row_id\": \"synopsis:row:sponsor\",\n            \"order\": 5,\n            \"label\": \"申办者\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:sponsor:label\",\n                \"row_id\": \"synopsis:row:sponsor\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"申办者\",\n                \"style_role\": \"row_header\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:sponsor\",\n                \"row_id\": \"synopsis:row:sponsor\",\n                \"column_id\": \"synopsis:col:content\",\n                \"text\": \"申办者负责发起、管理和资助本试验，确保试验按照已批准方案、GCP（药物临床试验质量管理规范）和适用法规实施；负责提供试验用药品、标签、运输和销毁授权，并监督药物管理符合方案、GCP和适用法规；建立并维护质量体系，确保试验质量和数据可靠性。申办者药物警戒部门负责SUSAR（可疑且非预期严重不良反应）和其他潜在严重安全性风险的识别、评估和报告。试验相关损害由申办者依法承担赔偿责任并提供相应补偿；申办者为该试验购买临床试验责任保险。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:principal_investigator\",\n            \"order\": 6,\n            \"label\": \"主要研究者\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:principal_investigator:label\",\n                \"row_id\": \"synopsis:row:principal_investigator\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"主要研究者\",\n                \"style_role\": \"row_header\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:principal_investigator\",\n                \"row_id\": \"synopsis:row:principal_investigator\",\n                \"column_id\": \"synopsis:col:content\",\n                \"text\": \"主要研究者；姓名与联系方式由研究中心确认后填写。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:trial_institutions\",\n            \"order\": 7,\n            \"label\": \"试验机构\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:trial_institutions:label\",\n                \"row_id\": \"synopsis:row:trial_institutions\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"试验机构\",\n                \"style_role\": \"row_header\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:trial_institutions\",\n                \"row_id\": \"synopsis:row:trial_institutions\",\n                \"column_id\": \"synopsis:col:content\",\n                \"text\": \"以获批研究中心列表为准。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:objective_estimand_endpoint\",\n            \"order\": 8,\n            \"label\": \"目的/估计目标/终点\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:objective_estimand_endpoint:label\",\n                \"row_id\": \"synopsis:row:objective_estimand_endpoint\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"目的/估计目标/终点\",\n                \"style_role\": \"row_header\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:objective_estimand_endpoint\",\n                \"row_id\": \"synopsis:row:objective_estimand_endpoint\",\n                \"column_id\": \"synopsis:col:content\",\n                \"text\": \"主要目的：在成人慢性鼻窦炎伴鼻息肉患者中评价合成药X对比生理盐水安慰剂的优效性概念验证；关键次要终点：SNOT-22采用固定序列检验控制多重性，Lund-Kennedy内镜评分为描述性分析；估计目标、终点与分析策略分别见嵌套表 synopsis.objective_estimand_endpoint。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:design\",\n            \"order\": 9,\n            \"label\": \"设计\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:design:label\",\n                \"row_id\": \"synopsis:row:design\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"设计\",\n                \"style_role\": \"row_header\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:design\",\n                \"row_id\": \"synopsis:row:design\",\n                \"column_id\": \"synopsis:col:content\",\n                \"text\": \"随机、双盲、安慰剂对照、优效性概念验证研究；Ⅱ期；成人慢性鼻窦炎伴鼻息肉；随机1:1，按中心分层；试验组为合成药X组，对照组为安慰剂组；第1天至第24周（末次给药），第24周评估主要和次要终点；允许稳定背景鼻用激素并记录；无期中分析。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:population_eligibility\",\n            \"order\": 10,\n            \"label\": \"人群\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:population_eligibility:label\",\n                \"row_id\": \"synopsis:row:population_eligibility\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"人群\",\n                \"style_role\": \"row_header\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:population_eligibility\",\n                \"row_id\": \"synopsis:row:population_eligibility\",\n                \"column_id\": \"synopsis:col:content\",\n                \"text\": \"成人慢性鼻窦炎伴鼻息肉患者；入选标准：年龄≥18岁的成人；诊断为慢性鼻窦炎伴鼻息肉；允许稳定背景鼻用激素并记录；所有标准需同时满足。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:drug\",\n            \"order\": 11,\n            \"label\": \"药物\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:drug:label\",\n                \"row_id\": \"synopsis:row:drug\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"药物\",\n                \"style_role\": \"row_header\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:drug\",\n                \"row_id\": \"synopsis:row:drug\",\n                \"column_id\": \"synopsis:col:content\",\n                \"text\": \"研究药物：合成药X，注射制剂，IL-4Rα拮抗；对照药：生理盐水安慰剂。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:interventions\",\n            \"order\": 12,\n            \"label\": \"干预\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:interventions:label\",\n                \"row_id\": \"synopsis:row:interventions\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"干预\",\n                \"style_role\": \"row_header\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:interventions\",\n                \"row_id\": \"synopsis:row:interventions\",\n                \"column_id\": \"synopsis:col:content\",\n                \"text\": \"合成药X组：负荷给药期第1、8、15、22天每周一次共4次，每次150 mg/1.0 mL皮下给药；维持给药期第36天起每两周一次，每次150 mg/1.0 mL皮下给药至第24周（末次给药）。安慰剂组：负荷给药期第1、8、15、22天每周一次共4次，每次生理盐水安慰剂1.0 mL皮下注射；维持给药期第36天起每两周一次，每次生理盐水安慰剂1.0 mL皮下注射至第24周（末次给药）。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:sample_size\",\n            \"order\": 13,\n            \"label\": \"样本量\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:sample_size:label\",\n                \"row_id\": \"synopsis:row:sample_size\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"样本量\",\n                \"style_role\": \"row_header\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:sample_size\",\n                \"row_id\": \"synopsis:row:sample_size\",\n                \"column_id\": \"synopsis:col:content\",\n                \"text\": \"约404例（每组约202例）；按1:1随机，双侧α=0.05，把握度（power）=90%，试验组应答率35%，安慰剂组应答率20%，脱落率8%；采用两独立比例的正态近似；按中心分层的CMH（Cochran-Mantel-Haenszel）检验，报告风险差及95%CI（置信区间）。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:statistical_methods\",\n            \"order\": 14,\n            \"label\": \"统计分析\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:statistical_methods:label\",\n                \"row_id\": \"synopsis:row:statistical_methods\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"统计分析\",\n                \"style_role\": \"row_header\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:statistical_methods\",\n                \"row_id\": \"synopsis:row:statistical_methods\",\n                \"column_id\": \"synopsis:col:content\",\n                \"text\": \"分析集：FAS（全分析集，依据ITT（意向治疗）原则），按随机分组；主要分析：按中心分层的CMH（Cochran-Mantel-Haenszel）检验，报告风险差及95%CI（置信区间）；ICE（伴发事件）按治疗策略处理；ICE事件包括鼻塞加重需全身激素或手术干预、因不良事件停药、失访；救援治疗定义为因鼻塞加重使用全身激素或鼻窦手术；缺失数据：第24周缺失主要终点采用NRI（无应答插补），敏感性分析采用tipping point；多重性：关键次要终点SNOT-22采用固定序列检验控制多重性；Lund-Kennedy内镜评分为描述性分析。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:overall_duration\",\n            \"order\": 15,\n            \"label\": \"总体周期\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:overall_duration:label\",\n                \"row_id\": \"synopsis:row:overall_duration\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"总体周期\",\n                \"style_role\": \"row_header\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:overall_duration\",\n                \"row_id\": \"synopsis:row:overall_duration\",\n                \"column_id\": \"synopsis:col:content\",\n                \"text\": \"约24周治疗和评估期（第1天至第24周末次给药/主要终点评估）；总体研究结束以所有试验参与者完成第24周评估并完成数据清理、数据库锁定和统计分析为准。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:participation_duration\",\n            \"order\": 16,\n            \"label\": \"参与者访视时长\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:participation_duration:label\",\n                \"row_id\": \"synopsis:row:participation_duration\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"参与者访视时长\",\n                \"style_role\": \"row_header\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:participation_duration\",\n                \"row_id\": \"synopsis:row:participation_duration\",\n                \"column_id\": \"synopsis:col:content\",\n                \"text\": \"试验参与者自签署知情同意书进入筛选期，至第24周主要终点评估完成；之后按方案进行安全性随访，AE（不良事件）/SAE（严重不良事件）收集至末次给药后30天。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          }\n        ],\n        \"notes\": []\n      }\n    },\n    {\n      \"block_id\": \"block:synopsis:objective-estimand-endpoint\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [],\n      \"table\": {\n        \"table_id\": \"synopsis.objective_estimand_endpoint\",\n        \"block_id\": \"block:synopsis:objective-estimand-endpoint\",\n        \"title\": \"目的、估计目标与终点嵌套表\",\n        \"role\": \"body_content\",\n        \"domain\": \"objectives_endpoints\",\n        \"version\": 0,\n        \"review_state\": \"ai_draft\",\n        \"header_row_count\": 0,\n        \"columns\": [\n          {\n            \"column_id\": \"synopsis:col:objective\",\n            \"order\": 0,\n            \"label\": \"目的\",\n            \"semantic_role\": \"objective\",\n            \"style_role\": \"body\"\n          },\n          {\n            \"column_id\": \"synopsis:col:estimand\",\n            \"order\": 1,\n            \"label\": \"估计目标\",\n            \"semantic_role\": \"estimand\",\n            \"style_role\": \"body\"\n          },\n          {\n            \"column_id\": \"synopsis:col:endpoint\",\n            \"order\": 2,\n            