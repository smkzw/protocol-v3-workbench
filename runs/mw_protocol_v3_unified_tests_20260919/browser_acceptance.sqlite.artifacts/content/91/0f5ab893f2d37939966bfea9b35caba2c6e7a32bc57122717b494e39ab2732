{"content":"{\n  \"chapters\": {\n    \"v2_n_3_1_2_2\": {\n      \"estimand.primary.variable_aggregation\": {\n        \"aggregation_unit\": \"受试者\",\n        \"aggregation_method\": \"按受试者在第24周是否达到临床缓解进行二分类判定，并计算第24周临床缓解率（达到缓解的受试者人数/分析集受试者人数）。\",\n        \"analysis_set\": \"FAS（ITT原则）\"\n      },\n      \"estimand.primary.variable_measurement\": {\n        \"definition\": \"第24周临床缓解定义为双侧鼻息肉评分（NPS）≤1且鼻塞VAS≤1。\",\n        \"nps\": \"NPS采用0～8分（每侧0～4分的双侧总和），缓解阈值为≤1分。\",\n        \"nasal_congestion_vas\": \"鼻塞VAS采用0～10 cm视觉模拟量表，缓解阈值为≤1分。\",\n        \"timepoint\": \"第24周\"\n      },\n      \"estimand.primary.variable_timepoint_window\": {\n        \"timepoint\": \"第24周\",\n        \"description\": \"在第24周访视评估主要终点。\"\n      }\n    },\n    \"v2_n_3_1_2_3\": {\n      \"design.rescue_treatment_planned\": {\n        \"planned\": true,\n        \"description\": \"允许因鼻塞加重使用全身激素或鼻窦手术作为救援治疗。\",\n        \"rescue_treatments\": [\n          \"全身激素\",\n          \"鼻窦手术\"\n        ],\n        \"trigger\": \"鼻塞加重\"\n      },\n      \"estimand.primary.background_treatment\": {\n        \"allowed\": true,\n        \"description\": \"允许稳定背景鼻用激素并记录。\",\n        \"therapy\": \"稳定背景鼻用激素\",\n        \"recorded\": true\n      },\n      \"estimand.primary.treatment_condition\": {\n        \"condition\": \"随机分配的治疗\",\n        \"description\": \"合成药X 150 mg/1.0 mL皮下给药方案（负荷期第1、8、15、22天每周一次共4次；维持期第36天起每两周一次至第24周末次给药）或安慰剂（生理盐水1.0 mL皮下注射，同体积同途径同频率）。\",\n        \"randomized\": true,\n        \"arms\": [\n          \"合成药X组\",\n          \"安慰剂组\"\n        ]\n      },\n      \"estimand.primary.treatment_effect_label_clarification\": {\n        \"label\": \"随机分配的治疗，伴有或不伴有‘补救治疗或背景治疗改变’\",\n        \"clarification\": \"ICE按治疗策略（treatment policy）处理；无论是否发生救援治疗或背景治疗改变，主要分析均按随机分配的治疗组进行。\"\n      },\n      \"intervention.background_therapy_applicable\": {\n        \"applicable\": true,\n        \"description\": \"允许稳定背景鼻用激素并记录。\",\n        \"therapy\": \"鼻用激素\",\n        \"stable_required\": true,\n        \