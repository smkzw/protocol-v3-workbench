{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-3-3-1:v2\",\n  \"node_id\": \"v2_n_3_3_1\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"block_id\": \"b1\",\n      \"kind\": \"paragraph\",\n      \"text\": \"本章安全性目的为：评价合成药X 150 mg皮下给药方案相较安慰剂在成人慢性鼻窦炎伴鼻息肉患者中的安全性和耐受性。安全性评价将依据已确认的安全性终点开展，包括不良事件（AE）发生率、严重不良事件（SAE）发生率及注射部位反应发生率。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"b2\",\n      \"kind\": \"paragraph\",\n      \"text\": \"安全性观察期为整个研究期间，包括治疗期和安全性随访期。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"b3\",\n      \"kind\": \"paragraph\",\n      \"text\": \"注射反应适用性判定为适用：研究药物为皮下注射给药，需评估注射部位反应。注射部位反应指皮下注射后发生于注射部位的局部不良事件，按NCI CTCAE 5.0版进行严重程度分级，并按预先定义的类别记录和汇总。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"fa17d2ed1670667736334c25a9d1208587ce3e33cc44229bdd9b68b3590930c1"}],"logical_call_id":"call:chapter-draft:0c5614f233eabcc35fc5dfee7b2a567f8aa8fdc0c21605fc39892fed977ab408:chapter-generate","node_execution_contract_id":"nec:chapter-draft:0c5614f233eabcc35fc5dfee7b2a567f8aa8fdc0c21605fc39892fed977ab408:chapter-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/ordered-chapter-draft-candidate.v1.json","output_sha256":"e0f80305ef517b061ea0e91997617cb9ce946d595c426bf9239ee9a48d67d70d","prompt_sha256":"47dd66c834319411962b91127cd952207cccdab4dee7068a9ab81409e5aefa1e","provider_session_id":"f606b327-ea6b-4521-86fc-91177eb56cea","requested_reasoning_effort":"max"},"schema":"model_response.v1"}