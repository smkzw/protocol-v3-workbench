{"content":"{\n  \"chapters\": {\n    \"v2_n_9_1\": {\n      \"efficacy.assessment_instrument_or_scale\": {\n        \"primary\": \"双侧鼻息肉评分（NPS，0～8分，每侧0～4分）和鼻塞VAS（0～10 cm视觉模拟量表，缓解阈值≤1分）。\",\n        \"secondary\": \"SNOT-22问卷和Lund-Kennedy内镜评分。\"\n      },\n      \"efficacy.assessment_timing_reference\": {\n        \"primary\": \"第24周评估临床缓解状态。\",\n        \"secondary\": \"所有次要终点均在第24周评估；SNOT-22和Lund-Kennedy比较第24周较基线的变化。\"\n      },\n      \"efficacy.evaluator_role_and_training\": {\n        \"evaluator\": \"NPS和Lund-Kennedy内镜评分由经过培训的研究者/耳鼻喉科医师评估；鼻塞VAS和SNOT-22由受试者自评。\",\n        \"training\": \"评估者应接受方案和量表使用培训。\"\n      },\n      \"efficacy.primary_endpoint_measurement\": {\n        \"endpoint\": \"第24周临床缓解率\",\n        \"definition\": \"第24周达到双侧鼻息肉评分（NPS）≤1且鼻塞VAS≤1的受试者比例。\",\n        \"analysis_set\": \"FAS（ITT原则），按随机分组分析。\",\n        \"missing_data\": \"第24周缺失主要终点采用无应答插补（NRI），敏感性分析采用tipping point。\"\n      },\n      \"efficacy.primary_estimand_link\": {\n        \"variable\": \"第24周临床缓解，定义为双侧NPS≤1且鼻塞VAS≤1。\",\n        \"population\": \"成人慢性鼻窦炎伴鼻息肉患者；允许稳定背景鼻用激素并记录。\",\n        \"summary_measure\": \"第24周临床缓解率（比例）。\",\n        \"ice_strategy\": \"ICE按治疗策略（treatment policy）处理。ICE事件包括鼻塞加重需全身激素或手术干预、因不良事件停药、失访；救援治疗定义为因鼻塞加重使用全身激素或鼻窦手术。\",\n        \"main_analysis\": \"按中心分层的CMH检验，报告风险差及95%CI；优效性检验。\"\n      },\n      \"evaluation.framework_scope\": {\n        \"phase\": \"Ⅱ期概念验证\",\n        \"design\": \"随机双盲、安慰剂对照优效性设计\",\n        \"primary_objective\": \"评估合成药X 150 mg/1.0 mL皮下给药方案（负荷期第1、8、15、22天每周一次共4次；维持期第36天起每两周一次至第24周末次给药）相较安慰剂在成人慢性鼻窦炎伴鼻息肉患者中第24周临床缓解率的优效性。\",\n        \"secondary_objectives\": [\n          \"评价第24周SNOT-22较基线的变化（关键次要终点，采用固定序列检验控制多重性）。\",\n          \"评价第24周Lund-Kennedy内镜评分较基线的变化（描述性分析）。\"\n        ]\n      }\n    }\n  }\n}","receipt":{"idempotency_key":"chapter-facts.derive.v1","input_artifacts":[{"ref":"chapter-facts-input","sha256":"ea98ff401e2c5c16a188a18bbe3add15d9e89c0850a841eac8c6f58048a63958"}],"logical_call_id":"call:chapter-facts:ea98ff401e2c