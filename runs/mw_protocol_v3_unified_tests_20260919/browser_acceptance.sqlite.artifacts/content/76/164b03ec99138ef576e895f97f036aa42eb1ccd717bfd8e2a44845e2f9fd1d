{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-2-2-2-1:v2\",\n  \"node_id\": \"v2_n_2_2_2_1\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"block_id\": \"blk:v2_n_2_2_2_1:clinical-pharmacology-context\",\n      \"kind\": \"paragraph\",\n      \"text\": \"临床药理学背景：合成药X为IL-4Rα（白介素-4受体α）拮抗剂，拟用于2型炎症相关的CRSwNP（慢性鼻窦炎伴鼻息肉）；其临床药理学特征应结合非临床及早期临床数据评估。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:v2_n_2_2_2_1:pd\",\n      \"kind\": \"paragraph\",\n      \"text\": \"药效学（PD）：IL-4Rα拮抗可阻断IL-4（白介素-4）/IL-13（白介素-13）介导的2型炎症信号，预期降低相关炎症介质和生物标志物。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:v2_n_2_2_2_1:pk\",\n      \"kind\": \"paragraph\",\n      \"text\": \"药代动力学（PK）：非临床药代数据详见研究者手册，本方案不重复罗列。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:v2_n_2_2_2_1:toxicology\",\n      \"kind\": \"paragraph\",\n      \"text\": \"毒理学：非临床毒理数据详见研究者手册，本方案不重复罗列。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:v2_n_2_2_2_1:general-pharmacology\",\n      \"kind\": \"paragraph\",\n      \"text\": \"一般药理学：IL-4Rα是IL-4和IL-13共用的受体亚基，阻断该受体可抑制2型炎症信号通路。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"5027acbc05fe019e0d362f76f51cab944af363c744eaea9c4987b5f153b4df0f"}],"logical_call_id":"call:chapter-draft:6b4608e891729ca6eb1408b5f5c8618510d6d243352a1a2e4040510ea20b5b49:chapter-generate","node_execution_contract_id":"nec:chapter-draft:6b4608e891729ca6eb1408b5f5c8618510d6d243352a1a2e4040510ea20b5b49:chapter-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/ordered-chapter-