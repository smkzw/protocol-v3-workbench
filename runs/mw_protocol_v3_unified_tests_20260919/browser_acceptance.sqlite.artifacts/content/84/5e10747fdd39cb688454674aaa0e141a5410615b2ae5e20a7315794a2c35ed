{"content":"{\"chapter_contract_id\":\"contract:v2-n-13-1:v2\",\"node_id\":\"v2_n_13_1\",\"schema_version\":\"ordered_chapter_draft_candidate.v1\",\"known_evidence_ids\":[],\"blocks\":[{\"block_id\":\"block:v2-n-13-1:p1\",\"kind\":\"paragraph\",\"text\":\"本章节说明本研究的伦理审查与伦理规范安排。以下内容依据已确认的项目事实整理。\",\"evidence_refs\":[],\"source_locator\":\"\"},{\"block_id\":\"block:v2-n-13-1:table1\",\"kind\":\"table\",\"evidence_refs\":[],\"table\":{\"table_id\":\"table:v2-n-13-1:ethics\",\"block_id\":\"block:v2-n-13-1:table1\",\"title\":\"伦理规范与审查安排\",\"domain\":\"generic\",\"role\":\"body_content\",\"header_row_count\":1,\"review_state\":\"ai_draft\",\"version\":0,\"source_locator\":\"chapter_input.resolved_facts\",\"schema_version\":\"structured_table_v1\",\"columns\":[{\"column_id\":\"ethics:col:item\",\"order\":0,\"label\":\"伦理事项\",\"semantic_role\":\"item\",\"style_role\":\"header\"},{\"column_id\":\"ethics:col:fact\",\"order\":1,\"label\":\"项目事实/安排\",\"semantic_role\":\"fact\",\"style_role\":\"body\"}],\"rows\":[{\"row_id\":\"ethics:row:header\",\"order\":0,\"style_role\":\"header\",\"cells\":[{\"cell_id\":\"ethics:cell:header_item\",\"row_id\":\"ethics:row:header\",\"column_id\":\"ethics:col:item\",\"text\":\"伦理事项\",\"source_locator\":\"\",\"provenance_lineage\":[],\"style_role\":\"header\"},{\"cell_id\":\"ethics:cell:header_fact\",\"row_id\":\"ethics:row:header\",\"column_id\":\"ethics:col:fact\",\"text\":\"项目事实/安排\",\"source_locator\":\"\",\"provenance_lineage\":[],\"style_role\":\"header\"}]},{\"row_id\":\"ethics:row:prospective_review_procedure\",\"order\":1,\"style_role\":\"body\",\"cells\":[{\"cell_id\":\"ethics:cell:prospective_review_procedure_item\",\"row_id\":\"ethics:row:prospective_review_procedure\",\"column_id\":\"ethics:col:item\",\"text\":\"审查程序\",\"source_locator\":\"\",\"provenance_lineage\":[],\"style_role\":\"body\"},{\"cell_id\":\"ethics:cell:prospective_review_procedure\",\"row_id\":\"ethics:row:prospective_review_procedure\",\"column_id\":\"ethics:col:fact\",\"text\":\"研究采用初始审查、修正案审查和定期继续审查；方案修正案在实施前获得伦理委员会批准，除非为消除对受试者的紧急危害。审查记录和沟通文件归档。\",\"source_locator\":\"chapter_input.resolved_facts.ethics.prospective_review_procedure\",\"provenance_lineage\":[],\"style_role\":\"body\"}]},{\"row_id\":\"ethics:row:approval_status\",\"order\":2,\"style_role\":\"body\",\"cells\":[{\"cell_id\":\"ethics:cell:approval_status_item\",\"row_id\":\"ethics:row:approval_status\",\"column_id\":\"ethics:col:item\",\"text\":\"批准状态\",\"source_locator\":\"\",\"provenance_lineage\":[],\"style_role\":\"body\"},{\"cell_id\":\"ethics:cell:review_status\",\"row_id\":\"ethics:row:approval_status\",\"column_id\":\"ethics:col:fact\",\"text\":\"研究开始前，方案、知情同意书、招募材料及其他受试者相关文件须获得伦理委员会批准；批准文件和成员名单归档。研究期间按伦理委员会要求提交继续审查和修正案审查。\",\"source_locator\":\"chapter_input.resolved_facts.ethics.approval_status\",\"provenance_lineage\":[],\"style_role\":\"body\"}]},{\"row_id\":\"ethics:row:responsible_role\",\"order\":3,\"style_role\":\"body\",\"cells\":[{\"cell_id\":\"ethics:cell:responsible_role_item\",\"row_id\":\"ethics:row:responsible_role\",\"column_id\":\"ethics:col:item\",\"text\":\"责任角色\",\"source_locator\":\"\",\"provenance_lineage\":[],\"style_role\":\"body\"},{\"cell_id\":\"ethics:cell:responsible_role\",\"row_id\":\"ethics:row:responsible_role\",\"column_id\":\"ethics:col:fact\",\"text\":\"主要研究者负责本中心伦理审查申请、伦理委员会沟通、方案依从和安全性报告；申办者负责提供必要文件并确保多中心研究按统一伦理要求管理。\",\"source_locator\":\"chapter_input.resolved_facts.ethics.responsible_role\",\"provenance_lineage\":[],\"style_role\":\"body\"}]},{\"row_id\":\"ethics:row:version_control\",\"order\":4,\"style_role\":\"body\",\"cells\":[{\"cell_id\":\"ethics:cell:version_control_item\",\"row_id\":\"ethics:row:version_control\",\"column_id\":\"ethics:col:item\",\"text\":\"版本控制\",\"source_locator\":\"\",\"provenance_lineage\":[],\"style_role\":\"body\"},{\"cell_id\":\"ethics:cell:version_control\",\"row_id\":\"ethics:row:version_control\",\"column_id\":\"ethics:col:fact\",\"text\":\"方案和知情同意书采用版本号和日期控制；研究中心仅使用伦理委员会批准的最新版本，版本变更、批准日期和生效日期记录在文件控制清单和受试者文件中。\",\"source_locator\":\"chapter_input.resolved_facts.ethics.version_control\",\"provenance_lineage\":[],\"style_role\":\"body\"}]},{\"row_id\":\"ethics:row:new_information_handling\",\"order\":5,\"style_role\":\"body\",\"cells\":[{\"cell_id\":\"ethics:cell:new_information_handling_item\",\"row_id\":\"ethics:row:new_information_handling\",\"column_id\":\"ethics:col:item\",\"text\":\"新信息处理\",\"source_locator\":\"\",\"provenance_lineage\":[],\"style_role\":\"body\"},{\"cell_id\":\"ethics:cell:new_information_handling\",\"row_id\":\"ethics:row:new_information_handling\",\"column_id\":\"ethics:col:fact\",\"text\":\"出现可能影响受试者安全、权益或研究继续开展的新信息时，研究者或申办者及时评估并报告伦理委员会和监管机构；必要时暂停研究、修改方案或知情同意书并重新取得同意。\",\"source_locator\":\"chapter_input.resolved_facts.ethics.new_information_handling\",\"provenance_lineage\":[],\"style_role\":\"body\"}]},{\"row_id\":\"ethics:row:before_procedure_confirmation\",\"order\":6,\"style_role\":\"body\",\"cells\":[{\"cell_id\":\"ethics:cell:before_procedure_confirmation_item\",\"row_id\":\"ethics:row:before_procedure_confirmation\",\"column_id\":\"ethics:col:item\",\"text\":\"程序前确认\",\"source_locator\":\"\",\"provenance_lineage\":[],\"style_role\":\"body\"},{\"cell_id\":\"ethics:cell:before_procedure_confirmation\",\"row_id\":\"ethics:row:before_procedure_confirmation\",\"column_id\":\"ethics:col:fact\",\"text\":\"在获得伦理委员会批准和受试者签署知情同意书前，不得进行任何研究相关程序；筛选评估仅在签署知情同意后按方案执行。\",\"source_locator\":\"chapter_input.resolved_facts.ethics.before_procedure_confirmation\",\"provenance_lineage\":[],\"style_role\":\"body\"}]}],\"notes\":[],\"word_layout\":{}}},{\"block_id\":\"block:v2-n-13-1:p2\",\"kind\":\"paragraph\",\"text\":\"研究采用初始审查、修正案审查和定期继续审查；方案修正案在实施前获得伦理委员会批准，除非为消除对受试者的紧急危害。审查记录和沟通文件归档。\",\"evidence_refs\":[],\"source_locator\":\"chapter_input.resolved_facts.ethics.prospective_review_procedure\"},{\"block_id\":\"block:v2-n-13-1:p3\",\"kind\":\"paragraph\",\"text\":\"研究开始前，方案、知情同意书、招募材料及其他受试者相关文件须获得伦理委员会批准；批准文件和成员名单归档。研究期间按伦理委员会要求提交继续审查和修正案审查。\",\"evidence_refs\":[],\"source_locator\":\"chapter_input.resolved_facts.ethics.approval_status\"},{\"block_id\":\"block:v2-n-13-1:p4\",\"kind\":\"paragraph\",\"text\":\"主要研究者负责本中心伦理审查申请、伦理委员会沟通、方案依从和安全性报告；申办者负责提供必要文件并确保多中心研究按统一伦理要求管理。\",\"evidence_refs\":[],\"source_locator\":\"chapter_input.resolved_facts.ethics.responsible_role\"},{\"block_id\":\"block:v2-n-13-1:p5\",\"kind\":\"paragraph\",\"text\":\"方案和知情同意书采用版本号和日期控制；研究中心仅使用伦理委员会批准的最新版本，版本变更、批准日期和生效日期记录在文件控制清单和受试者文件中。\",\"evidence_refs\":[],\"source_locator\":\"chapter_input.resolved_facts.ethics.version_control\"},{\"block_id\":\"block:v2-n-13-1:p6\",\"kind\":\"paragraph\",\"text\":\"出现可能影响受试者安全、权益或研究继续开展的新信息时，研究者或申办者及时评估并报告伦理委员会和监管机构；必要时暂停研究、修改方案或知情同意书并重新取得同意。\",\"evidence_refs\":[],\"source_locator\":\"chapter_input.resolved_facts.ethics.new_information_handling\"},{\"block_id\":\"block:v2-n-13-1:p7\",\"kind\":\"paragraph\",\"text\":\"在获得伦理委员会批准和受试者签署知情同意书前，不得进行任何研究相关程序；筛选评估仅在签署知情同意后按方案执行。\",\"evidence_refs\":[],\"source_locator\":\"chapter_input.resolved_facts.ethics.before_procedure_confirmation\"}]}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"62a4bdf5c71a74aeb4ec731636894f08598cd75ba67dc9736f316b2b0aedb610"}],"logical_call_id":"call:chapter-draft:0ceee533139b87e7bd8c3628a5fc2ff6c6d2e98ae31a450c3dacf205485620b0:chapter-generate","node_execution_contract_id":"nec:chapter-draft:0ceee533139b87e7bd8c3628a5fc2ff6c6d2e98ae31a450c3dacf205485620b0:chapter-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/ordered-chapter-draft-candidate.v1.json","output_sha256":"bcf99c01b68d67151958ff323ef2e7e01289b4a6928599b3b530b94886dd0383","prompt_sha256":"47dd66c834319411962b91127cd952207cccdab4dee7068a9ab81409e5aefa1e","provider_session_id":"7625f5d1-7671-444e-a0a4-0b9792a33203","requested_reasoning_effort":"max"},"schema":"model_response.v1"}