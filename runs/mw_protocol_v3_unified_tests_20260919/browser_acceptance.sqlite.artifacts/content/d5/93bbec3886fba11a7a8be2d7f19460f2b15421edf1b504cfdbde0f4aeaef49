{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-10-5:v2\",\n  \"node_id\": \"v2_n_10_5\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"block_id\": \"p_v2_n_10_5_001\",\n      \"kind\": \"paragraph\",\n      \"text\": \"本节中，特殊关注不良事件（AESI）是基于试验药物作用机制、非临床或临床安全性数据预先指定的、需持续监测并快速报告的不良事件或医学事件。AESI 的项目化选择复用已确认的 picos.aesi_definitions 事实，即根据合成药X的 IL-4Rα 拮抗作用机制及安全性特征预先指定需重点监测的不良事件；具体列表应在安全性管理计划中基于最新参考安全性信息确定。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"p_v2_n_10_5_002\",\n      \"kind\": \"paragraph\",\n      \"text\": \"任何 AESI 均应记录并评估；若 AESI 符合 SAE 标准、导致停药或需要特定干预，应按严重或快速报告流程处理。同类 AESI 的频率或严重程度明显增加时，应触发信号评估。上述阈值不采用通用模板默认值，而按本品 AESI 项目逐项应用并保持可追溯。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"b_v2_n_10_5_t01\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [],\n      \"table\": {\n        \"table_id\": \"tbl_v2_n_10_5_aesi\",\n        \"block_id\": \"b_v2_n_10_5_t01\",\n        \"title\": \"AESI 事件、阈值与监测/报告动作\",\n        \"domain\": \"ae_management\",\n        \"role\": \"body_content\",\n        \"review_state\": \"ai_draft\",\n        \"header_row_count\": 0,\n        \"source_locator\": \"\",\n        \"schema_version\": \"structured_table_v1\",\n        \"columns\": [\n          {\n            \"column_id\": \"aesi:col:event\",\n            \"label\": \"AESI 事件\",\n            \"order\": 0,\n            \"semantic_role\": \"event\",\n            \"style_role\": \"header\"\n          },\n          {\n            \"column_id\": \"aesi:col:threshold\",\n            \"label\": \"阈值\",\n            \"order\": 1,\n            \"semantic_role\": \"threshold\",\n            \"style_role\": \"header\"\n          },\n          {\n            \"column_id\": \"aesi:col:monitoring_action\",\n            \"label\": \"监测/报告动作\",\n            \"order\": 2,\n            \"semantic_role\": \"monitoring_action\",\n            \"style_role\": \"header\"\n          }\n        ],\n        \"rows\": [\n          {\n            \"row_id\": \"aesi:row:1\",\n            \"order\": 0,\n            \"cells\": [\n              {\n                \"cell_id\": \"aesi:cell:event\",\n                \"row_id\": \"aesi:row:1\",\n                \"column_id\": \"aesi:col:event\",\n                \"text\": \"合成药X 的产品特异性 AESI：依据 IL-4Rα 拮抗作用机制及最新参考安全性信息，在安全性管理计划中预先指定需持续监测并快速报告的医学事件\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"aesi:cell:threshold\",\n                \"row_id\": \"aesi:row:1\",\n                \"column_id\": \"aesi:col:threshold\",\n                \"text\": \"任何 AESI 均应记录并评估；符合 SAE 标准、导致停药或需要特定干预者按严重或快速报告流程处理；同类 AESI 频率或严重程度明显增加时触发信号评估\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"aesi:cell:monitoring_action\",\n                \"row_id\": \"aesi:row:1\",\n                \"column_id\": \"aesi:col:monitoring_action\",\n                \"text\": \"持续监测、记录和评估；符合 SAE 或 SUSAR 标准者按相应快速报告流程报告，其他 AESI 按方案规定报告\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              }\n            ]\n          }\n        ]\n      }\n    },\n    {\n      \"block_id\": \"p_v2_n_10_5_003\",\n      \"kind\": \"paragraph\",\n      \"text\": \"研究者和申办者应对 AESI 进行持续监测、记录和评估；符合 SAE 或 SUSAR 标准的 AESI 应按相应快速报告流程报告，其他 AESI 按方案规定报告。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"af0f3431623b931bb79257cd6d2a741c0359cf24ee2a8eff81c0e2542d2a3855"}],"