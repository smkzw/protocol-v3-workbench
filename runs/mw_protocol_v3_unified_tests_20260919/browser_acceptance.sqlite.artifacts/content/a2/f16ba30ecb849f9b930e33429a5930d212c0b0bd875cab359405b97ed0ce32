{"content":"{\"chapter_contract_id\":\"contract:v2-n-10-6:v2\",\"node_id\":\"v2_n_10_6\",\"schema_version\":\"ordered_chapter_draft_candidate.v1\",\"known_evidence_ids\":[],\"blocks\":[{\"block_id\":\"v2_n_10_6:block:001\",\"kind\":\"paragraph\",\"text\":\"本节规定妊娠相关管理要求，包括妊娠检测、妊娠预防、妊娠暴露报告、伴侣知情同意、妊娠结局随访、异常结局报告，以及因妊娠停用试验用药品后的随访与数据收集安排。妊娠本身不自动归为SAE；妊娠相关异常结局按SAE或相关安全性报告流程报告。\",\"evidence_refs\":[],\"source_locator\":\"\"},{\"block_id\":\"v2_n_10_6:block:002\",\"kind\":\"paragraph\",\"text\":\"妊娠检测：有生育潜力的女性受试者应在筛选期及研究期间按方案规定进行妊娠试验；结果阳性者应暂停或停止试验用药品并报告。具体检测、时点与适用人群如下表所示。\",\"evidence_refs\":[],\"source_locator\":\"\"},{\"block_id\":\"v2_n_10_6:block:003\",\"kind\":\"table\",\"evidence_refs\":[],\"table\":{\"table_id\":\"v2_n_10_6:table:001\",\"block_id\":\"v2_n_10_6:block:003\",\"title\":\"妊娠检测安排\",\"domain\":\"laboratory_panel\",\"role\":\"body_content\",\"schema_version\":\"structured_table_v1\",\"version\":0,\"header_row_count\":1,\"columns\":[{\"column_id\":\"pregnancy:col:test\",\"label\":\"检测\",\"order\":0,\"semantic_role\":\"test\",\"source_locator\":\"\",\"style_role\":\"header\",\"width_twips\":null},{\"column_id\":\"pregnancy:col:timing\",\"label\":\"时点\",\"order\":1,\"semantic_role\":\"timing\",\"source_locator\":\"\",\"style_role\":\"header\",\"width_twips\":null},{\"column_id\":\"pregnancy:col:population\",\"label\":\"适用人群\",\"order\":2,\"semantic_role\":\"population\",\"source_locator\":\"\",\"style_role\":\"header\",\"width_twips\":null}],\"rows\":[{\"row_id\":\"pregnancy:row:header\",\"order\":0,\"label\":\"\",\"source_locator\":\"\",\"style_role\":\"header\",\"cells\":[{\"cell_id\":\"v2_n_10_6:table:001:cell:h:test\",\"row_id\":\"pregnancy:row:header\",\"column_id\":\"pregnancy:col:test\",\"text\":\"检测\",\"source_locator\":\"\",\"provenance_lineage\":[],\"style_role\":\"header\",\"semantic_value\":null,\"rich_text\":null,\"column_span\":1,\"row_span\":1,\"note_refs\":[],\"condition_expression\":\"\"},{\"cell_id\":\"v2_n_10_6:table:001:cell:h:timing\",\"row_