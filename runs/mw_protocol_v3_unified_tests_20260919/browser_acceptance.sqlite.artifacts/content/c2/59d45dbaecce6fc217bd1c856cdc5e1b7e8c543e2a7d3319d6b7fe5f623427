{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-10-1-6:v2\",\n  \"node_id\": \"v2_n_10_1_6\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"block_id\": \"p:v2_n_10_1_6:scope\",\n      \"kind\": \"paragraph\",\n      \"text\": \"本节对AE随访范围、持续时间/终止条件及持续事件处理作出项目化规定。所有未缓解的AE和SAE均应纳入随访，随访范围包括住院、转归、治疗及最终结局；SAE还应按法规要求完成快速报告和随访报告。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"p:v2_n_10_1_6:duration\",\n      \"kind\": \"paragraph\",\n      \"text\": \"AE随访至事件缓解、恢复至基线、稳定、确定不再恢复，或受试者死亡、失访、撤回知情同意；SAE应随访至事件解决、稳定或获得明确转归，且不少于末次给药后30天。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"p:v2_n_10_1_6:ongoing\",\n      \"kind\": \"paragraph\",\n      \"text\": \"末次给药后30天仍持续存在的AE应记录为持续中并继续随访至解决或稳定；持续存在的SAE应按法规要求报告并随访至事件解决或稳定。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"f1f16f4261383a422f25bd4392ae403c6b6da9eef98a5603f7d932aacce1c10b"}],"logical_call_id":"call:chapter-draft:04afe4bd7cb5d5367c1a67822a103c0e9a310622cc040df0d54ca9be6cc7ebd2:chapter-generate","node_execution_contract_id":"nec:chapter-draft:04afe4bd7cb5d5367c1a67822a103c0e9a310622cc040df0d54ca9be6cc7ebd2:chapter-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/ordered-chapter-draft-candidate.v1.json","output_sha256":"cc9cb75fb3c4aa7e60e2961472d9019b2e0d46d51ac81e59f3db611bd63c52d4","prompt_sha256":"47dd66c834319411962b91127cd952207cccdab4dee7068a9ab81409e5aefa1e","provider_session_id":"c73cbe68-af44-43a2-857e-eb0ebc4dfc7b","requested_reasoning_effort":"max"},"schema":"model_response.v1"}