{"content":"{\"chapter_contract_id\":\"contract:v2-n-6-2-1:v2\",\"node_id\":\"v2_n_6_2_1\",\"schema_version\":\"ordered_chapter_draft_candidate.v1\",\"known_evidence_ids\":[],\"blocks\":[{\"block_id\":\"block:paragraph:heading:v2_n_6_2_1\",\"kind\":\"paragraph\",\"text\":\"6.2.1 试验用药品接收、清点、发放、回收与销毁\",\"evidence_refs\":[],\"source_locator\":\"\"},{\"block_id\":\"block:paragraph:responsibility_overview:v2_n_6_2_1\",\"kind\":\"paragraph\",\"text\":\"本中心试验用药品的接收、清点、储存、发放、使用、回收、返还和销毁应按照本方案、药物临床试验质量管理规范（GCP）和申办者标准操作规程（SOP）执行，并保持双盲和可追溯。研究者对研究中心试验用药品接收、清点、储存、发放、使用、回收和记录负总体责任；申办者负责提供试验用药品、标签、运输和销毁授权，并监督药物管理符合方案、GCP和适用法规；监查员核查药物管理记录与源文件，确认数量一致、储存合规和盲态维持；由研究者或其授权并经培训的临床试验人员负责准备和给药，药物分配与盲态维持由不参与疗效评价的指定人员执行。\",\"evidence_refs\":[],\"source_locator\":\"\"},{\"block_id\":\"block:table:receipt_inventory:v2_n_6_2_1\",\"kind\":\"table\",\"evidence_refs\":[],\"table\":{\"table_id\":\"table:intervention:receipt_inventory\",\"block_id\":\"block:table:receipt_inventory:v2_n_6_2_1\",\"title\":\"表1 试验用药品接收、储存与清点要求\",\"domain\":\"generic\",\"role\":\"body_content\",\"header_row_count\":1,\"columns\":[{\"column_id\":\"col:receipt_inventory:step\",\"label\":\"环节\",\"order\":0,\"style_role\":\"body\"},{\"column_id\":\"col:receipt_inventory:requirement\",\"label\":\"项目特定操作要求\",\"order\":1,\"style_role\":\"body\"},{\"column_id\":\"col:receipt_inventory:party\",\"label\":\"责任方\",\"order\":2,\"style_role\":\"body\"},{\"column_id\":\"col:receipt_inventory:record\",\"label\":\"记录字段与可追溯信息\",\"order\":3,\"style_role\":\"body\"}],\"rows\":[{\"row_id\":\"row:receipt_inventory:receipt\",\"order\":0,\"label\":\"接收\",\"cells\":[{\"cell_id\":\"intervention:cell:receipt_inventory:receipt:step\",\"row_id\":\"row:receipt_inventory:receipt\",\"column_id\":\"col:receipt_inventory:step\",\"text\":\"接收\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"},{\"cell_id\":\"intervention:cell:receipt_inventory:receipt:requirement\",\"row_id\":\"row:receipt_inventory:receipt\",\"column_id\":\"col:receipt_inventory:requirement\",\"text\":\"接收时核对申办者发运清单、药物名称/安慰剂、规格/体积、批号、数量、有效期、包装完整性和标签；记录接收日期、接收人、运输条件和温度偏离（如有）。\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"},{\"cell_id\":\"intervention:cell:receipt_inventory:receipt:party\",\"row_id\":\"row:receipt_inventory:receipt\",\"column_id\":\"col:receipt_inventory:party\",\"text\":\"研究者对研究中心试验用药品接收负总体责任；由研究者授权并经培训的临床试验人员执行。\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"},{\"cell_id\":\"intervention:cell:receipt_identity\",\"row_id\":\"row:receipt_inventory:receipt\",\"column_id\":\"col:receipt_inventory:record\",\"text\":\"接收日期、接收人、药物名称/安慰剂、规格/体积、批号、数量、有效期、运输条件、温度偏离及处理；应可追溯至申办者发运清单和实际批次/数量。\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"}]},{\"row_id\":\"row:receipt_inventory:storage\",\"order\":1,\"label\":\"储存与隔离\",\"cells\":[{\"cell_id\":\"intervention:cell:receipt_inventory:storage:step\",\"row_id\":\"row:receipt_inventory:storage\",\"column_id\":\"col:receipt_inventory:step\",\"text\":\"储存与隔离\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"},{\"cell_id\":\"intervention:cell:receipt_inventory:storage:requirement\",\"row_id\":\"row:receipt_inventory:storage\",\"column_id\":\"col:receipt_inventory:requirement\",\"text\":\"接收后按标签规定条件储存；隔离过期、破损或异常药物。\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"},{\"cell_id\":\"intervention:cell:receipt_inventory:storage:party\",\"row_id\":\"row:receipt_inventory:storage\",\"column_id\":\"col:receipt_inventory:party\",\"text\":\"研究者总体负责；授权人员执行；监查员核查储存合规。\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"},{\"cell_id\":\"intervention:cell:receipt_inventory:storage:record\",\"row_id\":\"row:receipt_inventory:storage\",\"column_id\":\"col:receipt_inventory:record\",\"text\":\"储存条件记录；异常、破损、过期或温度偏离记录及处理；隔离药物标识、数量、批号及处置去向。\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"}]},{\"row_id\":\"row:receipt_inventory:inventory\",\"order\":2,\"label\":\"清点\",\"cells\":[{\"cell_id\":\"intervention:cell:receipt_inventory:inventory:step\",\"row_id\":\"row:receipt_inventory:inventory\",\"column_id\":\"col:receipt_inventory:step\",\"text\":\"清点\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"},{\"cell_id\":\"intervention:cell:receipt_inventory:inventory:requirement\",\"row_id\":\"row:receipt_inventory:inventory\",\"column_id\":\"col:receipt_inventory:requirement\",\"text\":\"建立药物接收、储存、发放、使用、回收、返还和销毁清点记录，定期盘点并保持数量一致。\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"},{\"cell_id\":\"intervention:cell:receipt_inventory:inventory:party\",\"row_id\":\"row:receipt_inventory:inventory\",\"column_id\":\"col:receipt_inventory:party\",\"text\":\"研究者总体负责；授权人员执行；监查员核查药物管理记录与源文件，确认数量一致、储存合规和盲态维持。\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"},{\"cell_id\":\"intervention:cell:receipt_inventory:inventory:record\",\"row_id\":\"row:receipt_inventory:inventory\",\"column_id\":\"col:receipt_inventory:record\",\"text\":\"清点日期、环节、药物名称/安慰剂、批号、数量、库存平衡、差异调查和纠正措施；记录不得揭示治疗分配。\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"}]}],\"notes\":[],\"review_state\":\"ai_draft\",\"version\":0,\"schema_version\":\"structured_table_v1\",\"source_locator\":\"\",\"word_layout\":{}}},{\"block_id\":\"block:paragraph:dispensing_return:v2_n_6_2_1\",\"kind\":\"paragraph\",\"text\":\"试验用药品发放、给药、回收与返还应由研究者或其授权并经培训的临床试验人员执行；药物分配与盲态维持由不参与疗效评价的指定人员执行。发放前应核对随机号、药物标识、剂量/体积、给药日期和给药途径，按随机分配发放合成药X 150 mg/1.0 mL或生理盐水安慰剂1.0 mL，保持双盲并记录实际发放；试验参与者返还或研究中心回收未使用药物、空包装和剩余药物时，应记录日期、数量、批号及完整性，并与发放记录核对。\",\"evidence_refs\":[],\"source_locator\":\"\"},{\"block_id\":\"block:table:dispensing_disposition:v2_n_6_2_1\",\"kind\":\"table\",\"evidence_refs\":[],\"table\":{\"table_id\":\"table:intervention:dispensing_disposition\",\"block_id\":\"block:table:dispensing_disposition:v2_n_6_2_1\",\"title\":\"表2 试验用药品发放、回收、核对与销毁记录要求\",\"domain\":\"generic\",\"role\":\"body_content\",\"header_row_count\":1,\"columns\":[{\"column_id\":\"col:dispensing_disposition:step\",\"label\":\"环节\",\"order\":0,\"style_role\":\"body\"},{\"column_id\":\"col:dispensing_disposition:requirement\",\"label\":\"项目特定操作或条件\",\"order\":1,\"style_role\":\"body\"},{\"column_id\":\"col:dispensing_disposition:party\",\"label\":\"责任方\",\"order\":2,\"style_role\":\"body\"},{\"column_id\":\"col:dispensing_disposition:record\",\"label\":\"记录字段与可追溯信息\",\"order\":3,\"style_role\":\"body\"}],\"rows\":[{\"row_id\":\"row:dispensing_disposition:dispensing\",\"order\":0,\"label\":\"发放与给药\",\"cells\":[{\"cell_id\":\"intervention:cell:dispensing_disposition:dispensing:step\",\"row_id\":\"row:dispensing_disposition:dispensing\",\"column_id\":\"col:dispensing_disposition:step\",\"text\":\"发放与给药\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"},{\"cell_id\":\"intervention:cell:dispensing_disposition:dispensing:requirement\",\"row_id\":\"row:dispensing_disposition:dispensing\",\"column_id\":\"col:dispensing_disposition:requirement\",\"text\":\"按随机分配发放合成药X 150 mg/1.0 mL或生理盐水安慰剂1.0 mL；发放前核对随机号、药物标识、剂量/体积、给药日期和给药途径，保持双盲并记录实际发放。由不参与疗效评价的指定人员执行分配与盲态维持。\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"},{\"cell_id\":\"intervention:cell:dispensing_disposition:dispensing:party\",\"row_id\":\"row:dispensing_disposition:dispensing\",\"column_id\":\"col:dispensing_disposition:party\",\"text\":\"研究者或其授权并经培训的临床试验人员负责准备和给药；药物分配与盲态维持由不参与疗效评价的指定人员执行。\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"},{\"cell_id\":\"intervention:cell:accountability_record\",\"row_id\":\"row:dispensing_disposition:dispensing\",\"column_id\":\"col:dispensing_disposition:record\",\"text\":\"发放日期、随机号/试验参与者编号、药物名称/安慰剂、规格/体积、批号、数量；实际给药日期、剂量、体积、给药途径、是否按计划完成、延迟/遗漏/暂停原因及处理；发放和给药记录不得揭示治疗分配。\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"}]},{\"row_id\":\"row:dispensing_disposition:return\",\"order\":1,\"label\":\"回收与返还\",\"cells\":[{\"cell_id\":\"intervention:cell:dispensing_disposition:return:step\",\"row_id\":\"row:dispensing_disposition:return\",\"column_id\":\"col:dispensing_disposition:step\",\"text\":\"回收与返还\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"},{\"cell_id\":\"intervention:cell:dispensing_disposition:return:requirement\",\"row_id\":\"row:dispensing_disposition:return\",\"column_id\":\"col:dispensing_disposition:requirement\",\"text\":\"试验参与者返还或研究中心回收未使用药物、空包装和剩余药物，记录日期、数量、批号及完整性。\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"},{\"cell_id\":\"intervention:cell:dispensing_disposition:return:party\",\"row_id\":\"row:dispensing_disposition:return\",\"column_id\":\"col:dispensing_disposition:party\",\"text\":\"研究者总体负责；授权人员执行。\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"},{\"cell_id\":\"intervention:cell:dispensing_disposition:return:record\",\"row_id\":\"row:dispensing_disposition:return\",\"column_id\":\"col:dispensing_disposition:record\",\"text\":\"回收/返还日期、试验参与者编号、药物名称/安慰剂、批号、数量、空包装和剩余药物完整性、未使用原因（如适用）；应可追溯至发放记录。\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"}]},{\"row_id\":\"row:dispensing_disposition:reconciliation\",\"order\":2,\"label\":\"数量核对\",\"cells\":[{\"cell_id\":\"intervention:cell:dispensing_disposition:reconciliation:step\",\"row_id\":\"row:dispensing_disposition:reconciliation\",\"column_id\":\"col:dispensing_disposition:step\",\"text\":\"数量核对\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"},{\"cell_id\":\"intervention:cell:dispensing_disposition:reconciliation:requirement\",\"row_id\":\"row:dispensing_disposition:reconciliation\",\"column_id\":\"col:dispensing_disposition:requirement\",\"text\":\"将发放、使用、回收、剩余和销毁数量进行核对，差异须调查并记录；涉及盲态时按紧急揭盲程序处理。\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"},{\"cell_id\":\"intervention:cell:dispensing_disposition:reconciliation:party\",\"row_id\":\"row:dispensing_disposition:reconciliation\",\"column_id\":\"col:dispensing_disposition:party\",\"text\":\"研究者总体负责；监查员核查药物管理记录与源文件，确认数量一致、储存合规和盲态维持。\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"},{\"cell_id\":\"intervention:cell:dispensing_disposition:reconciliation:record\",\"row_id\":\"row:dispensing_disposition:reconciliation\",\"column_id\":\"col:dispensing_disposition:record\",\"text\":\"发放、使用、回收、剩余和销毁数量；药物计数和依从性记录；差异调查、纠正措施及报告；记录不得揭示治疗分配。\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"}]},{\"row_id\":\"row:dispensing_disposition:destruction\",\"order\":3,\"label\":\"销毁\",\"cells\":[{\"cell_id\":\"intervention:cell:dispensing_disposition:destruction:step\",\"row_id\":\"row:dispensing_disposition:destruction\",\"column_id\":\"col:dispensing_disposition:step\",\"text\":\"销毁\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"},{\"cell_id\":\"intervention:cell:dispensing_disposition:destruction:requirement\",\"row_id\":\"row:dispensing_disposition:destruction\",\"column_id\":\"col:dispensing_disposition:requirement\",\"text\":\"研究药物销毁须经申办者书面授权；研究中心不得自行销毁。由研究者或申办者指定人员按适用法规、申办者SOP和机构要求执行。\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"},{\"cell_id\":\"intervention:cell:dispensing_disposition:destruction:party\",\"row_id\":\"row:dispensing_disposition:destruction\",\"column_id\":\"col:dispensing_disposition:party\",\"text\":\"申办者负责销毁授权；研究者或申办者指定人员执行；监查员核查记录。\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"},{\"cell_id\":\"intervention:cell:destruction_record\",\"row_id\":\"row:dispensing_disposition:destruction\",\"column_id\":\"col:dispensing_disposition:record\",\"text\":\"销毁日期、药物名称/安慰剂、批号、数量、销毁方式、执行人、授权人和见证人；销毁记录应接受监查并可追溯至实际批次/数量。\",\"provenance_lineage\":[],\"note_refs\":[],\"source_locator\":\"\",\"style_role\":\"body\"}]}],\"notes\":[],\"review_state\":\"ai_draft\",\"version\":0,\"schema_version\":\"structured_table_v1\",\"source_locator\":\"\",\"word_layout\":{}}},{\"block_id\":\"block:paragraph:discrepancy_records_monitoring:v2_n_6_2_1\",\"kind\":\"paragraph\",\"text\":\"任何数量、标签、包装或温度偏离均应记录、调查并向申办者报告；如发现药物数量或记录差异，应调查并记录，涉及盲态时按紧急揭盲程序处理。药物发放/回收记录、注射给药记录、试验参与者日志或日记卡、源文件和病例报告表（CRF）均应保存并可追溯至实际产品批次/数量。准备、发放、给药和回收均需记录并接受监查；记录不得揭示治疗分配，盲态维持由不参与疗效评价的指定人员执行。\",\"evidence_refs\":[],\"source_locator\":\"\"}]}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"135c6410aa456e9bbfacce10926c6c75c40a2d06ca9909562f76da85634e7a8d"}],"logical_call_id":"call:chapter-draft:8c259b6ee07612b7d6fba316fb0511a61c2814b0af8463249838b270d3dd8044:chapter-generate","node_execution_contract_id":"nec:chapter-draft:8c259b6ee07612b7d6fba316fb0511a61c2814b0af8463249838b270d3dd8044:chapter-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/ordered-chapter-draft-candidate.v1.json","output_sha256":"e3f47599b2e9b72f6878eb23270efa5de858c2c4625a8c28415aa20b6f95e32e","prompt_sha256":"9aec0ea7a8d8361fdb1c273790e20e30d5e6b1d7680ac1c6c63436bd71300fac","provider_session_id":"a8a41728-c1ef-4290-b1ae-521d956d6924","requested_reasoning_effort":"max"},"schema":"model_response.v1"}