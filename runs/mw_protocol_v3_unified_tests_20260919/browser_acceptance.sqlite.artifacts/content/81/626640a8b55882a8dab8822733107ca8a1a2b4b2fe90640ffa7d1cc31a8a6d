{"content":"{\n  \"chapters\": {\n    \"v2_n_8_1\": {\n      \"discontinuation.individual_hold_applicable\": {\n        \"applicable\": true,\n        \"text\": \"适用。若受试者出现需要暂停研究干预的临床情况（如可疑与试验药物相关的具有临床意义的不良事件、实验室异常或合并用药/操作冲突），研究者可暂停个体给药并尽快完成安全性评估；暂停期间不得自行恢复，恢复须在评估完成且符合方案和医学监查要求后进行。\"\n      },\n      \"discontinuation.individual_hold_requires_permanent_stop\": {\n        \"requires_permanent_stop\": false,\n        \"text\": \"个体暂停不必然导致永久停止研究干预。暂停后若安全性评估显示可继续且未达到永久停药标准，可按方案和医学监查要求恢复给药；若达到永久停药标准，则永久停止研究干预。\"\n      },\n      \"discontinuation.permanent_stop_criteria.participant\": {\n        \"criteria\": [\n          \"受试者撤回知情同意或明确要求永久停止研究干预\",\n          \"发生与试验药物相关的严重不良事件或不可耐受毒性，研究者判断继续给药风险大于获益\",\n          \"发生重度过敏或超敏反应，或需紧急处理的系统性反应\",\n          \"具有临床意义的实验室检查、生命体征或其他安全性异常经重复确认，且研究者或医学监查员判断需永久停药\",\n          \"研究者判断继续给药不符合受试者最佳利益\",\n          \"申办者、伦理委员会或监管机构要求永久停止\"\n        ],\n        \"text\": \"达到上述任一标准时永久停止研究干预，并按方案继续安全性随访；撤回知情同意者不再进行新的研究相关操作。\"\n      },\n      \"discontinuation.permanent_stop_recording\": {\n        \"text\": \"永久停止研究干预需在eCRF中记录日期、原因、与试验药物关系、是否达到方案定义标准、是否继续研究随访；相关不良事件或严重不良事件按GCP和安全性报告流程报告。\"\n      },\n      \"discontinuation.safety_assessment_coherence\": {\n        \"text\": \"个体暂停或永久停药决策应与安全性评估、不良事件/严重不良事件报告和随访安排一致；暂停后需完成方案规定的安全性评估，达到永久停药标准者停止给药并继续安全性随访至第24周或医学监查确认结束。\"\n      },\n      \"discontinuation.trial_stop_decision_authority\": {\n        \"text\": \"试验整体暂停或终止由申办者会同研究者、医学监查员决定；涉及受试者安全时按法规和伦理委员会、监管机构要求报告并执行。\"\n      },\n      \"discontinuation.trial_stop_decision_logic\": {\n        \"text\": \"当出现系统性安全性信号、影响试验继续的严重方案违背、监管或伦理要求，或无法控制的风险时，应评估风险获益并决定暂停入组/给药或终止试验。\"\n      },\n      \"discontinuation.trial_stop_post_decision\": {\n        \"text\": \"决定暂停或终止后，立即停止相关入组或给药，通知所有中心，确保受试者安全并安排必要的安全性随访和转归，按法规报告伦理委员会和监管机构，记录并保存所有决定及依据。\"\n      },\n      \"discontinuation.trial_suspension_criteria\": {\n        \"text\": \"出现可能影响受试者安全的非预期严重不良反应聚集、系统性安全性问题、中心严重方案违背、监管或伦理要求暂停等情形时，可暂停试验入组或给药，待评估后决定恢复或终止。\"\n      },\n      \"discontinuation.trial_termination_criteria\": {\n        \"text\": \"出现明确不可接受的安全性风险、无效或获益/风险比不支持继续、监管机构或伦理委员会要求终止、申办者无法继续实施等情形时，终止试验。\"\n      }\n    },\n    \"v2_n_8_2\": {\n      \"discontinuation.basis_for_further_collection\": {\n        \"text\": \"受试者停用研究干预但未撤回知情同意时，继续按方案收集安全性和疗效随访数据；撤回知情同意后不再收集新数据，除非法规要求或受试者另行同意。\"\n      },\n      \"discontinuation.continued_assessment_scope\": {\n        \"text\": \"若仅停止研究干预，继续至第24周的关键疗效、安全性、合并用药和不良事件随访；若撤回知情同意，则终止所有研究相关随访，仅保留已收集数据。\"\n      },\n      \"discontinuation.continued_data_types\": {\n        \"text\": \"停止干预后继续收集：不良事件/严重不良事件、合并用药、生命体征、实验室检查、鼻息肉评分、鼻塞VAS、SNOT-22、Lund-Kennedy内镜评分等方案计划评估，以及退出原因和转归。\"\n      },\n      \"discontinuation.data_retention_after_withdrawal\": {\n        \"text\": \"撤回知情同意后，已收集的数据和标本按法规、伦理和知情同意约定保留并用于分析；不再进行新的研究相关操作，除非受试者另行同意或法规要求。\"\n      },\n      \"discontinuation.disposition_schedule_integration\": {\n        \"text\": \"受试者中止或退出时完成提前退出访视，记录末次给药日期、末次评估日期、退出原因和转归，并安排安全性随访；数据录入eCRF并纳入分析。\"\n      },\n      \"discontinuation.existing_data_handling\": {\n        \"text\": \"退出前已收集的数据纳入FAS和安全性分析；主要终点缺失按无应答插补处理，敏感性分析采用tipping point。撤回知情同意不影响已收集数据按预定义分析计划使用。\"\n      },\n      \"discontinuation.followup_after_withdrawal\": {\n        \"text\": \"仅停用干预者继续随访至第24周；因不良事件停药者随访至事件稳定或恢复，并按医学监查要求完成安全性随访；撤回知情同意者不进行进一步研究随访。\"\n      },\n      \"discontinuation.replacement_policy\": {\n        \"text\": \"不替换退出或失访的受试者；样本量已按8%失访膨胀，分析按ITT/FAS原则进行。\"\n      },\n      \"discontinuation.time_limits\": {\n        \"text\": \"退出或失访时间以末次研究接触或末次可评价日期记录；随访窗口按方案访视窗口执行；撤回知情同意后无新的研究随访时间。\"\n      },\n      \"discontinuation.withdrawal_reason_recording\": {\n        \"text\": \"在eCRF中记录退出或中止原因，包括不良事件、缺乏疗效、撤回知情同意、失访、研究者判断、死亡等；尽量记录具体不良事件或原因，并标明与试验药物关系。\"\n      },\n      \"discontinuation.withdrawal_scenarios\": {\n        \"scenarios\": [\n          \"受试者撤回知情同意，退出整个研究\",\n          \"仅停止研究干预但继续研究随访\",\n          \"因不良事件或严重不良事件永久停止研究干预\",\n          \"失访\",\n          \"死亡\",\n          \"研究者或申办者决定终止参与\",\n          \"因鼻塞加重接受方案允许的救援治疗，按ICE记录并继续随访，不自动视为退出\"\n        ],\n        \"text\": \"上述情形需在eCRF中明确区分，并按对应路径完成随访、记录和分析。\"\n      }\n    },\n    \"v2_n_8_3\": {\n      \"lost_to_followup.attempt_records\": {\n        \"text\": \"每次联系尝试均记录日期、时间、方式、联系对象、结果和操作者；记录保存在受试者源文件和eCRF或随访记录中。\"\n      },\n      \"lost_to_followup.consent_and_outcome_distinction\": {\n        \"text\": \"失访不同于撤回知情同意：撤回知情同意是受试者明确决定退出，之后不再联系；失访是经多次合理尝试仍无法联系，且无明确撤回同意。若无法联系但已知死亡或转归，应记录为相应结局而非失访。\"\n      },\n      \"lost_to_followup.contact_attempt_procedure\": {\n        \"text\": \"在第24周访视窗口及随访到期后，通过电话、短信或邮件、信件等经批准的联系方式至少进行3次联系尝试，尽量覆盖不同日期和时段；可联系受试者提供的紧急联系人，但需符合知情同意和隐私要求。\"\n      },\n      \"lost_to_followup.participant_contact_restrictions\": {\n        \"text\": \"联系不得侵犯隐私，不得向无关人员披露研究信息；仅使用受试者授权联系方式；受试者撤回知情同意或要求停止联系后，不再进行失访联系。\"\n      },\n      \"lost_to_followup.review_and_classification\": {\n        \"text\": \"由研究者或指定人员审核联系记录，确认已按程序完成合理尝试后，将受试者分类为失访；分类日期、依据和末次接触日期记录在eCRF。若后续恢复联系，按方案评估是否继续随访。\"\n      },\n      \"lost_to_followup.role_and_approvals\": {\n        \"text\": \"研究中心研究者负责联系、记录和初步分类；医学监查员或申办者审核失访分类及对分析的影响；必要时与伦理委员会沟通。所有分类和审批记录保存。\"\n      }\n    },\n    \"v2_n_9_1\": {\n      \"efficacy.assessment_instrument_or_scale\": {\n        \"instruments\": [\n          \"双侧鼻息肉评分（NPS），每侧0～4分，总分0～8分\",\n          \"鼻塞VAS，0～10 cm视觉模拟量表，缓解阈值≤1分\",\n          \"SNOT-22量表\",\n          \"Lund-Kennedy内镜评分\"\n        ],\n        \"text\": \"主要终点采用双侧NPS和鼻塞VAS；次要终点采用SNOT-22和Lund-Kennedy内镜评分。\"\n      },\n      \"efficacy.assessment_timing_reference\": {\n        \"text\": \"基线在首次给药前评估；主要终点和次要终点均在第24周评估；SNOT-22和Lund-Kennedy较基线变化以第24周为评价时点。\"\n      },\n      \"efficacy.evaluator_role_and_training\": {\n        \"text\": \"NPS和Lund-Kennedy由经过培训的研究者或耳鼻喉科评估者实施，尽可能由同一评估者在各访视进行；评估者需接受方案、评分标准和一致性培训。鼻塞VAS和SNOT-22由受试者按方案指导完成。\"\n      },\n      \"efficacy.primary_endpoint_measurement\": {\n        \"text\": \"第24周临床缓解率，定义为第24周达到双侧NPS≤1且鼻塞VAS≤1的受试者比例。\"\n      },\n      \"efficacy.primary_estimand_link\": {\n        \"text\": \"主要估计目标对应：人群为成人慢性鼻窦炎伴鼻息肉患者（FAS，ITT原则）；变量为第24周临床缓解；治疗为合成药X 150 mg皮下方案对比安慰剂；ICE按治疗策略处理；群体汇总为缓解率比例，采用按中心分层CMH检验，报告风险差及95%CI。\"\n      },\n      \"evaluation.framework_scope\": {\n        \"text\": \"疗效评估框架包括主要终点、关键次要终点SNOT-22和描述性次要终点Lund-Kennedy。主要分析集为FAS；主要终点缺失采用无应答插补，敏感性分析采用tipping point。关键次要终点采用固定序列检验控制多重性。\"\n      }\n    },\n    \"v2_n_9_2\": {\n      \"safety.assessment_restrictions\": {\n        \"text\": \"安全性评估按统一方案和访视窗口进行；评估前避免使用可能干扰判断的合并用药或操作，若发生需记录。不良事件和严重不良事件按GCP报告。\"\n      },\n      \"safety.assessment_windows\": {\n        \"text\": \"安全性评估覆盖筛选期、基线、负荷期、维持期至第24周末次给药及安全性随访；访视窗口按方案规定执行。\"\n      },\n      \"safety.central_lab_applicable\": false,\n      \"safety.future_use_specimen_distinction\": {\n        \"text\": \"用于方案规定安全性或疗效评估的标本与未来研究用标本应区分；未来使用需在知情同意中单独说明并取得同意，未同意者标本不用于未来研究。\"\n      },\n      \"safety.lab_panel_definition\": {\n        \"text\": \"安全性实验室检查包括血常规、血生化、肝肾功能、电解质等常规指标；具体项目按方案和研究中心标准执行。\"\n      },\n      \"safety.lab_units_and_reference_ranges\": {\n        \"text\": \"实验室检查记录单位、参考范围和异常判断；采用当地实验室报告单位与参考范围，异常结果按CTCAE或方案定义分级。\"\n      },\n      \"safety.monitoring_assessments\": {\n        \"text\": \"安全性监测包括不良事件/严重不良事件、生命体征、体格检查、注射部位反应、实验室检查、合并用药以及临床需要的其他检查。\"\n      },\n      \"safety.monitoring_schedule\": {\n        \"text\": \"筛选期、基线、负荷期第1、8、15、22天、维持期第36天起每两周至第24周，以及安全性随访进行安全性评估；不良事件和严重不良事件按方案规定持续收集至安全性随访结束。\"\n      },\n      \"safety.repeat_confirmation_rules\": {\n        \"text\": \"对具有临床意义的异常实验室检查、生命体征或其他安全性结果，应重复检测确认；若重复仍异常或加重，按不良事件或严重不良事件处理并评估是否暂停或永久停用研究干预。\"\n      },\n      \"safety.special_assay_purposes\": {\n        \"text\": \"本方案未规定特殊检测；常规安全性实验室检查用于安全性监测。\"\n      },\n      \"safety.specimen_types_and_handling\": {\n        \"text\": \"标本类型包括血液、尿液等，按当地实验室和方案要求采集、处理、储存和运输；注射部位反应和不良事件记录不涉及特殊标本。\"\n      }\n    },\n    \"v2_n_9_3\": {\n      \"exploratory.immunogenicity_applicable\": false,\n      \"exploratory.population_pk_applicable\": false,\n      \"statistics.pk_pd_er.er_applicable\": {\n        \"applicable\": false,\n        \"text\": \"本方案未计划暴露-反应分析。\"\n      },\n      \"statistics.pk_pd_er.pd_applicable\": {\n        \"applicable\": false,\n        \"text\": \"本方案未计划药效学评估。\"\n      },\n      \"statistics.pk_pd_er.pk_applicable\": {\n        \"applicable\": false,\n        \"text\": \"本方案未计划群体药动学评估。\"\n      }\n    },\n    \"v2_n_9_4\": {\n      \"irc.applicable\": false\n    },\n    \"v2_n_front_1\": {\n      \"document_control.amendment_exists\": {\n        \"exists\": false,\n        \"text\": \"本方案为初始版本，无修订记录。\"\n      },\n      \"document_control.initial_version_treatment\": {\n        \"text\": \"初始版本作为当前执行版本，后续如有修订需更新版本号和修订历史。\"\n      },\n      \"document_control.version_date\": {\n        \"text\": \"无修订日期；初始版本日期以方案定稿签署或批准日期记录。\"\n      },\n      \"document_control.version_history\": {\n        \"text\": \"版本历史仅包含初始版本，无既往版本修订记录。\"\n      }\n    }\n  }\n}","receipt":{"idempotency_key":"chapter-facts.derive.v1","input_artifacts":[{"ref":"chapter-facts-input","sha256":"ea98ff401e2c5c16a188a18bbe3add15d9e89c0850a841eac8c6f58048a63958"}],"logical_call_id":"call:chapter-facts:ea98ff401e2c5c16a188a18bbe3add15d9e89c0850a841eac8c6f58048a63958","node_execution_contract_id":"nec:chapter-facts:ea98ff401e2c5c16a188a18bbe3add15d9e89c0850a841eac8c6f58048a63958","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/chapter-facts-output.v1.json","output_sha256":"f196f5c4b948a34798fffbd8a3fa3e653e9857a536b41bb12e3154ce6b0acca4","prompt_sha256":"81a4f629a6890c6f801162e4a74b9ab00ea246faf6b827f82fb3d8a5fee50daf","provider_session_id":"901191fa-973f-40f5-b310-6e498f42491c","requested_reasoning_effort":"max"},"schema":"model_response.v1"}