{"content":"{\"chapter_contract_id\":\"contract:v2-n-12-1:v2\",\"node_id\":\"v2_n_12_1\",\"schema_version\":\"ordered_chapter_draft_candidate.v1\",\"known_evidence_ids\":[],\"blocks\":[{\"block_id\":\"blk:v2_n_12_1:paragraph:intro\",\"kind\":\"paragraph\",\"text\":\"本章节依据已确认研究事实描述本项目数据收集和管理职责。下列角色、源数据识别、质疑与更正控制及相关责任边界仅使用已确认事实；未在已确认事实中出现的伦理审查、隐私保护、数据未来使用和补偿安排，列入待补/建议解决事项。\",\"evidence_refs\":[],\"source_locator\":\"\"},{\"block_id\":\"blk:v2_n_12_1:table:data_management_responsibilities\",\"kind\":\"table\",\"evidence_refs\":[],\"table\":{\"table_id\":\"tbl:v2_n_12_1:data_management_responsibilities\",\"block_id\":\"blk:v2_n_12_1:table:data_management_responsibilities\",\"title\":\"数据收集和管理职责表\",\"domain\":\"generic\",\"role\":\"body_content\",\"review_state\":\"ai_draft\",\"source_locator\":\"812–813\",\"header_row_count\":0,\"version\":0,\"schema_version\":\"structured_table_v1\",\"columns\":[{\"column_id\":\"activity\",\"label\":\"数据收集和管理活动\",\"order\":0,\"semantic_role\":\"activity\",\"style_role\":\"header\",\"source_locator\":\"812–813\"},{\"column_id\":\"role_owner\",\"label\":\"责任方/角色\",\"order\":1,\"semantic_role\":\"role_owner\",\"style_role\":\"header\",\"source_locator\":\"812–813\"},{\"column_id\":\"source_authority\",\"label\":\"源数据/依据与控制边界\",\"order\":2,\"semantic_role\":\"source_authority\",\"style_role\":\"header\",\"source_locator\":\"812–813\"},{\"column_id\":\"responsibility\",\"label\":\"职责说明\",\"order\":3,\"semantic_role\":\"responsibility\",\"style_role\":\"header\",\"source_locator\":\"812–813\"}],\"rows\":[{\"row_id\":\"row:source_data_entry_review\",\"order\":0,\"label\":\"源数据采集、录入与核查\",\"style_role\":\"body\",\"source_locator\":\"812–813\",\"cells\":[{\"cell_id\":\"cell:source_data_entry_review:activity\",\"row_id\":\"row:source_data_entry_review\",\"column_id\":\"activity\",\"text\":\"源数据采集、录入与核查\",\"style_role\":\"body\",\"source_locator\":\"812–813\",\"provenance_lineage\":[]},{\"cell_id\":\"data:cell:role_owner\",\"row_id\":\"row:source_