e_role\":\"body\",\"source_locator\":\"812–813\",\"cells\":[{\"cell_id\":\"cell:statistical_analysis:activity\",\"row_id\":\"row:statistical_analysis\",\"column_id\":\"activity\",\"text\":\"统计分析\",\"style_role\":\"body\",\"source_locator\":\"812–813\",\"provenance_lineage\":[]},{\"cell_id\":\"cell:statistical_analysis:role_owner\",\"row_id\":\"row:statistical_analysis\",\"column_id\":\"role_owner\",\"text\":\"统计师\",\"style_role\":\"body\",\"source_locator\":\"812–813\",\"provenance_lineage\":[]},{\"cell_id\":\"cell:statistical_analysis:source_authority\",\"row_id\":\"row:statistical_analysis\",\"column_id\":\"source_authority\",\"text\":\"统计分析计划；分析数据集和统计记录待补\",\"style_role\":\"body\",\"source_locator\":\"812–813\",\"provenance_lineage\":[]},{\"cell_id\":\"cell:statistical_analysis:responsibility\",\"row_id\":\"row:statistical_analysis\",\"column_id\":\"responsibility\",\"text\":\"统计师负责统计分析计划制定和统计分析。\",\"style_role\":\"body\",\"source_locator\":\"812–813\",\"provenance_lineage\":[]}]},{\"row_id\":\"row:correction_review\",\"order\":5,\"label\":\"数据更正与审核\",\"style_role\":\"body\",\"source_locator\":\"812–813\",\"cells\":[{\"cell_id\":\"cell:correction_review:activity\",\"row_id\":\"row:correction_review\",\"column_id\":\"activity\",\"text\":\"数据更正与审核\",\"style_role\":\"body\",\"source_locator\":\"812–813\",\"provenance_lineage\":[]},{\"cell_id\":\"cell:correction_review:role_owner\",\"row_id\":\"row:correction_review\",\"column_id\":\"role_owner\",\"text\":\"研究者或授权人员；数据管理员；监查员\",\"style_role\":\"body\",\"source_locator\":\"812–813\",\"provenance_lineage\":[]},{\"cell_id\":\"cell:correction_review:source_authority\",\"row_id\":\"row:correction_review\",\"column_id\":\"source_authority\",\"text\":\"源文件、eCRF、稽查轨迹\",\"style_role\":\"body\",\"source_locator\":\"812–813\",\"provenance_lineage\":[]},{\"cell_id\":\"cell:correction_review:responsibility\",\"row_id\":\"row:correction_review\",\"column_id\":\"responsibility\",\"text\":\"研究者或授权人员负责在源文件和eCRF中更正数据，并记录更正原因和日期；数据管理员负责审核数据更正和质疑答复；监查员负责源数据核查；所有数据更正和审核活动保留稽查轨迹。\",\"style_role\":\"body\",\"source_locator\":\"812–813\",\"provenance_lineage\":[]}]},{\"row_id\":\"row:query_management\",\"order\":6,\"label\":\"质疑管理\",\"style_role\":\"body\",\"source_locator\":\"812–813\",\"cells\":[{\"cell_id\":\"cell:query_management:activity\",\"row_id\":\"row:query_management\",\"column_id\":\"activity\",\"text\":\"质疑管理\",\"style_role\":\"body\",\"source_locator\":\"812–813\",\"provenance_lineage\":[]},{\"cell_id\":\"cell:query_management:role_owner\",\"row_id\":\"row:query_management\",\"column_id\":\"role_owner\",\"text\":\"数据管理员；研究者或其授权的临床人员；数据管理员和监查员；研究者、申办者医学监查员\",\"style_role\":\"body\",\"source_locator\":\"812–813\",\"provenance_lineage\":[]},{\"cell_id\":\"cell:query_management:source_authority\",\"row_id\":\"row:query_management\",\"column_id\":\"source_authority\",\"text\":\"质疑发放、解决、审核和升级角色安排；具体记录待补\",\"style_role\":\"body\",\"source_locator\":\"812–813\",\"provenance_lineage\":[]},{\"cell_id\":\"cell:query_management:responsibility\",\"row_id\":\"row:query_management\",\"column_id\":\"responsibility\",\"text\":\"数据管理员负责发放质疑；研究者或其授权的临床人员负责解决质疑；数据管理员和监查员负责审核；研究者、申办者医学监查员负责升级。\",\"style_role\":\"body\",\"source_locator\":\"812–813\",\"provenance_lineage\":[]}]},{\"row_id\":\"row:source_identification_plan\",\"order\":7,\"label\":\"源数据识别计划/源数据映射\",\"style_role\":\"body\",\"source_locator\":\"812–813\",\"cells\":[{\"cell_id\":\"cell:source_identification_plan:activity\",\"row_id\":\"row:source_identification_plan\",\"column_id\":\"activity\",\"text\":\"源数据识别计划/源数据映射\",\"style_role\":\"body\",\"source_locator\":\"812–813\",\"provenance_lineage\":[]},{\"cell_id\":\"cell:source_identification_plan:role_owner\",\"row_id\":\"row:source_identification_plan\",\"column_id\":\"role_owner\",\"text\":\"待补：已确认事实未指定建立和维护责任人\",\"style_role\":\"body\",\"source_locator\":\"\",\"provenance_lineage\":[]},{\"cell_id\":\"cell:source_identification_plan:source_authority\",\"row_id\":\"row:source_identification_plan\",\"column_id\":\"source_authority\",\"text\":\"源数据识别计划/源数据映射\",\"style_role\":\"body\",\"source_locator\":\"812–813\",\"provenance_lineage\":[]},{\"cell_id\":\"cell:source_identification_plan:responsibility\",\"row_id\":\"row:source_identification_plan\",\"column_id\":\"responsibility\",\"text\":\"在研究启动前建立源数据识别计划/源数据映射，明确每个eCRF变量对应的源文件、采集方式和责任人；若变量直接录入eCRF且无独立源文件，需在源数据识别计划中注明并符合ALCOA+原则。\",\"style_role\":\"body\",\"source_locator\":\"812–813\",\"provenance_lineage\":[]}]}],\"notes\":[{\"note_id\":\"note:dm:source_plan\",\"note_type\":\"operational\",\"text\":\"源数据识别计划/源数据映射应在研究启动前建立，明确每个eCRF变量对应的源文件、采集方式和责任人；若变量直接录入eCRF且无独立源文件，需在源数据识别计划中注明并符合ALCOA+原则。\",\"target_ids\":[\"row:source_identification_plan\"],\"source_refs\":[],\"marker_source_locator\":\"812–813\"}]}},{\"block_id\":\"blk:v2_n_12_1:paragraph:responsible_parties\",\"kind\":\"paragraph\",\"text\":\"责任主体：研究者负责源数据采集、eCRF录入、质疑答复和数据的医学准确性；监查员负责源数据核查和方案依从性监查；数据管理员负责数据清理、质疑管理和数据库锁定准备；申办者负责整体数据管理、数据库建立、数据质量控制及统计分析；统计师负责统计分析计划制定和统计分析。\",\"evidence_refs\":[],\"source_locator\":\"812–813\"},{\"block_id\":\"blk:v2_n_12_1:paragraph:role_assignments\",\"kind\":\"paragraph\",\"text\":\"角色安排：数据管理由数据管理员负责；数据库锁定由数据管理员发起、申办者批准；医学审理由医学监查员/研究者承担；源数据录入由研究者或授权人员承担；源数据核查由监查员承担；统计分析由统计师承担。\",\"evidence_refs\":[],\"source_locator\":\"812–813\"},{\"block_id\":\"blk:v2_n_12_1:paragraph:source_identification_plan\",\"kind\":\"paragraph\",\"text\":\"源数据识别计划：在研究启动前建立源数据识别计划/源数据映射，明确每个eCRF变量对应的源文件、采集方式和责任人。若变量直接录入eCRF且无独立源文件，需在源数据识别计划中注明并符合ALCOA+原则。源文件包括门诊/住院病历、实验室报告、心电图报告、内镜报告、VAS评分表、药物发放记录。\",\"evidence_refs\":[],\"source_locator\":\"812–813\"},{\"block_id\":\"blk:v2_n_12_1:paragraph:query_correction_control\",\"kind\":\"paragraph\",\"text\":\"质疑与更正控制：数据管理员负责发放质疑；研究者或其授权的临床人员负责解决质疑；数据管理员和监查员负责审核；研究者、申办者医学监查员负责升级。研究者或授权人员负责在源文件和eCRF中更正数据，并记录更正原因和日期；数据管理员负责审核数据更正和质疑答复；监查员负责源数据核查；所有数据更正和审核活动保留稽查轨迹。\",\"evidence_refs\":[],\"source_locator\":\"812–813\"},{\"block_id\":\"blk:v2_n_12_1:paragraph:pending_boundaries\",\"kind\":\"paragraph\",\"text\":\"待补/建议解决：伦理审查、隐私保护、数据未来使用和补偿安排的边界需由项目事实补充，包括适用责任方、记录、协议和审批/知情安排；不得以“不适用”替代强制内容。\",\"evidence_refs\":[],\"source_locator\":\"\"},{\"block_id\":\"blk:v2_n_12_1:paragraph:evidence_status\",\"kind\":\"paragraph\",\"text\":\"可追溯证据状态：本候选未接收 evidence 单元，无法将源窗口812–813的实际项目安排逐项绑定至 evidence_unit_id；正式内容核对前需补充项目主要来源证据并逐项建立证据链。\",\"evidence_refs\":[],\"source_locator\":\"\"}]}","receipt":{"idempotency_key":"chapter-draft.correct.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"411d3fe902b7f995e819c266688395a42ace78182435700281d43bb0918fb26a"},{"ref":"correction-context","sha256":"bb3659e6ac2aa0d3c1391d0e234f6dfaadd7bde899565b642c41436f487ac987"}],"logical_call_id":"call:chapter-draft:fa8af1848d0b987552b4ec6d25da6447ec9ff5f8a24d94ace49c0e8ff3eb4297:correction:1:chapter-generate","node_execution_contract_id":"nec:chapter-draft:fa8af1848d0b987552b4ec6d25da6447ec9ff5f8a24d94ace49c0e8ff3eb4297:correction:1:chapter-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/ordered-chapter-draft-candidate.v1.json","output_sha256":"87ff161ead0a8acae423d38c2625ed6b5ed5a8dcc0b04013c5f5388e8885dcc6","prompt_sha256":"47dd66c834319411962b91127cd952207cccdab4dee7068a9ab81409e5aefa1e","provider_session_id":"7ea09913-d2e3-4015-9dc7-c275519ac2bd","requested_reasoning_effort":"max"},"schema":"model_response.v1"}