{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-14-3:v2\",\n  \"node_id\": \"v2_n_14_3\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"block_id\": \"blk:v2_n_14_3:001\",\n      \"kind\": \"paragraph\",\n      \"text\": \"本节监查安排如下：监查应基于风险，范围与频率应与试验的复杂性、关键终点和潜在风险相称；监查范围包括知情同意、受试者合格性、主要终点和次要终点评估（NPS、鼻塞VAS、SNOT-22、Lund-Kennedy）、随机化和盲法、研究药物管理、方案依从性、源数据与病例报告表一致性、安全性报告和试验记录保存。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:v2_n_14_3:002\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [],\n      \"table\": {\n        \"table_id\": \"tbl:v2_n_14_3:monitoring-arrangements\",\n        \"block_id\": \"blk:v2_n_14_3:002\",\n        \"title\": \"监查安排与记录\",\n        \"schema_version\": \"structured_table_v1\",\n        \"domain\": \"generic\",\n        \"role\": \"body_content\",\n        \"review_state\": \"ai_draft\",\n        \"version\": 0,\n        \"header_row_count\": 0,\n        \"source_locator\": \"\",\n        \"columns\": [\n          {\n            \"column_id\": \"col:v2_n_14_3:t1:element\",\n            \"order\": 0,\n            \"label\": \"监查要素\",\n            \"semantic_role\": \"category\",\n            \"style_role\": \"header\",\n            \"source_locator\": \"\",\n            \"width_twips\": null\n          },\n          {\n            \"column_id\": \"col:v2_n_14_3:t1:arrangement\",\n            \"order\": 1,\n            \"label\": \"项目安排\",\n            \"semantic_role\": \"arrangement\",\n            \"style_role\": \"header\",\n            \"source_locator\": \"\",\n            \"width_twips\": null\n          },\n          {\n            \"column_id\": \"col:v2_n_14_3:t1:records\",\n            \"order\": 2,\n            \"label\": \"记录与留存\",\n            \"semantic_role\": \"records\",\n            \"style_role\": \"header\",\n            \"source_locator\": \"\",\n            \"width_twips\": null\n          }\n        ],\n        \"rows\": [\n          {\n            \"row_id\": \"row:v2_n_14_3:t1:r1\",\n            \"order\": 0,\n            \"style_role\": \"body\",\n            \"source_locator\": \"\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:v2_n_14_3:t1:r1:c1\",\n                \"row_id\": \"row:v2_n_14_3:t1:r1\",\n                \"column_id\": \"col:v2_n_14_3:t1:element\",\n                \"text\": \"监查范围与程度\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_14_3:t1:r1:c2\",\n                \"row_id\": \"row:v2_n_14_3:t1:r1\",\n                \"column_id\": \"col:v2_n_14_3:t1:arrangement\",\n                \"text\": \"监查范围包括知情同意、受试者合格性、主要终点和次要终点评估（NPS、鼻塞VAS、SNOT-22、Lund-Kennedy）、随机化和盲法、研究药物管理、方案依从性、源数据与病例报告表一致性、安全性报告和试验记录保存。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_14_3:t1:r1:c3\",\n                \"row_id\": \"row:v2_n_14_3:t1:r1\",\n                \"column_id\": \"col:v2_n_14_3:t1:records\",\n                \"text\": \"监查活动应形成书面记录，包括监查计划、监查报告、沟通记录和措施跟踪记录；上述记录纳入监查记录保存范围。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:v2_n_14_3:t1:r2\",\n            \"order\": 1,\n            \"style_role\": \"body\",\n            \"source_locator\": \"\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:v2_n_14_3:t1:r2:c1\",\n                \"row_id\": \"row:v2_n_14_3:t1:r2\",\n                \"column_id\": \"col:v2_n_14_3:t1:element\",\n                \"text\": \"比例化方式\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_14_3:t1:r2:c2\",\n                \"row_id\": \"row:v2_n_14_3:t1:r2\",\n                \"column_id\": \"col:v2_n_14_3:t1:arrangement\",\n                \"text\": \"监查应基于风险，范围与频率应与试验的复杂性、关键终点和潜在风险相称。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_14_3:t1:r2:c3\",\n                \"row_id\": \"row:v2_n_14_3:t1:r2\",\n                \"column_id\": \"col:v2_n_14_3:t1:records\",\n                \"text\": \"比例化方式及相应监查活动按监查计划、监查报告和措施跟踪记录留存。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:v2_n_14_3:t1:r3\",\n            \"order\": 2,\n            \"style_role\": \"body\",\n            \"source_locator\": \"\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:v2_n_14_3:t1:r3:c1\",\n                \"row_id\": \"row:v2_n_14_3:t1:r3\",\n                \"column_id\": \"col:v2_n_14_3:t1:element\",\n                \"text\": \"监查方法\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_14_3:t1:r3:c2\",\n                \"row_id\": \"row:v2_n_14_3:t1:r3\",\n                \"column_id\": \"col:v2_n_14_3:t1:arrangement\",\n                \"text\": \"监查方法包括现场监查和中心化监查等，具体方法应基于风险确定。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_14_3:t1:r3:c3\",\n                \"row_id\": \"row:v2_n_14_3:t1:r3\",\n                \"column_id\": \"col:v2_n_14_3:t1:records\",\n                \"text\": \"具体方法及选择依据纳入监查计划与监查报告。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:v2_n_14_3:t1:r4\",\n            \"order\": 3,\n            \"style_role\": \"body\",\n            \"source_locator\": \"\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:v2_n_14_3:t1:r4:c1\",\n                \"row_id\": \"row:v2_n_14_3:t1:r4\",\n                \"column_id\": \"col:v2_n_14_3:t1:element\",\n                \"text\": \"远程监查\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_14_3:t1:r4:c2\",\n                \"row_id\": \"row:v2_n_14_3:t1:r4\",\n                \"column_id\": \"col:v2_n_14_3:t1:arrangement\",\n                \"text\": \"本试验远程监查适用；远程监查活动应形成书面记录，包括监查计划、监查报告、沟通记录和措施跟踪记录。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_14_3:t1:r4:c3\",\n                \"row_id\": \"row:v2_n_14_3:t1:r4\",\n                \"column_id\": \"col:v2_n_14_3:t1:records\",\n                \"text\": \"远程监查记录纳入监查记录保存范围，其留存边界随试验记录保存安排执行，具体期限以相应记录保存要求为准。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:v2_n_14_3:t1:r5\",\n            \"order\": 4,\n            \"style_role\": \"body\",\n            \"source_locator\": \"\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:v2_n_14_3:t1:r5:c1\",\n                \"row_id\": \"row:v2_n_14_3:t1:r5\",\n                \"column_id\": \"col:v2_n_14_3:t1:element\",\n                \"text\": \"监查发现与跟进\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_14_3:t1:r5:c2\",\n                \"row_id\": \"row:v2_n_14_3:t1:r5\",\n                \"column_id\": \"col:v2_n_14_3:t1:arrangement\",\n                \"text\": \"监查员应记录监查发现，及时向研究者和申办者报告，并跟踪纠正和预防措施直至解决。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_14_3:t1:r5:c3\",\n                \"row_id\": \"row:v2_n_14_3:t1:r5\",\n                \"column_id\": \"col:v2_n_14_3:t1:records\",\n                \"text\": \"监查发现、沟通和措施跟踪记录应可追溯；缺失信息按待补/建议解决流程处理。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:v2_n_14_3:t1:r6\",\n            \"order\": 5,\n            \"style_role\": \"body\",\n            \"source_locator\": \"\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:v2_n_14_3:t1:r6:c1\",\n                \"row_id\": \"row:v2_n_14_3:t1:r6\",\n                \"column_id\": \"col:v2_n_14_3:t1:element\",\n                \"text\": \"监查员资格与授权\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_14_3:t1:r6:c2\",\n                \"row_id\": \"row:v2_n_14_3:t1:r6\",\n                \"column_id\": \"col:v2_n_14_3:t1:arrangement\",\n                \"text\": \"监查员应具备医学、药学、生物科学或相关领域背景，并应接受GCP和方案培训，有能力评估试验实施和数据质量；监查员资格与授权应登记为项目实际安排。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_14_3:t1:r6:c3\",\n                \"row_id\": \"row:v2_n_14_3:t1:r6\",\n                \"column_id\": \"col:v2_n_14_3:t1:records\",\n                \"text\": \"培训完成状态以项目记录为准，不在本节由职责意图推断为已完成。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:v2_n_14_3:t1:r7\",\n            \"order\": 6,\n            \"style_role\": \"body\",\n            \"source_locator\": \"\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:v2_n_14_3:t1:r7:c1\",\n                \"row_id\": \"row:v2_n_14_3:t1:r7\",\n                \"column_id\": \"col:v2_n_14_3:t1:element\",\n                \"text\": \"监查记录\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_14_3:t1:r7:c2\",\n                \"row_id\": \"row:v2_n_14_3:t1:r7\",\n                \"column_id\": \"col:v2_n_14_3:t1:arrangement\",\n                \"text\": \"监查活动应形成书面记录，包括监查计划、监查报告、沟通记录和措施跟踪记录。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_14_3:t1:r7:c3\",\n                \"row_id\": \"row:v2_n_14_3:t1:r7\",\n                \"column_id\": \"col:v2_n_14_3:t1:records\",\n                \"text\": \"记录应可追溯；不以模板示例记录替代项目记录。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              }\n            ]\n          }\n        ],\n        \"notes\": []\n      }\n    },\n    {\n      \"block_id\": \"blk:v2_n_14_3:003\",\n      \"kind\": \"paragraph\",\n      \"text\": \"本试验远程监查适用。远程监查活动应形成书面记录，包括监查计划、监查报告、沟通记录和措施跟踪记录；远程监查记录纳入监查记录保存范围，其留存边界随试验记录保存安排执行，具体期限以相应记录保存要求为准。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:v2_n_14_3:004\",\n      \"kind\": \"paragraph\",\n      \"text\": \"监查员应记录监查发现，及时向研究者和申办者报告，并跟踪纠正和预防措施直至解决。监查发现、跟进与记录应可追溯；缺失信息按待补/建议解决流程处理，不以模板示例记录替代项目记录。监查发现涉及试验参与者安全或权益时，应进入项目沟通与记录，不得留白。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:v2_n_14_3:005\",\n      \"kind\": \"paragraph\",\n      \"text\": \"监查员应具备医学、药学、生物科学或相关领域背景，并应接受GCP和方案培训，有能力评估试验实施和数据质量。监查员资格与授权应登记为项目实际安排；培训完成状态以项目记录为准，不在本节由职责意图推断为已完成。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"84ff4b0f2ba1a62baa9bb3e55990d96892adea83d59fc1790322bccc5e18c3c5"}],"logical_call_id":"call:chapter-draft:6449027cb3682973121e17c2cd85082fc1da5401791b35ce7d766ddae1395ace:chapter-generate","node_execution_contract_id":"nec:chapter-draft:6449027cb3682973121e17c2cd85082fc1da5401791b35ce7d766ddae1395ace:chapter-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/ordered-chapter-draft-candidate.v1.json","output_sha256":"93e48a4f089928850c39a6cccab2cfa8675b88081d95a5fb75829445d980f819","prompt_sha256":"47dd66c834319411962b91127cd952207cccdab4dee7068a9ab81409e5aefa1e","provider_session_id":"45e8fedc-b0d9-40fd-8699-ca6d6eb423d0","requested_reasoning_effort":"max"},"schema":"model_response.v1"}