{"content":"{\n  \"chapters\": {\n    \"v2_n_10_2_2\": {\n      \"sae_reporting.first_awareness_reference\": {\n        \"text\": \"报告时限的起算点为研究者或申办者首次获知严重不良事件（SAE）的日期；若不同人员获知日期不一致，以最早获知日期为准。\"\n      },\n      \"sae_reporting.investigator_clock\": {\n        \"text\": \"研究者获知SAE后应当立即向申办者报告，且不迟于24小时；致死或危及生命的SAE应立即报告。方案规定的无需即时报告的例外事件除外。\"\n      },\n      \"sae_reporting.investigator_recipient\": {\n        \"text\": \"研究者应当将SAE报告给申办者（或其药物警戒/安全性部门及指定代表），并按照法规和伦理委员会要求向伦理委员会报告。\"\n      },\n      \"sae_reporting.investigator_record\": {\n        \"text\": \"研究者应在原始资料和病例报告表中记录SAE的获知日期、报告日期、报告对象、事件描述、发生时间、严重性标准、与试验用药品的因果关系、采取的措施、治疗及转归等信息。\"\n      }\n    },\n    \"v2_n_10_2_3\": {\n      \"sae_followup.new_information_reporting\": {\n        \"text\": \"研究者获知SAE的新信息或随访信息后，应在24小时内向申办者报告，并提供更新的SAE报告；致死或危及生命的SAE新信息应立即报告。\"\n      },\n      \"sae_followup.outcome_documentation\": {\n        \"text\": \"应持续记录SAE的转归，直至事件痊愈、好转、稳定、恢复至基线、死亡或研究者判断无需继续随访；记录应包括结束日期、最终转归、后遗症及是否采取治疗。\"\n      },\n      \"sae_followup.scope\": {\n        \"text\": \"SAE随访范围包括对事件过程的持续追踪、相关检查结果、治疗调整、合并用药、因果关系再评价、严重性变化及最终转归，并按方案和法规要求提交随访报告。\"\n      }\n    },\n    \"v2_n_10_3_1\": {\n      \"susar.chapter_area_framing\": {\n        \"text\": \"本节规定可疑非预期严重不良反应（SUSAR）的定义、非预期性判定依据及快速报告要求，适用于本试验中发生的严重不良事件。\"\n      },\n      \"susar.definition\": {\n        \"text\": \"可疑非预期严重不良反应（SUSAR）指临床表现严重、与试验用药品的因果关系不能排除、且其性质、严重程度或频率未在参考安全性信息中列出的不良反应。\"\n      },\n      \"susar.expectedness_reference\": {\n        \"text\": \"非预期性判定应以本试验的参考安全性信息为依据，通常为研究者手册（IB）中已列出的不良反应；若试验用药品已获批，则应参考现行药品说明书。\"\n      },\n      \"susar.reportability_criteria\": {\n        \"text\": \"SAE同时满足以下条件时应按SUSAR报告：事件为严重不良事件；与试验用药品存在可疑因果关系，即不能排除相关性；事件的性质、严重程度或频率属于非预期；并符合法规规定的快速报告情形。\"\n      }\n    },\n    \"v2_n_10_3_2\": {\n      \"susar_reporting.authority_and_ethics_communications\": {\n        \"text\": \"申办者应将SUSAR报告提交药品监督管理部门和伦理委员会；对致死或危及生命的SUSAR，应在首次获知后7个日历日内首次报告，并在随后8个日历日内提交随访报告；其他SUSAR应在首次获知后15个日历日内报告。\"\n      },\n      \"susar_reporting.awareness_reference\": {\n        \"text\": \"申办者SUSAR快速报告时限的起算点为申办者首次获知符合SUSAR最低报告标准信息的日期。\"\n      },\n      \"susar_reporting.sponsor_clock\": {\n        \"text\": \"致死或危及生命的SUSAR：申办者应在首次获知后7个日历日内向药品监督管理部门和伦理委员会首次报告，并在随后8个日历日内提交尽可能完整的随访报告；其他SUSAR：应在首次获知后15个日历日内报告。\"\n      },\n      \"susar_reporting.sponsor_followup_clock\": {\n        \"text\": \"SUSAR随访报告应在获得新信息后尽快提交；对致死或危及生命的SUSAR，首次报告后的补充随访信息应在随后8个日历日内提交；其他SUSAR随访信息应在获得后尽快提交，并符合适用法规要求。\"\n      },\n      \"susar_reporting.sponsor_recipient\": {\n        \"text\": \"申办者应将SUSAR报告提交药品监督管理部门和伦理委员会，并按法规及伦理委员会要求通知参与试验的研究者。\"\n      }\n    },\n    \"v2_n_10_3_3\": {\n      \"susar_followup.causality_disagreement_retention\": {\n        \"text\": \"当研究者和申办者对事件因果关系判断不一致时，应保留双方判断意见；若任一方认为不能排除与试验用药品的相关性，该事件仍应按SUSAR进行报告和随访。\"\n      },\n      \"susar_followup.documentation\": {\n        \"text\": \"SUSAR随访应记录并提交新信息，包括事件进展、检查结果、治疗、转归、严重性变化、因果关系再评价和非预期性再评价，并保存于安全性数据库和试验文件中。\"\n      },\n      \"susar_followup.new_information_clock\": {\n        \"text\": \"获得可能改变SUSAR评估或报告内容的新信息后，应在法规规定的快速报告时限内提交随访报告；对致死或危及生命的SUSAR，应在首次报告后8个日历日内提交尽可能完整的补充信息，后续新信息应尽快报告。\"\n      },\n      \"susar_followup.recipients\": {\n        \"text\": \"SUSAR随访报告应提交与初始SUSAR报告相同的接收方，包括药品监督管理部门、伦理委员会以及按法规或伦理要求需要通知的参与试验研究者。\"\n      }\n    },\n    \"v2_n_10_4\": {\n      \"other_ssi.recipient_and_clock\": {\n        \"text\": \"申办者应将其他潜在的严重安全性风险信息及时报告药品监督管理部门和伦理委员会；适用法规或伦理委员会规定具体时限的，从其规定。\"\n      },\n      \"other_ssi.reporting_criteria\": {\n        \"text\": \"报告范围包括可能影响受试者安全、改变试验风险获益评估、提示新的严重安全性风险或需要采取安全性措施的信息，如其他研究的新发现、非临床或流行病学数据、生产质量问题、剂量相关风险等。\"\n      },\n      \"other_ssi.review_responsibility\": {\n        \"text\": \"申办者负责持续监测、评估和报告其他潜在的严重安全性风险信息；研究者应及时向申办者报告相关安全性信息；伦理委员会和药品监督管理部门按职责审阅并决定是否采取额外风险控制措施。\"\n      },\n      \"other_ssi.signal_definition\": {\n        \"text\": \"安全性信号指来自一项或多项来源的信息，提示试验用药品存在新的潜在因果关联或已知关联的新方面，且具有临床意义或需要进一步评价。\"\n      }\n    },\n    \"v2_n_10_5\": {\n      \"aesi.definition\": {\n        \"text\": \"特殊关注不良事件（AESI）指与研究药物或研究疾病相关的、需在试验中持续监测的医学事件；其具体清单和定义应以研究者手册、方案或安全性监测计划为准。\"\n      },\n      \"aesi.monitoring_and_reporting\": {\n        \"text\": \"研究者应对AESI进行持续监测和记录；发生AESI时，即使不严重，也应按方案规定报告；若符合严重不良事件标准，则按SAE流程报告，若符合SUSAR标准，则按快速报告流程报告。\"\n      },\n      \"aesi.thresholds\": {\n        \"text\": \"AESI达到严重标准时按SAE报告；若与试验用药品相关性不能排除且为非预期，则按SUSAR报告；若同类事件发生频率或严重程度达到方案规定的安全性信号阈值，应提交申办者进行汇总评估并采取相应风险控制措施。\"\n      },\n      \"picos.aesi_definitions\": {\n        \"text\": \"特殊关注不良事件（AESI）的定义和具体清单以研究者手册、方案或安全性监测计划中列明者为准；如识别到新的AESI，应及时更新并按规定报告。\"\n      }\n    },\n    \"v2_n_10_6\": {\n      \"pregnancy.abnormal_outcome_reporting\": {\n        \"text\": \"妊娠相关异常结局，如自然流产、异位妊娠、死胎、死产、先天畸形、新生儿异常等，应按SAE或方案规定的妊娠报告流程及时报告申办者，并随访至结局明确。\"\n      },\n      \"pregnancy.continued_collection_arrangement\": {\n        \"text\": \"妊娠暴露应持续收集和随访，直至妊娠终止、分娩或研究者判断无需继续随访；应收集母亲、胎儿或新生儿的安全性信息，并按要求提交随访报告。\"\n      },\n      \"pregnancy.exposure_reporting\": {\n        \"text\": \"发现女性受试者妊娠或男性受试者伴侣妊娠后，应在24小时内报告申办者，即使未发生不良事件；报告应包括末次给药时间、妊娠确认时间、预产期及合并用药等信息。\"\n      },\n      \"pregnancy.outcome_followup\": {\n        \"text\": \"应随访妊娠结局至妊娠终止或分娩，并按方案规定继续收集新生儿信息；记录母亲和新生儿状况、先天性异常、妊娠并发症及其他不良事件；异常结局按SAE或SUSAR流程报告。\"\n      },\n      \"pregnancy.partner_consent\": {\n        \"text\": \"涉及男性受试者伴侣或新生儿信息收集时，应按照伦理委员会要求和当地法规取得伴侣或法定代理人的知情同意；如伦理委员会同意豁免，则可按豁免要求执行。\"\n      },\n      \"pregnancy.prevention_requirements\": {\n        \"text\": \"育龄期女性受试者及男性受试者的女性伴侣在试验期间和末次给药后应使用高效避孕措施，具体持续时间根据试验用药品半衰期、法规和伦理委员会要求确定；研究者应提供妊娠预防指导。\"\n      },\n      \"pregnancy.testing_requirements\": {\n        \"text\": \"育龄期女性受试者在筛选时及第24周/末次访视时进行妊娠试验，给药前妊娠试验必须为阴性；如研究期间怀疑妊娠，应立即进行妊娠检测。\"\n      },\n      \"pregnancy.withdrawal_arrangement\": {\n        \"text\": \"确认妊娠后，受试者应停止使用试验用药品；是否退出研究由研究者和申办者根据风险获益评估决定，但妊娠安全性随访应继续至结局明确。\"\n      }\n    }\n  }\n}","receipt":{"idempotency_key":"chapter-facts.derive.v1","input_artifacts":[{"ref":"chapter-facts-input","sha256":"005cd0b2fadac93e6c162fb2ab68694334d7174181ab713f03f222c1e0b05891"}],"logical_call_id":"call:chapter-facts:005cd0b2fadac93e6c162fb2ab68694334d7174181ab713f03f222c1e0b05891","node_execution_contract_id":"nec:chapter-facts:005cd0b2fadac93e6c162fb2ab68694334d7174181ab713f03f222c1e0b05891","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/chapter-facts-output.v1.json","output_sha256":"b21310c3b62810039037e7c2fd5fada187c6531a2e81278a43b5110e6e3f60bf","prompt_sha256":"81a4f629a6890c6f801162e4a74b9ab00ea246faf6b827f82fb3d8a5fee50daf","provider_session_id":"b132a752-daaa-4c06-b100-45fcd9cd989a","requested_reasoning_effort":"max"},"schema":"model_response.v1"}