{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-14-4:v2\",\n  \"node_id\": \"v2_n_14_4\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"block_id\": \"v2_n_14_4:p:investigator_conduct_and_delegation\",\n      \"kind\": \"paragraph\",\n      \"text\": \"研究者负责按照已批准方案和GCP实施试验；可将部分任务委派给有资质的人员，但应有书面委派记录并保留监督责任。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"source_window:901-909\"\n    },\n    {\n      \"block_id\": \"v2_n_14_4:p:investigator_supervision\",\n      \"kind\": \"paragraph\",\n      \"text\": \"研究者应监督研究团队和试验相关医疗决策，确保受试者安全和数据质量。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"source_window:901-909\"\n    },\n    {\n      \"block_id\": \"v2_n_14_4:p:investigator_protocol_compliance\",\n      \"kind\": \"paragraph\",\n      \"text\": \"研究者应遵守方案要求，获取知情同意，按方案完成访视和评估，并及时报告方案偏离。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"source_window:901-909\"\n    },\n    {\n      \"block_id\": \"v2_n_14_4:p:investigator_records\",\n      \"kind\": \"paragraph\",\n      \"text\": \"研究者应保存源数据、病例报告表、知情同意文件、药物管理记录和其他试验相关记录，并确保数据可溯源。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"source_window:901-909\"\n    },\n    {\n      \"block_id\": \"v2_n_14_4:p:investigator_facilities_and_resources\",\n      \"kind\": \"paragraph\",\n      \"text\": \"研究者应具备足够的时间、人员、设施和设备，以安全、规范地实施本试验，包括终点评估和内镜检查所需条件。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"source_window:901-909\"\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"43072b9d01b5f69a8f94284cdc1e1acdc952ecb6785864c377db4bd818fb4d0e"}],"logical_call_id":"call:chapter-draft:2f68dbc7cfa936ff58ca10cc41f33e9821a2b707e60b92642eaaa18ec471326d:chapter-generate","node_execution_contract_id":"nec:chapter-draft:2f68dbc7cfa936ff58ca10cc41f33e9821a2b707e60b92642eaaa18ec471326d:chapter-generate","observed_model":"d