{"content":"{\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"chapter_contract_id\": \"contract:v2-n-14-2:v2\",\n  \"node_id\": \"v2_n_14_2\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"block_id\": \"blk_v2_n_14_2_heading\",\n      \"kind\": \"paragraph\",\n      \"text\": \"14.2 申办者责任、监督、委派与记录\",\n      \"source_locator\": \"_Toc132623417;source_window:886-891\",\n      \"evidence_refs\": []\n    },\n    {\n      \"block_id\": \"blk_v2_n_14_2_intro\",\n      \"kind\": \"paragraph\",\n      \"text\": \"本节依据已确认的项目事实，对申办者责任、监督与委派、质量体系、记录与报告以及培训义务进行逐项登记。下列内容为项目事实登记，不构成方案接受已签署、培训已完成或质量体系已批准的声明。\",\n      \"source_locator\": \"source_window:886-891\",\n      \"evidence_refs\": []\n    },\n    {\n      \"block_id\": \"blk_v2_n_14_2_table\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [],\n      \"table\": {\n        \"table_id\": \"tbl_v2_n_14_2_sponsor_responsibility_alignment\",\n        \"block_id\": \"blk_v2_n_14_2_table\",\n        \"title\": \"申办者责任与实际安排对齐登记\",\n        \"role\": \"body_content\",\n        \"domain\": \"generic\",\n        \"header_row_count\": 1,\n        \"review_state\": \"ai_draft\",\n        \"source_locator\": \"source_window:886-891\",\n        \"columns\": [\n          {\n            \"column_id\": \"col_dimension\",\n            \"order\": 0,\n            \"label\": \"责任维度\",\n            \"semantic_role\": \"dimension\",\n            \"style_role\": \"header\",\n            \"source_locator\": \"source_window:886-891\"\n          },\n          {\n            \"column_id\": \"col_fact_registration\",\n            \"order\": 1,\n            \"label\": \"项目事实登记\",\n            \"semantic_role\": \"fact\",\n            \"style_role\": \"header\",\n            \"source_locator\": \"source_window:886-891\"\n          },\n          {\n            \"column_id\": \"col_alignment_note\",\n            \"order\": 2,\n            \"label\": \"对齐与推断边界\",\n            \"semantic_role\": \"note\",\n            \"style_role\": \"header\",\n            \"source_locator\": \"source_window:886-891\"\n          }\n        ],\n        \"rows\": [\n          {\n            \"row_id\": \"row_conduct\",\n            \"order\": 0,\n            \"label\": \"试验实施\",\n            \"source_locator\": \"source_window:886-891\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell_conduct_dimension\",\n                \"row_id\": \"row_conduct\",\n                \"column_id\": \"col_dimension\",\n                \"text\": \"试验实施\",\n                \"source_locator\": \"source_window:886-891\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"cell_conduct_fact\",\n                \"row_id\": \"row_conduct\",\n                \"column_id\": \"col_fact_registration\",\n                \"text\": \"申办者负责发起、管理和资助本试验，确保试验按照已批准方案、GCP和适用法规实施。\",\n                \"source_locator\": \"source_window:886-891\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"cell_conduct_alignment\",\n                \"row_id\": \"row_conduct\",\n                \"column_id\": \"col_alignment_note\",\n                \"text\": \"登记为项目事实；不表示方案接受已签署。\",\n                \"source_locator\": \"source_window:886-891\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row_oversight_delegation\",\n            \"order\": 1,\n            \"label\": \"监督与委派\",\n            \"source_locator\": \"source_window:886-891\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell_oversight_dimension\",\n                \"row_id\": \"row_oversight_delegation\",\n                \"column_id\": \"col_dimension\",\n                \"text\": \"监督与委派\",\n                \"source_locator\": \"source_window:886-891\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"cell_oversight_fact\",\n                \"row_id\": \"row_oversight_delegation\",\n                \"column_id\": \"col_fact_registration\",\n                \"text\": \"申办者可将部分试验任务委派给有资质的第三方，但应进行监督并确保被委派方遵守方案、GCP和适用法规；委派应有书面记录。\",\n                \"source_locator\": \"source_window:886-891\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"cell_oversight_alignment\",\n                \"row_id\": \"row_oversight_delegation\",\n                \"column_id\": \"col_alignment_note\",\n                \"text\": \"登记为项目事实；不表示委派记录已存在或监督已完成。\",\n                \"source_locator\": \"source_window:886-891\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row_quality_system\",\n            \"order\": 2,\n            \"label\": \"质量体系\",\n            \"source_locator\": \"source_window:886-891\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell_quality_dimension\",\n                \"row_id\": \"row_quality_system\",\n                \"column_id\": \"col_dimension\",\n                \"text\": \"质量体系\",\n                \"source_locator\": \"source_window:886-891\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"cell_quality_fact\",\n                \"row_id\": \"row_quality_system\",\n                \"column_id\": \"col_fact_registration\",\n                \"text\": \"申办者应建立并维护质量体系，包括书面标准操作规程、培训、质量控制和质量保证活动，以确保试验质量和数据可靠性。\",\n                \"source_locator\": \"source_window:886-891\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"cell_quality_alignment\",\n                \"row_id\": \"row_quality_system\",\n                \"column_id\": \"col_alignment_note\",\n                \"text\": \"登记为项目事实；不表示质量体系已批准。\",\n                \"source_locator\": \"source_window:886-891\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row_records_reports\",\n            \"order\": 3,\n            \"label\": \"记录与报告\",\n            \"source_locator\": \"source_window:886-891\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell_records_dimension\",\n                \"row_id\": \"row_records_reports\",\n                \"column_id\": \"col_dimension\",\n                \"text\": \"记录与报告\",\n                \"source_locator\": \"source_window:886-891\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"cell_records_fact\",\n                \"row_id\": \"row_records_reports\",\n                \"column_id\": \"col_fact_registration\",\n                \"text\": \"申办者应保存与试验相关的记录和报告，并按规定向监管机构、伦理委员会和其他相关方报告安全性信息和试验进展。\",\n                \"source_locator\": \"source_window:886-891\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"cell_records_alignment\",\n                \"row_id\": \"row_records_reports\",\n                \"column_id\": \"col_alignment_note\",\n                \"text\": \"登记为项目事实；不表示记录已实际保存或报告已提交。\",\n                \"source_locator\": \"source_window:886-891\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row_training_obligation\",\n            \"order\": 4,\n            \"label\": \"培训义务\",\n            \"source_locator\": \"source_window:886-891\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell_training_dimension\",\n                \"row_id\": \"row_training_obligation\",\n                \"column_id\": \"col_dimension\",\n                \"text\": \"培训义务\",\n                \"source_locator\": \"source_window:886-891\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"cell_training_fact\",\n                \"row_id\": \"row_training_obligation\",\n                \"column_id\": \"col_fact_registration\",\n                \"text\": \"申办者应确保参与试验的所有人员接受与其职责相适应的培训，包括方案、GCP、保密和安全性报告要求。\",\n                \"source_locator\": \"source_window:886-891\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"cell_training_alignment\",\n                \"row_id\": \"row_training_obligation\",\n                \"column_id\": \"col_alignment_note\",\n                \"text\": \"登记为项目事实；不表示培训已完成。\",\n        