{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-14-7:v2\",\n  \"node_id\": \"v2_n_14_7\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"block_id\": \"v2_n_14_7_p1\",\n      \"kind\": \"paragraph\",\n      \"text\": \"14.7 安全性监督\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"916-921\"\n    },\n    {\n      \"block_id\": \"v2_n_14_7_p2\",\n      \"kind\": \"paragraph\",\n      \"text\": \"本试验未设立独立数据监查委员会（IDMC）。本试验的安全性监督主体为研究者及其授权研究团队、申办者药物警戒/安全报告部门、医学监查员，以及伦理委员会和药品监督管理部门等外部监督机构。上述主体按各自职责承担安全性监督，不相互替代；该安排与其他委员会类型保持区分，DSMB、SMC、独立安全性监查员或终点评审委员会（IRC）等安排如存在，均不得自动替代本试验实际安全性监督主体。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"916-921\"\n    },\n    {\n      \"block_id\": \"v2_n_14_7_t1\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [],\n      \"table\": {\n        \"table_id\": \"v2_n_14_7_t1\",\n        \"block_id\": \"v2_n_14_7_t1\",\n        \"title\": \"安全性监督主体、组成、角色与信息流\",\n        \"domain\": \"generic\",\n        \"role\": \"body_content\",\n        \"header_row_count\": 1,\n        \"columns\": [\n          {\n            \"column_id\": \"col_subject\",\n            \"order\": 0,\n            \"label\": \"监督主体/参与方\",\n            \"semantic_role\": \"subject\",\n            \"source_locator\": \"916-921\"\n          },\n          {\n            \"column_id\": \"col_roles\",\n            \"order\": 1,\n            \"label\": \"角色与职责\",\n            \"semantic_role\": \"roles\",\n            \"source_locator\": \"916-921\"\n          },\n          {\n            \"column_id\": \"col_info\",\n            \"order\": 2,\n            \"label\": \"信息流与报告路径\",\n            \"semantic_role\": \"information_flow\",\n            \"source_locator\": \"916-921\"\n          }\n        ],\n        \"rows\": [\n          {\n            \"row_id\": \"row_investigator\",\n            \"order\": 0,\n            \"label\": \"研究者及其授权研究团队\",\n            \"source_locator\": \"916-921\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell_investigator_subject\",\n                \"row_id\": \"row_investigator\",\n                \"column_id\": \"col_subject\",\n                \"text\": \"研究者及其授权研究团队\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"916-921\"\n              },\n              {\n                \"cell_id\": \"cell_investigator_roles\",\n                \"row_id\": \"row_investigator\",\n                \"column_id\": \"col_roles\",\n                \"text\": \"研究者负责受试者安全、AE/SAE识别、记录、因果关系评估和向申办者报告；授权研究团队按授权参与研究安全性相关工作。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"916-921\"\n              },\n              {\n                \"cell_id\": \"cell_investigator_info\",\n                \"row_id\": \"row_investigator\",\n                \"column_id\": \"col_info\",\n                \"text\": \"研究者识别并记录AE/SAE后立即向申办者或其委托的药物警戒/安全报告接收部门报告；在筛选期、基线、负荷给药期、维持给药期至第24周末次给药及安全性随访期间持续监测和记录AE/SAE。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"916-921\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row_sponsor_pv\",\n            \"order\": 1,\n            \"label\": \"申办者药物警戒/安全报告部门\",\n            \"source_locator\": \"916-921\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell_sponsor_pv_subject\",\n                \"row_id\": \"row_sponsor_pv\",\n                \"column_id\": \"col_subject\",\n                \"text\": \"申办者药物警戒/安全报告部门\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"916-921\"\n              },\n              {\n                \"cell_id\": \"cell_sponsor_pv_roles\",\n                \"row_id\": \"row_sponsor_pv\",\n                \"column_id\": \"col_roles\",\n                \"text\": \"负责SUSAR和其他潜在严重安全性风险的识别、评估和报告；收集、评估安全性信息。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"916-921\"\n              },\n              {\n                \"cell_id\": \"cell_sponsor_pv_info\",\n                \"row_id\": \"row_sponsor_pv\",\n                \"column_id\": \"col_info\",\n                \"text\": \"收集、评估和快速报告SUSAR及其他潜在严重安全性风险；申办者评估后按法规要求向药品监督管理部门、卫生健康主管部门和伦理委员会报告；对于SUSAR，还应通知所有参加临床试验的研究者/机构。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"916-921\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row_medical_monitor\",\n            \"order\": 2,\n            \"label\": \"医学监查员\",\n            \"source_locator\": \"916-921\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell_medical_monitor_subject\",\n                \"row_id\": \"row_medical_monitor\",\n                \"column_id\": \"col_subject\",\n                \"text\": \"医学监查员\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"916-921\"\n              },\n              {\n                \"cell_id\": \"cell_medical_monitor_roles\",\n                \"row_id\": \"row_medical_monitor\",\n                \"column_id\": \"col_roles\",\n                \"text\": \"负责医学审核。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"916-921\"\n              },\n              {\n                \"cell_id\": \"cell_medical_monitor_info\",\n                \"row_id\": \"row_medical_monitor\",\n                \"column_id\": \"col_info\",\n                \"text\": \"对安全性信息提供医学审核；审核结果用于支持安全性评估与报告流程。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"916-921\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row_ethics_committee\",\n            \"order\": 3,\n            \"label\": \"伦理委员会\",\n            \"source_locator\": \"916-921\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell_ethics_committee_subject\",\n                \"row_id\": \"row_ethics_committee\",\n                \"column_id\": \"col_subject\",\n                \"text\": \"伦理委员会\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"916-921\"\n              },\n              {\n                \"cell_id\": \"cell_ethics_committee_roles\",\n                \"row_id\": \"row_ethics_committee\",\n                \"column_id\": \"col_roles\",\n                \"text\": \"负责审查和监督。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"916-921\"\n              },\n              {\n                \"cell_id\": \"cell_ethics_committee_info\",\n                \"row_id\": \"row_ethics_committee\",\n                \"column_id\": \"col_info\",\n                \"text\": \"接收申办者按法规要求提交的安全性报告，并按照职责进行审查和监督。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"916-921\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row_regulators\",\n            \"order\": 4,\n            \"label\": \"药品监督管理部门、卫生健康主管部门等监管机构\",\n            \"source_locator\": \"916-921\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell_regulators_subject\",\n                \"row_id\": \"row_regulators\",\n                \"column_id\": \"col_subject\",\n                \"text\": \"药品监督管理部门、卫生健康主管部门等监管机构\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"916-921\"\n              },\n              {\n                \"cell_id\": \"cell_regulators_roles\",\n                \"row_id\": \"row_regulators\",\n                \"column_id\": \"col_roles\",\n                \"text\": \"负责审查和监督。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"916-921\"\n              },\n              {\n                \"cell_id\": \"cell_regulators_info\",\n                \"row_id\": \"row_regulators\",\n                \"column_id\": \"col_info\",\n                \"text\": \"接收申办者按法规要求提交的安全性报告，并按照职责进行审查和监督；对于SUSAR相关信息，按法规要求接收报告。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"916-921\"\n              }\n            ]\n          }\n        ],\n        \"notes\": [\n          {\n            \"note_id\": \"v2_n_14_7_t1_n1\",\n            \"note_type\": \"definition\",\n            \"text\": \"本试验未设立独立数据监查委员会（IDMC）。本表所列参与方共同实施安全性监督；终点评审委员会（IRC）或其他委员会类型如适用，不自动替代本表所列安全性监督主体。\",\n            \"source_refs\": [],\n            \"target_ids\": [\n              \"v2_n_14_7_t1\"\n            ],\n            \"marker\": \"\",\n            \"marker_source_locator\": \"916-921\",\n            \"review_status\": \"ai_draft\",\n            \"project_override\": false\n          },\n          {\n            \"note_id\": \"v2_n_14_7_t1_n2\",\n            \"note_type\": \"operational\",\n            \"text\": \"本试验不适用独立的安全性监督章程；该不适用不豁免上述安全性监督义务。\",\n            \"source_refs\": [],\n            \"target_ids\": [\n              \"v2_n_14_7_t1\"\n            ],\n            \"marker\": \"\",\n            \"marker_source_locator\": \"916-921\",\n            \"review_status\": \"ai_draft\",\n            \"project_override\": false\n          }\n        ],\n        \"source_locator\": \"916-921\",\n        \"review_state\": \"ai_draft\",\n        \"version\": 0,\n        \"schema_version\": \"structured_table_v1\",\n        \"word_layout\": {}\n      }\n    },\n    {\n      \"block_id\": \"v2_n_14_7_p3\",\n      \"kind\": \"paragraph\",\n      \"text\": \"安全性监督贯穿筛选期、基线、负荷给药期、维持给药期至第24周末次给药及安全性随访。研究者持续监测和记录AE/SAE；申办者药物警戒部门对SAE/SUSAR和其他潜在严重安全性风险进行及时评估和报告，必要时与伦理委员会和监管机构沟通。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"916-921\"\n    },\n    {\n      \"block_id\": \"v2_n_14_7_p4\",\n      \"kind\": \"paragraph\",\n      \"text\": \"升级与报告路径为：研究者识别并记录AE/SAE后立即向申办者或其委托的药物警戒/安全报告接收部门报告；申办者评估后按法规要求向药品监督管理部门、卫生健康主管部门和伦理委员会报告；对于SUSAR，还应通知所有参加临床试验的研究者/机构。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"916-921\"\n    },\n    {\n      \"block_id\": \"v2_n_14_7_p5\",\n      \"kind\": \"paragraph\",\n      \"text\": \"本试验不适用独立的安全性监督章程；上述安全性监督职责仍按本方案及法规要求执行。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"916-921\"\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"71b3050de9dc48b137002f188862e92505fd7efc87d68f772124416efca7a73c"}],"logical_call_id":"call:chapter-draft:1152a3f5ca5eae44facb20a39c7d2ecd5a079d515c8c079be98d25132ecdd747:chapter-generate","node_execution_contract_id":"nec:chapter-draft:1152a3f5ca5eae44facb20a39c7d2ecd5a079d515c8c079be98d25132ecdd747:chapter-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/ordered-chapter-draft-candidate.v1.json","output_sha256":"9a445233523dbd47dcbed80c4ae92f44ec34c40c438089e0cf036891cd668847","prompt_sha256":"47dd66c834319411962b91127cd952207cccdab4dee7068a9ab81409e5aefa1e","provider_session_id":"4384cb9f-6464-48c9-a293-c9116ac7c105","requested_reasoning_effort":"max"},"schema":"model_response.v1"}