{"content":"{\n  \"chapters\": {\n    \"v2_n_6_1_2\": {\n      \"intervention.dose_modification_features\": {\n        \"fixed_dose\": true,\n        \"dose_escalation\": false,\n        \"dlt_assessment\": false,\n        \"planned_holds\": false,\n        \"unplanned_holds\": \"任何因不良事件、合并用药、手术、受试者原因或其他情况导致的给药暂停、延迟或遗漏，均记录发生日期、原因、持续时间、是否恢复、恢复日期及实际给药调整。\",\n        \"dose_adjustment\": \"方案未设定剂量递增、减量或按体重调整；如出现需暂停或永久停药的情况，按个体暂停和永久停药标准处理。\",\n        \"blinding\": \"暂停、恢复或停止给药均不得破坏双盲；如发生紧急揭盲，按紧急揭盲程序记录原因、日期和人员。\"\n      },\n      \"intervention.dose_modification_required\": {\n        \"applicable\": false,\n        \"reason\": \"本研究采用固定剂量150 mg/1.0 mL皮下给药，无剂量递增或剂量调整设计；未达到永久停药标准前按原方案给药。\",\n        \"individual_hold_allowed\": true,\n        \"individual_hold_not_equal_permanent_stop\": true,\n        \"resume_condition\": \"暂停后若安全性评估显示可继续且未达到永久停药标准，可按方案和医学监查要求恢复给药。\",\n        \"permanent_stop_condition\": \"若达到永久停药标准，则永久停止研究干预并按方案继续安全性随访。\"\n      },\n      \"intervention.missed_dose_instructions\": {\n        \"make_up\": \"本方案未设定常规补给药规则；遗漏、延迟或暂停给药不得自行补用或调整剂量。\",\n        \"recording\": \"记录发生日期、原因、持续时间、是否恢复、恢复日期及实际给药调整。\",\n        \"resumption\": \"由研究者评估并符合方案和医学监查要求后方可恢复；若达到永久停药标准则永久停止研究干预。\",\n        \"follow_up\": \"暂停期间继续按计划进行安全性和疗效随访，除非受试者退出。\",\n        \"blinding\": \"处理遗漏或暂停时保持双盲。\"\n      },\n      \"intervention.permanent_discontinuation_criteria\": {\n        \"criteria\": [\n          \"受试者撤回知情同意或明确要求永久停止研究干预\",\n          \"发生与试验药物相关的严重不良事件或不可耐受毒性，研究者判断继续给药风险大于获益\",\n          \"发生重度过敏或超敏反应，或需紧急处理的系统性反应\",\n          \"具有临床意义的实验室检查、生命体征或其他安全性异常经重复确认，且研究者或医学监查员判断需永久停药\",\n          \"研究者判断继续给药不符合受试者最佳利益\",\n          \"申办者、伦理委员会或监管机构要求永久停止\"\n        ],\n        \"text\": \"达到上述任一标准时永久停止研究干预，并按方案继续安全性随访；撤回知情同意者不再进行新的研究相关操作。\",\n        \"recording\": \"永久停止研究干预需在eCRF中记录日期、原因、与试验药物关系、是否达到方案定义标准、是否继续研究随访；相关不良事件或严重不良事件按GCP和安全性报告流程报告。\",\n        \"follow_up\": \"因不良事件停药者随访至事件稳定或恢复，并按医学监查要求完成安全性随访；撤回知情同意者不进行进一步研究随访。\"\n      }\n    },\n    \"v2_n_6_2_1\": {\n      \"intervention.accountability_records\": {\n        \"records\": [\n          \"接收日期、数量和批号\",\n          \"储存条件记录\",\n          \"发放日期、随机号/受试者编号、数量、批号\",\n          \"回收/返还日期、数量、批号\",\n          \"销毁日期、数量、批号及授权\",\n          \"实际给药日期、剂量、体积、途径、是否按计划完成、延迟/遗漏/暂停原因及处理\",\n          \"药物计数和依从性记录\",\n          \"异常、破损、过期或温度偏离记录及处理\"\n        ],\n        \"source\": \"药物发放/回收记录、注射给药记录、受试者日志或日记卡、源文件和CRF。\",\n        \"monitoring\": \"准备、发放、给药和回收均需记录并接受监查。\",\n        \"blinding\": \"记录不得揭示治疗分配；盲态维持由不参与疗效评价的指定人员执行。\"\n      },\n      \"intervention.destruction_authorization\": {\n        \"authorization\": \"研究药物销毁须经申办者书面授权；研究中心不得自行销毁。\",\n        \"executor\": \"由研究者或申办者指定人员按适用法规、申办者SOP和机构要求执行。\",\n        \"records\": \"记录销毁日期、药物名称/安慰剂、批号、数量、销毁方式、执行人、授权人和见证人。\",\n        \"discrepancy\": \"如发现药物数量或记录差异，应调查并记录；涉及盲态时按紧急揭盲程序处理。\"\n      },\n      \"intervention.dispensing_and_return\": {\n        \"dispensing\": \"按随机分配发放合成药X 150 mg/1.0 mL或生理盐水安慰剂1.0 mL；发放前核对随机号、药物标识、剂量/体积、给药日期和途径，保持双盲并记录实际发放。\",\n        \"return\": \"受试者返还或研究中心回收未使用药物、空包装和剩余药物，记录日期、数量、批号及完整性。\",\n        \"reconciliation\": \"将发放、使用、回收、剩余和销毁数量进行核对，差异须调查并记录。\",\n        \"blinding\": \"由不参与疗效评价的指定人员执行分配与盲态维持。\"\n      },\n      \"intervention.receipt_and_inventory\": {\n        \"receipt\": \"接收时核对申办者发运清单、药物名称/安慰剂、规格/体积、批号、数量、有效期、包装完整性和标签；记录接收日期、接收人、运输条件和温度偏离（如有）。\",\n        \"inventory\": \"建立药物接收、储存、发放、使用、回收、返还和销毁清点记录，定期盘点并保持数量一致。\",\n        \"storage\": \"接收后按标签规定条件储存，隔离过期、破损或异常药物。\",\n        \"discrepancy\": \"任何数量、标签、包装或温度偏离均应记录、调查并向申办者报告。\"\n      },\n      \"intervention.responsible_party\": {\n        \"investigator\": \"研究者对研究中心试验用药品接收、清点、储存、发放、使用、回收和记录负总体责任。\",\n        \"delegated_personnel\": \"由研究者或其授权并经培训的临床试验人员负责准备和给药；药物分配与盲态维持由不参与疗效评价的指定人员执行。\",\n        \"sponsor\": \"申办者负责提供试验用药品、标签、运输和销毁授权，并监督药物管理符合方案、GCP和适用法规。\",\n        \"monitor\": \"监查员核查药物管理记录与源文件，确认数量一致、储存合规和盲态维持。\"\n      }\n    },\n    \"v2_n_6_2_2\": {\n      \"intervention.packaging_and_labeling\": {\n        \"product\": \"合成药X注射制剂150 mg/1.0 mL；安慰剂为生理盐水1.0 mL。\",\n        \"packaging\": \"按申办者提供的临床试验用药品包装供应；包装应保护产品、维持盲态并便于清点。\",\n        \"labeling\": \"标签内容至少包括方案编号PV3-69F53457、随机号/受试者编号、药物名称或安慰剂、规格/体积、批号、有效期、储存条件、'仅供临床试验使用'及申办者信息。\",\n        \"blinding\": \"标签不得揭示治疗分配；如使用盲底或应急揭盲标签，按紧急揭盲程序管理。\",\n        \"language\": \"标签使用适用法规和伦理委员会批准的中文或中英文内容。\"\n      },\n      \"intervention.regulatory_labeling_check\": {\n        \"check_content\": \"接收和发放前核对标签与方案编号、随机号、药物名称/安慰剂、规格/体积、批号、有效期、储存条件和盲态要求一致。\",\n        \"compliance\": \"标签应符合NMPA药物临床试验质量管理规范、ICH GCP和适用法规要求，并经申办者质量部门审核。\",\n        \"discrepancy\": \"标签错误、缺失、破损或信息不一致时，应立即隔离该药物，记录并报告申办者，不得用于受试者。\",\n        \"records\": \"核对人员、日期、结果和措施记录于药物接收/清点记录和监查报告。\"\n      }\n    },\n    \"v2_n_6_2_3\": {\n      \"intervention.stability_handling\": {\n        \"general\": \"按申办者提供的稳定性数据和标签要求储存、运输和使用；未获稳定性支持的条件不得使用。\",\n        \"inspection\": \"给药前检查药物外观、颗粒物、包装完整性和有效期；如出现浑浊、变色、颗粒、破损、过期或温度偏离，不得使用。\",\n        \"temperature_excursion\": \"发生温度偏离时，应立即隔离并报告申办者，按申办者评估决定是否可用或销毁。\",\n        \"aseptic\": \"按注射剂无菌操作要求准备，给药前核对随机号、药物标识、剂量/体积、给药日期和途径。\",\n        \"records\": \"稳定性相关检查、温度偏离和处理记录保存于药物管理记录。\"\n      },\n      \"intervention.storage_conditions\": {\n        \"general\": \"按申办者提供的临床试验用药品标签和研究者手册规定储存；保持原包装并标识'仅供临床试验使用'。\",\n        \"monitoring\": \"定期记录和审查储存温度；发生温度偏离时隔离药物并报告申办者评估。\",\n        \"placebo\": \"生理盐水安慰剂按相同要求储存，包装和标签维持盲态。\"\n      }\n    },\n    \"v2_n_front_2\": {},\n    \"v2_n_front_3\": {},\n    \"v2_n_front_4\": {},\n    \"v2_n_front_6\": {\n      \"toc.heading_hierarchy_source\": {\n        \"source\": \"依据本方案正文已确认章节标题层级生成，目录层级与正文标题一致。\",\n        \"node_ids\": [\n          \"v2_n_6_1_2\",\n          \"v2_n_6_2_1\",\n          \"v2_n_6_2_2\",\n          \"v2_n_6_2_3\",\n          \"v2_n_front_2\",\n          \"v2_n_front_3\",\n          \"v2_n_front_4\",\n          \"v2_n_front_6\"\n        ],\n        \"note\": \"目录标题使用各章节已确认标题。\"\n      }\n    }\n  }\n}","receipt":{"idempotency_key":"chapter-facts.derive.v1","input_artifacts":[{"ref":"chapter-facts-input","sha256":"0e177d1db23c3def7b9745c1848a77dc450e2ca9cfd2b55bf33f444ee10eb65c"}],"logical_call_id":"call:chapter-facts:0e177d1db23c3def7b9745c1848a77dc450e2ca9cfd2b55bf33f444ee10eb65c","node_execution_contract_id":"nec:chapter-facts:0e177d1db23c3def7b9745c1848a77dc450e2ca9cfd2b55bf33f444ee10eb65c","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/chapter-facts-output.v1.json","output_sha256":"5f0774a299eba351327ae94a17411d599f3b55050c192c037acf55887c096b2b","prompt_sha256":"81a4f629a6890c6f801162e4a74b9ab00ea246faf6b827f82fb3d8a5fee50daf","provider_session_id":"3375c7aa-4af8-4e70-ba92-73437a0613a7","requested_reasoning_effort":"max"},"schema":"model_response.v1"}