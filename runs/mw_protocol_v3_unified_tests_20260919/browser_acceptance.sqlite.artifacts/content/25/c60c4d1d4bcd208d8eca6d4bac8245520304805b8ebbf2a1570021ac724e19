{"content":"{\"chapters\":{\"v2_n_3_4_2\":{\"exploratory.endpoint_disposition\":{\"applicable\":false,\"prespecified\":[],\"immunogenicity_applicable\":false,\"population_pk_applicable\":false,\"reason\":\"已确认研究事实未预设探索性终点；本研究未计划免疫原性或群体药代动力学探索性分析。\"},\"picos.exploratory_endpoints\":{\"applicable\":false,\"endpoints\":[],\"analysis\":\"无预设探索性终点分析。\",\"reason\":\"已确认研究事实未预设探索性终点；任何事后探索性分析将明确标注为探索性，不用于确证性结论。\"}},\"v2_n_4_2\":{\"framing.structured_design.placebo_decision\":{\"applicable\":true,\"comparator\":\"安慰剂\",\"placebo\":\"生理盐水1.0 mL，皮下注射，同体积、同途径、同频率给药。\",\"rationale\":\"Ⅱ期概念验证采用安慰剂对照以评估合成药X的相对疗效并保持试验敏感性；允许稳定背景鼻用激素并记录。\",\"design_type\":\"Ⅱ期、随机、双盲、安慰剂对照、优效性概念验证研究\"}},\"v2_n_5_1\":{},\"v2_n_5_2\":{\"picos.risk.pregnancy_contraception\":{\"applicable\":true,\"reason\":\"有生育潜力的受试者及其伴侣应在研究期间及末次给药后按方案要求采取有效避孕措施；有生育潜力的女性受试者应在筛选期及研究期间按方案规定进行妊娠试验，结果阳性者应暂停或停止试验用药品并报告。\"}},\"v2_n_5_3\":{\"picos.risk.pregnancy_contraception\":{\"applicable\":true,\"reason\":\"有生育潜力的受试者及其伴侣应在研究期间及末次给药后按方案要求采取有效避孕措施；有生育潜力的女性受试者应在筛选期及研究期间按方案规定进行妊娠试验，结果阳性者应暂停或停止试验用药品并报告。\"},\"population.lifestyle.constraints\":{\"contraception\":\"有生育潜力的受试者及其伴侣应在研究期间及末次给药后按方案要求采取有效避孕措施。\",\"pregnancy_testing\":\"有生育潜力的女性受试者应在筛选期及研究期间按方案规定进行妊娠试验；结果阳性者应暂停或停止试验用药品并报告。\",\"pregnancy_exposure_reporting\":\"受试者或男性受试者伴侣发生妊娠暴露后，应在获知后立即报告申办者。\"},\"population.lifestyle.exceptions\":{\"exceptions\":[]},\"population.lifestyle.scope\":{\"scope\":\"避孕要求、妊娠试验和妊娠暴露报告。\"},\"population.lifestyle.timing\":{\"contraception\":\"研究期间及末次给药后按方案要求。\",\"pregnancy_testing\":\"筛选期及研究期间按方案规定。\",\"pregnancy_exposure_reporting\":\"获知妊娠暴露后立即报告。\"}},\"v2_n_5_4\":{\"population.screen_failure.definition\":{\"definition\":\"受试者在筛选期未满足全部入选标准或存在排除标准，且未进入随机化。\",\"timing\":\"在筛选期资格评估完成并确认不能随机化时判定。\"},\"population.screen_failure.permitted_reasons\":{\"reasons\":[\"未满足全部入选标准\",\"满足排除标准\"]},\"population.screen_failure.randomization_status\":{\"randomized\":false,\"text\":\"筛选失败者不进行随机化；仅确认符合全部入排标准后按1:1随机分配，并按中心分层。\"},\"population.screen_failure.records\":{\"required_fields\":[\"筛选失败日期\",\"未满足的入选标准或排除标准\",\"重复评估日期和结果（如适用）\",\"最终入排判断\"],\"source\":\"源文件和eCRF。\"},\"population.screen_failure.timing\":{\"text\":\"在随机化前完成资格确认；筛选评估异常时可在随机化前重复相关评估以确认资格，重复评估日期、结果和最终入排判断需记录。\"}},\"v2_n_5_5\":{\"population.recruitment.ethics_review_plan\":{\"approval\":\"研究开始前，方案、知情同意书、招募材料及其他受试者相关文件须获得伦理委员会批准；批准文件和成员名单归档。\",\"review\":\"研究期间按伦理委员会要求提交继续审查和修正案审查。\",\"responsible_role\":\"主要研究者负责本中心伦理审查申请、伦理委员会沟通、方案依从和安全性报告；申办者负责提供必要文件并确保多中心研究按统一伦理要求管理。\"},\"population.recruitment.feasibility\":{\"planned_randomized_total\":\"约404例（每组约202例）\",\"randomization_ratio\":\"1:1\",\"stratification\":\"按中心分层\",\"attrition_assumption\":\"8%\",\"feasibility_basis\":\"样本量按安慰剂组20%、试验组35%、双侧α=0.05、效能90%、8%失访膨胀计算；无期中分析。\"},\"population.recruitment.materials_review\":{\"review\":\"招募材料及其他受试者相关文件须获得伦理委员会批准后方可使用。\",\"version_control\":\"方案和知情同意书采用版本号和日期控制；研究中心仅使用伦理委员会批准的最新版本。\"},\"population.recruitment.visit_measures\":{\"screening\":\"筛选期从签署知情同意书开始，完成入排标准确认、基线评估和背景治疗稳定性确认。\",\"randomization\":\"确认符合全部入排标准并完成随机化后，第1天开始首次给药。\",\"source\":\"procedure.screening_period_definition；procedure.dosing_start_rules。\"},\"population.retention.follow_up\":{\"text\":\"仅停用研究干预者继续随访至第24周；因不良事件停药者随访至事件稳定或恢复，并按医学监查要求完成安全性随访；撤回知情同意者不进行进一步研究随访。\",\"lost_to_followup\":\"经至少3次合理联系尝试仍无法联系且无明确撤回同意者，由研究者审核分类为失访；后续恢复联系时按方案评估是否继续随访。\",\"safety_followup\":\"安全性随访按治疗期访视及末次给药后第24周评估进行；如发生不良事件，随访至事件消退或稳定。\"},\"population.retention.strategy\":{\"strategy\":\"通过方案规定的访视窗、安全性随访、不良事件和合并用药记录、依从性记录、失访联系程序和退出管理提高保留。\",\"contact_attempts\":\"在第24周访视窗口及随访到期后，通过电话、短信或邮件、信件等经批准的联系方式至少进行3次联系尝试，尽量覆盖不同日期和时段；仅使用受试者授权联系方式。\",\"withdrawal_handling\":\"受试者撤回知情同意后不再收集新数据，除非法规要求或受试者另行同意；已收集数据按预定义分析计划使用。\",\"discontinuation_handling\":\"受试者停用研究干预但未撤回知情同意时，继续按方案收集安全性和疗效随访数据。\"}},\"v2_n_6_1_1\":{\"intervention.product_authority\":{\"name\":\"合成药X\",\"identity\":\"合成药X注射制剂\",\"dosage_form\":\"注射制剂\",\"strength\":\"150 mg/1.0 mL\",\"route\":\"皮下给药\",\"mechanism_of_action\":\"IL-4Rα拮抗\",\"placebo\":\"生理盐水1.0 mL，皮下注射，同体积、同途径、同频率。\"}}}}","receipt":{"idempotency_key":"chapter-facts.derive.v1","input_artifacts":[{"ref":"chapter-facts-input","sha256":"f82eb17fc351f435c3673e541e1549ac85b9bc355c753728b20f77d7dc10ee81"}],"logical_call_id":"call:chapter-facts:f82eb17fc351f435c3673e541e1549ac85b9bc355c753728b20f77d7dc10ee81","node_execution_contract_id":"nec:chapter-facts:f82eb17fc351f435c3673e541e1549ac85b9bc355c753728b20f77d7dc10ee81","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/chapter-facts-output.v1.json","output_sha256":"b508ba260e8aace467e1241e545a4cde9cecbed7e254a99ec525b60a3baf83a1","prompt_sha256":"81a4f629a6890c6f801162e4a74b9ab00ea246faf6b827f82fb3d8a5fee50daf","provider_session_id":"4f5b5f88-a624-4d0e-b190-48f4208254cf","requested_reasoning_effort":"max"},"schema":"model_response.v1"}