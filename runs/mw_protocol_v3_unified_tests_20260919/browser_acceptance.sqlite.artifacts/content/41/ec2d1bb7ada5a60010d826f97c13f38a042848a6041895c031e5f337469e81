{"content":"{\n  \"chapters\": {\n    \"v2_front_block\": {\n      \"document_control.applicable_parties\": {\n        \"text\": \"本方案适用于申办者、研究者、研究机构、伦理委员会、药品监督管理部门及经授权的临床研究相关人员。\"\n      },\n      \"document_control.confidentiality_statement\": {\n        \"text\": \"本方案及研究相关数据属于申办者保密信息，仅限研究授权人员、伦理委员会和监管机构审阅使用；未经申办者书面许可，不得向无关第三方披露。\"\n      },\n      \"document_control.header_footer_metadata\": {\n        \"header\": \"合成药X治疗慢性鼻窦炎伴鼻息肉的Ⅱ期临床研究方案\",\n        \"footer\": \"保密信息 | 页码\"\n      },\n      \"framing.document_title\": {\n        \"text\": \"合成药X治疗慢性鼻窦炎伴鼻息肉的Ⅱ期临床研究方案\"\n      }\n    },\n    \"v2_n_10_1_1\": {\n      \"ae.ae_term_binding\": {\n        \"text\": \"不良事件名称应采用医学术语，使用MedDRA进行编码；以首选语（PT）作为事件名称，系统器官分类（SOC）用于汇总分析。\"\n      },\n      \"ae.chapter_scope_framing\": {\n        \"text\": \"本章规定本Ⅱ期慢性鼻窦炎伴鼻息肉研究中不良事件和严重不良事件的定义、严重程度、相关性判断、收集、记录、随访及报告要求。\"\n      },\n      \"ae.definition\": {\n        \"text\": \"不良事件（AE）指受试者在接受试验用药品后出现的任何不良医学事件，包括症状、体征、疾病、实验室检查异常等，不一定与试验用药品存在因果关系。\"\n      },\n      \"ae.oncology_progression_exception_applicable\": false,\n      \"ae.pre_existing_condition_handling\": {\n        \"text\": \"既存疾病或症状应在筛选期病史中记录；若在首次给药后新发生或较基线加重，应作为AE记录；若持续存在但未加重，不作为AE。\"\n      },\n      \"ae.teaee_derivation\": {\n        \"text\": \"治疗期出现的不良事件（TEAE）定义为首次给予试验用药品后新发生或较基线恶化的AE；首次给药前已存在且未恶化的事件不计为TEAE。\"\n      },\n      \"ae.temporal_window_definition\": {\n        \"text\": \"TEAE观察期自首次给予试验用药品开始，至末次给药后30天结束；在此期间新发生或恶化的AE归为TEAE。\"\n      }\n    },\n    \"v2_n_10_1_2\": {\n      \"ae.severity_grading_definition\": {\n        \"text\": \"严重程度分级用于描述AE的强度，按NCI CTCAE 5.0版分为1至5级：1级轻度，2级中度，3级严重或医学上显著，4级危及生命，5级死亡。\"\n      },\n      \"ae.severity_scale_version\": {\n        \"text\": \"NCI CTCAE 5.0版。\"\n      },\n      \"ae.severity_seriousness_distinctness\": {\n        \"text\": \"严重程度（severity）指AE的强度分级，严重性（seriousness）指是否符合严重不良事件标准；两者概念不同，严重AE不一定严重程度高，反之亦然。\"\n      }\n    },\n    \"v2_n_10_1_3\": {\n      \"causality.current_authority_basis\": {\n        \"text\": \"相关性判断依据ICH E2A、CIOMS、NMPA药物临床试验质量管理规范及WHO-UMC因果关系评价原则，由研究者综合判断。\"\n      },\n      \"causality.five_level_terminology\": {\n        \"text\": \"采用五级相关性术语：肯定有关、很可能有关、可能有关、可能无关、无关。\"\n      },\n      \"causality.judgment_method\": {\n        \"text\": \"研究者根据事件发生时间与试验用药品给药的时间关系、临床过程、已知药理作用、去激发或再激发、混杂因素及既往病史等综合判断相关性；必要时由申办者医学人员复核。\"\n      },\n      \"causality.reportability_algorithm\": {\n        \"text\": \"SAE且与试验用药品相关性为肯定有关、很可能有关或可能有关，或无法排除相关性，且属于非预期不良反应的，按可疑且非预期严重不良反应（SUSAR）流程快速报告；严重但无关或预期的不良反应按SAE报告但不作为SUSAR；非严重AE按常规记录。报告时限遵循NMPA GCP和ICH E2A要求。\"\n      }\n    },\n    \"v2_n_10_1_4\": {\n      \"ae.ae_collection_not_teaee_classification\": {\n        \"text\": \"AE收集不预先限定为TEAE；在收集期内发生的所有AE均应记录，后续再按TEAE或非TEAE进行分类。\"\n      },\n      \"ae.collection_period_definition\": {\n        \"text\": \"AE收集期自首次给予试验用药品开始，至末次给药后30天结束；SAE收集期自签署知情同意书开始，至末次给药后30天结束。\"\n      },\n      \"ae.collection_period_start_reference\": {\n        \"text\": \"AE以首次给予试验用药品为收集起点；SAE以受试者签署知情同意书为收集起点。\"\n      },\n      \"ae.collection_stop_reference\": {\n        \"text\": \"AE和SAE均收集至末次给药后30天；若受试者提前终止试验，则至提前终止访视后30天。\"\n      },\n      \"ae.consent_history_distinction\": {\n        \"text\": \"签署知情同意书后至首次给药前发生的事件属于给药前事件，应记录SAE并按法规报告，但不计入TEAE；签署知情同意书前发生的事件不作为研究AE收集。\"\n      }\n    },\n    \"v2_n_10_1_5\": {\n      \"ae.recording_requirements\": {\n        \"text\": \"所有AE应完整记录于原始资料和eCRF，包括事件名称、开始时间、结束时间、严重程度、严重性、与试验用药品相关性、对试验用药品采取的措施、处理措施及转归；SAE还应记录报告日期和随访信息。\"\n      },\n      \"ae.report_time_selection_rule\": {\n        \"text\": \"AE的发生时间以事件实际开始日期为准；若开始日期不明确，应记录可获得的最早日期。SAE报告时限以研究者首次获知该事件的时间为起点计算。\"\n      },\n      \"ae.separate_times\": {\n        \"text\": \"应分别记录AE开始时间、结束时间、研究者获知时间及报告时间，不得相互替代或混用。\"\n      },\n      \"ae.terminology_boundary\": {\n        \"text\": \"AE名称应使用标准医学术语并采用MedDRA编码；实验室检查异常若符合AE定义应作为AE记录，否则按实验室异常处理；病史和合并用药不应与AE记录混同。\"\n      }\n    },\n    \"v2_n_10_1_6\": {\n      \"ae.followup_duration_or_end\": {\n        \"text\": \"AE随访至事件缓解、恢复至基线、稳定、确定不再恢复，或受试者死亡、失访、撤回知情同意；SAE应随访至事件解决、稳定或获得明确转归，且不少于末次给药后30天。\"\n      },\n      \"ae.followup_scope\": {\n        \"text\": \"所有未缓解的AE和SAE均应纳入随访，包括住院、转归、治疗及最终结局；SAE还应按法规要求完成快速报告和随访报告。\"\n      },\n      \"ae.ongoing_event_handling\": {\n        \"text\": \"末次给药后30天仍持续存在的AE应记录为持续中并继续随访至解决或稳定；持续存在的SAE应按法规要求报告并随访至事件解决或稳定。\"\n      }\n    },\n    \"v2_n_10_2_1\": {\n      \"sae.definition\": {\n        \"text\": \"严重不良事件（SAE）指在临床试验中发生的任何不良医学事件，符合以下一项或多项严重性标准：死亡、危及生命、需住院或延长住院、持续或显著残疾/丧失能力、先天异常/出生缺陷、重要医学事件。\"\n      },\n      \"sae.seriousness_criteria\": {\n        \"text\": \"严重性标准包括：导致死亡；危及生命；需要住院治疗或延长现有住院时间；导致持续或显著的残疾或丧失能力；导致先天异常或出生缺陷；属于重要医学事件，虽未达到上述标准，但可能危及受试者或需要干预以预防上述结局。\"\n      },\n      \"sae.seriousness_criteria_version_binding\": {\n        \"text\": \"严重性标准依据ICH E2A《临床安全数据管理：快速报告的定义和标准》及NMPA现行药物临床试验质量管理规范确定。\"\n      },\n      \"sae.severity_seriousness_distinctness\": {\n        \"text\": \"严重程度（severity）描述AE强度，按CTCAE分级；严重性（seriousness）判断是否符合SAE标准。二者不同，SAE不一定为重度AE，重度AE也不一定为SAE。\"\n      }\n    }\n  }\n}","receipt":{"idempotency_key":"chapter-facts.derive.v1","input_artifacts":[{"ref":"chapter-facts-input","sha256":"8b203522fa216314445c7b039022f9ef8ba80aa7ca79343f2b49805a70814d14"}],"logical_call_id":"call:chapter-facts:8b203522fa216314445c7b039022f9ef8ba80aa7ca79343f2b49805a70814d14","node_execution_contract_id":"nec:chapter-facts:8b203522fa216314445c7b039022f9ef8ba80aa7ca79343f2b49805a70814d14","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/chapter-facts-output.v1.json","output_sha256":"342090809689ed75614f69c63646194dccca328c53a75ace7b1b5a4698e5040f","prompt_sha256":"81a4f629a6890c6f801162e4a74b9ab00ea246faf6b827f82fb3d8a5fee50daf","provider_session_id":"08ccb373-06bb-4a87-8fd9-40d7df06953d","requested_reasoning_effort":"max"},"schema":"model_response.v1"}