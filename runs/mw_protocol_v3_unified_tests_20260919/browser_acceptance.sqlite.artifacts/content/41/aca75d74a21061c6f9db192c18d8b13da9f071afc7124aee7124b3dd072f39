{"content":"{\n  \"chapters\": {\n    \"v2_n_11_4_5\": {\n      \"statistics.safety_analysis.data_definition\": {\n        \"description\": \"安全性分析数据基于安全性分析集，包括不良事件、严重不良事件、实验室检查、生命体征、注射部位反应等。数据来源于病例报告表、源文件及检查报告。\"\n      },\n      \"statistics.safety_analysis.endpoints\": {\n        \"primary_safety_endpoints\": [\"不良事件（AE）\", \"严重不良事件（SAE）\", \"导致停药的不良事件\"],\n        \"other_safety_endpoints\": [\"注射部位反应\", \"生命体征\", \"临床实验室检查\"]\n      },\n      \"statistics.safety_analysis.observation_period\": {\n        \"start\": \"首次给予研究药物\",\n        \"end\": \"末次访视（包括第24周评估）或提前退出/终止\",\n        \"description\": \"安全性观察期从首次给药至末次访视，覆盖整个治疗期和随访期。\"\n      },\n      \"statistics.safety_analysis.population\": {\n        \"name\": \"安全性分析集\",\n        \"definition\": \"所有至少接受一剂研究药物的受试者，按实际接受的治疗分组。\",\n        \"rationale\": \"用于评估研究药物的安全性。\"\n      },\n      \"statistics.safety_analysis.summary_methods\": {\n        \"general\": \"按治疗组描述性总结不良事件和严重不良事件的发生率、例数、严重程度、与药物的关系等。\",\n        \"ae_analysis\": \"不良事件按系统器官分类和首选术语汇总。\",\n        \"continuous_variables\": \"实验室检查、生命体征等连续变量总结均数、标准差、中位数、最小值、最大值。\",\n        \"categorical_variables\": \"分类变量总结频数和百分比。\",\n        \"comparison\": \"不进行正式的统计学检验。\"\n      }\n    },\n    \"v2_n_11_4_6\": {\n      \"statistics.exploratory_analysis.data_definition\": {\n        \"applicable\": false,\n        \"description\": \"本研究未预设探索性终点分析。\"\n      },\n      \"statistics.exploratory_analysis.endpoints\": {\n        \"applicable\": false,\n        \"description\": \"无预设探索性终点。\"\n      },\n      \"statistics.exploratory_analysis.methods\": {\n        \"applicable\": false,\n        \"description\": \"无探索性终点统计分析方法。\"\n      },\n      \"statistics.pk_pd_er.pk_applicable\": {\n        \"applicable\": false,\n        \"description\": \"本研究未预设群体药代动力学分析。\"\n      },\n      \"statistics.pk_pd_er.pd_applicable\": {\n        \"applicable\": false,\n        \"description\": \"本研究未预设药效学分析。\"\n      },\n      \"statistics.pk_pd_er.er_applicable\": {\n        \"applicable\": false,\n        \"description\": \"本研究未预设暴露-效应分析。\"\n      },\n      \"statistics.pk_pd_er.pk_confirmatory\": false,\n      \"statistics.pk_pd_er.pd_confirmatory\": false,\n      \"statistics.pk_pd_er.er_confirmatory\": false\n    },\n    \"v2_n_11_4_7\": {\n      \"statistics.subgroup_analysis.data_definition\": {\n        \"description\": \"亚组分析基于FAS，按研究中心进行描述性总结。\"\n      },\n      \"statistics.subgroup_analysis.factors\": {\n        \"factors\": [\"研究中心\"],\n        \"description\": \"研究中心为随机分层因素，可作为描述性亚组因素。其他亚组因素未预设。\"\n      },\n      \"statistics.subgroup_analysis.interaction_or_heterogeneity\": {\n        \"description\": \"未预设正式的交互作用检验；亚组分析结果仅作描述性展示。\"\n      },\n      \"statistics.subgroup_analysis.interpretation\": {\n        \"description\": \"亚组分析结果为探索性，用于提示可能存在的效应异质性，不用于确证性结论。\"\n      },\n      \"statistics.subgroup_analysis.methods\": {\n        \"description\": \"按亚组描述主要终点和关键次要终点的汇总统计量，必要时计算风险差及95%CI；不进行多重性调整。\"\n      }\n    },\n    \"v2_n_11_4_8\": {\n      \"statistics.multiplicity.alpha_allocation\": {\n        \"overall_alpha\": \"双侧α=0.05\",\n        \"allocation\": \"主要终点与关键次要终点采用固定序列检验，整体双侧α=0.05，不进行α分割。\"\n      },\n      \"statistics.multiplicity.applicability_disposition\": {\n        \"applicable\": true,\n        \"description\": \"多重性调整适用于确证性终点：主要终点（第24周临床缓解率）和关键次要终点（第24周SNOT-22较基线变化）。其他次要终点为描述性分析，不纳入多重性调整。\"\n      },\n      \"statistics.multiplicity.confirmatory_family\": {\n        \"family\": [\"主要终点：第24周临床缓解率\", \"关键次要终点：第24周SNOT-22较基线变化\"],\n        \"description\": \"确证性检验族包括主要终点和关键次要终点。\"\n      },\n      \"statistics.multiplicity.dependencies\": {\n        \"description\": \"关键次要终点SNOT-22的检验依赖于主要终点达到统计学显著性；若主要终点未达到显著性，则SNOT-22不进行正式确证性检验。\"\n      },\n      \"statistics.multiplicity.no_adjustment_applicable\": {\n        \"applicable\": true,\n        \"description\": \"Lund-Kennedy内镜评分等次要终点为描述性分析，不进行多重性调整。\"\n      },\n      \"statistics.multiplicity.ordering\": {\n        \"order\": [\"主要终点：第24周临床缓解率\", \"关键次要终点：第24周SNOT-22较基线变化\"],\n        \"description\": \"按固定序列检验，先检验主要终点，达到显著性后再检验关键次要终点。\"\n      },\n      \"statistics.multiplicity.procedure\": {\n        \"method\": \"固定序列检验（fixed-sequence testing）\",\n        \"alpha\": \"双侧α=0.05\",\n        \"description\": \"主要终点采用双侧α=0.05检验；若显著，则关键次要终点在双侧α=0.05水平检验；否则停止确证性检验。\"\n      }\n    },\n    \"v2_n_11_4_9\": {\n      \"irc.applicable\": false,\n      \"statistics.interim.applicable\": {\n        \"applicable\": false,\n        \"description\": \"本研究无期中分析计划。\"\n      },\n      \"statistics.interim.features\": {\n        \"interim_analysis\": false,\n        \"description\": \"无期中分析计划，故无期中分析特征。\"\n      }\n    },\n    \"v2_n_12_1\": {\n      \"data_management.correction_review_roles\": {\n        \"correction_reviewer\": \"数据管理员和研究者\",\n        \"description\": \"数据更正需经研究者确认，数据管理员审核并记录。\"\n      },\n      \"data_management.responsible_parties\": {\n        \"sponsor\": \"申办方负责整体数据管理、质量保证和监管合规。\",\n        \"investigator\": \"研究者负责源数据的产生、准确性、完整性和及时记录。\",\n        \"data_manager\": \"数据管理员负责CRF设计、数据清理、质疑管理和数据库锁定。\",\n        \"monitor\": \"监查员负责源数据核查，确保源数据与CRF一致。\",\n        \"statistician\": \"生物统计师负责统计分析计划的制定和实施。\"\n      },\n      \"data_management.review_query_owner\": {\n        \"owner\": \"数据管理员\",\n        \"description\": \"数据管理员负责发起、跟踪和关闭数据质疑。\"\n      },\n      \"data_management.role_assignments\": {\n        \"source_data\": \"研究者\",\n        \"data_entry\": \"研究者或其授权人员\",\n        \"data_cleaning\": \"数据管理员\",\n        \"query_resolution\": \"研究者\",\n        \"source_data_verification\": \"监查员\",\n        \"database_lock\": \"数据管理员与申办方\"\n      },\n      \"data_management.source_identification_plan\": {\n        \"description\": \"源数据来源于受试者的医疗记录、实验室报告、检查报告、药物发放记录等。研究者在源文件中记录所有方案要求的数据。\",\n        \"source_documents\": [\"门诊/住院病历\", \"实验室检查报告\", \"影像学报告\", \"药物发放和回收记录\"]\n      }\n    },\n    \"v2_n_12_2\": {\n      \"data_management.copied_source_record\": {\n        \"description\": \"CRF中录入的数据为源数据的转录副本，源数据仍以医疗记录和源文件为准。\"\n      },\n      \"data_management.data_capture_method\": {\n        \"method\": \"电子数据采集系统（EDC/eCRF）\",\n        \"description\": \"研究者或其授权人员将源数据录入eCRF，系统内置逻辑核查和编辑检查。\"\n      },\n      \"data_management.direct_ecrf_source\": {\n        \"is_direct_source\": false,\n        \"description\": \"eCRF不是源文件，源数据以医疗记录和源文件为准。\"\n      },\n      \"data_management.source_data_review_path\": {\n        \"description\": \"监查员定期进行源数据核查，比对源文件与eCRF记录，确认数据一致性。\"\n      },\n      \"data_management.source_identification_method\": {\n        \"description\": \"通过受试者编号和访视日期在医疗记录中识别源数据，确保可追溯性。\"\n      }\n    },\n    \"v2_n_12_3\": {\n      \"data_quality.cleaning_review_record\": {\n        \"description\": \"数据清理过程包括编辑检查、数据审查和质疑管理，所有清理活动记录在数据管理报告中。\"\n      },\n      \"data_quality.query_escalation\": {\n        \"description\": \"若质疑未及时回复或存在重大数据问题，数据管理员按流程升级至监查员、项目经理或医学监查员。\"\n      },\n      \"data_quality.query_issuance\": {\n        \"description\": \"数据管理员根据编辑检查或人工审查结果在EDC系统中发起数据质疑，通知研究者。\"\n      },\n      \"data_quality.query_resolution\": {\n        \"description\": \"研究者对质疑进行核实和回复，数据管理员审核回复并关闭质疑；必要时更新源文件。\"\n      }\n    }\n  }\n}","receipt":{"idempotency_key":"chapter-facts.derive.v1","input_artifacts":[{"ref":"chapter-facts-input","sha256":"205d9ab2d4a6517d30362cccd61b310858c4056cd84982c8525a0cd98d520014"}],"logical_call_id":"call:chapter-facts:205d9ab2d4a6517d30362cccd61b310858c4056cd84982c8525a0cd98d520014","node_execution_contract_id":"nec:chapter-facts:205d9ab2d4a6517d30362cccd61b310858c4056cd84982c8525a0cd98d520014","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/chapter-facts-output.v1.json","output_sha256":"b164cf485be276e723857ddeb079bb9eb39a636a1d1ba5a2b35626ab8224199c","prompt_sha256":"81a4f629a6890c6f801162e4a74b9ab00ea246faf6b827f82fb3d8a5fee50daf","provider_session_id":"7b571d04-cad0-4136-9d45-26fed3fd150c","requested_reasoning_effort":"max"},"schema":"model_response.v1"}