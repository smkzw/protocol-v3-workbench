{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-6-2-4:v2\",\n  \"node_id\": \"v2_n_6_2_4\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"block_id\": \"blk:v2_n_6_2_4:paragraph:001\",\n      \"kind\": \"paragraph\",\n      \"text\": \"试验药应由研究者或其授权并经培训的临床试验人员负责准备和给药；药物分配与盲态维持应由不参与疗效评价的指定人员执行。应按随机分配准备合成药X注射制剂150 mg/1.0 mL或生理盐水安慰剂1.0 mL，并按注射剂无菌操作要求进行准备，给药前应检查外观和颗粒物。安慰剂与试验药应同体积、同途径、同频率给药；准备和给药前应核对随机号、药物标识、剂量/体积、给药日期和途径，保持双盲并记录实际给药。给药途径为皮下给药；负荷期第1、8、15、22天每周一次共4次，维持期第36天起每两周一次至第24周末次给药。准备、发放、给药和回收均应记录并接受监查。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"0196bd446e6de4381e1bc0579a8018bb566a9d7ee7991dec855ecf19a309b0e0"}],"logical_call_id":"call:chapter-draft:5cccadc426a7f49a49e2b4b08ea926e70230b739e6a4707f2e0b3d5488a7e415:chapter-generate","node_execution_contract_id":"nec:chapter-draft:5cccadc426a7f49a49e2b4b08ea926e70230b739e6a4707f2e0b3d5488a7e415:chapter-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/ordered-chapter-draft-candidate.v1.json","output_sha256":"700b36341a48b5b42ba6b37bba8909a3f269042b6ea8e4f285b287d5001485ea","prompt_sha256":"9aec0ea7a8d8361fdb1c273790e20e30d5e6b1d7680ac1c6c63436bd71300fac","provider_session_id":"dc247fda-fc5c-4720-a8d3-513e8027c4c1","requested_reasoning_effort":"max"},"schema":"model_response.v1"}