{"content":"{\n  \"chapters\": {\n    \"v2_n_11_4_5\": {\n      \"statistics.safety_analysis.data_definition\": {\n        \"safety_set\": \"安全性分析集包括所有至少接受一次研究药物（合成药X或安慰剂）给药的随机受试者，按实际接受的治疗分组。\",\n        \"data_sources\": [\"不良事件记录\", \"严重不良事件记录\", \"生命体征\", \"体格检查\", \"实验室检查\", \"12导联心电图\", \"注射部位评估\", \"合并用药记录\"],\n        \"coding\": \"不良事件和合并用药分别采用MedDRA和WHO Drug词典编码。\"\n      },\n      \"statistics.safety_analysis.endpoints\": {\n        \"primary_safety_endpoints\": [\"不良事件（AE）发生率、严重程度和相关性\", \"严重不良事件（SAE）发生率\", \"治疗期出现的不良事件（TEAE）发生率\"],\n        \"other_safety_endpoints\": [\"注射部位反应\", \"生命体征、体格检查、实验室检查、12导联心电图较基线的变化\", \"因不良事件导致的停药\", \"合并用药使用情况\"]\n      },\n      \"statistics.safety_analysis.observation_period\": {\n        \"start\": \"首次给予研究药物\",\n        \"end\": \"第24周末次给药后研究结束\",\n        \"ae_collection\": \"从首次给药至第24周末次给药/研究结束期间收集不良事件；严重不良事件按法规要求报告。\"\n      },\n      \"statistics.safety_analysis.population\": {\n        \"population\": \"安全性分析集（Safety Set）：所有至少接受一次研究药物给药的随机受试者。\",\n        \"grouping\": \"按实际接受的治疗组分析；安全性分析不采用ITT或FAS原则。\"\n      },\n      \"statistics.safety_analysis.summary_methods\": {\n        \"general\": \"安全性数据以描述性统计为主，不进行正式假设检验。\",\n        \"ae_summary\": \"按治疗组汇总不良事件的发生例数、发生率、严重程度、与药物的相关性、导致停药的情况；按MedDRA系统器官分类和首选术语分层。\",\n        \"continuous\": \"生命体征、实验室检查、心电图等连续变量报告例数、均值、标准差、中位数、最小值和最大值，以及较基线的变化；分类变量报告频数和百分比。\",\n        \"special\": \"注射部位反应按预先定义的类别汇总；严重不良事件单独列表。\"\n      }\n    },\n    \"v2_n_11_4_6\": {\n      \"statistics.exploratory_analysis.data_definition\": {\n        \"analysis_set\": \"探索性分析基于FAS或符合方案集（PPS）视具体终点而定。\",\n        \"note\": \"本研究未另行预设探索性终点分析；任何事后探索性分析将明确标注为探索性，不用于确证性结论。\"\n      },\n      \"statistics.exploratory_analysis.endpoints\": {\n        \"prespecified\": [],\n        \"note\": \"本研究未预设探索性终点。\"\n      },\n      \"statistics.exploratory_analysis.methods\": {\n        \"applicable\": false,\n        \"reason\": \"未预设探索性终点分析。\",\n        \"descriptive\": \"若开展探索性分析，仅采用描述性统计和图形展示，不控制多重性。\"\n      },\n      \"statistics.pk_pd_er.er_applicable\": {\n        \"applicable\": false,\n        \"reason\": \"研究设计未包含暴露-反应（ER）分析。\"\n      },\n      \"statistics.pk_pd_er.er_confirmatory\": false,\n      \"statistics.pk_pd_er.pd_applicable\": {\n        \"applicable\": false,\n        \"reason\": \"研究设计未包含药效学（PD）分析。\"\n      },\n      \"statistics.pk_pd_er.pd_confirmatory\": false,\n      \"statistics.pk_pd_er.pk_applicable\": {\n        \"applicable\": false,\n        \"reason\": \"研究设计未包含药代动力学（PK）分析。\"\n      },\n      \"statistics.pk_pd_er.pk_confirmatory\": false\n    },\n    \"v2_n_11_4_7\": {\n      \"statistics.subgroup_analysis.data_definition\": {\n        \"analysis_set\": \"如进行亚组分析，将基于FAS。\",\n        \"note\": \"本研究未预设亚组分析。\"\n      },\n      \"statistics.subgroup_analysis.factors\": {\n        \"prespecified\": [],\n        \"reason\": \"本研究未预设亚组因素，未计划亚组分析。\"\n      },\n      \"statistics.subgroup_analysis.interaction_or_heterogeneity\": {\n        \"applicable\": false,\n        \"reason\": \"无预设亚组分析，故不进行交互作用或异质性检验。\"\n      },\n      \"statistics.subgroup_analysis.interpretation\": {\n        \"applicable\": false,\n        \"reason\": \"不进行亚组分析，因此无预设亚组解释；任何事后亚组分析仅作探索性展示。\"\n      },\n      \"statistics.subgroup_analysis.methods\": {\n        \"applicable\": false,\n        \"reason\": \"未预设亚组分析方法。\"\n      }\n    },\n    \"v2_n_11_4_8\": {\n      \"statistics.multiplicity.alpha_allocation\": {\n        \"overall_two_sided_alpha\": 0.05,\n        \"primary\": \"双侧α=0.05用于主要终点（第24周临床缓解率）的优效性检验。\",\n        \"key_secondary\": \"若主要终点检验成功，则将同一双侧α=0.05用于关键次要终点（第24周SNOT-22较基线变化）的固定序列检验。\",\n        \"other_endpoints\": \"Lund-Kennedy内镜评分及其他次要/探索性分析不分配确证性α，仅描述性分析。\"\n      },\n      \"statistics.multiplicity.applicability_disposition\": {\n        \"confirmatory_family\": \"主要终点和第24周SNOT-22关键次要终点构成确证性检验家族。\",\n        \"multiplicity_control\": \"采用固定序列检验控制总I类错误率在双侧0.05。\",\n        \"descriptive\": \"Lund-Kennedy内镜评分和安全性分析等不纳入多重性调整。\"\n      },\n      \"statistics.multiplicity.confirmatory_family\": {\n        \"ordered_endpoints\": [\n          \"第24周临床缓解率（主要终点）\",\n          \"第24周SNOT-22较基线变化（关键次要终点）\"\n        ],\n        \"family_alpha\": \"双侧0.05\"\n      },\n      \"statistics.multiplicity.dependencies\": {\n        \"sequence_dependency\": \"关键次要终点SNOT-22的正式检验仅当主要终点达到统计学显著性后方可进行；若主要终点未达到，则SNOT-22不作确证性检验。\",\n        \"alpha_recycling\": \"不进行α回收或重新分配。\"\n      },\n      \"statistics.multiplicity.no_adjustment_applicable\": {\n        \"applicable\": true,\n        \"endpoints\": [\"Lund-Kennedy内镜评分较基线变化\", \"其他描述性次要终点\", \"安全性终点\"],\n        \"disposition\": \"不进行多重性调整；结果以描述性统计和名义P值（如报告）呈现，不用于确证性结论。\"\n      },\n      \"statistics.multiplicity.ordering\": {\n        \"order\": [\"主要终点：第24周临床缓解率\", \"关键次要终点：第24周SNOT-22较基线变化\"],\n        \"testing\": \"固定序列：先检验主要终点，成功后检验关键次要终点。\"\n      },\n      \"statistics.multiplicity.procedure\": {\n        \"method\": \"固定序列（hierarchical/gatekeeping）检验\",\n        \"alpha\": \"双侧0.05\",\n        \"decision_rule\": \"主要终点P<0.05则继续检验SNOT-22；SNOT-22 P<0.05则声明该关键次要终点具有统计学意义；否则停止确证性检验。\",\n        \"no_interim\": \"无期中分析，不涉及α消耗。\"\n      }\n    },\n    \"v2_n_11_4_9\": {\n      \"irc.applicable\": false,\n      \"statistics.interim.applicable\": {\n        \"applicable\": false,\n        \"reason\": \"用户简报明确无期中分析计划。\"\n      },\n      \"statistics.interim.features\": {\n        \"planned\": false,\n        \"idmc\": false,\n        \"reason\": \"无期中分析计划。\"\n      }\n    },\n    \"v2_n_12_1\": {\n      \"data_management.correction_review_roles\": {\n        \"data_correction\": \"研究者或授权人员负责在源文件和eCRF中更正数据，并记录更正原因和日期。\",\n        \"review\": \"数据管理员负责审核数据更正和质疑答复；监查员负责源数据核查。\",\n        \"documentation\": \"所有数据更正和审核活动保留稽查轨迹。\"\n      },\n      \"data_management.responsible_parties\": {\n        \"sponsor\": \"申办者负责整体数据管理、数据库建立、数据质量控制及统计分析。\",\n        \"investigator\": \"研究者负责源数据采集、eCRF录入、质疑答复和数据的医学准确性。\",\n        \"data_manager\": \"数据管理员负责数据清理、质疑管理和数据库锁定准备。\",\n        \"monitor\": \"监查员负责源数据核查和方案依从性监查。\",\n        \"statistician\": \"统计师负责统计分析计划制定和统计分析。\"\n      },\n      \"data_management.review_query_owner\": {\n        \"query_issuance_owner\": \"数据管理员\",\n        \"query_resolution_owner\": \"研究者或其授权的临床人员\",\n        \"review_owner\": \"数据管理员和监查员\",\n        \"escalation_owner\": \"研究者、申办者医学监查员\"\n      },\n      \"data_management.role_assignments\": {\n        \"source_data_entry\": \"研究者或授权人员\",\n        \"data_management\": \"数据管理员\",\n        \"source_data_review\": \"监查员\",\n        \"medical_review\": \"医学监查员/研究者\",\n        \"statistical_analysis\": \"统计师\",\n        \"database_lock\": \"数据管理员发起，申办者批准\"\n      },\n      \"data_management.source_identification_plan\": {\n        \"plan\": \"在研究启动前建立源数据识别计划/源数据映射，明确每个eCRF变量对应的源文件、采集方式和责任人。\",\n        \"source_documents\": [\"门诊/住院病历\", \"实验室报告\", \"心电图报告\", \"内镜报告\", \"VAS评分表\", \"药物发放记录\"],\n        \"direct_eCRF\": \"若变量直接录入eCRF且无独立源文件，需在源数据识别计划中注明并符合ALCOA+原则。\"\n      }\n    },\n    \"v2_n_12_2\": {\n      \"data_management.copied_source_record\": {\n        \"definition\": \"从源文件转录至eCRF的数据，如实验室检查、心电图等。\",\n        \"control\": \"转录数据需经源数据核查，确保与源文件一致；更正保留稽查轨迹。\"\n      },\n      \"data_management.data_capture_method\": {\n        \"primary\": \"采用电子数据采集（EDC/eCRF）系统进行数据采集。\",\n        \"entry\": \"由研究者或授权人员录入；必要时使用纸质源文件。\",\n        \"coding\": \"不良事件和合并用药采用标准词典编码。\"\n      },\n      \"data_management.direct_ecrf_source\": {\n        \"definition\": \"直接以eCRF作为源数据的情形，如受试者自评量表或研究者直接录入的评估。\",\n        \"requirements\": \"需在源数据识别计划中预先规定，并确保符合ALCOA+原则。\"\n      },\n      \"data_management.source_data_review_path\": {\n        \"path\": \"监查员按监查计划进行源数据核查，比较源文件与eCRF；发现差异时发起质疑并跟踪至解决。\",\n        \"documentation\": \"源数据核查活动记录在监查报告中。\"\n      },\n      \"data_management.source_identification_method\": {\n        \"method\": \"通过源数据识别计划/源数据映射表定义每个变量的来源。\",\n        \"categories\": [\"直接录入eCRF\", \"从源文件转录\", \"由外部供应商传输（如中心实验室）\"],\n        \"note\": \"所有源数据需可溯源、清晰、同步、原始、准确、完整、一致、持久、可获取（ALCOA+）。\"\n      }\n    },\n    \"v2_n_12_3\": {\n      \"data_quality.cleaning_review_record\": {\n        \"record\": \"数据清理活动记录包括数据清理计划、质疑日志、数据更正记录、数据库锁定检查表和稽查轨迹。\",\n        \"review\": \"数据管理员定期审查数据完整性、逻辑一致性、缺失值和异常值。\"\n      },\n      \"data_quality.query_escalation\": {\n        \"process\": \"未解决的质疑按预设时限逐级升级：数据管理员→监查员→研究者/主要研究者→申办者医学监查员。\",\n        \"criteria\": \"升级触发条件包括超时未答复、关键数据缺失或严重方案违背。\",\n        \"documentation\": \"升级和解决过程记录在质疑管理系统中。\"\n      },\n      \"data_quality.query_issuance\": {\n        \"issuer\": \"数据管理员或授权人员\",\n        \"triggers\": [\"缺失数据\", \"逻辑不一致\", \"超出范围值\", \"违反方案的数据\", \"源数据与eCRF不一致\"],\n        \"system\": \"通过EDC系统或质疑管理工具发放质疑。\"\n      },\n      \"data_quality.query_resolution\": {\n        \"resolver\": \"研究者或授权人员\",\n        \"actions\": \"答复质疑、更正eCRF或提供解释；数据管理员审核后关闭质疑。\",\n        \"documentation\": \"所有质疑、答复、更正和关闭均保留稽查轨迹。\"\n      }\n    }\n  }\n}","receipt":{"idempotency_key":"chapter-facts.derive.v1","input_artifacts":[{"ref":"chapter-facts-input","sha256":"205d9ab2d4a6517d30362cccd61b310858c4056cd84982c8525a0cd98d520014"}],"logical_call_id":"call:chapter-facts:205d9ab2d4a6517d30362cccd61b310858c4056cd84982c8525a0cd98d520014","node_execution_contract_id":"nec:chapter-facts:205d9ab2d4a6517d30362cccd61b310858c4056cd84982c8525a0cd98d520014","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/chapter-facts-output.v1.json","output_sha256":"dd0dc0fd66c0f4787e838bd74b175fe3916968fcb35a5242e6a35625a5bf8bed","prompt_sha256":"81a4f629a6890c6f801162e4a74b9ab00ea246faf6b827f82fb3d8a5fee50daf","provider_session_id":"5e705fdf-a7c8-42fe-8ffa-66f1b7ed0dcd","requested_reasoning_effort":"max"},"schema":"model_response.v1"}