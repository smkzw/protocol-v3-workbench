{"content":"{\n  \"chapters\": {\n    \"v2_n_11_1\": {\n      \"framing.structured_design.allocation_ratio\": {\n        \"ratio\": \"1:1\",\n        \"stratification\": \"按中心分层\",\n        \"description\": \"受试者按1:1随机分配至合成药X组或安慰剂组，随机化按中心分层。\"\n      },\n      \"framing.structured_design.hypothesis\": {\n        \"design\": \"随机双盲、安慰剂对照、优效性Ⅱ期概念验证研究\",\n        \"null_hypothesis\": \"第24周临床缓解率在合成药X组与安慰剂组间相同。\",\n        \"alternative_hypothesis\": \"第24周临床缓解率在合成药X组高于安慰剂组。\",\n        \"sidedness\": \"双侧α=0.05\"\n      },\n      \"statistics.sample_size.dose_alignment\": {\n        \"status\": \"一致\",\n        \"description\": \"样本量估算针对合成药X 150 mg/1.0 mL皮下给药方案（负荷期第1、8、15、22天每周一次共4次；维持期第36天起每两周一次至第24周末次给药）与安慰剂比较。\"\n      },\n      \"statistics.sample_size.interim_applicable\": false,\n      \"statistics.sample_size.reproducible_result\": {\n        \"primary_endpoint\": \"第24周临床缓解率\",\n        \"assumptions\": {\n          \"placebo_response_rate\": \"20%\",\n          \"synthetic_x_response_rate\": \"35%\",\n          \"absolute_difference\": \"15个百分点\",\n          \"alpha\": \"双侧0.05\",\n          \"power\": \"90%\",\n          \"allocation_ratio\": \"1:1\",\n          \"attrition\": \"8%\"\n        },\n        \"unadjusted_evaluable\": {\n          \"per_arm\": \"约184.1例，向上取整为185例\",\n          \"total\": \"370例\"\n        },\n        \"after_attrition\": {\n          \"per_arm\": \"约202例\",\n          \"total\": \"约404例\"\n        },\n        \"method\": \"两独立比例比较的正态近似\",\n        \"note\": \"中心数量及小层规模未在输入中给出，统计分析计划中应复核分层分析对样本量的影响。\"\n      },\n      \"statistics.sample_size.sidedness\": {\n        \"type\": \"双侧\",\n        \"alpha\": \"0.05\"\n      },\n      \"statistics.sample_size.soa_alignment\": {\n        \"status\": \"一致\",\n        \"description\": \"样本量估算依据第24周主要终点临床缓解率，主要疗效评估时点与SoA中第24周评估及末次给药至第24周一致；无期中分析计划。\"\n      },\n      \"statistics.sample_size.test_model\": {\n        \"model\": \"按中心分层的CMH检验\",\n        \"effect_estimate\": \"风险差及95%置信区间\",\n        \"stratification\": \"中心\",\n        \"comparison\": \"合成药X组 vs 安慰剂组\"\n      }\n    },\n    \"v2_n_11_2\": {\n      \"statistics.analysis_sets.available_assessments\": {\n        \"efficacy\": [\n          \"第24周临床缓解率（NPS≤1且鼻塞VAS≤1）\",\n          \"第24周SNOT-22较基线变化\",\n          \"第24周Lund-Kennedy内镜评分较基线变化\"\n        ],\n        \"baseline_and_demographics\": [\n          \"人口学及基线疾病特征\",\n          \"背景鼻用激素使用\"\n        ],\n        \"other\": [\n          \"依从性\",\n          \"合并用药\"\n        ]\n      },\n      \"statistics.analysis_sets.grouping_rules\": {\n        \"randomized_groups\": [\n          \"合成药X组\",\n          \"安慰剂组\"\n        ],\n        \"allocation_ratio\": \"1:1\",\n        \"stratification\": \"按中心分层\",\n        \"analysis_grouping\": \"疗效分析按随机分组进行。\"\n      },\n      \"statistics.analysis_sets.handling_rules\": {\n        \"primary_analysis\": \"FAS（ITT原则），按随机分组分析；第24周缺失主要终点采用NRI。\",\n        \"intercurrent_events\": \"ICE按治疗策略处理；救援治疗不排除、不删失。\",\n        \"sensitivity_analysis\": \"主要终点敏感性分析采用tipping point。\"\n      },\n      \"statistics.analysis_sets.inclusion_rules\": {\n        \"FAS\": \"所有随机化受试者，按ITT原则纳入主要分析；第24周缺失主要终点按NRI处理。\",\n        \"treated_set\": \"接受至少一剂研究药物的受试者，用于依从性等分析。\"\n      },\n      \"statistics.analysis_sets.randomized\": {\n        \"definition\": \"所有经随机化分配至合成药X组或安慰剂组的受试者。\",\n        \"ratio\": \"1:1\",\n        \"stratification\": \"按中心分层\"\n      },\n      \"statistics.analysis_sets.rescue_treated_handling\": {\n        \"rescue_treatment_definition\": \"因鼻塞加重使用全身激素或鼻窦手术。\",\n        \"handling\": \"接受救援治疗的受试者不排除，仍按随机分组纳入FAS；ICE按治疗策略处理，主要终点缺失按NRI。\"\n      },\n      \"statistics.analysis_sets.treated\": {\n        \"definition\": \"接受至少一剂研究药物（合成药X或安慰剂）的受试者。\",\n        \"grouping\": \"按实际接受治疗分组。\"\n      }\n    },\n    \"v2_n_11_3\": {\n      \"statistics.descriptive.intercurrent_event_distinction\": {\n        \"ice_events\": [\n          \"鼻塞加重需全身激素或手术干预\",\n          \"因不良事件停药\",\n          \"失访\"\n        ],\n        \"rescue_treatment\": \"因鼻塞加重使用全身激素或鼻窦手术。\",\n        \"strategy\": \"ICE按治疗策略处理。\",\n        \"missing_outcome\": \"第24周缺失主要终点采用NRI；敏感性分析采用tipping point。\"\n      },\n      \"statistics.descriptive.missing_denominator_rules\": {\n        \"primary_response\": \"主要分析FAS中按随机分组的所有受试者为分母；第24周缺失主要终点按NRI计为无应答。\"\n      },\n      \"statistics.descriptive.missing_outcome_handling\": {\n        \"primary\": \"第24周缺失主要终点采用无应答插补（NRI）。\",\n        \"sensitivity\": \"主要终点敏感性分析采用tipping point。\",\n        \"ice\": \"ICE按治疗策略处理。\"\n      },\n      \"statistics.descriptive.summary_conventions\": {\n        \"continuous\": \"报告例数、均值、标准差、中位数、最小值、最大值。\",\n        \"categorical\": \"报告各类别例数及百分比。\"\n      },\n      \"statistics.descriptive.variable_types\": {\n        \"primary_endpoint\": \"二分类（临床缓解是/否）。\",\n        \"secondary_endpoints\": \"连续变量（SNOT-22变化、Lund-Kennedy评分变化）。\",\n        \"demographics\": \"连续或分类变量。\",\n        \"adherence\": \"连续或分类变量。\"\n      }\n    },\n    \"v2_n_11_4_1\": {\n      \"statistics.demographics.baseline_variables\": {\n        \"demographics\": [\n          \"年龄\",\n          \"性别\"\n        ],\n        \"disease_characteristics\": [\n          \"基线双侧鼻息肉评分（NPS）\",\n          \"基线鼻塞VAS\",\n          \"基线SNOT-22\",\n          \"基线Lund-Kennedy内镜评分\"\n        ],\n        \"background_treatment\": [\n          \"稳定背景鼻用激素使用情况\"\n        ]\n      },\n      \"statistics.demographics.data_definition\": {\n        \"analysis_set\": \"FAS（ITT原则）\",\n        \"grouping\": \"按随机分组（合成药X组、安慰剂组）\",\n        \"baseline_definition\": \"基线定义为首次给药前。\"\n      },\n      \"statistics.demographics.summary_methods\": {\n        \"continuous\": \"例数、均值、标准差、中位数、最小值、最大值\",\n        \"categorical\": \"例数及百分比\",\n        \"by_group\": \"按治疗组分别汇总。\"\n      },\n      \"statistics.demographics.variable_types\": {\n        \"age\": \"连续变量\",\n        \"sex\": \"分类变量\",\n        \"NPS\": \"连续变量\",\n        \"nasal_congestion_VAS\": \"连续变量\",\n        \"SNOT-22\": \"连续变量\",\n        \"Lund-Kennedy\": \"连续变量\",\n        \"background_INCS\": \"分类变量\"\n      }\n    },\n    \"v2_n_11_4_2\": {\n      \"statistics.adherence.data_definition\": {\n        \"analysis_set\": \"接受至少一剂研究药物的受试者（treated set）\",\n        \"treatment_groups\": [\n          \"合成药X组\",\n          \"安慰剂组\"\n        ],\n        \"source\": \"给药记录/注射记录\"\n      },\n      \"statistics.adherence.definition\": {\n        \"definition\": \"依从性定义为实际接受的计划内研究药物注射次数占计划注射次数的比例。\",\n        \"planned_regimen\": \"负荷期第1、8、15、22天共4次；维持期第36天起每两周一次至第24周末次给药。\"\n      },\n      \"statistics.adherence.denominator\": {\n        \"denominator\": \"计划注射次数\",\n        \"population\": \"接受至少一剂研究药物的受试者\",\n        \"per_group\": \"按治疗组分别计算\"\n      },\n      \"statistics.adherence.measurement_method\": {\n        \"method\": \"根据注射记录和药物计数计算实际注射次数与计划注射次数的比例，并按连续比例汇总。\"\n      },\n      \"statistics.concomitant_treatment.definition\": {\n        \"definition\": \"研究期间除研究药物外使用的所有药物或治疗，包括允许的稳定背景鼻用激素。\",\n        \"rescue_treatment\": \"因鼻塞加重使用全身激素或鼻窦手术定义为救援治疗。\"\n      },\n      \"statistics.concomitant_treatment.timing\": {\n        \"collection_window\": \"从基线/首次给药至第24周研究结束。\"\n      }\n    },\n    \"v2_n_11_4_3_1\": {\n      \"estimand.primary.intercurrent_events\": {\n        \"events\": [\n          \"鼻塞加重需全身激素或手术干预\",\n          \"因不良事件停药\",\n          \"失访\"\n        ],\n        \"rescue_treatment\": \"因鼻塞加重使用全身激素或鼻窦手术。\",\n        \"strategy\": \"ICE按治疗策略（treatment policy）处理。\",\n        \"rationale\": \"用户简报明确ICE按治疗策略处理并列出ICE事件；NRI和tipping point为输入中已给出的操作性定义建议值。\"\n      },\n      \"estimand.primary.population\": {\n        \"population\": \"成人慢性鼻窦炎伴鼻息肉患者。\",\n        \"background_therapy\": \"允许稳定背景鼻用激素并记录。\",\n        \"analysis_set\": \"FAS（ITT原则），按随机分组分析。\"\n      },\n      \"estimand.primary.treatment_condition\": {\n        \"experimental\": \"合成药X注射制剂150 mg/1.0 mL皮下给药：负荷期第1、8、15、22天每周一次共4次；维持期第36天起每两周一次至第24周末次给药。\",\n        \"control\": \"生理盐水安慰剂1.0 mL皮下注射，同体积、同途径、同频率。\",\n        \"comparison\": \"合成药X组 vs 安慰剂组\"\n      },\n      \"statistics.primary_analysis.analysis_set\": {\n        \"name\": \"FAS（ITT原则）\",\n        \"definition\": \"主要分析集为FAS，按随机分组进行分析。\",\n        \"missing_data\": \"第24周缺失主要终点采用NRI；敏感性分析采用tipping point。\"\n      },\n      \"statistics.primary_analysis.dose_consistency\": {\n        \"status\": \"一致\",\n        \"description\": \"主要分析按随机分配的治疗组比较，合成药X组对应150 mg/1.0 mL皮下给药方案，安慰剂组对应生理盐水1.0 mL同途径同频率；不因实际接受剂量或救援治疗改变分组。\"\n      },\n      \"statistics.primary_analysis.effect_measure\": {\n        \"measure\": \"风险差\",\n        \"comparison\": \"合成药X组相对安慰剂组第24周临床缓解率的风险差\",\n        \"confidence_interval\": \"95%CI\",\n        \"test\": \"按中心分层的CMH检验\"\n      },\n      \"statistics.primary_analysis.estimand_linkage\": {\n        \"variable\": \"第24周临床缓解，定义为双侧鼻息肉评分（NPS）≤1且鼻塞VAS≤1。\",\n        \"population\": \"成人慢性鼻窦炎伴鼻息肉患者，FAS（ITT）。\",\n        \"treatment_condition\": \"合成药X 150 mg/1.0 mL皮下给药方案 vs 安慰剂。\",\n        \"ice_strategy\": \"ICE按治疗策略处理。\",\n        \"summary_measure\": \"第24周临床缓解率（比例），风险差及95%CI。\",\n        \"alignment\": \"主要分析直接对应主要估计目标。\"\n      },\n      \"statistics.primary_analysis.method\": {\n        \"primary_method\": \"按中心分层的CMH检验\",\n        \"effect_estimate\": \"风险差及95%CI\",\n        \"alpha\": \"双侧0.05\"\n      },\n      \"statistics.primary_analysis.missing_data\": {\n        \"primary\": \"第24周缺失主要终点采用无应答插补（NRI）。\",\n        \"sensitivity\": \"采用tipping point。\",\n        \"ice\": \"ICE按治疗策略处理。\"\n      },\n      \"statistics.primary_analysis.soa_consistency\": {\n        \"status\": \"一致\",\n        \"description\": \"主要终点在第24周评估，与SoA中第24周评估时点一致；末次给药至第24周；无期中分析。\"\n      }\n    },\n    \"v2_n_11_4_3_2\": {\n      \"statistics.sensitivity_analysis.assumption\": {\n        \"primary_assumption\": \"主要分析采用NRI，即第24周缺失主要终点视为无应答。\",\n        \"sensitivity_assumption\": \"敏感性分析通过tipping point探索缺失结局偏离NRI假设时对结论的影响。\"\n      },\n      \"statistics.sensitivity_analysis.estimand_alignment\": {\n        \"alignment\": \"敏感性分析保持与主要估计目标一致：FAS、按随机分组、第24周临床缓解、ICE按治疗策略、风险差及95%CI。\"\n      },\n      \"statistics.sensitivity_analysis.method\": {\n        \"method\": \"tipping point分析\",\n        \"description\": \"在缺失主要终点的不同插补假设下重复主要分析，确定使优效性结论发生改变的tipping point。\"\n      },\n      \"statistics.sensitivity_analysis.missing_data_handling\": {\n        \"handling\": \"采用tipping point处理第24周缺失主要终点；探索不同缺失值假设下的结果稳健性。\"\n      },\n      \"statistics.sensitivity_analysis.primary_method_link\": {\n        \"link\": \"沿用主要分析的按中心分层CMH检验、FAS和风险差及95%CI。\"\n      },\n      \"statistics.sensitivity_analysis.result_interpretation\": {\n        \"interpretation\": \"若在不同合理缺失假设下优效性结论保持稳健，则支持主要分析结果；若结论仅在极端假设下维持，应谨慎解读。\"\n      }\n    },\n    \"v2_n_11_4_4\": {\n      \"statistics.secondary_analysis.analysis_set\": {\n        \"analysis_set\": \"FAS（ITT原则），按随机分组分析。\"\n      },\n      \"statistics.secondary_analysis.data_definition\": {\n        \"timepoint\": \"第24周\",\n        \"baseline\": \"首次给药前\",\n        \"change\": \"第24周值较基线变化值\"\n      },\n      \"statistics.secondary_analysis.endpoint_definitions\": {\n        \"key_secondary\": \"第24周SNOT-22较基线变化。\",\n        \"secondary\": \"第24周Lund-Kennedy内镜评分较基线变化。\"\n      },\n      \"statistics.secondary_analysis.methods\": {\n        \"key_secondary\": \"SNOT-22采用固定序列检验控制多重性。\",\n        \"secondary\": \"Lund-Kennedy为描述性分析，不控制多重性。\",\n        \"testing_sequence\": \"固定序列检验：首先检验主要终点，若显著则检验关键次要终点SNOT-22。\"\n      }\n    }\n  }\n}","receipt":{"idempotency_key":"chapter-facts.derive.v1","input_artifacts":[{"ref":"chapter-facts-input","sha256":"7ce9d5c5b7444d835e88e64f44caba3bd81168374ceea17d2d926807352249dd"}],"logical_call_id":"call:chapter-facts:7ce9d5c5b7444d835e88e64f44caba3bd81168374ceea17d2d926807352249dd","node_execution_contract_id":"nec:chapter-facts:7ce9d5c5b7444d835e88e64f44caba3bd81168374ceea17d2d926807352249dd","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/chapter-f