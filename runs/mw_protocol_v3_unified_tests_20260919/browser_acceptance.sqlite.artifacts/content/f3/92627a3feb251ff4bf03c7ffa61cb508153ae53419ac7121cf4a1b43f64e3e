者提供的稳定性数据和标签要求储存、运输和使用；未获稳定性支持的条件不得使用，且应在标签标示的有效期内使用。给药前检查药物外观、颗粒物、包装完整性和有效期；如出现浑浊、变色、颗粒、破损、过期或温度偏离，不得使用。发生温度偏离时，立即隔离并报告申办者，按申办者评估决定是否可用或销毁。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:n-6-2-3:2\",\n            \"order\": 1,\n            \"label\": \"生理盐水安慰剂\",\n            \"style_role\": \"body\",\n            \"source_locator\": \"\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:n-6-2-3:r2:item\",\n                \"row_id\": \"row:n-6-2-3:2\",\n                \"column_id\": \"col:n-6-2-3:item\",\n                \"text\": \"生理盐水安慰剂\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:n-6-2-3:r2:condition\",\n                \"row_id\": \"row:n-6-2-3:2\",\n                \"column_id\": \"col:n-6-2-3:storage_condition\",\n                \"text\": \"按相同要求储存；包装和标签维持盲态\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:n-6-2-3:r2:unit\",\n                \"row_id\": \"row:n-6-2-3:2\",\n                \"column_id\": \"col:n-6-2-3:storage_unit\",\n                \"text\": \"2℃～8℃\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:n-6-2-3:r2:stability\",\n                \"row_id\": \"row:n-6-2-3:2\",\n                \"column_id\": \"col:n-6-2-3:stability_handling\",\n                \"text\": \"按相同要求储存；包装和标签维持盲态。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          }\n        ],\n        \"notes\": [\n          {\n            \"note_id\": \"note:n-6-2-3:storage-consistency\",\n            \"note_type\": \"operational\",\n            \"text\": \"注：储存条件应与申办者提供的临床试验用药品标签及研究者手册一致；发生温度偏离时，应立即隔离并报告申办者评估。\",\n            \"source_refs\": [],\n            \"marker_source_locator\": \"\",\n            \"target_ids\": [\n              \"intervention:cell:storage_condition\",\n              \"intervention:cell:storage_unit\"\n            ]\n          }\n        ]\n      }\n    },\n    {\n      \"block_id\": \"block:n-6-2-3:p3\",\n      \"kind\": \"paragraph\",\n      \"text\": \"应定期记录和审查储存温度；发生温度偏离时，应立即隔离药物并报告申办者评估。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"block:n-6-2-3:p4\",\n      \"kind\": \"paragraph\",\n      \"text\": \"应按申办者提供的稳定性数据和标签要求储存、运输和使用；未获稳定性支持的条件不得使用，且应在标签标示的有效期内使用。给药前应检查药物外观、颗粒物、包装完整性和有效期；如出现浑浊、变色、颗粒、破损、过期或温度偏离，不得使用。注射剂应按无菌操作要求准备，给药前核对随机号、药物标识、剂量/体积、给药日期和途径。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"block:n-6-2-3:p5\",\n      \"kind\": \"paragraph\",\n      \"text\": \"稳定性相关检查、温度偏离和处理记录应保存于药物管理记录。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"a950d97ce63947b9a70d89c58e43cf64fe4a4bdee19d7e1e4219f71040b0a378"}],"logical_call_id":"call:chapter-draft:d84ac80df392141330cfc1a86722d0346d0dcdcf57c2a164b25fcf9423450366:chapter-generate","node_execution_contract_id":"nec:chapter-draft:d84ac80df392141330cfc1a86722d0346d0dcdcf57c2a164b25fcf9423450366:chapter-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/ordered-chapter-draft-candidate.v1.json","output_sha256":"17b58327c79427e261b71ea4b366940e096f8fb0d1