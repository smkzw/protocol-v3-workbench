{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-6-2-3:v2\",\n  \"node_id\": \"v2_n_6_2_3\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"block_id\": \"block:n-6-2-3:p1\",\n      \"kind\": \"paragraph\",\n      \"text\": \"试验用药品应于2℃～8℃避光冷藏，保持原包装并标识“仅供临床试验使用”；储存条件应与申办者提供的临床试验用药品标签及研究者手册规定一致。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"block:n-6-2-3:p2\",\n      \"kind\": \"paragraph\",\n      \"text\": \"生理盐水安慰剂应按相同要求储存，包装和标签维持盲态。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"block:n-6-2-3:table1\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [],\n      \"table\": {\n        \"table_id\": \"table:n-6-2-3:storage-stability\",\n        \"block_id\": \"block:n-6-2-3:table1\",\n        \"title\": \"表6-2-3 试验用药品储存条件与稳定性处理\",\n        \"domain\": \"generic\",\n        \"role\": \"body_content\",\n        \"review_state\": \"ai_draft\",\n        \"schema_version\": \"structured_table_v1\",\n        \"header_row_count\": 1,\n        \"source_locator\": \"\",\n        \"version\": 0,\n        \"word_layout\": {},\n        \"columns\": [\n          {\n            \"column_id\": \"col:n-6-2-3:item\",\n            \"label\": \"项目\",\n            \"order\": 0,\n            \"semantic_role\": \"item\",\n            \"style_role\": \"header\",\n            \"source_locator\": \"\"\n          },\n          {\n            \"column_id\": \"col:n-6-2-3:storage_condition\",\n            \"label\": \"储存条件\",\n            \"order\": 1,\n            \"semantic_role\": \"storage_condition\",\n            \"style_role\": \"header\",\n            \"source_locator\": \"\"\n          },\n          {\n            \"column_id\": \"col:n-6-2-3:storage_unit\",\n            \"label\": \"单位/范围\",\n            \"order\": 2,\n            \"semantic_role\": \"storage_unit\",\n            \"