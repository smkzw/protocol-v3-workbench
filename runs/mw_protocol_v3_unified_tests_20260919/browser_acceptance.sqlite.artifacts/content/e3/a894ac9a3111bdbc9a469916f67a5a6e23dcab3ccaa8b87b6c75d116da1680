{"content":"{\n  \"status\": \"needs_information\",\n  \"objectives\": {\n    \"primary\": [\n      {\n        \"text\": \"在慢性鼻窦炎伴鼻息肉成人患者中，证明合成药X（150 mg/1.0 mL皮下注射，负荷期第1、8、15、22天，维持期第36天起每两周一次至第24周）相较于生理盐水安慰剂在第24周临床缓解率上的优效性（Ⅱ期概念验证）。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户简报明确主要比较为Ⅱ期概念验证的优效性检验，主要终点为第24周临床缓解率。\",\n        \"references\": []\n      }\n    ],\n    \"secondary\": [\n      {\n        \"text\": \"评估第24周SNOT-22较基线的变化，作为关键次要终点，并在固定序列检验中控制多重性。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户简报将SNOT-22列为关键次要终点，并规定采用固定序列检验控制多重性。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"评估第24周Lund-Kennedy内镜评分较基线的变化，作为描述性次要终点。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户简报将Lund-Kennedy内镜评分列为次要终点，并规定为描述性分析。\",\n        \"references\": []\n      }\n    ],\n    \"questions\": []\n  },\n  \"endpoint\": {\n    \"primary_endpoint\": {\n      \"text\": \"第24周临床缓解率：达到双侧鼻息肉评分（NPS）≤1且鼻塞VAS≤1的受试者比例。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户简报明确主要终点为第24周临床缓解率，并给出操作定义。\",\n      \"references\": []\n    },\n    \"key_secondary\": [\n      {\n        \"text\": \"第24周SNOT-22较基线的变化；关键次要终点，采用固定序列检验控制多重性。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户简报明确SNOT-22为关键次要终点并规定多重性策略。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"第24周Lund-Kennedy内镜评分较基线的变化；描述性分析。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户简报明确Lund-Kennedy为次要终点并规定描述性分析。\",\n        \"references\": []\n      }\n    ],\n    \"measurement_details\": \"NPS采用0～8分（每侧0～4分的双侧总和），缓解阈值为≤1分；鼻塞VAS采用0～10 cm视觉模拟量表，缓解阈值为≤1分；次要终点均在第24周评估。\",\n    \"questions\": [\n      \"NPS和鼻塞VAS的最终评估时间窗、评估者培训与中心间一致性要求是什么？\",\n      \"第24周临床缓解的操作定义（NPS≤1且鼻塞VAS≤1）是否经研究者最终确认，是否允许任何访视窗或评分方法偏差？\"\n    ]\n  },\n  \"estimand\": {\n    \"treatment\": {\n      \"text\": \"合成药X 150 mg/1.0 mL皮下注射：负荷期第1、8、15、22天每周一次，共4次；维持期第36天起每两周一次至第24周末次给药。对照为生理盐水安慰剂1.0 mL皮下注射，同体积、同途径、同频率。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户简报明确给药方案和安慰剂匹配方式。\",\n      \"references\": []\n    },\n    \"population\": {\n      \"text\": \"慢性鼻窦炎伴鼻息肉成人患者；主要分析集为FAS（ITT原则）；随机1:1，按中心分层；允许稳定背景鼻用激素并记录。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户简报明确研究人群、分析集、随机分层和背景治疗。\",\n      \"references\": []\n    },\n    \"variable\": {\n      \"text\": \"第24周临床缓解这一二分类变量：NPS≤1且鼻塞VAS≤1。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户简报给出主要终点的操作定义。\",\n      \"references\": []\n    },\n    \"ice_strategy\": {\n      \"text\": \"治疗策略（treatment policy）：ICE事件发生后受试者仍按随机分组纳入分析；ICE包括鼻塞加重需全身激素或手术干预、因不良事件停药、失访；救援治疗定义为因鼻塞加重使用全身激素或鼻窦手术。第24周缺失主要终点采用NRI，敏感性分析采用tipping point。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户简报明确ICE按治疗策略处理并给出ICE事件、救援治疗及缺失处理。\",\n      \"references\": []\n    },\n    \"summary_measure\": {\n      \"text\": \"第24周临床缓解率的组间风险差（合成药X组−安慰剂组），采用CMH分层检验并报告95%CI。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户简报明确主要分析采用CMH分层检验并报告风险差及95%CI。\",\n      \"references\": []\n    },\n    \"ice_events\": [\n      \"鼻塞加重需全身激素或手术干预\",\n      \"因不良事件停药\",\n      \"失访\"\n    ],\n    \"questions\": [\n      \"ICE事件发生后是否继续收集第24周主要终点数据？治疗策略下NRI与tipping point的缺失数据处理层级是否最终确认？\",\n      \"是否需要补充假想策略（hypothetical）或principal stratum敏感性分析以评估ICE对疗效估计的影响？\"\n    ]\n  },\n  \"sample_size\": {\n    \"assumptions\": [\n      \"主要终点为第24周临床缓解率\",\n      \"安慰剂组缓解率20%，合成药X组缓解率35%，绝对风险差15个百分点\",\n      \"双侧α=0.05，检验效能90%\",\n      \"1:1随机，按中心分层；主要分析为CMH分层检验\",\n      \"失访率8%\",\n      \"第24周缺失主要终点采用NRI\",\n      \"无期中分析\"\n    ],\n    \"alpha\": \"双侧α=0.05\",\n    \"power\": \"90%\",\n    \"model\": \"两独立样本率的正态近似样本量计算，用于CMH分层检验的主分析；在不计分层设计效应的保守近似下估计。\",\n    \"planned_n\": \"约400例，200例/组。按约184例/组可评估样本量，考虑8%失访后约200例/组。\",\n    \"attrition\": \"预计失访8%，按1/(1−0.08)膨胀样本量。\",\n    \"justification\": \"以p1=0.20、p2=0.35、双侧α=0.05、power=90%，n/组=[z0.975√(2p̄(1−p̄))+z0.90√(p1(1−p1)+p2(1−p2))]^2/(p1−p2)^2，p̄=0.275，计算约184.1例/组可评估；经8%失访膨胀184.1/0.92≈200.1，取200例/组，总计约400例。\",\n    \"questions\": [\n      \"样本量是否需额外考虑中心分层设计效应、中心数量和中心内最小样本量？\",\n      \"8%失访假设是否已纳入NRI导致的效应稀释，是否需要基于tipping point敏感性分析调整？\"\n    ],\n    \"references\": []\n  },\n  \"interim_planning\": null,\n  \"non_inferiority_margin\": null,\n  \"questions\": [\n    \"主要终点操作定义（NPS≤1且鼻塞VAS≤1）及第24周评估时间窗需研究者最终确认。\",\n    \"ICE事件发生后第24周主要终点的收集、NRI与tipping point的缺失处理层级需最终确认。\",\n    \"样本量是否需计入中心分层设计效应及中心内最小样本量需最终确认。\"\n  ],\n  \"unresolved_questions\": [\n    \"主要终点操作定义及评估时间窗的最终确认。\",\n    \"ICE事件后主要终点数据收集与缺失处理策略的最终确认。\",\n    \"样本量是否需包含中心分层设计效应及中心内最小样本量。\"\n  ]\n}","receipt":{"idempotency_key":"design-elements.generate.v1","input_artifacts":[{"ref":"design-elements-intake","sha256":"36320a14f5b650f00b3714bb8f7c044630f236631fd6278c5147e2e828eee2c9"}],"logical_call_id":"call:design-elements:428b39e70770b7744357fa96cba3d4a12baba9cecc311ab5de07b927521a5bf8:design-generate","node_execution_contract_id":"nec:design-elements:428b39e70770b7744357fa96cba3d4a12baba9cecc311ab5de07b927521a5bf8:design-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/design-elements-output.v1.json","output_sha256":"5eda959a902749bacb9d22ba0fce63f1d78b6d7b2c64d1b96e18c953eb57aaeb","prompt_sha256":"0434ecd36e0e0a74215ce07f9d8024a58da6c70dac604c0eab379bef1197f63f","provider_session_id":"70973071-1f2f-4a87-8c8f-029628a5d09c","requested_reasoning_effort":"max"},"schema":"model_response.v1"}