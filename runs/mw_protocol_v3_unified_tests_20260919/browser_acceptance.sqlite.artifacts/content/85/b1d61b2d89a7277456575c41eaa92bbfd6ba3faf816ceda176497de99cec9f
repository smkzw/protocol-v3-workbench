{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-11-4-3-1:v2\",\n  \"node_id\": \"v2_n_11_4_3_1\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"block_id\": \"blk:v2-n-11-4-3-1:p001\",\n      \"kind\": \"paragraph\",\n      \"text\": \"主要估计目标的主要分析基于已确认的主要估计目标。主要估计目标人群为成人慢性鼻窦炎伴鼻息肉患者；允许稳定背景鼻用糖皮质激素并记录。主要分析集为FAS（ITT原则），按随机分组进行分析。主要终点为第24周临床缓解率，即第24周达到双侧鼻息肉评分（NPS）≤1且鼻塞VAS≤1的受试者比例；变量为第24周临床缓解，定义为双侧鼻息肉评分（NPS）≤1且鼻塞VAS≤1。治疗条件为随机分配的治疗：合成药X 150 mg/1.0 mL皮下给药方案（负荷期第1、8、15、22天每周一次共4次；维持期第36天起每两周一次至第24周（末次给药））或安慰剂（生理盐水1.0 mL皮下注射，同体积同途径同频率）。\",\n      \"source_locator\": \"\",\n      \"evidence_refs\": []\n    },\n    {\n      \"block_id\": \"blk:v2-n-11-4-3-1:p002\",\n      \"kind\": \"paragraph\",\n      \"text\": \"主要分析方法为按中心分层的CMH检验，双侧α=0.05；主要比较为合成药X组相对安慰剂组第24周临床缓解率的风险差，并提供95%CI。该分析直接对应主要估计目标：汇总指标为第24周临床缓解率（比例）、风险差及95%CI，人群为成人慢性鼻窦炎伴鼻息肉患者FAS（ITT），治疗条件为合成药X 150 mg/1.0 mL皮下给药方案 vs 安慰剂。\",\n      \"source_locator\": \"\",\n      \"evidence_refs\": []\n    },\n    {\n      \"block_id\": \"blk:v2-n-11-4-3-1:t001\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [],\n      \"table\": {\n        \"table_id\": \"tbl:v2-n-11-4-3-1:primary-analysis-summary\",\n        \"block_id\": \"blk:v2-n-11-4-3-1:t001\",\n        \"title\": \"主要估计目标的主要分析要素\",\n        \"schema_version\": \"structured_table_v1\",\n        \"domain\": \"generic\",\n        \"role\": \"body_content\",\n        \"review_state\": \"ai_draft\",\n        \"header_row_count\": 1,\n        \"columns\": [\n          {\n            \"column_id\": \"col:item\",\n            \"order\": 0,\n            \"label\": \"要素\",\n            \"style_role\": \"header\"\n          },\n          {\n            \"column_id\": \"col:content\",\n            \"order\": 1,\n            \"label\": \"内容\",\n            \"style_role\": \"header\"\n          }\n        ],\n        \"rows\": [\n          {\n            \"row_id\": \"row:population\",\n            \"order\": 0,\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:population:item\",\n                \"row_id\": \"row:population\",\n                \"column_id\": \"col:item\",\n                \"text\": \"主要估计目标人群\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:population:content\",\n                \"row_id\": \"row:population\",\n                \"column_id\": \"col:content\",\n                \"text\": \"成人慢性鼻窦炎伴鼻息肉患者；允许稳定背景鼻用糖皮质激素并记录。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:analysis-set\",\n            \"order\": 1,\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:analysis-set:item\",\n                \"row_id\": \"row:analysis-set\",\n                \"column_id\": \"col:item\",\n                \"text\": \"主要分析集\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:analysis-set:content\",\n                \"row_id\": \"row:analysis-set\",\n                \"column_id\": \"col:content\",\n                \"text\": \"FAS（ITT原则），按随机分组进行分析。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:endpoint\",\n            \"order\": 2,\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:endpoint:item\",\n                \"row_id\": \"row:endpoint\",\n                \"column_id\": \"col:item\",\n                \"text\": \"主要终点/变量\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:endpoint:content\",\n                \"row_id\": \"row:endpoint\",\n                \"column_id\": \"col:content\",\n                \"text\": \"第24周临床缓解率：第24周达到双侧鼻息肉评分（NPS）≤1且鼻塞VAS≤1的受试者比例；变量为第24周临床缓解，定义为双侧鼻息肉评分（NPS）≤1且鼻塞VAS≤1。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:treatment-condition\",\n            \"order\": 3,\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:treatment-condition:item\",\n                \"row_id\": \"row:treatment-condition\",\n                \"column_id\": \"col:item\",\n                \"text\": \"治疗条件\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:treatment-condition:content\",\n                \"row_id\": \"row:treatment-condition\",\n                \"column_id\": \"col:content\",\n                \"text\": \"随机分配的治疗；合成药X 150 mg/1.0 mL皮下给药方案（负荷期第1、8、15、22天每周一次共4次；维持期第36天起每两周一次至第24周（末次给药））或安慰剂（生理盐水1.0 mL皮下注射，同体积同途径同频率）。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:method\",\n            \"order\": 4,\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:method:item\",\n                \"row_id\": \"row:method\",\n                \"column_id\": \"col:item\",\n                \"text\": \"主要分析方法\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:method:content\",\n                \"row_id\": \"row:method\",\n                \"column_id\": \"col:content\",\n                \"text\": \"按中心分层的CMH检验；双侧α=0.05；效应量为风险差及95%CI。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:effect-measure\",\n            \"order\": 5,\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:effect-measure:item\",\n                \"row_id\": \"row:effect-measure\",\n                \"column_id\": \"col:item\",\n                \"text\": \"主要比较/效应量\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:effect-measure:content\",\n                \"row_id\": \"row:effect-measure\",\n                \"column_id\": \"col:content\",\n                \"text\": \"合成药X组相对安慰剂组第24周临床缓解率的风险差；95%CI。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:ice\",\n            \"order\": 6,\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:ice:item\",\n                \"row_id\": \"row:ice\",\n                \"column_id\": \"col:item\",\n                \"text\": \"伴发事件策略\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:ice:content\",\n                \"row_id\": \"row:ice\",\n                \"column_id\": \"col:content\",\n                \"text\": \"ICE按治疗策略（treatment policy）处理。事件包括鼻塞加重需全身激素或手术干预、因不良事件停药、失访；救援治疗定义为因鼻塞加重使用全身激素或鼻窦手术。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:missing-data\",\n            \"order\": 7,\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:missing-data:item\",\n                \"row_id\": \"row:missing-data\",\n                \"column_id\": \"col:item\",\n                \"text\": \"缺失数据\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:missing-data:content\",\n                \"row_id\": \"row:missing-data\",\n                \"column_id\": \"col:content\",\n                \"text\": \"第24周缺失主要终点采用无应答插补（NRI）；敏感性分析采用tipping point。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:estimand-linkage\",\n            \"order\": 8,\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:estimand-linkage:item\",\n                \"row_id\": \"row:estimand-linkage\",\n                \"column_id\": \"col:item\",\n                \"text\": \"估计目标链接\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:estimand-linkage:content\",\n                \"row_id\": \"row:estimand-linkage\",\n                \"column_id\": \"col:content\",\n                \"text\": \"主要分析直接对应主要估计目标：人群为成人慢性鼻窦炎伴鼻息肉患者FAS（ITT），变量为第24周临床缓解，治疗条件为合成药X 150 mg/1.0 mL皮下给药方案 vs 安慰剂，汇总指标为第24周临床缓解率（比例）、风险差及95%CI，ICE按治疗策略处理。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:consistency\",\n            \"order\": 9,\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:consistency:item\",\n                \"row_id\": \"row:consistency\",\n                \"column_id\": \"col:item\",\n                \"text\": \"设计与SOA一致性\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:consistency:content\",\n                \"row_id\": \"row:consistency\",\n                \"column_id\": \"col:content\",\n                \"text\": \"主要终点在第24周评估，与SoA中第24周评估时点一致；末次给药至第24周；无期中分析。主要分析按随机分配的治疗组比较，不因实际接受剂量或救援治疗改变分组。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              }\n            ]\n          }\n        ],\n        \"notes\": [],\n        \"source_locator\": \"\",\n        \"version\": 0,\n        \"word_layout\": {}\n      }\n    },\n    {\n      \"block_id\": \"blk:v2-n-11-4-3-1:p003\",\n      \"kind\": \"paragraph\",\n      \"text\": \"伴发事件（ICE）按治疗策略（treatment policy）处理。ICE事件包括鼻塞加重需全身激素或手术干预、因不良事件停药和失访；救援治疗定义为因鼻塞加重使用全身激素或鼻窦手术。第24周缺失主要终点采用无应答插补（NRI）；敏感性分析采用tipping point。\",\n      \"source_locator\": \"\",\n      \"evidence_refs\": []\n    },\n    {\n      \"block_id\": \"blk:v2-n-11-4-3-1:p004\",\n      \"kind\": \"paragraph\",\n      \"text\": \"与设计和SoA一致性：主要终点在第24周评估，与SoA中第162天（第24周/末次给药）评估时点一致，该访视评估双侧鼻息肉评分（NPS）和鼻塞VAS；末次给药至第24周，无期中分析。主要分析按随机分配的治疗组比较，合成药X组对应150 mg/1.0 mL皮下给药方案，安慰剂组对应生理盐水1.0 mL同途径同频率；不因实际接受剂量或救援治疗改变分组。上述方法、终点、分析集、剂量和SoA事实保持一致。\",\n      \"source_locator\": \"\",\n      \"evidence_refs\": []\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"b523ea08d6bb4b179280cf85d67346d97390383e72923000f6f8c9c116a0b5cc"}],"logical_call_id":"call:chapter-draft:2c0a4cb9bad1958e8b16b5899290301e921030382bac3737ea7a2a73969ac677:chapter-generate","node_execution_contract_id":"nec:chapter-draft:2c0a4cb9bad1958e8b16b5899290301e921030382bac3737ea7a2a73969ac677:chapter-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/ordered-chapter-draft-candidate.v1.json","output_sha256":"f496ed8d4ef69e16ac871da550dae854f0c74c8d983f32353a37192b4f10ab42","prompt_sha256":"47dd66c834319411962b91127cd952207cccdab4dee7068a9ab81409e5aefa1e","provider_session_id":"9d601e8c-ba04-4793-becb-8e4207b2dd10","requested_reasoning_effort":"max"},"schema":"model_response.v1"}