{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-6-4-3:v2\",\n  \"node_id\": \"v2_n_6_4_3\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"block_id\": \"block:v2_n_6_4_3:p1\",\n      \"kind\": \"paragraph\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\",\n      \"text\": \"本节说明因鼻塞加重所需补救治疗的允许条件、启动时点、记录要求、随访衔接及其与估计目标和分析策略的一致性。补救治疗策略应为项目特定，并应可追溯至源文件和CRF（case report form，病例报告表）。\"\n    },\n    {\n      \"block_id\": \"block:v2_n_6_4_3:p2\",\n      \"kind\": \"paragraph\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\",\n      \"text\": \"因鼻塞加重允许使用全身激素或进行鼻窦手术。补救治疗应由研究者判断，在鼻塞加重需要全身激素或手术干预时使用；具体药物、剂量、疗程或手术方式按临床常规执行并记录。补救治疗可在研究期间至第24周主要终点评估前，如发生因鼻塞加重的临床需要时随时给予，不得预防性使用。\"\n    },\n    {\n      \"block_id\": \"block:v2_n_6_4_3:table:rescue-plan\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [],\n      \"table\": {\n        \"table_id\": \"table:v2_n_6_4_3:rescue-plan\",\n        \"block_id\": \"block:v2_n_6_4_3:table:rescue-plan\",\n        \"title\": \"表 6-4-3-1 补救治疗项目特定要求\",\n        \"domain\": \"generic\",\n        \"role\": \"body_content\",\n        \"header_row_count\": 1,\n        \"review_state\": \"ai_draft\",\n        \"version\": 0,\n        \"schema_version\": \"structured_table_v1\",\n        \"source_locator\": \"\",\n        \"columns\": [\n          {\n            \"column_id\": \"col:item\",\n            \"label\": \"项目\",\n            \"order\": 0,\n            \"semantic_role\": \"row_label\",\n            \"style_role\": \"header\"\n          },\n          {\n            \"column_id\": \"col:spec\",\n            \"label\": \"项目特定要求\",\n            \"order\": 1,\n            \"semantic_role\": \"specification\",\n            \"style_role\": \"header\"\n          }\n        ],\n        \"rows\": [\n          {\n            \"row_id\": \"row:header\",\n            \"order\": 0,\n            \"label\": \"\",\n            \"style_role\": \"header\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:header:item\",\n                \"row_id\": \"row:header\",\n                \"column_id\": \"col:item\",\n                \"text\": \"项目\",\n                \"style_role\": \"header\",\n                \"provenance_lineage\": []\n              },\n              {\n                \"cell_id\": \"cell:header:spec\",\n                \"row_id\": \"row:header\",\n                \"column_id\": \"col:spec\",\n                \"text\": \"项目特定要求\",\n                \"style_role\": \"header\",\n                \"provenance_lineage\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:rescue_plan\",\n            \"order\": 1,\n            \"label\": \"总体补救治疗策略\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:rescue_plan:item\",\n                \"row_id\": \"row:rescue_plan\",\n                \"column_id\": \"col:item\",\n                \"text\": \"总体补救治疗策略\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": []\n              },\n              {\n                \"cell_id\": \"intervention:cell:rescue_plan\",\n                \"row_id\": \"row:rescue_plan\",\n                \"column_id\": \"col:spec\",\n                \"text\": \"因鼻塞加重允许使用全身激素或进行鼻窦手术；具体药物、剂量、疗程或手术方式按临床常规并记录。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:permitted\",\n            \"order\": 2,\n            \"label\": \"允许条件与定义\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:permitted:item\",\n                \"row_id\": \"row:permitted\",\n                \"column_id\": \"col:item\",\n                \"text\": \"允许条件与定义\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": []\n              },\n              {\n                \"cell_id\": \"cell:permitted:spec\",\n                \"row_id\": \"row:permitted\",\n                \"column_id\": \"col:spec\",\n                \"text\": \"由研究者判断鼻塞加重需要全身激素或手术干预时使用；补救治疗定义为因鼻塞加重允许使用全身激素或进行鼻窦手术。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:timing\",\n            \"order\": 3,\n            \"label\": \"启动时点与记录时点\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:timing:item\",\n                \"row_id\": \"row:timing\",\n                \"column_id\": \"col:item\",\n                \"text\": \"启动时点与记录时点\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": []\n              },\n              {\n                \"cell_id\": \"cell:timing:spec\",\n                \"row_id\": \"row:timing\",\n                \"column_id\": \"col:spec\",\n                \"text\": \"研究期间至第24周主要终点评估前，如发生因鼻塞加重的临床需要，可随时给予；不得预防性使用。补救治疗日期、原因和方案需在发生时及时记录。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:records\",\n            \"order\": 4,\n            \"label\": \"记录要求\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:records:item\",\n                \"row_id\": \"row:records\",\n                \"column_id\": \"col:item\",\n                \"text\": \"记录要求\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": []\n              },\n              {\n                \"cell_id\": \"cell:records:spec\",\n                \"row_id\": \"row:records\",\n                \"column_id\": \"col:spec\",\n                \"text\": \"记录于源文件和CRF（case report form，病例报告表）。至少记录：试验参与者随机号；补救治疗日期；鼻塞加重表现/严重程度；补救治疗类型（全身激素或鼻窦手术）；药物名称、剂量、途径、疗程或手术名称/日期；使用原因与研究者判断；是否满足ICE定义；后续转归和是否恢复研究干预。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:followup\",\n            \"order\": 5,\n            \"label\": \"随访衔接\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:followup:item\",\n                \"row_id\": \"row:followup\",\n                \"column_id\": \"col:item\",\n                \"text\": \"随访衔接\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": []\n              },\n              {\n                \"cell_id\": \"cell:followup:spec\",\n                \"row_id\": \"row:followup\",\n                \"column_id\": \"col:spec\",\n                \"text\": \"使用补救治疗后继续按计划随访至第24周主要终点及后续安全性随访，不因补救治疗提前终止或删失。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:safety\",\n            \"order\": 6,\n            \"label\": \"安全性记录\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:safety:item\",\n                \"row_id\": \"row:safety\",\n                \"column_id\": \"col:item\",\n                \"text\": \"安全性记录\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": []\n              },\n              {\n                \"cell_id\": \"cell:safety:spec\",\n                \"row_id\": \"row:safety\",\n                \"column_id\": \"col:spec\",\n                \"text\": \"记录AE（不良事件）/SAE（严重不良事件）并与补救治疗的关系。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:estimand\",\n            \"order\": 7,\n            \"label\": \"估计目标与分析策略一致性\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:estimand:item\",\n                \"row_id\": \"row:estimand\",\n                \"column_id\": \"col:item\",\n                \"text\": \"估计目标与分析策略一致性\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": []\n              },\n              {\n                \"cell_id\": \"cell:estimand:spec\",\n                \"row_id\": \"row:estimand\",\n                \"column_id\": \"col:spec\",\n                \"text\": \"ICE（intercurrent event，伴发事件）按治疗策略处理；因鼻塞加重需要全身激素或手术干预属于ICE事件，但不剔除试验参与者，继续按随机分组纳入主要分析。主要估计目标反映在治疗策略下，无论是否使用补救治疗，干预对第24周临床缓解率的效应。第24周主要终点缺失采用NRI（non-responder imputation，非应答者归因）；敏感性分析采用tipping point（临界点分析）。主要分析继续纳入FAS（full analysis set，全分析集）。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:prohibition\",\n            \"order\": 8,\n            \"label\": \"禁止性说明\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:prohibition:item\",\n                \"row_id\": \"row:prohibition\",\n                \"column_id\": \"col:item\",\n                \"text\": \"禁止性说明\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": []\n              },\n              {\n                \"cell_id\": \"cell:prohibition:spec\",\n                \"row_id\": \"row:prohibition\",\n                \"column_id\": \"col:spec\",\n                \"text\": \"不得将补救治疗视为未处理或据此推断非劣或优效；不得使用与估计目标或分析策略不一致的补救处理描述。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": []\n              }\n            ]\n          }\n        ],\n        \"notes\": []\n      }\n    },\n    {\n      \"block_id\": \"block:v2_n_6_4_3:p3\",\n      \"kind\": \"paragraph\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\",\n      \"text\": \"使用补救治疗后，试验参与者应继续按计划随访至第24周主要终点及后续安全性随访，不因补救治疗提前终止或删失。应记录AE（不良事件）/SAE（严重不良事件）并与补救治疗的关系。\"\n    },\n    {\n      \"block_id\": \"block:v2_n_6_4_3:p4\",\n      \"kind\": \"paragraph\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\",\n      \"text\": \"与估计目标和分析策略的一致性应按下述原则处理：ICE（intercurrent event，伴发事件）按治疗策略处理；因鼻塞加重需要全身激素或手术干预属于ICE事件，但不剔除试验参与者，继续按随机分组纳入主要分析。主要估计目标反映在治疗策略下，无论是否使用补救治疗，干预对第24周临床缓解率的效应。第24周主要终点缺失采用NRI（non-responder imputation，非应答者归因）；敏感性分析采用tipping point（临界点分析）。主要分析应继续纳入FAS（full analysis set，全分析集）。\"\n    },\n    {\n      \"block_id\": \"block:v2_n_6_4_3:p5\",\n      \"kind\": \"paragraph\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\",\n      \"text\": \"补救治疗的处理不得与上述估计目标和分析策略不一致，也不得将补救治疗视为未处理或据此推断非劣或优效。\"\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"4fd0b657a056c3828afbd6f4090be4dfa95ce616b1f6b821456cb73244e2161f"}],"logical_call_id":"call:chapter-draft:8765e46e22b14604fb12e43852cb6664492f1b5f07336916288b7f39229f0ce8:chapter-generate","node_execution_contract_id":"nec:chapter-draft:8765e46e22b14604fb12e43852cb6664492f1b5f07336916288b7f39229f0ce8:chapter-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/ordered-chapter-draft-candidate.v1.json","output_sha256":"446ce96409952bd75e475809389ac4f550bd824bd0ac1e704af2fb85abda5bf6","prompt_sha256":"9aec0ea7a8d8361fdb1c273790e20e30d5e6b1d7680ac1c6c63436bd71300fac","provider_session_id":"75a18fd3-d9aa-416f-b90c-15d51ac988df","requested_reasoning_effort":"max"},"schema":"model_response.v1"}