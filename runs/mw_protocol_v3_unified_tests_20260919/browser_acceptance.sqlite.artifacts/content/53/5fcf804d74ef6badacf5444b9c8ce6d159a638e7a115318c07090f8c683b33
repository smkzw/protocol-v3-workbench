{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-4-4:v2\",\n  \"node_id\": \"v2_n_4_4\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"block_id\": \"block:v2_n_4_4:paragraph:epoch-closure-overview\",\n      \"kind\": \"paragraph\",\n      \"text\": \"本试验的研究阶段包括负荷给药期（第1天至第22天；第1、8、15、22天给药）、维持给药期（第36天起至第24周，末次给药）以及第24周主要和次要终点评估。研究完成、随访、治疗后评估与总体研究结束应分别定义；试验参与者完成、随访窗口和总体研究结束不得合并为含糊的“末次访视”。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"block:v2_n_4_4:table:study-end-definitions\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [],\n      \"table\": {\n        \"table_id\": \"table:v2_n_4_4:study-end-definitions\",\n        \"block_id\": \"block:v2_n_4_4:table:study-end-definitions\",\n        \"title\": \"研究完成、随访窗口、治疗后评估与总体研究结束定义\",\n        \"domain\": \"generic\",\n        \"role\": \"body_content\",\n        \"review_state\": \"ai_draft\",\n        \"version\": 0,\n        \"schema_version\": \"structured_table_v1\",\n        \"source_locator\": \"\",\n        \"header_row_count\": 1,\n        \"columns\": [\n          {\n            \"column_id\": \"item\",\n            \"label\": \"结构要素\",\n            \"order\": 0,\n            \"semantic_role\": \"row_label\",\n            \"style_role\": \"header\",\n            \"source_locator\": \"\"\n          },\n          {\n            \"column_id\": \"definition\",\n            \"label\": \"项目化定义\",\n            \"order\": 1,\n            \"semantic_role\": \"definition\",\n            \"style_role\": \"header\",\n            \"source_locator\": \"\"\n          },\n          {\n            \"column_id\": \"timing\",\n            \"label\": \"时间窗/触发\",\n            \"order\": 2,\n            \"semantic_role\": \"timing\",\n            \"style_role\": \"header\",\n            \"source_locator\": \"\"\n          },\n          {\n            \"column_id\": \"assessment\",\n            \"label\": \"评估或收集要求\",\n            \"order\": 3,\n            \"semantic_role\": \"assessment\",\n            \"style_role\": \"header\",\n            \"source_locator\": \"\"\n          }\n        ],\n        \"rows\": [\n          {\n            \"row_id\": \"row:v2_n_4_4:header\",\n            \"order\": 0,\n            \"label\": \"表头\",\n            \"style_role\": \"header\",\n            \"source_locator\": \"\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:v2_n_4_4:header:item\",\n                \"row_id\": \"row:v2_n_4_4:header\",\n                \"column_id\": \"item\",\n                \"text\": \"结构要素\",\n                \"style_role\": \"header\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_4_4:header:definition\",\n                \"row_id\": \"row:v2_n_4_4:header\",\n                \"column_id\": \"definition\",\n                \"text\": \"项目化定义\",\n                \"style_role\": \"header\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_4_4:header:timing\",\n                \"row_id\": \"row:v2_n_4_4:header\",\n                \"column_id\": \"timing\",\n                \"text\": \"时间窗/触发\",\n                \"style_role\": \"header\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_4_4:header:assessment\",\n                \"row_id\": \"row:v2_n_4_4:header\",\n                \"column_id\": \"assessment\",\n                \"text\": \"评估或收集要求\",\n                \"style_role\": \"header\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:v2_n_4_4:participant-completion\",\n            \"order\": 1,\n            \"label\": \"试验参与者完成\",\n            \"style_role\": \"body\",\n            \"source_locator\": \"\",\n            \"cells\": [\n              {\n                \"cell_id\": \"end:participant-completion\",\n                \"row_id\": \"row:v2_n_4_4:participant-completion\",\n                \"column_id\": \"item\",\n                \"text\": \"试验参与者完成\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_4_4:participant-completion:definition\",\n                \"row_id\": \"row:v2_n_4_4:participant-completion\",\n                \"column_id\": \"definition\",\n                \"text\": \"试验参与者完成至第24周的所有方案规定给药和评估，包括第24周末次给药及主要/次要终点评估。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_4_4:participant-completion:timing\",\n                \"row_id\": \"row:v2_n_4_4:participant-completion\",\n                \"column_id\": \"timing\",\n                \"text\": \"第24周；末次给药及主要/次要终点评估时点。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_4_4:participant-completion:assessment\",\n                \"row_id\": \"row:v2_n_4_4:participant-completion\",\n                \"column_id\": \"assessment\",\n                \"text\": \"第24周完成主要终点和次要终点评估；主要终点为第24周临床缓解率，关键次要终点为SNOT-22（22项鼻腔鼻窦结局测试）较基线变化，Lund-Kennedy内镜评分为描述性分析。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:v2_n_4_4:follow-up-window\",\n            \"order\": 2,\n            \"label\": \"随访定义与窗口\",\n            \"style_role\": \"body\",\n            \"source_locator\": \"\",\n            \"cells\": [\n              {\n                \"cell_id\": \"end:follow-up-window\",\n                \"row_id\": \"row:v2_n_4_4:follow-up-window\",\n                \"column_id\": \"item\",\n                \"text\": \"随访定义与窗口\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_4_4:follow-up-window:definition\",\n                \"row_id\": \"row:v2_n_4_4:follow-up-window\",\n                \"column_id\": \"definition\",\n                \"text\": \"随访期自第24周末次给药/主要终点评估后开始，至末次随访/研究结束；用于安全性随访和结局确认。AE（不良事件）和SAE（严重不良事件）收集至末次给药后30天；若试验参与者提前终止试验，则收集至提前终止访视后30天。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_4_4:follow-up-window:timing\",\n                \"row_id\": \"row:v2_n_4_4:follow-up-window\",\n                \"column_id\": \"timing\",\n                \"text\": \"随访访视按方案预定时间窗执行；第24周为主要终点评估访视，应尽量在计划时间窗内完成主要和次要终点评估。所有访视应记录实际日期并计算与计划日期的偏差。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_4_4:follow-up-window:assessment\",\n                \"row_id\": \"row:v2_n_4_4:follow-up-window\",\n                \"column_id\": \"assessment\",\n                \"text\": \"继续收集AE、SAE、合并用药、背景治疗和补救治疗，并随访已发生事件至稳定或恢复。若试验参与者无法现场访视，可按方案允许的方式联系并记录，但电话访视不得替代第24周主要终点所需的NPS（鼻息肉评分）和鼻塞VAS（视觉模拟量表）评估。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:v2_n_4_4:overall-study-end\",\n            \"order\": 3,\n            \"label\": \"总体研究结束\",\n            \"style_role\": \"body\",\n            \"source_locator\": \"\",\n            \"cells\": [\n              {\n                \"cell_id\": \"end:overall-study\",\n                \"row_id\": \"row:v2_n_4_4:overall-study-end\",\n                \"column_id\": \"item\",\n                \"text\": \"总体研究结束\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_4_4:overall-study:definition\",\n                \"row_id\": \"row:v2_n_4_4:overall-study-end\",\n                \"column_id\": \"definition\",\n                \"text\": \"总体研究结束定义为所有试验参与者完成第24周评估，且数据清理、锁定和统计分析完成。总体研究结束不等同于治疗结束或单纯末次访视。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_4_4:overall-study:timing\",\n                \"row_id\": \"row:v2_n_4_4:overall-study-end\",\n                \"column_id\": \"timing\",\n                \"text\": \"末例试验参与者完成第24周末次评估后触发研究结束流程。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_4_4:overall-study:assessment\",\n                \"row_id\": \"row:v2_n_4_4:overall-study-end\",\n                \"column_id\": \"assessment\",\n                \"text\": \"数据清理、锁定和统计分析完成后方可判定总体研究结束。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:v2_n_4_4:post-treatment\",\n            \"order\": 4,\n            \"label\": \"治疗后评估\",\n            \"style_role\": \"body\",\n            \"source_locator\": \"\",\n            \"cells\": [\n              {\n                \"cell_id\": \"end:post-treatment-assessment\",\n                \"row_id\": \"row:v2_n_4_4:post-treatment\",\n                \"column_id\": \"item\",\n                \"text\": \"治疗后评估\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_4_4:post-treatment:definition\",\n                \"row_id\": \"row:v2_n_4_4:post-treatment\",\n                \"column_id\": \"definition\",\n                \"text\": \"治疗后评估在第24周末次给药/主要终点评估后开始，至末次随访/研究结束。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_4_4:post-treatment:timing\",\n                \"row_id\": \"row:v2_n_4_4:post-treatment\",\n                \"column_id\": \"timing\",\n                \"text\": \"第24周末次给药/主要终点评估后至末次随访/研究结束；AE/SAE收集至末次给药后30天。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:v2_n_4_4:post-treatment:assessment\",\n                \"row_id\": \"row:v2_n_4_4:post-treatment\",\n                \"column_id\": \"assessment\",\n                \"text\": \"评估和收集包括AE、SAE、合并用药、背景治疗和补救治疗、生命体征和临床安全性评估、已发生事件的转归。安全性随访按治疗期访视及末次给药后第24周评估进行；如发生AE，应随访至事件消退或稳定。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          }\n        ],\n        \"notes\": [\n          {\n            \"note_id\": \"note:v2_n_4_4:abbreviations\",\n            \"note_type\": \"definition\",\n            \"text\": \"AE=不良事件；SAE=严重不良事件；NPS=鼻息肉评分；VAS=视觉模拟量表；SNOT-22=22项鼻腔鼻窦结局测试。\",\n            \"target_ids\": [\n              \"end:participant-completion\",\n              \"cell:v2_n_4_4:participant-completion:assessment\",\n              \"end:follow-up-window\",\n              \"cell:v2_n_4_4:follow-up-window:definition\",\n              \"cell:v2_n_4_4:follow-up-window:assessment\",\n              \"end:post-treatment-assessment\",\n              \"cell:v2_n_4_4:post-treatment:assessment\"\n            ],\n            \"source_refs\": [],\n            \"marker\": \"*\",\n            \"association_reason\": \"统一缩略语定义。\",\n            \"review_status\": \"confirmed\",\n            \"project_override\": false\n          },\n          {\n            \"note_id\": \"note:v2_n_4_4:overall-end\",\n            \"note_type\": \"definition\",\n            \"text\": \"总体研究结束以所有试验参与者完成第24周评估且数据清理、锁定和统计分析完成为准，不以治疗结束或末次访视替代。\",\n            \"target_ids\": [\n              \"end:overall-study\",\n              \"cell:v2_n_4_4:overall-study:definition\",\n              \"cell:v2_n_4_4:overall-study:timing\"\n            ],\n            \"source_refs\": [],\n            \"association_reason\": \"明确总体研究结束边界。\",\n            \"review_status\": \"confirmed\",\n            \"project_override\": false\n          },\n          {\n            \"note_id\": \"note:v2_n_4_4:ae-window\",\n            \"note_type\": \"timing_rule\",\n            \"text\": \"AE/SAE收集至末次给药后30天；若试验参与者提前终止试验，则至提前终止访视后30天。\",\n            \"target_ids\": [\n              \"end:follow-up-window\",\n              \"end:post-treatment-assessment\",\n              \"cell:v2_n_4_4:follow-up-window:definition\",\n              \"cell:v2_n_4_4:post-treatment:timing\"\n            ],\n            \"source_refs\": [],\n            \"association_reason\": \"保留安全性随访时间窗。\",\n            \"review_status\": \"confirmed\",\n            \"project_override\": false\n          }\n        ],\n        \"word_layout\": {}\n      }\n    },\n    {\n      \"block_id\": \"block:v2_n_4_4:paragraph:operational-closure\",\n      \"kind\": \"paragraph\",\n      \"text\": \"在操作层面，第24周为主要终点和次要终点评估时点；随访期应自第24周末次给药/主要终点评估后开始，至末次随访/研究结束；治疗后评估应在第24周末次给药/主要终点评估后继续实施。AE和SAE应收集至末次给药后30天；若试验参与者提前终止试验，则应收集至提前终止访视后30天。末例试验参与者完成第24周末次评估后应触发研究结束流程；总体研究结束应以所有试验参与者完成第24周评估且数据清理、锁定和统计分析完成为准。若试验参与者无法现场访视，可按方案允许的方式联系并记录，但电话访视不得替代第24周主要终点所需的NPS和鼻塞VAS评估。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"9603d86fac1a9289c5afe5c579e8ab1b3b9f7714ef6b6694c155423d72e06ff1"}],"logical_call_id":"call:chapter-draft:a31a77b5cae7cbf453c5852ce153c09dfc6fd34dddd05af4959d4bb8998b2f1a:chapter-generate","node_execution_contract_id":"nec:chapter-draft:a31a77b5cae7cbf453c5852ce153c09dfc6fd34dddd05af4959d4bb8998b2f1a:chapter-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/ordered-chapter-draft-candidate.v1.json","output_sha256":"750b655ee52a39f4ef6c526a33912b2578e0d400f4e03acf7d9f4b4fc95455d3","prompt_sha256":"9aec0ea7a8d8361fdb1c273790e20e30d5e6b1d7680ac1c6c63436bd71300fac","provider_session_id":"93953643-fa4e-4876-9487-e50b81c3824b","requested_reasoning_effort":"max"},"schema":"model_response.v1"}