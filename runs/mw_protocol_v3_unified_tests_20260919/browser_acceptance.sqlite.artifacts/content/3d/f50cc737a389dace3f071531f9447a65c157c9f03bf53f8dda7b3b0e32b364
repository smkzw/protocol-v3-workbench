y\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:hypothesis:dimension\",\n                \"row_id\": \"row:hypothesis\",\n                \"column_id\": \"col:dimension\",\n                \"text\": \"研究假设\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:hypothesis:fact\",\n                \"row_id\": \"row:hypothesis\",\n                \"column_id\": \"col:fact\",\n                \"text\": \"H1：合成药X组第24周临床缓解率高于安慰剂组；H0：两组第24周临床缓解率无差异；主要分析为按中心分层的CMH检验，报告风险差及95%CI，双侧α=0.05；预期安慰剂组20%、试验组35%，绝对差15个百分点；把握度90%；无期中分析。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"rationale:hypothesis\",\n                \"row_id\": \"row:hypothesis\",\n                \"column_id\": \"col:rationale\",\n                \"text\": \"优效性假设、主要分析、预期效应和把握度一致；第24周缺失主要终点采用NRI，敏感性分析采用tipping point；关键次要终点SNOT-22采用固定序列检验控制多重性，Lund-Kennedy为描述性分析。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"rationale\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:evidence-floor\",\n            \"order\": 3,\n            \"label\": \"证据底线\",\n            \"source_locator\": \"\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:evidence-floor:dimension\",\n                \"row_id\": \"row:evidence-floor\",\n                \"column_id\": \"col:dimension\",\n                \"text\": \"证据底线\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"cell:evidence-floor:fact\",\n                \"row_id\": \"row:evidence-floor\",\n                \"column_id\": \"col:fact\",\n                \"text\": \"不适用；本研究为安慰剂对照优效性设计，未采用非劣效性检验，不设定非劣效性界值或历史证据底线。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"body\"\n              },\n              {\n                \"cell_id\": \"rationale:evidence-floor\",\n                \"row_id\": \"row:evidence-floor\",\n                \"column_id\": \"col:rationale\",\n                \"text\": \"因非劣效性不适用，不应引入非劣效界值或将历史证据底线写成当前研究参数。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\",\n                \"style_role\": \"rationale\"\n              }\n            ]\n          }\n        ],\n        \"notes\": []\n      }\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"83d3d2bb10280f7662f179415682c76d6d46bc4370dfed47b885cb6902925720"}],"logical_call_id":"call:chapter-draft:16be63309b25e1eed4baa645b31ace049080722777577b52a3dc7435d7444f3f:chapter-generate","node_execution_contract_id":"nec:chapter-draft:16be63309b25e1eed4baa645b31ace049080722777577b52a3dc7435d7444f3f:chapter-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/ordered-chapter-draft-candidate.v1.json","output_sha256":"6f26346809010bc334066936095f7b82f23b83e8ec81f192cfbff3691d3bccc5","prompt_sha256":"9aec0ea7a8d8361fdb1c273790e20e30d5e6b1d7680ac1c6c63436bd71300fac","provider_session_id":"4dc15b76-2c56-49b3-9e58-169f6b99c9a2","requested_reasoning_effort":"max"},"schema":"model_response.v1"}