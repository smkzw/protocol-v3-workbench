{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-1-1:v2\",\n  \"node_id\": \"v2_n_1_1\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"block_id\": \"block:v2_n_1_1:synopsis-table\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [],\n      \"table\": {\n        \"table_id\": \"synopsis:table:242\",\n        \"block_id\": \"block:v2_n_1_1:synopsis-table\",\n        \"title\": \"方案汇总表\",\n        \"domain\": \"generic\",\n        \"role\": \"protocol_synopsis\",\n        \"header_row_count\": 0,\n        \"review_state\": \"ai_draft\",\n        \"schema_version\": \"structured_table_v1\",\n        \"version\": 0,\n        \"source_locator\": \"\",\n        \"columns\": [\n          {\n            \"column_id\": \"synopsis:col:item\",\n            \"label\": \"项目\",\n            \"order\": 0,\n            \"semantic_role\": \"row_label\",\n            \"style_role\": \"label\",\n            \"width_twips\": null,\n            \"source_locator\": \"\"\n          },\n          {\n            \"column_id\": \"synopsis:col:value\",\n            \"label\": \"内容\",\n            \"order\": 1,\n            \"semantic_role\": \"value\",\n            \"style_role\": \"body\",\n            \"width_twips\": null,\n            \"source_locator\": \"\"\n          }\n        ],\n        \"rows\": [\n          {\n            \"row_id\": \"synopsis:row:protocol_id\",\n            \"order\": 0,\n            \"label\": \"编号\",\n            \"source_locator\": \"framing.protocol_id\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:protocol_id:label\",\n                \"row_id\": \"synopsis:row:protocol_id\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"编号\",\n                \"style_role\": \"label\",\n                \"source_locator\": \"\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:protocol_id\",\n                \"row_id\": \"synopsis:row:protocol_id\",\n                \"column_id\": \"synopsis:col:value\",\n                \"text\": \"PV3-69F53457\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"framing.protocol_id\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:title\",\n            \"order\": 1,\n            \"label\": \"标题\",\n            \"source_locator\": \"framing.document_title\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:title:label\",\n                \"row_id\": \"synopsis:row:title\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"标题\",\n                \"style_role\": \"label\",\n                \"source_locator\": \"\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:title\",\n                \"row_id\": \"synopsis:row:title\",\n                \"column_id\": \"synopsis:col:value\",\n                \"text\": \"合成药X治疗慢性鼻窦炎伴鼻息肉的Ⅱ期临床研究方案\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"framing.document_title\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:version_date\",\n            \"order\": 2,\n            \"label\": \"版本/日期\",\n            \"source_locator\": \"framing.version; document_control.version_date\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:version_date:label\",\n                \"row_id\": \"synopsis:row:version_date\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"版本/日期\",\n                \"style_role\": \"label\",\n                \"source_locator\": \"\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:version_date\",\n                \"row_id\": \"synopsis:row:version_date\",\n                \"column_id\": \"synopsis:col:value\",\n                \"text\": \"版本：1.0；日期：无修订日期；初始版本日期以方案定稿签署或批准日期记录。\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"framing.version; document_control.version_date\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:study_phase\",\n            \"order\": 3,\n            \"label\": \"期别\",\n            \"source_locator\": \"framing.study_phase\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:study_phase:label\",\n                \"row_id\": \"synopsis:row:study_phase\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"期别\",\n                \"style_role\": \"label\",\n                \"source_locator\": \"\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:study_phase\",\n                \"row_id\": \"synopsis:row:study_phase\",\n                \"column_id\": \"synopsis:col:value\",\n                \"text\": \"Ⅱ期\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"framing.study_phase\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:registration_classification\",\n            \"order\": 4,\n            \"label\": \"注册分类\",\n            \"source_locator\": \"synopsis.registration_classification\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:registration_classification:label\",\n                \"row_id\": \"synopsis:row:registration_classification\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"注册分类\",\n                \"style_role\": \"label\",\n                \"source_locator\": \"\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:registration_classification\",\n                \"row_id\": \"synopsis:row:registration_classification\",\n                \"column_id\": \"synopsis:col:value\",\n                \"text\": \"新药临床试验申请路径（注册类别以最终策略为准）\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"synopsis.registration_classification\",\n                \"provenance_lineage\": [],\n                \"note_refs\": [\n                  \"synopsis:note:registration-classification\"\n                ]\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:sponsor\",\n            \"order\": 5,\n            \"label\": \"申办者\",\n            \"source_locator\": \"synopsis.sponsor\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:sponsor:label\",\n                \"row_id\": \"synopsis:row:sponsor\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"申办者\",\n                \"style_role\": \"label\",\n                \"source_locator\": \"\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:sponsor\",\n                \"row_id\": \"synopsis:row:sponsor\",\n                \"column_id\": \"synopsis:col:value\",\n                \"text\": \"申办者负责发起、管理和资助本试验，确保试验按照已批准方案、GCP和适用法规实施；负责提供试验用药品、标签、运输和销毁授权，并监督药物管理符合方案、GCP和适用法规；建立并维护质量体系，确保试验质量和数据可靠性。安全性报告：申办者药物警戒部门负责SUSAR和其他潜在严重安全性风险的识别、评估和报告。补偿：试验相关损害由申办方依法承担赔偿责任并提供相应补偿；申办方为本试验购买临床试验责任保险。代表角色：申办方代表。\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"synopsis.sponsor\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:principal_investigator\",\n            \"order\": 6,\n            \"label\": \"主要研究者\",\n            \"source_locator\": \"synopsis.principal_investigator\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:principal_investigator:label\",\n                \"row_id\": \"synopsis:row:principal_investigator\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"主要研究者\",\n                \"style_role\": \"label\",\n                \"source_locator\": \"\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:principal_investigator\",\n                \"row_id\": \"synopsis:row:principal_investigator\",\n                \"column_id\": \"synopsis:col:value\",\n                \"text\": \"主要研究者：姓名与联系方式由研究中心确认后填写。\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"synopsis.principal_investigator\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:trial_institutions\",\n            \"order\": 7,\n            \"label\": \"试验机构\",\n            \"source_locator\": \"synopsis.trial_institutions\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:trial_institutions:label\",\n                \"row_id\": \"synopsis:row:trial_institutions\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"试验机构\",\n                \"style_role\": \"label\",\n                \"source_locator\": \"\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:trial_institutions\",\n                \"row_id\": \"synopsis:row:trial_institutions\",\n                \"column_id\": \"synopsis:col:value\",\n                \"text\": \"以获批研究中心列表为准。\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"synopsis.trial_institutions\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:objective_estimand_endpoint\",\n            \"order\": 8,\n            \"label\": \"目的/估计目标/终点\",\n            \"source_locator\": \"synopsis.design; synopsis.statistical_methods\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:objective_estimand_endpoint:label\",\n                \"row_id\": \"synopsis:row:objective_estimand_endpoint\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"目的/估计目标/终点\",\n                \"style_role\": \"label\",\n                \"source_locator\": \"\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:objective_estimand_endpoint\",\n                \"row_id\": \"synopsis:row:objective_estimand_endpoint\",\n                \"column_id\": \"synopsis:col:value\",\n                \"text\": \"见紧随其后的嵌套表“目的、估计目标、终点与分析策略嵌套表”。E9(R1)/M11适用性处置未在已确认事实中记录；本候选不推断。\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"synopsis.design; synopsis.statistical_methods\",\n                \"provenance_lineage\": [],\n                \"note_refs\": [\n                  \"synopsis:note:objective-estimand-linkage\"\n                ]\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:design\",\n            \"order\": 9,\n            \"label\": \"设计\",\n            \"source_locator\": \"synopsis.design\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:design:label\",\n                \"row_id\": \"synopsis:row:design\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"设计\",\n                \"style_role\": \"label\",\n                \"source_locator\": \"\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:design\",\n                \"row_id\": \"synopsis:row:design\",\n                \"column_id\": \"synopsis:col:value\",\n                \"text\": \"随机、双盲、安慰剂对照、优效性概念验证研究；Ⅱ期；随机1:1，按中心分层；合成药X组与安慰剂组；允许稳定背景鼻用激素并记录；适应症为成人慢性鼻窦炎伴鼻息肉；第1天至第24周（末次给药），第24周评估主要和次要终点；无期中分析；研究药物为合成药X；靶机制为IL-4Rα/IL-4Rα拮抗。\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"synopsis.design\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:population_eligibility\",\n            \"order\": 10,\n            \"label\": \"人群/入选标准\",\n            \"source_locator\": \"synopsis.population_eligibility\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:population_eligibility:label\",\n                \"row_id\": \"synopsis:row:population_eligibility\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"人群/入选标准\",\n                \"style_role\": \"label\",\n                \"source_locator\": \"\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:population_eligibility\",\n                \"row_id\": \"synopsis:row:population_eligibility\",\n                \"column_id\": \"synopsis:col:value\",\n                \"text\": \"目标人群：成人慢性鼻窦炎伴鼻息肉患者。入选标准（全部需满足）：年龄≥18岁的成人受试者；诊断为慢性鼻窦炎伴鼻息肉；允许稳定背景鼻用激素并记录。\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"synopsis.population_eligibility\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:drug\",\n            \"order\": 11,\n            \"label\": \"药物\",\n            \"source_locator\": \"synopsis.investigational_drug; synopsis.comparator_drug\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:drug:label\",\n                \"row_id\": \"synopsis:row:drug\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"药物\",\n                \"style_role\": \"label\",\n                \"source_locator\": \"\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:drug\",\n                \"row_id\": \"synopsis:row:drug\",\n                \"column_id\": \"synopsis:col:value\",\n                \"text\": \"研究药物：合成药X注射制剂；作用机制为IL-4Rα拮抗。对照药：生理盐水安慰剂1.0 mL皮下注射；负荷期第1、8、15、22天每周一次共4次，维持期第36天起每两周一次至第24周末次给药。\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"synopsis.investigational_drug; synopsis.comparator_drug\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:interventions\",\n            \"order\": 12,\n            \"label\": \"干预\",\n            \"source_locator\": \"synopsis.interventions\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:interventions:label\",\n                \"row_id\": \"synopsis:row:interventions\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"干预\",\n                \"style_role\": \"label\",\n                \"source_locator\": \"\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:interventions\",\n                \"row_id\": \"synopsis:row:interventions\",\n                \"column_id\": \"synopsis:col:value\",\n                \"text\": \"合成药X组：负荷给药期第1、8、15、22天，每周一次共4次，每次合成药X注射制剂150 mg/1.0 mL皮下给药；维持给药期第36天起每两周一次，每次150 mg/1.0 mL皮下给药至第24周（末次给药）。安慰剂组：负荷给药期第1、8、15、22天，每周一次共4次，每次生理盐水安慰剂1.0 mL皮下注射；维持给药期第36天起每两周一次，每次生理盐水安慰剂1.0 mL皮下注射至第24周（末次给药）。\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"synopsis.interventions\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:sample_size\",\n            \"order\": 13,\n            \"label\": \"样本量\",\n            \"source_locator\": \"synopsis.sample_size\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:sample_size:label\",\n                \"row_id\": \"synopsis:row:sample_size\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"样本量\",\n                \"style_role\": \"label\",\n                \"source_locator\": \"\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:sample_size\",\n                \"row_id\": \"synopsis:row:sample_size\",\n                \"column_id\": \"synopsis:col:value\",\n                \"text\": \"约404例（每组约202例）。假设：双侧α=0.05；把握度90%；随机1:1；安慰剂反应率20%；治疗反应率35%；脱落率8%。方法：两独立比例的正态近似；按中心分层的CMH检验，报告风险差及95%CI。\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"synopsis.sample_size\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:statistical_methods\",\n            \"order\": 14,\n            \"label\": \"统计分析\",\n            \"source_locator\": \"synopsis.statistical_methods\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:statistical_methods:label\",\n                \"row_id\": \"synopsis:row:statistical_methods\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"统计分析\",\n                \"style_role\": \"label\",\n                \"source_locator\": \"\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:statistical_methods\",\n                \"row_id\": \"synopsis:row:statistical_methods\",\n                \"column_id\": \"synopsis:col:value\",\n                \"text\": \"分析集：FAS（ITT原则），按随机分组。主要分析：按中心分层的CMH检验，报告风险差及95%CI。ICE：按治疗策略处理；ICE事件包括鼻塞加重需全身激素或手术干预、因不良事件停药、失访；救援治疗定义为因鼻塞加重使用全身激素或鼻窦手术。缺失数据：第24周缺失主要终点采用无应答插补（NRI），敏感性分析采用tipping point。多重性：关键次要终点SNOT-22采用固定序列检验控制多重性；Lund-Kennedy内镜评分为描述性分析。\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"synopsis.statistical_methods\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:overall_duration\",\n            \"order\": 15,\n            \"label\": \"总体周期\",\n            \"source_locator\": \"synopsis.overall_duration\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:overall_duration:label\",\n                \"row_id\": \"synopsis:row:overall_duration\",\n                \"column_id\": \"synopsis:col:item\",\n                \"text\": \"总体周期\",\n                \"style_role\": \"label\",\n                \"source_locator\": \"\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              },\n              {\n                \"cell_id\": \"synopsis:cell:overall_duration\",\n                \"row_id\": \"synopsis:row:overall_duration\",\n                \"column_id\": \"synopsis:col:value\",\n                \"text\": \"约24周治疗和评估期（第1天至第24周末次给药/主要终点评估）；总体研究结束以所有受试者完成第24周评估并完成数据清理、数据库锁定和统计分析为准。\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"synopsis.overall_duration\",\n                \"provenance_lineage\": [],\n                \"note_refs\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"synopsis:row:participation_duration\",\n            \"order\": 16,\n            \"label\": \"参与者访视时长\",\n            \"source_locator\": \"synopsis.participation_duration\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"synopsis:cell:participation_duration:label\",\n                \"row_id\": \"synopsis:row:participation_duration\",\n                \"column_id\": \