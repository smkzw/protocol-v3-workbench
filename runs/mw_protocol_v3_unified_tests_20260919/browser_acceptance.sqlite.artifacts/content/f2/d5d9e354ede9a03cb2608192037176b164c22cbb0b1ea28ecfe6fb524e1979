{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-4-1:v2\",\n  \"node_id\": \"v2_n_4_1\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"block_id\": \"blk:v2_n_4_1:p1\",\n      \"kind\": \"paragraph\",\n      \"text\": \"本章总体设计依据已确认的结构化项目事实描述：目标适应症为成人慢性鼻窦炎伴鼻息肉，研究药物为合成药X，作用机制涉及IL-4Rα和IL-4Rα拮抗。已确认设计为Ⅱ期、随机、双盲、安慰剂对照、优效性概念验证研究。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:v2_n_4_1:p2\",\n      \"kind\": \"paragraph\",\n      \"text\": \"试验参与者应按1:1随机分配至合成药X组或安慰剂组，随机分配方法为随机分配，随机化按中心分层。试验参与者和研究者对治疗分配应保持盲态；安慰剂应为生理盐水1.0 mL皮下注射，并与试验药保持同体积、同途径、同频率给药。研究期间允许使用稳定背景鼻用激素并应记录。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:v2_n_4_1:p3\",\n      \"kind\": \"paragraph\",\n      \"text\": \"合成药X组接受合成药X注射制剂150 mg/1.0 mL皮下给药：负荷期第1、8、15、22天每周一次共4次，维持期第36天起每两周一次至第24周末次给药。安慰剂组接受生理盐水安慰剂1.0 mL皮下注射，给药体积、途径和频率与合成药X组一致。研究治疗期为第1天至第24周（末次给药），主要和次要终点均应在第24周评估。本方案未设置期中分析。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:v2_n_4_1:p4\",\n      \"kind\": \"paragraph\",\n      \"text\": \"主要假设为：无效假设是第24周临床缓解率在合成药X组与安慰剂组间无差异；备择假设是合成药X组第24周临床缓解率高于安慰剂组。主要分析应采用按中心分层的CMH=Cochran-Mantel-Haenszel检验，报告风险差及95%CI=置信区间，检验水准为双侧α=0.05。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:v2_n_4_1:p5\",\n      \"kind\": \"paragraph\",\n      \"text\": \"已确认存在按中心分层的设计：分层因素为中心，随机化比例为1:1。已确认本方案设计包含子研究；子研究的具体设计、流程、终点和统计方法应依据经确认的子研究方案及相应章节执行，本总体设计章节不新增未确认参数。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:v2_n_4_1:table:overall-design\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [],\n      \"table\": {\n        \"table_id\": \"tbl:v2_n_4_1:overall-design\",\n        \"block_id\": \"blk:v2_n_4_1:table:overall-design\",\n        \"title\": \"总体设计结构化要素\",\n        \"role\": \"body_content\",\n        \"domain\": \"generic\",\n        \"header_row_count\": 1,\n        \"columns\": [\n          {\n            \"column_id\": \"col.item\",\n            \"label\": \"设计要素\",\n            \"order\": 0,\n            \"semantic_role\": \"row_label\",\n            \"style_role\": \"body\"\n          },\n          {\n            \"column_id\": \"col.value\",\n            \"label\": \"已确认内容\",\n            \"order\": 1,\n            \"semantic_role\": \"value\",\n            \"style_role\": \"body\"\n          }\n        ],\n        \"rows\": [\n          {\n            \"row_id\": \"row.hypothesis\",\n            \"order\": 0,\n            \"label\": \"假设\",\n            \"cells\": [\n              {\n                \"cell_id\": \"label.design.hypothesis\",\n                \"row_id\": \"row.hypothesis\",\n                \"column_id\": \"col.item\",\n                \"text\": \"假设\"\n              },\n              {\n                \"cell_id\": \"design:hypothesis\",\n                \"row_id\": \"row.hypothesis\",\n                \"column_id\": \"col.value\",\n                \"text\": \"无效假设：第24周临床缓解率在合成药X组与安慰剂组间无差异。备择假设：合成药X组第24周临床缓解率高于安慰剂组。主要分析：按中心分层的CMH=Cochran-Mantel-Haenszel检验，报告风险差及95%CI=置信区间；双侧α=0.05。\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row.phase\",\n            \"order\": 1,\n            \"label\": \"期别\",\n            \"cells\": [\n              {\n                \"cell_id\": \"label.design.phase\",\n                \"row_id\": \"row.phase\",\n                \"column_id\": \"col.item\",\n                \"text\": \"期别\"\n              },\n              {\n                \"cell_id\": \"design:phase\",\n                \"row_id\": \"row.phase\",\n                \"column_id\": \"col.value\",\n                \"text\": \"Ⅱ期\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row.type\",\n            \"order\": 2,\n            \"label\": \"设计类型\",\n            \"cells\": [\n              {\n                \"cell_id\": \"label.design.type\",\n                \"row_id\": \"row.type\",\n                \"column_id\": \"col.item\",\n                \"text\": \"设计类型\"\n              },\n              {\n                \"cell_id\": \"design:type\",\n                \"row_id\": \"row.type\",\n                \"column_id\": \"col.value\",\n                \"text\": \"Ⅱ期、随机、双盲、安慰剂对照、优效性概念验证研究\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row.arms\",\n            \"order\": 3,\n            \"label\": \"组别与干预\",\n            \"cells\": [\n              {\n                \"cell_id\": \"label.design.arms\",\n                \"row_id\": \"row.arms\",\n                \"column_id\": \"col.item\",\n                \"text\": \"组别与干预\"\n              },\n              {\n                \"cell_id\": \"design:arms\",\n                \"row_id\": \"row.arms\",\n                \"column_id\": \"col.value\",\n                \"text\": \"合成药X组：合成药X注射制剂150 mg/1.0 mL皮下给药；负荷期第1、8、15、22天每周一次共4次，维持期第36天起每两周一次至第24周末次给药。安慰剂组：生理盐水安慰剂1.0 mL皮下注射；同体积、同途径、同频率给药。\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row.duration\",\n            \"order\": 4,\n            \"label\": \"研究周期与终点评估\",\n            \"cells\": [\n              {\n                \"cell_id\": \"label.design.duration\",\n                \"row_id\": \"row.duration\",\n                \"column_id\": \"col.item\",\n                \"text\": \"研究周期与终点评估\"\n              },\n              {\n                \"cell_id\": \"design:duration\",\n                \"row_id\": \"row.duration\",\n                \"column_id\": \"col.value\",\n                \"text\": \"第1天至第24周（末次给药）；第24周评估主要和次要终点。\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row.allocation\",\n            \"order\": 5,\n            \"label\": \"分配\",\n            \"cells\": [\n              {\n                \"cell_id\": \"label.design.allocation\",\n                \"row_id\": \"row.allocation\",\n                \"column_id\": \"col.item\",\n                \"text\": \"分配\"\n              },\n              {\n                \"cell_id\": \"design:allocation\",\n                \"row_id\": \"row.allocation\",\n                \"column_id\": \"col.value\",\n                \"text\": \"随机分配；随机化比例1:1；按中心分层。\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row.masking\",\n            \"order\": 6,\n            \"label\": \"盲法\",\n            \"cells\": [\n              {\n                \"cell_id\": \"label.design.masking\",\n                \"row_id\": \"row.masking\",\n                \"column_id\": \"col.item\",\n                \"text\": \"盲法\"\n              },\n              {\n                \"cell_id\": \"design:masking\",\n                \"row_id\": \"row.masking\",\n                \"column_id\": \"col.value\",\n                \"text\": \"双盲；试验参与者和研究者对治疗分配保持盲态；安慰剂为生理盐水1.0 mL，皮下注射，与试验药同体积、同途径、同频率。\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row.centers\",\n            \"order\": 7,\n            \"label\": \"中心\",\n            \"cells\": [\n              {\n                \"cell_id\": \"label.design.centers\",\n                \"row_id\": \"row.centers\",\n                \"column_id\": \"col.item\",\n                \"text\": \"中心\"\n              },\n              {\n                \"cell_id\": \"design:centers\",\n                \"row_id\": \"row.centers\",\n                \"column_id\": \"col.value\",\n                \"text\": \"按中心分层；已确认结构化事实未提供中心数量。\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row.stratification\",\n            \"order\": 8,\n            \"label\": \"分层\",\n            \"cells\": [\n              {\n                \"cell_id\": \"label.design.stratification\",\n                \"row_id\": \"row.stratification\",\n                \"column_id\": \"col.item\",\n                \"text\": \"分层\"\n              },\n              {\n                \"cell_id\": \"design:stratification\",\n                \"row_id\": \"row.stratification\",\n                \"column_id\": \"col.value\",\n                \"text\": \"适用；分层因素为中心；试验参与者按1:1随机分配至合成药X组或安慰剂组，随机化按中心分层；主要分析采用按中心分层的CMH=Cochran-Mantel-Haenszel检验并报告风险差及95%CI=置信区间。\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row.substudy\",\n            \"order\": 9,\n            \"label\": \"子研究\",\n            \"cells\": [\n              {\n                \"cell_id\": \"label.design.substudy\",\n                \"row_id\": \"row.substudy\",\n                \"column_id\": \"col.item\",\n                \"text\": \"子研究\"\n              },\n              {\n                \"cell_id\": \"design:substudy\",\n                \"row_id\": \"row.substudy\",\n                \"column_id\": \"col.value\",\n                \"text\": \"适用；本方案设计包含子研究。子研究的具体设计、流程、终点和统计方法应依据经确认的子研究方案及相应章节执行，本总体设计章节不新增未确认参数。\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row.background-therapy\",\n            \"order\": 10,\n            \"label\": \"背景治疗\",\n            \"cells\": [\n              {\n                \"cell_id\": \"label.design.background_therapy\",\n                \"row_id\": \"row.background-therapy\",\n                \"column_id\": \"col.item\",\n                \"text\": \"背景治疗\"\n              },\n              {\n                \"cell_id\": \"design:background_therapy\",\n                \"row_id\": \"row.background-therapy\",\n                \"column_id\": \"col.value\",\n                \"text\": \"允许使用稳定背景鼻用激素并记录。\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row.interim-analysis\",\n            \"order\": 11,\n            \"label\": \"期中分析\",\n            \"cells\": [\n              {\n                \"cell_id\": \"label.design.interim_analysis\",\n                \"row_id\": \"row.interim-analysis\",\n                \"column_id\": \"col.item\",\n                \"text\": \"期中分析\"\n              },\n              {\n                \"cell_id\": \"design:interim_analysis\",\n                \"row_id\": \"row.interim-analysis\",\n                \"column_id\": \"col.value\",\n                \"text\": \"无。\"\n              }\n            ]\n          }\n        ]\n      }\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"52619a9b711d3d2fd18714759697fe4cf384b4c8e30ccf1a1491f5f104525d4c"}],"logical_call_id":"call:chapter-draft:90477b440a4d11a91483754ee998ec3a160afcb3eda0b1e78e8c66e60aef1cdb:chapter-generate","node_execution_contract_id":"nec:chapter-draft:90477b440a4d11a91483754ee998ec3a160afcb3eda0b1e78e8c66e60aef1cdb:chapter-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/ordered-chapter-draft-candidate.v1.json","output_sha256":"bcbc156c2319409e298503128e04bbab261359c9b622c25d9d90da62d15b10cf","prompt_sha256":"9aec0ea7a8d8361fdb1c273790e20e30d5e6b1d7680ac1c6c63436bd71300fac","provider_session_id":"b829da37-2333-4d0a-9f24-88cc0f539316","requested_reasoning_effort":"max"},"schema":"model_response.v1"}