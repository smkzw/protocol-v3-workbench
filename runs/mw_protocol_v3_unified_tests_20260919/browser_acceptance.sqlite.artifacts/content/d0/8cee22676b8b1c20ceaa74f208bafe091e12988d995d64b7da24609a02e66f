{"content":"{\n  \"status\": \"ready_for_review\",\n  \"objectives\": {\n    \"primary\": [\n      {\n        \"text\": \"评估合成药X 150 mg皮下给药方案（第1、8、15、22天每周一次负荷给药，第36天起每两周一次维持给药至第24周末次给药）相较生理盐水安慰剂，在慢性鼻窦炎伴鼻息肉成人患者中提高第24周临床缓解率的优效性。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"用户已确认主要终点、对照、给药方案及20%对35%的缓解率假设；按Ⅱ期概念验证和优效性比较组织主要目标。\",\n        \"references\": []\n      }\n    ],\n    \"secondary\": [\n      {\n        \"text\": \"评估第24周SNOT-22评分较基线的变化。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"SNOT-22变化被用户列为次要终点；建议第24周分析时点与主要终点一致，具体版本和访视窗需确认。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"评估第24周Lund-Kennedy内镜评分较基线的变化。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"Lund-Kennedy内镜评分被用户列为次要终点；建议第24周分析时点与主要终点一致，评分和阅片方式需确认。\",\n        \"references\": []\n      }\n    ],\n    \"questions\": [\n      \"次要终点是否纳入多重性控制，还是仅作描述性分析？\",\n      \"SNOT-22版本、Lund-Kennedy评分时点及阅片者盲态如何规定？\"\n    ]\n  },\n  \"endpoint\": {\n    \"primary_endpoint\": {\n      \"text\": \"第24周临床缓解率：达到双侧鼻息肉评分（NPS）≤1且鼻塞VAS≤1的受试者比例。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户简报明确主要终点为第24周临床缓解率，并给出操作定义：双侧NPS≤1且鼻塞VAS≤1。\",\n      \"references\": []\n    },\n    \"key_secondary\": [\n      {\n        \"text\": \"第24周SNOT-22评分较基线变化。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"用户列出SNOT-22变化为次要终点；具体时点未确认，建议与主要终点第24周对齐。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"第24周Lund-Kennedy内镜评分较基线变化。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"用户列出Lund-Kennedy内镜评分为次要终点；具体时点未确认，建议与主要终点第24周对齐。\",\n        \"references\": []\n      }\n    ],\n    \"measurement_details\": \"主要终点为复合二分类应答：双侧NPS≤1且鼻塞VAS≤1。NPS和Lund-Kennedy建议由盲态评估者或中心阅片完成；鼻塞VAS量表范围、方向及≤1阈值定义需确认。\",\n    \"questions\": [\n      \"鼻塞VAS的具体量表范围、方向和≤1阈值定义是什么，例如0–10 cm还是0–100 mm？\",\n      \"双侧NPS≤1是指左右两侧各自≤1、双侧总分≤1，还是其他汇总规则？\",\n      \"第24周访视允许的窗口期是多少，例如±7天？\",\n      \"第24周主要终点缺失或未评估时，是否按非缓解者处理，或采用多重插补等其他规则？\",\n      \"NPS和Lund-Kennedy是否由独立中心阅片或盲态评估者评分？\",\n      \"评估前使用救援治疗时，NPS和VAS如何处理？\"\n    ]\n  },\n  \"estimand\": {\n    \"treatment\": {\n      \"text\": \"合成药X 150 mg/1.0 mL皮下注射，第1、8、15、22天每周一次负荷给药，随后第36天起每两周一次维持给药至第24周末次给药；对照为生理盐水1.0 mL皮下注射，同体积、同途径、同频率给药。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户简报明确合成药X和安慰剂的剂量、途径、频率及给药时间。\",\n      \"references\": []\n    },\n    \"population\": {\n      \"text\": \"慢性鼻窦炎伴鼻息肉成人患者，符合方案入排标准并随机分配至合成药X或安慰剂；主要分析建议采用所有随机化受试者（ITT/全分析集）。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"目标人群由用户确认；ITT/全分析集与治疗策略ICE处理相符，但具体分析集定义需研究者确认。\",\n      \"references\": []\n    },\n    \"variable\": {\n      \"text\": \"第24周临床缓解的二分类指标：NPS≤1且鼻塞VAS≤1为缓解，否则为非缓解。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户简报明确主要终点操作定义。\",\n      \"references\": []\n    },\n    \"ice_strategy\": {\n      \"text\": \"治疗策略：无论是否发生ICE，均按随机分组分析第24周临床缓解；允许稳定背景鼻用激素并记录，稳定背景鼻用激素不视为ICE。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户确认ICE按治疗策略处理，并允许稳定背景鼻用激素且记录。\",\n      \"references\": []\n    },\n    \"summary_measure\": {\n      \"text\": \"试验组与安慰剂组第24周临床缓解率之差（风险差，试验组−安慰剂组）及其95%置信区间；可同时报告率比。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"二分类主要终点通常以风险差为易于解释的绝对获益汇总指标；分析模型需与20%对35%的样本量假设一致。\",\n      \"references\": []\n    },\n    \"ice_events\": [\n      \"启动系统性糖皮质激素、鼻息肉手术或其他方案规定的救援治疗。\",\n      \"因不良事件、缺乏疗效或受试者决定而永久停用研究药物。\",\n      \"使用方案禁止的伴随药物。\",\n      \"第24周主要终点评估缺失。\"\n    ],\n    \"questions\": [\n      \"ITT/全分析集、符合方案集等分析集的具体定义是什么？\",\n      \"上述ICE事件清单是否符合方案，是否还有其他预设ICE？\",\n      \"发生ICE后第24周临床缓解缺失时，是否按非缓解者处理？\",\n      \"稳定背景鼻用激素的具体允许剂量和稳定期定义是什么？\",\n      \"主要分析是否按随机分层因素校正？\"\n    ]\n  },\n  \"sample_size\": {\n    \"assumptions\": [\n      \"主要终点为第24周临床缓解率（NPS≤1且鼻塞VAS≤1）二分类变量。\",\n      \"安慰剂组缓解率20%，合成药X组缓解率35%，绝对差15%。\",\n      \"双侧α=0.05，效能90%。\",\n      \"两组按1:1随机分配。\",\n      \"失访或不可评估率8%，按可评估样本量膨胀。\",\n      \"无期中分析计划。\"\n    ],\n    \"alpha\": \"双侧0.05\",\n    \"power\": \"90%\",\n    \"model\": \"两独立样本比例的正态近似检验，等价于未校正卡方检验的样本量计算；主要分析建议报告风险差及95%置信区间。若预设分层因素，采用分层CMH或分层logistic回归，需确认。\",\n    \"planned_n\": \"约404例，每组约202例；预期可评估约370例，每组约185例。\",\n    \"attrition\": \"8%\",\n    \"justification\": \"按两比例样本量公式：n/组=[z_{1−α/2}√(2p̄(1−p̄))+z_{1−β}√(p1(1−p1)+p2(1−p2))]^2/(p1−p2)^2，p1=0.20、p2=0.35、p̄=0.275；得每组约185例，总370例。考虑8%失访，370/0.92≈402.2，向上按1:1取整为404例，即202例/组。\",\n    \"references\": [],\n    \"questions\": [\n      \"随机分配比例是否确认为1:1？\",\n      \"是否预设分层因素，如基线NPS、哮喘或过敏共病、既往鼻息肉手术史？\",\n      \"是否采用连续性校正或精确检验？若采用会影响样本量。\",\n      \"主要分析缺失数据规则是否与二分类非缓解者处理一致？\"\n    ]\n  },\n  \"interim_planning\": null,\n  \"non_inferiority_margin\": null,\n  \"questions\": [\n    \"本研究的主要比较是Ⅱ期概念验证性质的优效性检验，还是仅为探索性信号评估？\",\n    \"主要终点鼻塞VAS量表范围和≤1阈值定义尚未确认。\",\n    \"双侧NPS≤1的汇总规则尚未确认。\",\n    \"ITT/全分析集及第24周缺失数据主要分析规则尚未确认。\",\n    \"ICE事件清单及救援治疗定义需确认。\",\n    \"随机分配比例、分层因素和主要分析模型需确认。\",\n    \"次要终点是否控制多重性及评估时点需确认。\"\n  ],\n  \"unresolved_questions\": [\n    \"鼻塞VAS具体量表范围、方向和≤1阈值定义未确认。\",\n    \"双侧NPS≤1的汇总规则未确认。\",\n    \"ITT/全分析集定义及第24周缺失数据处理规则未确认。\",\n    \"ICE事件清单及救援治疗定义未确认。\",\n    \"随机分配比例、分层因素和主要分析模型未确认。\",\n    \"SNOT-22和Lund-Kennedy评估时点、版本及多重性策略未确认。\"\n  ]\n}","receipt":{"idempotency_key":"design-elements.generate.v1","input_artifacts":[{"ref":"design-elements-intake","sha256":"e436c6e21e4df6237540483b017387e44474bb932fc8965a5a35fceb6d926b7b"}],"logical_call_id":"call:design-elements:b2bc142fd90269c47c46e5764e6b9d555223d2ea33bf8db99df63f04aad45eb2:design-generate","node_execution_contract_id":"nec:design-elements:b2bc142fd90269c47c46e5764e6b9d555223d2ea33bf8db99df63f04aad45eb2:design-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/design-elements-output.v1.json","output_sha256":"e32c98e1df40c3022879f38603f9feefa72f2102a08bb110c251ebf80c7e6857","prompt_sha256":"42d7741ef77c015a07546119870c3287bf59043e56873e2ca41109b1f481f6d6","provider_session_id":"2915a21c-6aea-4d7f-8a6c-fa24d0a07452","requested_reasoni