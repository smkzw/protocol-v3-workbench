{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-5-5:v2\",\n  \"node_id\": \"v2_n_5_5\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"block_id\": \"blk:p:5-5-01\",\n      \"kind\": \"paragraph\",\n      \"text\": \"本章节说明本试验的招募、伦理审查计划、招募材料管理、联系与访视措施、补偿安排及保留策略。研究人群为成人慢性鼻窦炎伴鼻息肉试验参与者，允许稳定背景鼻用激素并记录；随机分配比例为1:1，按中心分层。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:table:5-5-01\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [],\n      \"table\": {\n        \"table_id\": \"tbl:v2_n_5_5:recruitment_retention\",\n        \"block_id\": \"blk:table:5-5-01\",\n        \"title\": \"表 5-1 招募与保留核心安排\",\n        \"domain\": \"generic\",\n        \"role\": \"body_content\",\n        \"review_state\": \"ai_draft\",\n        \"schema_version\": \"structured_table_v1\",\n        \"version\": 0,\n        \"header_row_count\": 1,\n        \"source_locator\": \"\",\n        \"word_layout\": {},\n        \"notes\": [],\n        \"columns\": [\n          {\n            \"column_id\": \"col:item\",\n            \"label\": \"要素\",\n            \"order\": 0,\n            \"semantic_role\": \"item\",\n            \"style_role\": \"header\"\n          },\n          {\n            \"column_id\": \"col:arrangement\",\n            \"label\": \"项目特定安排\",\n            \"order\": 1,\n            \"semantic_role\": \"value\",\n            \"style_role\": \"header\"\n          }\n        ],\n        \"rows\": [\n          {\n            \"row_id\": \"row:header\",\n            \"order\": 0,\n            \"style_role\": \"header\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:header:item\",\n                \"row_id\": \"row:header\",\n                \"column_id\": \"col:item\",\n                \"text\": \"要素\",\n                \"style_role\": \"header\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:header:value\",\n                \"row_id\": \"row:header\",\n                \"column_id\": \"col:arrangement\",\n                \"text\": \"项目特定安排\",\n                \"style_role\": \"header\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:recruitment-target\",\n            \"order\": 1,\n            \"label\": \"招募目标\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"label:recruitment:target\",\n                \"row_id\": \"row:recruitment-target\",\n                \"column_id\": \"col:item\",\n                \"text\": \"招募目标\",\n                \"style_role\": \"label\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"recruitment:target\",\n                \"row_id\": \"row:recruitment-target\",\n                \"column_id\": \"col:arrangement\",\n                \"text\": \"约404例成人慢性鼻窦炎伴鼻息肉试验参与者；按1:1随机分配，每组约202例，按中心分层；样本量按安慰剂组20%、试验组35%、双侧α=0.05、效能90%、8%失访膨胀计算；无期中分析。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:recruitment-channels\",\n            \"order\": 2,\n            \"label\": \"招募渠道\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"label:recruitment:channels\",\n                \"row_id\": \"row:recruitment-channels\",\n                \"column_id\": \"col:item\",\n                \"text\": \"招募渠道\",\n                \"style_role\": \"label\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"recruitment:channels\",\n                \"row_id\": \"row:recruitment-channels\",\n                \"column_id\": \"col:arrangement\",\n                \"text\": \"合作研究中心相应专科门诊筛选及经伦理委员会批准后方可使用的招募材料。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:recruitment-feasibility\",\n            \"order\": 3,\n            \"label\": \"可行性\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"label:recruitment:feasibility\",\n                \"row_id\": \"row:recruitment-feasibility\",\n                \"column_id\": \"col:item\",\n                \"text\": \"可行性\",\n                \"style_role\": \"label\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"recruitment:feasibility\",\n                \"row_id\": \"row:recruitment-feasibility\",\n                \"column_id\": \"col:arrangement\",\n                \"text\": \"样本量按安慰剂组20%、试验组35%、双侧α=0.05、效能90%、8%失访膨胀计算；计划随机约404例（每组约202例），1:1，按中心分层；无期中分析。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:recruitment-materials-review\",\n            \"order\": 4,\n            \"label\": \"材料审查\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"label:recruitment:materials-review\",\n                \"row_id\": \"row:recruitment-materials-review\",\n                \"column_id\": \"col:item\",\n                \"text\": \"材料审查\",\n                \"style_role\": \"label\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"recruitment:materials-review\",\n                \"row_id\": \"row:recruitment-materials-review\",\n                \"column_id\": \"col:arrangement\",\n                \"text\": \"招募材料及其他试验参与者相关文件须获得伦理委员会批准后方可使用；方案和知情同意书采用版本号和日期控制；研究中心仅使用伦理委员会批准的最新版本。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:recruitment-contacts\",\n            \"order\": 5,\n            \"label\": \"联系措施\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"label:recruitment:contacts\",\n                \"row_id\": \"row:recruitment-contacts\",\n                \"column_id\": \"col:item\",\n                \"text\": \"联系措施\",\n                \"style_role\": \"label\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"recruitment:contacts\",\n                \"row_id\": \"row:recruitment-contacts\",\n                \"column_id\": \"col:arrangement\",\n                \"text\": \"研究中心公开联系电话；仅使用经伦理委员会批准后方可使用的招募材料。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:recruitment-visits\",\n            \"order\": 6,\n            \"label\": \"访视措施\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"label:recruitment:visits\",\n                \"row_id\": \"row:recruitment-visits\",\n                \"column_id\": \"col:item\",\n                \"text\": \"访视措施\",\n                \"style_role\": \"label\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"recruitment:visits\",\n                \"row_id\": \"row:recruitment-visits\",\n                \"column_id\": \"col:arrangement\",\n                \"text\": \"筛选期自签署知情同意书开始，完成入排标准确认、基线评估和背景治疗稳定性确认；确认符合全部入排标准并完成随机化后，第1天开始首次给药。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:compensation-arrangement\",\n            \"order\": 7,\n            \"label\": \"补偿安排\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"label:compensation:arrangement\",\n                \"row_id\": \"row:compensation-arrangement\",\n                \"column_id\": \"col:item\",\n                \"text\": \"补偿安排\",\n                \"style_role\": \"label\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"compensation:arrangement\",\n                \"row_id\": \"row:compensation-arrangement\",\n                \"column_id\": \"col:arrangement\",\n                \"text\": \"适用。试验相关损害由申办方依法承担赔偿责任并提供相应补偿；申办方为本试验购买临床试验责任保险；补偿与损害处理条款以临床试验协议为准；研究者立即处置并记录，申办方承担治疗费用并依法补偿。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:retention-strategy\",\n            \"order\": 8,\n            \"label\": \"保留策略\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"label:retention:strategy\",\n                \"row_id\": \"row:retention-strategy\",\n                \"column_id\": \"col:item\",\n                \"text\": \"保留策略\",\n                \"style_role\": \"label\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"retention:strategy\",\n                \"row_id\": \"row:retention-strategy\",\n                \"column_id\": \"col:arrangement\",\n                \"text\": \"通过方案规定的访视窗、安全性随访、不良事件和合并用药记录、依从性记录、失访联系程序和退出管理提高保留。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:retention-followup\",\n            \"order\": 9,\n            \"label\": \"随访与退出\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"label:retention:follow-up\",\n                \"row_id\": \"row:retention-followup\",\n                \"column_id\": \"col:item\",\n                \"text\": \"随访与退出\",\n                \"style_role\": \"label\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"retention:follow-up\",\n                \"row_id\": \"row:retention-followup\",\n                \"column_id\": \"col:arrangement\",\n                \"text\": \"安全性随访按治疗期访视及末次给药后第24周评估进行；仅停用研究干预者继续随访至第24周；因不良事件停药者随访至事件稳定或恢复；撤回知情同意者不进行进一步研究随访。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          }\n        ]\n      }\n    },\n    {\n      \"block_id\": \"blk:p:5-5-02\",\n      \"kind\": \"paragraph\",\n      \"text\": \"招募目标为约404例试验参与者，按1:1随机分配，每组约202例，并按中心分层；样本量按安慰剂组20%、试验组35%、双侧α=0.05、效能90%、8%失访膨胀计算，无期中分析。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:p:5-5-03\",\n      \"kind\": \"paragraph\",\n      \"text\": \"招募通过合作研究中心相应专科门诊筛选及经伦理委员会批准后方可使用的招募材料进行。招募材料及其他试验参与者相关文件应获得伦理委员会批准后方可使用；方案和知情同意书应采用版本号和日期控制，研究中心仅使用伦理委员会批准的最新版本。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:p:5-5-04\",\n      \"kind\": \"paragraph\",\n      \"text\": \"研究中心应公开联系电话，且仅使用经伦理委员会批准后方可使用的招募材料。筛选期自签署知情同意书开始，应完成入排标准确认、基线评估和背景治疗稳定性确认；确认符合全部入排标准并完成随机化后，第1天开始首次给药。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:p:5-5-05\",\n      \"kind\": \"paragraph\",\n      \"text\": \"本试验已确认适用补偿安排。试验相关损害由申办方依法承担赔偿责任并提供相应补偿；申办方为本试验购买临床试验责任保险；补偿与损害处理条款以临床试验协议为准。试验参与者发生试验相关损害时，研究者应立即处置并记录，申办方应承担治疗费用并依法补偿。负责联系人为申办方医学监察员及药物安全负责人（联系方式见中心启动资料）。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:p:5-5-06\",\n      \"kind\": \"paragraph\",\n      \"text\": \"伦理审查计划方面，研究开始前，方案、知情同意书、招募材料及其他试验参与者相关文件须获得伦理委员会批准；批准文件和成员名单应归档。主要研究者负责本中心伦理审查申请、伦理委员会沟通、方案依从和安全性报告；申办者负责提供必要文件并确保多中心研究按统一伦理要求管理。研究期间应按伦理委员会要求提交继续审查和修正案审查。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:p:5-5-07\",\n      \"kind\": \"paragraph\",\n      \"text\": \"保留策略应通过方案规定的访视窗、安全性随访、不良事件和合并用药记录、依从性记录、失访联系程序和退出管理实施。若试验参与者停用研究干预但未撤回知情同意，应继续按方案收集安全性和疗效随访数据；仅停用研究干预者应继续随访至第24周；因不良事件停药者应随访至事件稳定或恢复，并按医学监查要求完成安全性随访；撤回知情同意者不进行进一步研究随访。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:p:5-5-08\",\n      \"kind\": \"paragraph\",\n      \"text\": \"在第24周访视窗口及随访到期后，应通过电话、短信或邮件、信件等经批准的联系方式至少进行3次联系尝试，尽量覆盖不同日期和时段；仅使用试验参与者授权联系方式。经至少3次合理联系尝试仍无法联系且无明确撤回同意者，由研究者审核分类为失访；后续恢复联系时，应按方案评估是否继续随访。安全性随访应按治疗期访视及末次给药后第24周评估进行；如发生不良事件，应随访至事件消退或稳定。撤回知情同意后不再收集新数据，除非法规要求或试验参与者另行同意；已收集数据按预定义分析计划使用。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"89fb30305ca621fad2404e69f6f2a6bd9f72ae15885887e2b2fe09134c8d849c"}],"logical_call_id":"call:chapter-draft:68b1e138fcf7651c837187439c41ea8c45e3318c6afc46ac75d5c78b8ae40168:chapter-generate","node_execution_contract_id":"nec:chapter-draft:68b1e138fcf7651c837187439c41ea8c45e3318c6afc46ac75d5c78b8ae40168:chapter-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/ordered-chapter-draft-candidate.v1.json","output_sha256":"85e21e506be6221249bb0c37fd7a4c6c4d40e79acfe88f94719117d01db9ba7a","prompt_sha256":"9aec0ea7a8d8361fdb1c273790e20e30d5e6b1d7680ac1c6c63436bd71300fac","provider_session_id":"aa8facf4-3766-42d8-bf0d-d6a5ed6c615c","requested_reasoning_effort":"max"},"schema":"model_response.v1"}