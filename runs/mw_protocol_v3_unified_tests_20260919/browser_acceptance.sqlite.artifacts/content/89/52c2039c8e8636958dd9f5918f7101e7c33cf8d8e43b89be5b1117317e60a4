{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-8-1:v2\",\n  \"node_id\": \"v2_n_8_1\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"block_id\": \"v2_n_8_1:p:intro\",\n      \"kind\": \"paragraph\",\n      \"text\": \"本章规定个体层面与整体层面的停止安排：个体层面分为个体暂时暂停与个体永久停药，整体层面分为试验暂停与试验终止。各层级标准、执行、记录、决策和后续处理应分别适用，不得将个体停药等同于整体试验暂停或终止。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"v2_n_8_1:p:individual_hold\",\n      \"kind\": \"paragraph\",\n      \"text\": \"本设计包含个体暂时暂停路径。个体暂停指因安全性或其他医学原因暂时停止研究干预，但未撤回知情同意；暂停不自动等同于永久停药。本方案未设定计划性暂停给药。暂停期间继续按计划进行安全性和疗效随访，除非受试者退出；恢复给药需由研究者判断并记录，符合方案和医学监查要求后方可恢复；达到永久停药标准者停止给药并继续安全性随访至第24周或医学监查确认结束。任何因不良事件、合并用药、手术、受试者原因或其他情况导致的给药暂停、延迟或遗漏，均记录发生日期、原因、持续时间、是否恢复、恢复日期及实际给药调整。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"v2_n_8_1:p:individual_hold_criteria\",\n      \"kind\": \"paragraph\",\n      \"text\": \"个体暂停的触发条件包括：发生不良事件/严重不良事件，需暂停给药以评估与试验药物的关系及继续给药风险；具有临床意义的实验室检查、生命体征或其他安全性异常，需重复确认并评估是否暂停或永久停用研究干预；发生重度过敏或超敏反应，或需紧急处理的系统性反应，需暂停给药并评估是否永久停药；因合并用药、手术、受试者原因或其他情况导致需要暂停、延迟或遗漏给药。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"v2_n_8_1:p:permanent_stop\",\n      \"kind\": \"paragraph\",\n      \"text\": \"达到以下任一标准时，个体永久停止研究干预：受试者撤回知情同意或明确要求永久停止研究干预；发生与试验药物相关的严重不良事件或不可耐受毒性，研究者判断继续给药风险大于获益；发生重度过敏或超敏反应，或需紧急处理的系统性反应；具有临床意义的实验室检查、生命体征或其他安全性异常经重复确认，且研究者或医学监查员判断需永久停药；研究者判断继续给药不符合受试者最佳利益；申办者、伦理委员会或监管机构要求永久停止。达到上述任一标准时永久停止研究干预，并按方案继续安全性随访；撤回知情同意者不再进行新的研究相关操作。永久停止研究干预需在eCRF中记录日期、原因、与试验药物关系、是否达到方案定义标准、是否继续研究随访；相关不良事件或严重不良事件按GCP和安全性报告流程报告。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"v2_n_8_1:p:safety_coherence\",\n      \"kind\": \"paragraph\",\n      \"text\": \"个体暂停或永久停药决策应与安全性评估、不良事件/严重不良事件报告和随访安排一致；暂停后需完成方案规定的安全性评估，达到永久停药标准者停止给药并继续安全性随访至第24周或医学监查确认结束。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"v2_n_8_1:table:individual_cessation\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [],\n      \"table\": {\n        \"table_id\": \"v2_n_8_1:table:individual_cessation\",\n        \"block_id\": \"v2_n_8_1:table:individual_cessation\",\n        \"title\": \"表1 个体层面停止：暂停与永久停药\",\n        \"domain\": \"stopping_rules\",\n        \"role\": \"body_content\",\n        \"header_row_count\": 1,\n        \"review_state\": \"ai_draft\",\n        \"version\": 0,\n        \"columns\": [\n          {\n            \"column_id\": \"individual:col:type\",\n            \"order\": 0,\n            \"label\": \"停止类型\",\n            \"semantic_role\": \"category\"\n          },\n          {\n            \"column_id\": \"individual:col:trigger\",\n            \"order\": 1,\n            \"label\": \"项目特定触发标准\",\n            \"semantic_role\": \"trigger\"\n          },\n          {\n            \"column_id\": \"individual:col:management\",\n            \"order\": 2,\n            \"label\": \"执行与随访\",\n            \"semantic_role\": \"management\"\n          },\n          {\n            \"column_id\": \"individual:col:recording\",\n            \"order\": 3,\n            \"label\": \"记录与转换\",\n            \"semantic_role\": \"recording\"\n          }\n        ],\n        \"rows\": [\n          {\n            \"row_id\": \"individual:r:hold\",\n            \"order\": 0,\n            \"label\": \"个体暂停\",\n            \"cells\": [\n              {\n                \"cell_id\": \"individual:r:hold:type\",\n                \"row_id\": \"individual:r:hold\",\n                \"column_id\": \"individual:col:type\",\n                \"text\": \"个体暂停\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"discontinuation:cell:individual_trigger\",\n                \"row_id\": \"individual:r:hold\",\n                \"column_id\": \"individual:col:trigger\",\n                \"text\": \"发生不良事件/严重不良事件，需暂停给药以评估与试验药物的关系及继续给药风险；具有临床意义的实验室检查、生命体征或其他安全性异常，需重复确认并评估是否暂停或永久停用研究干预；发生重度过敏或超敏反应，或需紧急处理的系统性反应，需暂停给药并评估是否永久停药；因合并用药、手术、受试者原因或其他情况导致需要暂停、延迟或遗漏给药。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"individual:r:hold:management\",\n                \"row_id\": \"individual:r:hold\",\n                \"column_id\": \"individual:col:management\",\n                \"text\": \"暂停期间继续按计划进行安全性和疗效随访，除非受试者退出；恢复给药需由研究者评估并符合方案和医学监查要求；达到永久停药标准者停止给药并继续安全性随访至第24周或医学监查确认结束。本方案未设定计划性暂停给药。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"individual:r:hold:recording\",\n                \"row_id\": \"individual:r:hold\",\n                \"column_id\": \"individual:col:recording\",\n                \"text\": \"记录发生日期、原因、持续时间、是否恢复、恢复日期及实际给药调整；暂停不自动等同于永久停药。若达到永久停药标准，则永久停止研究干预，并按方案继续安全性随访；撤回知情同意者不再进行新的研究相关操作。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"individual:r:permanent\",\n            \"order\": 1,\n            \"label\": \"个体永久停药\",\n            \"cells\": [\n              {\n                \"cell_id\": \"individual:r:permanent:type\",\n                \"row_id\": \"individual:r:permanent\",\n                \"column_id\": \"individual:col:type\",\n                \"text\": \"个体永久停药\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"individual:r:permanent:trigger\",\n                \"row_id\": \"individual:r:permanent\",\n                \"column_id\": \"individual:col:trigger\",\n                \"text\": \"受试者撤回知情同意或明确要求永久停止研究干预；发生与试验药物相关的严重不良事件或不可耐受毒性，研究者判断继续给药风险大于获益；发生重度过敏或超敏反应，或需紧急处理的系统性反应；具有临床意义的实验室检查、生命体征或其他安全性异常经重复确认，且研究者或医学监查员判断需永久停药；研究者判断继续给药不符合受试者最佳利益；申办者、伦理委员会或监管机构要求永久停止。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"individual:r:permanent:management\",\n                \"row_id\": \"individual:r:permanent\",\n                \"column_id\": \"individual:col:management\",\n                \"text\": \"达到上述任一标准时永久停止研究干预，并按方案继续安全性随访；撤回知情同意者不再进行新的研究相关操作。个体暂停或永久停药决策应与安全性评估、不良事件/严重不良事件报告和随访安排一致；暂停后需完成方案规定的安全性评估，达到永久停药标准者停止给药并继续安全性随访至第24周或医学监查确认结束。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"individual:r:permanent:recording\",\n                \"row_id\": \"individual:r:permanent\",\n                \"column_id\": \"individual:col:recording\",\n                \"text\": \"永久停止研究干预需在eCRF中记录日期、原因、与试验药物关系、是否达到方案定义标准、是否继续研究随访；相关不良事件或严重不良事件按GCP和安全性报告流程报告。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          }\n        ],\n        \"word_layout\": {}\n      }\n    },\n    {\n      \"block_id\": \"v2_n_8_1:p:trial_stop_criteria\",\n      \"kind\": \"paragraph\",\n      \"text\": \"整体试验暂停条件包括：出现可能影响受试者安全的非预期严重不良反应聚集、系统性安全性问题、中心严重方案违背、监管或伦理要求暂停等情形时，可暂停试验入组或给药，待评估后决定恢复或终止。整体试验终止条件包括：出现明确不可接受的安全性风险、无效或获益/风险比不支持继续、监管机构或伦理委员会要求终止、申办者无法继续实施等情形时，终止试验。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"v2_n_8_1:p:trial_stop_decision\",\n      \"kind\": \"paragraph\",\n      \"text\": \"整体暂停或终止的决策逻辑为：当出现系统性安全性信号、影响试验继续的严重方案违背、监管或伦理要求，或无法控制的风险时，应评估风险获益并决定暂停入组/给药或终止试验。试验整体暂停或终止由申办者会同研究者、医学监查员决定；涉及受试者安全时按法规和伦理委员会、监管机构要求报告并执行。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"v2_n_8_1:table:trial_stop\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [],\n      \"table\": {\n        \"table_id\": \"v2_n_8_1:table:trial_stop\",\n        \"block_id\": \"v2_n_8_1:table:trial_stop\",\n        \"title\": \"表2 整体层面试验暂停/终止的触发、决策与决定后处理\",\n        \"domain\": \"stopping_rules\",\n        \"role\": \"body_content\",\n        \"header_row_count\": 1,\n        \"review_state\": \"ai_draft\",\n        \"version\": 0,\n        \"columns\": [\n          {\n            \"column_id\": \"trial:col:item\",\n            \"order\": 0,\n            \"label\": \"整体停止要素\",\n            \"semantic_role\": \"category\"\n          },\n          {\n            \"column_id\": \"trial:col:content\",\n            \"order\": 1,\n            \"label\": \"项目特定内容\",\n            \"semantic_role\": \"content\"\n          }\n        ],\n        \"rows\": [\n          {\n            \"row_id\": \"trial:r:suspension\",\n            \"order\": 0,\n            \"label\": \"整体暂停触发标准\",\n            \"cells\": [\n              {\n                \"cell_id\": \"trial:r:suspension:item\",\n                \"row_id\": \"trial:r:suspension\",\n                \"column_id\": \"trial:col:item\",\n                \"text\": \"整体暂停触发标准\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"discontinuation:cell:trial_trigger\",\n                \"row_id\": \"trial:r:suspension\",\n                \"column_id\": \"trial:col:content\",\n                \"text\": \"出现可能影响受试者安全的非预期严重不良反应聚集、系统性安全性问题、中心严重方案违背、监管或伦理要求暂停等情形时，可暂停试验入组或给药，待评估后决定恢复或终止。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"trial:r:termination\",\n            \"order\": 1,\n            \"label\": \"整体终止触发标准\",\n            \"cells\": [\n              {\n                \"cell_id\": \"trial:r:termination:item\",\n                \"row_id\": \"trial:r:termination\",\n                \"column_id\": \"trial:col:item\",\n                \"text\": \"整体终止触发标准\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"trial:r:termination:content\",\n                \"row_id\": \"trial:r:termination\",\n                \"column_id\": \"trial:col:content\",\n                \"text\": \"出现明确不可接受的安全性风险、无效或获益/风险比不支持继续、监管机构或伦理委员会要求终止、申办者无法继续实施等情形时，终止试验。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"trial:r:logic\",\n            \"order\": 2,\n            \"label\": \"整体暂停/终止决策逻辑\",\n            \"cells\": [\n              {\n                \"cell_id\": \"trial:r:logic:item\",\n                \"row_id\": \"trial:r:logic\",\n                \"column_id\": \"trial:col:item\",\n                \"text\": \"整体暂停/终止决策逻辑\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"discontinuation:cell:trial_decision_logic\",\n                \"row_id\": \"trial:r:logic\",\n                \"column_id\": \"trial:col:content\",\n                \"text\": \"当出现系统性安全性信号、影响试验继续的严重方案违背、监管或伦理要求，或无法控制的风险时，应评估风险获益并决定暂停入组/给药或终止试验。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"trial:r:authority\",\n            \"order\": 3,\n            \"label\": \"决定方与报告路径\",\n            \"cells\": [\n              {\n                \"cell_id\": \"trial:r:authority:item\",\n                \"row_id\": \"trial:r:authority\",\n                \"column_id\": \"trial:col:item\",\n                \"text\": \"决定方与报告路径\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"discontinuation:cell:trial_decision_authority\",\n                \"row_id\": \"trial:r:authority\",\n                \"column_id\": \"trial:col:content\",\n                \"text\": \"试验整体暂停或终止由申办者会同研究者、医学监查员决定；涉及受试者安全时按法规和伦理委员会、监管机构要求报告并执行。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"trial:r:post\",\n            \"order\": 4,\n            \"label\": \"决定后处理\",\n            \"cells\": [\n              {\n                \"cell_id\": \"trial:r:post:item\",\n                \"row_id\": \"trial:r:post\",\n                \"column_id\": \"trial:col:item\",\n                \"text\": \"决定后处理\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"discontinuation:cell:trial_post_decision\",\n                \"row_id\": \"trial:r:post\",\n                \"column_id\": \"trial:col:content\",\n                \"text\": \"决定暂停或终止后，立即停止相关入组或给药，通知所有中心，确保受试者安全并安排必要的安全性随访和转归，按法规报告伦理委员会和监管机构，记录并保存所有决定及依据。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          }\n        ],\n        \"word_layout\": {}\n      }\n    },\n    {\n      \"block_id\": \"v2_n_8_1:p:trial_stop_post_decision\",\n      \"kind\": \"paragraph\",\n      \"text\": \"整体暂停或终止后，受试者处理与随访安排为：立即停止相关入组或给药，通知所有中心，确保受试者安全并安排必要的安全性随访和转归，按法规报告伦理委员会和监管机构，记录并保存所有决定及依据。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"5b5a74b45792ad8c0800cd668f13422cefb8cf0bdbecb7076ce6ce0112e0d3c9"}],"logical_call_id":"call:chapter-draft:ec88e599d22fde0ee6bbe91124bdd0cb0041701da313793bcf5bf5fd6bc4d69d:chapter-generate","node_execution_contract_id":"nec:chapter-draft:ec88e599d22fde0ee6bbe91124bdd0cb0041701da313793bcf5bf5fd6bc4d69d:chapter-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/ordered-chapter-draft-candidate.v1.json","output_sha256":"314cf95f3d282d2640ed21ece8bcd7ce83a9454851c4b21f400c9bc8e273f2b7","prompt_sha256":"47dd66c834319411962b91127cd952207cccdab4dee7068a9ab81409e5aefa1e","provider_session_id":"26d17e2e-7d8d-4803-9719-d5e9ff62eab2","requested_reasoning_effort":"max"},"schema":"model_response.v1"}