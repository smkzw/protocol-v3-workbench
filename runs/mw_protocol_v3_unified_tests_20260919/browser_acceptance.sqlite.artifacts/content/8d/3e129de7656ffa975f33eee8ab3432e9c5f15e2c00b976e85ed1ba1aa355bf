{"content":"{\"chapters\":{\"v2_n_1_1\":{\"synopsis.sponsor\":{\"role\":\"申办者\",\"representative_role\":\"申办方代表\",\"responsibility\":\"申办者负责发起、管理和资助本试验，确保试验按照已批准方案、GCP和适用法规实施；负责提供试验用药品、标签、运输和销毁授权，并监督药物管理符合方案、GCP和适用法规；建立并维护质量体系，确保试验质量和数据可靠性。\",\"compensation\":\"试验相关损害由申办方依法承担赔偿责任并提供相应补偿；申办方为本试验购买临床试验责任保险。\",\"safety_reporting\":\"申办者药物警戒部门负责SUSAR和其他潜在严重安全性风险的识别、评估和报告。\"}},\"v2_n_1_2\":{\"diagram.allocation_ratio\":{\"ratio\":\"1:1\",\"stratification\":\"按中心分层\",\"allocation\":\"随机分配\",\"arms\":[\"合成药X组\",\"安慰剂组\"],\"randomized\":true,\"description\":\"受试者按1:1随机分配至合成药X组或安慰剂组，随机化按中心分层。\"}},\"v2_n_3_1_1\":{\"design.discontinuation_rescue_strategy\":{\"rescue_treatment_planned\":true,\"rescue_treatment_definition\":\"因鼻塞加重使用全身激素或鼻窦手术。\",\"ice_strategy\":\"ICE按治疗策略（treatment policy）处理。\",\"ice_events\":[\"鼻塞加重需全身激素或手术干预\",\"因不良事件停药\",\"失访\"],\"discontinuation_handling\":\"受试者停用研究干预但未撤回知情同意时，继续按方案收集安全性和疗效随访数据；撤回知情同意后不再收集新数据，除非法规要求或受试者另行同意。\",\"missing_data\":\"第24周缺失主要终点采用无应答插补（NRI）；敏感性分析采用tipping point。\",\"estimand_linkage\":\"主要估计目标反映在治疗策略下，无论是否使用补救治疗，干预对第24周临床缓解率的效应。\"}},\"v2_n_3_1_2_3\":{\"estimand.primary.rescue_treatment_handling\":{\"strategy\":\"治疗策略（treatment policy）\",\"rescue_treatment_definition\":\"因鼻塞加重使用全身激素或鼻窦手术。\",\"ice_event\":true,\"handling\":\"救援治疗不排除、不删失；接受救援治疗的受试者仍按随机分组纳入FAS，继续按计划随访至第24周主要终点及后续安全性随访。\",\"missing_data\":\"第24周缺失主要终点采用无应答插补（NRI）；敏感性分析采用tipping point。\",\"safety\":\"记录AE/SAE并与补救治疗的关系。\",\"label\":\"随机分配的治疗，伴有或不伴有‘补救治疗或背景治疗改变’\"}},\"v2_n_3_1_2_4\":{\"estimand.primary.ice_strategy_crosscheck\":{\"ice_events\":[{\"event\":\"鼻塞加重需全身激素或手术干预\",\"strategy\":\"治疗策略（treatment policy）\"},{\"event\":\"因不良事件停药\",\"strategy\":\"治疗策略（treatment policy）\"},{\"event\":\"失访\",\"strategy\":\"治疗策略（treatment policy）\"}],\"overall_strategy\":\"ICE按治疗策略（treatment policy）处理。\",\"rescue_treatment_definition\":\"因鼻塞加重使用全身激素或鼻窦手术。\",\"missing_data_handling\":\"第24周缺失主要终点采用无应答插补（NRI）；敏感性分析采用tipping point。\",\"crosscheck\":\"表1所列伴发事件及处理策略与主要估计目标一致；救援治疗不排除、不删失，继续按随机分组纳入主要分析。\"}},\"v2_n_4_5\":{\"framing.structured_design.randomization_procedure\":{\"randomization\":\"受试者按1:1随机分配至合成药X组或安慰剂组，随机化按中心分层。\",\"allocation\":\"随机分配\",\"randomization_ratio\":\"1:1\",\"stratification\":\"按中心分层\",\"arms\":[\"合成药X组\",\"安慰剂组\"],\"masking\":\"双盲\",\"masking_procedure\":\"采用双盲设计。安慰剂为生理盐水1.0 mL，皮下注射，同体积、同途径、同频率给药，以维持盲态；受试者和研究者对治疗分配保持盲态。\",\"blinded_parties\":[\"受试者\",\"研究者\"],\"matching_placebo\":\"生理盐水1.0 mL，皮下注射，与试验药同体积、同途径、同频率\"}},\"v2_n_5_4\":{\"population.rescreening.allowed\":false},\"v2_n_5_5\":{\"population.recruitment.compensation_applicable\":true}}}","receipt":{"idempotency_key":"chapter-facts.derive.v1","input_artifacts":[{"ref":"chapter-facts-input","sha256":"cafec15f61b862f2fbff678cbad8eda11d662bacaee43568d30b40c0cd8f9f39"}],"logical_call_id":"call:chapter-facts:cafec15f61b862f2fbff678cbad8eda11d662bacaee43568d30b40c0cd8f9f39","node_execution_contract_id":"nec:chapter-facts:cafec15f61b862f2fbff678cbad8eda11d662bacaee43568d30b40c0cd8f9f39","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/chapter-facts-output.v1.json","output_sha256":"49e013cb487125380a533b6d267dd7fffb7a09a7393b03cdd8433ba5c97bb1e5","prompt_sha256":"81a4f629a6890c6f801162e4a74b9ab00ea246faf6b827f82fb3d8a5fee50daf","provider_session_id":"ef65f681-bbf4-4846-aee0-dab9144185c0","requested_reasoning_effort":"max"},"schema":"model_response.v1"}