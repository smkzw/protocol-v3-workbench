{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-10-4:v2\",\n  \"node_id\": \"v2_n_10_4\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"block_id\": \"blk_v2_n_10_4_para_001\",\n      \"kind\": \"paragraph\",\n      \"text\": \"本节规定其他潜在严重安全性风险信息的项目化识别、报告与审核要求，逐项明确信号定义、报告标准、报告对象与时限以及审核责任。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk_v2_n_10_4_para_002\",\n      \"kind\": \"paragraph\",\n      \"text\": \"其他潜在严重安全性风险信息的报告义务按下列项目化要求执行；相关信息符合报告标准时，应按本节及现行法规和伦理委员会要求处理。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk_v2_n_10_4_tbl_001\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [],\n      \"table\": {\n        \"table_id\": \"tbl_v2_n_10_4_other_ssi\",\n        \"block_id\": \"blk_v2_n_10_4_tbl_001\",\n        \"title\": \"其他潜在严重安全性风险信息项目化要求\",\n        \"domain\": \"generic\",\n        \"role\": \"body_content\",\n        \"header_row_count\": 1,\n        \"review_state\": \"ai_draft\",\n        \"version\": 0,\n        \"source_locator\": \"\",\n        \"schema_version\": \"structured_table_v1\",\n        \"columns\": [\n          {\n            \"column_id\": \"col_item\",\n            \"order\": 0,\n            \"label\": \"项目\",\n            \"semantic_role\": \"item\",\n            \"style_role\": \"body\",\n            \"source_locator\": \"\"\n          },\n          {\n            \"column_id\": \"col_content\",\n            \"order\": 1,\n            \"label\": \"项目化内容\",\n            \"semantic_role\": \"content\",\n            \"style_role\": \"body\",\n            \"source_locator\": \"\"\n          }\n        ],\n        \"rows\": [\n          {\n            \"row_id\": \"row_signal_definition\",\n            \"order\": 0,\n            \"label\": \"信号定义\",\n            \"source_locator\": \"\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell_signal_definition_item\",\n                \"row_id\": \"row_signal_definition\",\n                \"column_id\": \"col_item\",\n                \"text\": \"信号定义\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell_signal_definition_content\",\n                \"row_id\": \"row_signal_definition\",\n                \"column_id\": \"col_content\",\n                \"text\": \"其他潜在的严重安全性风险信息指明显影响药品获益-风险评价的临床前或临床信息，如严重不良反应发生率增加、预期严重不良反应新发、动物致癌/致畸或其他重大安全性问题。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row_reporting_criteria\",\n            \"order\": 1,\n            \"label\": \"报告标准\",\n            \"source_locator\": \"\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell_reporting_criteria_item\",\n                \"row_id\": \"row_reporting_criteria\",\n                \"column_id\": \"col_item\",\n                \"text\": \"报告标准\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell_reporting_criteria_content\",\n                \"row_id\": \"row_reporting_criteria\",\n                \"column_id\": \"col_content\",\n                \"text\": \"当信息可能改变药品获益-风险评价、影响受试者安全或需要采取安全性措施时，应按其他潜在严重安全性风险信息报告。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row_recipient_and_clock\",\n            \"order\": 2,\n            \"label\": \"报告对象与时限\",\n            \"source_locator\": \"\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell_recipient_and_clock_item\",\n                \"row_id\": \"row_recipient_and_clock\",\n                \"column_id\": \"col_item\",\n                \"text\": \"报告对象与时限\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell_recipient_and_clock_content\",\n                \"row_id\": \"row_recipient_and_clock\",\n                \"column_id\": \"col_content\",\n                \"text\": \"申办者应在获知其他潜在严重安全性风险信息后尽快报告给药品监督管理部门、卫生健康主管部门、伦理委员会及相关研究者；具体时限按现行法规和伦理委员会要求执行。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row_review_responsibility\",\n            \"order\": 3,\n            \"label\": \"审核职责\",\n            \"source_locator\": \"\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell_review_responsibility_item\",\n                \"row_id\": \"row_review_responsibility\",\n                \"column_id\": \"col_item\",\n                \"text\": \"审核职责\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell_review_responsibility_content\",\n                \"row_id\": \"row_review_responsibility\",\n                \"column_id\": \"col_content\",\n                \"text\": \"申办者药物警戒部门负责识别、评估和报告；研究者负责及时提供信息；伦理委员会和监管机构负责审查。\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          }\n        ],\n        \"notes\": []\n      }\n    },\n    {\n      \"block_id\": \"blk_v2_n_10_4_para_003\",\n      \"kind\": \"paragraph\",\n      \"text\": \"上述信号定义、报告标准、报告对象与时限及审核责任为本试验执行其他潜在严重安全性风险信息报告义务的项目依据。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"81253c59134fe50916daf396c77f63f