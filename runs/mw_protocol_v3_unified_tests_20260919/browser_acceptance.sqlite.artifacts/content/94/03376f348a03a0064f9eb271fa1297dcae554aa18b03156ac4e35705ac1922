{"content":"{\n  \"chapters\": {\n    \"v2_n_6_2_4\": {\n      \"intervention.preparation_conditions\": {\n        \"description\": \"合成药X注射制剂150 mg/1.0 mL与生理盐水安慰剂1.0 mL均按随机分组准备，皮下注射，同体积、同途径、同频率给药；准备和给药过程需保持盲态。\"\n      }\n    },\n    \"v2_n_6_3\": {\n      \"intervention.adherence_denominator\": {\n        \"description\": \"按方案预期给药次数计算：负荷期第1、8、15、22天共4次；维持期自第36天起每两周一次至第24周末次给药。安慰剂组同体积、同途径、同频率给药。\"\n      },\n      \"intervention.adherence_evidence_source\": {\n        \"description\": \"依据研究药物发放/回收记录、给药记录、受试者用药日志、访视记录和药物计数等源文件。\"\n      },\n      \"intervention.adherence_measure\": {\n        \"description\": \"实际接受给药次数占方案预期给药次数的比例；同时记录漏用、暂停、延迟给药及原因。\"\n      },\n      \"intervention.planned_hold_tracking\": {\n        \"description\": \"对任何计划内或计划外给药暂停、漏用或延迟进行记录，包括日期、原因、持续时间和后续处理。\"\n      }\n    },\n    \"v2_n_6_4_1\": {\n      \"intervention.prohibited_treatments\": {\n        \"description\": \"研究设计中除救援治疗相关条款外未列出其他禁止使用的食物、药物和治疗；因鼻塞加重使用全身激素或鼻窦手术按救援治疗管理。\"\n      },\n      \"intervention.prohibited_window\": {\n        \"description\": \"未设定统一的禁止使用窗口；救援治疗因鼻塞加重时按需使用并记录。\"\n      }\n    },\n    \"v2_n_6_4_2\": {\n      \"intervention.allowed_timing\": {\n        \"description\": \"稳定背景鼻用激素允许在研究期间持续使用并记录；因鼻塞加重时允许使用全身激素或鼻窦手术作为救援治疗。\"\n      },\n      \"intervention.allowed_treatments\": {\n        \"description\": \"稳定背景鼻用激素；因鼻塞加重使用全身激素或鼻窦手术作为救援治疗。\"\n      },\n      \"intervention.background_therapy_applicable\": {\n        \"applicable\": true,\n        \"description\": \"允许稳定背景鼻用激素，并需记录。\"\n      }\n    },\n    \"v2_n_6_4_3\": {\n      \"intervention.rescue_estimand_linkage\": {\n        \"description\": \"救援治疗对应ICE事件（鼻塞加重需全身激素或手术干预），按治疗策略处理；主要分析不因救援治疗剔除或删失，第24周缺失主要终点采用NRI，敏感性分析采用tipping point。\"\n      },\n      \"intervention.rescue_followup_handling\": {\n        \"description\": \"使用救援治疗后继续按计划随访并记录疗效与安全性；不改变随机分组分析，第24周数据按治疗策略纳入。\"\n      },\n      \"intervention.rescue_permitted\": {\n        \"permitted\": true,\n        \"description\": \"允许因鼻塞加重使用全身激素或鼻窦手术作为救援治疗。\"\n      },\n      \"intervention.rescue_records\": {\n        \"description\": \"记录救援治疗类型、药物或手术名称、剂量、日期、原因、与鼻塞加重的关系及结局，并作为ICE事件记录。\"\n      },\n      \"intervention.rescue_timing\": {\n        \"description\": \"因鼻塞加重时按临床需要实施；记录具体日期。\"\n      }\n    },\n    \"v2_n_7_1\": {\n      \"procedure.baseline_assessments\": {\n        \"description\": \"至少包括主要和次要终点相关基线评估：双侧鼻息肉评分（NPS）、鼻塞VAS、SNOT-22、Lund-Kennedy内镜评分。\"\n      },\n      \"procedure.screening_period_definition\": {\n        \"description\": \"筛选期用于确认成人慢性鼻窦炎伴鼻息肉诊断和入选/排除标准，并完成基线评估，至随机分组前结束。\"\n      }\n    },\n    \"v2_n_7_2\": {\n      \"diagram.randomized\": {\n        \"randomized\": true,\n        \"ratio\": \"1:1\",\n        \"stratification\": \"按中心分层\",\n        \"arms\": [\"合成药X组\", \"安慰剂组\"],\n        \"blinding\": \"双盲\"\n      },\n      \"procedure.blinded_treatment_handling\": {\n        \"description\": \"研究采用双盲设计；合成药X 150 mg/1.0 mL皮下注射与生理盐水安慰剂1.0 mL皮下注射同体积、同途径、同频率给药，以保持盲态。\"\n      },\n      \"procedure.dosing_start_rules\": {\n        \"description\": \"随机后第1天开始首次给药；负荷期第1、8、15、22天每周一次共4次；维持期自第36天起每两周一次至第24周末次给药。\"\n      },\n      \"procedure.treatment_period_definition\": {\n        \"description\": \"治疗期从第1天首次给药开始至第24周末次给药；包括负荷给药期（第1、8、15、22天）和维持给药期（第36天起每两周一次至第24周）。\"\n      },\n      \"procedure.treatment_visit_procedures\": {\n        \"description\": \"按给药日程进行皮下注射给药；第24周评估主要终点临床缓解率及次要终点SNOT-22、Lund-Kennedy内镜评分；记录不良事件、合并用药和依从性。\"\n      }\n    },\n    \"v2_n_7_3\": {\n      \"procedure.unscheduled_contact_recording_plan\": {\n        \"assessment_rules\": \"记录非计划联系中完成的评估项目、结果，以及与计划访视评估的关系；如涉及疗效或安全性终点，按方案规定补充至相应访视数据。\",\n        \"date_recording\": \"记录联系日期，并注明与最近一次计划访视或给药日期的间隔。\",\n        \"modality_recording\": \"记录联系方式（如电话、视频、门诊、住院或其他）。\",\n        \"reason_recording\": \"记录非计划联系的原因，包括不良事件、救援治疗、依从性问题、疗效变化或其他。\",\n        \"safety_information_handling\": \"按安全性报告流程收集、评估和报告不良事件/严重不良事件；必要时安排计划外访视并记录处理。\"\n      }\n    }\n  }\n}","receipt":{"idempotency_key":"chapter-facts.derive.v1","input_artifacts":[{"ref":"chapter-facts-input","sha256":"152e2293b052d1d2c01eeda85de1abf613432439527f6298ae5fa5ae1d90538d"}],"logical_call_id":"call:chapter-facts:152e2293b052d1d2c01eeda85de1abf613432439527f6298ae5fa5ae1d90538d","node_execution_contract_id":"nec:chapter-facts:152e2293b052d1d2c01eeda85de1abf613432439527f6298ae5fa5ae1d90538d","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/chapter-facts-output.v1.json","output_sha256":"825ab87ff1e41b045c2c9b3df2b4055262bcd6dd9dba5203582bcc95c51667c8","prompt_sha256":"81a4f629a6890c6f801162e4a74b9ab00ea246faf6b827f82fb3d8a5fee50daf","provider_session_id":"9dec8bc3-df06-49b9-a894-84d6f8e9da18","requested_reasoning_effort":"max"},"schema":"model_response.v1"}