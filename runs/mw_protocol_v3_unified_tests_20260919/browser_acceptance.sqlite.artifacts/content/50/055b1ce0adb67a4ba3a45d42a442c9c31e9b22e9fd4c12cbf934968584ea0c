{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-12-8:v2\",\n  \"node_id\": \"v2_n_12_8\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"block_id\": \"block:v2_n_12_8:paragraph:001\",\n      \"kind\": \"paragraph\",\n      \"text\": \"本项目研究记录的保存安排按已确认的项目事实执行，覆盖需保存的记录类型、保存触发、保存期限、保存责任与控制边界、存储位置和保存期满处置。需保存的记录包括方案及修正案、知情同意书、伦理批件、病例报告表、源文件、随机化与盲底记录、试验用药品记录、安全性报告、监查或稽查记录、数据管理记录、审计轨迹、统计分析计划、分析数据集和临床研究报告。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"837-842\"\n    },\n    {\n      \"block_id\": \"block:v2_n_12_8:table:retention\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [],\n      \"table\": {\n        \"table_id\": \"table:v2_n_12_8:retention\",\n        \"block_id\": \"block:v2_n_12_8:table:retention\",\n        \"title\": \"研究记录保存安排\",\n        \"role\": \"body_content\",\n        \"domain\": \"generic\",\n        \"review_state\": \"ai_draft\",\n        \"header_row_count\": 1,\n        \"version\": 0,\n        \"schema_version\": \"structured_table_v1\",\n        \"source_locator\": \"837-842\",\n        \"columns\": [\n          {\n            \"column_id\": \"col:item\",\n            \"label\": \"项目\",\n            \"order\": 0,\n            \"semantic_role\": \"item\",\n            \"style_role\": \"header\",\n            \"source_locator\": \"837-842\"\n          },\n          {\n            \"column_id\": \"col:arrangement\",\n            \"label\": \"本项目安排\",\n            \"order\": 1,\n            \"semantic_role\": \"arrangement\",\n            \"style_role\": \"header\",\n            \"source_locator\": \"837-842\"\n          }\n        ],\n        \"rows\": [\n          {\n            \"row_id\": \"row:header\",\n            \"order\": 0,\n            \"style_role\": \"header\",\n            \"source_locator\": \"837-842\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:header:item\",\n                \"row_id\": \"row:header\",\n                \"column_id\": \"col:item\",\n                \"text\": \"项目\",\n                \"style_role\": \"header\",\n                \"source_locator\": \"837-842\",\n                \"provenance_lineage\": []\n              },\n              {\n                \"cell_id\": \"cell:header:arrangement\",\n                \"row_id\": \"row:header\",\n                \"column_id\": \"col:arrangement\",\n                \"text\": \"本项目安排\",\n                \"style_role\": \"header\",\n                \"source_locator\": \"837-842\",\n                \"provenance_lineage\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:record_types\",\n            \"order\": 1,\n            \"style_role\": \"body\",\n            \"source_locator\": \"837-842\",\n            \"cells\": [\n              {\n                \"cell_id\": \"retention:cell:record_types:label\",\n                \"row_id\": \"row:record_types\",\n                \"column_id\": \"col:item\",\n                \"text\": \"需保存的记录类型\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"837-842\",\n                \"provenance_lineage\": []\n              },\n              {\n                \"cell_id\": \"retention:cell:record_types\",\n                \"row_id\": \"row:record_types\",\n                \"column_id\": \"col:arrangement\",\n                \"text\": \"包括方案及修正案、知情同意书、伦理批件、病例报告表、源文件、随机化与盲底记录、试验用药品记录、安全性报告、监查或稽查记录、数据管理记录、审计轨迹、统计分析计划、分析数据集和临床研究报告。\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"837-842\",\n                \"provenance_lineage\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:trigger\",\n            \"order\": 2,\n            \"style_role\": \"body\",\n            \"source_locator\": \"837-842\",\n            \"cells\": [\n              {\n                \"cell_id\": \"retention:cell:trigger:label\",\n                \"row_id\": \"row:trigger\",\n                \"column_id\": \"col:item\",\n                \"text\": \"保存触发/起算\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"837-842\",\n                \"provenance_lineage\": []\n              },\n              {\n                \"cell_id\": \"retention:cell:trigger\",\n                \"row_id\": \"row:trigger\",\n                \"column_id\": \"col:arrangement\",\n                \"text\": \"保存期限自研究完成或终止时起算；以末例受试者末次访视、数据库锁定和最终研究报告归档完成中较晚者作为研究结束或终止的判定依据。\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"837-842\",\n                \"provenance_lineage\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:duration\",\n            \"order\": 3,\n            \"style_role\": \"body\",\n            \"source_locator\": \"837-842\",\n            \"cells\": [\n              {\n                \"cell_id\": \"retention:cell:duration:label\",\n                \"row_id\": \"row:duration\",\n                \"column_id\": \"col:item\",\n                \"text\": \"保存期限\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"837-842\",\n                \"provenance_lineage\": []\n              },\n              {\n                \"cell_id\": \"retention:cell:duration\",\n                \"row_id\": \"row:duration\",\n                \"column_id\": \"col:arrangement\",\n                \"text\": \"研究记录按适用法规和申办者标准操作规程要求的最长期限保存；通常不少于研究结束后5年，或至申办者确认无进一步监管、法律和科学需要为止。\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"837-842\",\n                \"provenance_lineage\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:custody\",\n            \"order\": 4,\n            \"style_role\": \"body\",\n            \"source_locator\": \"837-842\",\n            \"cells\": [\n              {\n                \"cell_id\": \"retention:cell:custody:label\",\n                \"row_id\": \"row:custody\",\n                \"column_id\": \"col:item\",\n                \"text\": \"保存责任与控制边界\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"837-842\",\n                \"provenance_lineage\": []\n              },\n              {\n                \"cell_id\": \"retention:cell:custody\",\n                \"row_id\": \"row:custody\",\n                \"column_id\": \"col:arrangement\",\n                \"text\": \"研究者或研究中心负责保存本中心研究记录和源文件；申办者负责保存其持有的方案、监管、监查、数据管理、统计和药物警戒记录。电子记录由验证系统管理员按权限保管。\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"837-842\",\n                \"provenance_lineage\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:storage_location\",\n            \"order\": 5,\n            \"style_role\": \"body\",\n            \"source_locator\": \"837-842\",\n            \"cells\": [\n              {\n                \"cell_id\": \"retention:cell:storage_location:label\",\n                \"row_id\": \"row:storage_location\",\n                \"column_id\": \"col:item\",\n                \"text\": \"存储位置\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"837-842\",\n                \"provenance_lineage\": []\n              },\n              {\n                \"cell_id\": \"retention:cell:storage_location\",\n                \"row_id\": \"row:storage_location\",\n                \"column_id\": \"col:arrangement\",\n                \"text\": \"纸质记录保存于研究中心和申办者指定的安全档案设施，限制访问并防火防潮；电子记录保存于经验证的电子归档系统，具备访问控制、备份和灾难恢复。\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"837-842\",\n                \"provenance_lineage\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:disposition\",\n            \"order\": 6,\n            \"style_role\": \"body\",\n            \"source_locator\": \"837-842\",\n            \"cells\": [\n              {\n                \"cell_id\": \"retention:cell:disposition:label\",\n                \"row_id\": \"row:disposition\",\n                \"column_id\": \"col:item\",\n                \"text\": \"保存期满处置\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"837-842\",\n                \"provenance_lineage\": []\n              },\n              {\n                \"cell_id\": \"retention:cell:disposition\",\n                \"row_id\": \"row:disposition\",\n                \"column_id\": \"col:arrangement\",\n                \"text\": \"保存期满后，按申办者标准操作规程和适用法规处置记录；纸质记录销毁、电子记录安全删除或永久去标识化，并保留销毁或处置清单和批准记录。未经授权不得提前销毁。\",\n                \"style_role\": \"body\",\n                \"source_locator\": \"837-842\",\n                \"provenance_lineage\": []\n              }\n            ]\n          }\n        ]\n      }\n    },\n    {\n      \"block_id\": \"block:v2_n_12_8:paragraph:002\",\n      \"kind\": \"paragraph\",\n      \"text\": \"保存责任、存储位置和期满处置按上表项目事实执行。表中“通常不少于研究结束后5年”系本项目保存期限安排的描述，不构成脱离本项目的普适法律规则。涉及参与者隐私、未来使用和补偿安排的记录保存边界，应与适用的知情同意、伦理批准及项目特定安排保持一致；本章未确认的具体安排不视为不适用，按待补/建议解决路径处理。涉及法规、GCP 条号或同意/保留法律措辞的引用仅作来源出处记录，适用性需由适用一手来源核验；本章不构成医学、伦理、法律或审批判断。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"837-842\"\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"1abf8dda748da8ba4013f006f6cb06f1bd1439d3f61ebc7cc155ba0b1756497f"}],"logical_call_id":"call:chapter-draft:d3aa0cde3a7177885baac5d87013beee8c021420cb547be983953a07aa561853:chapter-generate","node_execution_contract_id":"nec:chapter-draft:d3aa0cde3a7177885baac5d87013beee8c021420cb547be983953a07aa561853:chapter-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/ordered-chapter-draft-candidate.v1.json","output_sha256":"351f12182ff626802731d8d8936416845cbd360a99a63302