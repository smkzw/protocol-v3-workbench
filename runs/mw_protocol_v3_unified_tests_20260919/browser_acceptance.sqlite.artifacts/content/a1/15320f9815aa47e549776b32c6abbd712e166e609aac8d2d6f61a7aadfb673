{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-3-1-2-2:v2\",\n  \"node_id\": \"v2_n_3_1_2_2\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"block_id\": \"blk:v2_n_3_1_2_2:p:1\",\n      \"kind\": \"paragraph\",\n      \"text\": \"研究变量（估计目标属性二）列示主要估计目标的研究变量属性。研究变量为第24周临床缓解，定义为双侧鼻息肉评分（NPS）≤1且鼻塞VAS≤1。仅写“研究变量：疗效”等标签不构成可用的研究变量属性；须同时给出测量、聚合与时间点/时间窗。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:v2_n_3_1_2_2:tbl:variable-attributes\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [],\n      \"table\": {\n        \"table_id\": \"tbl:v2_n_3_1_2_2:variable-attributes\",\n        \"block_id\": \"blk:v2_n_3_1_2_2:tbl:variable-attributes\",\n        \"title\": \"主要估计目标研究变量属性表\",\n        \"domain\": \"objectives_endpoints\",\n        \"role\": \"body_content\",\n        \"header_row_count\": 1,\n        \"review_state\": \"ai_draft\",\n        \"columns\": [\n          {\n            \"column_id\": \"variable:col:attribute\",\n            \"label\": \"属性要素\",\n            \"order\": 0,\n            \"semantic_role\": \"attribute\",\n            \"style_role\": \"body\"\n          },\n          {\n            \"column_id\": \"variable:col:content\",\n            \"label\": \"研究变量属性内容\",\n            \"order\": 1,\n            \"semantic_role\": \"content\",\n            \"style_role\": \"body\"\n          },\n          {\n            \"column_id\": \"variable:col:source\",\n            \"label\": \"来源定位\",\n            \"order\": 2,\n            \"semantic_role\": \"source\",\n            \"style_role\": \"body\"\n          }\n        ],\n        \"rows\": [\n          {\n            \"row_id\": \"variable:row:variable\",\n            \"order\": 0,\n            \"label\": \"研究变量\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"variable:cell:attribute:variable\",\n                \"row_id\": \"variable:row:variable\",\n                \"column_id\": \"variable:col:attribute\",\n                \"text\": \"研究变量\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"variable:cell:variable\",\n                \"row_id\": \"variable:row:variable\",\n                \"column_id\": \"variable:col:content\",\n                \"text\": \"第24周临床缓解，定义为双侧鼻息肉评分（NPS）≤1且鼻塞VAS≤1。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"variable:cell:source:variable\",\n                \"row_id\": \"variable:row:variable\",\n                \"column_id\": \"variable:col:source\",\n                \"text\": \"\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"variable:row:measurement\",\n            \"order\": 1,\n            \"label\": \"测量\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"variable:cell:attribute:measurement\",\n                \"row_id\": \"variable:row:measurement\",\n                \"column_id\": \"variable:col:attribute\",\n                \"text\": \"测量\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"variable:cell:measurement\",\n                \"row_id\": \"variable:row:measurement\",\n                \"column_id\": \"variable:col:content\",\n                \"text\": \"NPS采用0～8分（每侧0～4分的双侧总和），缓解阈值为≤1分；鼻塞VAS采用0～10 cm视觉模拟量表，缓解阈值为≤1分；测量时点为第24周。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"variable:cell:source:measurement\",\n                \"row_id\": \"variable:row:measurement\",\n                \"column_id\": \"variable:col:source\",\n                \"text\": \"\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"variable:row:aggregation\",\n            \"order\": 2,\n            \"label\": \"聚合\",\n            \"style_role\": \"body\",\n            \"cells\": [\n              {\n                \"cell_id\": \"variable:cell:attribute:aggregation\",\n                \"row_id\": \"variable:row:aggregation\",\n                \"column_id\": \"variable:col:attribute\",\n                \"text\": \"聚合\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"variable:cell:aggregation\",\n                \"row_id\": \"variable:row:aggregation\",\n                \"column_id\": \"variable:col:content\",\n                \"text\": \"按受试者在第24周是否达到临床缓解进行二分类判定，并计算第24周临床缓解率（达到缓解的受试者人数/分析集受试者人数）。聚合单位为受试者；分析集为FAS（ITT原则）。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"variable:cell:source:aggregation\",\n                \"row_id\": \"variable:row:aggregation\",\n                \"column_id\": \"variable:col:source\",\n                \"text\": \"\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n    