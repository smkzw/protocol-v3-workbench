{"content":"{\n  \"chapters\": {\n    \"v2_n_11_1\": {\n      \"framing.structured_design.allocation_ratio\": {\n        \"ratio\": \"1:1\",\n        \"stratification_factor\": \"中心\",\n        \"design\": \"随机双盲、安慰剂对照\"\n      },\n      \"framing.structured_design.hypothesis\": {\n        \"type\": \"优效性\",\n        \"null\": \"合成药X组第24周临床缓解率不优于安慰剂组\",\n        \"alternative\": \"合成药X组第24周临床缓解率优于安慰剂组\",\n        \"alpha\": \"双侧0.05\",\n        \"power\": \"90%\"\n      },\n      \"statistics.sample_size.dose_alignment\": {\n        \"dose_regimen\": \"合成药X 150 mg/1.0 mL皮下注射，负荷期第1、8、15、22天每周一次共4次；维持期第36天起每两周一次至第24周末次给药；安慰剂为生理盐水1.0 mL，同途径同频率。\",\n        \"alignment\": \"样本量估算基于第24周主要终点临床缓解率，给药方案覆盖至第24周主要终点评估。\"\n      },\n      \"statistics.sample_size.interim_applicable\": false,\n      \"statistics.sample_size.reproducible_result\": {\n        \"unadjusted\": \"每组约184.1例可评价受试者，向上取整185例，总370例。\",\n        \"adjusted_for_attrition\": \"按8%失访膨胀并保守向上取整，每组约202例，总约404例。\",\n        \"parameters\": {\n          \"placebo_rate\": \"20%\",\n          \"test_rate\": \"35%\",\n          \"alpha\": \"双侧0.05\",\n          \"power\": \"90%\",\n          \"allocation\": \"1:1\",\n          \"attrition\": \"8%\",\n          \"method\": \"两独立比例的正态近似\"\n        }\n      },\n      \"statistics.sample_size.sidedness\": {\n        \"sidedness\": \"双侧\",\n        \"alpha\": \"0.05\"\n      },\n      \"statistics.sample_size.soa_alignment\": {\n        \"primary_endpoint_assessment\": \"第24周临床缓解率\",\n        \"schedule\": \"第24周评估；末次给药为第24周\",\n        \"alignment\": \"样本量估算的终点评估时间与SoA一致。\"\n      },\n      \"statistics.sample_size.test_model\": {\n        \"primary_analysis_model\": \"按中心分层的CMH检验\",\n        \"effect_measure\": \"风险差及95%CI\",\n        \"population\": \"FAS（ITT原则）\"\n      }\n    },\n    \"v2_n_11_2\": {\n      \"statistics.analysis_sets.available_assessments\": {\n        \"FAS\": \"全分析集，ITT原则，主要疗效分析集，所有随机受试者按随机分组分析。\",\n        \"Treated\": \"接受过至少一次研究药物的受试者，可用于依从性和安全性描述。\"\n      },\n      \"statistics.analysis_sets.grouping_rules\": {\n        \"analysis_groups\": \"合成药X组与安慰剂组，按随机分组分析。\",\n        \"stratification\": \"主要分析按中心分层。\"\n      },\n      \"statistics.analysis_sets.handling_rules\": {\n        \"missing_primary_endpoint\": \"第24周缺失主要终点采用无应答插补（NRI）。\",\n        \"intercurrent_events\": \"ICE按治疗策略处理，受试者留在FAS中按随机分组分析。\",\n        \"sensitivity\": \"敏感性分析采用tipping point。\"\n      },\n      \"statistics.analysis_sets.inclusion_rules\": {\n        \"FAS\": \"所有随机受试者均纳入FAS。\",\n        \"Treated\": \"至少接受一次研究药物（合成药X或安慰剂）的受试者。\"\n      },\n      \"statistics.analysis_sets.randomized\": {\n        \"definition\": \"所有经随机化分配的受试者。\",\n        \"use\": \"作为FAS/ITT分析的基础，按随机分组分析。\"\n      },\n      \"statistics.analysis_sets.rescue_treated_handling\": {\n        \"rescue_definition\": \"因鼻塞加重使用全身激素或鼻窦手术。\",\n        \"handling\": \"救援治疗不导致受试者排除；按治疗策略处理，受试者留在FAS中按随机分组分析。\"\n      },\n      \"statistics.analysis_sets.treated\": {\n        \"definition\": \"接受过至少一次研究药物（合成药X或安慰剂）的受试者。\",\n        \"use\": \"可用于依从性和安全性描述；不替代主要疗效分析集FAS。\"\n      }\n    },\n    \"v2_n_11_3\": {\n      \"statistics.descriptive.intercurrent_event_distinction\": {\n        \"ice_events\": \"鼻塞加重需全身激素或手术干预、因不良事件停药、失访。\",\n        \"distinction\": \"ICE需与缺失数据区分；ICE按治疗策略处理，主要终点缺失采用NRI，敏感性分析采用tipping point。\"\n      },\n      \"statistics.descriptive.missing_denominator_rules\": {\n        \"continuous\": \"以分析集中具有非缺失数据的受试者数作为分母，并报告缺失例数。\",\n        \"categorical\": \"以分析集中具有该评估的受试者数作为分母，并报告缺失例数。\"\n      },\n      \"statistics.descriptive.missing_outcome_handling\": {\n        \"primary\": \"第24周缺失主要终点采用无应答插补（NRI）。\",\n        \"sensitivity\": \"敏感性分析采用tipping point。\"\n      },\n      \"statistics.descriptive.summary_conventions\": {\n        \"continuous\": \"汇总均值、标准差、中位数、最小值、最大值。\",\n        \"categorical\": \"汇总频数和百分比。\",\n        \"by_group\": \"按治疗组进行描述性汇总。\"\n      },\n      \"statistics.descriptive.variable_types\": {\n        \"continuous\": \"NPS、鼻塞VAS、SNOT-22、Lund-Kennedy评分等。\",\n        \"categorical\": \"治疗组、临床缓解（是/否）、背景鼻用激素使用等。\"\n      }\n    },\n    \"v2_n_11_4_1\": {\n      \"statistics.demographics.baseline_variables\": {\n        \"demographics\": \"年龄、性别等人口学特征。\",\n        \"disease_baseline\": \"双侧NPS、鼻塞VAS、SNOT-22、Lund-Kennedy内镜评分、背景鼻用激素使用。\"\n      },\n      \"statistics.demographics.data_definition\": {\n        \"baseline\": \"基线定义为首次给药前的评估值。\",\n        \"change_from_baseline\": \"第24周变化值 = 第24周评分 - 基线评分。\"\n      },\n      \"statistics.demographics.summary_methods\": {\n        \"continuous\": \"均值、标准差、中位数、最小值、最大值。\",\n        \"categorical\": \"频数和百分比。\",\n        \"grouping\": \"按治疗组汇总。\"\n      },\n      \"statistics.demographics.variable_types\": {\n        \"continuous\": \"年龄、NPS、鼻塞VAS、SNOT-22、Lund-Kennedy评分。\",\n        \"categorical\": \"性别、背景鼻用激素使用、治疗组。\"\n      }\n    },\n    \"v2_n_11_4_2\": {\n      \"statistics.adherence.data_definition\": {\n        \"source\": \"给药记录/注射日志。\",\n        \"variables\": \"计划给药次数、实际给药次数、给药时间。\"\n      },\n      \"statistics.adherence.definition\": {\n        \"definition\": \"依从性 = 实际接受研究药物的次数/剂量占计划给药次数/剂量的比例。\"\n      },\n      \"statistics.adherence.denominator\": {\n        \"denominator\": \"按方案计划的给药次数（负荷期4次；维持期第36天起每两周一次至第24周末次给药）。\",\n        \"numerator\": \"实际给药次数。\"\n      },\n      \"statistics.adherence.measurement_method\": {\n        \"method\": \"按受试者计算依从率，并按治疗组进行描述性汇总。\",\n        \"summary\": \"均值、标准差、中位数、范围及分类频数。\"\n      },\n      \"statistics.concomitant_treatment.definition\": {\n        \"definition\": \"研究期间使用的除研究药物外的药物或治疗，包括允许的稳定背景鼻用激素。\",\n        \"rescue\": \"因鼻塞加重使用全身激素或鼻窦手术按救援治疗和ICE定义记录。\"\n      },\n      \"statistics.concomitant_treatment.timing\": {\n        \"timing\": \"研究期间，包括基线时已稳定使用的背景鼻用激素及研究期间新使用的合并用药，按CRF记录。\"\n      }\n    },\n    \"v2_n_11_4_3_1\": {\n      \"estimand.primary.intercurrent_events\": {\n        \"events\": \"鼻塞加重需全身激素或手术干预、因不良事件停药、失访。\",\n        \"strategy\": \"ICE按治疗策略处理；救援治疗定义为因鼻塞加重使用全身激素或鼻窦手术。\"\n      },\n      \"estimand.primary.population\": {\n        \"population\": \"成人慢性鼻窦炎伴鼻息肉患者。\",\n        \"analysis_set\": \"FAS（ITT原则），按随机分组分析。\",\n        \"concomitant\": \"允许稳定背景鼻用激素并记录。\"\n      },\n      \"estimand.primary.treatment_condition\": {\n        \"active\": \"合成药X 150 mg/1.0 mL皮下注射，负荷期第1、8、15、22天每周一次共4次，维持期第36天起每两周一次至第24周末次给药。\",\n        \"control\": \"生理盐水安慰剂1.0 mL，皮下注射，同体积同途径同频率。\"\n      },\n      \"statistics.primary_analysis.analysis_set\": {\n        \"analysis_set\": \"FAS（ITT原则）。\",\n        \"grouping\": \"按随机分组分析。\"\n      },\n      \"statistics.primary_analysis.dose_consistency\": {\n        \"dose_regimen\": \"合成药X 150 mg/1.0 mL皮下，负荷第1、8、15、22天，维持第36天起每两周一次至第24周；安慰剂同体积同途径同频率。\",\n        \"consistency\": \"主要分析中的治疗条件与方案规定一致。\"\n      },\n      \"statistics.primary_analysis.effect_measure\": {\n        \"effect_measure\": \"风险差（合成药X组与安慰剂组第24周临床缓解率之差）。\",\n        \"ci\": \"95%CI。\"\n      },\n      \"statistics.primary_analysis.estimand_linkage\": {\n        \"linkage\": \"主要分析直接对应主要估计目标：FAS、治疗策略、第24周临床缓解率。\",\n        \"missing\": \"第24周缺失采用NRI。\"\n      },\n      \"statistics.primary_analysis.method\": {\n        \"method\": \"按中心分层的CMH检验。\",\n        \"effect_measure\": \"风险差及95%CI。\"\n      },\n      \"statistics.primary_analysis.missing_data\": {\n        \"primary\": \"第24周缺失主要终点采用无应答插补（NRI）。\",\n        \"sensitivity\": \"敏感性分析采用tipping point。\"\n      },\n      \"statistics.primary_analysis.soa_consistency\": {\n        \"assessment_time\": \"第24周。\",\n        \"schedule\": \"与SoA第24周访视一致；末次给药为第24周。\"\n      }\n    },\n    \"v2_n_11_4_3_2\": {\n      \"statistics.sensitivity_analysis.assumption\": {\n        \"assumption\": \"主要分析采用NRI处理第24周缺失主要终点；敏感性分析采用tipping point考察不同缺失假设。\"\n      },\n      \"statistics.sensitivity_analysis.estimand_alignment\": {\n        \"alignment\": \"保持与主要估计目标一致：FAS、治疗策略、第24周临床缓解率、风险差。\"\n      },\n      \"statistics.sensitivity_analysis.method\": {\n        \"method\": \"tipping point分析。\"\n      },\n      \"statistics.sensitivity_analysis.missing_data_handling\": {\n        \"handling\": \"对第24周缺失主要终点，从NRI逐步改变插补假设，寻找结论翻转的临界点。\"\n      },\n      \"statistics.sensitivity_analysis.primary_method_link\": {\n        \"link\": \"与主要分析（按中心分层CMH检验，风险差及95%CI）对应，仅改变缺失数据处理假设。\"\n      },\n      \"statistics.sensitivity_analysis.result_interpretation\": {\n        \"interpretation\": \"评价主要结论对缺失数据假设的稳健性；若tipping point远离合理范围，则支持主要分析结论。\"\n      }\n    },\n    \"v2_n_11_4_4\": {\n      \"statistics.secondary_analysis.analysis_set\": {\n        \"analysis_set\": \"FAS（ITT原则），按随机分组分析。\"\n      },\n      \"statistics.secondary_analysis.data_definition\": {\n        \"snot22\": \"第24周SNOT-22较基线变化。\",\n        \"lund_kennedy\": \"第24周Lund-Kennedy内镜评分较基线变化。\"\n      },\n      \"statistics.secondary_analysis.endpoint_definitions\": {\n        \"snot22\": \"关键次要终点，第24周SNOT-22较基线变化，采用固定序列检验控制多重性。\",\n        \"lund_kennedy\": \"第24周Lund-Kennedy内镜评分较基线变化，描述性分析。\"\n      },\n      \"statistics.secondary_analysis.methods\": {\n        \"snot22\": \"固定序列检验控制多重性。\",\n        \"lund_kennedy\": \"描述性分析。\"\n      }\n    }\n  }\n}","receipt":{"idempotency_key":"chapter-facts.derive.v1","input_artifacts":[{"ref":"chapter-facts-input","sha256":"7ce9d5c5b7444d835e88e64f44caba3bd81168374ceea17d2d926807352249dd"}],"logical_call_id":"call:chapter-facts:7ce9d5c5b7444d835e88e64f44caba3bd81168374ceea17d2d926807352249dd","node_execution_contract_id":"nec:chapter-facts:7ce9d5c5b7444d835e88e64f44caba3bd81168374ceea17d2d926807352249dd","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/chapter-facts-output.v1.json","output_sha256":"8f70904a05c61b93bbaae151da542fd702e0d38840eeb294ef4a24f8e8087b99","prompt_sha256":"81a4f629a6890c6f801162e4a74b9ab00ea246faf6b827f82fb3d8a5fee50daf","provider_session_id":"8486733d-8605-4570-820e-ac3c3906cbda","requested_reasoning_effort":"max"},"schema":"model_response.v1"}