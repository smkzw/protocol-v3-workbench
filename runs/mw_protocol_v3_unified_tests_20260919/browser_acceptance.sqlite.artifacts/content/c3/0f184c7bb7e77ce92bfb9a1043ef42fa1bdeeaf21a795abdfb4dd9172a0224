{"content":"{\n  \"status\": \"ready_for_review\",\n  \"objectives\": {\n    \"primary\": [\n      {\n        \"text\": \"在慢性鼻窦炎伴鼻息肉成人患者中，评价合成药X 150 mg/1.0 mL皮下给药方案（第1、8、15、22天每周一次负荷共4次；第36天起每两周一次维持至第24周末次给药）相对于生理盐水安慰剂的优效性，主要比较第24周临床缓解率。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"用户简述已确认Ⅱ期概念验证、随机双盲、安慰剂对照、优效性检验及第24周临床缓解率主要终点；本条为与已确认事实一致的设计要素建议。\",\n        \"references\": []\n      }\n    ],\n    \"secondary\": [\n      {\n        \"text\": \"评价合成药X相对于安慰剂在第24周SNOT-22评分较基线的变化。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"用户简述明确SNOT-22变化为次要终点，且关键次要终点采用固定序列检验控制多重性。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"评价合成药X相对于安慰剂在第24周Lund-Kennedy内镜评分较基线的变化。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"用户简述明确Lund-Kennedy内镜评分为次要终点，并采用描述性分析。\",\n        \"references\": []\n      }\n    ],\n    \"questions\": []\n  },\n  \"endpoint\": {\n    \"primary_endpoint\": {\n      \"text\": \"第24周临床缓解率，缓解定义为双侧鼻息肉评分（NPS）≤1且鼻塞VAS≤1。NPS采用0～8分（每侧0～4分的双侧总和）；鼻塞VAS采用0～10 cm视觉模拟量表，缓解阈值为≤1分。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"用户简述已给出主要终点操作定义；虽然标注为建议值，按输入采纳为推荐并进入审阅。\",\n      \"references\": []\n    },\n    \"key_secondary\": [\n      {\n        \"text\": \"第24周SNOT-22评分较基线变化，作为关键次要终点，采用固定序列检验控制多重性。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"用户简述明确SNOT-22为关键次要终点并采用固定序列检验。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"第24周Lund-Kennedy内镜评分较基线变化，描述性分析。\",\n        \"basis\": \"recommendation\",\n        \"reason\": \"用户简述明确Lund-Kennedy为次要终点且为描述性分析。\",\n        \"references\": []\n      }\n    ],\n    \"measurement_details\": \"主要终点在第24周评估；NPS为0～8分，每侧0～4分；鼻塞VAS为0～10 cm，缓解阈值为≤1分；次要终点均在第24周评估。SNOT-22为关键次要终点并采用固定序列检验；Lund-Kennedy为描述性分析。\",\n    \"questions\": []\n  },\n  \"estimand\": {\n    \"treatment\": {\n      \"text\": \"合成药X 150 mg/1.0 mL皮下注射：第1、8、15、22天每周一次负荷共4次；第36天起每两周一次维持至第24周末次给药。对照为生理盐水安慰剂1.0 mL皮下注射，同体积、同途径、同频率。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"用户简述与给药方案已确认研究药和安慰剂剂量、途径、频率及周期。\",\n      \"references\": []\n    },\n    \"population\": {\n      \"text\": \"FAS（ITT原则），纳入随机化患者并按随机分组分析；允许稳定背景鼻用激素并记录。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"用户简述明确主要分析集为FAS（ITT原则），并允许稳定背景鼻用激素。\",\n      \"references\": []\n    },\n    \"variable\": {\n      \"text\": \"第24周临床缓解（是/否），定义为双侧NPS≤1且鼻塞VAS≤1；NPS为0～8分（每侧0～4分总和），鼻塞VAS为0～10 cm，缓解阈值为≤1分。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"用户简述已给出主要终点操作定义。\",\n      \"references\": []\n    },\n    \"ice_strategy\": {\n      \"text\": \"ICE按治疗策略（treatment policy）处理：发生ICE后不剔除患者，按随机分组纳入主要分析；救援治疗定义为因鼻塞加重使用全身激素或鼻窦手术。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"用户简述明确ICE按治疗策略处理，并给出救援治疗定义。\",\n      \"references\": []\n    },\n    \"summary_measure\": {\n      \"text\": \"第24周临床缓解率的风险差，采用CMH分层检验并报告95%CI；主要分析中第24周缺失主要终点采用无应答插补（NRI），敏感性分析采用tipping point。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"用户简述明确主要分析采用CMH分层检验、风险差及95%CI，缺失采用NRI，敏感性分析采用tipping point。\",\n      \"references\": []\n    },\n    \"ice_events\": [\n      \"鼻塞加重需全身激素或手术干预\",\n      \"因不良事件停药\",\n      \"失访\",\n      \"救援治疗：因鼻塞加重使用全身激素或鼻窦手术\"\n    ],\n    \"questions\": []\n  },\n  \"interim_planning\": null,\n  \"non_inferiority_margin\": null,\n  \"sample_size\": {\n    \"assumptions\": [\n      \"随机1:1，按中心分层；主要分析采用CMH分层检验并报告风险差及95%CI。\",\n      \"安慰剂组第24周临床缓解率20%，试验组35%，绝对差15%。\",\n      \"双侧α=0.05，power=90%，采用两独立比例正态近似；假设无中心效应，CMH分层检验与不分层近似信息量一致。\",\n      \"失访率8%，第24周缺失主要终点采用NRI。\",\n      \"主要分析集为FAS（ITT原则），无期中分析计划。\"\n    ],\n    \"alpha\": \"双侧0.05\",\n    \"power\": \"90%\",\n    \"model\": \"两独立比例正态近似（1:1分配）；主要分析为CMH分层检验，报告风险差及95%CI。\",\n    \"planned_n\": \"约404例随机化（每组202例）；对应可评价约370例（每组185例），按8%失访膨胀。\",\n    \"attrition\": \"8%（第24周主要终点缺失，按NRI处理并用于样本量膨胀）\",\n    \"justification\": \"计算输入：p1=0.20，p2=0.35，pbar=0.275，Δ=0.15，z0.975=1.960，z0.90=1.282。公式 n/组=(z0.975*sqrt(2*pbar*(1-pbar))+z0.90*sqrt(p1*(1-p1)+p2*(1-p2)))^2/Δ^2，得约185例/组，可评价总计约370例；按8%失访膨胀并向上取整为202例/组，共404例随机化。\",\n    \"questions\": [],\n    \"references\": []\n  },\n  \"questions\": [],\n  \"unresolved_questions\": []\n}","receipt":{"idempotency_key":"design-elements.generate.v1","input_artifacts":[{"ref":"design-elements-intake","sha256":"fb306ce4504d975360246542ff03154eca07814c4a81b3518b36ab49ec436a4b"}],"logical_call_id":"call:design-elements:c402ed7b9df28344ee31b319d657accc27c04fd61ec26a583ec2290d5f73c81d:design-generate","node_execution_contract_id":"nec:design-elements:c402ed7b9df28344ee31b319d657accc27c04fd61ec26a583ec2290d5f73c81d:design-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/design-elements-output.v1.json","output_sha256":"27a67560bc95c6d9cb6fdc3994ea6f79c48a631b0fdda1302812365337618e4c","prompt_sha256":"21bf2955294ee9cc2fd35ad41a9fec8e8279bf3e566b47d7babf7c624d527a38","provider_session_id":"81e5cc2c-a86a-4b58-84e0-a38c2123c480","requested_reasoning_effort":"max"},"schema":"model_response.v1"}