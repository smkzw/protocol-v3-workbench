a_version\": \"structured_table_v1\",\n        \"version\": 0,\n        \"source_locator\": \"\",\n        \"word_layout\": {}\n      }\n    },\n    {\n      \"block_id\": \"blk:v2_n_9_2:p3\",\n      \"kind\": \"paragraph\",\n      \"text\": \"生命体征、体格检查、注射部位反应及其他临床需要的检查按方案规定记录；其单位与参考范围按方案或研究中心标准记录。对具有临床意义的异常实验室检查、生命体征或其他安全性结果，应重复检测确认；若重复仍异常或加重，按不良事件或严重不良事件处理，并评估是否暂停或永久停用研究干预。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:v2_n_9_2:p4\",\n      \"kind\": \"paragraph\",\n      \"text\": \"安全性评估覆盖筛选期、基线、负荷期、维持期至第24周末次给药及安全性随访；访视窗口按方案规定执行，并与SoA一致。监测计划按筛选期、基线、负荷期第1、8、15、22天、维持期第36天起每两周至第24周及安全性随访进行安全性评估；不良事件和严重不良事件按方案规定持续收集至安全性随访结束。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:v2_n_9_2:p5\",\n      \"kind\": \"paragraph\",\n      \"text\": \"标本类型包括血液、尿液等，按当地实验室和方案要求采集、处理、储存和运输；注射部位反应和不良事件记录不涉及特殊标本。本方案未规定特殊检测；常规安全性实验室检查用于安全性监测。用于方案规定安全性或疗效评估的标本与未来研究用标本应区分；未来使用需在知情同意中单独说明并取得同意，未同意者标本不用于未来研究。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:v2_n_9_2:p6\",\n      \"kind\": \"paragraph\",\n      \"text\": \"安全性评估按统一方案和访视窗口进行；评估前避免使用可能干扰判断的合并用药或操作，若发生需记录。不良事件和严重不良事件按GCP报告。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"2f58eb759ad4656990af01ba4115cfdc651f77f40b303fb29b6c58b6b9ce0785"}],"logical_call_id":"call:chapter-draft:90e6da79d54df64887166e0c78c65ae0dfae81b2cdc205400b54b306c715ccdb:chapter-generate","node_execution_contract_id":"nec:chapter-draft:90e6da79d54df64887166e0c78c65ae0dfae81b2cdc205400b54b306c715ccdb:chapter-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/ordered-chapter-draft-candidate.v1.json","output_sha256":"d2a2760fc1383ba955126fd028b7448cecb65d1b97c2e1378b53