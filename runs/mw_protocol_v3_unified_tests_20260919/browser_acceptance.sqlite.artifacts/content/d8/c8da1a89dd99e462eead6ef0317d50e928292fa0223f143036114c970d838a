{"content":"{\n  \"chapters\": {\n    \"v2_n_12_4\": {\n      \"corrections.audit_trail\": {\n        \"system\": \"电子数据采集或数据管理系统应自动生成审计轨迹。\",\n        \"content\": [\n          \"修改前值\",\n          \"修改后值\",\n          \"修改时间\",\n          \"操作者身份\",\n          \"修改原因\",\n          \"电子签名（如适用）\"\n        ],\n        \"requirements\": [\n          \"不可删除或覆盖原始记录\",\n          \"可与源数据关联并追溯\",\n          \"保留至研究记录保存期限\"\n        ]\n      },\n      \"corrections.procedure\": {\n        \"paper\": \"纸质源数据修改采用单线划改，保留原记录，由修改者签名并注明日期和原因；不得涂改或覆盖。\",\n        \"electronic\": \"电子数据修改通过经验证的系统进行，系统保留审计轨迹，修改需有权限并记录原因。\",\n        \"source_vs_crf\": \"源数据与CRF或电子数据不一致时，应依据源数据核实并记录澄清或修改，必要时由研究者确认。\",\n        \"queries\": \"数据质疑由数据管理或监查发出，研究者或授权人员答复，关闭前需审核。\"\n      },\n      \"corrections.reason_record\": {\n        \"required\": true,\n        \"categories\": [\n          \"数据录入错误\",\n          \"源数据澄清\",\n          \"访视日期或时间修正\",\n          \"实验室数据修正\",\n          \"编码修正\",\n          \"方案偏离相关修正\",\n          \"其他经批准原因\"\n        ],\n        \"content\": \"每条修改或质疑答复均记录原因、修改人和日期；原因应具体可审核，不得使用无意义说明。\"\n      },\n      \"corrections.review_approval\": {\n        \"review\": \"数据修改和质疑关闭由数据管理员、监查员及研究者按职责审核；关键数据由医学或统计人员审核。\",\n        \"approval\": \"涉及主要终点、安全性、入排标准、知情同意等关键数据的修改，需研究者或授权研究者确认或批准。\",\n        \"independence\": \"修改者与批准者应符合权限矩阵；电子签名与登录身份唯一对应。\"\n      }\n    },\n    \"v2_n_12_5\": {\n      \"lock_export.export_format\": {\n        \"general\": \"按数据管理计划和统计分析计划规定的格式导出；用于分析的导出数据集应与锁库版本一致。\",\n        \"possible_formats\": [\n          \"SAS数据集\",\n          \"CSV\",\n          \"Excel（仅用于审核或传输，分析以确定格式为准）\",\n          \"CDISC SDTM或ADaM（如监管递交要求）\"\n        ],\n        \"requirements\": [\n          \"版本号和日期\",\n          \"变量标签或编码说明\",\n          \"传输加密\",\n          \"校验和或哈希\"\n        ]\n      },\n      \"lock_export.export_receipt\": {\n        \"required\": true,\n        \"content\": [\n          \"导出时间\",\n          \"导出人或系统\",\n          \"数据集名称和版本\",\n          \"接收方\",\n          \"用途\",\n          \"校验和或哈希\",\n          \"接收确认签名或日期\"\n        ],\n        \"retention\": \"导出记录和接收回执作为数据管理文件或试验主文件保存。\"\n      },\n      \"lock_export.lock_authority\": {\n        \"authority\": \"数据库锁库由申办者数据管理部门会同主要研究者、生物统计师和质量保证人员按职责批准。\",\n        \"documentation\": \"锁库决定、锁库日期、参与人员、未决事项及处理意见应书面记录。\",\n        \"responsibility\": \"主要研究者对医学和源数据完整性负责；数据管理员对数据库清理和锁定操作负责；统计师对分析数据集锁定负责。\"\n      },\n      \"lock_export.lock_criteria\": {\n        \"criteria\": [\n          \"所有受试者已完成或终止研究，末次访视数据已录入\",\n          \"所有数据质疑已解决或经批准保留\",\n          \"方案偏离和重大方案偏离已审核并分类\",\n          \"严重不良事件与安全性数据库一致\",\n          \"入排标准、主要终点、知情同意等关键数据已核验\",\n          \"中心已关闭或完成数据清理\",\n          \"分析人群定义已确定并经审核\",\n          \"锁库前检查清单完成，批准签字齐全\"\n        ],\n        \"timing\": \"在主要分析前、揭盲或统计分析前完成；锁库后如需修改，按解锁或变更控制程序执行并保留审计轨迹。\"\n      }\n    },\n    \"v2_n_12_6\": {\n      \"data_governance.access_controls\": {\n        \"principle\": \"基于角色和最小权限原则分配系统访问权限。\",\n        \"measures\": [\n          \"唯一用户账号，禁止共享账号\",\n          \"强密码和定期更换，必要时多因素认证\",\n          \"按角色授权，离岗或转岗及时禁用或调整\",\n          \"登录失败锁定和会话超时\",\n          \"访问日志和审计轨迹定期审核\"\n        ],\n        \"data_scope\": \"受试者隐私数据、源数据、电子数据采集、随机化和揭盲信息、安全性数据按需授权。\"\n      },\n      \"data_governance.change_management\": {\n        \"procedure\": \"计算机化系统、电子数据采集系统、随机化系统、统计程序等的变更须经申请、影响评估、批准、测试、实施和记录。\",\n        \"assessment\": \"评估对数据完整性、受试者安全、系统验证状态和统计分析的影响；必要时更新验证文档和标准操作规程。\",\n        \"documentation\": \"变更申请、测试证据、批准记录、回滚计划和实施日期纳入系统生命周期文件。\"\n      },\n      \"data_governance.record_integrity\": {\n        \"principles\": \"遵循ALCOA+原则：可归属、易读、同步记录、原始、准确、完整、一致、持久、可获得。\",\n        \"controls\": [\n          \"审计轨迹\",\n          \"电子签名\",\n          \"时间戳\",\n          \"备份与灾难恢复\",\n          \"数据校验和逻辑核查\",\n          \"权限控制\",\n          \"源数据核验\"\n        ],\n        \"retention\": \"数据与元数据按研究记录保存期限保存，确保可重建和可审计。\"\n      },\n      \"data_governance.system_roles\": {\n        \"roles\": [\n          {\n            \"role\": \"主要研究者或研究者\",\n            \"access\": \"查看、录入或审核其授权受试者数据，批准关键修改\"\n          },\n          {\n            \"role\": \"研究协调员\",\n            \"access\": \"按授权录入数据和答复质疑\"\n          },\n          {\n            \"role\": \"数据管理员\",\n            \"access\": \"建库、质疑管理、数据清理、锁库和导出\"\n          },\n          {\n            \"role\": \"监查员\",\n            \"access\": \"源数据核验、质疑发起和跟踪，不修改源数据\"\n          },\n          {\n            \"role\": \"生物统计师\",\n            \"access\": \"分析数据集和统计程序，按权限访问锁库数据\"\n          },\n          {\n            \"role\": \"系统管理员\",\n            \"access\": \"账号和权限管理、系统维护，按权限隔离揭盲信息\"\n          },\n          {\n            \"role\": \"申办者或质量保证\",\n            \"access\": \"稽查和监督所需权限\"\n          }\n        ],\n        \"principle\": \"权限矩阵应经批准并定期复核。\"\n      },\n      \"data_governance.validation_status\": {\n        \"status\": \"凡用于本研究的计算机化系统在投入使用前应完成验证，并在变更后保持验证状态。\",\n        \"requirements\": [\n          \"用户需求规格\",\n          \"风险评估\",\n          \"验证计划、测试脚本和测试报告\",\n          \"电子签名和审计轨迹符合GCP及适用法规\",\n          \"定期回顾\",\n          \"偏差和变更管理\"\n        ],\n        \"evidence\": \"验证文件作为试验主文件或系统生命周期文件保存。\"\n      }\n    },\n    \"v2_n_12_7\": {\n      \"future_use.applicable\": {\n        \"applicable\": false,\n        \"rationale\": \"已确认研究设计事实中未设置储备样本库、遗传样本或数据的未来使用；因此本方案不包含超出当前研究目的的样本或数据未来使用。\",\n        \"conditions\": \"如未来拟使用，须另行获得伦理委员会批准和受试者知情同意或适用的豁免授权，并符合隐私和数据保护要求。\"\n      },\n      \"future_use.current_study_assay_separation\": {\n        \"separation\": \"当前研究样本和数据的检测或分析仅用于本方案预设目的，包括主要终点、次要终点、安全性和数据管理。\",\n        \"future_use\": \"任何未来研究用途应与当前研究检测在伦理审批、知情同意、样本或数据编码、存储和访问权限上分离。\",\n        \"traceability\": \"如发生未来使用，应可追溯样本或数据来源、授权范围和使用记录；未获授权不得用于未来研究。\"\n      }\n    },\n    \"v2_n_12_8\": {\n      \"retention.custody\": {\n        \"custodian\": \"主要研究者和临床试验机构负责研究记录和源数据的保管；申办者负责其必备文件和系统数据的保管。\",\n        \"delegation\": \"保管责任可书面委托，但最终责任不转移；监查、稽查和监管检查时应可及时提供。\",\n        \"confidentiality\": \"受试者身份信息保密，仅授权人员可访问。\"\n      },\n      \"retention.disposition\": {\n        \"procedure\": \"保存期满后，按机构标准操作规程、申办者要求和适用法规销毁或匿名化；不得擅自丢弃。\",\n        \"documentation\": \"处置需经批准并记录处置日期、方式、记录类型、执行人和见证人。\",\n        \"legal_hold\": \"涉及未决监管问题、诉讼、稽查或申办者要求时，暂停处置直至解除。\"\n      },\n      \"retention.duration\": {\n        \"general\": \"按ICH GCP、中国GCP及适用法规和机构标准操作规程保存；至少至研究结束后5年，或至试验药物上市后2年（如适用），以较长者为准。\",\n        \"agreement\": \"如申办者与机构另有书面约定或法规要求更长，从其约定或要求。\",\n        \"trigger\": \"保存期限自研究结束、终止或适用法规规定的触发事件起算。\"\n      },\n      \"retention.record_types\": {\n        \"types\": [\n          \"源数据和源文件\",\n          \"知情同意书\",\n          \"CRF或电子数据及审计轨迹\",\n          \"伦理审批文件\",\n          \"方案及修正案\",\n          \"安全性报告\",\n          \"随机化和揭盲记录\",\n          \"监查和稽查记录\",\n          \"样本管理记录（如适用）\",\n          \"统计分析计划、分析数据集和程序\",\n          \"试验主文件\",\n          \"通信和培训记录\"\n        ],\n        \"format\": \"纸质和电子记录均需保存，电子记录保持可读、可恢复和可审计。\"\n      },\n      \"retention.storage_location\": {\n        \"location\": \"临床试验机构档案室或申办者指定档案系统；电子数据存储在经验证的服务器或电子归档系统中。\",\n        \"requirements\": [\n          \"防火、防潮、防盗和访问控制\",\n          \"备份和灾难恢复\",\n          \"环境与介质管理\",\n          \"电子系统版本兼容或迁移计划\"\n        ],\n        \"access\": \"仅授权人员在受控条件下访问。\"\n      },\n      \"retention.trigger\": {\n        \"trigger_events\": \"研究结束、研究终止、药物获批或上市、监管要求或申办者书面通知。\",\n        \"start\": \"按适用法规确定起算点；通常从研究结束或终止日起算。\",\n        \"review\": \"保存期间定期检查可及性和完整性，到期前评估是否延长。\"\n      }\n    },\n    \"v2_n_12_9\": {\n      \"publication.actual_agreements\": {\n        \"status\": \"本方案未设置单独的发表或数据共享协议作为方案正文；若申办者、研究机构和研究者另行签署书面协议，以该协议为准。\",\n        \"principles\": \"协议不得限制研究者依法、符合伦理地发表研究结果；应明确作者、数据使用、发表时机和申办者审阅范围。\",\n        \"documentation\": \"相关协议作为试验主文件保存。\"\n      },\n      \"publication.authorship_roles\": {\n        \"criteria\": \"作者资格按ICMJE标准：实质性贡献、参与起草或修订、最终批准、对内容负责。\",\n        \"roles\": [\n          \"主要研究者或研究者\",\n          \"统计师\",\n          \"申办者代表或医学负责人（如符合ICMJE标准）\",\n          \"医学写作或数据管理人员（仅在其有实质性贡献时）\"\n        ],\n        \"prohibited\": \"禁止荣誉作者和幽灵作者；所有作者需披露利益冲突。\"\n      },\n      \"publication.data_sharing_conditions\": {\n        \"timing\": \"通常在主要结果发表后共享；未发表期间一般仅限研究团队和监管用途。\",\n        \"conditions\": [\n          \"去标识化数据\",\n          \"合理书面申请和研究方案\",\n          \"数据使用协议\",\n          \"伦理或隐私审查（如适用）\",\n          \"不用于再识别\",\n          \"接收方保密和安全措施\"\n        ],\n        \"scope\": \"共享内容可包括分析数据集、统计代码和结果报告，具体以协议和适用法规为准。\"\n      },\n      \"publication.disclosure_plan\": {\n        \"registration\": \"在首个受试者入组前，按适用法规在公共临床试验注册平台注册并保持更新。\",\n        \"results\": \"研究完成后按法规和ICMJE要求公开结果摘要、论文或监管递交信息；披露资金来源、利益冲突和试验药物信息。\",\n        \"timing\": \"结果披露时间应符合注册平台、期刊和适用法规要求。\"\n      },\n      \"publication.recipient_controls\": {\n        \"recipient_obligations\": [\n          \"签署保密或数据使用协议\",\n          \"遵守伦理和隐私法规\",\n          \"仅用于批准的研究目的\",\n          \"不尝试再识别\",\n          \"安全存储和传输\",\n          \"报告使用情况或违规事件\"\n        ],\n        \"approval\": \"数据共享前由申办者或研究治理委员会审批；涉及受试者隐私或伦理问题时需伦理委员会批准。\",\n        \"transfer\": \"使用加密传输和受控访问；保留传输记录和接收确认。\"\n      }\n    },\n    \"v2_n_13_1\": {\n      \"ethics.approval_status\": {\n        \"requirement\": \"本研究方案、知情同意书、招募材料及修正案必须经伦理委员会审查批准后方可实施；未获批准或批准过期不得入组受试者。\",\n        \"documentation\": \"伦理批准文件、批件号、批准日期和有效期保存于试验主文件。\"\n      },\n      \"ethics.before_procedure_confirmation\": {\n        \"confirmation\": \"在任何研究相关程序包括筛选前，确认伦理批准有效、知情同意已签署、受试者符合入排标准、研究者获授权且培训合格。\",\n        \"responsibility\": \"主要研究者或授权研究者负责确认并记录。\"\n      },\n      \"ethics.new_information_handling\": {\n        \"procedure\": \"出现可能影响受试者安全、权益或研究继续开展的新信息时，及时评估并报告伦理委员会、监管机构和申办者。\",\n        \"actions\": [\n          \"更新知情同意书并重新获取同意（如需要）\",\n          \"调整方案或暂停、终止研究（如需要）\",\n          \"记录评估、报告和采取的措施\"\n        ],\n        \"timing\": \"按法规和伦理委员会要求的时限报告。\"\n      },\n      \"ethics.prospective_review_procedure\": {\n        \"procedure\": \"方案修正案、知情同意书修改、招募材料变更和重要研究变更须在实施前提交伦理委员会审查批准。\",\n        \"review\": \"按伦理委员会要求进行初始审查、跟踪审查、年度或定期审查和结题审查；严重不良事件和非预期严重不良反应按规定报告。\",\n        \"deviation\": \"重大方案偏离应及时报告伦理委员会，并采取纠正和预防措施。\"\n      },\n      \"ethics.responsible_role\": {\n        \"role\": \"主要研究者负责确保研究符合伦理要求、获取伦理批准、执行知情同意、报告安全性信息和方案偏离；申办者负责提供必要信息并配合报告。\",\n        \"delegation\": \"职责可授权给合格人员，但主要研究者保留最终责任。\",\n        \"training\": \"相关人员应接受GCP、伦理和方案培训。\"\n      },\n      \"ethics.version_control\": {\n        \"control\": \"所有伦理相关文件使用版本号和日期控制，仅使用伦理委员会批准的版本；修正案需记录版本变更、批准日期和实施日期。\",\n        \"distribution\": \"及时向研究团队、申办者和伦理委员会分发受控版本，回收或作废旧版本。\"\n      }\n    },\n    \"v2_n_13_2\": {\n      \"consent.before_relevant_procedure\": {\n        \"requirement\": \"受试者在进行任何研究相关程序包括筛选前，必须签署伦理委员会批准的知情同意书。\",\n        \"exception\": \"紧急情况下的例外须符合适用法规和伦理委员会要求，并在事后尽快补签同意。\"\n      },\n      \"consent.capacity_or_representative\": {\n        \"general\": \"本研究入组成人慢性鼻窦炎伴鼻息肉患者，预期具有完全民事行为能力，由受试者本人签署知情同意书。\",\n        \"impaired\": \"若受试者无同意能力，应按适用法规由法定代理人签署；受试者恢复能力后应本人重新同意。\",\n        \"documentation\": \"代理关系、评估和签署过程需记录于源文件。\"\n      },\n      \"consent.new_information_handling\": {\n        \"procedure\": \"获知可能影响受试者继续参加意愿的新信息时，及时更新知情同意书并提交伦理委员会审查。\",\n        \"reconsent\": \"对仍在研究中的受试者，按伦理委员会要求重新获取知情同意；已结束研究的受试者按法规和伦理要求处理。\",\n        \"documentation\": \"新信息评估、沟通、再同意日期和版本记录保存。\"\n      },\n      \"consent.procedure\": {\n        \"steps\": [\n          \"由合格研究者与受试者充分讨论\",\n          \"使用通俗语言，给予提问和考虑时间\",\n          \"说明研究目的、程序、风险、获益、替代方案、保密和自愿退出\",\n          \"受试者签名并注明日期，研究者签名并注明日期\",\n          \"向受试者提供签署副本\"\n        ],\n        \"voluntariness\": \"不得强迫或不正当诱导；拒绝或退出不影响常规医疗。\",\n        \"documentation\": \"知情同意过程记录于源文件和CRF（如适用）。\"\n      },\n      \"consent.responsible_role\": {\n        \"role\": \"主要研究者或经授权并培训合格的研究者负责获取知情同意；申办者负责提供伦理批准的知情同意书模板和信息。\",\n        \"delegation\": \"授权分工表应明确获授权人员；未获授权人员不得获取知情同意。\"\n      },\n      \"consent.version\": {\n        \"version\": \"使用伦理委员会批准的知情同意书版本，记录版本号和日期；修正案批准后，使用新版并按要求重新同意。\",\n        \"control\": \"受控分发，确保研究现场仅使用当前批准版本。\"\n      },\n      \"consent.witness_if_a