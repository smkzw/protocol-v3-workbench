{"content":"{\"chapters\":{\"v2_n_3_1_2_2\":{\"estimand.primary.variable_aggregation\":{\"type\":\"二分类复合终点\",\"unit_of_analysis\":\"受试者\",\"aggregation_rule\":\"第24周同时满足双侧鼻息肉评分（NPS）≤1且鼻塞VAS≤1定义为临床缓解，否则为未缓解。\",\"components\":[\"双侧鼻息肉评分（NPS）≤1\",\"鼻塞VAS≤1\"]},\"estimand.primary.variable_measurement\":{\"nps\":{\"name\":\"双侧鼻息肉评分\",\"scale\":\"每侧0～4分，双侧总和0～8分\",\"threshold\":\"≤1\"},\"nasal_congestion_vas\":{\"name\":\"鼻塞VAS\",\"scale\":\"0～10 cm视觉模拟量表\",\"threshold\":\"≤1\"},\"clinical_remission\":\"第24周NPS≤1且鼻塞VAS≤1\"},\"estimand.primary.variable_timepoint_window\":{\"timepoint\":\"第24周\",\"window\":\"第24周\",\"evaluation\":\"在第24周评估临床缓解状态\"}},\"v2_n_3_1_2_3\":{\"design.rescue_treatment_planned\":{\"planned\":true,\"rescue_treatment\":\"因鼻塞加重使用全身激素或鼻窦手术\",\"handling\":\"救援治疗不终止随机分组；主要分析按治疗策略处理。\"},\"estimand.primary.background_treatment\":{\"applicable\":true,\"description\":\"允许稳定背景鼻用激素，并记录使用情况。\",\"handling\":\"背景鼻用激素作为伴随治疗记录，主要分析按随机分组进行。\"},\"estimand.primary.treatment_condition\":{\"experimental\":\"合成药X 150 mg/1.0 mL皮下注射；负荷期第1、8、15、22天每周一次共4次，维持期第36天起每两周一次至第24周末次给药\",\"comparator\":\"生理盐水安慰剂1.0 mL皮下注射，同体积、同途径、同频率\",\"randomization\":\"1:1随机，双盲，按中心分层\",\"condition\":\"随机分配至合成药X组或安慰剂组\"},\"estimand.primary.treatment_effect_label_clarification\":{\"label\":\"随机分配的治疗效应，伴有或不伴有补救治疗或背景治疗改变\",\"clarification\":\"主要估计量评价随机分配至合成药X组相对于安慰剂组的治疗效应；无论是否发生救援治疗或背景治疗改变，均按随机分组进行分析，符合治疗策略。\"},\"intervention.background_therapy_applicable\":{\"applicable\":true,\"description\":\"允许稳定背景鼻用激素，并记录。\"}},\"v2_n_3_1_2_4\":{\"design.rescue_treatment_planned\":{\"planned\":true,\"rescue_treatment\":\"因鼻塞加重使用全身激素或鼻窦手术\",\"handling\":\"救援治疗不终止随机分组；主要分析按治疗策略处理。\"},\"estimand.primary.intercurrent_events\":{\"handling_strategy\":\"ICE按治疗策略（treatment policy）处理。\",\"events\":[{\"event\":\"鼻塞加重需全身激素或手术干预\",\"handling\":\"按治疗策略保留在随机分组中分析；救援治疗定义为因鼻塞加重使用全身激素或鼻窦手术。\"},{\"event\":\"因不良事件停药\",\"handling\":\"按治疗策略保留在随机分组中分析。\"},{\"event\":\"失访\",\"handling\":\"第24周缺失主要终点采用无应答插补（NRI），敏感性分析采用tipping point。\"}],\"missing_data_handling\":\"第24周缺失主要终点采用NRI；敏感性分析采用tipping point。\"},\"intervention.background_therapy_applicable\":{\"applicable\":true,\"description\":\"允许稳定背景鼻用激素，并记录。\"}},\"v2_n_3_2_1\":{\"picos.secondary_multiplicity_intent\":{\"key_secondary\":\"第24周SNOT-22较基线变化\",\"multiplicity_control\":\"关键次要终点采用固定序列检验控制多重性。\",\"other_secondary\":\"第24周Lund-Kennedy内镜评分较基线变化为描述性分析，不纳入多重性控制。\"},\"picos.secondary_objective_endpoint_map\":{\"mapping\":[{\"objective\":\"评价第24周SNOT-22较基线的变化\",\"endpoint\":\"第24周SNOT-22较基线变化\",\"role\":\"关键次要终点\",\"multiplicity\":\"固定序列检验控制多重性\"},{\"objective\":\"评价第24周Lund-Kennedy内镜评分较基线的变化\",\"endpoint\":\"第24周Lund-Kennedy内镜评分较基线变化\",\"role\":\"其他次要终点\",\"multiplicity\":\"描述性分析\"}]}},\"v2_n_3_2_2\":{\"picos.key_secondary_endpoints\":{\"endpoints\":[{\"name\":\"第24周SNOT-22较基线变化\",\"timepoint\":\"第24周\",\"analysis\":\"关键次要终点，采用固定序列检验控制多重性。\"}]},\"picos.other_secondary_endpoints\":{\"endpoints\":[{\"name\":\"第24周Lund-Kennedy内镜评分较基线变化\",\"timepoint\":\"第24周\",\"analysis\":\"描述性分析。\"}]},\"picos.secondary_endpoint_definitions\":{\"snot22\":\"第24周SNOT-22评分较基线的变化。\",\"lund_kennedy\":\"第24周Lund-Kennedy内镜评分较基线的变化。\",\"timepoint\":\"第24周\"}},\"v2_n_3_3_1\":{\"picos.safety_endpoints\":{\"endpoints\":[\"治疗中出现的不良事件（TEAE）发生率、严重程度及与药物的关系\",\"严重不良事件（SAE）发生率\",\"注射部位反应发生率及严重程度\",\"因不良事件导致停药的发生率\"]},\"safety.injection_reaction_applicability\":{\"applicable\":true,\"reason\":\"合成药X和安慰剂均经皮下注射给药，需评估注射部位反应。\"},\"safety.observation_period\":{\"start\":\"首次给药\",\"end\":\"第24周（末次给药）\",\"description\":\"从首次给药至第24周末次给药期间观察安全性。\"},\"safety.safety_objectives\":{\"objectives\":[\"评价合成药X 150 mg/1.0 mL皮下给药方案相较安慰剂在成人慢性鼻窦炎伴鼻息肉患者中的安全性和耐受性。\",\"评价注射部位反应、不良事件、严重不良事件及因不良事件停药等安全性特征。\"]}},\"v2_n_3_3_2\":{\"picos.aesi_definitions\":{\"aesi\":[{\"name\":\"注射部位反应\",\"definition\":\"给药后发生于注射部位的局部反应，如红斑、疼痛、肿胀、瘙痒、硬结等。\"},{\"name\":\"过敏反应/超敏反应\",\"definition\":\"给药后发生的疑似过敏或超敏反应，包括皮疹、荨麻疹、血管性水肿、支气管痉挛或过敏性休克等。\"}]},\"safety.endpoint_definitions\":{\"adverse_event\":\"不良事件（AE）为受试者接受研究干预后出现的任何不良医学事件，不一定与治疗有因果关系。\",\"serious_adverse_event\":\"严重不良事件（SAE）为导致死亡、危及生命、需住院或延长住院、持续或显著残疾/功能丧失、先天异常/出生缺陷或重要医学事件的不良事件。\",\"injection_site_reaction\":\"注射部位反应为给药部位出现的红斑、疼痛、肿胀、瘙痒、硬结等局部事件。\",\"aesi\":\"特别关注的不良事件（AESI）包括注射部位反应及过敏/超敏反应等。\",\"analysis\":\"安全性终点按治疗中出现的不良事件（TEAE）发生率和严重程度进行汇总分析。\"},\"safety.observation_period\":{\"start\":\"首次给药\",\"end\":\"第24周（末次给药）\",\"description\":\"从首次给药至第24周末次给药期间观察安全性。\"}},\"v2_n_3_4_1\":{\"exploratory.biomarker_applicable\":false,\"exploratory.disposition\":{\"planned\":false,\"description\":\"本研究未设置探索性生物标志物、免疫原性或群体PK分析。\"},\"exploratory.immunogenicity_applicable\":false,\"exploratory.population_pk_applicable\":false,\"picos.exploratory_objectives\":{\"planned\":false,\"objectives\":[]},\"statistics.pk_pd_er.er_applicable\":{\"applicable\":false,\"reason\":\"研究设计未包含PK/PD/ER分析。\"}}}}","receipt":{"idempotency_key":"chapter-facts.derive.v1","input_artifacts":[{"ref":"chapter-facts-input","sha256":"bc92aa717ea02cb69309538e34f4933d0f7a354535c36104eae940e555f652cf"}],"logical_call_id":"call:chapter-facts:bc92aa717ea02cb69309538e34f4933d0f7a354535c36104eae940e555f652cf","node_execution_contract_id":"nec:chapter-facts:bc92aa717ea02cb69309538e34f4933d0f7a354535c36104eae940e555f652cf","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/chapter-facts-output.v1.json","output_sha256":"c12197e7a0ea570ab20cbc8d0749fcf1bd0b5f394a1ad8f39142110d57e99a06","prompt_sha256":"81a4f629a6890c6f801162e4a74b9ab00ea246faf6b827f82fb3d8a5fee50daf","provider_session_id":"930f3048-5514-4580-971f-feb2b57abd23","requested_reasoning_effort":"max"},"schema":"model_response.v1"}