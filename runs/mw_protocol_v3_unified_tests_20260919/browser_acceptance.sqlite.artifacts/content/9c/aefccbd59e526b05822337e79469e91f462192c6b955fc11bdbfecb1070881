{"content":"{\n  \"chapters\": {\n    \"v2_n_1_1\": {\n      \"synopsis.comparator_drug\": {\n        \"name\": \"生理盐水安慰剂\",\n        \"dose\": \"1.0 mL\",\n        \"route\": \"皮下注射\",\n        \"frequency\": \"与合成药X同体积、同途径、同频率给药\",\n        \"loading\": \"第1、8、15、22天每周一次，共4次\",\n        \"maintenance\": \"第36天起每两周一次至第24周末次给药\"\n      },\n      \"synopsis.design\": {\n        \"phase\": \"Ⅱ期\",\n        \"design\": \"概念验证、随机双盲、安慰剂对照、优效性设计\",\n        \"randomization\": \"1:1随机，按中心分层\",\n        \"interim_analysis\": \"无期中分析计划\",\n        \"primary_endpoint\": \"第24周临床缓解率\"\n      },\n      \"synopsis.investigational_drug\": {\n        \"name\": \"合成药X注射制剂\",\n        \"dose\": \"150 mg/1.0 mL\",\n        \"route\": \"皮下给药\",\n        \"loading\": \"第1、8、15、22天每周一次，共4次\",\n        \"maintenance\": \"第36天起每两周一次至第24周末次给药\"\n      },\n      \"synopsis.population_eligibility\": {\n        \"population\": \"成人慢性鼻窦炎伴鼻息肉患者\",\n        \"background_therapy\": \"允许稳定背景鼻用激素并记录\",\n        \"analysis_set\": \"FAS（ITT原则），按随机分组进行分析\"\n      },\n      \"synopsis.sample_size\": {\n        \"assumptions\": {\n          \"placebo_response_rate\": \"20%\",\n          \"treatment_response_rate\": \"35%\",\n          \"alpha\": \"双侧0.05\",\n          \"power\": \"90%\",\n          \"randomization\": \"1:1\",\n          \"attrition\": \"8%\"\n        },\n        \"result\": \"约404例（每组约202例）\",\n        \"method\": \"两独立比例的正态近似；按中心分层的CMH检验，报告风险差及95%CI\"\n      },\n      \"synopsis.statistical_methods\": {\n        \"primary_analysis\": \"按中心分层的CMH检验，报告风险差及95%CI\",\n        \"analysis_set\": \"FAS（ITT原则），按随机分组\",\n        \"missing_data\": \"第24周缺失主要终点采用无应答插补（NRI），敏感性分析采用tipping point\",\n        \"multiplicity\": \"关键次要终点SNOT-22采用固定序列检验控制多重性；Lund-Kennedy内镜评分为描述性分析\",\n        \"ice\": \"ICE按治疗策略处理；ICE事件包括鼻塞加重需全身激素或手术干预、因不良事件停药、失访；救援治疗定义为因鼻塞加重使用全身激素或鼻窦手术\"\n      }\n    },\n    \"v2_n_1_2\": {\n      \"diagram.escalation_design\": {\n        \"applicable\": false,\n        \"description\"