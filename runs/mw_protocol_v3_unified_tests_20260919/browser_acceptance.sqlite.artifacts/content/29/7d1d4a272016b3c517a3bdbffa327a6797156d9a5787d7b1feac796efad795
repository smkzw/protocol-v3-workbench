{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-8-1:v2\",\n  \"node_id\": \"v2_n_8_1\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"block_id\": \"block:v2_n_8_1:p:001\",\n      \"kind\": \"paragraph\",\n      \"text\": \"本节按个体层面与试验整体层面分层规定暂停和终止。个体暂停指因安全性或其他医学原因暂时停止研究干预，但不自动退出研究或撤回知情同意；暂停不自动等同于永久停药。个体永久停药指达到方案规定的永久停药标准后停止研究干预。个体暂停、个体永久停药与试验整体暂停/终止应分层类型化且互不转写。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"block:v2_n_8_1:t:individual_cessation\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [],\n      \"table\": {\n        \"table_id\": \"table:v2_n_8_1:individual_cessation\",\n        \"block_id\": \"block:v2_n_8_1:t:individual_cessation\",\n        \"title\": \"个体层面暂停与永久停药分层表\",\n        \"domain\": \"stopping_rules\",\n        \"role\": \"body_content\",\n        \"header_row_count\": 1,\n        \"review_state\": \"ai_draft\",\n        \"version\": 0,\n        \"source_locator\": \"\",\n        \"schema_version\": \"structured_table_v1\",\n        \"word_layout\": {},\n        \"columns\": [\n          {\n            \"column_id\": \"col:ind:level\",\n            \"label\": \"层面/类型\",\n            \"order\": 0,\n            \"semantic_role\": \"level\",\n            \"style_role\": \"body\",\n            \"source_locator\": \"\"\n          },\n          {\n            \"column_id\": \"col:ind:trigger\",\n            \"label\": \"触发条件或标准\",\n            \"order\": 1,\n            \"semantic_role\": \"trigger\",\n            \"style_role\": \"body\",\n            \"source_locator\": \"\"\n          },\n          {\n            \"column_id\": \"col:ind:action\",\n            \"label\": \"执行与记录要求\",\n            \"order\": 2,\n            \"semantic_role\": \"action_record\",\n            \"style_role\": \"body\",\n            \"source_locator\": \"\"\n          },\n          {\n            \"column_id\": \"col:ind:followup\",\n            \"label\": \"恢复或后续安排\",\n            \"order\": 3,\n            \"semantic_role\": \"followup\",\n            \"style_role\": \"body\",\n            \"source_locator\": \"\"\n          }\n        ],\n        \"rows\": [\n          {\n            \"row_id\": \"row:ind:hold\",\n            \"order\": 0,\n            \"label\": \"个体暂停\",\n            \"style_role\": \"body\",\n            \"source_locator\": \"\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:ind:hold:level\",\n                \"row_id\": \"row:ind:hold\",\n                \"column_id\": \"col:ind:level\",\n                \"text\": \"个体暂停（暂时停止研究干预）\",\n                \"style_role\": \"body\",\n                \"row_span\": 1,\n                \"column_span\": 1,\n                \"condition_expression\": \"\",\n                \"note_refs\": [],\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"discontinuation:cell:individual_trigger\",\n                \"row_id\": \"row:ind:hold\",\n                \"column_id\": \"col:ind:trigger\",\n                \"text\": \"发生不良事件（AE）/严重不良事件（SAE），需暂停给药以评估与试验药物的关系及继续给药风险；具有临床意义的实验室检查、生命体征或其他安全性异常，需重复确认并评估是否暂停或永久停用研究干预；发生重度过敏或超敏反应，或需紧急处理的系统性反应，需暂停给药并评估是否永久停药；因合并用药、手术、试验参与者原因或其他情况导致需要暂停、延迟或遗漏给药。\",\n                \"style_role\": \"body\",\n                \"row_span\": 1,\n                \"column_span\": 1,\n                \"condition_expression\": \"\",\n                \"note_refs\": [],\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:ind:hold:action\",\n                \"row_id\": \"row:ind:hold\",\n                \"column_id\": \"col:ind:action\",\n                \"text\": \"暂停期间继续按计划进行安全性和疗效随访，除非试验参与者退出；恢复给药需由研究者评估并符合方案和医学监查要求；本方案未设定计划性暂停给药。任何因AE、合并用药、手术、试验参与者原因或其他情况导致的给药暂停、延迟或遗漏，均应记录发生日期、原因、持续时间、是否恢复、恢复日期及实际给药调整。\",\n                \"style_role\": \"body\",\n                \"row_span\": 1,\n                \"column_span\": 1,\n                \"condition_expression\": \"\",\n                \"note_refs\": [],\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:ind:hold:followup\",\n                \"row_id\": \"row:ind:hold\",\n                \"column_id\": \"col:ind:followup\",\n                \"text\": \"暂停不自动等同于永久停药；个体暂停后不要求自动转为永久停药；若达到永久停药标准，则永久停止研究干预，并按方案继续安全性随访；撤回知情同意者不再进行新的研究相关操作。\",\n                \"style_role\": \"body\",\n                \"row_span\": 1,\n                \"column_span\": 1,\n                \"condition_expression\": \"\",\n                \"note_refs\": [],\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:ind:permanent\",\n            \"order\": 1,\n            \"label\": \"个体永久停药\",\n            \"style_role\": \"body\",\n            \"source_locator\": \"\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:ind:permanent:level\",\n                \"row_id\": \"row:ind:permanent\",\n                \"column_id\": \"col:ind:level\",\n                \"text\": \"个体永久停药\",\n                \"style_role\": \"body\",\n                \"row_span\": 1,\n                \"column_span\": 1,\n                \"condition_expression\": \"\",\n                \"note_refs\": [],\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:ind:permanent:trigger\",\n                \"row_id\": \"row:ind:permanent\",\n                \"column_id\": \"col:ind:trigger\",\n                \"text\": \"试验参与者撤回知情同意或明确要求永久停止研究干预；发生与试验药物相关的SAE或不可耐受毒性，研究者判断继续给药风险大于获益；发生重度过敏或超敏反应，或需紧急处理的系统性反应；具有临床意义的实验室检查、生命体征或其他安全性异常经重复确认，且研究者或医学监查员判断需永久停药；研究者判断继续给药不符合试验参与者最佳利益；申办者、伦理委员会或监管机构要求永久停止。\",\n                \"style_role\": \"body\",\n                \"row_span\": 1,\n                \"column_span\": 1,\n                \"condition_expression\": \"\",\n                \"note_refs\": [],\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:ind:permanent:action\",\n                \"row_id\": \"row:ind:permanent\",\n                \"column_id\": \"col:ind:action\",\n                \"text\": \"达到上述任一标准时永久停止研究干预，并按方案继续安全性随访；永久停止研究干预需在电子病例报告表（eCRF）中记录日期、原因、与试验药物关系、是否达到方案定义标准、是否继续研究随访；相关AE或SAE按药物临床试验质量管理规范（GCP）和安全性报告流程报告。\",\n                \"style_role\": \"body\",\n                \"row_span\": 1,\n                \"column_span\": 1,\n                \"condition_expression\": \"\",\n                \"note_refs\": [],\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:ind:permanent:followup\",\n                \"row_id\": \"row:ind:permanent\",\n                \"column_id\": \"col:ind:followup\",\n                \"text\": \"撤回知情同意者不再进行新的研究相关操作；达到永久停药标准者停止给药并继续安全性随访至第24周或医学监查确认结束。\",\n                \"style_role\": \"body\",\n                \"row_span\": 1,\n                \"column_span\": 1,\n                \"condition_expression\": \"\",\n                \"note_refs\": [],\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          }\n        ]\n      }\n    },\n    {\n      \"block_id\": \"block:v2_n_8_1:p:002\",\n      \"kind\": \"paragraph\",\n      \"text\": \"个体暂停或永久停药决策应与安全性评估、AE/SAE报告和随访安排一致；暂停后需完成方案规定的安全性评估，达到永久停药标准者停止给药并继续安全性随访至第24周或医学监查确认结束。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"block:v2_n_8_1:t:trial_stop\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [],\n      \"table\": {\n        \"table_id\": \"table:v2_n_8_1:trial_stop\",\n        \"block_id\": \"block:v2_n_8_1:t:trial_stop\",\n        \"title\": \"试验整体暂停与终止决策表\",\n        \"domain\": \"stopping_rules\",\n        \"role\": \"body_content\",\n        \"header_row_count\": 1,\n        \"review_state\": \"ai_draft\",\n        \"version\": 0,\n        \"source_locator\": \"\",\n        \"schema_version\": \"structured_table_v1\",\n        \"word_layout\": {},\n        \"columns\": [\n          {\n            \"column_id\": \"col:trial:type\",\n            \"label\": \"整体决策类型\",\n            \"order\": 0,\n            \"semantic_role\": \"decision_type\",\n            \"style_role\": \"body\",\n            \"source_locator\": \"\"\n          },\n          {\n            \"column_id\": \"col:trial:trigger\",\n            \"label\": \"触发条件\",\n            \"order\": 1,\n            \"semantic_role\": \"trigger\",\n            \"style_role\": \"body\",\n            \"source_locator\": \"\"\n          },\n          {\n            \"column_id\": \"col:trial:logic\",\n            \"label\": \"决策逻辑与依据\",\n            \"order\": 2,\n            \"semantic_role\": \"decision_logic\",\n            \"style_role\": \"body\",\n            \"source_locator\": \"\"\n          },\n          {\n            \"column_id\": \"col:trial:authority\",\n            \"label\": \"决定方与报告路径\",\n            \"order\": 3,\n            \"semantic_role\": \"decision_authority\",\n            \"style_role\": \"body\",\n            \"source_locator\": \"\"\n          },\n          {\n            \"column_id\": \"col:trial:post\",\n            \"label\": \"决策后处理\",\n            \"order\": 4,\n            \"semantic_role\": \"post_decision\",\n            \"style_role\": \"body\",\n            \"source_locator\": \"\"\n          }\n        ],\n        \"rows\": [\n          {\n            \"row_id\": \"row:trial:suspension\",\n            \"order\": 0,\n            \"label\": \"试验暂停入组或给药\",\n            \"style_role\": \"body\",\n            \"source_locator\": \"\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:trial:suspension:type\",\n                \"row_id\": \"row:trial:suspension\",\n                \"column_id\": \"col:trial:type\",\n                \"text\": \"试验暂停入组或给药\",\n                \"style_role\": \"body\",\n                \"row_span\": 1,\n                \"column_span\": 1,\n                \"condition_expression\": \"\",\n                \"note_refs\": [],\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"discontinuation:cell:trial_trigger\",\n                \"row_id\": \"row:trial:suspension\",\n                \"column_id\": \"col:trial:trigger\",\n                \"text\": \"出现可能影响试验参与者安全的非预期严重不良反应聚集、系统性安全性问题、中心严重方案违背、监管或伦理要求暂停等情形时，可暂停试验入组或给药，待评估后决定恢复或终止。\",\n                \"style_role\": \"body\",\n                \"row_span\": 1,\n                \"column_span\": 1,\n                \"condition_expression\": \"\",\n                \"note_refs\": [],\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:trial:suspension:logic\",\n                \"row_id\": \"row:trial:suspension\",\n                \"column_id\": \"col:trial:logic\",\n                \"text\": \"数据依据：系统性安全性信号、影响试验继续的严重方案违背、监管或伦理要求、无法控制的风险；决策逻辑：达到上述任一情形后，应评估风险获益，并决定暂停入组/给药或终止试验；决策链应可复核并记录。\",\n                \"style_role\": \"body\",\n                \"row_span\": 1,\n                \"column_span\": 1,\n                \"condition_expression\": \"\",\n                \"note_refs\": [],\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"discontinuation:cell:trial_decision_authority\",\n                \"row_id\": \"row:trial:suspension\",\n                \"column_id\": \"col:trial:authority\",\n                \"text\": \"试验整体暂停或终止由申办者会同研究者、医学监查员决定；涉及试验参与者安全时按法规和伦理委员会、监管机构要求报告并执行。\",\n                \"style_role\": \"body\",\n                \"row_span\": 1,\n                \"column_span\": 1,\n                \"condition_expression\": \"\",\n                \"note_refs\": [],\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:trial:suspension:post\",\n                \"row_id\": \"row:trial:suspension\",\n                \"column_id\": \"col:trial:post\",\n                \"text\": \"决定暂停后，立即停止相关入组或给药，通知所有中心，确保试验参与者安全并安排必要的安全性随访和转归，按法规报告伦理委员会和监管机构，记录并保存所有决定及依据。\",\n                \"style_role\": \"body\",\n                \"row_span\": 1,\n                \"column_span\": 1,\n                \"condition_expression\": \"\",\n                \"note_refs\": [],\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row:trial:termination\",\n            \"order\": 1,\n            \"label\": \"试验终止\",\n            \"style_role\": \"body\",\n            \"source_locator\": \"\",\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:trial:termination:type\",\n                \"row_id\": \"row:trial:termination\",\n                \"column_id\": \"col:trial:type\",\n                \"text\": \"试验终止\",\n                \"style_role\": \"body\",\n                \"row_span\": 1,\n                \"column_span\": 1,\n                \"condition_expression\": \"\",\n                \"note_refs\": [],\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:trial:termination:trigger\",\n                \"row_id\": \"row:trial:termination\",\n                \"column_id\": \"col:trial:trigger\",\n                \"text\": \"出现明确不可接受的安全性风险、无效或获益/风险比不支持继续、监管机构或伦理委员会要求终止、申办者无法继续实施等情形时，终止试验。\",\n                \"style_role\": \"body\",\n                \"row_span\": 1,\n                \"column_span\": 1,\n                \"condition_expression\": \"\",\n                \"note_refs\": [],\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:trial:termination:logic\",\n                \"row_id\": \"row:trial:termination\",\n                \"column_id\": \"col:trial:logic\",\n                \"text\": \"数据依据：明确不可接受的安全性风险、无效或获益/风险比不支持继续、监管机构或伦理委员会要求终止、申办者无法继续实施；决策逻辑：达到上述任一情形后，评估风险获益并决定终止试验；不得以无设计特定决策链的模板短语允许提前停止，也不得出具疗效结论。\",\n                \"style_role\": \"body\",\n                \"row_span\": 1,\n                \"column_span\": 1,\n                \"condition_expression\": \"\",\n                \"note_refs\": [],\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:trial:termination:authority\",\n                \"row_id\": \"row:trial:termination\",\n                \"column_id\": \"col:trial:authority\",\n                \"text\": \"试验整体暂停或终止由申办者会同研究者、医学监查员决定；涉及试验参与者安全时按法规和伦理委员会、监管机构要求报告并执行。\",\n                \"style_role\": \"body\",\n                \"row_span\": 1,\n                \"column_span\": 1,\n                \"condition_expression\": \"\",\n                \"note_refs\": [],\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"cell:trial:termination:post\",\n                \"row_id\": \"row:trial:termination\",\n                \"column_id\": \"col:trial:post\",\n                \"text\": \"决定终止后，立即停止相关入组或给药，通知所有中心，确保试验参与者安全并安排必要的安全性随访和转归，按法规报告伦理委员会和监管机构，记录并保存所有决定及依据。\",\n                \"style_role\": \"body\",\n                \"row_span\": 1,\n                \"column_span\": 1,\n                \"condition_expression\": \"\",\n                \"note_refs\": [],\n                \"provenance_lineage\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          }\n        ]\n      }\n    },\n    {\n      \"block_id\": \"block:v2_n_8_1:p:003\",\n      \"kind\": \"paragraph\",\n      \"text\": \"试验整体暂停或终止不得以模板示例停止规则作为本项目标准，也不得将个体停药标准等同于整体试验暂停或终止。任何整体暂停或终止决定均应基于触发数据、风险获益评估、监管或伦理要求，并保留可复核的决策链；决定后应立即停止相关入组或给药，通知所有中心，确保试验参与者安全并安排必要的安全性随访和转归，按法规报告伦理委员会和监管机构，记录并保存所有决定及依据。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"ef79695b4a5acbe80fcddaccf925b384d3c3f7ad0bdcc6c38629a8d70c4b9c03"}],"logical_call_id":"call:chapter-draft:a70659f19d2d01560e93845ed0fccb1fb6fd3f2132da160b39958568d796731d:chapter-generate","node_execution_contract_id":"nec:chapter-draft:a70659f19d2d01560e93845ed0fccb1fb6fd3f2132da160b39958568d796731d:chapter-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/ordered-chapter-draft-candidate.v1.json","output_sha256":"bb180377079606882352c990f7934116e8ec56ab7836813220d5cbbdcc408b0f","prompt_sha256":"9aec0ea7a8d8361fdb1c273790e20e30d5e6b1d7680ac1c6c63436bd71300fac","provider_session_id":"c202e05c-4d81-46b1-a56a-7780406df7be","requested_reasoning_effort":"max"},"schema":"model_response.v1"}