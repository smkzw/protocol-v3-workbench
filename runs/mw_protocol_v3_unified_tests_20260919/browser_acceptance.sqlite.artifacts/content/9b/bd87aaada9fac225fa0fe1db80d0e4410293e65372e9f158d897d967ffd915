{"content":"{\n  \"chapters\": {\n    \"v2_front_block\": {\n      \"framing.document_title\": \"合成药X治疗慢性鼻窦炎伴鼻息肉的Ⅱ期随机、双盲、安慰剂对照研究方案\",\n      \"document_control.confidentiality_statement\": \"本方案及研究相关资料属机密信息，仅限申办者、研究者、伦理委员会、监管机构及经授权的研究相关人员使用；未经申办者书面许可不得向第三方披露。\",\n      \"document_control.applicable_parties\": {\n        \"parties\": [\n          \"申办者\",\n          \"研究者\",\n          \"伦理委员会\",\n          \"监管机构\",\n          \"经授权的研究相关人员\"\n        ]\n      },\n      \"document_control.header_footer_metadata\": {\n        \"header_fields\": [\n          \"方案标题\"\n        ],\n        \"footer_fields\": [\n          \"页码\"\n        ]\n      }\n    },\n    \"v2_n_10_1_1\": {\n      \"ae.ae_term_binding\": \"不良事件术语使用MedDRA进行编码和归类，首选术语（PT）和系统器官分类（SOC）采用当时有效的MedDRA版本；严重程度按NCI CTCAE v5.0分级。\",\n      \"ae.chapter_scope_framing\": \"本章规定本试验中不良事件（AE）、治疗期出现的不良事件（TEAE）和严重不良事件（SAE）的定义、收集、记录、评估、随访与报告要求。\",\n      \"ae.definition\": \"不良事件（AE）指受试者签署知情同意书后接受试验用药品或参与研究程序期间出现的任何不良医学事件，可以表现为新发疾病、症状、体征、实验室异常或原有疾病/症状加重；AE不一定与试验用药品存在因果关系。\",\n      \"ae.oncology_progression_exception_applicable\": false,\n      \"ae.pre_existing_condition_handling\": \"签署知情同意书前已存在的疾病、症状或实验室异常作为病史记录；若在签署知情同意书后新发生或加重，则作为AE记录并评估。筛选期已存在且未加重的异常不作为AE。\",\n      \"ae.teaee_derivation\": \"TEAE定义为首次给予试验用药品后至安全性随访结束期间新发生或加重的AE；首次给药前已存在且未加重的AE不计为TEAE。\",\n      \"ae.temporal_window_definition\": \"AE收集期自签署知情同意书起至末次给药后安全性随访结束；TEAE的观察期自首次给予试验用药品开始至安全性随访结束。\"\n    },\n    \"v2_n_10_1_2\": {\n      \"ae.severity_grading_definition\": \"AE严重程度按NCI CTCAE v5.0分级：1级为轻度，2级为中度，3级为重度或医学上显著但非立即危及生命，4级为危及生命，5级为死亡。CTCAE未列出的AE可按轻度、中度、重度、危及生命、死亡进行分级。\",\n      \"ae.severity_scale_version\": \"NCI CTCAE v5.0\",\n      \"ae.severity_seriousness_distinctness\": \"严重程度（severity）指AE的强度，严重性（seriousness）指事件是否符合SAE标准；两者概念不同，严重AE不一定严重程度高，严重程度高的AE也不一定为SAE。\"\n    },\n    \"v2_n_10_1_3\": {\n      \"causality.current_authority_basis\": \"相关性判断依据ICH E2A、NMPA《药物临床试验质量管理规范》及现行药物警戒要求，并结合时间关系、药理学/生物学合理性、去激发与再激发、混杂因素和既往安全性信息进行综合判断。\",\n      \"causality.five_level_terminology\": [\n        {\n          \"term\": \"肯定有关\",\n          \"definition\": \"有合理时间关系，停药后改善，再次用药后重现，且不能用其他原因解释。\"\n        },\n        {\n          \"term\": \"很可能有关\",\n          \"definition\": \"有合理时间关系，停药后改善，不能用其他原因解释，但无再激发资料。\"\n        },\n        {\n          \"term\": \"可能有关\",\n          \"definition\": \"有合理时间关系，也可能由其他原因解释，或停药后改善不明确。\"\n        },\n        {\n          \"term\": \"可能无关\",\n          \"definition\": \"时间关系不密切，其他原因更可能解释该事件。\"\n        },\n        {\n          \"term\": \"无关\",\n          \"definition\": \"无合理时间关系，且其他原因可明确解释该事件。\"\n        }\n      ],\n      \"causality.judgment_method\": \"由研究者在源文件和eCRF中按五级分类判断相关性；严重不良事件还需由申办者医学人员复核。若判断不一致，应讨论并记录，报告要求按法规和方案执行。\",\n      \"causality.reportability_algorithm\": \"SAE报告不以相关性判断为前提；所有SAE应在研究者获知后24小时内报告。是否作为可疑且非预期严重不良反应（SUSAR）加速报告，需结合严重性、与试验用药品的相关性及预期性进行判断。\"\n    },\n    \"v2_n_10_1_4\": {\n      \"ae.ae_collection_not_teaee_classification\": \"AE收集不限于TEAE；签署知情同意书后至安全性随访结束期间发生的所有AE均需收集，并在分析时区分给药前AE、TEAE和给药后非TEAE。\",\n      \"ae.collection_period_definition\": \"AE收集期自受试者签署知情同意书起至末次给药后安全性随访结束。\",\n      \"ae.collection_period_start_reference\": \"以签署知情同意书为AE收集起点；筛选失败者仍需收集签署知情同意书后至筛选结束期间发生的AE/SAE。\",\n      \"ae.collection_stop_reference\": \"以末次给药后安全性随访结束为AE收集终点；受试者提前终止研究时，应完成安全性随访并收集至该随访结束。\",\n      \"ae.consent_history_distinction\": \"签署知情同意书前的疾病、症状和异常作为病史记录；签署知情同意书后新发生或加重的医学事件作为AE记录。\"\n    },\n    \"v2_n_10_1_5\": {\n      \"ae.recording_requirements\": \"所有AE均应记录于源文件和eCRF，至少包括事件描述、MedDRA首选术语、开始和结束日期、严重程度、严重性、与试验用药品的相关性、采取的措施、转归及是否符合SAE标准。\",\n      \"ae.report_time_selection_rule\": \"AE开始时间以事件首次出现日期或原有事件加重日期为准；给药前已存在并在给药后加重的事件，应按加重后的AE记录，开始日期为加重日期。\",\n      \"ae.separate_times\": \"应分别记录AE开始日期、结束日期、研究者获知日期和报告日期；SAE还应记录申办者获知日期、报告时限及随访报告日期。\",\n      \"ae.terminology_boundary\": \"AE术语使用MedDRA编码，分析时以首选术语（PT）为基础。实验室异常若符合AE定义则作为AE记录；若无临床表现且不符合AE定义，可作为实验室检查异常记录。\"\n    },\n    \"v2_n_10_1_6\": {\n      \"ae.followup_duration_or_end\": \"AE应随访至事件消退、恢复至基线、稳定或获得合理医学解释；SAE应随访至事件解决、稳定或死亡。\",\n      \"ae.followup_scope\": \"随访内容包括事件转归、严重程度变化、严重性变化、治疗措施、对试验用药品和研究程序的影响，以及是否发生SAE。\",\n      \"ae.ongoing_event_handling\": \"至安全性随访结束时仍未恢复的AE，应继续随访至恢复、稳定或研究者判断无需进一步随访；未解决的SAE应按法规要求持续提交随访报告。\"\n    },\n    \"v2_n_10_2_1\": {\n      \"sae.definition\": \"严重不良事件（SAE）指受试者接受试验用药品后发生的任何不良医学事件，符合以下一项或多项标准：导致死亡、危及生命、需要住院或延长住院、持续或显著残疾/功能丧失、先天异常/出生缺陷、重要医学事件。\",\n      \"sae.seriousness_criteria\": [\n        \"导致死亡\",\n        \"危及生命\",\n        \"需要住院或延长住院\",\n        \"持续或显著残疾/功能丧失\",\n        \"先天异常/出生缺陷\",\n        \"重要医学事件：虽未达到上述标准，但可能危及受试者或需要医疗干预以防止上述结局\"\n      ],\n      \"sae.seriousness_criteria_version_binding\": \"严重性标准依据ICH E2A及NMPA现行《药物临床试验质量管理规范》和药物警戒要求执行；标准本身不随CTCAE版本变化。\",\n      \"sae.severity_seriousness_distinctness\": \"严重程度（severity）描述AE的强度，严重性（seriousness）依据SAE标准判断；二者不同，不能互相替代。\"\n    }\n  }\n}","receipt":{"idempotency_key":"chapter-facts.derive.v1","input_artifacts":[{"ref":"chapter-facts-input","sha256":"8b203522fa216314445c7b039022f9ef8ba80aa7ca79343f2b49805a70814d14"}],"logical_call_id":"call:chapter-facts:8b203522fa216314445c7b039022f9ef8ba80aa7ca79343f2b49805a70814d14","node_execution_contract_id":"nec:chapter-facts:8b203522fa216314445c7b039022f9ef8ba80aa7ca79343f2b49805a70814d14","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/chapter-facts-output.v1.json","output_sha256":"2be54e9a20fab1f2672f7e3583cdce1067471e738cf8c51e2679e2e022b75499","prompt_sha256":"81a4f629a6890c6f801162e4a74b9ab00ea246faf6b827f82fb3d8a5fee50daf","provider_session_id":"f95dab5f-97dd-4e70-82dc-c1786758d9d8","requested_reasoning_effort":"max"},"schema":"model_response.v1"}