e_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          },\n          {\n            \"row_id\": \"row_registry_source\",\n            \"order\": 5,\n            \"label\": \"注册库身份与来源版本\",\n            \"cells\": [\n              {\n                \"cell_id\": \"row_registry_source_label\",\n                \"row_id\": \"row_registry_source\",\n                \"column_id\": \"col_module\",\n                \"text\": \"注册库身份与来源版本\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": [],\n                \"source_locator\": \"\"\n              },\n              {\n                \"cell_id\": \"exclusion:registry-source\",\n                \"row_id\": \"row_registry_source\",\n                \"column_id\": \"col_content\",\n                \"text\": \"不经登记库排除；注册库身份不适用，来源版本不适用。\",\n                \"style_role\": \"body\",\n                \"provenance_lineage\": [],\n                \"note_refs\": [],\n                \"source_locator\": \"\"\n              }\n            ]\n          }\n        ]\n      }\n    },\n    {\n      \"block_id\": \"v2_n_5_2_p2\",\n      \"kind\": \"paragraph\",\n      \"text\": \"排除标准应按本章结构化模块执行：排除逻辑为任一命中即不入组；排除标准包括活动性鼻/鼻窦感染、既往鼻窦手术、全身激素依赖、未控制重大系统性疾病；判定参数为按各中心筛选期检查结果判定；本章未设置排除标准适用的时间窗口，且无特殊例外。上述项目事实应以结构化表为准，不得使用模板示例值替代。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"v2_n_5_2_p3\",\n      \"kind\": \"paragraph\",\n      \"text\": \"妊娠/避孕风险适用性已确认。对于有生育潜力的试验参与者及其伴侣，应在研究期间及末次给药后按方案要求采取有效避孕措施；有生育潜力的女性试验参与者应在筛选期及研究期间按方案规定进行妊娠试验，结果阳性者应暂停或停止试验用药品并报告。本章涉及妊娠/避孕的排除判定应引用纳入载体登记的相应事实：育龄女性妊娠试验阴性并同意采取有效避孕（见排除标准）；不复制纳入标准的逆命题，不设置通用期限。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"v2_n_5_2_p4\",\n      \"kind\": \"paragraph\",\n      \"text\": \"注册库一致性：本研究的排除标准不经登记库排除；注册库身份不适用，注册库来源版本不适用。不得将无来源的登记条目作为项目排除依据。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    }\n  ]\n}","receipt":{"idempotency_key":"chapter-draft.generate.v1","input_artifacts":[{"ref":"chapter-intake","sha256":"e7f623fd19b67efd5b719d556494169c872a2801229c4c75978547aa93cbdb55"}],"logical_call_id":"call:chapter-draft:0e3747fc5e7cf9321c19ca9317bd9b0349921da6a177c31c7ee2db53c499462b:chapter-generate","node_execution_contract_id":"nec:chapter-draft:0e3747fc5e7cf9321c19ca9317bd9b0349921da6a177c31c7ee2db53c499462b:chapter-generate","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/ordered-chapter-draft-candidate.v1.json","output_sha256":"d2b0a2f47aa53e47554d439e5828de100a78ecd7921c46f134d9bfe1dc5e1c7e","prompt_sha256":"9aec0ea7a8d8361fdb1c273790e20e30d5e6b1d7680ac1c6c63436bd71300fac","provider_session_id":"3540ec59-b064-4e2d-83b9-dabd93a96404","requested_reasoning_effort":"max"},"schema":"model_response.v1"}