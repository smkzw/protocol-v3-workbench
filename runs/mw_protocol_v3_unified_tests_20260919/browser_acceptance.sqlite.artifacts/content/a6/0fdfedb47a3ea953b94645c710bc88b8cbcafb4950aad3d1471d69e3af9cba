{"content":"{\n  \"chapters\": {\n    \"v2_n_16\": {\n      \"appendix.applicable_attachment_index\": {\n        \"applicable\": false,\n        \"basis\": \"本次研究暂无正式来源文件，来源引用留空；已确认研究事实未列出需纳入的附件索引。\"\n      },\n      \"appendix.container_aggregation_scope\": {\n        \"scope\": \"附录容器，汇总方案附录；已确认包含附录3“中心实验室信息和样本销毁公司信息”。\",\n        \"includes\": [\"附录3 中心实验室信息和样本销毁公司信息\"],\n        \"basis\": \"章节树及已确认研究事实。\"\n      },\n      \"appendix.inclusion_decision_basis\": {\n        \"basis\": \"仅纳入与已确认研究设计、安全性、数据管理或操作相关的附录；已确认中心实验室不适用，未确认的附件不编造纳入。\"\n      }\n    },\n    \"v2_n_16_x3\": {\n      \"appendix.destruction_provider_identifying_details\": {\n        \"applicable\": false,\n        \"basis\": \"本方案未计划采集或保存用于未来研究的额外储备样本或数据；已确认研究事实未指定样本销毁公司，故不适用。\"\n      },\n      \"appendix.destruction_provider_name\": {\n        \"applicable\": false,\n        \"name\": \"不适用\",\n        \"basis\": \"本方案未指定样本销毁公司；本方案未计划采集或保存用于未来研究的额外储备样本或数据。\"\n      },\n      \"appendix.destruction_provider_roles\": {\n        \"applicable\": false,\n        \"basis\": \"未指定样本销毁公司及其职责；方案规定标本按当地实验室和方案要求采集、处理、储存和运输。\"\n      },\n      \"appendix.laboratory_identifying_details\": {\n        \"applicable\": false,\n        \"basis\": \"已确认研究事实表明中心实验室不适用；安全性实验室检查按当地实验室和方案要求执行。\"\n      },\n      \"appendix.laboratory_name\": {\n        \"applicable\": false,\n        \"name\": \"不适用\",\n        \"basis\": \"本研究未设置中心实验室。\"\n      },\n      \"appendix.laboratory_roles_and_scope\": {\n        \"applicable\": false,\n        \"scope\": \"不设置中心实验室；常规安全性实验室检查包括血常规、血生化、肝肾功能、电解质等，按当地实验室和方案要求执行。\"\n      }\n    },\n    \"v2_n_1_1\": {\n      \"synopsis.overall_duration\": {\n        \"duration\": \"约24周治疗和评估期（第1天至第24周末次给药/主要终点评估）；总体研究结束以所有受试者完成第24周评估并完成数据清理、数据库锁定和统计分析为准。\"\n      },\n      \"synopsis.participation_duration\": {\n        \"duration\": \"受试者自签署知情同意书进入筛选期，至第24周主要终点评估完成；之后按方案进行安全性随访，AE/SAE收集至末次给药后30天。\"\n      }\n    },\n    \"v2_n_1_3\": {\n      \"soa.visit_window_definitions\": {\n        \"general\": \"随访访视按方案预定时间窗执行；所有访视应记录实际日期并计算与计划日期的偏差。\",\n        \"week24\": \"第24周为主要终点评估访视，应尽量在计划时间窗内完成主要和次要终点评估。\",\n        \"missing_or_phone\": \"若受试者无法现场访视，可按方案允许的方式联系并记录，但电话访视不得替代第24周主要终点所需的NPS和鼻塞VAS评估。\",\n        \"unscheduled\": \"非计划联系需记录实际日期、时间及与计划访视的相对时间。\"\n      }\n    },\n    \"v2_n_2_2_2_1\": {},\n    \"v2_n_2_2_3\": {},\n    \"v2_n_3_3_1\": {\n      \"safety.injection_reaction_definitions\": {\n        \"definition\": \"注射部位反应指皮下注射后发生于注射部位的局部不良事件，按NCI CTCAE 5.0版进行严重程度分级，并按预先定义的类别记录和汇总。\",\n        \"assessment\": \"研究药物为皮下注射给药，需评估注射部位反应。\"\n      }\n    },\n    \"v2_n_3_4_1\": {\n      \"exploratory.biomarker_applicable\": false,\n      \"exploratory.disposition\": {\n        \"applicable\": false,\n        \"reason\": \"本研究未预设探索性目的或探索性终点；未计划探索性分析。\"\n      },\n      \"picos.exploratory_objectives\": {\n        \"objectives\": [],\n        \"reason\": \"本研究未预设探索性目的。\"\n      }\n    }\n  }\n}","receipt":{"idempotency_key":"chapter-facts.derive.v1","input_artifacts":[{"ref":"chapter-facts-input","sha256":"edebb7170598457d966f7767b15cc4a8c10f85cc7f8de7038ac9e1d321d6bdc8"}],"logical_call_id":"call:chapter-facts:edebb7170598457d966f7767b15cc4a8c10f85cc7f8de7038ac9e1d321d6bdc8","node_execution_contract_id":"nec:chapter-facts:edebb7170598457d966f7767b15cc4a8c10f85cc7f8de7038ac9e1d321d6bdc8","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/chapter-facts-output.v1.json","output_sha256":"5e87992f1e2b5f231d42f2830bd73a64db2ba062c7a3cf3bf6d44f8f88bc9ae8","prompt_sha256":"81a4f629a6890c6f801162e4a74b9ab00ea246faf6b827f82fb3d8a5fee50daf","provider_session_id":"7c45edc6-aff4-4f0c-ba75-4a3eb19e30c0","requested_reasoning_effort":"max"},"schema":"model_response.v1"}