{"content":"{\"chapters\":{\"v2_n_1_3\":{\"soa.assessment_cells\":[{\"visit\":\"第1天\",\"timing\":\"第1天\",\"assessments\":[\"随机分组（1:1，按中心分层）\",\"基线评估（给药前）：双侧鼻息肉评分（NPS）、鼻塞VAS、SNOT-22、Lund-Kennedy内镜评分\",\"首次给予合成药X 150 mg/1.0 mL皮下注射或生理盐水安慰剂1.0 mL皮下注射\"]},{\"visit\":\"第8天\",\"timing\":\"第8天\",\"assessments\":[\"给予合成药X 150 mg/1.0 mL皮下注射或生理盐水安慰剂1.0 mL皮下注射\"]},{\"visit\":\"第15天\",\"timing\":\"第15天\",\"assessments\":[\"给予合成药X 150 mg/1.0 mL皮下注射或生理盐水安慰剂1.0 mL皮下注射\"]},{\"visit\":\"第22天\",\"timing\":\"第22天\",\"assessments\":[\"给予合成药X 150 mg/1.0 mL皮下注射或生理盐水安慰剂1.0 mL皮下注射\"]},{\"visit\":\"第36天\",\"timing\":\"第36天\",\"assessments\":[\"维持期首次给药：合成药X 150 mg/1.0 mL皮下注射或生理盐水安慰剂1.0 mL皮下注射\"]},{\"visit\":\"维持期后续访视\",\"timing\":\"第36天起每两周一次至第24周\",\"assessments\":[\"给予合成药X 150 mg/1.0 mL皮下注射或生理盐水安慰剂1.0 mL皮下注射\"]},{\"visit\":\"第24周\",\"timing\":\"第24周（末次给药）\",\"assessments\":[\"末次给予合成药X 150 mg/1.0 mL皮下注射或生理盐水安慰剂1.0 mL皮下注射\",\"主要终点评估：第24周临床缓解率（双侧鼻息肉评分NPS≤1且鼻塞VAS≤1）\",\"关键次要终点评估：SNOT-22较基线变化\",\"次要终点评估：Lund-Kennedy内镜评分较基线变化（描述性分析）\"]}]},\"v2_n_2_1\":{\"background.clinical_problem\":{\"indication\":\"慢性鼻窦炎伴鼻息肉\",\"population\":\"成人患者\",\"clinical_features\":\"双侧鼻息肉和鼻塞；临床缓解定义为NPS≤1且鼻塞VAS≤1。\",\"impact\":\"鼻塞加重时需全身激素或手术干预。\"},\"background.rationale_uncertainty\":{\"uncertainty\":\"合成药X 150 mg皮下给药方案相较安慰剂能否提高成人慢性鼻窦炎伴鼻息肉患者第24周临床缓解率尚不确定。\",\"study_design\":\"Ⅱ期概念验证研究，随机双盲、安慰剂对照优效性设计。\"},\"background.standard_of_care\":{\"background_therapy\":\"允许稳定的背景鼻用激素并记录。\",\"rescue_therapy\":\"因鼻塞加重使用全身激素或鼻窦手术。\"},\"background.unmet_need\":{\"need\":\"在稳定背景鼻用激素下，部分患者仍存在鼻塞和鼻息肉控制不佳，需要新的治疗选择以改善临床缓解。\"}},\"v2_n_2_2_1\":{\"background.product.authority_identity\":{\"name\":\"合成药X\",\"dosage_form\":\"注射制剂\",\"strength\":\"150 mg/1.0 mL\"},\"background.product.mechanism\":{\"target\":\"IL-4Rα\",\"mechanism\":\"IL-4Rα拮抗\"},\"background.product.structure_applicability\":{\"formulation\":\"注射制剂\",\"route\":\"皮下给药\",\"applicability\":\"适用于150 mg/1.0 mL皮下注射方案。\"},\"framing.product_profile\":{\"investigational_product\":\"合成药X\",\"study_phase\":\"Ⅱ期\",\"indication\":\"慢性鼻窦炎伴鼻息肉\",\"target_mechanism\":[\"IL-4Rα\",\"IL-4Rα拮抗\"],\"formulation\":\"注射制剂\",\"strength\":\"150 mg/1.0 mL\",\"route\":\"皮下给药\",\"dose_regimen\":\"负荷期第1、8、15、22天每周一次共4次；维持期第36天起每两周一次至第24周末次给药。\",\"comparator\":\"生理盐水安慰剂1.0 mL，皮下注射，同体积、同途径、同频率。\"}},\"v2_n_2_2_2_1\":{\"background.clinical_pharmacology_context\":{\"target\":\"IL-4Rα\",\"mechanism\":\"IL-4Rα拮抗\",\"context\":\"IL-4Rα拮抗可阻断IL-4/IL-13信号通路，该通路与慢性鼻窦炎伴鼻息肉的炎症过程相关。\"}},\"v2_n_2_2_3\":{\"background.own_product.clinical_study_context\":{\"study\":\"合成药X的Ⅱ期概念验证研究\",\"design\":\"随机双盲、安慰剂对照\",\"population\":\"成人慢性鼻窦炎伴鼻息肉患者\",\"objective\":\"评估合成药X 150 mg皮下给药方案相较安慰剂第24周临床缓解率的优效性。\"},\"picos.comparator_summary\":{\"comparator\":\"安慰剂\",\"description\":\"生理盐水1.0 mL，皮下注射，与合成药X同体积、同途径、同频率给药。\"}},\"v2_n_2_3\":{\"background.risk.anticipated_benefit\":{\"benefit\":\"可能提高第24周临床缓解率（NPS≤1且鼻塞VAS≤1）。\"},\"background.risk.benefit_risk_assessment\":{\"assessment\":\"本研究为Ⅱ期概念验证、随机双盲、安慰剂对照优效性设计；在允许稳定背景鼻用激素并允许鼻塞加重时使用全身激素或鼻窦手术救援的前提下，评估合成药X的获益与风险。\"},\"background.risk.mitigation\":{\"mitigation\":\"允许稳定背景鼻用激素；因鼻塞加重使用全身激素或鼻窦手术作为救援治疗；ICE按治疗策略处理。\"},\"background.risk.uncertainty\":{\"uncertainty\":\"合成药X在成人慢性鼻窦炎伴鼻息肉患者中的疗效尚需本研究评估；主要疗效不确定性为第24周临床缓解率是否优于安慰剂。\"}},\"v2_n_3_1_1\":{\"design.rescue_treatment_planned\":{\"planned\":true,\"definition\":\"因鼻塞加重使用全身激素或鼻窦手术。\"},\"picos.primary_clinical_question\":{\"question\":\"在成人慢性鼻窦炎伴鼻息肉患者中，合成药X 150 mg/1.0 mL皮下给药方案（负荷期第1、8、15、22天每周一次共4次；维持期第36天起每两周一次至第24周末次给药）相较安慰剂能否提高第24周临床缓解率？\"},\"picos.primary_comparison\":{\"comparison\":\"优效性检验\",\"method\":\"按中心分层的CMH检验\",\"effect_measure\":\"风险差及95%CI\"}},\"v2_n_3_1_2_1\":{\"estimand.primary.analysis_set_distinction\":{\"primary_analysis_set\":\"FAS（ITT原则）\",\"randomization\":\"按随机分组进行分析\",\"missing_data\":\"第24周缺失主要终点采用无应答插补（NRI），敏感性分析采用tipping point。\"},\"estimand.primary.population\":{\"population\":\"成人慢性鼻窦炎伴鼻息肉患者\",\"background_therapy\":\"允许稳定背景鼻用激素并记录。\",\"analysis_set\":\"主要分析集为FAS（ITT原则）。\"}}}}","rec