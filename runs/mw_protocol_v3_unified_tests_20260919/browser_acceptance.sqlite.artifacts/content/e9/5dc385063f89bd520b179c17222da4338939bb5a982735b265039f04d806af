{"content":"{\n  \"chapters\": {\n    \"v2_n_6_2_4\": {\n      \"intervention.preparation_conditions\": {\n        \"product\": \"合成药X注射制剂150 mg/1.0 mL或生理盐水安慰剂1.0 mL，按随机分配准备。\",\n        \"route_and_schedule\": \"皮下给药；负荷期第1、8、15、22天每周一次共4次，维持期第36天起每两周一次至第24周末次给药。\",\n        \"blinding_and_verification\": \"安慰剂与试验药同体积、同途径、同频率给药；准备和给药前核对随机号、药物标识、剂量/体积、给药日期和途径，保持双盲并记录实际给药。\",\n        \"aseptic_requirements\": \"按注射剂无菌操作要求准备，给药前检查外观和颗粒物。\"\n      },\n      \"intervention.preparation_responsible_party\": {\n        \"responsible_party\": \"由研究者或其授权并经培训的临床试验人员负责准备和给药；药物分配与盲态维持由不参与疗效评价的指定人员执行。\",\n        \"documentation\": \"准备、发放、给药和回收均需记录并接受监查。\"\n      }\n    },\n    \"v2_n_6_3\": {\n      \"intervention.adherence_denominator\": {\n        \"population\": \"FAS（按随机分组，ITT原则；所有随机受试者），不因未接受干预、依从性差或使用补救治疗而排除。\",\n        \"denominator_definition\": \"以方案计划的研究干预给药次数为分母，受试者随机分组后进入依从性汇总。\"\n      },\n      \"intervention.adherence_evidence_source\": {\n        \"primary_source\": \"药物发放/回收记录、注射给药记录、受试者日志或日记卡、源文件和CRF。\",\n        \"captured_items\": \"每次给药的日期、剂量、体积、途径、是否按计划完成、延迟/遗漏/暂停原因及处理。\"\n      },\n      \"intervention.adherence_measure\": {\n        \"metric\": \"实际接受的研究干预注射次数占方案计划注射次数的比例。\",\n        \"summary\": \"按负荷期、维持期和总体分别汇总；报告完全依从、部分依从和未依从的受试者比例。\",\n        \"analysis_population\": \"FAS（所有随机受试者）。\"\n      },\n      \"intervention.planned_hold_tracking\": {\n        \"planned_holds\": \"本方案未设定计划性暂停给药。\",\n        \"unplanned_holds\": \"任何因不良事件、合并用药、手术、受试者原因或其他情况导致的给药暂停、延迟或遗漏，均记录发生日期、原因、持续时间、是否恢复、恢复日期及实际给药调整。\",\n        \"follow_up\": \"暂停期间继续按计划进行安全性和疗效随访，除非受试者退出；恢复给药需由研究者判断并记录。\"\n      }\n    },\n    \"v2_n_6_4_1\": {\n      \"intervention.prohibited_treatments\": {\n        \"treatments\": [\n          \"其他针对慢性鼻窦炎伴鼻息肉的生物制剂或IL-4Rα靶向药物\",\n          \"其他研究药物或参加其他干预性研究\",\n          \"除方案允许的稳定背景鼻用激素和规定的补救治疗外的系统性免疫抑制剂或用于研究疾病的全身性激素\",\n          \"可能显著影响主要终点评价的其他鼻用或全身治疗（补救治疗除外）\"\n        ],\n        \"notes\": \"若临床需要使用上述治疗，应优先按补救治疗规则处理并记录；禁止自行调整背景鼻用激素的稳定方案。\"\n      },\n      \"intervention.prohibited_window\": {\n        \"window\": \"自筛选期开始至末次随访/研究结束。\",\n        \"exception\": \"方案规定的稳定背景鼻用激素和因鼻塞加重使用的补救治疗（全身激素或鼻窦手术）不视为禁止治疗，但需按6.4.3记录。\"\n      }\n    },\n    \"v2_n_6_4_2\": {\n      \"intervention.allowed_timing\": {\n        \"background_therapy_timing\": \"从筛选期确认稳定使用开始，持续至第24周主要终点评估/末次随访，研究期间保持剂量和频率稳定。\",\n        \"rescue_timing\": \"因鼻塞加重时按6.4.3允许使用。\"\n      },\n      \"intervention.allowed_treatments\": {\n        \"background_therapy\": \"稳定背景鼻用激素，允许在研究期间继续使用，前提是筛选前已稳定使用且研究期间种类和剂量不变。\",\n        \"other_allowed\": \"其他临床必需的合并用药可按研究者判断使用并记录，但不得违反禁止治疗规定；因鼻塞加重使用的补救治疗见6.4.3。\",\n        \"record_requirement\": \"所有允许使用的背景治疗和合并用药均需记录名称、剂量、频率、起止日期和原因。\"\n      },\n      \"intervention.background_therapy_applicable\": {\n        \"applicable\": true,\n        \"description\": \"允许稳定背景鼻用激素，并要求记录。\"\n      }\n    },\n    \"v2_n_6_4_3\": {\n      \"intervention.rescue_estimand_linkage\": {\n        \"estimand_strategy\": \"ICE按治疗策略处理；因鼻塞加重需要全身激素或手术干预属于ICE事件，但不剔除受试者，继续按随机分组纳入主要分析。\",\n        \"missing_data\": \"第24周主要终点缺失采用NRI；敏感性分析采用tipping point。\",\n        \"interpretation\": \"主要估计目标反映在治疗策略下，无论是否使用补救治疗，干预对第24周临床缓解率的效应。\"\n      },\n      \"intervention.rescue_followup_handling\": {\n        \"followup\": \"使用补救治疗后继续按计划随访至第24周主要终点及后续安全性随访，不因补救治疗提前终止或删失。\",\n        \"analysis\": \"补救治疗引起的鼻塞加重若符合ICE定义，按治疗策略处理；主要分析继续纳入FAS，第24周缺失主要终点采用NRI，敏感性分析采用tipping point。\",\n        \"safety\": \"记录AE/SAE并与补救治疗的关系。\"\n      },\n      \"intervention.rescue_permitted\": {\n        \"permitted\": true,\n        \"definition\": \"因鼻塞加重允许使用全身激素或进行鼻窦手术。\",\n        \"conditions\": \"由研究者判断鼻塞加重需要全身激素或手术干预时使用；具体药物、剂量、疗程或手术方式按临床常规并记录。\"\n      },\n      \"intervention.rescue_records\": {\n        \"required_fields\": [\n          \"受试者随机号\",\n          \"补救治疗日期\",\n          \"鼻塞加重表现/严重程度\",\n          \"补救治疗类型（全身激素或鼻窦手术）\",\n          \"药物名称、剂量、途径、疗程或手术名称/日期\",\n          \"使用原因与研究者判断\",\n          \"是否满足ICE定义\",\n          \"后续转归和是否恢复研究干预\"\n        ],\n        \"source\": \"源文件和CRF。\"\n      },\n      \"intervention.rescue_timing\": {\n        \"timing\": \"研究期间至第24周主要终点评估前，如发生因鼻塞加重的临床需要，可随时给予补救治疗；不得预防性使用。\",\n        \"documentation_timing\": \"补救治疗日期、原因和方案需在发生时及时记录。\"\n      }\n    },\n    \"v2_n_7_1\": {\n      \"procedure.baseline_assessments\": {\n        \"efficacy_baseline\": [\n          \"双侧鼻息肉评分（NPS）\",\n          \"鼻塞VAS（0～10 cm）\",\n          \"SNOT-22\",\n          \"Lund-Kennedy内镜评分\"\n        ],\n        \"background_therapy\": \"记录稳定背景鼻用激素使用情况。\",\n        \"other\": \"完成入排标准确认和随机分层所需信息。\"\n      },\n      \"procedure.screening_period_definition\": {\n        \"definition\": \"筛选期从受试者签署知情同意书开始，至完成入排标准确认并随机化前；用于资格评估、基线评估和背景治疗稳定性确认。\",\n        \"documentation\": \"所有筛选评估日期和结果需记录。\"\n      },\n      \"procedure.screening_reassessment_rules\": {\n        \"rules\": \"筛选评估异常时，可在随机化前重复相关评估以确认资格；重复评估的日期、结果和最终入排判断需记录。\",\n        \"prohibited\": \"不得通过重复评估规避入排标准或修改随机分层因素。\"\n      }\n    },\n    \"v2_n_7_2\": {\n      \"diagram.randomized\": {\n        \"ratio\": \"1:1\",\n        \"stratification\": \"按中心分层\",\n        \"planned_total\": \"约404例（每组约202例）\",\n        \"arms\": [\n          \"合成药X组\",\n          \"安慰剂组\"\n        ]\n      },\n      \"procedure.blinded_treatment_handling\": {\n        \"blind_level\": \"双盲，受试者、研究者和疗效评价者保持盲态。\",\n        \"matching\": \"合成药X与安慰剂同体积、同途径、同频率给药。\",\n        \"unblinding\": \"仅按紧急揭盲程序执行，记录揭盲原因、日期和人员；揭盲后受试者继续按计划随访，除非研究者判断需终止。\"\n      },\n      \"procedure.dosing_start_rules\": {\n        \"start\": \"确认符合全部入排标准并完成随机化后，第1天开始首次给药。\",\n        \"schedule\": \"按随机分配接受合成药X 150 mg/1.0 mL或生理盐水安慰剂1.0 mL皮下注射；负荷期第1、8、15、22天每周一次共4次，维持期第36天起每两周一次至第24周末次给药。\",\n        \"blinding\": \"给药前核对随机号和药物标识，保持双盲。\"\n      },\n      \"procedure.treatment_period_definition\": {\n        \"definition\": \"自第1天首次给药开始，至第24周末次给药/主要终点评估结束；负荷给药期第1、8、15、22天，维持给药期第36天起每两周一次至第24周。\",\n        \"randomization\": \"随机1:1，按中心分层。\"\n      },\n      \"procedure.treatment_visit_procedures\": {\n        \"general\": \"各治疗访视完成资格/随机核对、研究干预准备与给药、依从性记录、合并用药和背景治疗记录、AE记录。\",\n        \"efficacy\": \"第24周评估主要终点（NPS≤1且鼻塞VAS≤1的临床缓解）及次要终点（SNOT-22变化、Lund-Kennedy内镜评分变化）。\",\n        \"safety\": \"按方案进行生命体征、临床安全性评估和不良事件监测。\"\n      }\n    },\n    \"v2_n_7_3\": {\n      \"procedure.followup_period_definition\": {\n        \"definition\": \"随访期自第24周末次给药/主要终点评估后开始，至末次随访/研究结束；用于安全性随访和结局确认。\",\n        \"scope\": \"继续记录AE、SAE、合并用药、背景治疗和补救治疗；已发生的临床事件随访至稳定或恢复。\"\n      },\n      \"procedure.followup_visit_windows\": {\n        \"windows\": \"随访访视按方案预定时间窗执行；所有访视应记录实际日期并计算与计划日期的偏差。\",\n        \"week24\": \"第24周为主要终点评估访视，应尽量在计划时间窗内完成主要和次要终点评估。\",\n        \"missing\": \"若受试者无法现场访视，可按方案允许的方式联系并记录，但不能替代主要终点所需的现场评估。\"\n      },\n      \"procedure.phone_visit_linkage\": {\n        \"linkage\": \"电话访视仅作为计划访视的补充或替代安全性随访，需在记录中对应到具体计划访视和日期。\",\n        \"restrictions\": \"电话访视不得替代第24周主要终点所需的NPS和鼻塞VAS评估；若发生，需记录原因并评估对缺失数据处理的影响。\"\n      },\n      \"procedure.unscheduled_contact_recording_plan\": {\n        \"assessment_rules\": \"记录非计划联系中完成的评估项目、结果和未完成原因；非计划评估不替代计划访视，除非方案允许。\",\n        \"date_recording\": \"记录非计划联系的实际日期、时间及与计划访视的相对时间。\",\n        \"modality_recording\": \"记录联系方式/模式（如电话、视频、现场或其他）及实施人员。\",\n        \"reason_recording\": \"记录非计划联系的原因（如不良事件、补救治疗、依从性问题、受试者主动联系等）。\",\n        \"safety_information_handling\": \"收集并报告AE/SAE、合并用药和补救治疗信息，按安全性报告流程处理并记录临床处理及转归。\"\n      }\n    }\n  }\n}","receipt":{"idempotency_key":"chapter-facts.derive.v1","input_artifacts":[{"ref":"chapter-facts-input","sha256":"152e2293b052d1d2c01eeda85de1abf613432439527f6298ae5fa5ae1d90538d"}],"logical_call_id":"call:chapter-facts:152e2293b052d1d2c01eeda85de1abf613432439527f6298ae5fa5ae1d90538d","node_execution_contract_id":"nec:chapter-facts:152e2293b052d1d2c01eeda85de1abf613432439527f6298ae5fa5ae1d90538d","observed_model":"deepseek-flash","observed_provider":"deepseek","output_schema_ref":"https://protocol-v3.local/schemas/chapter-facts-output.v1.json","output_sha256":"f160cfecf6e004ec21324840a9e4449799c3a6844316d205bcfae702980a8da2","prompt_sha256":"81a4f629a6890c6f801162e4a74b9ab00ea246faf6b827f82fb3d8a5fee50daf","provider_session_id":"5e91724f-de27-45a0-9bfb-3dd1cf1f040f","requested_reasoning_effort":"max"},"schema":"model_response.v1"}