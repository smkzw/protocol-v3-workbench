visit_id\": \"D148\",\n            \"visit_name\": \"第148天\",\n            \"assessments\": [\n              \"研究药物给药\",\n              \"合并用药\",\n              \"不良事件\",\n              \"背景鼻用糖皮质激素使用记录\"\n            ]\n          },\n          {\n            \"visit_id\": \"D162\",\n            \"visit_name\": \"第162天（第24周/末次给药）\",\n            \"assessments\": [\n              \"研究药物给药\",\n              \"双侧鼻息肉评分（NPS）\",\n              \"鼻塞VAS\",\n              \"SNOT-22\",\n              \"Lund-Kennedy内镜评分\",\n              \"背景鼻用糖皮质激素使用记录\",\n              \"合并用药\",\n              \"不良事件\",\n              \"研究药物计数/依从性\"\n            ]\n          }\n        ]\n      },\n      \"soa.contact_visits\": [],\n      \"soa.early_exit_assessment\": {\n        \"description\": \"提前退出/终止研究时进行安全性评估，并尽可能完成第24周疗效终点评估，包括双侧鼻息肉评分（NPS）、鼻塞VAS、SNOT-22和Lund-Kennedy内镜评分；记录退出原因、研究药物计数、合并用药和不良事件。\"\n      },\n      \"soa.footnote_bindings\": {\n        \"NPS\": \"双侧鼻息肉评分，每侧0～4分，双侧总和0～8分；第24周临床缓解定义为NPS≤1。\",\n        \"nasal_congestion_VAS\": \"鼻塞VAS采用0～10 cm视觉模拟量表；第24周临床缓解定义为VAS≤1分。\",\n        \"SNOT-22\": \"22项鼻窦炎结局测试，评估生活质量；关键次要终点，第24周较基线变化，采用固定序列检验控制多重性。\",\n        \"Lund-Kennedy\": \"Lund-Kennedy内镜评分，第24周较基线变化，描述性分析。\",\n        \"background_INCS\": \"允许稳定背景鼻用糖皮质激素，并记录使用情况。\",\n        \"ICE_rescue\": \"ICE事件包括鼻塞加重需全身激素或手术干预、因不良事件停药、失访；按治疗策略处理。救援治疗定义为因鼻塞加重使用全身激素或鼻窦手术。\"\n      },\n      \"soa.pk_sampling_present\": false,\n      \"soa.safety_followup\": {\n        \"description\": \"安全性随访按治疗期访视及末次给药后第24周评估进行；如发生不良事件，随访至事件消退或稳定。\"\n      }\n    },\n    \"v2_n_2_1\": {\n      \"background.clinical_problem\": {\n        \"summary\": \"慢性鼻窦炎伴鼻息肉（CRSwNP）是一种以鼻腔和鼻窦黏膜慢性炎症、双侧鼻息肉为特征的疾病，常表现为鼻塞、嗅觉减退、流涕、面部疼痛/压迫感和生活质量下降。\",\n        \"details\": \"CRSwNP病程迁延、易复发，常伴2型炎症，IL-4、IL-13等细胞因子在发病中起关键作用。患者常需长期治疗，疾病负担重。\"\n      },\n      \"background.rationale_uncertainty\": {\n        \"rationale\": \"合成药X为IL-4Rα拮抗剂，理论上可阻断IL-4/IL-13信号通路，抑制2型炎症，从而减轻鼻息肉和鼻塞等症状。\",\n        \"uncertainty\": \"尚需Ⅱ期概念验证研究确认合成药X在成人CRSwNP患者中的疗效、安全性和耐受性；第24周临床缓解率、SNOT-22及Lund-Kennedy评分的变化尚不确定。\"\n      },\n      \"background.standard_of_care\": {\n        \"summary\": \"CRSwNP的标准治疗包括鼻用糖皮质激素、生理盐水冲洗、短期全身糖皮质激素、合并感染时抗生素，以及难治性患者的功能性内镜鼻窦手术。\",\n        \"details\": \"对于重度未控制患者，可考虑生物制剂治疗。但部分患者对现有治疗反应不足或不能耐受，存在未满足的医疗需求。\"\n      },\n      \"background.unmet_need\": {\n        \"summary\": \"尽管有上述治疗，仍有较多CRSwNP患者疾病控制不佳，鼻塞、嗅觉减退等症状持续，复发率高，生活质量受影响。\",\n        \"details\": \"全身糖皮质激素长期使用有安全性风险，手术有创且可能复发。因此需要新型靶向治疗改善症状、减少复发和激素暴露。\"\n      }\n    },\n    \"v2_n_2_2_1\": {\n      \"background.product.authority_identity\": {\n        \"name\": \"合成药X\",\n        \"dosage_form\": \"注射制剂\",\n        \"strength\": \"150 mg/1.0 mL\",\n        \"route\": \"皮下给药\",\n        \"identity\": \"合成药X注射制剂\"\n      },\n      \"background.product.mechanism\": {\n        \"target\": \"IL-4Rα\",\n        \"mechanism\": \"IL-4Rα拮抗剂，阻断IL-4和IL-13信号通路，抑制2型炎症反应。\"\n      },\n      \"background.product.structure_applicability\": {\n        \"applicability\": \"基于IL-4Rα拮抗机制，适用于2型炎症驱动的慢性鼻窦炎伴鼻息肉。\"\n      },\n      \"framing.product_profile\": {\n        \"investigational_product\": \"合成药X\",\n        \"mechanism\": [\"IL-4Rα\", \"IL-4Rα拮抗\"],\n        \"indication\": \"慢性鼻窦炎伴鼻息肉\",\n        \"phase\": \"Ⅱ期\",\n        \"dose_regimen\": {\n          \"arms\": [\n            {\"id\": \"arm.synthetic-x\", \"label\": \"合成药X组\"},\n            {\"id\": \"arm.placebo\", \"label\": \"安慰剂组\"}\n          ],\n          \"periods\": [\n            {\"id\": \"period.loading\", \"label\": \"负荷给药期\", \"timing\": \"第1天至第22天；第1、8、15、22天给药\"},\n            {\"id\": \"period.maintenance\", \"label\": \"维持给药期\", \"timing\": \"第36天起至第24周（末次给药）\"}\n          ],\n          \"schedules\": [\n            {\n              \"arm_id\": \"arm.synthetic-x\",\n              \"period_id\": \"period.loading\",\n              \"steps\": [\n                {\n                  \"frequency\": \"每周一次，共4次\",\n                  \"kind\": \"loading\",\n                  \"products\": [\n                    {\n                      \"dose\": {\"unit\": \"mg\", \"value\": 150},\n                      \"name\": \"合成药X注射制剂\",\n                      \"volume\": {\"unit\": \"mL\", \"value\": 1.0}\n                    }\n                  ],\n                  \"route\": \"皮下给药\",\n                  \"timing\": \"第1、8、15、22天\"\n                }\n              ]\n            },\n            {\n              \"arm_id\": \"arm.synthetic-x\",\n              \"period_id\": \"period.maintenance\",\n              \"steps\": [\n                {\n                  \"frequency\": \"每两周一次\",\n                  \"kind\": \"maintenance\",\n                  \"products\": [\n                    {\n                      \"dose\": {\"unit\": \"mg\", \"value\": 150},\n                      \"name\": \"合成药X注射制剂\",\n                      \"volume\": {\"unit\": \"mL\", \"value\": 1.0}\n                    }\n                  ],\n                  \"route\": \"皮下给药\",\n                  \"timing\": \"第36天起至第24周（末次给药）\"\n                }\n              ]\n            },\n            {\n              \"arm_id\": \"arm.placebo\",\n              \"period_id\": \"period.loading\",\n              \"steps\": [\n                {\n                  \"frequency\": \"每周一次，共4次\",\n                  \"kind\": \"loading\",\n                  \"products\": [\n                    {\n                      \"dose\": {\"unit\": \"mL\", \"value\": 1.0},\n                      \"name\": \"生理盐水安慰剂\",\n                      \"volume\": null\n                    }\n                  ],\n                  \"route\": \"皮下注射\",\n                  \"timing\": \"第1、8、15、22天\"\n                }\n              ]\n            },\n            {\n              \"arm_id\": \"arm.placebo\",\n              \"period_id\": \"period.maintenance\",\n              \"steps\": [\n                {\n                  \"frequency\": \"每两周一次\",\n                  \"kind\": \"maintenance\",\n                  \"products\": [\n                    {\n                      \"dose\": {\"unit\": \"mL\", \"value\": 1.0},\n                      \"name\": \"生理盐水安慰剂\",\n                      \"volume\": null\n                    }\n                  ],\n                  \"route\": \"皮下注射\",\n                  \"timing\": \"第36天起至第24周（末次给药）\"\n                }\n              ]\n            }\n          ]\n        },\n        \"placebo\": \"生理盐水1.0 mL，皮下注射，同体积、同途径、同频率。\"\n      }\n    },\n    \"v2_n_2_2_2_1\": {\n      \"background.clinical_pharmacology_context\": {\n        \"context\": \"合成药X为IL-4Rα拮抗剂，拟用于2型炎症相关的CRSwNP；其临床药理学特征需结合非临床及早期临床数据评估。\"\n      },\n      \"nonclinical.general_pharmacology\": {\n        \"summary\": \"IL-4Rα是IL-4和IL-13共用的受体亚基，阻断该受体可抑制2型炎症信号通路。\"\n      },\n      \"nonclinical.pharmacodynamics\": {\n        \"summary\": \"IL-4Rα拮抗可阻断IL-4/IL-13介导的2型炎症信号，预期降低相关炎症介质和生物标志物。\"\n      }\n    },\n    \"v2_n_2_2_3\": {\n      \"background.own_product.clinical_study_context\": {\n        \"summary\": \"本研究为合成药X在成人慢性鼻窦炎伴鼻息肉患者中的Ⅱ期概念验证研究，采用随机双盲、安慰剂对照设计。\"\n      },\n      \"picos.comparator_summary\": {\n        \"comparator\": \"安慰剂\",\n        \"details\": \"生理盐水1.0 mL，皮下注射，同体积、同途径、同频率给药。\"\n      }\n    },\n    \"v2_n_2_3\": {\n      \"background.risk.anticipated_benefit\": {\n        \"summary\": \"合成药X通过IL-4Rα拮抗抑制2型炎症，可能改善CRSwNP患者鼻息肉评分、鼻塞、生活质量和内镜表现。\",\n        \"details\": \"若达到第24周临床缓解率优效，可能为患者提供新的靶向治疗选择。\"\n      },\n      \"background.risk.benefit_risk_assessment\": {\n        \"summary\": \"在成人CRSwNP患者中，现有治疗仍有未满足需求；合成药X的潜在获益需与其风险相权衡。\",\n        \"details\": \"Ⅱ期研究将评估疗效和安全性；若风险可控且获益明确，可支持进一步开发。\"\n      },\n      \"background.risk.known_risks\": {\n        \"summary\": \"已确认事实未提供合成药X的特异性已知风险。\",\n        \"details\": \"需在研究中监测不良事件，特别是IL-4Rα拮抗相关潜在风险。\"\n      },\n      \"background.risk.potential_risks\": {\n        \"summary\": \"潜在风险包括注射部位反应、过敏反应、免疫原性、感染风险增加等。\",\n        \"details\": \"需通过不良事件监测、实验室检查和生命体征评估进行观察。\"\n      },\n      \"background.risk.mitigation\": {\n        \"summary\": \"通过入选/排除标准、定期安全性评估、不良事件监测和救援治疗进行风险控制。\",\n        \"details\": \"允许稳定背景鼻用激素；因鼻塞加重可使用全身激素或鼻窦手术作为救援治疗。\"\n      },\n      \"background.risk.uncertainty\": {\n        \"summary\": \"合成药X在CRSwNP患者中的疗效、安全性和耐受性尚不确定。\",\n        \"details\": \"本研究为Ⅱ期概念验证，无期中分析计划；主要终点第24周临床缓解率的假设为安慰剂组20%、试验组35%，需通过实际数据验证。\"\n      }\n    },\n    \"v2_n_3_1_1\": {\n      \"design.rescue_treatment_planned\": {\n        \"planned\": true,\n        \"definition\": \"救援治疗定义为因鼻塞加重使用全身糖皮质激素或鼻窦手术。\",\n        \"ice_strategy\": \"ICE按治疗策略处理；ICE事件包括鼻塞加重需全身激素或手术干预、因不良事件停药、失访。\"\n      },\n      \"picos.primary_clinical_question\": {\n        \"question\": \"在成人慢性鼻窦炎伴鼻息肉患者中，与安慰剂相比，合成药X 150 mg/1.0 mL皮下给药方案能否提高第24周临床缓解率？\",\n        \"population\": \"成人慢性鼻窦炎伴鼻息肉患者\",\n        \"intervention\": \"合成药X 150 mg/1.0 mL皮下给药：第1、8、15、22天每周一次负荷给药共4次；第36天起每两周一次维持给药至第24周末次给药。\",\n        \"comparator\": \"安慰剂（生理盐水1.0 mL，皮下注射，同体积、同途径、同频率）。\",\n        \"outcome\": \"第24周临床缓解率，定义为双侧鼻息肉评分（NPS）≤1且鼻塞VAS≤1。\"\n      },\n      \"picos.primary_comparison\": {\n        \"type\": \"优效性检验\",\n        \"design\": \"随机双盲、安慰剂对照、1:1随机、按中心分层\",\n        \"method\": \"按中心分层的CMH检验，报告风险差及95%CI。\",\n        \"hypothesis\": \"合成药X组第24周临床缓解率优于安慰剂组。\"\n      }\n    },\n    \"v2_n_3_1_2_1\": {\n      \"estimand.primary.population\": {\n        \"population\": \"成人慢性鼻窦炎伴鼻息肉患者；允许稳定背景鼻用糖皮质激素并记录。\",\n        \"analysis_set\": \"主要分析集为FAS（ITT原则），按随机分组进行分析。\"\n      },\n      \"estimand.primary.analysis_set_distinction\": {\n        \"FAS\": \"全分析集，遵循ITT原则，包括随机化受试者，按随机分组分析。\",\n        \"ITT\": \"意向性治疗原则，主要分析基于FAS。\",\n        \"missing_data\": \"第24周缺失主要终点采用无应答插补（NRI），敏感性分析采用tipping point。\"\n      }\n    }\n  }\n}","receipt":{"idempotency_key":"chapter-facts.derive.v1","input_artifacts":[{"ref":"chapter-facts-input","sha256":"eed176e354a0aa8cf68c7aee0dbfcdc1399ba4c9618ef4d7d18beb2955a92984"}],"logical_call_id":"call:chapter-facts:eed176e354a0aa8cf68c7aee0dbfcdc1399ba4c9618ef4d7d18beb2955a92984","nod