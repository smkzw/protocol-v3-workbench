{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-3-1-2-2:v2\",\n  \"node_id\": \"v2_n_3_1_2_2\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"block_id\": \"blk:v2_n_3_1_2_2:para_01\",\n      \"kind\": \"paragraph\",\n      \"text\": \"本章应逐项明确主要估计目标的研究变量及其测量、聚合和时间点/窗口。主要研究变量应为第24周临床缓解，定义为双侧鼻息肉评分（NPS）≤1且鼻塞视觉模拟量表（VAS）≤1；其中NPS应采用0～8分（每侧0～4分的双侧总和），缓解阈值为≤1分，鼻塞VAS应采用0～10 cm视觉模拟量表，缓解阈值为≤1分。研究变量属性应同时提供测量、聚合与时间点/窗口三要素。\",\n      \"evidence_refs\": [],\n      \"source_locator\": \"\"\n    },\n    {\n      \"block_id\": \"blk:v2_n_3_1_2_2:table_01\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [],\n      \"table\": {\n        \"table_id\": \"tbl:v2_n_3_1_2_2:variable_attributes\",\n        \"block_id\": \"blk:v2_n_3_1_2_2:table_01\",\n        \"title\": \"主要估计目标的研究变量属性表\",\n        \"domain\": \"objectives_endpoints\",\n        \"role\": \"body_content\",\n        \"header_row_count\": 1,\n        \"review_state\": \"ai_draft\",\n        \"version\": 0,\n        \"schema_version\": \"structured_table_v1\",\n        \"source_locator\": \"\",\n        \"columns\": [\n          {\n            \"column_id\": \"col:attribute\",\n            \"label\": \"属性要素\",\n            \"order\": 0,\n            \"style_role\": \"header\",\n            \"source_locator\": \"\"\n          },\n          {\n            \"column_id\": \"col:specification\",\n            \"label\": \"研究变量属性内容\",\n            \"order\": 1,\n            \"style_role\": \"body\",\n            \"source_locator\": \"\"\n          }\n        ],\n        \"rows\": [\n          {\n            \"row_id\": \"row:header\",\n            \"order\": 0,\n            \"style_role\": \"header\",\n            \"source_locator\": \"\",\n            \"cells\": [\n              {\n                \"cell_id\": \"hdr:attribute\",\n                \"row_id\": \"row:header\",\n                \"column_id\": \"col:attribute\",\n              