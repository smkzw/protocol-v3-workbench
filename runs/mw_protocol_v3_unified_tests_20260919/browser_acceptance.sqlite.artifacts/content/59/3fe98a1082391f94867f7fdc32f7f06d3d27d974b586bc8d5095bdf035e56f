{"content":"{\n  \"chapter_contract_id\": \"contract:v2-n-6-4-2:v2\",\n  \"node_id\": \"v2_n_6_4_2\",\n  \"schema_version\": \"ordered_chapter_draft_candidate.v1\",\n  \"known_evidence_ids\": [],\n  \"blocks\": [\n    {\n      \"block_id\": \"blk:v2_n_6_4_2:p1\",\n      \"kind\": \"paragraph\",\n      \"text\": \"本节规定试验期间允许使用的治疗、允许使用的时间安排以及必须使用的背景治疗规则。允许治疗范围应与本方案禁止治疗规定保持互补且不冲突；其他临床必需的合并用药可按研究者判断使用并记录，但不得违反禁止治疗规定。若临床需要使用禁止治疗，应优先按补救治疗规则处理并记录；因鼻塞加重使用的补救治疗见6.4.3。所有允许使用的背景治疗和合并用药均应记录名称、剂量、频率、起止日期和原因。\",\n      \"evidence_refs\": []\n    },\n    {\n      \"block_id\": \"blk:v2_n_6_4_2:p2\",\n      \"kind\": \"paragraph\",\n      \"text\": \"本试验存在必须使用的背景治疗：稳定背景鼻用激素。该背景治疗允许在研究期间继续使用，前提是筛选前已稳定使用，且研究期间种类和剂量不变；其时间安排为从筛选期确认稳定使用开始，持续至第24周主要终点评估/末次随访，研究期间保持剂量和频率稳定。禁止自行调整背景鼻用激素的稳定方案。\",\n      \"evidence_refs\": []\n    },\n    {\n      \"block_id\": \"blk:v2_n_6_4_2:t1\",\n      \"kind\": \"table\",\n      \"evidence_refs\": [],\n      \"table\": {\n        \"table_id\": \"tbl:v2_n_6_4_2:allowed_treatments\",\n        \"block_id\": \"blk:v2_n_6_4_2:t1\",\n        \"title\": \"允许治疗清单、时间安排与记录要求\",\n        \"domain\": \"generic\",\n        \"role\": \"body_content\",\n        \"review_state\": \"ai_draft\",\n        \"version\": 0,\n        \"schema_version\": \"structured_table_v1\",\n        \"header_row_count\": 1,\n        \"columns\": [\n          {\n            \"column_id\": \"col:t1:allowed_item\",\n            \"label\": \"允许项目\",\n            \"order\": 0,\n            \"semantic_role\": \"allowed_item\"\n          },\n          {\n            \"column_id\": \"col:t1:rule\",\n            \"label\": \"项目特定规则\",\n            \"order\": 1,\n            \"semantic_role\": \"rule\"\n          },\n          {\n            \"column_id\": \"col:t1:timing\",\n            \"label\": \"允许时间安排\",\n            \"order\": 2,\n            \"semantic_role\": \"timing\"\n          },\n          {\n            \"column_id\": \"col:t1:record\",\n            \"label\": \"记录要求\",\n            \"order\": 3,\n            \"semantic_role\": \"record\"\n          }\n        ],\n        \"rows\": [\n          {\n            \"row_id\": \"r:t1:header\",\n            \"order\": 0,\n            \"cells\": [\n              {\n                \"cell_id\": \"cell:t1:header:allowed_item\",\n                \"row_id\": \"r:t1:header\",\n                \"column_id\": \"col:t1:allowed_item\",\n                \"text\": \"允许项目\",\n                \"provenance_lineage\": []\n              },\n              {\n                \"cell_id\": \"cell:t1:header:rule\",\n                \"row_id\": \"r:t1:header\",\n                \"column_id\": \"col:t1:rule\",\n                \"text\": \"项目特定规则\",\n                \"provenance_lineage\": []\n              },\n              {\n                \"cell_id\": \"cell:t1:header:timing\",\n                \"row_id\": \"r:t1:header\",\n                \"column_id\": \"col:t1:timing\",\n                \"text\": \"允许时间安排\",\n                \"provenance_lineage\": []\n              },\n              {\n                \"cell_id\": \"cell:t1:header:record\",\n                \"row_id\": \"r:t1:header\",\n                \"column_id\": \"col:t1:record\",\n                \"text\": \"记录要求\",\n                \"provenance_lineage\": []\n              }\n            ]\n          },\n          {\n            \"row_id\": \"r:t1:1\",\n            \"order\": 1,\n            \"cells\": [\n              {\n                \"cell_id\": \"intervention:cell:allowed_item\",\n                \"row_id\": \"r:t1:1\",\n                \"column_id\": \"col:t1:allowed_item\",\n                \"text\": \"稳定背景鼻用激素\",\n                \"provenance_lineage\": []\n              },\n              {\n                \"cell_id\": \"cell:t1:1:rule\",\n                \"row_id\": \"r:t1:1\",\n                \"column_id\": \"col:t1:rule\",\n                \"text\": \"允许在研究期间继续使用，前提是筛选前已稳定使用且研究期间种类和剂量不变。\",\n                \"provenance_lineage\": []\n          