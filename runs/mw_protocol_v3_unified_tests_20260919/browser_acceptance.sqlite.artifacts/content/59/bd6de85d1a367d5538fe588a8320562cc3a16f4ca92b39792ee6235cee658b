{"content":"{\n  \"status\": \"ready_for_review\",\n  \"objectives\": {\n    \"primary\": [\n      {\n        \"text\": \"评估合成药X 150 mg/1.0 mL皮下给药方案（负荷期第1、8、15、22天每周一次共4次；维持期第36天起每两周一次至第24周末次给药）相较安慰剂在成人慢性鼻窦炎伴鼻息肉患者中第24周临床缓解率的优效性。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户简报明确研究为Ⅱ期概念验证、随机双盲、安慰剂对照优效性设计，主要终点为第24周临床缓解率。\",\n        \"references\": []\n      }\n    ],\n    \"secondary\": [\n      {\n        \"text\": \"评价第24周SNOT-22较基线的变化（关键次要终点，采用固定序列检验控制多重性）。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户简报明确次要终点包括SNOT-22变化，并指定其作为关键次要终点采用固定序列检验。\",\n        \"references\": []\n      },\n      {\n        \"text\": \"评价第24周Lund-Kennedy内镜评分较基线的变化（描述性分析）。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户简报明确次要终点包括Lund-Kennedy内镜评分，并指定为描述性分析。\",\n        \"references\": []\n      }\n    ],\n    \"questions\": []\n  },\n  \"endpoint\": {\n    \"primary_endpoint\": {\n      \"text\": \"第24周临床缓解率：第24周达到双侧鼻息肉评分（NPS）≤1且鼻塞VAS≤1的受试者比例。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"主要终点为第24周临床缓解率，输入明确给出操作定义；其中NPS≤1且鼻塞VAS≤1的操作定义标注为建议值，按已采纳推荐处理。\",\n      \"references\": []\n    },\n    \"measurement_details\": \"NPS采用0～8分（每侧0～4分的双侧总和），缓解阈值为≤1分；鼻塞VAS采用0～10 cm视觉模拟量表，缓解阈值为≤1分；第24周评估临床缓解率。\",\n    \"key_secondary\": [\n      {\n        \"text\": \"第24周SNOT-22较基线变化。\",\n        \"basis\": \"user\",\n        \"reason\": \"用户简报明确SNOT-22变化为次要终点，并作为关键次要终点纳入固定序列检验以控制多重性。\",\n        \"references\": []\n      }\n    ],\n    \"questions\": []\n  },\n  \"estimand\": {\n    \"treatment\": {\n      \"text\": \"合成药X 150 mg/1.0 mL皮下注射：负荷期第1、8、15、22天每周一次共4次；维持期第36天起每两周一次至第24周末次给药。安慰剂为生理盐水1.0 mL皮下注射，同体积、同途径、同频率给药。\",\n      \"basis\": \"user\",\n      \"reason\": \"用户简报和已确认给药方案明确试验组与安慰剂组的剂量、途径、频率和给药时点。\",\n      \"references\": []\n    },\n    \"population\": {\n      \"text\": \"成人慢性鼻窦炎伴鼻息肉患者；允许稳定背景鼻用激素并记录。主要分析集为FAS（ITT原则），按随机分组进行分析。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"研究人群在用户简报中明确；FAS/ITT原则为输入中已给出的操作性定义建议值，按已采纳推荐处理。\",\n      \"references\": []\n    },\n    \"variable\": {\n      \"text\": \"第24周临床缓解，定义为双侧鼻息肉评分（NPS）≤1且鼻塞VAS≤1。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"主要终点变量在用户简报中明确，NPS/VAS阈值及量表范围为输入中已给出的操作性定义建议值。\",\n      \"references\": []\n    },\n    \"ice_strategy\": {\n      \"text\": \"ICE按治疗策略（treatment policy）处理。ICE事件包括鼻塞加重需全身激素或手术干预、因不良事件停药、失访；救援治疗定义为因鼻塞加重使用全身激素或鼻窦手术。第24周缺失主要终点采用无应答插补（NRI），敏感性分析采用tipping point。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"用户简报明确ICE按治疗策略处理并列出ICE事件；NRI和tipping point为输入中已给出的操作性定义建议值。\",\n      \"references\": []\n    },\n    \"summary_measure\": {\n      \"text\": \"第24周临床缓解率（比例）。主要比较为优效性检验，采用按中心分层的CMH检验，报告风险差及95%CI。\",\n      \"basis\": \"recommendation\",\n      \"reason\": \"主要比较和统计方法在输入操作性定义中明确给出，按已采纳推荐处理。\",\n      \"references\": []\n    },\n    \"ice_events\": [\n      \"鼻塞加重需全身激素或手术干预\",\n      \"因不良事件停药\",\n      \"失访\"\n    ],\n    \"questions\": []\n  },\n  \"sample_size\": {\n    \"assumptions\": [\n      \"主要终点为第24周临床缓解率，安慰剂组缓解率20%，合成药X组缓解率35%（绝对差15个百分点）。\",\n      \"双侧α=0.05，检验效能90%。\",\n      \"随机1:1，按中心分层；主要分析采用CMH分层检验并报告风险差及95%CI。\",\n      \"失访/缺失主要终点假设为8%。\",\n      \"无期中分析计划。\",\n      \"样本量估算基于两独立比例比较的正态近似；未对中心分层导致的小样本层额外膨胀做调整，CMH分层为主要分析方法。\"\n    ],\n    \"alpha\": \"双侧α=0.05\",\n    \"power\": \"90%\",\n    \"model\": \"样本量计算采用1:1两独立比例的正态近似；主要分析模型为按中心分层的CMH检验，报告风险差及95%CI。\",\n    \"planned_n\": \"约404例随机（每组约202例）。\",\n    \"attrition\": \"8%\",\n    \"justification\": \"按安慰剂组20%、试验组35%、双侧α=0.05、power=90%、1:1随机，未调整失访时每组约需184.1例可评价受试者（向上取整185例，总370例）；按8%失访膨胀并采用保守向上取整，每组约202例，总约404例。中心数量及小层规模未在输入中给出，统计分析计划中应复核分层分析对样本量的影响。\",\n    \"references\": [],\n    \"questions\": []\n  },\n  \"interim_planning\": null,\n  \"non_inferiority_margin\": null,\n  \"questions\": [],\n  \"unresolved_questions\": []\n}","receipt":{"idempotency_key":"design-elements.generate.v1","input_artifacts":[{"ref":"design-elements-intake","sha256":"c7e6dddcb7ddb57a35a0080c905d61fb3f5772ddc696ae1e2eff67a9a29d056c"}],"