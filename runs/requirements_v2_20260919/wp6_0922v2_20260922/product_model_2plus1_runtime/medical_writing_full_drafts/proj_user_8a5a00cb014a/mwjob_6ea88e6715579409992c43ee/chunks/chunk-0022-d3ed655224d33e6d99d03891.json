{"ai_run_id":"airun_20260922034202_8d578eb2","chunk_index":22,"job_id":"mwjob_6ea88e6715579409992c43ee","precondition_digest":"968aabd6184f764b8be1b297092e19b0d5f45b861c3a384214982b8cdb9452d9","project_id":"proj_user_8a5a00cb014a","schema_version":"protocol_full_draft_chunk_v7","section_ids":["mwsec_greenfield_proj_user_8a5a00cb014a_c41ac953b62f7d4d"],"sections":[{"ai_run_id":"airun_20260922034202_8d578eb2","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:d3ed655224d33e6d99d03891","quote":"SECTION_ID=mwsec_greenfield_proj_user_8a5a00cb014a_c41ac953b62f7d4d\n章节编号=14.5\n章节标题=项目特异附录\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"9e14ba05f2a6db7154d4e5b86b4b1baf170005551bdedde902034b4571e06303","source_id":"protocol_full_draft_selection:d3ed655224d33e6d99d03891","span_id":"span_section_packet"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究时期：筛选期：最长4周。；双盲治疗期：16周。；安全性随访期：4周。","quote_sha256":"1df9f3c36a7060d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_study_periods"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"访视策略：筛选后于基线/第1天随机；第2、4、8、12、16周进行治疗期访视，第20周进行安全性随访。PASI和sPGA于基线及第4、8、12、16周评价。","quote_sha256":"8c7a570d51b842be51c8689066b3d6fe50030b8229d96708644c920d085e82c5","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_visit_schedule"}],"evidence_span_ids":["span_section_packet","span_study_periods","span_visit_schedule"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"heading":"项目特异附录","missing_source_classes":[],"proposal_text":"本附录汇总本项目特有的访视与评估安排。研究分为筛选期、双盲治疗期和安全性随访期，其中筛选期最长持续4周，双盲治疗期为16周，安全性随访期为4周。受试者在完成筛选后于基线/第1天进行随机化。治疗期访视分别安排在第2周、第4周、第8周、第12周和第16周；安全性随访访视安排在第20周。PASI和sPGA的评估时间点为基线以及第4周、第8周、第12周和第16周。上述访视与评估安排应与方案正文中相应章节的描述保持一致。","rationale":"本节正文基于当前项目已确认研究事实中的研究时期和访视策略撰写，明确了筛选期最长4周、双盲治疗期16周、安全性随访期4周，以及第2、4、8、12、16周治疗期访视、第20周安全性随访和PASI/sPGA于基线及第4、8、12、16周评价。医学作者需核对项目特异附录是否还需纳入其他项目特有补充材料（如数据采集工具的项目特异设置、实验室手册或量表版本），并确认访视窗口的具体规定。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_c41ac953b62f7d4d","section_number":"14.5","source_ids":["protocol_full_draft_selection:d3ed655224d33e6d99d03891","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:2410eb4e97ccdc","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:201bf55c2c14d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:43de5d7d9a7af4","company_corpus:cms_cn_protocol_corpus_20260715_v1:2d13968ff4efdd"]}],"source_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:d3ed655224d33e6d99d03891","source_id":"protocol_full_draft_selection:d3ed655224d33e6d99d03891","source_type":"protocol_full_draft_selection","text_sha256":"9e14ba05f2a6db7154d4e5b86b4b1baf170005551bdedde902034b4571e06303"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","source_type":"current_project_study_definition","text_sha256":"787313a6f081b1c9afdf03800feb1c50c317aa4aa4f0c3884e924b0594e666da"},{"locator":"section:统计分析单位签字页|block:44|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:2410eb4e97ccdc","source_type":"company_protocol_reference_corpus","text_sha256":"396bb84db9de267f89e9a39704222963198b4e25b2ffe751a8f592945f818cfa"},{"locator":"section:7.3.1 病例报告表的设计|block:1037|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","source_type":"company_protocol_reference_corpus