56":"8c7a570d51b842be51c8689066b3d6fe50030b8229d96708644c920d085e82c5","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ev_sd_visits"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"统计分析策略：全分析集按随机分组采用CMH方法比较主要终点，报告应答率差、95%置信区间和P值，以优效性为目标。主要缺失处理采用无应答填补，并以多重插补和观察病例分析进行敏感性分析；安全性集按实际治疗分析。不开展期中分析。","quote_sha256":"ccd7b348358b71793f3761994bf0e928e73abcd319f577b74f5285d5c99e3b7c","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ev_sd_stats"}],"evidence_span_ids":["ev_pkt_sec31","ev_sd_objectives","ev_sd_endpoints","ev_sd_estimand","ev_sd_visits","ev_sd_stats"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"heading":"主要目的和主要终点","missing_source_classes":[],"proposal_text":"主要研究目的为评价合成试验药A（100 mg口服，每日一次）相较匹配安慰剂治疗成人中重度斑块状银屑病的疗效。主要终点为第16周达到PASI 75应答（较基线PASI评分改善≥75%）的受试者比例，该终点基于治疗策略人群即所有随机受试者进行评价；受试者停药或使用救援治疗按复合策略判定为无应答，其他缺失数据采用无应答填补，并报告组间应答率差及95%置信区间。PASI于基线及第4、8、12、16周进行评价，主要终点以第16周作为评价时点；主要终点的组间比较采用CMH方法，以优效性为目标。","rationale":"正文依据已确认的主要研究目的、主要终点（第16周PASI 75应答率）、估计目标策略、CMH比较方法及PASI评价时点扩写。需医学作者核对：主要目的表述与主要终点定义在全文中的一致性，以及组间比较结果的呈现方式。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"required","review_reasons":["本节直接设定高影响设计或研究实施决定（主要目的和主要终点），请逐卡确认。"],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_db5f25e7dd5b8877","section_number":"3.1","source_ids":["protocol_full_draft_selection:766727f54515189878dfd671","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:6b9f50aa913504"]},{"ai_run_id":"airun_20260922025608_9db3204d","content_status":"decision_required","decision_items":[{"blocking_section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_9e670d193fbbb761","fact_path":"picos.exploratory_objectives","options":[{"label":"补充疗效与安全性特征描述","option_id":"opt_objective_supportive","summary":"在主要和次要终点体系内，对治疗反应作描述性扩展，不引入新的机制性指标。"},{"label":"作用机制与生物标志物探索","option_id":"opt_objective_biomarker","summary":"围绕药物作用或疾病活动度相关的生物标志物、药效学指标设定探索性目的。"},{"label":"不设探索性目的","option_id":"opt_objective_none","summary":"不再单独设定探索性目的，仅保留主要、次要和安全性目的。"}],"question":"探索性目的是否设定，以及应聚焦哪类研究问题？","rationale":"推荐项与已确认的主要、次要终点评价体系衔接，属于最小扩展；是否采用及最终表述须由医学作者确认。","recommended_option_id":"opt_objective_supportive"},{"blocking_section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_9e670d193fbbb761","fact_path":"picos.exploratory_endpoints","options":[{"label":"基于PASI体系的补充疗效指标","option_id":"opt_endpoint_supportive","summary":"沿用已确认的PASI评价时点，补充其他应答阈值或描述性疗效指标，不改变主要终点分析策略。"},{"label":"生物标志物或药效学指标","option_id":"opt_endpoint_biomarker","summary":"以生物标志物、药效学指标作为探索性终点，需另行明确采样时点与检测方法。"},{"label":"不设探索性终点","option_id":"opt_endpoint_none","summary":"方案不单列探索性终点，仅保留主要、关键次要、其他次要和安全性终点。"}],"question":"探索性终点采用哪类指标，并如何与既有评价时点衔接？","rationale":"推荐项可在已确认的PASI评价框架内实施，避免新增未确认的检测安排；最终指标与时点须由医学作者确认。","recommended_option_id":"opt_endpoint_supportive"}],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:766727f54515189878dfd671","quote":"章节编号=3.3\n章节标题=探索性目的和探索性终点\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"05380a29f8ef8bacd6188403e706918dc04dd73c2374c00e3ff5d002b53e06d6","source_id":"protocol_full_draft_selection:766727f54515189878dfd671","span_id":"ev_pkt_sec33"}],"evidence_span_ids":["ev_pkt_sec33"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"heading":"探索性目的和探索性终点","missing_source_classes":[],"proposal_text":"","rationale":"现有确认事实未定义探索性目的与探索性终点，正文保持空白，并以决定项提出待确认内容；推荐项仅为待审建议，须经医学作者确认后方可形成章节正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_9e670d193fbbb761","section_number":"3.3","source_ids":["protocol_full_draft_selection:766727f54515189878dfd671","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:6b9f50aa913504"]},{"ai_run_id":"airun_20260922025608_9db3204d","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究题目：合成试验药A用于治疗成人中重度斑块状银屑病的III期临床研究\n试验药物：合成试验药A\n适应症：成人中重度斑块状银屑病\n研究分期：III期\n开发区域：中国\n内在研究目的：确证性研究","quote_sha256":"8269c0ca3715091483ef89708c04da728479327d520e21f17020f5b5783f5b89","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ev_sd_header"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"总体研究设计：平行组（parallel assignment）、双盲、安慰剂对照、随机\n目标研究人群：成人中重度斑块状银屑病患者\n随机化方式：随机分配\n对照措施：匹配安慰剂\n分配模型：平行组（parallel assignment）\n中心模式：多中心","quote_sha256":"9546677f90c38af4d30a7b2ba79669a1527fc3fc8f8caced3e12f9f4b35c0ec4","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ev_sd_design"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"样本量再估计是否计划：否\n期中分析是否计划：否\n药物技术类型：small_molecule\n给药途径：口服\n剂型：口服固体制剂\n局部/系统暴露范围：systemic","quote_sha256":"60720fbca8a6d9b83c04e5ec0a2a20b3867f3acdd3aa832af80ea6c6c180f430","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ev_sd_misc"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究人群概述：确诊为斑块状银屑病、疾病严重程度为中重度的成人受试者。\n入选标准模块：年龄≥18岁；确诊斑块状银屑病≥6个月；筛选及基线时PASI≥12、受累体表面积≥10%、sPGA≥3；适合接受系统治疗或光疗。\n排除标准模块：非斑块型银屑病为主要表现，或存在可能干扰疗效/安全性评价的其他活动性皮肤病；活动性严重感染；妊娠或哺乳期；研究者判断不适合参加。","quote_sha256":"bffa03cf578db8b4f95f6d99561aec5f2806c3dc7bb5477fde2982b68fa6bb79","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ev_sd_population"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"试验干预：试验组接受合成试验药A 100 mg口服，每日一次，连续16周；对照组接受匹配安慰剂。\n剂量与给药方案：合成试验药A：100 mg，每日一次（QD）（口服）；第1天至第16周。依从：通过药品计数及受试者日记评价依从性\n匹配安慰剂：每日一次（QD）（口服）；第1天至第16周双盲治疗期。依从：通过药品计数及受试者日记评价依从性","quote_sha256":"593bba668c7b8876ab4fde41e75ef3db582fd7354f8205c66132c569107988ac","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ev_sd_intervention"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"对照：匹配安慰剂对照；试验组与安慰剂组按1:1随机分配，双盲治疗16周。","quote_sha256":"bcf69f1343deaa3b4cd6b8ab0fd4fbac84bf974c3118292b17999b1ba93aa172","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ev_sd_comparator"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究时期：筛选期：最长4周。；双盲治疗期：16周。；安全性随访期：4周。","quote_sha256":"1df9f3c36a7060d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ev_sd_periods"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"访视策略：筛选后于基线/第1天随机；第2、4、8、12、16周进行治疗期访视，第20周进行安全性随访。PASI和sPGA于基线及第4、8、12、16周评价。","quote_sha256":"8c7a570d51b842be51c8689066b3d6fe50030b8229d96708644c920d085e82c5","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ev_sd_visits"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"样本量策略：假设第16周PASI 75应答率试验组为60%、安慰剂组为30%，双侧α=0.05、把握度90%、1:1随机，并考虑15%脱落，共计划入组132例（每组66例）。","quote_sha256":"2088842f2548655845b43f017bb904dc2663a94d1a5c7a802e7adf8daa68b0d2","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ev_sd_sample"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"统计分析策略：全分析集按随机分组采用CMH方法比较主要终点，报告应答率差、95%置信区间和P值，以优效性为目标。主要缺失处理采用无应答填补，并以多重插补和观察病例分析进行敏感性分析；安全性集按实际治疗分析。不开展期中分析。","quote_sha256":"ccd7b348358b71793f3761994bf0e928e73abcd319f577b74f5285d5c99e3b7c","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ev_sd_stats"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"估计目标策略：治疗策略人群为所有随机受试者；比较第16周PASI 75应答。停药或使用救援治疗按复合策略判定为无应答，其他缺失数据采用无应答填补；报告组间率差及95%置信区间。","quote_sha256":"44f71070d9cdb5b6b69ad6feeeb7fbfeef4aad105693eaa3500bedd537f18414","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ev_sd_estimand"}],"evidence_span_ids":["ev_sd_header","ev_sd_design","ev_sd_misc","ev_sd_population","ev_sd_intervention","ev_sd_comparator","ev_sd_periods","ev_sd_visits","ev_sd_sample","ev_sd_stats","ev_sd_estimand"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":11},"heading":"研究设计","missing_source_classes":[],"proposal_text":"本研究为在中国开展的III期确证性临床研究，采用多中心、随机、双盲、安慰剂对照、平行组设计，评价合成试验药A治疗成人中重度斑块状银屑病的疗效与安全性。计划入组确诊为斑块状银屑病且疾病严重程度为中重度的成人受试者，年龄≥18岁，确诊斑块状银屑病≥6个月，筛选及基线时PASI≥12、受累体表面积≥10%、sPGA≥3，且适合接受系统治疗或光疗；排除以非斑块型银屑病为主要表现或存在可能干扰疗效/安全性评价的其他活动性皮肤病、活动性严重感染、妊娠或哺乳期，以及研究者判断不适合参加的受试者。受试者按1:1随机分配至试验组或对照组。试验组接受合成试验药A 100 mg口服，每日一次，第1天至第16周；对照组接受匹配安慰剂，每日一次，第1天至第16周双盲治疗期；依从性通过药品计数及受试者日记评价。研究时期包括最长4周的筛选期、16周双盲治疗期和4周安全性随访期；筛选后于基线/第1天随机，第2、4、8、12、16周进行治疗期访视，第20周进行安全性随访，PASI和sPGA于基线及第4、8、12、16周评价。样本量按第16周PASI 75应答率试验组60%、安慰剂组30%，双侧α=0.05、把握度90%、1:1随机并考虑15%脱落估算，计划入组132例（每组66例）；不计划样本量再估计，不开展期中分析。主要终点在治疗策略人群（所有随机受试者）中评价，停药或使用救援治疗按复合策略判定为无应答，其他缺失数据采用无应答填补；全分析集按随机分组采用CMH方法比较主要终点，报告应答率差、95%置信区间和P值，以优效性为目标，并以多重插补和观察病例分析进行敏感性分析；安全性集按实际治疗分析。合成试验药A为小分子口服固体制剂，经口服途径给药，属系统性暴露。","rationale":"正文依据已确认的总体设计（III期、多中心、随机、双盲、安慰剂对照、平行组、1:1）、目标人群与入选排除要点、给药方案、研究时期与访视安排、样本量估算及主要终点统计分析策略撰写。需医学作者核对：随机化与盲法实施细节、救援治疗及缺失数据处理的操作定义、依从性记录方式，以及入选排除标准的完整表述。","review_advisories":["本节提及高影响设计信息（α、主要终点、期中分析、样本量、计划入组）；系统未把重复提及升级为强制确认。"],"review_level":"required","review_reasons":["本节直接设定高影响设计或研究实施决定（研究设计），请逐卡确认。"],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_1741b1557c67abd7","section_number":"4","source_ids":["protocol_full_draft_selection:766727f54515189878dfd671","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:6b9f50aa913504"]}],"source_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:766727f54515189878dfd671","source_id":"protocol_full_draft_selection:766727f54515189878dfd671","source_type":"protocol_full_draft_selection","text_sha256":"93840d460fbf8d92b1dbf188662859f1b30c9e2cc4ddfbbc950d117ebaef7dcf"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","source_type":"current_project_study_definition","text_sha256":"787313a6f081b1c9afdf03800feb1c50c317aa4aa4f0c3884e924b0594e666da"},{"locator":"section:8.4.9.2 不良事件|block:1136|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","source_type":"company_protocol_reference_corpus","text_sha256":"a4dbbca5ee93dd8afdc70483dd7648214180490ccefcd4eceab6680c02415d81"},{"locator":"section:7.3.1 病例报告表的设计|block:1037|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","source_type":"company_protocol_reference_corpus","text_sha256":"a081fa03f5ce0ceb2ca2444ea6b2a850997611938884f75fa4f6b5e188b3af68"},{"locator":"section:统计分析单位签字页|block:57|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","source_type":"company_protocol_reference_corpus","text_sha256":"288c4151aa03e0bb0feffeb19ae4b67d399ea214ab90d8f02d3dd67800bdd070"},{"locator":"section:统计分析单位签字页|block:56|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","source_type":"company_protocol_reference_corpus","text_sha256":"ce0d2dfe125632cc5d7e00e964022f9cd73382987f5a821bb4cc70694b086ad9"},{"locator":"section:研究目的和终点|block:321|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:6b9f50aa913504","source_type":"company_protocol_reference_corpus","text_sha256":"67acce9109ac9afcabc94dc949b010c17d925d27ae49d9aaf0c358c3c7d229e1"}]}