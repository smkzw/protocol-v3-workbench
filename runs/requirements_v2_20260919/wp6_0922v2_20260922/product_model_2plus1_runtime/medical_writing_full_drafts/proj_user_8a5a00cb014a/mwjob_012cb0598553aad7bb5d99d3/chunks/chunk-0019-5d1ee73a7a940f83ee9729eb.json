":"a668438495209c1a93ff8056f3ef958a45b23c7f699057c8114de2ccc026a93e"},{"content_sha256":"7efe71dbc609553fdc2a0fa8836b8cd21ab8fdeb657d90ec493ef48b00b6bff8","locator":"section:研究的伦理指导|block:904|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:cebb133a914e24","source_type":"company_protocol_reference_corpus","source_version":"cebb133a914e24","text_sha256":"7efe71dbc609553fdc2a0fa8836b8cd21ab8fdeb657d90ec493ef48b00b6bff8"},{"content_sha256":"dfc9fceb41db9d941df0e3715483adaa069da4f1953600a6a37a56d7f81373dd","locator":"section:文档开头|block:4|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","source_type":"company_protocol_reference_corpus","source_version":"342cfc57d67b67","text_sha256":"dfc9fceb41db9d941df0e3715483adaa069da4f1953600a6a37a56d7f81373dd"}]}