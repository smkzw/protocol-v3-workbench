source_classes":["流行病学与疾病负担来源"],"target":"第2章 研究背景和立项依据—疾病流行与疾病负担论述"},{"action":"补充国内外斑块状银屑病诊疗指南/共识与治疗现状来源后撰写相应段落","category":"source_missing","gap_id":"GAP-S2-02","missing_source_classes":["国内外斑块状银屑病诊疗指南/共识","系统性治疗与光疗治疗现状来源"],"target":"第2章 研究背景和立项依据—诊疗指南与治疗现状论述"},{"action":"补充研究药物非临床与既往临床研究资料后撰写相应段落","category":"source_missing","gap_id":"GAP-S2-03","missing_source_classes":["研究药物非临床研究资料","既往临床研究资料","研究者手册"],"target":"第2章 研究背景和立项依据—研究药物开发依据论述"}],"heading":"研究背景和立项依据","missing_source_classes":["流行病学与疾病负担来源","国内外诊疗指南与治疗现状来源","研究药物非临床与既往临床研究资料"],"proposal_text":"本项目拟开发合成试验药A用于治疗成人中重度斑块状银屑病。合成试验药A为小分子药物，经口服途径给药，剂型为口服固体制剂，属系统暴露。本研究为在中国开展的III期确证性临床研究，目标人群为确诊为斑块状银屑病、疾病严重程度为中重度的成人受试者，采用多中心、平行组、随机、双盲、安慰剂对照设计，并以匹配安慰剂为对照措施。本研究的立项依据为：在成人中重度斑块状银屑病患者中开展设计规范的III期确证性研究，在双盲、安慰剂对照条件下评价合成试验药A相较安慰剂的疗效与安全性，为该药物在该人群中的确证性评价提供依据。","rationale":"本章节依据已确认研究事实中的适应症、药物技术类型、给药途径、剂型、系统暴露属性、开发区域、研究分期、研究目的与总体设计撰写立项依据。流行病学、疾病负担、诊疗指南与治疗现状以及研究药物的非临床与既往临床资料未在允许来源中出现，相关内容以gap_items标注待补。请医学负责人核对立项依据表述与最终背景资料的一致性。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_0687d5113cc82a0a","section_number":"2","source_ids":["protocol_full_draft_selection:303cfd29bc0d07ab22cb8ae6","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:8054da15ded3d2","company_corpus:cms_cn_protocol_corpus_20260715_v1:8906e921bf8a9f"]},{"ai_run_id":"airun_20260922132406_af813deb","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"检索并提交斑块状银屑病流行病学、疾病负担、诊疗指南与治疗现状来源后撰写全章","category":"source_missing","gap_id":"GAP-S21-01","missing_source_classes":["流行病学资料",