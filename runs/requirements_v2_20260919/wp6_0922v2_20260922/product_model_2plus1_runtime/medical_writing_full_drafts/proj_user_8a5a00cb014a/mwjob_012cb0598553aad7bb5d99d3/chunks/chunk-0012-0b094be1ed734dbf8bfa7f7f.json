t"}],"evidence_span_ids":["ev_sel_8","ev_population","ev_safety_endpoints","ev_periods","ev_visits","ev_safety_set"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"获取并确认项目安全性管理文件与术语定义依据，明确AE/SAE/SUSAR定义、采集与报告要求。","category":"source_missing","gap_id":"gap_s8_safety_definitions","missing_source_classes":["项目安全性管理文件（AE/SAE/SUSAR定义与报告流程）","研究者手册"],"target":"8 安全性评价中术语定义与事件采集报告相关子章节"},{"action":"获取并确认安全性评估时间表或访视计划文件，明确实验室检查、生命体征及12导联心电图的采集时点。","category":"source_missing","gap_id":"gap_s8_assessment_timing","missing_source_classes":["安全性评估时间表或访视计划文件"],"target":"8 安全性评价中安全性评估时点与检查安排"}],"heading":"安全性评价","missing_source_classes":["项目安全性管理文件（AE/SAE/SUSAR定义与报告流程）","安全性评估时间表或访视计划文件","不良事件严重程度分级与因果关系评价标准文件"],"proposal_text":"本研究在成人中重度斑块状银屑病患者中评价合成试验药A的安全性。研究时期包括最长4周的筛选期、16周双盲治疗期及4周安全性随访期，安全性随访于第20周访视进行。安全性终点包括治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件发生率，以及实验室检查、生命体征及12导联心电图具有临床意义的变化。安全性分析按安全性集进行，依据受试者实际接受的治疗进行分组分析。","rationale":"已确认研究事实支持安全性评价的人群、观察时期、安全性终点及安全性集分析方式；AE/SAE/SUSAR定义、事件采集与报告流程及各项安全性检查的时点安排缺少项目来源，需医学作者确认相应项目文件。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_7693d868c98988a2","section_number":"8","source_ids":["protocol_full_draft_selection:0b094be1ed734dbf8bfa7f7f","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]},{"ai_run_id":"airun_20260922140641_5fc28e3e","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:0b094be1ed734dbf8bfa7f7f","quote":"章节编号=8.1\n章节标题=总则\n章节类型=section","quote_sha256":"69760344340a95ea9eaef92e9f29d01f2459c4c003f781cb3aa12485adb4e9ad","source_id":"protocol_full_draft_selection:0b094be1ed734dbf8bfa7f7f","span_id":"ev_sel_8_1"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"适应症：成人中重度斑块状银屑病","quote_sha256":"dea7d22754107be0e06f2a8925034c9cf46e7a270521c79bf1c536