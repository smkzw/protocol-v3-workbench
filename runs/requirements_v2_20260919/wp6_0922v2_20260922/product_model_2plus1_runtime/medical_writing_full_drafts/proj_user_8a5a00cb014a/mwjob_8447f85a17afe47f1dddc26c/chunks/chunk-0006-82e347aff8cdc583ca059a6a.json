{"ai_run_id":"airun_20260922015830_4bf1ab92","chunk_index":6,"job_id":"mwjob_8447f85a17afe47f1dddc26c","precondition_digest":"7349d025237003fc2a71649e47dc3f181ea6e6f1b327c41c9a0c64a4929460d8","project_id":"proj_user_8a5a00cb014a","schema_version":"protocol_full_draft_chunk_v6","section_ids":["mwsec_greenfield_proj_user_8a5a00cb014a_786ed871c599f48b","mwsec_greenfield_proj_user_8a5a00cb014a_b7e45f89bd422b0c","mwsec_greenfield_proj_user_8a5a00cb014a_4c48871b5365c1fd","mwsec_greenfield_proj_user_8a5a00cb014a_7a3cc05f07007ef0"],"sections":[{"ai_run_id":"airun_20260922015830_4bf1ab92","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"入选标准模块：年龄≥18岁；确诊斑块状银屑病≥6个月；筛选及基线时PASI≥12、受累体表面积≥10%、sPGA≥3；适合接受系统治疗或光疗。","quote_sha256":"3e9ca06af65f6aeb7e28df97f2a93f40d8966553fa5faff3f806e43f762999dd","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ev_incl_def"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究人群概述：确诊为斑块状银屑病、疾病严重程度为中重度的成人受试者。","quote_sha256":"a8e79e0e0422cd44b88dc3e21e985b80d8a582156f8af354719235edcd236224","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ev_pop_def"},{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:82e347aff8cdc583ca059a6a","quote":"当前正文=年龄≥18岁；确诊斑块状银屑病≥6个月；筛选及基线时PASI≥12、受累体表面积≥10%、sPGA≥3；适合接受系统治疗或光疗。","quote_sha256":"4a361364c08914600529cb513f9a0a805487ea58439e6a00b200463e1e922e1c","source_id":"protocol_full_draft_selection:82e347aff8cdc583ca059a6a","span_id":"ev_incl_sel"}],"evidence_span_ids":["ev_incl_def","ev_pop_def","ev_incl_sel"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"heading":"入选标准","missing_source_classes":[],"proposal_text":"拟入组受试者须同时满足以下条件：（1）年龄≥18岁；（2）确诊斑块状银屑病≥6个月；（3）筛选及基线时PASI≥12、受累体表面积≥10%、sPGA≥3；（4）适合接受系统治疗或光疗。研究人群为确诊为斑块状银屑病且疾病严重程度为中重度的成人受试者。研究者应在筛选期及基线时依据上述条件逐项确认受试者的合格性，全部满足者方可入组本研究。","rationale":"依据已确认研究定义中的入选标准模块和目标研究人群生成：年龄≥18岁、确诊斑块状银屑病≥6个月、筛选及基线时PASI≥12、受累体表面积≥10%、sPGA≥3、适合接受系统治疗或光疗；人群为确诊斑块状银屑病且中重度的成人。医学作者需核对是否补充其他项目特异的入选条件。","review_advisories":[],"review_level":"required","review_reasons":["本节直接设定高影响设计或研究实施决定（入选标准），请逐卡确认。"],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_786ed871c599f48b","section_number":"5.3","source_ids":["protocol_full_draft_selection:82e347aff8cdc583ca059a6a","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]},{"ai_run_id":"airun_20260922015830_4bf1ab92","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"heading":"排除标准","missing_source_classes":["支持本章节研究实施规则的项目权威资料或职能确认"],"proposal_text":"","rationale":"依据已确认研究定义中的排除标准模块生成：非斑块型银屑病为主要表现或存在可能干扰疗效与安全性评价的其他活动性皮肤病、活动性严重感染、妊娠或哺乳期、研究者判断不适合参加。医学作者需核对排除标准是否需结合项目安全性考虑进一步细化。","review_advisories":[],"review_level":"required","review_reasons":["本节直接设定高影响设计或研究实施决定（排除标准），请逐卡确认。"],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_b7e45f89bd422b0c","section_number":"5.4","source_ids":["protocol_full_draft_selection:82e347aff8cdc583ca059a6a","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]},{"ai_run_id":"airun_20260922015830_4bf1ab92","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"heading":"筛选失败与重新筛选","missing_source_classes":["本项目筛选失败与重新筛选实施规则（需申办方或医学负责人确认）","本项目筛选期操作流程与筛选编号管理来源"],"proposal_text":"","rationale":"已确认研究事实未包含筛选失败定义、筛选期重复检查、重新筛选条件及筛选编号管理等实施规则；其他适应症方案中的相关描述属于跨适应症参考，不能迁移为本项目既定要求。需由医学作者与申办方确认上述规则后方可形成本章节正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_4c48871b5365c1fd","section_number":"5.5","source_ids":["protocol_full_draft_selection:82e347aff8cdc583ca059a6a","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]},{"ai_run_id":"airun_20260922015830_4bf1ab92","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"试验干预：试验组接受合成试验药A 100 mg口服，每日一次，连续16周；对照组接受匹配安慰剂。","quote_sha256":"f3eff5ef57b4691ff025db695140e4ead682562786c0dec621edcd256ef28af3","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ev_ci"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"剂量与给药方案：合成试验药A：100 mg，每日一次（QD）（口服）；第1天至第16周。依从：通过药品计数及受试者日记评价依从性","quote_sha256":"e97da70f0c9a5d6f604a29b6c054d0ed03fc9fd60470293f55ab4afbebddcff0","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ev_dose"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"匹配安慰剂：每日一次（QD）（口服）；第1天至第16周双盲治疗期。依从：通过药品计数及受试者日记评价依从性","quote_sha256":"6e161fdc710a0a80dfd37e8087ba89849d7bfdb2aa6b1f8d9a2466c304e8fae9","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ev_placebo"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"药物技术类型：small_molecule","quote_sha256":"d8ca21a7e62cbca0e65228c7147e2ce5e59273b60f0d0cc55ed216f48e27710c","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ev_type"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"给药途径：口服","quote_sha256":"404b058b755608a73d13b54521a28c02b129df449774d0671b1c3f8b8a5ce42c","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ev_route"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"剂型：口服固体制剂","quote_sha256":"2c22ee80756bfd178af43cee3c8a0a1b4058aaecb83d264b4107972a334b5bf4","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ev_form"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"局部/系统暴露范围：systemic","quote_sha256":"83a8469236905f60f11fec86f93234f3ddf2027482e82bafa90802a6e138e6e2","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ev_systemic"}],"evidence_span_ids":["ev_ci","ev_dose","ev_placebo","ev_type","ev_route","ev_form","ev_systemic"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":7},"heading":"研究治疗/干预","missing_source_classes":[],"proposal_text":"试验组受试者接受合成试验药A 100 mg口服，每日一次，自第1天至第16周连续给药。对照组受试者接受匹配安慰剂，每日一次口服，给药自第1天至第16周。合成试验药A为小分子口服固体制剂，经口服途径给药，属于全身暴露制剂。治疗期间通过药品计数及受试者日记评价受试者的依从性。两组给药频率均为每日一次，治疗持续16周。","rationale":"依据已确认研究定义中的试验干预、剂量与给药方案、对照及药物技术属性生成：合成试验药A 100 mg口服、每日一次、第1天至第16周；匹配安慰剂同期限给药；依从性通过药品计数及受试者日记评价；药物为小分子口服固体制剂、全身暴露。医学作者需核对药物名称、规格与包装等信息是否需在本章节补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_7a3cc05f07007ef0","section_number":"6","source_ids":["protocol_full_draft_selection:82e347aff8cdc583ca059a6a","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]}],"source_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:82e347aff8cdc583ca059a6a","source_id":"protocol_full_draft_selection:82e347aff8cdc583ca059a6a","source_type":"protocol_full_draft_selection","text_sha256":"399573590b664fd9f8dbf4c77324f833c1c99888b566fdc7e495fa7afc98bd88"},{"locator":"study_definition:mwde