f61c21914","span_id":"ES-04"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"安全性集按实际治疗分析。","quote_sha256":"1268001c52aab5587c60c4485ee589055e72f4636f7ca620998567b780d17001","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ES-05"},{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:b7fa5f78c4ad8164340fd70e","quote":"SECTION_ID=mwsec_greenfield_proj_user_8a5a00cb014a_bd9d9224d94e0ac8\n章节编号=7.3\n章节标题=安全性评估\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"9501b9428a8802d0987fec391e94456308816df6825e26419958f681a5e0169a","source_id":"protocol_full_draft_selection:b7fa5f78c4ad8164340fd70e","span_id":"ES-06"}],"evidence_span_ids":["ES-01","ES-02","ES-03","ES-04","ES-05","ES-06"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"heading":"安全性评估","missing_source_classes":[],"proposal_text":"本研究的安全性评估用于评价合成试验药A在成人中重度斑块状银屑病受试者中的安全性和耐受性。安全性评估与研究的访视安排相衔接：筛选期最长4周，第1天为基线访视，第2、4、8、12、16周为治疗期访视，第20周为安全性随访；双盲治疗期为16周，安全性随访期为4周。安全性终点包括治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件发生率，以及实验室检查、生命体征和12导联心电图具有临床意义的变化。本章分别说明生命体征和体格检查、心电图检查、实验室检查的安全性评估安排。安全性数据按受试者实际接受的治疗进行汇总分析。","rationale":"已确认研究事实支持本章：安全性终点为治疗期间出现的不良事件、严重不良事件及导致停药的不良事件发生率，以及实验室检查、生命体征和12导联心电图具有临床意义的变化；研究时期为筛选期最长4周、双盲治疗期16周、安全性随访期4周；访视安排为第2、4、8、12、16周治疗期访视和第20周安全性随访；安全性数据按实际治疗分析。需医学作者核对：不良事件的定义、分级与报告流程，以及各项安全性评估的具体实施细节。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_bd9d9224d94e0ac8","section_number":"7.3","source_ids":["protocol_full_draft_selection:b7fa5f78c4ad8164340fd70e","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]},{"ai_run_id":"airun_20260922020752_82e72430","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"安全性终点：治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件发生率。；实验室检查、生命体征及12导联心电图具有临床意义的变化。","quote_sha256":"99133b9298d6b094501b14430ac89a3b690a9aa9acb4bb1df325ea3196a44236","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ES-01"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究时期：筛选期：最长4周。；双盲治疗期：16周。；安全性随访期：4周。","quote_sha256":"1df9f3c36a7060d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ES-02"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"访视策略：筛选后于基线/第1天随机；第2、4、8、12、16周进行治疗期访视，第20周进行安全性随访。PASI和sPGA于基线及第4、8、12、16周评价。","quote_sha256":"8c7a570d51b842be51c8689066b3d6fe50030b8229d96708644c920d085e82c5","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ES-03"},{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:b7fa5f78c4ad8164340fd70e","quote":"SECTION_ID=mwsec_greenfield_proj_user_8a5a00cb014a_90b6de05a57a5bcc\n章节编号=7.3.1\n章节标题=生命体征和体格检查\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"0abaa3225c9998d6888f79daa68f0b668f254ec64b9844dac48a6e8b4b8ea396","source_id":"protocol_full_draft_selection:b7fa5f78c4ad8164340fd70e","span_id":"ES-07"}],"evidence_span_ids":["ES-01","ES-02","ES-03","ES-07"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"heading":"生命体征和体格检查","missing_source_classes":[],"proposal_text":"本节说明生命体征和体格检查的安全性评估安排。生命体征和体格检查用于评价受试者在治疗期间的一般健康状况和临床安全性，其中生命体征具有临床意义的变化属于本研究安全性终点的组成部分。双盲治疗期为16周，安全性随访期为4周；相关评估与访视安排相衔接，治疗期访视设于第2、4、8、12、16周，第20周进行安全性随访。对检查中发现的异常，将结合受试者的临床表现及其他安全性评估结果进行评价。生命体征和体格检查结果与实验室检查、12导联心电图等安全性数据共同用于支持对合成试验药A安全性的总体评价。","rationale":"已确认研究事实支持本节：生命体征具有临床意义的变化属于安全性终点组成部分；双盲治疗期16周、安全性随访期4周；治疗期访视设于第2、4、8、12、16周，第20周进行安全性随访。需医学作者核对：生命体征具体项目与测量时点、体格检查的范围与执行方式、异常结果的临床意义判定与记录要求。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_90b6de05a57a5bcc","section_number":"7.3.1","source_ids":["protocol_full_draft_selection:b7fa5f78c4ad8164340fd70e","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]},{"ai_run_id":"airun_20260922020752_82e72430","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"安全性终点：治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件发生率。；实验室检查、生命体征及12导联心电图具有临床意义的变化。","quote_sha256":"99133b9298d6b094501b14430ac89a3b690a9aa9acb4bb1df325ea3196a44236","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ES-01"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究时期：筛选期：最长4周。；双盲治疗期：16周。；安全性随访期：4周。","quote_sha256":"1df9f3c36a7060d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ES-02"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"访视策略：筛选后于基线/第1天随机；第2、4、8、12、16周进行治疗期访视，第20周进行安全性随访。PASI和sPGA于基线及第4、8、12、16周评价。","quote_sha256":"8c7a570d51b842be51c8689066b3d6fe50030b8229d96708644c920d085e82c5","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ES-03"},{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:b7fa5f78c4ad8164340fd70e","quote":"SECTION_ID=mwsec_greenfield_proj_user_8a5a00cb014a_bbc8a74bb7965cf9\n章节编号=7.3.2\n章节标题=心电图检查\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"e70808f046c47e1a0e8711ca3df24f7cb14727e92008d49f4977eabb29479ab5","source_id":"protocol_full_draft_selection:b7fa5f78c4ad8164340fd70e","span_id":"ES-08"}],"evidence_span_ids":["ES-01","ES-02","ES-03","ES-08"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"heading":"心电图检查","missing_source_classes":[],"proposal_text":"本节说明12导联心电图检查的安全性评估安排。本研究采用12导联心电图评价受试者在治疗期间的心脏安全性，12导联心电图具有临床意义的变化属于本研究安全性终点的组成部分。双盲治疗期为16周，安全性随访期为4周；心电图检查与访视安排相衔接，治疗期访视设于第2、4、8、12、16周，第20周进行安全性随访。对检查中发现的具有临床意义的异常，将结合受试者的临床表现及其他安全性评估结果进行评价。心电图结果与生命体征、实验室检查等安全性数据共同用于支持对合成试验药A安全性的总体评价。","rationale":"已确认研究事实支持本节：12导联心电图具有临床意义的变化属于安全性终点组成部分；双盲治疗期16周、安全性随访期4周；治疗期访视设于第2、4、8、12、16周，第20周进行安全性随访。需医学作者核对：心电图采集时点、记录参数、异常判定标准及异常结果处理流程。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_bbc8a74bb7965cf9","section_number":"7.3.2","source_ids":["protocol_full_draft_selection:b7fa5f78c4ad8164340fd70e","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]},{"ai_run_id":"airun_20260922020752_82e72430","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"安全性终点：治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件发生率。；实验室检查、生命体征及12导联心电图具有临床意义的变化。","quote_sha256":"99133b9298d6b094501b14430ac89a3b690a9aa9acb4bb1df325ea3196a44236","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ES-01"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究时期：筛选期：最长4周。；双盲治疗期：16周。；安全性随访期：4周。","quote_sha256":"1df9f3c36a7060d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ES-02"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"访视策略：筛选后于基线/第1天随机；第2、4、8、12、16周进行治疗期访视，第20周进行安全性随访。PASI和sPGA于基线及第4、8、12、16周评价。","quote_sha256":"8c7a570d51b842be51c8689066b3d6fe50030b8229d96708644c920d085e82c5","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"ES-03"},{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:b7fa5f78c4ad816434