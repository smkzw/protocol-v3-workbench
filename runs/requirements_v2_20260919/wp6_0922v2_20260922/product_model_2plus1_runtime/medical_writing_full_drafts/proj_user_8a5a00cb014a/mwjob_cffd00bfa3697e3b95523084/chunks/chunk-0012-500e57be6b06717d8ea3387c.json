{"ai_run_id":"airun_20260922042911_884692a0","chunk_index":12,"job_id":"mwjob_cffd00bfa3697e3b95523084","precondition_digest":"f483172f30b055a8b1e1a0031ff9bcf82f903ed2e0e2f5846600e2e4c3920808","project_id":"proj_user_8a5a00cb014a","schema_version":"protocol_full_draft_chunk_v8","section_ids":["mwsec_greenfield_proj_user_8a5a00cb014a_02ec258233d8e7ca","mwsec_greenfield_proj_user_8a5a00cb014a_7693d868c98988a2","mwsec_greenfield_proj_user_8a5a00cb014a_384005122a9ff626","mwsec_greenfield_proj_user_8a5a00cb014a_893db0e17b2da155"],"sections":[{"ai_run_id":"airun_20260922042911_884692a0","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"heading":"妊娠检查和避孕问询","missing_source_classes":["研究药物生殖毒性及非临床安全性资料（研究者手册）","妊娠检查时点、方法与避孕要求的研究设计来源","妊娠事件报告与随访流程的申办方文件"],"proposal_text":"","rationale":"已确认事实仅明确妊娠或哺乳期女性属于排除标准，未提供妊娠检查的时点与方法、避孕要求、妊娠或伴侣妊娠报告流程及新生儿随访安排。上述规则不能由排除标准推导，需医学作者在取得相应来源后核对确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_02ec258233d8e7ca","section_number":"7.3.4","source_ids":["protocol_full_draft_selection:500e57be6b06717d8ea3387c","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]},{"ai_run_id":"airun_20260922042911_884692a0","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"heading":"安全性评价","missing_source_classes":["支持本章节研究实施规则的项目权威资料或职能确认"],"proposal_text":"","rationale":"依据已确认研究事实：研究为双盲、安慰剂对照设计；安全性终点包括TEAE、严重不良事件、导致停药的不良事件发生率及实验室检查、生命体征和12导联心电图的临床意义变化；双盲治疗期16周、安全性随访期4周，治疗期访视于第2、4、8、12、16周，第20周进行安全性随访；安全性集按实际治疗分析。医学作者需核对安全性数据收集与评估的具体操作口径。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_7693d868c98988a2","section_number":"8","source_ids":["protocol_full_draft_selection:500e57be6b06717d8ea3387c","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]},{"ai_run_id":"airun_20260922042911_884692a0","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:500e57be6b06717d8ea3387c","quote":"章节编号=8.1\n章节标题=总则\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"894ad8746e47ffdf0c735757113973f78622a49fa75d61f16923288d2a2432aa","source_id":"protocol_full_draft_selection:500e57be6b06717d8ea3387c","span_id":"span_sel_003"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"安全性终点：治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件发生率。；实验室检查、生命体征及12导联心电图具有临床意义的变化。","quote_sha256":"99133b9298d6b094501b14430ac89a3b690a9aa9acb4bb1df325ea3196a44236","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_005"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究时期：筛选期：最长4周。；双盲治疗期：16周。；安全性随访期：4周。","quote_sha256":"1df9f3c36a7060d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_006"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"统计分析策略：全分析集按随机分组采用CMH方法比较主要终点，报告应答率差、95%置信区间和P值，以优效性为目标。主要缺失处理采用无应答填补，并以多重插补和观察病例分析进行敏感性分析；安全性集按实际治疗分析。不开展期中分析。","quote_sha256":"ccd7b348358b71793f3761994bf0e928e73abcd319f577b74f5285d5c99e3b7c","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_009"}],"evidence_span_ids":["span_sel_003","span_def_005","span_def_006","span_def_009"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"heading":"总则","missing_source_classes":[],"proposal_text":"安全性评价覆盖16周双盲治疗期和4周安全性随访期，以治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件发生率，以及实验室检查、生命体征及12导联心电图具有临床意义的变化为核心内容。安全性信息在收集、记录与评估时应围绕上述核心内容保持一致，重点关注研究期间出现的潜在安全性风险。安全性数据的分析在安全性集中进行，安全性集按实际治疗分析。安全性评价结果与疗效评价结果共同构成对合成试验药A获益—风险的整体判断依据。","rationale":"依据已确认研究事实：安全性终点内容、双盲治疗期16周与安全性随访期4周，以及安全性集按实际治疗分析。医学作者需核对安全性信息收集、记录和评估的具体流程与职责。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_384005122a9ff626","section_number":"8.1","source_ids":["protocol_full_draft_selection:500e57be6b06717d8ea3387c","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]},{"ai_run_id":"airun_20260922042911_884692a0","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"heading":"定义","missing_source_classes":["不良事件与严重不良事件的标准定义来源","研究药物安全性参考信息（研究者手册或等效文件）","不良事件严重程度分级、因果关系判定与报告时限的监管或申办方标准"],"proposal_text":"","rationale":"已确认来源仅列出安全性终点所涉及的事件类型和检查项目，未给出不良事件、严重不良事件、治疗期间出现的不良事件的定义、严重程度分级、因果关系判定及报告时限。上述内容不能由终点名称推导或套用外部通用定义，需医学作者依据相应来源核对确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_893db0e17b2da155","section_number":"8.2","source_ids":["protocol_full_draft_selection:500e57be6b06717d8ea3387c","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]}],"source_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:500e57be6b06717d8ea3387c","source_id":"protocol_full_draft_selection:500e57be6b06717d8ea3387c","source_type":"protocol_full_draft_selection","text_sha256":"cea1dd8d5ff563ac02bcffc02ebbd03507d94f79f3eac5044fad9404a0e6aa36"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","source_type":"current_project_study_definition","text_sha256":"787313a6f081b1c9afdf03800feb1c50c317aa4aa4f0c3884e924b0594e666da"}]}