:"39f86855784611b541acfcdc9bde1954b606955366139902ea030dd2587d715e","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_title"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究分期：III期\n开发区域：中国\n内在研究目的：确证性研究","quote_sha256":"90beed36d92a466e3479b43c777a7fe39351a15faa72f5164361cf3a0b937352","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_phase"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"入选标准模块：年龄≥18岁；确诊斑块状银屑病≥6个月；筛选及基线时PASI≥12、受累体表面积≥10%、sPGA≥3；适合接受系统治疗或光疗。","quote_sha256":"3e9ca06af65f6aeb7e28df97f2a93f40d8966553fa5faff3f806e43f762999dd","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_inclusion"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"排除标准模块：非斑块型银屑病为主要表现，或存在可能干扰疗效/安全性评价的其他活动性皮肤病；活动性严重感染；妊娠或哺乳期；研究者判断不适合参加。","quote_sha256":"25de1577631d408629fd83338122249e7d0333f30cafbcf4445c1c9991fc6aee","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_exclusion"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"药物技术类型：small_molecule\n给药途径：口服\n剂型：口服固体制剂\n局部/系统暴露范围：systemic","quote_sha256":"93d70823288385813f38b773b8c6e7bba227a7ed893796844d8834e9f3bae884","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_drug"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"总体研究设计：平行组（parallel assignment）、双盲、安慰剂对照、随机\n目标研究人群：成人中重度斑块状银屑病患者\n随机化方式：随机分配\n对照措施：匹配安慰剂\n分配模型：平行组（parallel assignment）\n中心模式：多中心","quote_sha256":"9546677f90c38af4d30a7b2ba79669a1527fc3fc8f8caced3e12f9f4b35c0ec4","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_design"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"主要研究目的：评价合成试验药A相较安慰剂治疗成人中重度斑块状银屑病的疗效。\n次要研究目的：评价合成试验药A对皮损清除程度及皮肤病相关生活质量的影响。","quote_sha256":"2ac5414e5b404b58a36cba216311b70c374adcc64fbb813ea19e5451f68e54f8","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_objectives"}],"evidence_span_ids":["span_title","span_phase","span_inclusion","span_exclusion","span_drug","span_design","span_objectives"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":7},"heading":"研究背景和立项依据","missing_source_classes":[],"proposal_text":"本研究针对成人中重度斑块状银屑病开展III期确证性临床研究，开发区域为中国。目标研究人群为确诊为斑块状银屑病、疾病严重程度为中重度的成人受试者。入选标准要求年龄≥18岁、确诊斑块状银屑病≥6个月，筛选及基线时PASI≥12、受累体表面积≥10%、sPGA≥3，并且适合接受系统治疗或光疗；排除标准包括以非斑块型银屑病为主要表现或存在可能干扰疗效/安全性评价的其他活动性皮肤病、活动性严重感染、妊娠或哺乳期，以及研究者判断不适合参加者。合成试验药A为小分子药物，给药途径为口服，剂型为口服固体制剂，局部/系统暴露范围为systemic，本研究采用匹配安慰剂作为对照。立项依据为在成人中重度斑块状银屑病人群中评价合成试验药A相较安慰剂的疗效，并评价其对皮损清除程度及皮肤病相关生活质量的影响，同时观察安全性。研究采用多中心、平行组、安慰剂对照设计，以支持在中国人群中的确证性评价。","rationale":"支持事实包括研究题目、III期确证性分期、中国开发区域、目标人群、入选和排除标准、试验药为小分子口服全身暴露药物、匹配安慰剂对照、主要和次要研究目的。医学作者需核对疾病负担、流行病学、既往治疗格局、文献引用及立项依据的监管表述；这些背景来源未在允许来源中出现。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_0687d5113cc82a0a","section_number":"2","source_ids":["protocol_full_draft_selection:6df08cf0180fd7bfe854fc0a","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:8054da15ded3d2","company_corpus:cms_cn_protocol_corpus_20260715_v1:8906e921bf8a9f"]},{"ai_run_id":"airun_20260922040259_88033fd0","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"入选标准模块：年龄≥18岁；确诊斑块状银屑病≥6个月；筛选及基线时PASI≥12、受累体表面积≥10%、sPGA≥3；适合接受系统治疗或光疗。","quote_sha256":"3e9ca06af65f6aeb7e28df97f2a93f40d8966553fa5faff3f806e43f762999dd","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_inclusion"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"排除标准模块：非斑块型银屑病为主要表现，或存在可能干扰疗效/安全性评价的其他活动性皮肤病；活动性严重感染；妊娠或哺乳期；研究者判断不适合参加。","quote_sha256":"25de1577631d408629fd83338122249e7d0333f30cafbcf4445c1c9991fc6aee","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_exclusion"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"药物技术类型：small_molecule\n给药途径：口服\n剂型：口服固体制剂\n局部/系统暴露范围：systemic","quote_sha256":"93d70823288385813f38b773b8c6e7bba227a7ed893796844d8834e9f3bae884","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_drug"}],"evidence_span_ids":["span_inclusion","span_exclusion","span_drug"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"heading":"疾病背景及治疗现状","missing_source_classes":[],"proposal_text":"本研究的目标适应症为成人中重度斑块状银屑病。入选标准要求年龄≥18岁、确诊斑块状银屑病≥6个月，筛选及基线时PASI≥12、受累体表面积≥10%、sPGA≥3，并且适合接受系统治疗或光疗。该人群的疾病严重程度由PASI、受累体表面积和sPGA共同界定，且以斑块状银屑病为主要表现。排除标准包括以非斑块型银屑病为主要表现或存在可能干扰疗效/安全性评价的其他活动性皮肤病、活动性严重感染、妊娠或哺乳期，以及研究者判断不适合参加者。治疗现状方面，入选标准明确目标人群适合接受系统治疗或光疗，本研究据此评价口服系统性药物合成试验药A在该人群中的疗效与安全性。上述人群定义和疾病严重程度标准构成研究人群选择与疗效评价的背景基础。","rationale":"支持事实包括目标人群为成人中重度斑块状银屑病、年龄≥18岁、确诊≥6个月、筛选及基线PASI≥12、受累体表面积≥10%、sPGA≥3、适合接受系统治疗或光疗，以及排除非斑块型银屑病为主要表现、其他活动性皮肤病、活动性严重感染、妊娠或哺乳期和研究者判断不适合参加者。医学作者需核对流行病学、疾病负担、现有治疗选择、指南推荐和疾病自然史等背景信息。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_5f2555c78168de91","section_number":"2.1","source_ids":["protocol_full_draft_selection:6df08cf0180fd7bfe854fc0a","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:8054da15ded3d2","company_corpus:cms_cn_protocol_corpus_20260715_v1:8906e921bf8a9f"]},{"ai_run_id":"airun_20260922040259_88033fd0","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"heading":"作用机制及同类药物研究进展","missing_source_classes":["研究药物作用机制资料","非临床研究资料","既往临床研究资料","同类药物研究进展文献"],"proposal_text":"","rationale":"支持事实仅为合成试验药A为小分子口服药物、局部/系统暴露范围为systemic，以及试验组接受合成试验药A 100 mg口服每日一次连续16周、对照组接受匹配安慰剂；研究药物作用机制、非临床研究、既往临床研究和同类药物研究进展资料未在允许来源中提供，需医学作者补充相应来源后形成该章节内容。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_ec775a481341d056","section_number":"2.2","source_ids":["protocol_full_draft_selection:6df08cf0180fd7bfe854fc0a","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:8054da15ded3d2","company_corpus:cms_cn_protocol_corpus_20260715_v1:8906e921bf8a9f"]}],"source_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:6df08cf0180fd7bfe854fc0a","source_id":"protocol_full_draft_selection:6df08cf0180fd7bfe854fc0a","source_type":"protocol_full_draft_selection","text_sha256":"a165024e2a90c76ad5d6609c455aecbb4427ac4b4067202b4a269f021a22d1b1"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","source_id":"current_project_study_def