c21914","span_id":"sd_safety_ep"}],"evidence_span_ids":["s1_sec3","sd_title","sd_phase_region","sd_purpose","sd_primary_obj","sd_secondary_obj","sd_primary_ep","sd_key_secondary","sd_other_secondary","sd_safety_ep"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":9},"heading":"研究目的和终点","missing_source_classes":[],"proposal_text":"本研究为确证性III期临床研究，主要目的为评价合成试验药A相较安慰剂治疗成人中重度斑块状银屑病的疗效，次要目的为评价合成试验药A对皮损清除程度及皮肤病相关生活质量的影响。主要终点为第16周达到PASI 75应答（较基线PASI评分改善≥75%）的受试者比例；关键次要终点为第16周sPGA达到0或1且较基线改善≥2级的受试者比例，以及第16周达到PASI 90应答的受试者比例；其他次要终点为第16周PASI评分较基线的变化和第16周DLQI评分较基线的变化。安全性终点为治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件发生率，以及实验室检查、生命体征及12导联心电图具有临床意义的变化。","rationale":"正文依据已确认研究事实中的主要目的、次要目的、主要终点、关键次要终点、其他次要终点及安全性终点组织；终点的评价工具与访视策略一致。医学作者需核对终点层级与措辞，并在第3.3节探索性内容确认后复核本章是否需要相应补充。","review_advisories":["本节复述高影响研究设计（研究目的和终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_cc81ab6b8717128e","section_number":"3","source_ids":["protocol_full_draft_selection:8eb0d7b9830dbe758244457c","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:6b9f50aa913504"]},{"ai_run_id":"airun_20260922040929_a256cfa3","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:8eb0d7b9830dbe758244457c","quote":"章节编号=3.1\n章节标题=主要目的和主要终点\n章节类型=section\n当前正文=评价合成试验药A相较安慰剂治疗成人中重度斑块状银屑病的疗效。\n第16周达到PASI 75应答（较基线PASI评分改善≥75%）的受试者比例。","quote_sha256":"38a7426d3eb3c54b2d96a5092b68470c7e0cbf1478222048d8b2d954e59588e5","source_id":"protocol_full_draft_selection:8eb0d7b9830dbe758244457c","span_id":"s1_sec31"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"主要研究目的：评价合成试验药A相较安慰剂治疗成人中重度斑块状银屑病的疗效。","quote_sha256":"91f9668c833c01c737e00948c18613521366f596752872eef9fc69a09e681b8f","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"sd_primary_obj"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"主要终点：第16周达到PASI 75应答（较基线PASI评分改善≥75%）的受试者比例。","quote_sha256":"0726a50bb0c8f1c5ec79b9e21b343bfd08fddc0a595315a5c8e3769df01ce9a7","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"sd_primary_ep"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"访视策略：筛选后于基线/第1天随机；第2、4、8、12、16周进行治疗期访视，第20周进行安全性随访。PASI和sPGA于基线及第4、8、12、16周评价。","quote_sha256":"8c7a570d51b842be51c8689066b3d6fe50030b8229d96708644c920d085e82c5","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"sd_visits"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"估计目标策略：治疗策略人群为所有随机受试者；比较第16周PASI 75应答。停药或使用救援治疗按复合策略判定为无应答，其他缺失数据采用无应答填补；报告组间率差及95%置信区间。","quote_sha256":"44f71070d9cdb5b6b69ad6feeeb7fbfeef4aad105693eaa3500bedd537f18414","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"sd_estimand"}],"evidence_span_ids":["s1_sec31","sd_primary_obj","sd_primary_ep","sd_visits","sd_estimand"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"heading":"主要目的和主要终点","missing_source_classes":[],"proposal_text":"本研究的主要目的为评价合成试验药A相较安慰剂治疗成人中重度斑块状银屑病的疗效。主要终点为第16周达到PASI 75应答（较基线PASI评分改善≥75%）的受试者比例；PASI评分于基线及第4、8、12、16周进行评价，第16周PASI评分相对基线的改善幅度用于判定PASI 75应答。主要终点在治疗策略人群（所有随机受试者）中评价；停用研究药物或接受救援治疗的受试者按复合策略判定为无应答，其他缺失数据采用无应答填补；组间比较报告应答率差及其95%置信区间。","rationale":"正文依据已确认研究事实：主要目的为评价合成试验药A相较安慰剂的疗效，主要终点为第16周PASI 75应答（较基线改善≥75%）；PASI于基线及第4、8、12、16周评价；主要终点在治疗策略人群（所有随机受试者）中评价，停用研究药物或接受救援治疗者按复合策略判定为无应答，其他缺失数据采用无应答填补，组间比较报告应答率差及95%置信区间。医学作者需核对终点定义与统计分析章节的一致性。","review_advisories":["本节复述高影响研究设计（主要目的和主要终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_db5f25e7dd5b8877","section_number":"3.1","source_ids":["protocol_full_draft_selection:8eb0d7b9830dbe758244457c","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:6b9f50aa913504"]},{"ai_run_id":"airun_20260922040929_a256cfa3","content_status":"decision_required","decision_items":[{"blocking_section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_9e670d193fbbb761","fact_path":"picos.exploratory_objectives","options":[{"label":"早期应答探索","option_id":"early_onset_objective","summary":"描述第4、8、12周PASI 75应答率、PASI 90应答率及sPGA 0/1应答率随时间的变化。"},{"label":"深度清除探索","option_id":"deep_clearance_objective","summary":"描述第16周PASI 100应答率。"}],"question":"本研究的探索性目的应聚焦哪个方向？","rationale":"早期应答探索仅使用已确认的PASI与sPGA评价时点及已确认的PASI 75、PASI 90、sPGA 0/1应答定义，不需要新增量表或访视；深度清除探索将引入当前来源未确认的PASI 100阈值。","recommended_option_id":"early_onset_objective"},{"blocking_section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_9e670d193fbbb761","fact_path":"picos.exploratory_endpoints","options":[{"label":"早期应答终点","option_id":"early_onset_endpoint","summary":"第4、8、12周PASI 75应答率、PASI 90应答率及sPGA 0/1应答率。"},{"label":"深度清除终点","option_id":"deep_clearance_endpoint","summary":"第16周PASI 100应答率。"}],"question":"与探索性目的对应的探索性终点应如何设定？","rationale":"推荐项与早期应答探索方向对应，全部基于已确认的评价时点和应答阈值；若选择深度清除方向，需同时确认第16周PASI 100的判定规则。","recommended_option_id":"early_onset_endpoint"}],"evidence_bi