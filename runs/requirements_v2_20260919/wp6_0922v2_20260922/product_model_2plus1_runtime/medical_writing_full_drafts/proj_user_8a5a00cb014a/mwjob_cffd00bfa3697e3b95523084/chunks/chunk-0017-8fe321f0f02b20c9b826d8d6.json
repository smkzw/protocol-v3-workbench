0d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_s2_period"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"访视策略：筛选后于基线/第1天随机；第2、4、8、12、16周进行治疗期访视，第20周进行安全性随访。PASI和sPGA于基线及第4、8、12、16周评价。","quote_sha256":"8c7a570d51b842be51c8689066b3d6fe50030b8229d96708644c920d085e82c5","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_s2_visit"}],"evidence_span_ids":["span_s1_11_2","span_s2_multicenter","span_s2_design","span_s2_phase","span_s2_population","span_s2_inclusion","span_s2_exclusion","span_s2_control","span_s2_intervention","span_s2_period","span_s2_visit"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":10},"heading":"知情同意","missing_source_classes":[],"proposal_text":"知情同意的核心在于确保受试者在充分理解研究相关信息的基础上自主作出参加决定。本研究为多中心、随机、双盲、安慰剂对照III期临床研究，受试者为年龄≥18岁的成人中重度斑块状银屑病患者，入选标准包括确诊斑块状银屑病≥6个月，且筛选及基线时PASI≥12、受累体表面积≥10%、sPGA≥3。受试者将按1:1随机分配至合成试验药A 100 mg每日一次口服组或匹配安慰剂组，双盲治疗16周，并接受4周安全性随访。知情同意过程覆盖的内容包括研究目的、研究设计、随机与盲法安排、安慰剂对照、治疗周期、访视安排、预期风险和获益，以及妊娠或哺乳期女性不适合参加本研究的情况。","rationale":"正文引用的目标人群、年龄要求、诊断与疾病严重程度入选标准、多中心随机双盲安慰剂对照设计、试验干预与对照措施、治疗周期、安全性随访、访视安排以及妊娠或哺乳期排除标准等事实均来自当前项目已确认研究定义。医学作者需核对知情同意书模板、知情同意签署与记录要求、重新知情同意的触发条件、受试者补偿说明、隐私授权条款以及知情同意过程的具体实施步骤等尚未在允许来源中明确的内容。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_e0758ac163445055","section_number":"11.2","source_ids":["protocol_full_draft_selection:8fe321f0f02b20c9b826d8d6","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]}],"source_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:8fe321f0f02b20c9b826d8d6","source_id":"protocol_full_draft_selection:8fe321f0f02b20c9b826d8d6","source_type":"protocol_full_draft_selection","tex