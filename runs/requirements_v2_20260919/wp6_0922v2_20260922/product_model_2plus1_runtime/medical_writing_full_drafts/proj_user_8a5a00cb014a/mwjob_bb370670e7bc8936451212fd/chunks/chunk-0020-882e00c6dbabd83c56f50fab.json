dy_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]},{"ai_run_id":"airun_20260922060810_96a9920e","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"中心模式：多中心","quote_sha256":"2cfa68bc992967c797bbd3113b5e0d0844d660a2050095a31f08358c5e40311f","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"sp_project_center"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"安全性终点：治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件发生率。；实验室检查、生命体征及12导联心电图具有临床意义的变化。","quote_sha256":"99133b9298d6b094501b14430ac89a3b690a9aa9acb4bb1df325ea3196a44236","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"sp_project_safety"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"依从：通过药品计数及受试者日记评价依从性","quote_sha256":"bae98d5756fc33d2dec389859c413b44261174683ee2abd68620571e65357c06","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"sp_project_adherence"},{"locator":"section:数据质量保证|block:932|chunk:1","quote":"研究中心质量保证人员对数据转移文件、统计报告数据进行抽查，保证数据准确无误。申办者根据需要，结合试验进展情况及质量控制人员/监查员的核查结果，可对上述临床研究过程产生的数据进行不同范畴的稽查。","quote_sha256":"84e30f7a8178b6ecebc4f6b8272c753029708f78a4aea8f02201d0abf4225b0b","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db","span_id":"sp_corpus_qa"}],"evidence_span_ids":["sp_project_center","sp_project_safety","sp_project_adherence","sp_corpus_qa"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":3},"heading":"质量控制与保证","missing_source_classes":[],"proposal_text":"为使研究过程、研究数据及相关记录符合研究方案、药物临床试验质量管理规范及适用的监管要求，本研究将实施覆盖全过程的质量控制与保证。质量控制与保证的范围覆盖多中心研究实施中的数据采集、处理、分析和报告，重点关注PASI、sPGA和DLQI等疗效评价数据，以及治疗期间出现的不良事件、严重不良事件、导致停药的不良事件、实验室检查、生命体征和12导联心电图等安全性数据。研究中心通过药品计数和受试者日记评价依从性，相关记录应纳入质量核查范围。质量保证活动应支持上述数据的真实性、完整性、准确性和可溯源性，并可根据研究进展及核查结果，对研究过程产生的数据开展不同范围的稽查。","rationale":"该章依据已确认的多中心研究实施、PASI/sPGA/DLQI疗效评价、TEAE/严重不良事件/导致停药不良事件及实验室检查、生命体征、12导联心电图安全性评价，以及药品计数和受试者日记依从性评价等事实撰写；质量保证与稽查表述仅采用监管共性措辞，未指定本项目角色、频次、时限或具体方法。医学作者需核对本项目质量保证计划、监查与稽查安排以及数据质量核查记录要求。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_b9e92c2f0bf08455","section_number":"12.7","source_ids":["protocol_full_draft_selection:882e00c6dbabd83c56f50fab","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]},{"ai_run_id":"airun_20260922060810_96a9920e","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"heading":"附录","missing_source_classes":["附录清单与格式要求","研究日程/评估流程表模板","实验室检查与评估手册","量表版本与授权文件"],"proposal_text":"","rationale":"允许来源仅提供本章节标题及空白正文，未包含附录清单、研究流程表、实验室检查与评估手册、量表版本或授权文件等来源。医学作者需核对本项目附录构成和格式要求。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_02f0fcfe33d65d34","section_number":"14","source_ids":["protocol_full_draft_selection:882e00c6dbabd83c56f50fab","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]}],"source_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:882e00c6dbabd83c56f50fab","source_id":"protocol_full_draft_selection:882e00c6dbabd83c56f50fab","source_type":"protocol_full_draft_selection","text_sha256":"9d07413f5ead10854021471587cdc7177062292454313af2371b2d3f05139940"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"