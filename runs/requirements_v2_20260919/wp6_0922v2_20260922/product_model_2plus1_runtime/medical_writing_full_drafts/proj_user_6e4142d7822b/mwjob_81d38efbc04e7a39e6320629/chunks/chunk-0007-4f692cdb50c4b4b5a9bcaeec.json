d2e:r4:20fc48105f14cc3c","span_id":"span_placebo_b"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"合成阳性对照C匹配安慰剂：每2周一次（皮下注射）；24周","quote_sha256":"b35ec2caf9b9faac52c8eac6b61c1cdcd42a9b4ba4ec34f6fdb6397cb16217c2","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_placebo_c"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"试验组口服合成试验药B并接受阳性对照模拟注射；对照组接受匹配口服安慰剂并皮下注射合成阳性对照C；两组继续稳定甲氨蝶呤，治疗24周。","quote_sha256":"8e4cb2848e337e4e991c60dab2927d84ef52ddd361cc8556b64caaa1e5e75a04","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_intervention"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"甲氨蝶呤维持入组前稳定剂量，除安全性需要外治疗期不调整。","quote_sha256":"80557c8dcff92acb47246eb4c434508daf062763e0136459b7f0506a7e97219d","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_mtx"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"剂型：片剂","quote_sha256":"ac01ccc3f1399fad3760dc30138cfa54dacd503a8c3cfe3a2361adb88bb07c30","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_dosage_form"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"给药途径：口服","quote_sha256":"404b058b755608a73d13b54521a28c02b129df449774d0671b1c3f8b8a5ce42c","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_route"}],"evidence_span_ids":["span_drug_b","span_drug_c","span_placebo_b","span_placebo_c","span_intervention","span_mtx","span_dosage_form","span_route"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":8},"gap_items":[],"heading":"研究药物信息","missing_source_classes":[],"proposal_text":"本研究试验药物为合成试验药B，剂型为片剂，给药途径为口服，给药剂量为50 mg，每日一次，连续给药24周。试验组受试者在继续接受稳定剂量甲氨蝶呤治疗的基础上口服合成试验药B，并接受阳性对照模拟注射。对照组受试者接受与合成试验药B匹配的口服安慰剂，每日一次，连续24周，同时皮下注射合成阳性对照C 40 mg，每2周一次，连续24周，并继续接受稳定剂量甲氨蝶呤治疗。合成阳性对照C匹配安慰剂为每2周一次皮下注射，用于维持双模拟盲态。两组受试者均维持入组前稳定剂量的甲氨蝶呤，除安全性需要外治疗期不调整。","rationale":"依据已确认研究事实，合成试验药B为口服片剂50 mg每日一次，合成阳性对照C为40 mg每2周一次皮下注射，匹配安慰剂分别维持双模拟，两组均继续稳定甲氨蝶呤治疗24周。医学作者需核对最终规格、安慰剂匹配方式及产品标签信息。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_6e4142d7822b_386e44d1cc471a31","section_number":"6.1.1","source_ids":["protocol_full_draft_selection:4f692cdb50c4b4b5a9bcaeec","current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c"]},{"ai_run_id":"airun_20260922155140_0e056a40","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取研究药物制备、包装、标签、储存与管理的对应项目文件或药房手册后补充本章节。","category":"source_missing","gap_id":"gap_612_1","missing_source_classes":["研究药物制备操作规程","包装与标签规范","储存条件与稳定性数据","药物管理计划","药房操作手册"],"target":"6.1.2 制备、包装、标签、储存与管理"}],"heading":"制备、包装、标签、储存与管理","missing_source_classes":["研究药物制备操作规程","包装与标签规范","储存条件与稳定性数据","药物管理计划"],"proposal_text":"","rationale":"当前可用的项目来源未提供研究药物制备、包装、标签、储存与管理的具体项目文件，无法安全形成实质正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_6e4142d7822b_2ad641e767c353ca","section_number":"6.1.2","source_ids":["protocol_full_draft_selection:4f692cdb50c4b4b5a9bcaeec","current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c"]},{"ai_run_id":"airun_20260922155140_0e056a40","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取研究药物发放、回收与清点的对应项目文件或药房管理规程后补充本章节。","category":"source_missing","gap_id":"gap_613_1","missing_source_classes":["药物发放规程","回收与清点记录","药物计数与销毁流程","药房管理文件"],"target":"6.1.3 发放、回