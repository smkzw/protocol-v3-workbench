68bc992967c797bbd3113b5e0d0844d660a2050095a31f08358c5e40311f","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_multicenter"}],"evidence_span_ids":["span_sec_12_2","span_monitoring","span_multicenter"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":1},"gap_items":[{"action":"补充本项目监查计划或监查管理文件，明确监查频率、监查内容、监查员职责与监查报告要求，并据此更新本章节。","category":"source_missing","gap_id":"gap_monitoring_plan","missing_source_classes":["本项目监查计划/监查管理文件","监查员职责分工文件"],"target":"12.2 监查"},{"action":"补充监查记录与监查报告的具体要求，明确原始资料访问方式和发现问题后的跟踪与关闭流程。","category":"source_missing","gap_id":"gap_monitoring_records","missing_source_classes":["监查报告模板与监查记录要求文件","问题跟踪与关闭流程文件"],"target":"12.2 监查"}],"heading":"监查","missing_source_classes":["本项目监查计划/监查管理文件","监查员职责分工文件","监查报告模板与监查记录要求文件","问题跟踪与关闭流程文件"],"proposal_text":"申办者负有确保研究按照已确立的研究准则、药物临床试验质量管理规范、适用管理要求和法规进行的道德、法律和科学义务。为履行该义务，申办者将委派监查员或其代表与各研究中心保持电话和书面沟通，并定期开展现场监查，以评价研究中心对监管要求的遵守情况，确认受试者的安全、福利和隐私得到保护，核查方案依从性、病例报告表录入的完整性和准确性、病例报告表数据与原始文件的一致性以及不良事件的发生与记录情况。研究者应允许监查员或其代表查阅所有原始资料和研究文件。本研究为多中心设计，各研究中心的监查安排应与本项目的监查管理要求保持一致。","rationale":"监查章节依据监管共性措辞来源中关于申办者监查义务、监查员电话与书面沟通及定期现场监查、受试者安全与隐私保护、方案依从性、CRF录入完整性与准确性、CRF数据与原始文件验证以及研究者提供原始资料访问权限的要求撰写；当前项目事实仅确认多中心设计，监查频率、监查内容清单、监查报告和监查员职责分工尚需医学作者结合项目监查管理文件核定。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_6e4142d7822b_ca90d3c055a81e7f","section_number":"12.2","source_ids":["protocol_full_draft_selection:ff1219a94b2ddaab70bb0341","current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","company_corpus:cms_cn_protocol_corpus_20260715_v1:3d78c7bb1bd24f","company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:c63e43f68405d2"]},{"ai_run_id":"airun_20260922161210_d855244d","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_6e4142d7822b_b209d029cdd23382:full-draft:ff1219a94b2ddaab70bb0341","quote":"章节编号=12.3\n章节标题=稽查和核查","quote_sha256":"4576e2e4a2fee4e2855c65519edfc574aae09365fd37e59f00c6433ac5d0c4aa","source_id":"protocol_full_draft_selection:ff1219a94b2ddaab70bb0341","span_id":"span_sec_12_3"},{"locator":"section:研究者签字页|block:32|chunk:1","quote":"我同意接受申办者派遣临床监查员或稽查员对本次临床研究的监查或稽查及药品管理部门的视查，确保临床研究质量。","quote_sha256":"7b5107e534b1945df0f53889ceb8ec820728aa37140ba980bc462ccfc9d5507a","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","span_id":"span_inspection"},{"locator":"section:统计分析单位签字页|block:56|chunk:1","quote":"努力并严格按照方案、现行的ICH GCP和NMPA GCP指导原则以及适用的法规和指导方针进行本试验的临床监查、数据管理和统计分析工作，认真履行第三方职责","quote_sha256":"b3e8bed69acbb36cf5f1bc801490adb41fe30158fe8be82197d12a8e796744f1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","span_id":"span_thirdparty"},{"locator":"section:文档开头|block:4|chunk:1","quote":"本方案中所包含的所有信息归申办方所有，因此，仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构进行审阅。","quote_sha256":"a95f171292054da4c0e730a5808f9cf1db173b3e9368862f63a2a3c3172a88c6","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:c63e43f68405d2","span_id":"span_confidentiality"}],"evidence_span_ids":["span_sec_12_3","span_inspection","span_thirdparty","span_confidentiality"],"evidence_summary":{"corpus_spans":3,"project_fact_spans":0},"gap_items":[{"action":"补充本项目稽查计划或稽查程序文件，明确稽查触发条件、稽查范围、通知方式和回复时限。","category":"source_missing","gap_id":"gap_inspection_plan","missing_source_classes":["本项目稽查计划/稽查程序文件","稽查通知与回复要求文件"],"target":"12.3 稽查和核查"},{"action":"补充监管核查配合程序，明确核查准备、资料提供、回复与整改要求。","category":"source_missing","gap_id":"gap_regulatory_inspection","missing_source_classes":["监管核查配合与回复程序文件","核查准备与整改要求文件"],"target":"12.3 稽查和核查"}],"heading":"稽查和核查","missing_source_classes":["本项目稽查计划/稽查程序文件","稽查通知与回复要求文件","监管核查配合与回复程序文件","核查准备与整改要求文件"],"proposal_text":"研究者同意接受申办者派遣的稽查员对临床研究进行稽查，并接受药品监督管理部门的检查或核查，以确保临床研究质量。稽查和核查应按照适用的药物临床试验质量管理规范、法规要求及申办者质量管理体系实施。研究者及相关研究人员应配合提供原始资料、研究文件和其他必要记录，保证研究记录与报告的数据真实、准确、完整。参与本研究的第三方按照现行ICH GCP和NMPA GCP指导原则以及适用法规履行职责，负责协调和监查本项临床研究，保证参与者权益受到保障。本方案信息仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构审阅，未经申办者书面批准不得向与本试验无关的第三方披露。","rationale":"稽查和核查章节依据监管共性措辞来源中研究者接受申办者稽查和药品监督管理部门检查、第三方按照ICH GCP和NMPA GCP履行监查与数据管理职责，以及方案信息审阅范围的要求撰写；本项目稽查计划、核查配合程序、通知与回复要求尚需医学作者补充项目文件后核定。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_6e4142d7822b_171b3908ff2f0b4b","section_number":"12.3","source_ids":["protocol_full_draft_selection:ff1219a94b2ddaab70bb0341","current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","company_corpus:cms_cn_protocol_corpus_20260715_v1:3d78c7bb1bd24f","company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:c63e43f68405d2"]},{"ai_run_id":"airun_20260922161210_d855244d","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_6e4142d7822b_b209d029cdd23382:full-draft:ff1219a94b2ddaab70bb0341","quote":"章节编号=12.4\n章节标题=方案偏离","quote_sha256":"8f72e98b8bad2324c18230e4d95d96a9c9d8849b8017540e5eb1f12189a1e3b6","source_id":"protocol_full_draft_selection:ff1219a94b2ddaab70bb0341","span_id":"span_sec_12_4"},{"locator":"section:11.7 方案修订|block:1231|chunk:1","quote":"根据 GCP 要求，未经申办者和 EC 的同意，研究者不得修改或者偏离试验方案，但不包括为了及时消除对受试者的紧急危害或者更换监查员、电话号码等仅涉及临床 试验管理方面的改动。","quote_sha256":"76042946d5684aaa9636ba63055710074755cd90e1cbcdea361b478c726f510b","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:3d78c7bb1bd24f","span_id":"span_deviation"}],"evidence_span_ids":["span_sec_12_4","span_deviation"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":0},"gap_items":[{"action":"补充本项目方案偏离管理文件，明确偏离分类、记录、评估、报告路径和报告时限，并据此细化本章内容。","category":"source_missing","gap_id":"gap_deviation_sop","missing_source_classes":["本项目方案偏离管理SOP","偏离分类与报告路径文件"],"target":"12.4 方案偏离"},{"action":"补充纠正与预防措施程序，明确偏离后纠正预防措施的制定、跟踪和关闭要求。","category":"source_missing","gap_id":"gap_capa","missing_source_classes":["纠正与预防措施程序文件"],"target":"12.4 方案偏离"}],"heading":"方案偏离","missing_source_classes":["本项目方案偏离管理SOP","偏离分类与报告路径文件","纠正与预防措施程序文件"],"proposal_text":"研究者应严格按照经伦理委员会批准的试验方案实施研究。根据药物临床试验质量管理规范要求，未经申办者和伦理委员会同意，研究者不得修改或者偏离试验方案；但为了及时消除对受试者的紧急危害，或者更换监查员、电话号码等仅涉及临床试验管理方面的改动除外。对于研究实施过程中发生的方案偏离，应按照适用的法规要求及申办者质量管理体系予以识别、记录、评估和报告，评估其对受试者权益和安全以及研究数据可靠性的影响，并采取相应措施防止同类偏离再次发生。","rationale":"方案偏离章节依据监管共性措辞来源中关于未经申办者和伦理委员会同意不得修改或偏离试验方案、紧急危害与临床试验管理性改动除外的要求撰写；本项目尚未提供偏离分类、记录与报告路径、报告时限和纠正预防措施要求，需医学作者补充项目方案偏离管理文件后核定。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_6e4142d7822b_ad7943e0b16f1b90","section_number":"12.4","source_ids":["protocol_full_draft_selection:ff1219a94b2ddaab70bb0341","current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","company_corpus:cms_cn_protocol_corpus_20260715_v1:3d78c7bb1bd24f","company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:c63e43f68405d2"]},{"ai_run_id":"airun_20260922161210_d855244d","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_6e4142d7822b_b209d029cdd23382:full-draft:ff1219a94b2ddaab70bb0341","quote":"章节编号=12.5\n章节标题=关键角色和研究管理","quote_sha256":"1ef630ff0f7b947d76f8e1d0c4235021137b3e8f82ee82590660f46f06502bed","source_id":"protocol_full_draft_selection:ff1219a94b2ddaab70bb0341","span_id":"span_sec_12_5"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"中心模式：多中心","quote_sha256":"2cfa68bc992967c797bbd3113b5e0d0844d660a2050095a31f08358c5e40311f","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_multicenter"},{"locator":"section:9.1 研究监查|block:1175|chunk:1","quote":"申办者有道德上、法律上和科学上的义务，确保研究按照已确立的研究准则、GCP 指导原则、适用的管理要求和法规进行。作为履行这些义务的协调措施，在研究中，申办者的监查员或其代表需经常电话和书面与研究中心沟通，并定期拜访研究中心进行现场监查，评价其是否遵守监管要求，确保受试者的安全、福利以及隐私受到 保护、方案依从性、CRF 录入的完整性和准确性、CRF 数据和原始文件的验证及 AE 的发生等。研究者必须向监查员提供访问所有原始资料和研究文件的权限。","quote_sha256":"308a36177f06e789510202b2b938b2a9e5084c7e222d80919f28732387e33a3e","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","span_id":"span_monitoring"},{"locator":"section:研究者签字页|block:32|chunk:1","quote":"我同意接受申办者派遣临床监查员或稽查员对本次临床研究的监查或稽查及药品管理部门的视查，确保临床研究质量。","quote_sha256":"7b5107e534b1945df0f53889ceb8ec820728aa37140ba980bc462ccfc9d5507a","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","span_id":"span_inspection"},{"locator":"section:统计分析单位签字页|block:56|chunk:1","quote":"努力并严格按照方案、现行的ICH GCP和NMPA GCP指导原则以及适用的法规和指导方针进行本试验的临床监查、数据管理和统计分析工作，认真履行第三方职责","quote_sha256":"b3e8bed69acbb36cf5f1bc801490adb41fe30158fe8be82197d12a8e796744f1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","span_id":"span_thirdparty"},{"locator":"section:文档开头|block:4|chunk:1","quote":"本方案中所包含的所有信息归申办方所有，因此，仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构进行审阅。","quote_sha256":"a95f171292054da4c0e730a5808f9cf1db173b3e9368862f63a2a3c3172a88c6","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:c63e43f68405d2","span_id":"span_confidentiality"}],"evidence_span_ids":["span_sec_12_5","span_multicenter","span_monitoring","span_inspection","span_thirdparty","span_confidentiality"],"evidence_summary":{"corpus_spans":4,"project_fact_spans":1},"gap_items":[{"action":"补充本项目关键角色职责分工与授权文件，明确申办者、研究者、监查员、稽查员、数据管理方和统计方的项目级职责边界。","category":"source_missing","gap_id":"gap_role_matrix","missing_source_classes":["本项目关键角色职责分工文件","研究者授权表与职责授权记录"],"target":"12.5 关键角色和研究管理"},{"action":"补充研究管理协调机制文件，明确沟通、决策和问题升级路径。","category":"source_missing","gap_id":"gap_management_committee","missing_source_classes":["研究管理协调机制文件","问题升级路径文件"],"target":"12.5 关键角色和研究管理"}],"heading":"关键角色和研究管理","missing_source_classes":["本项目关键角色职责分工文件","研究者授权表与职责授权记录","研究管理协调机制文件","问题升级路径文件"],"proposal_text":"本研究为多中心临床研究，研究实施涉及申办者、研究者、监查员或其代表、稽查员、伦理委员会和药品监督管理部门等关键角色。申办者承担确保研究按照已确立的研究准则、药物临床试验质量管理规范、适用管理要求和法规进行的道德、法律和科学义务，并委派监查员或其代表与各研究中心保持沟通并开展监查。研究者负责按照已批准方案实施研究，保证临床研究资料真实、准确、及时、合法地载入病例报告表，并接受申办者派遣的监查员或稽查员以及药品监督管理部门的检查。承担临床监查、数据管理和统计分析工作的第三方按照现行ICH GCP和NMPA GCP指导原则及适用法规履行职责，保证研究记录与报告的数据真实、准确、完整。本方案信息仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构审阅。","rationale":"关键角色和研究管理章节依据当前项目事实中的多中心设计，以及监管共性措辞来源中申办者义务、研究者接受监查稽查、第三方按ICH GCP和NMPA GCP履行职责、方案信息审阅范围的表述撰写；各角色的具体人员、授权范围与项目级职责分工仍需医学作者结合项目研究管理文件核定。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_6e4142d7822b_216f8538022cdff3","section_number":"12.5","source_ids":["protocol_full_draft_selection:ff1219a94b2ddaab70bb0341","current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","company_corpus:cms_cn_protocol_corpus_20260715_v1:3d78c7bb1bd24f","company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:c63e43f68405d2"]}],"source_bindings":[{"content_sha256":"65541c48d5fc874ebc0de4cb248318346df898897bf8711061cc2b40e4054ad3","locator":"document:mwdoc_greenfield_proj_user_6e4142d7822b_b209d029cdd23382:full-draft:ff1219a94b2ddaab70bb0341","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:ff1219a94b2ddaab70bb0341","source_type":"protocol_full_draft_selection","source_version":"full-draft:defc9b2a5fb939bebce57c9f1eb47eb7b7a5651124c6cd0f737697349c57cfb1:ff1219a94b2ddaab70bb0341","text_sha256":"65541c48d5fc874ebc0de4cb248318346df898897bf8711061cc2b40e4054ad3"},{"content_sha256":"c5bf2d0afd5d40df8334c8e3453d30d7faf52e6f4d22546778d8bae4c48f8aba","locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","source_type":"current_project_study_definition","source_version":"mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","text_sha256":"c5bf2d0afd5d40df8334c8e3453d30d7faf52e6f4d22546778d8bae4c48f8aba"},{"content_sha256":"76042946d5684aaa9636ba63055710074755cd90e1cbcdea361b478c726f510b","locator":"section:11.7 方案修订|block:1231|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:3d78c7bb1bd24f","source_type":"company_protocol_reference_corpus","source_version":"3d78c7bb1bd24f","text_sha256":"76042946d5684aaa9636ba63055710074755cd90e1cbcdea361b478c726f510b"},{"content_sha256":"308a36177f06e789510202b2b938b2a9e5084c7e222d80919f28732387e33a3e","locator":"section:9.1 研究监查|block:1175|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","source_type":"company_protocol_reference_corpus","source_version":"d4bef81ce83416","text_sha256":"308a36177f06e789510202b2b938b2a9e5084c7e222d80919f28732387e33a3e"},{"content_sha256":"9d5bb308153441df0cf0a282e48e71b5918f97f81ec06babdf8e969557541291","locator":"section:研究者签字页|block:32|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","source_type":"company_protocol_reference_corpus","source_version":"544d5795fdc791","text_sha256":"9d5bb308153441df0cf0a282e48e71b5918f97f81ec06babdf8e969557541291"},{"content_sha256":"ce0d2dfe125632cc5d7e00e964022f9cd73382987f5a821bb4cc70694b086ad9","locator":"section:统计分析单位签字页|block:56|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","source_type":"company_protocol_reference_corpus","source_version":"21fb7445eed9f6","text_sha256":"ce0d2dfe125632cc5d7e00e964022f9cd73382987f5a821bb4cc70694b086ad9"},{"content_sha256":"dfc9fceb41db9d941df0e3715483adaa069da4f1953600a6a37a56d7f81373dd","locator":"section:文档开头|block:4|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:c63e43f68405d2","source_type":"company_protocol_reference_corpus","source_version":"c63e43f68405d2","text_sha256":"dfc9fceb41db9d941df0e3715483adaa069da4f1953600a6a37a56d7f81373dd"}]}