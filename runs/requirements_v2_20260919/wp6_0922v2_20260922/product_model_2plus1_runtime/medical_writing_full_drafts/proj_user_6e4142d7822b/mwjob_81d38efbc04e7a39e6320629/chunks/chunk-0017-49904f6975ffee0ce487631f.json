tion"}],"evidence_span_ids":["ev_sec_10_4","ev_design","ev_population","ev_intervention","ev_endpoints","ev_safety","ev_randomization"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"补充资料保存与归档管理规程和记录保留期限规定，确定保存期限、存储形式与归档销毁要求。","category":"source_missing","gap_id":"gap_10_4_retention","missing_source_classes":["资料保存与归档管理规程","记录保留期限规定"],"target":"10.4 资料保存与数据保护"},{"action":"补充数据保护与隐私政策、访问控制与数据传输规程以及知情同意中与数据使用相关的条款，确定个人健康信息的保护与访问要求。","category":"source_missing","gap_id":"gap_10_4_data_protection","missing_source_classes":["数据保护与隐私政策","访问控制与数据传输规程","知情同意中与数据使用相关的条款"],"target":"10.4 资料保存与数据保护"}],"heading":"资料保存与数据保护","missing_source_classes":["资料保存与归档管理规程","记录保留期限规定","数据保护与隐私政策","访问控制与数据传输规程"],"proposal_text":"资料保存与数据保护的对象为本研究在筛选期、24周双盲双模拟治疗期和第28周安全性随访期间产生的全部研究资料，包括各中心采集的原始记录、疗效与安全性评价记录，以及1:1分层随机产生的随机分配信息。疗效资料涉及第24周ACR20应答率、第24周DAS28-CRP较基线变化、第24周ACR50应答率和第12周ACR20应答率的评价记录；安全性资料涉及TEAE、SAE、导致停药的不良事件以及实验室检查、生命体征和心电图具有临床意义变化的记录。上述资料涉及18–75岁活动性类风湿关节炎成人试验参与者的个人健康信息，在多中心条件下需对来自不同中心的资料采用一致的保护口径。资料保存与数据保护遵循适用的资料保存与数据保护要求，覆盖自筛选期资料产生至研究资料归档的全过程，保存期间保持资料的完整性与可辨识性，研究参与者的个人健康信息仅在研究实施与审评所需范围内使用。","rationale":"已确认的研究设计、18–75岁研究人群、24周治疗期、第28周安全性随访、疗效与安全性终点框架以及1:1分层随机分组信息共同界定了保存与保护对象的范围。医学作者需核对资料保存与归档管理规程、记录保留期限规定、数据保护与隐私政策、访问控制与数据传输规程以及知情同意中与数据使用相关的条款。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_6e4142d7822b_6d70b9df5d39a920","section_number":"10.4","source_ids":["protocol_full_draft_selection:49904f6975ffee0ce487631f","current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c"]},{"ai_run_id":"airun_20260922160608_f4c276d0","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_6e4142d7822b_b209d029cdd23382:full-draft:49904f6975ffee0ce487631f","quote":"SECTION_ID=mwsec_greenfield_proj_user_6e4142d7822b_5fcee0dcd7068db8\n章节编号=10.5\n章节标题=数据发布和研究发表策略\n章节类型=section","quote_sha256":"2d43535efa4934ec229a757275661b2c5c1a06160ffdb55a7cc27cf45b5630ca","source_id":"protocol_full_draft_selection:49904f6975ffee0ce487631f","span_id":"ev_sec_10_5"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"总体研究设计：多中心、随机、双盲、双模拟、阳性对照、平行组、非劣效III期研究","quote_sha256":"a02da94ca30265ce95f8a5824ef17d9434a9934c5a46c4781ca73525f9620267","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"ev_design"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"主要终点：第24周ACR20应答率。\n关键次要终点：第24周DAS28-CRP较基线变化。；第24周ACR50应答率。\n其他次要终点：第12周ACR20应答率。","quote_sha256":"b4401774c2ec58ae1903ca1f3794732da299c0b7c872b4b9e19c91d2aff0cfdb","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"ev_endpoints"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"安全性终点：TEAE、SAE及导致停药的不良事件发生率。；实验室检查、生命体征和心电图具有临床意义的变化。","quote_sha256":"b7b07260763ae74db57a2516bf63ca4452202b7f5fee51482cc73ab6c3900d25","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"ev_safety"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"访视策略：筛选、基线及第2、4、8、12、16、20、24周访视，第28周安全性随访。","quote_sha256":"8064a05bfe59d7b6d746ff3bcdbe4879fa4e001a85025a3185af088ff6c804e9","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"ev_visits"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"统计分析策略：全分析集与符合方案集共同支持主要非劣效结论；以组间ACR20率差的双侧95%置信区间下限高于-12%判定非劣效。不开展期中分析；安全性集按实际治疗分析。","quote_sha256":"3ea2a43e039c0b559a6a3c5378c18582d36d42cc6c5330ea45590d8107674c7a","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"ev_stats"}],"evidence_span_ids":["ev_sec_10_5","ev_design","ev_endpoints","ev_safety","ev_visits","ev_stats"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"补充发表与数据发布政策、作者资格与利益冲突管理文件以及研究注册计划，确定发表审批、作者资格判定和注册信息发布要求。","category":"source_missing","gap_id":"gap_10_5_publication_policy","missing_source_classes":["发表与数据发布政策","作者资格与利益冲突管理文件","研究注册计划"],"target":"10.5 数据发布和研究发表策略"},{"action":"补充数据共享与结果发布一致性审核文件，确定结果发布范围、发布时机以及与临床研究报告保持一致性的审核要求。","category":"source_missing","gap_id":"gap_10_5_results_reporting","missing_source_classes":["数据共享与结果发布一致性审核文件","临床研究报告发布流程文件"],"target":"10.5 数据发布和研究发表策略"}],"heading":"数据发布和研究发表策略","missing_source_classes":["发表与数据发布政策","作者资格与利益冲突管理文件","研究注册计划","数据共享与结果发布一致性审核文件"],"proposal_text":"本研究的数据发布和研究发表以第24周ACR20应答率的主要非劣效结论为核心内容。该结论在试验组不劣于阳性对照组时成立，判定依据为两组ACR20应答率差的双侧95%置信区间下限高于-12%，且由全分析集与符合方案集共同支持。研究发表内容同时涵盖第24周DAS28-CRP较基线变化和第24周ACR50应答率等关键次要终点结果、第12周ACR20应答率等其他次要终点结果，以及TEAE、SAE、导致停药的不良事件和实验室检查、生命体征和心电图具有临床意义变化等安全性结果；安全性结果按安全性集的实际治疗分析口径报告。研究结果在正式发布时应与本研究设定的终点定义、分析集口径和统计判定标准保持一致，并覆盖24周双盲双模拟治疗期与第28周安全性随访所获得的疗效和安全性信息。","rationale":"已确认的主要终点第24周ACR20应答率及其非劣效判定标准、关键次要终点、其他次要终点、安全性终点，以及全分析集、符合方案集和安全性集口径，界定了发布与发表的核心内容范围。医学作者需核对发表与数据发布政策、作者资格与利益冲突管理文件、研究注册计划以及数据共享与结果发布一致性审核文件。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_6e4142d7822b_5fcee0dcd7068db8","section_number":"10.5","source_ids":["protocol_full_draft_selection:49904f6975ffee0ce487631f","current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c"]}],"source_bindings":[{"content_sha256":"a30327dac9aabf28135337db5fa81cc5f4ede8b468fce37c1cb04b15d17d985b","locator":"document:mwdoc_greenfield_proj_user_6e4142d7822b_b209d029cdd23382:full-draft:49904f6975ffee0ce487631f","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:49904f6975ffee0ce487631f","source_type":"protocol_full_draft_selection","source_version":"full-draft:defc9b2a5fb939bebce57c9f1eb47eb7b7a5651124c6cd0f737697349c57cfb1:49904f6975ffee0ce487631f","text_sha256":"a30327dac9aabf281353