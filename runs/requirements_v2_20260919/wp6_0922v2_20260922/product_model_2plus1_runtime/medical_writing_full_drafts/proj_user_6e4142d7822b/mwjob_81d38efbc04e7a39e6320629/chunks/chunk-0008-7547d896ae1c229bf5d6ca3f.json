14cc3c"]},{"ai_run_id":"airun_20260922155236_2bae5c07","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"试验干预：试验组口服合成试验药B并接受阳性对照模拟注射；对照组接受匹配口服安慰剂并皮下注射合成阳性对照C；两组继续稳定甲氨蝶呤，治疗24周。","quote_sha256":"73286896e9c328c422019082f13c0792bf3ff2b05054007e0aa0f8b9162a9f84","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_intervention"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"剂量与给药方案：合成试验药B：50 mg，每日一次（口服）；24周\n合成阳性对照C：40 mg，每2周一次（皮下注射）；24周","quote_sha256":"e0ddd6f1aac7e3ae04d6f2e25ff2aa2023c6c910bf8405d0e54ed32f461de8d8","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_dose_schedule"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"总体研究设计：多中心、随机、双盲、双模拟、阳性对照、平行组、非劣效III期研究","quote_sha256":"a02da94ca30265ce95f8a5824ef17d9434a9934c5a46c4781ca73525f9620267","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_overall_design"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"研究时期：筛选期4周。；双盲双模拟治疗期24周。；安全性随访期4周。","quote_sha256":"3bfef9b5c99840973d468cd7875097ed081dba51f84af025bb7f2dc1a992586a","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_study_periods"}],"evidence_span_ids":["span_intervention","span_dose_schedule","span_overall_design","span_study_periods"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"检索本项目关于研究治疗依从性记录工具、评价频次与判定标准的来源内容，经医学确认后补入依从性评价方法。","category":"source_not_retrieved","gap_id":"gap_6_5_compliance_assessment_method","missing_source_classes":["研究治疗依从性评价方法与记录要求的项目来源"],"target":"6.5 研究治疗依从性"}],"heading":"研究治疗依从性","missing_source_classes":["研究治疗依从性评价方法与记录要求的项目来源"],"proposal_text":"本研究采用多中心、随机、双盲、双模拟、阳性对照、平行组非劣效III期设计。试验组受试者口服合成试验药B 50 mg每日一次并接受阳性对照模拟注射，对照组受试者口服合成试验药B匹配安慰剂每日一次并皮下注射合成阳性对照C 40 mg每2周一次；两组均继续使用入组前稳定剂量的甲氨蝶呤，除安全性需要外治疗期不调整，双盲双模拟治疗期为24周，其后设4周安全性随访期。研究治疗依从性管理的目标是使受试者在24周治疗期内按随机分配的治疗方案完成给药，同时将背景甲氨蝶呤维持在入组前稳定剂量。依从性评价范围涵盖随机分配治疗的执行情况、背景甲氨蝶呤维持治疗的一致性，以及双模拟条件下口服与皮下注射两种给药途径的执行情况，以保证疗效与安全性评价反映受试者实际接受的研究治疗。","rationale":"正文依据已确认的给药方案（合成试验药B 50 mg每日一次口服、合成阳性对照C 40 mg每2周一次皮下注射、各自匹配安慰剂、继续稳定剂量甲氨蝶呤、24周双盲双模拟治疗期）与总体设计撰写。依从性的记录工具、评价频次与判定阈值缺少可用来源，需医学经理确认来源后补充，并核对依从性评价范围表述是否符合本项目实施安排。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_6e4142d7822b_5460295ec96da48a","section_number":"6.5","source_ids":["protocol_full_draft_selection:7547d896ae1c229bf5d6ca3f","current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c"]},{"ai_run_id":"airun_20260922155236_2bae5c07","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_6e4142d7822b_b209d029cdd23382:full-draft:7547d896ae1c229bf5d6ca3f","quote":"章节编号=6.6.1\n章节标题=允许的合并用药/治疗\n章节类型=section\n当前正文=稳定剂量叶酸；符合方案限制的非甾体抗炎药。（策略=allowed_with_timing）","quote_sha256":"b229c6e74e087de80dba7c2fb85393692ee876d2fb992020081cae713e847cc2","source_id":"protocol_full_draft_selection:7547d896ae1c229bf5d6ca3f","span_id":"span_sec_6_6_1_packet"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"允许的合并治疗：稳定剂量叶酸；符合方案限制的非甾体抗炎药。（策略=allowed_with_timing）","quote_sha256":"52290b62246a1571b13181c62479662e061eb9408b97a3ef7caf0ce63cfd378e","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_allowed_comedication"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"必需背景治疗：甲氨蝶呤维持入组前稳定剂量，除安全性需要外治疗期不调整。（策略=allowed_if_stable）","quote_sha256":"1a80fcd1acfd6e2931cc113c092344ef969cd59856f3206e4eee09953627a413","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_mandatory_background"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"剂量与给药方案：合成试验药B：50 mg，每日一次（口服）；24周\n合成阳性对照C：40 mg，每2周一次（皮下注射）；24周","quote_sha256":"e0ddd6f1aac7e3ae04d6f2e25ff2aa2023c6c910bf8405d0e54ed32f461de8d8","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_dose_schedule"}],"evidence_span_ids":["span_sec_6_6_1_packet","span_allowed_comedication","span_mandatory_background","span_dose_schedule"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"检索本项目对非甾体抗炎药剂量与用药时机限制的具体规定以及稳定剂量叶酸的剂量数值，经医学确认后补入允许用药的具体限制内容。","category":"source_not_retrieved","gap_id":"gap_6_6_1_nsaid_limits_and_folate_dose","missing_source_classes":["非甾体抗炎药剂量与用药时机限制的项目来源","叶酸稳定剂量规定的项目来源"],"target":"6.6.1 允许的合并用药/治疗"},{"action":"检索本项目救援治疗的具体药物、启动条件与处理规则，与主要估计目标中救援治疗按复合策略计为无应答的规定保持一致后补入。","category":"source_not_retrieved","gap_id":"gap_6_6_1_rescue_therapy_rule","missing_source_classes":["救援治疗规则的项目来源"],"target":"6.6.1 允许的合并用药/治疗"}],"heading":"允许的合并用药/治疗","missing_source_classes":["非甾体抗炎药剂量与用药时机限制的项目来源","叶酸稳定剂量规定的项目来源","救援治疗规则的项目来源"],"proposal_text":"在为期24周的双盲双模拟治疗期内，受试者可继续使用稳定剂量的叶酸，以及在符合本项目限制条件下使用的非甾体抗炎药。甲氨蝶呤为本研究必需的背景治疗，受试者应维持入组前的稳定剂量，除安全性需要外治疗期内不作调整，并与随机分配的研究治疗联合使用。试验组受试者在口服合成试验药B 50 mg每日一次的同时接受阳性对照模拟注射；对照组受试者在口服匹配安慰剂每日一次的同时皮下注射合成阳性对照C 40 mg每2周一次。非甾体抗炎药的使用需同时满足本项目对该类药物剂量与用药时机的限制条件，以避免此类药物使用差异影响对研究治疗疗效的判断。","rationale":"正文依据已确认的允许合并用药策略（稳定剂量叶酸、符合限制条件的非甾体抗炎药）与必需背景治疗（甲氨蝶呤维持入组前稳定剂量，除安全性需要外不调整）撰写，并引用了两组给药方案以说明允许治疗与随机治疗的联合方式。非甾体抗炎药的具体限制条件与叶酸剂量数值缺少可用来源，需医学经理确认后补充具体数值与限制内容。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_6e4142d7822b_ecd0d836c0b5f005","section_number":"6.6.1","source_ids":["protocol_full_draft_selection:7547d896ae1c229bf5d6ca3f","current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c"]},{"ai_run_id":"airun_20260922155236_2bae5c07","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_6e4142d7822b_b209d029cdd23382:full-draft:7547d896ae1c229bf5d6ca3f","quote":"章节编号=6.6.2\n章节标题=禁止的合并用药/治疗\n章节类型=section\n当前正文=治疗期禁止新增其他生物制剂或靶向合成抗风湿药。（策略=prohibited）","quote_sha256":"ea369bbb56a74800f79c196f41e4cb9d056033f2befad1ee1559ca20cdad9d4d","source_id":"protocol_full_draft_selection:7547d896ae1c229bf5d6ca3f","span_id":"span_sec_6_6_2_packet"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"禁止的合并治疗：治疗期禁止新增其他生物制剂或靶向合成抗风湿药。（策略=prohibited）","quote_sha256":"1c59f559e15e6e65e9a2f10079f6b10971101b3b919f1e66392b73e6358898bd","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_prohibited_comedication"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"洗脱要求：除稳定甲氨蝶呤外的生物制剂或靶向合成抗风湿药按方案规定完成洗脱。","quote_sha256":"cc2c496038568f17e9b12486e121cf21ee42ef382061f1e1a5f0a0f205c321ae","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_washout_requirement"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"允许的合并治疗：稳定剂量叶酸；符合方案限制的非甾体抗炎药。（策略=allowed_with_timing）","quote_sha256":"52290b62246a1571b13181c62479662e061eb9408b97a3ef7caf0ce63cfd378e","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_allowed_comedication"}],"evidence_span_ids":["span_sec_6_6_2_packet","span_prohibited_comedication","span_washout_requirement","span_allowed_comedication"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"检索本项目对生物制剂或靶向合成抗风湿药洗脱时长的具体规定，经医学确认后补入洗脱要求的具体时限与执行方式。","category":"source_not_retrieved","gap_id":"gap_6_6_2_washout_duration","missing_source_classes":["生物制剂及靶向合成抗风湿药洗脱期规定的项目来源"],"target":"6.6.2 禁止的合并用药/治疗"}],"heading":"禁止的合并用药/治疗","missing_source_classes":["生物制剂及靶向合成抗风湿药洗脱期规定的项目来源"],"proposal_text":"在为期24周的双盲双模拟治疗期内，禁止新增其他生物制剂或其他靶向合成抗风湿药，即在随机分组后不得加用此类药物。对于入组前使用过生物制剂或靶向合成抗风湿药的受试者，除稳定剂量的甲氨蝶呤外，应在随机分组前完成本项目要求的洗脱。治疗期内受试者应继续接受随机分配的研究治疗并维持入组前稳定剂量的甲氨蝶呤，合并用药/治疗限于允许范围内稳定剂量的叶酸及符合本项目限制条件的非甾体抗炎药，以保持治疗期内疗效与安全性评价的可解释性。","rationale":"正文依据已确认的禁止合并用药策略（治疗期禁止新增其他生物制剂或靶向合成抗风湿药）、洗脱要求以及允许的合并用药范围撰写。洗脱期具体时长与方法缺少可用来源，需医学经理确认后补充，并核对治疗期合并用药限制的表述与项目文件一致。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_6e4142d7822b_7bcadafa7bb58c90","section_number":"6.6.2","source_ids":["protocol_full_draft_selection:7547d896ae1c229bf5d6ca3f","current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c"]}],"source_bindings":[{"content_sha256":"19ab34b580816078941e59d710222b5a02b751658dde44778e24255c6cb326d7","locator":"document:mwdoc_greenfield_proj_user_6e4142d7822b_b209d029cdd23382:full-draft:7547d896ae1c229bf5d6ca3f","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:7547d896ae1c229bf5d6ca3f","source_type":"protocol_full_draft_selection","source_version":"full-draft:defc9b2a5fb939bebce57c9f1eb47eb7b7a5651124c6cd0f737697349c57cfb1:7547d896ae1c229bf5d6ca3f","text_sha256":"19ab34b580816078941e59d710222b5a02b751658dde44778e24255c6cb326d7"},{"content_sha256":"c5bf2d0afd5d40df8334c8e3453d30d7faf52e6f4d22546778d8bae4c48f8aba","locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","source_type":"current_project_study_definition","source_version":"mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","text_sha256":"c5bf2d0afd5d40df8334c8e3453d30d7faf52e6f4d22546778d8bae4c48f8aba"}]}