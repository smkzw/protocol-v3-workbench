_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_sd_control"}],"evidence_span_ids":["span_selection_random","span_sd_random","span_sd_parallel","span_sd_multicenter","span_sd_control"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"补充项目随机化方案中的分层因素清单。","category":"source_missing","gap_id":"gap_s3_strat","missing_source_classes":["随机化方案与分层因素"],"target":"4.3 随机化中分层因素"},{"action":"补充随机数生成方法、区组设计和分配隐藏措施的项目文件。","category":"source_missing","gap_id":"gap_s3_alloc","missing_source_classes":["随机化系统配置说明","统计编程规范"],"target":"4.3 随机化中随机数生成与分配隐藏"},{"action":"补充随机化系统类型及操作流程的项目文件。","category":"source_missing","gap_id":"gap_s3_system","missing_source_classes":["随机化系统操作手册"],"target":"4.3 随机化中随机化系统操作流程"}],"heading":"随机化","missing_source_classes":["随机化方案与分层因素","随机化系统配置说明","统计编程规范","随机化系统操作手册"],"proposal_text":"本研究采用1:1分层随机，采用平行组分配模型，并在多中心实施。随机化将试验参与者按相同概率分配至合成试验药B联合甲氨蝶呤组或合成阳性对照C联合甲氨蝶呤组。随机化分配与双盲双模拟设计相衔接，以支持第24周ACR20应答率非劣效性的确证性评价。","rationale":"依据已确认研究事实中的随机化方式、分配模型、中心模式和对照设置撰写；医学作者需核对分层因素、随机数生成、分配隐藏及随机化系统配置等项目实施细节。","review_advisories":["本节复述高影响研究设计（随机化）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_6e4142d7822b_44010fdf7a168def","section_number":"4.3","source_ids":["protocol_full_draft_selection:685a7cde76873e1cfa4df6e3","current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:c3e1f164c2e657","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a"]},{"ai_run_id":"airun_20260922154707_3f8a6e2d","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_6e4142d7822b_b209d029cdd23382:full-draft:685a7cde76873e1cfa4df6e3","quote":"本研究采用双盲设计。双模拟维持盲态","quote_sha256":"1445f5b263b13464aa44a6683590cd3542bd1e0272263e44004c615f56fab525","source_id":"protocol_full_draft_selection:685a7cde76873e1cfa4df6e3","span_id":"span_selection_blinding"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"盲法角色：试验参与者；研究者；疗效评估者","quote_sha256":"ce7454cc2a89c1c83acc89f0906f7057e236ff05db2b6fecae5a8ca9974fbd49","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_sd_blind_roles"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"盲法实施：双模拟维持盲态","quote_sha256":"77ecfa9c037209f3bf1692db03313bd28b6d245667db0a63b9bdbb556cfcf083","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_sd_blind_impl"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"对照：合成阳性对照C联合甲氨蝶呤；1:1随机、双盲双模拟、24周平行对照。","quote_sha256":"0e5692134ab87cbcc07cf84cc6077eb06ebfbdfec1b845db5b27464b2b71b0d2","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_sd_control"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"试验干预：试验组口服合成试验药B并接受阳性对照模拟注射；对照组接受匹配口服安慰剂并皮下注射合成阳性对照C；两组继续稳定甲氨蝶呤，治疗24周。","quote_sha256":"73286896e9c328c422019082f13c0792bf3ff2b05054007e0aa0f8b9162a9f84","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_sd_intervention"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"合成试验药B：50 mg，每日一次（口服）；24周","quote_sha256":"1c1a9495d34d65f21e524c9eb04cdfff80c8adc9822975936729a43d8862b719","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_sd_dose_b"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"合成阳性对照C：40 mg，每2周一次（皮下注射）；24周","quote_sha256":"650ba0a3f1995366f4c39225fcc1eb45cf30f597485bb807f1ac7dbcf3dafee5","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_sd_dose_c"}],"evidence_span_ids":["span_selection_blinding","span_sd_blind_roles","span_sd_blind_impl","span_sd_control","span_sd_intervention","span_sd_dose_b","span_sd_dose_c"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"补充紧急揭盲触发条件、授权角色、记录和报告要求的项目文件。","category":"source_missing","gap_id":"gap_s4_unblind","missing_source_classes":["项目盲法/揭盲SOP","紧急揭盲流程"],"target":"4.4 盲法与揭盲中紧急揭盲流程"},{"action":"补充盲态维持、破盲记录和盲态评估的项目文件。","category":"source_missing","gap_id":"gap_s4_blind_maintain","missing_source_classes":["盲态维持计划","破盲记录表"],"target":"4.4 盲法与揭盲中盲态维持措施"}],"heading":"盲法与揭盲","missing_source_classes":["项目盲法/揭盲SOP","紧急揭盲流程","盲态维持计划","破盲记录表"],"proposal_text":"本研究采用双盲设计，并通过双模拟维持盲态。试验参与者按1:1随机分配至合成试验药B联合甲氨蝶呤组或合成阳性对照C联合甲氨蝶呤组。试验组口服合成试验药B 50 mg每日一次并接受合成阳性对照C匹配安慰剂皮下注射；对照组接受合成试验药B匹配口服安慰剂每日一次并皮下注射合成阳性对照C 40 mg每2周一次。盲法角色涵盖试验参与者、研究者和疗效评估者。双模拟设计使两组在口服片剂和皮下注射两种给药方式上均接受匹配安慰剂或阳性对照，以维持盲态并支持非劣效性评价。","rationale":"依据已确认研究事实中的双盲设计、双模拟维持盲态、1:1随机、匹配安慰剂、试验干预和盲法角色撰写；医学作者需核对紧急揭盲流程、授权角色、记录报告要求及盲态维持措施。","review_advisories":["本节复述高影响研究设计（盲法与揭盲）；请在合并设计摘要中统一核对。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_6e4142d7822b_0e3b0c29a60690c2","section_number":"4.4","source_ids":["protocol_full_draft_selection:685a7cde76873e1cfa4df6e3","current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:c3e1f164c2e657","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a"]}],"source_bindings":[{"content_sha256":"da701403f1ace1eb15bbd8d5db15cfbb4