b57a2516bf63ca4452202b7f5fee51482cc73ab6c3900d25","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"es_sd_safety_endpoints"}],"evidence_span_ids":["es_pkg_88","es_sd_aesi","es_sd_safety_endpoints"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"取得本项目安全性管理文件及不良事件判定标准后，补充事件定义、分级与判定要求","category":"source_missing","gap_id":"gap_8_8_aesi_definition","missing_source_classes":["安全性管理计划或不良事件判定标准","研究者手册中的感染风险信息"],"target":"8.8 严重感染和机会性感染的识别与判定标准"},{"action":"待本项目安全性报告流程文件可用后，补写报告路径、报告时限与随访安排","category":"source_missing","gap_id":"gap_8_8_aesi_reporting","missing_source_classes":["特别关注的不良事件报告流程与随访要求相关文件"],"target":"8.8 特别关注的不良事件的报告流程、报告对象、时限与随访要求"}],"heading":"特别关注的不良事件","missing_source_classes":["安全性管理计划或不良事件判定标准","特别关注的不良事件报告流程与随访要求相关文件","研究者手册中的感染风险信息"],"proposal_text":"本方案将严重感染和机会性感染确定为特别关注的不良事件。试验期间，研究者应对试验参与者新发或加重的严重感染、机会性感染保持警惕，及时识别、记录并评估其严重程度与临床转归，完整采集相关诊疗信息，并将其纳入安全性数据的汇总与安全性评价。在评价合成试验药B联合甲氨蝶呤的安全性时，此类事件的发生例数、发生率以及与导致停药的关系应单独汇总描述。","rationale":"依据已确认研究事实中“特别关注的不良事件：严重感染和机会性感染”以及安全性终点条目，正文将上述两类事件确定为本研究的特别关注的不良事件，并说明其识别、记录、评估与安全性汇总要求；特别关注的不良事件的判定标准、报告流程与时限、随访要求尚无项目级来源，已列入待补事项，需医学负责人确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_6e4142d7822b_7b0de6464adfc8ad","section_number":"8.8","source_ids":["protocol_full_draft_selection:67497d652f6290779353ea65","current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:152c1e08c78e76","company_corpus:cms_cn_protocol_corpus_20260715_v1:30fd7cd8503aae","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976"]},{"ai_run_id":"airun_20260922160238_cd960c40","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_6e4142d7822b_b209d029cdd23382:full-draft:67497d652f6290779353ea65","quote":"SECTION_ID=mwsec_greenfield_proj_user_6e4142d7822b_88c15a4176e6ac3e\n章节编号=8.9\n章节标题=妊娠事件的报告与随访\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"85360d60a69270953a9a907d1c5d5aed15446b45f213b5f8f68a29149d956ba9","source_id":"protocol_full_draft_selection:67497d652f6290779353ea65","span_id":"es_pkg_89"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"排除标准模块：既往对研究药或阳性对照不耐受；活动性严重感染；妊娠或哺乳；研究者判断不适合参加。","quote_sha256":"a84d3818dbfb446a1819a205cd6ee4dc82111a86ce76e0c7f1e0a9a3648a75d0","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"es_sd_exclusion"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"研究人群概述：18–75岁，符合类风湿关节炎分类标准，稳定甲氨蝶呤治疗后仍为中高疾病活动度的成人试验参与者。","quote_sha256":"9a107fe14893fc4db5f87b68654f5bd6074b469655881fe9433fa6c5ecf90e1a","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"es_sd_population"}],"evidence_span_ids":["es_pkg_89","es_sd_exclusion","es_sd_population"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"取得本项目妊娠事件管理相关文件后补写具体报告要求","category":"source_missing","gap_id":"gap_8_9_pregnancy_report","missing_source_classes":["妊娠事件报告与随访相关的项目级安全性管理文件"],"target":"8.9 妊娠事件的报告对象、报告时限、报告表与报告流程"},{"action":"在项目文件明确随访范围后补充随访终止时点与记录方式","category":"source_missing","gap_id":"gap_8_9_pregnancy_followup","missing_source_classes":["妊娠结局随访要求相关项目文件"],"target":"8.9 妊娠结局随访的随访内容与终止时点"},{"action":"由项目文件或医学职能确认避孕要求后另行规定，本章不自行设定","category":"source_missing","gap_id":"gap_8_9_contraception","missing_source_classes":["避孕要求与生殖风险防控相关项目文件"],"target":"8.9 与妊娠事件相关的避孕要求"}],"heading":"妊娠事件的报告与随访","missing_source_classes":["妊娠事件报告与随访相关的项目级安全性管理文件","妊娠结局随访要求相关项目文件","避孕要求与生殖风险防控相关项目文件"],"proposal_text":"本研究不纳入妊娠或哺乳期女性，试验参与者为18至75岁的成人。研究期间如发现试验参与者妊娠，应记录妊娠的发现时间、处理经过及最终妊娠结局，并对妊娠结局进行随访，随访获取的信息作为安全性信息纳入数据管理。妊娠事件涉及的报告对象、报告时限、报告表要求与随访终止时点，与本方案安全性报告的有关规定保持一致。","rationale":"依据已确认研究事实中妊娠或哺乳为排除标准以及试验参与者为18至75岁成人，正文说明本研究不纳入妊娠或哺乳期女性，并对研究期间妊娠事件的记录与结局随访范围作出规定；报告对象、报告时限、报告表、随访终止时点与避孕要求缺少项目级来源，不得沿用其他项目做法，需医学负责人确认。","review_advisories":["本节复述高影响研究设计（妊娠事件的报告与随访）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_6e4142d7822b_88c15a4176e6ac3e","section_number":"8.9","source_ids":["protocol_full_draft_selection:67497d652f6290779353ea65","current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:152c1e08c78e76","company_corpus:cms_cn_protocol_corpus_20260715_v1:30fd7cd8503aae","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976"]},{"ai_run_id":"airun_20260922160238_cd960c40","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_6e4142d7822b_b209d029cdd23382:full-draft:67497d652f6290779353ea65","quote":"SECTION_ID=mwsec_greenfield_proj_user_6e4142d7822b_c09e8cafe657b101\n章节编号=9\n章节标题=统计分析\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"eea060dc16ca9f8e4aed718434e2b97a4588a5fcc05189b22f20b2fba9fa1633","source_id":"protocol_full_draft_selection:67497d652f6290779353ea65","span_id":"es_pkg_9"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"主要研究目的：证明第24周ACR20应答率方面合成试验药B不劣于合成阳性对照C。","quote_sha256":"a7a7200060f3ad25aef63483ba7fb712ec38921a481ff6fe0f75f7521e8bfb6e","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"es_sd_primary_objective"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"统计分析策略：全分析集与符合方案集共同支持主要非劣效结论；以组间ACR20率差的双侧95%置信区间下限高于-12%判定非劣效。不开展期中分析；安全性集按实际治疗分析。","quote_sha256":"3ea2a43e039c0b559a6a3c5378c18582d36d42cc6c5330ea45590d8107674c7a","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"es_sd_stats_strategy"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"估计目标策略：主要估计目标比较所有随机试验参与者第24周ACR20应答；因疗效不足接受救援治疗按复合策略计为无应答，单纯停用随机治疗采用治疗策略并通过多重插补处理缺失。","quote_sha256":"f7d2d6751b0042a8a9ae740f5d1a4dff9f4672a029a40a3fa2844a22ffd8fa36","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"es_sd_estimand"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"安全性终点：TEAE、SAE及导致停药的不良事件发生率。；实验室检查、生命体征和心电图具有临床意义的变化。","quote_sha256":"b7b07260763ae74db57a2516bf63ca4452202b7f5fee51482cc73ab6c3900d25","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"es_sd_safety_endpoints"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"自适应设计是否计划：否\n样本量再估计是否计划：否\n期中分析是否计划：否","quote_sha256":"344feb02ff88d627a59d7419f0ce4b34776a5c77a4b3cebedec83e1ebdbeb839","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"es_sd_design_flags"}],"evidence_span_ids":["es_pkg_9","es_sd_primary_objective","es_sd_stats_strategy","es_sd_estimand","es_sd_safety_endpoints","es_sd_design_flags"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"待统计分析计划可用后补写模型、敏感性分析与亚组分析细节","category":"source_missing","gap_id":"gap_9_stat_methods","missing_source_classes":["统计分析计划（SAP）"],"target":"9 主要与次要疗效终点的统计模型、敏感性分析与亚组分析安排"},{"action":"待多重性控制策略确定后补充相应分析顺序与检验方法","category":"source_missing","gap_id":"gap_9_multiplicity","missing_source_classes":["多重性控制策略相关项目文件"],"target":"9 关键次要终点的多重性控制策略"},{"action":"取得分层因素信息后补充分层相关分析要求","category":"source_missing","gap_id":"gap_9_stratification","missing_source_classes":["随机化分层因素相关设计文件"],"target":"9 分层随机化分层因素在统计分析中的处理"}],"heading":"统计分析","missing_source_classes":["统计分析计划（SAP）","多重性控制策略相关项目文件","随机化分层因素相关设计文件"],"proposal_text":"本研究的统计分析按照预先确定的统计分析策略实施。主要疗效分析针对第24周ACR20应答率，计算合成试验药B联合甲氨蝶呤组与阳性对照联合甲氨蝶呤组之间的应答率差及其双侧95%置信区间，当该率差的双侧95%置信区间下限高于-12个百分点时判定非劣效成立，检验水准取单侧0.025。主要疗效结论由全分析集与符合方案集共同支持。针对伴发事件与缺失数据，因疗效不足接受救援治疗的试验参与者按复合策略计为无应答，单纯停用随机治疗的试验参与者采用治疗策略并通过多重插补处理缺失数据。次要疗效分析包括第12周ACR20应答率、第24周ACR50应答率以及第24周DAS28-CRP较基线的变化。安全性分析基于安全性集，按试验参与者实际接受的治疗进行，汇总TEAE、SAE及导致停药的不良事件发生率，以及实验室检查、生命体征和心电图具有临床意义的变化。本研究不开展期中分析，亦不进行样本量再估计。","rationale":"依据已确认研究事实中的主要研究目的、主要与次要终点、估计目标策略、统计分析策略、样本量策略与安全性终点，正文写入第24周ACR20应答率组间率差双侧95%置信区间下限高于-12个百分点的非劣效判定标准、单侧0.025的检验水准、救援治疗复合策略与多重插补处理缺失数据、次要终点分析范围、安全性分析范围以及不开展期中分析；统计模型、多重性控制与敏感性分析安排待统计分析计划明确，需医学负责人确认。","review_advisories":["本节复述高影响研究设计（统计分析）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（伴发事件、期中分析、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_6e4142d7822b_c09e8cafe657b101","section_number":"9","source_ids":["protocol_full_draft_selection:67497d652f6290779353ea65","current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:152c1e08c78e76","company_corpus:cms_cn_protocol_corpus_20260715_v1:30fd7cd8503aae","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976"]},{"ai_run_id":"airun_20260922160238_cd960c40","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_6e4142d7822b_b209d029cdd23382:full-draft:67497d652f6290779353ea65","quote":"SECTION_ID=mwsec_greenfield_proj_user_6e4142d7822b_225e7f5515daabed\n章节编号=9.2\n章节标题=统计分析数据集\n章节类型=section\n当前正文=全分析集与符合方案集共同支持主要非劣效结论；以组间ACR20率差的双侧95%置信区间下限高于-12%判定非劣效。不开展期中分析；安全性集按实际治疗分析。","quote_sha256":"1d3ca4a2be3a2112f5c0f713fe233d132c510488ab2167ebd0d14a8c3db557db","source_id":"protocol_full_draft_selection:67497d652f6290779353ea65","span_id":"es_pkg_92"},{"locator":"document:mwdoc_greenfield_proj_user_6e4142d7822b_b209d029cdd23382:full-draft:67497d652f6290779353ea65","quote":"SECTION_ID=mwsec_greenfield_proj_user_6e4142d7822b_c09e8cafe657b101\n章节编号=9\n章节标题=统计分析\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"eea060dc16ca9f8e4aed718434e2b97a4588a5fcc05189b22f20b2fba9fa1633","source_id":"protocol_full_draft_selection:67497d652f6290779353ea65","span_id":"es_pkg_9"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"统计分析策略：全分析集与符合方案集共同支持主要非劣效结论；以组间ACR20率差的双侧95%置信区间下限高于-12%判定非劣效。不开展期中分析；安全性集按实际治疗分析。","quote_sha256":"3ea2a43e039c0b559a6a3c5378c18582d36d42cc6c5330ea45590d8107674c7a","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"es_sd_stats_strategy"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"估计目标策略：主要估计目标比较所有随机试验参与者第24周ACR20应答；因疗效不足接受救援治疗按复合策略计为无应答，单纯停用随机治疗采用治疗策略并通过多重插补处理缺失。","quote_sha256":"f7d2d6751b0042a8a9ae740f5d1a4dff9f4672a029a40a3fa2844a22ffd8fa36","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"es_sd_estimand"}],"evidence_span_ids":["es_pkg_92","es_pkg_9","es_sd_stats_strategy","es_sd_estimand"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"取得统计分析计划中分析集定义后补写各数据集的具体纳入与排除条件","category":"source_missing","gap_id":"gap_9_2_dataset_definitions","missing_source_classes":["统计分析计划中分析集定义相关内容","方案偏离判定标准文件"],"target":"9.2 全分析集、符合方案集与安全性集的纳入条件及方案偏离判定"},{"action":"待数据管理与统计分析相关文件明确后补充分析集划分与确认程序","category":"source_missing","gap_id":"gap_9_2_dataset_finalization","missing_source_classes":["数据管理与数据库锁定相关文件"],"target":"9.2 分析集划分的最终确定程序与数据审核安排"}],"heading":"统计分析数据集","missing_source_classes":["统计分析计划中分析集定义相关内容","方案偏离判定标准文件","数据管理与数据库锁定相关文件"],"proposal_text":"本研究的统计分析数据集包括全分析集、符合方案集和安全性集，分别服务于主要疗效评价、主要结果的支持性评价和安全性评价。全分析集覆盖全部随机化的试验参与者，与符合方案集共同支持主要非劣效结论：以第24周ACR20应答率的组间率差双侧95%置信区间下限高于-12个百分点判定非劣效。符合方案集用于评价主要结果在符合方案规定条件下的稳健性。安全性集按试验参与者实际接受的治疗进行划分，用于TEAE、SAE及导致停药的不良事件发生率以及实验室检查、生命体征和心电图具有临床意义变化的汇总分析。本研究不开展期中分析。","rationale":"依据已确认研究事实与既有内容，正文写入全分析集、符合方案集与安全性集的角色、组间ACR20率差双侧95%置信区间下限高于-12个百分点的非劣效判定规则、安全性集按实际接受治疗划分以及不开展期中分析；各分析集的具体纳入条件、方案偏离判定与最小暴露要求待统计分析计划明确，需医学负责人确认。","review_advisories":["本节提及高影响设计信息（期中分析）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_6e4142d7822b_225e7f5515daabed","section_number":"9.2","source_ids":["protocol_full_draft_selection:67497d652f6290779353ea65","current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:152c1e08c78e76","company_corpus:cms_cn_protocol_corpus_20260715_v1:30fd7cd8503aae","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976"]}],"source_bindings":[{"content_sha256":"ba9ea84d8070945fae0f958a5705729eb7bdcf828fb2d880c793238976c058d6","locator":"document:mwdoc_greenfield_proj_user_6e4142d7822b_b209d029cdd23382:full-draft:67497d652f6290779353ea65","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:67497d652f6290779353ea65","source_type":"protocol_full_draft_selection","source_version":"full-draft:defc9b2a5fb939bebce57c9f1eb47eb7b7a5651124c6cd0f737697349c57cfb1:67497d652f6290779353ea65","text_sha256":"ba9ea84d8070945fae0f958a5705729eb7bdcf828fb2d880c793238976c058d6"},{"content_sha256":"c5bf2d0afd5d40df8334c8e3453d30d7faf52e6f4d22546778d8bae4c48f8aba","locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","source_type":"current_project_study_definition","source_version":"mwdefinition_ace846adc197b5363d