us_spans":0,"project_fact_spans":11},"gap_items":[{"action":"补充本项目剂量暂停、恢复与永久停药的判定标准与实施流程后写入相应条目","category":"source_missing","gap_id":"gap_6_dose_modification","missing_source_classes":["本项目剂量调整与停药标准文件"],"target":"6 研究治疗/干预—剂量暂停、恢复与永久停药"},{"action":"补充非甾体抗炎药等允许合并治疗的剂量、使用时长与时间窗等具体限制条件","category":"source_missing","gap_id":"gap_6_concomitant_limits","missing_source_classes":["本项目合并用药限制清单"],"target":"6 研究治疗/干预—合并用药限制条件"},{"action":"补充生物制剂与靶向合成抗风湿药的具体洗脱时长及计算起点后写入洗脱条目","category":"source_missing","gap_id":"gap_6_washout_duration","missing_source_classes":["本项目洗脱要求明细文件"],"target":"6 研究治疗/干预—洗脱要求"},{"action":"补充本项目疗效不足时救援治疗的用药、启动条件与实施流程后写入相应条目","category":"source_missing","gap_id":"gap_6_rescue_therapy","missing_source_classes":["本项目救援治疗与治疗中断管理文件"],"target":"6 研究治疗/干预—救援治疗"}],"heading":"研究治疗/干预","missing_source_classes":["本项目剂量调整与停药标准文件","本项目合并用药限制清单","本项目洗脱要求明细文件","本项目救援治疗与治疗中断管理文件"],"proposal_text":"本研究所有入组的试验参与者均在稳定剂量甲氨蝶呤背景治疗基础上接受为期24周的研究治疗。试验组口服合成试验药B 50 mg、每日一次，并接受阳性对照的模拟注射；对照组口服合成试验药B匹配安慰剂、每日一次，并皮下注射合成阳性对照C 40 mg、每2周一次。两组分别接受口服与皮下注射两种给药方式，通过匹配安慰剂维持双模拟。甲氨蝶呤在研究期间维持入组前的稳定剂量，除安全性需要外不做调整。研究期间允许的合并治疗包括稳定剂量叶酸，以及在满足本项目限制条件下使用的非甾体抗炎药；治疗期间禁止新增其他生物制剂或靶向合成抗风湿药。入组前正在使用除稳定剂量甲氨蝶呤以外的生物制剂或靶向合成抗风湿药的试验参与者，需完成洗脱后方可接受本研究治疗。本研究不设置计划性剂量调整。","rationale":"正文中的分组干预构成、给药剂量、给药频率、给药途径、治疗期24周、甲氨蝶呤背景治疗与合并用药允许及禁止范围，均取自本项目已确认的研究定义。医学作者需核对以下未在本章设定的实施细节：剂量暂停、恢复与永久停药标准，非甾体抗炎药的具体限制条件，生物制剂与靶向合成抗风湿药的洗脱时长，以及救援治疗的实施要求；上述内容在获得本项目相应文件前不写入正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_6e4142d7822b_0b8e3b178916f8fb","section_number":"6","source_ids":["protocol_full_draft_selection:83c62d0b40096b9f917ddd67","current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]},{"ai_run_id":"airun_20260922155005_151374e8","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_6e4142d7822b_b209d029cdd2