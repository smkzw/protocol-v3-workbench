428311ed6fcf1fd4c6010fb40286dc0b93cfa9cc4683c4d718","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_placebo_b"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"合成阳性对照C匹配安慰剂：每2周一次（皮下注射）；24周","quote_sha256":"b35ec2caf9b9faac52c8eac6b61c1cdcd42a9b4ba4ec34f6fdb6397cb16217c2","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_placebo_c"}],"evidence_span_ids":["span_sec61_current_text","span_dosage_form","span_route","span_tech_type","span_dose_b","span_dose_c","span_placebo_b","span_placebo_c"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":7},"gap_items":[{"action":"补充四类试验用药品的包装形式、标签内容与标签语言要求后写入相应条目","category":"source_missing","gap_id":"gap_61_packaging_labeling","missing_source_classes":["本项目试验用药品包装与标签文件"],"target":"6.1 试验用药品—包装与标签"},{"action":"补充储存条件、温度范围及运输与稳定性管理要求后写入相应条目","category":"source_missing","gap_id":"gap_61_storage_transport","missing_source_classes":["研究者手册","本项目试验用药品储存与运输管理文件"],"target":"6.1 试验用药品—储存与运输"},{"action":"补充试验用药品发放、回收、计数与销毁的记录要求及相应职责分工后写入相应条目","category":"source_missing","gap_id":"gap_61_dispensing_accountability","missing_source_classes":["本项目试验用药品供应、发放回收与计数管理文件"],"target":"6.1 试验用药品—发放、回收与计数"}],"heading":"试验用药品","missing_source_classes":["研究者手册","本项目试验用药品包装与标签文件","本项目试验用药品储存与运输管理文件","本项目试验用药品供应、发放回收与计数管理文件"],"proposal_text":"本研究的试验用药品包括合成试验药B及其匹配安慰剂，以及合成阳性对照C及其匹配安慰剂。合成试验药B为小分子药物，以片剂形式经口服途径给药，给药剂量为50 mg、每日一次，用药时限24周；其匹配安慰剂为口服制剂，每日给药一次，用药时限24周。合成阳性对照C经皮下注射给药，给药剂量为40 mg、每2周一次，用药时限24周；其匹配安慰剂同样每2周皮下注射一次，用药时限24周。上述试验用药品及其匹配安慰剂共同构成双模拟条件下两组受试者的用药组合，两组在给药方式上保持一致。","rationale":"试验用药品名称、剂型、给药途径、给药剂量、给药频率与用药时限均取自本项目已确认的研究定义。医学作者需补充并核对包装形式、标签内容与语言、储存与运输条件、发放回收与计数要求及相应职责分工；这些内容在缺少本项目来源的情况下不在正文中设定。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_6e4142d7822b_bd982c1c8ee685f6","section_number":"6.1","source_ids":["pr