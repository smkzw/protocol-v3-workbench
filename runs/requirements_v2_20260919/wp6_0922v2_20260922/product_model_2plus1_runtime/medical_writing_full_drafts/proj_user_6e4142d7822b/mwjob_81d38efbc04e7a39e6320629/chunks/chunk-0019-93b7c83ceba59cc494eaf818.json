n_ace846adc197b5363d2e:revision:4","quote":"方案编号：WP6-RA-NI-B\n方案版本：V0.1\n研究题目：合成试验药B联合甲氨蝶呤治疗活动性类风湿关节炎的随机、双盲、双模拟、阳性对照III期非劣效研究方案\n试验药物：合成试验药B\n适应症：甲氨蝶呤应答不足的活动性类风湿关节炎\n研究分期：III期","quote_sha256":"92d14f60041937427c8bd7710e63f918752bbe94587e6925118350fcffc60e0c","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_project_identity"},{"locator":"section:9.1 研究监查|block:1175|chunk:1","quote":"申办者有道德上、法律上和科学上的义务，确保研究按照已确立的研究准则、GCP 指导原则、适用的管理要求和法规进行。作为履行这些义务的协调措施，在研究中，申办者的监查员或其代表需经常电话和书面与研究中心沟通，并定期拜访研究中心进行现场监查，评价其是否遵守监管要求，确保受试者的安全、福利以及隐私受到 保护、方案依从性、CRF 录入的完整性和准确性、CRF 数据和原始文件的验证及 AE 的发生等。研究者必须向监查员提供访问所有原始资料和研究文件的权限。","quote_sha256":"308a36177f06e789510202b2b938b2a9e5084c7e222d80919f28732387e33a3e","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","span_id":"span_monitoring"},{"locator":"section:11.4 研究数据记录|block:1218|chunk:1","quote":"记录必须按照当前的 GCP 指导原则保留。所有必要的研究文件包括受试者的记 录、原始文件、CRF 和研究药物库存清单必须记录在案。","quote_sha256":"f7aafa4178dd21690460dacca369e7f10ae2fcf13e0a791098b68b6758b2984d","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:d84680fc442c0c","span_id":"span_records"},{"locator":"section:质量控制|block:896|chunk:1","quote":"临床研究开始前，必须通过启动会或研究者会议对所有参加研究的人员进行研究方案的培训，使每个参研人员都对临床研究方案及其各指标具体内涵有充分理解和认识、掌握GCP原则、统一记录方式与判断标准、严格按照方案执行。培训必须在该临床试验机构入选试验参与者之前进行。","quote_sha256":"d390ad9e56aa00a48a8506e0ab4636d8fdf7c2214b0b331f9094e23dec03bb55","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:69be796f1e42c8","span_id":"span_training"}],"evidence_span_ids":["span_packet_12","span_project_identity","span_monitoring","span_records","span_training"],"evidence_summary":{"corpus_spans":3,"project_fact_spans":1},"gap_items":[{"action":"获取本项目监查计划后补充监查方式、频次和范围","category":"source_missing","gap_id":"gap_12_monitoring_plan","missing_source_classes":["项目监查计划"],"target":"12 研究文件、监查和管理"},{"action":"获取数据管理计划和研究文件清单后补充数据职责、文件保存和归档要求","category":"source_missing","gap_id":"gap_12_data_management","missing_source_classes":["数据管理计划","研究文件清单与保存期限"],"target":"12 研究文件、监查和管理"},{"action":"获取培训计划或记录模板后补充培训实施与记录要求","category":"source_missing","gap_id":"gap_12_training_records","missing_source_classes":["培训计划与培训记录模板"],"target":"12 研究文件、监查和管理"}],"heading":"研究文件、监查和管理","missing_source_classes":["项目监查计划","数据管理计划","研究文件清单与保存期限","培训计划与培训记录模板"],"proposal_text":"本研究按照方案编号 WP6-RA-NI-B、版本 V0.1 执行。申办者承担确保研究按照已确立的研究准则、药物临床试验质量管理规范、适用的管理要求和法规进行的责任。作为履行该责任的协调措施，监查员或其代表应与研究中心保持定期电话和书面沟通，并定期进行现场监查，评价研究中心是否遵守监管要求，确保受试者的安全、福利和隐私受到保护，同时核查方案依从性、病例报告表录入的完整性和准确性、病例报告表数据与原始文件的验证以及不良事件的发生情况。研究者必须向监查员提供访问所有原始资料和研究文件的权限。所有必要的研究文件，包括受试者记录、原始文件、病例报告表和研究药物库存清单，必须按照药物临床试验质量管理规范记录在案并予以保留。研究开始前，应通过启动会或研究者会议对所有参加研究的人员进行方案培训，使其充分理解和认识临床研究方案及其各指标具体内涵，掌握药物临床试验质量管理规范原则，统一记录方式与判断标准，并严格按照方案执行；培训应在该临床试验机构入选受试者之前进行。","rationale":"方案编号与版本来自当前项目已确认研究事实；监查、研究文件保留和方案培训采用适用于本方案的监管共性表述。医学作者需核对本项目监查计划、数据管理计划、研究文件清单和培训安排。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_6e4142d7822b_a610a66753cc5fa0","section_number":"12","source_ids":["protocol_full_draft_selection:93b7c83ceba59cc494eaf818","current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","company_corpus:cms_cn_protocol_corpus_20260715_v1:d84680fc442c0c","company_corpus:cms_cn_protocol_corpus_20260715_v1:ea3e32851b5d74","company_corpus:cms_cn_protocol_corpus_20260715_v1:69be796f1e42c8","company_corpus:cms_cn_protocol_corpus_20260715_v1:c63e43f68405d2"]},{"ai_run_id":"airun_20260922161001_5a65bb8c","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_6e4142d7822b_b209d029cdd23382:full-draft:93b7c83ceba59cc494eaf818","quote":"SECTION_ID=mwsec_greenfield_proj_user_6e4142d7822b_38cb98d9e8c202ce\n章节编号=12.1\n章节标题=研究方案的依从\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"4b8371ae5ded961ca87a35aa5b8209f3b29127c936fada2d17dc32f08c1c62cd