性对照模拟注射；对照组接受匹配口服安慰剂并皮下注射合成阳性对照C；两组继续稳定甲氨蝶呤，治疗24周。","quote_sha256":"73286896e9c328c422019082f13c0792bf3ff2b05054007e0aa0f8b9162a9f84","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_proj_intervention"},{"locator":"section:试验参与者知情同意书|block:906|chunk:1","quote":"知情同意书分为成年人、未成年人及监护人版本，经过伦理委员会的审批之后方可使用。","quote_sha256":"2acebffe2bcacc2b4c22948a73b66ff040ee70fcbe02b33a6a441bde4fe38204","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:42d49ba7a285ce","span_id":"span_corpus_icf_adult"},{"locator":"section:试验参与者知情同意书|block:908|chunk:1","quote":"知情同意书的任何修改需经所在临床研究医院伦理委员会批准后执行，未出组患者必须重新签署新版知情同意书。","quote_sha256":"bb9c04474a3b8ea11eb6af9fde69b3f838645f116f0588d9a5fe4887129d2a78","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:582cc728dae6fe","span_id":"span_corpus_icf_modify"},{"locator":"section:4.1.1 筛选期|block:677|chunk:1","quote":"知情同意并签署 ICF；","quote_sha256":"289780804af814a372538eb298054487fa0ba1d93be6500affa63d01db7a2b2b","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:fc98aacc7e06ca","span_id":"span_corpus_screening_icf"}],"evidence_span_ids":["span_sec_11_2_def","span_proj_population","span_proj_design","span_proj_intervention","span_corpus_icf_adult","span_corpus_icf_modify","span_corpus_screening_icf"],"evidence_summary":{"corpus_spans":3,"project_fact_spans":3},"gap_items":[{"action":"补充本项目知情同意书模板及版本文件","category":"source_missing","gap_id":"gap_icf_version","missing_source_classes":["知情同意书模板"],"target":"知情同意章节中知情同意书版本与适用人群"},{"action":"补充本项目知情同意签署与保存流程文件","category":"source_missing","gap_id":"gap_icf_signature","missing_source_classes":["知情同意签署流程文件"],"target":"知情同意章节中签署份数与保存方式"},{"action":"结合参考来源建议确认本项目是否要求未出组受试者重新签署新版知情同意书","category":"source_missing","gap_id":"gap_icf_reconsent","missing_source_classes":["知情同意修订后重新签署规则文件"],"target":"知情同意章节中修订后重新签署规则"}],"heading":"知情同意","missing_source_classes":["本项目知情同意书模板与版本文件","知情同意签署与保存流程文件","知情同意书修订后重新签署规则文件"],"proposal_text":"本研究受试人群为18–75岁活动性类风湿关节炎成人，知情同意过程应使用经伦理委员会批准的知情同意书，并在受试者参加研究前由研究者向其充分说明研究目的、研究设计、试验药物与对照药物、随机与双盲安排、访视计划、可能的风险与获益、替代治疗选择以及自愿参加和随时退出的权利。受试者应在理解上述信息后自愿签署知情同意书；对于不符合入选标准或不愿参加的个体，不得施加不当影响。知情同意书及其修订应经伦理委员会批准后使用。研究期间如获得可能影响受试者继续参加研究意愿的新信息，应及时告知受试者。","rationale":"正文依据当前项目18–75岁活动性类风湿关节炎成人人群、随机双盲双模拟设计及试验药与阳性对照设置，结合知情同意通用伦理要求写成。知情同意书具体版本、签署份数、保存方式、重新签署规则及未成年人或监护人版本是否适用等未在允许来源中明确，需医学经理确认；参考来源中关于未出组患者重新签署新版知情同意书的内容建议在确认后纳入。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_6e4142d7822b_c3949ab5c608f04a","section_number":"11.2","source_ids":["protocol_full_draft_selection:81db4dad422d49f83cd924b5","current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","company_corpus:cms_cn_protocol_corpus_20260715_v1:42d49ba7a285ce","company_corpus:cms_cn_protocol_corpus_20260715_v1:582cc728dae6fe","company_corpus:cms_cn_protocol_corpus_20260715_v1:c63e43f68405d2","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc98aacc7e06ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:3d4fa32554415b"]},{"ai_run_id":"airun_20260922160838_0a194fc4","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_6e4142d7822b_b209d029cdd23382:full-draft:81db4dad422d49f83cd924b5","quote":"SECTION_ID=mwsec_greenfield_proj_user_6e4142d7822b_d3a6f74b17856a84\n章节编号=11.3\n章节标题=伦理委员会\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"22a9891afba1cee83082ec7f11edf5c6233735dcdf1d85c618f1fe0b918fc644","source_id":"protocol_full_draft_selection:81db4dad422d49f83cd924b5","span_id":"span_sec_11_3_def"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"开发区域：中国","quote_sha256":"cff843d358ea50e7e53ede8d1eba9b9d23baa740d2cd2134679e6483c3e50b76","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_proj_region"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"研究分期：III期","quote_sha256":"5ac919b18530a35e6df200dbf04b4bc9fbd8d00da2c279aa58a1ff849584b451","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_proj_phase"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"总体研究设计：多中心、随机、双盲、双模拟、阳性对照、平行组、非劣效III期研究","quote_sha256":"a02da94ca30265ce95f8a5824ef17d9434a9934c5a46c4781ca73525f9620267","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_proj_design"},{"locator":"section:试验参与者知情同意书|block:906|chunk:1","quote":"知情同意书分为成年人、未成年人及监护人版本，经过伦理委员会的审批之后方可使用。","quote_sha256":"2acebffe2bcacc2b4c22948a73b66ff040ee70fcbe02b33a6a441bde4fe38204","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:42d49ba7a285ce","span_id":"span_corpus_icf_adult"},{"locator":"section:试验参与者知情同意书|block:908|chunk:1","quote":"知情同意书的任何修改需经所在临床研究医院伦理委员会批准后执行，未出组患者必须重新签署新版知情同意书。","quote_sha256":"bb9c04474a3b8ea11eb6af9fde69b3f838645f116f0588d9a5fe4887129d2a78","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:582cc728dae6fe","span_id":"span_corpus_icf_modify"}],"evidence_span_ids":["span_sec_11_3_def","span_proj_region","span_proj_phase","span_proj_design","span_corpus_icf_adult","span_corpus_icf_modify"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":3},"gap_items":[{"action":"补充本项目伦理审查申请、批准与跟踪审查流程文件","category":"source_missing","gap_id":"gap_ec_process","missing_source_classes":["伦理审查流程文件"],"target":"伦理委员会章节中审查与跟踪审查流程"},{"action":"确认未出组受试者重新签署新版知情同意书的要求后写入","category":"source_missing","gap_id":"gap_ec_reconsent","missing_source_classes":["知情同意修订与重新签署规则文件"],"target":"伦理委员会章节中修订知情同意书后的重新签署要求"}],"heading":"伦理委员会","missing_source_classes":["本项目伦理委员会审查与跟踪审查流程文件","伦理委员会备案文件","知情同意书修订后重新签署流程文件"],"proposal_text":"本研究为在中国开展的多中心III期临床研究，研究实施前应获得伦理委员会的审查批准，伦理委员会应对研究方案、知情同意书及其他相关文件进行审查。研究过程中，方案和知情同意书的任何修订应提交伦理委员会批准后执行。伦理委员会应独立履行审查职责，重点关注受试者权益、安全和健康，以及研究设计的科学性和伦理合理性。对于研究过程中出现的可能影响受试者安全或继续参加研究意愿的重要信息，应按伦理委员会要求进行报告或审查。","rationale":"正文依据当前项目在中国开展、为多中心III期研究，以及知情同意书需经伦理委员会审批、修订需经伦理委员会批准等通用伦理审查要求写成。关于伦理委员会具体名称、审查频次、跟踪审查流程、备案要求和未出组受试者重新签署新版知情同意书等实施细节，需医学经理确认后补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_6e4142d7822b_d3a6f74b17856a84","section_number":"11.3","source_ids":["protocol_full_draft_selection:81db4dad422d49f83cd924b5","current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","company_corpus:cms_cn_protocol_corpus_20260715_v1:42d49ba7a285ce","company_corpus:cms_cn_protocol_corpus_20260715_v1:582cc728dae6fe","company_corpus:cms_cn_protocol_corpus_20260715_v1:c63e43f68405d2","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc98aacc7e06ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:3d4fa32554415b"]}],"source_bindings":[{"content_sha256":"57136782dc4d7f7219d51f0d7e798e43ecc88e0eea1a14fa9fe8f45af8c7fa5d","locator":"document:mwdoc_greenfield_proj_user_6e4142d7822b_b209d029cdd23382:full-draft:81db4dad422d49f83cd924b5","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:81db4dad422d49f83cd924b5","source_type":"protocol_full_draft_selection","source_version":"full-draft:defc9b2a5fb939bebce57c9f1eb47eb7b7a5651124c6cd0f737697349c57cfb1:81db4dad422d49f83cd924b5","text_sha256":"57136782dc4d7f7219d51f0d7e798e43ecc88e0eea1a14fa9fe8f45af8c7fa5d"},{"content_sha256":"c5bf2d0afd5d40df8334c8e3453d30d7faf52e6f4d22546778d8bae4c48f8aba","locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","source_type":"current_project_study_definition","source_version":"mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","text_sha256":"c5bf2d0afd5d40df8334c8e3453d30d7faf52e6f4d22546778d8bae4c48f8aba"},{"content_sha256":"2acebffe2bcacc2b4c22948a73b66ff040ee70f