56":"0ab47e23258a396edd7543a2d919116227f680bc2be10f409cc7c3364fdcb677","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_proj_population"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"试验干预：试验组口服合成试验药B并接受阳性对照模拟注射；对照组接受匹配口服安慰剂并皮下注射合成阳性对照C；两组继续稳定甲氨蝶呤，治疗24周。","quote_sha256":"73286896e9c328c422019082f13c0792bf3ff2b05054007e0aa0f8b9162a9f84","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_proj_intervention"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"特别关注的不良事件：严重感染和机会性感染。","quote_sha256":"6302f18a206c03dd2ae646047c50b7523046872adfc22232db7036d4fe2c60dd","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_proj_safety"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"安全性终点：TEAE、SAE及导致停药的不良事件发生率。；实验室检查、生命体征和心电图具有临床意义的变化。","quote_sha256":"b7b07260763ae74db57a2516bf63ca4452202b7f5fee51482cc73ab6c3900d25","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_proj_safety_endpoints"},{"locator":"study_definition:mwdefinition_ace846adc197b5363d2e:revision:4","quote":"必需背景治疗：甲氨蝶呤维持入组前稳定剂量，除安全性需要外治疗期不调整。（策略=allowed_if_stable）","quote_sha256":"1a80fcd1acfd6e2931cc113c092344ef969cd59856f3206e4eee09953627a413","source_id":"current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","span_id":"span_proj_mtx"}],"evidence_span_ids":["span_sec_11_def","span_proj_design","span_proj_population","span_proj_intervention","span_proj_safety","span_proj_safety_endpoints","span_proj_mtx"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"补充本项目受试者补偿、保险及损伤处理相关文件后写入","category":"source_missing","gap_id":"gap_ethics_compensation","missing_source_classes":["受试者补偿文件","保险文件"],"target":"伦理考虑章节中受试者补偿与保险安排"},{"action":"补充本项目伦理跟踪审查计划或相关职能确认","category":"source_missing","gap_id":"gap_ethics_review_frequency","missing_source_classes":["伦理跟踪审查计划"],"target":"伦理考虑章节中跟踪审查安排"},{"action":"补充紧急揭盲程序文件后写入","category":"source_missing","gap_id":"gap_ethics_unblinding","missing_source_classes":["紧急揭盲程序文件"],"target":"伦理考虑章节中紧急揭盲相关伦理保障"}],"heading":"伦理考虑","missing_source_classes":["本项目伦理审查申请与跟踪审查文件","受试者补偿与保险文件","紧急揭盲程序文件"],"proposal_text":"本研究为在中国开展的多中心、随机、双盲、双模拟、阳性对照III期非劣效临床研究，受试人群为18–75岁、稳定甲氨蝶呤治疗后仍为中高疾病活动度的活动性类风湿关节炎成人。伦理考虑应以保障受试者权益、安全和健康为首要原则，在研究实施前获得伦理委员会批准并取得受试者知情同意。研究采用双盲双模拟设计，试验组接受口服合成试验药B并接受阳性对照模拟注射，对照组接受匹配口服安慰剂并皮下注射合成阳性对照C，两组继续稳定甲氨蝶呤治疗。由于研究涉及阳性对照和免疫相关安全性风险，伦理审查应关注严重感染和机会性感染等特别关注的不良事件，并结合方案规定的安全性终点进行风险监测。受试者参加研究应基于自愿，且不应因参加研究而影响其获得常规医疗的权利。","rationale":"正文依据当前项目已确认的III期多中心随机双盲双模拟阳性对照非劣效设计、18–75岁活动性类风湿关节炎成人人群、试验干预与对照设置、特别关注的不良事件及安全性终点写成。受试者补偿、保险、伦理审查频次、紧急揭盲程序等未在允许来源中给出，需医学经理确认后补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_6e4142d7822b_2b3e9345a7d7a592","section_number":"11","source_ids":["protocol_full_draft_selection:81db4dad422d49f83cd924b5","current_project_study_definition:mwdefinition_ace846adc197b5363d2e:r4:20fc48105f14cc3c","company_corpus:cms_cn_protocol_corpus_20260715_v1:42d49ba7a285ce","company_corpus:cms_cn_protocol_corpus_20260715_v1:582cc728dae6fe","company_corpus:cms_cn_protocol_corpus_20260715_v1:c63e43f68405d2","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc98aacc7e06ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:3d4fa32554415b"]},{"ai_run_id":"airun_20260922160838_0a194fc4","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_6e4142d7822b_b209d029cdd23382:full-draft:81db4dad422d49f83cd924b5","quote":"SECTION_ID=mwsec_greenfield_proj_user_6e4142d7822b_7fe99fabea48216c\n章节编号=11.1\n章节标题=遵守法律法规\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"99f2ccc5ac3088ebd28b72a92f8b43c725aca50d