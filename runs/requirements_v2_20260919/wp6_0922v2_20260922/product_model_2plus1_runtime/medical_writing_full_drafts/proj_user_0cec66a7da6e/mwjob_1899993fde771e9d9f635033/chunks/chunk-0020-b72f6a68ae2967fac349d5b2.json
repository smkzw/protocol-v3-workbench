d52e482eea1f8ff37b51605465","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8","span_id":"corpus_dev_1"}],"evidence_span_ids":["sec_12_3","sd_design","sd_region","corpus_dev_1"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":2},"gap_items":[{"action":"补充当前项目质量保证或稽查核查文件后细化","category":"source_missing","gap_id":"gap_12_3_audit_inspection_details","missing_source_classes":["当前项目质量保证计划","稽查核查SOP"],"target":"12.3 稽查核查计划、通知方式、执行角色和纠正预防措施时限"}],"heading":"稽查和核查","missing_source_classes":["当前项目质量保证计划","稽查核查SOP"],"proposal_text":"本研究的稽查和核查适用于研究中心执行经批准方案、保护受试者权益、记录源数据和安全性信息的相关活动。稽查和核查应依据中国药物临床试验质量管理规范及适用监管要求开展，覆盖研究实施记录、源文件、病例报告表及试验用药品管理记录。研究中心应配合稽查或核查并提供原始记录和必要说明。","rationale":"项目背景依据当前项目已确认研究设计事实；稽查核查范围采用监管共性表述。具体计划、通知、执行角色和纠正预防措施时限缺少当前项目质量保证文件，需医学经理核对。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_0cec66a7da6e_4eeaab4d5bca92fe","section_number":"12.3","source_ids":["protocol_full_draft_selection:b72f6a68ae2967fac349d5b2","current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8","company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20260922165941_47aca82d","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_0cec66a7da6e_92dc32ead2551dda:full-draft:b72f6a68ae2967fac349d5b2","quote":"SECTION_ID=mwsec_greenfield_proj_user_0cec66a7da6e_47f59697fd67775d\n章节编号=12.4\n章节标题=方案偏离","quote_sha256":"9d31e8e50c5ca0b46fb10c27082f61b2fe3bb4dc9a388bfa48c7018841aed1d9","source_id":"protocol_full_draft_selection:b72f6a68ae2967fac349d5b2","span_id":"sec_12_4"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"总体研究设计：多中心、随机、双盲、安慰剂对照、平行组、II期优效研究","quote_sha256":"6d0f4351b6ea60b47cbb29943f4965260aff1f9aa51fa468ba36554768261150","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"sd_design"},{"locator":"section:12.2 方案偏离|block:950|chunk:1","quote":"研究方案中规定的所有要求，必须严格执行。任何有意或无意偏离或违背研究方案和GCP原则的行为，均视为偏离方案或违背方案。监查员在监查过程中，如果发现偏离或违背方案，应由研究者或监查员填写偏离方案记录，详细记录事件发生的时间及过程、原因及相应的处理措施，由研究者签字，并根据研究中心相关规定通报伦理委员会及申办者。其中，所有可能严重违背方案的情况都必须马上报给申办者。当发生重大方案违背时，应由研究者和申办者进行评估。必要时，申办者可以提前终止本研究。","quote_sha256":"4ad13e82fb4d9748aa0fff1e399c95e53a8a8dd52e482eea1f8ff37b51605465","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8","span_id":"corpus_dev_1"},{"locator":"section:12.2 方案偏离|block:952|chunk:1","quote":"申办者将审查所有方案偏离，并评估是否有严重违背GCP，以及是否要求向卫生主管部门报告。根据申办者的要求或SOP，偏离方案的前瞻性请求，包括放弃方案合格性标准的请求将不会被允许。","quote_sha256":"643056aa94c1285201b5f63d6801971893fb90935354b44c77e0839ffc32b390","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","span_id":"corpus_dev_2"}],"evidence_span_ids":["sec_12_4","sd_design","corpus_dev_1","corpus_dev_2"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":1},"gap_items":[{"action":"补充当前项目方案偏离管理SOP和监查计划后细化","category":"source_missing","gap_id":"gap_12_4_deviation_rules","missing_source_classes":["当前项目方案偏离管理SOP","监查计划"],"target":"12.4 方案偏离记录表单、报告对象与时限、前瞻性请求处理、合格性标准豁免规则"}],"heading":"方案偏离","missing_source_classes":["当前项目方案偏离管理SOP","监查计划"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂对照II期研究，方案偏离管理应遵循经批准的方案、中国药物临床试验质量管理规范及适用法规。方案偏离包括任何有意或无意偏离经批准方案或GCP要求的行为。所有偏离均应被记录、评估和跟踪，可能构成严重违背GCP的情况应按方案偏离管理流程评估。方案偏离的记录、报告和后续处理应与研究质量管理和受试者权益保护要求一致。","rationale":"项目背景依据当前项目已确认研究设计事实；方案偏离一般原则参考可用的监管共性表述。记录表单、报告对象、时限、前瞻性请求和合格性标准豁免规则缺少当前项目SOP，需医学经理核对。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_0cec66a7da6e_47f59697fd67775d","section_number":"12.4","source_ids":["protocol_full_draft_s