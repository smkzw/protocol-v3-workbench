43","span_id":"ES_015"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"盲法实施：匹配安慰剂维持盲态","quote_sha256":"daa0fbc09b1745a58947b1b458cc99860882af072e341d5d34bb79cb6723f052","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"ES_016"}],"evidence_span_ids":["ES_002","ES_003","ES_004","ES_006","ES_007","ES_008","ES_009","ES_010","ES_015","ES_016"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":10},"gap_items":[{"action":"补充项目级停药标准文件并核对","category":"source_missing","gap_id":"gap_sec6_stop_criteria","missing_source_classes":["项目级停药标准文件"],"target":"6研究治疗/干预中因安全性暂停或永久停药的判断标准"},{"action":"补充合并用药管理文件并核对","category":"source_missing","gap_id":"gap_sec6_rescue_scope","missing_source_classes":["合并用药管理文件"],"target":"6研究治疗/干预中短期失眠对症用药的具体药物范围、剂量上限和持续时间"}],"heading":"研究治疗/干预","missing_source_classes":["项目级停药标准文件","合并用药管理文件"],"proposal_text":"本研究在既有稳定SSRI治疗基础上开展辅助治疗。试验组受试者口服合成试验药C胶囊，给药剂量为20 mg，每晚一次，双盲治疗8周；对照组受试者口服匹配安慰剂，每晚一次，双盲治疗8周。匹配安慰剂用于维持双盲条件。双盲辅助治疗期间，既有SSRI应维持稳定剂量。允许使用方案规定范围内的短期失眠对症用药；双盲期禁止新增其他抗抑郁药、抗精神病药或系统性心理治疗。本研究不设置计划性剂量调整；若因安全性需要暂停或永久停用研究药物，按本研究方案预设的停药标准执行。双盲辅助治疗期结束后进入2周安全性随访期。","rationale":"依据已确认研究事实：试验组为合成试验药C 20 mg每晚一次口服8周，对照组为匹配安慰剂每晚一次口服8周，背景SSRI在双盲期维持稳定剂量，合并用药限制明确，不设置计划性剂量调整。医学作者需核对因安全性暂停或永久停药的具体标准，以及短期失眠对症用药的具体范围。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_0cec66a7da6e_6e11a3314e6fe4e2","section_number":"6","source_ids":["protocol_full_draft_selection:1c1909102a9ed2e412feb101","current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc6f8c9ea6d34b","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:e35a8dbd3c7941"]},{"ai_ru