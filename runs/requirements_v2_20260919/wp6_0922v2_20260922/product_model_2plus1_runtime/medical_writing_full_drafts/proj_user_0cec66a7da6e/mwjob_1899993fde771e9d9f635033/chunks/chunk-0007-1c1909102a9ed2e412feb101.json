_003","ES_004","ES_010","ES_013","ES_016"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[],"heading":"试验用药品","missing_source_classes":[],"proposal_text":"本研究的试验用药品为合成试验药C胶囊，活性成分为合成试验药C，给药剂量为20 mg，口服，每晚一次，连续给药8周。对照组使用合成试验药C匹配安慰剂，剂型同为胶囊，口服，每晚一次，连续给药8周，以维持双盲条件。试验药与匹配安慰剂均在既有稳定SSRI治疗基础上辅助给药。研究期间不对研究药物进行计划性剂量调整；因安全性原因需要暂停或永久停用时，按本研究方案预设的停药标准执行。","rationale":"依据已确认研究事实：合成试验药C胶囊20 mg每晚一次口服8周，匹配安慰剂每晚一次口服8周，二者均在稳定SSRI背景治疗上辅助使用，且不设置计划性剂量调整。医学作者需核对试验用药品规格、批号及盲态包装细节是否在本章节进一步展开。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_0cec66a7da6e_d8d252a67c742728","section_number":"6.1","source_ids":["protocol_full_draft_selection:1c1909102a9ed2e412feb101","current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc6f8c9ea6d34b","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:e35a8dbd3c7941"]},{"ai_run_id":"airun_20260922163727_9307ccf5","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"试验药物：合成试验药C","quote_sha256":"50e705bf02697402cde25299dd977a6c6ee9822254f6edd73f411eb5390aa35e","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"ES_002"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"剂量与给药方案：合成试验药C：20 mg，每晚一次（口服）；8周","quote_sha256":"7bd6dc9108e3a9dafae21edce33fd2dcc46428233b5d8a65b9923bdfa42de3e4","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"ES_003"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"合成试验药C匹配安慰剂：每晚一次（口服）；8周","quote_sha256":"8a1f38edc19474ee1f5abce30c0feb3ce79cf03b5a66df45ec29ad8b370820ab","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"ES_004"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"药物技术类型：small_molecule","quote_sha256":"d8ca21a7e62cbca0e65228c7147e2ce5e59273b60f0d0cc55ed216f48e27710c","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"ES_011"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"给药途径：口服","quote_sha256":"404b058b755608a73d13b54521a28c02b129df449774d0671b1c3f8b8a5ce42c","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"ES_012"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"剂型：胶囊","quote_sha256":"8b542df19e1d5c934b975b6d38738e793819482c0236def9c39074419b9a74a4","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"ES_013"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"靶点/作用机制：合成中枢机制C调节剂（仅用于隔离验收）","quote_sha256":"7501d8970a178b03216ac51b9743a023fa782ced41f62916c2619121bf2a5a63","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"ES_014"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"适应症：当前抗抑郁治疗应答不足的重度抑郁障碍","quote_sha256":"f4525d3bf7c78d16ae1793432d81944aa11032e911e8c6f52d8c7a776782c09f","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"ES_018"}],"evidence_span_ids":["ES_002","ES_003","ES_004","ES_011","ES_012","ES_013","ES_014","ES_018"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":8},"gap_items":[],"heading":"研究药物信息","missing_source_classes":[],"proposal_text":"合成试验药C为小分子药物，剂型为胶囊，经口服途径给药，具有全身暴露特征，其作用机制为中枢机制调节。本研究中的给药方案为合成试验药C 20 mg，每晚一次，连续8周。匹配安慰剂为与合成试验药C匹配的安慰剂制剂，剂型为胶囊，口服，每晚一次，连续8周。试验药和匹配安慰剂均在受试者既有稳定SSRI治疗基础上辅助使用。研究药物用于评价合成试验药C辅助治疗当前抗抑郁治疗应答不足的重度抑郁障碍的疗效与安全性。","rationale":"依据已确认研究事实：合成试验药C为小分子、胶囊、口服、20 mg每晚一次、连续8周；匹配安慰剂同剂型同频次；适应症为当前抗抑郁治疗应答不足的重度抑郁障碍。作用机制仅可概括为中枢机制调节，隔离验收标记不进入正文。医学作者需核对机制表述和剂量表述。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_0cec66a7da6e_f5b1ce0d4ed7859d","section_number":"6.1.1","source_ids":["protocol_full_draft_selection:1c1909102a9ed2e412feb101","current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc6f8c9ea6d34b","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:e35a8dbd3c7941"]},{"ai_run_id":"airun_20260922163727_9307ccf5","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"补充试验用药品制备工艺文件并核对","category":"source_missing","gap_id":"gap_sec6_1_2_manufacturing","missing_source_classes":["试验用药品制备工艺文件"],"target":"6.1.2制备工艺与生产信息"},{"action":"补充包装与标签样稿并核对","category":"source_missing","gap_id":"gap_sec6_1_2_packaging","missing_source_classes":["包装与标签样稿"],"target":"6.1.2包装与标签"},{"action":"补充储存条件与稳定性资料并核对","category":"source_missing","gap_id":"gap_sec6_1_2_storage","missing_source_classes":["储存条件与稳定性资料"],"target":"6.1.2储存条件与稳定性"},{"action":"补充试验用药品发放回收管理规程并核对","category":"source_missing","gap_id":"gap_sec6_1_2_dispensing","missing_source_classes":["试验用药品发放回收管理规程"],"target":"6.1.2发放、回收与计数管理"},{"action":"补充盲态包装与紧急揭盲操作文件并核对","category":"source_missing","gap_id":"gap_sec6_1_2_blinding","missing_source_classes":["盲态包装与紧急揭盲操作文件"],"target":"6.1.2盲态包装与紧急揭盲操作"}],"heading":"制备、包装、标签、储存与管理","missing_source_classes":["试验用药品制备工艺文件","包装与标签样稿","储存条件与稳定性资料","试验用药品发放回收管理规程"],"proposal_text":"","rationale":"该章节所需试验用药品制备工艺、包装与标签样稿、储存条件、稳定性、发放回收与管理规程未在允许来源中提供，无法形成有直接证据支持的实质正文。医学作者需补充相应项目文件后再行撰写。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_0cec66a7da6e_d3dd8c30daba2ba9","section_number":"6.1.2","source_ids":["protocol_full_draft_selection:1c1909102a9ed2e412feb101","current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc6f8c9ea6d34b","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:e35a8dbd3c7941"]}],"source_bindings":[{"content_sha256":"b4604f4cbb6d8481934bf05552dda703c69cbb37e9cee4b3a12e749d58642e51","locator":"document:mwdoc_greenfield_proj_user_0cec66a7da6e_92dc32ead2551dda:full-draft:1c1909102a9ed2e412feb101","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:1c1909102a9ed2e412feb101","source_type":"protocol_full_draft_selection","source_version":"full-draft:c315238e8975745fc5500ae52859c14372253487b00aa4718f4224a279fcb0b5:1c1909102a9ed2e412feb101","text_sha256":"b4604f4cbb6d8481934bf05552dda703c69cbb37e9cee4b3a12e749d58642e51"},{"content_sha256":"844b3acb36f874917fb1ab2400816e3caff7f00a41b34d1a674f95d57696b803","locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","source_type":"current_project_study_definition","source_version":"mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","text_sha256":"844b3acb36f874917fb1ab2400816e3caff7f00a41b34d1a674f95d57696b803"},{"content_sha256":"33118fc6958419e645c6a0a19471c78f80e0c4c2