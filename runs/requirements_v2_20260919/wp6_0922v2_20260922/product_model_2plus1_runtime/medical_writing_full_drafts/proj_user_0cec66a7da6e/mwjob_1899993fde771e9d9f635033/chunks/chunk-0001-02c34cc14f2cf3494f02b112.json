6ef856f1b","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_sd_23"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"主要终点：第8周MADRS总分较基线变化。","quote_sha256":"7d24fedbdedcfe8cc33346a0687eeeaf0a92a196d921655654ce68ade2fb9d37","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_sd_24"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"关键次要终点：第8周MADRS应答率（总分较基线下降≥50%）。；第8周MADRS缓解率（总分≤10）。","quote_sha256":"c6b07ab8e97508acf8ec3e6df0d7827dd61d340dc7bfa81ac3fd76b39029f057","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_sd_25"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"其他次要终点：第8周SDS总分较基线变化。","quote_sha256":"5a098b4797e365e6b6c64280d863fe530402cee78289ce94f806735bff9bc5bc","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_sd_26"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"安全性终点：TEAE、SAE及导致停药的不良事件发生率。；C-SSRS自杀意念与行为评价及生命体征、实验室检查、心电图变化。","quote_sha256":"7fb7bdebd2adfade50a1cdec22f0c156522f0e83018fbf487ed008f708521362","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_sd_27"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"研究时期：筛选期2周。；双盲辅助治疗期8周。；安全性随访期2周。","quote_sha256":"87c6ae78b837bbf27786723128a08feb35bd15499a888d7ac73a66eb0e095c2d","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_sd_28"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"访视策略：筛选、基线及第1、2、4、6、8周访视，第10周安全性随访；MADRS由经培训且尽量保持同一的盲态评估者完成。","quote_sha256":"a5f71518e97723c4337a87f2fdb48f3243d0e56402965a4994070ccbe8182973","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_sd_29"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"样本量策略：假设组间MADRS变化差异为3分、标准差8分、双侧α=0.05、把握度90%、1:1随机并考虑15%失访，计划约170例；合成参数仅用于功能验收。","quote_sha256":"4cb86724706b86fefa4b2d8c1103f5898bb8306adf9c285c818b89230bafa237","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_sd_30"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"统计分析策略：主要终点采用MMRM，固定效应包括治疗组、访视、治疗组×访视、中心及基线MADRS，报告第8周最小二乘均值差、95%置信区间和双侧P值，以优效性为目标。不开展期中分析；安全性集按实际治疗分析。","quote_sha256":"356a405be343840d33b7adf7aabf02ee4ec71e29b6461a7d8ea1278d46458781","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_sd_32"}],"evidence_span_ids":["span_sd_1","span_sd_2","span_sd_3","span_sd_4","span_sd_5","span_sd_6","span_sd_9","span_sd_10","span_sd_11","span_sd_12","span_sd_13","span_sd_14","span_sd_15","span_sd_19","span_sd_22","span_sd_23","span_sd_24","span_sd_25","span_sd_26","span_sd_27","span_sd_28","span_sd_29","span_sd_30","span_sd_32"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":24},"gap_items":[],"heading":"方案概要","missing_source_classes":[],"proposal_text":"本研究是一项在中国开展的多中心、随机、双盲、安慰剂对照、平行组II期优效研究，方案编号为WP6-MDD-BLIND-C，方案版本为V0.1。研究题目为合成试验药C辅助治疗当前抗抑郁治疗应答不足的重度抑郁障碍随机双盲安慰剂对照II期研究方案。试验药物为合成试验药C，适应症为当前抗抑郁治疗应答不足的重度抑郁障碍。目标研究人群为18–65岁重度抑郁障碍成人，在稳定SSRI治疗下当前发作应答不足。试验组在既有稳定SSRI治疗基础上口服合成试验药C 20 mg，每晚一次，对照组口服匹配安慰剂，每晚一次，双盲辅助治疗期为8周。计划约170例受试者按1:1随机分配。主要研究目的为评价合成试验药C辅助治疗较安慰剂辅助治疗改善抑郁症状的优效性；次要研究目的为评价临床应答、缓解及功能改善。主要终点为第8周MADRS总分较基线变化。关键次要终点包括第8周MADRS应答率（总分较基线下降≥50%）和第8周MADRS缓解率（总分≤10）；其他次要终点为第8周SDS总分较基线变化。安全性终点包括TEAE、SAE及导致停药的不良事件发生率，以及C-SSRS自杀意念与行为评价及生命体征、实验室检查、心电图变化。研究时期包括筛选期2周、双盲辅助治疗期8周和安全性随访期2周；访视包括筛选、基线及第1、2、4、6、8周访视，第10周安全性随访。主要分析采用MMRM，报告第8周最小二乘均值差、95%置信区间和双侧P值，以优效性为目标。","rationale":"方案概要依据已确认的研究题目、分期、设计、人群、随机与盲法、给药方案、终点、样本量和访视策略撰写；医学作者需核对版本、终点定义与统计分析表述。","review_advisories":["本节复述高影响研究设计（方案概要）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_0cec66a7da6e_38aa2e30f51c45b4","section_number":"1","source_ids":["protocol_full_draft_selection:02c34cc14f2cf3494f02b112","current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc6f8c9ea6d34b","company_corpus:cms_cn_protocol_corpus_20260715_v1:e35a8dbd3c7941"]},{"ai_run_id":"airun_20260922162934_4f6ae222","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"补充重度抑郁障碍流行病学、疾病负担、临床指南及当前抗抑郁治疗应答不足治疗现状来源后撰写实质正文","category":"source_missing","gap_id":"gap_mwsec_2_1_disease_background","missing_source_classes":["重度抑郁障碍流行病学来源","疾病负担来源","临床指南或治疗现状来源"],"target":"2.1 疾病背景及治疗现状正文"}],"heading":"疾病背景及治疗现状","missing_source_classes":["重度抑郁障碍流行病学来源","疾病负担来源","临床指南或治疗现状来源"],"proposal_text":"","rationale":"现有允许来源未提供重度抑郁障碍流行病学、疾病负担、临床指南或当前治疗现状资料，仅可确认适应症名称，无法形成实质背景正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_0cec66a7da6e_2936922069809ccf","section_number":"2.1","source_ids":["protocol_full_draft_selection:02c34cc14f2cf3494f02b112","current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1: