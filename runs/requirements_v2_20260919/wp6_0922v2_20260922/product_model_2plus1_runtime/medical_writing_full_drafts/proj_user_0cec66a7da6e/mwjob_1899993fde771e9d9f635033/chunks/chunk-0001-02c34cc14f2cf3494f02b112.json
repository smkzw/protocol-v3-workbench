0eb340d3449f6848cfa7839ce29567cdf064d2959435c79bbf556","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_sd_36"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"禁止的合并治疗：双盲期禁止新增其他抗抑郁药、抗精神病药或系统性心理治疗。（策略=prohibited）","quote_sha256":"04017e19fc612566b954493ac818e58202eb14c43c585255f5e98238e8c640cb","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_sd_37"}],"evidence_span_ids":["span_pfd_6","span_pfd_7","span_sd_4","span_sd_16","span_sd_17","span_sd_18","span_sd_19","span_sd_20","span_sd_21","span_sd_35","span_sd_36","span_sd_37"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":10},"gap_items":[{"action":"获取研究药物具体风险来源后补充风险相关描述","category":"source_missing","gap_id":"gap_mwsec_2_3_drug_risk","missing_source_classes":["研究药物具体风险来源","研究药物既往临床资料"],"target":"2.3 研究药物简介中的具体风险信息"}],"heading":"研究药物简介","missing_source_classes":["研究药物具体风险来源","研究药物既往临床资料"],"proposal_text":"合成试验药C是一种小分子药物，剂型为胶囊，经口服途径给药。在双盲辅助治疗期内，试验组受试者在既有稳定SSRI治疗基础上口服合成试验药C 20 mg，每晚一次，持续8周；对照组口服匹配安慰剂，每晚一次，持续8周。本研究不设置计划性剂量调整；因安全性需要的暂停或永久停药按方案停药标准处理。双盲期允许的合并治疗包括方案规定范围内的短期失眠对症用药，既有SSRI需维持稳定剂量；双盲期禁止新增其他抗抑郁药、抗精神病药或系统性心理治疗。","rationale":"研究药物简介依据已确认的试验药物名称、技术类型、剂型、给药途径、剂量、频率、疗程及剂量调整原则撰写；医学作者需核对停药标准是否需要在本章节引用。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_0cec66a7da6e_6232910b5176ffd3","section_number":"2.3","source_ids":["protocol_full_draft_selection:02c34cc14f2cf3494f02b112","current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc6f8c9ea6d34b","company_corpus:cms_cn_protocol_corpus_20260715_v1:e35a8d