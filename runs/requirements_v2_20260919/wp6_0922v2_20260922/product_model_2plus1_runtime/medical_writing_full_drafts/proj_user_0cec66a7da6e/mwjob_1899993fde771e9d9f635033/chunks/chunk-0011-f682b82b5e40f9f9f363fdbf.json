ction_id":"mwsec_greenfield_proj_user_0cec66a7da6e_4e3194094bb95255","section_number":"7.1.4","source_ids":["protocol_full_draft_selection:f682b82b5e40f9f9f363fdbf","current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043"]},{"ai_run_id":"airun_20260922164229_ba2248a4","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"主要终点：第8周MADRS总分较基线变化。","quote_sha256":"7d24fedbdedcfe8cc33346a0687eeeaf0a92a196d921655654ce68ade2fb9d37","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_def_main_endpoint"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"关键次要终点：第8周MADRS应答率（总分较基线下降≥50%）。；第8周MADRS缓解率（总分≤10）。","quote_sha256":"c6b07ab8e97508acf8ec3e6df0d7827dd61d340dc7bfa81ac3fd76b39029f057","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_def_key_secondary"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"其他次要终点：第8周SDS总分较基线变化。","quote_sha256":"5a098b4797e365e6b6c64280d863fe530402cee78289ce94f806735bff9bc5bc","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_def_other_secondary"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"访视策略：筛选、基线及第1、2、4、6、8周访视，第10周安全性随访；MADRS由经培训且尽量保持同一的盲态评估者完成。","quote_sha256":"a5f71518e97723c4337a87f2fdb48f3243d0e56402965a4994070ccbe8182973","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_def_visits"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"统计分析策略：主要终点采用MMRM，固定效应包括治疗组、访视、治疗组×访视、中心及基线MADRS，报告第8周最小二乘均值差、95%置信区间和双侧P值，以优效性为目标。不开展期中分析；安全性集按实际治疗分析。","quote_sha256":"356a405be343840d33b7adf7aabf02ee4ec71e29b6461a7d8ea1278d46458781","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_def_analysis"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"估计目标策略：主要估计目标比较所有随机试验参与者第8周MADRS变化；停用随机治疗或启动禁止的抗抑郁救援治疗按治疗策略处理，使用基于重复测量模型的直接似然估计，并进行跳转参考多重插补敏感性分析。","quote_sha256":"3cff63524d470b353f0d5c2dbeb19fe1a8641d2482aeb9a32596d99164f2b9ef","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_def_estimand"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"主要研究目的：评价合成试验药C辅助治疗较安慰剂辅助治疗改善抑郁症状的优效性。","quote_sha256":"95a490769acb4034e3b8c7ead8640d4be2bf8945709cddd1ef5667ee96d7928a","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_def_primary_objective"}],"evidence_span_ids":["span_def_main_endpoint","span_def_key_secondary","span_def_other_secondary","span_def_visits","span_def_analysis","span_def_estimand","span_def_primary_objective"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":7},"gap_items":[{"action":"检索并核对MADRS和SDS量表版本、授权文件及评估者培训记录，在方案相应位置补充量表管理细节。","category":"source_not_retrieved","gap_id":"gap_7_2_scale_management","missing_source_classes":["MADRS/SDS量表版本、授权与培训记录（项目文件）"],"target":"7.2 有效性评估"}],"heading":"有效性评估","missing_source_classes":["MADRS/SDS量表版本、授权与培训记录（项目文件）"],"proposal_text":"本研究的主要有效性目的是评价合成试验药C辅助治疗较安慰剂辅助治疗改善抑郁症状的优效性。主要疗效终点为第8周MADRS总分较基线变化。关键次要疗效终点包括第8周MADRS应答率，定义为MADRS总分较基线下降≥50%，以及第8周MADRS缓解率，定义为MADRS总分≤10。其他次要疗效终点为第8周SDS总分较基线变化。MADRS由经培训且尽量保持同一的盲态评估者完成。主要疗效分析采用MMRM，固定效应包括治疗组、访视、治疗组×访视、中心及基线MADRS，报告第8周最小二乘均值差、95%置信区间和双侧P值，以优效性为目标。主要估计目标比较所有随机试验参与者第8周MADRS变化；停用随机治疗或启动禁止的抗抑郁救援治疗按治疗策略处理，使用基于重复测量模型的直接似然估计，并进行跳转参考多重插补敏感性分析。本研究不开展期中分析。","rationale":"已确认研究事实支持主要终点为第8周MADRS总分较基线变化，关键次要终点为第8周MADRS应答率和缓解率，其他次要终点为第8周SDS总分较基线变化；MADRS由经培训且尽量保持同一的盲态评估者完成。主要分析为MMRM，报告第8周最小二乘均值差、95%置信区间和双侧P值，估计目标按治疗策略处理并包含跳转参考多重插补敏感性分析。医学作者需核对量表版本、授权和培训记录。","review_advisories":["本节提及高影响设计信息（估计目标、期中分析）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_0cec66a7da6e_b16b72d176d45d56","section_number":"7.2","source_ids":["protocol_full_draft_selection:f682b82b5e40f9f9f363fdbf","current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043"]},{"ai_run_id":"airun_20260922164229_ba2248a4","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"安全性终点：TEAE、SAE及导致停药的不良事件发生率。；C-SSRS自杀意念与行为评价及生命体征、实验室检查、心电图变化。","quote_sha256":"7fb7bdebd2adfade50a1cdec22f0c156522f0e83018fbf487ed008f708521362","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_def_safety_endpoints"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"特别关注的不良事件：自杀意念或行为。","quote_sha256":"3a4e6509ee0b38269bb7622d85040be93d8adb26065fb350aacad90684e56c93","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_def_special_ae"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"研究时期：筛选期2周。；双盲辅助治疗期8周。；安全性随访期2周。","quote_sha256":"87c6ae78b837bbf27786723128a08feb35bd15499a888d7ac73a66eb0e095c2d","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_def_periods"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"访视策略：筛选、基线及第1、2、4、6、8周访视，第10周安全性随访；MADRS由经培训且尽量保持同一的盲态评估者完成。","quote_sha256":"a5f71518e97723c4337a87f2fdb48f3243d0e56402965a4994070ccbe8182973","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_def_visits"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"统计分析策略：主要终点采用MMRM，固定效应包括治疗组、访视、治疗组×访视、中心及基线MADRS，报告第8周最小二乘均值差、95%置信区间和双侧P值，以优效性为目标。不开展期中分析；安全性集按实际治疗分析。","quote_sha256":"356a405be343840d33b7adf7aabf02ee4ec71e29b6461a7d8ea1278d46458781","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_def_analysis"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"剂量调整：不设置计划性剂量调整；因安全性需要的暂停或永久停药按方案停药标准处理。","quote_sha256":"c5ee70f45469d0d4ef33855964e6b4348b784a0b2ab5c9011697efc45f910309","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_def_dose_adjust"}],"evidence_span_ids":["span_def_safety_endpoints","span_def_special_ae","span_def_periods","span_def_visits","span_def_analysis","span_def_dose_adjust"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"获取并核对项目安全性报告文件中的AE、SAE、SUSAR定义、采集要求、报告对象与时限，补充本章及安全性报告章节。","category":"source_missing","gap_id":"gap_7_3_ae_reporting","missing_source_classes":["AE/SAE/SUSAR定义与报告流程（项目安全性报告文件）"],"target":"7.3 安全性评估"},{"action":"获取实验室检查、心电图和C-SSRS的采集时点、操作规范与异常判定标准，补充安全性评估程序。","category":"source_missing","gap_id":"gap_7_3_lab_ecg_cssrs","missing_source_classes":["实验室检查、心电图和C-SSRS采集时点与操作规范（项目方案安全性评估文件）"],"target":"7.3 安全性评估"}],"heading":"安全性评估","missing_source_classes":["AE/SAE/SUSAR定义与报告流程（项目安全性报告文件）","实验室检查、心电图和C-SSRS采集时点与操作规范（项目方案安全性评估文件）"],"proposal_text":"本研究的安全性目的是评价合成试验药C辅助治疗的安全性与耐受性。安全性终点包括TEAE、SAE及导致停药的不良事件发生率，以及C-SSRS自杀意念与行为评价及生命体征、实验室检查、心电图变化。特别关注的不良事件为自杀意念或行为。研究时期包括筛选期2周、双盲辅助治疗期8周和安全性随访期2周；访视安排为筛选、基线及第1、2、4、6、8周访视，第10周进行安全性随访。安全性分析按实际接受的治疗进行。双盲辅助治疗期不设置计划性剂量调整；因安全性需要的暂停或永久停药按方案停药标准处理。","rationale":"已确认研究事实支持安全性终点包括TEAE、SAE及导致停药的不良事件发生率，C-SSRS、生命体征、实验室检查和心电图变化，特别关注不良事件为自杀意念或行为；研究时期和访视安排明确筛选期2周、双盲辅助治疗期8周、安全性随访期2周，第10周为安全性随访。医学作者需补充AE/SAE/SUSAR定义与报告流程、实验室检查和心电图采集时点及异常判定标准后定稿。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_0cec66a7da6e_1b87941489b7396d","section_number":"7.3",