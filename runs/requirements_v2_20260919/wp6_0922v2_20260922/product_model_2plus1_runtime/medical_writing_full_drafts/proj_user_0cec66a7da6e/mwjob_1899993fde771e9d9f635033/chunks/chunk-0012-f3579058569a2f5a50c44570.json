project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_def_005"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"统计分析策略：主要终点采用MMRM，固定效应包括治疗组、访视、治疗组×访视、中心及基线MADRS，报告第8周最小二乘均值差、95%置信区间和双侧P值，以优效性为目标。不开展期中分析；安全性集按实际治疗分析。","quote_sha256":"356a405be343840d33b7adf7aabf02ee4ec71e29b6461a7d8ea1278d46458781","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_def_006"}],"evidence_span_ids":["span_sel_004","span_def_001","span_def_002","span_def_003","span_def_004","span_def_005","span_def_006"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"获取AE、SAE、SUSAR定义、分级、采集与报告时限的项目文件后补充相应正文","category":"source_missing","gap_id":"gap_sec_ae_defs_reporting","missing_source_classes":["不良事件、严重不良事件及SUSAR定义与报告流程文件","安全性报告表与CRF填写指南"],"target":"8 安全性评价"},{"action":"获取TEAE采集窗口、研究结束时点及安全性评估窗口的项目来源后补充相应正文","category":"source_missing","gap_id":"gap_sec_assessment_windows","missing_source_classes":["安全性评估时间窗与访视计划操作文件","研究结束定义文件"],"target":"8 安全性评价"},{"action":"获取研究药物具体风险及保险赔偿信息的项目来源后补充相应正文","category":"source_missing","gap_id":"gap_sec_drug_risk_insurance","missing_source_classes":["研究者手册中研究药物安全性风险信息","保险赔偿与受试者损害处理文件"],"target":"8 安全性评价"}],"heading":"安全性评价","missing_source_classes":["不良事件、严重不良事件及SUSAR定义与报告流程文件","安全性评估时间窗与访视计划操作文件","研究者手册中研究药物安全性风险信息","保险赔偿与受试者损害处理文件"],"proposal_text":"本研究安全性评价包括治疗期出现的不良事件（TEAE）、严重不良事件（SAE）及导致停药的不良事件发生率，并包括C-SSRS自杀意念与行为评价以及生命体征、实验室检查和心电图变化。自杀意念或行为列为本研究的特别关注不良事件。安全性随访期为2周，计划在第10周进行安全性随访访视。本研究不设置计划性剂量调整；因安全性需要的暂停或永久停药按方案停药标准处理。安全性分析集按实际治疗分析。","rationale":"已确认安全性终点、特别关注不良事件、安全性随访期、第10周安全性随访、剂量调整原则和安全性分析集，故正文写入这些事实。医学经理需核对AE/SAE/SUSAR定义与报告时限、TEAE采集窗口、研究结束时点、安全性评估窗口、研究药物具体风险和保险赔偿等是否有项目文件支持。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_0cec66a7da6e_c004c8bcc7431976","section_number":"8","source_ids":["protocol_full_draft_selection: