rrent_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_003"}],"evidence_span_ids":["span_001","span_002","span_003"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"补充短期失眠对症用药的具体药物类别、使用时限与记录要求","category":"source_missing","gap_id":"gap_661_01","missing_source_classes":["合并用药管理细则","短期失眠对症用药品种与时限规定"],"target":"6.6.1 允许的合并用药/治疗正文"}],"heading":"允许的合并用药/治疗","missing_source_classes":["合并用药管理细则","短期失眠对症用药品种与时限规定"],"proposal_text":"在双盲辅助治疗期内，允许使用短期失眠对症用药。该允许用药限于短期失眠的对症处理，属于方案规定范围内的合并用药。双盲期禁止新增其他抗抑郁药、抗精神病药或系统性心理治疗；受试者在双盲辅助治疗期内应继续维持既有SSRI背景治疗的稳定剂量，短期失眠对症用药的使用不替代、不改变上述背景治疗的稳定剂量要求。","rationale":"依据当前项目已确认研究事实中的允许合并治疗条目：方案规定范围内的短期失眠对症用药，并结合禁止合并治疗与必需背景治疗条目界定其边界。医学作者需核对短期失眠对症用药的具体药物类别、使用时限及记录格式。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_0cec66a7da6e_4132098962779496","section_number":"6.6.1","source_ids":["protocol_full_draft_selection:ebe9c67a2a37bbc63fd61ecf","current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043"]},{"ai_run_id":"airun_20260922163957_44d54b12","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"禁止的合并治疗：双盲期禁止新增其他抗抑郁药、抗精神病药或系统性心理治疗。（策略=prohibited）","quote_sha256":"04017e19fc612566b954493ac818e58202eb14c43c585255f5e98238e8c640cb","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_002"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"必需背景治疗：既有SSRI在双盲期维持稳定剂量。（策略=allowed_if_stable）","quote_sha256":"1efb636574f0eb340d3449f6848cfa7839ce29567cdf064d2959435c79bbf556","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_003"}],"evidence_span_ids":["span_002","span_003"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[],"heading":"禁止的合并用药/治疗","missing_source_classes":[],"proposal_text":"双盲辅助治疗期内，禁止新增其他抗抑郁药、抗精神病药或系统性心理治疗。该禁止范围包括其他抗抑郁药、抗精神病药以及系统性心理治疗三类。受试者进入双盲辅助治疗期后，应继续维持既有SSRI背景治疗的稳定剂量。","rationale":"依据当前项目已确认研究事实中的禁止合并治疗条目：双盲期禁止新增其他抗抑郁药、抗精神病药或系统性心理治疗。医学作者需确认禁止治疗出现时的救援与停药处理流程。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_0cec66a7da6e_387f6ed7116295eb","section_number":"6.6.2","source_ids":["protocol_full_draft_selection:ebe9c67a2a37bbc63fd61ecf","current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043"]},{"ai_run_id":"airun_20260922163957_44d54b12","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"必需背景治疗：既有SSRI在双盲期维持稳定剂量。（策略=allowed_if_stable）","quote_sha256":"1efb636574f0eb340d3449f6848cfa7839ce29567cdf064d2959435c79bbf556","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_003"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"入选标准模块：符合重度抑郁障碍诊断；当前发作持续至少8周；基线MADRS总分≥26；筛选前SSRI剂量稳定至少4周。","quote_sha256":"ecfe9a8a38d3e3a05ff5dc2209a8946e1d520e7d9cc90747e9ffc9545a3b7c72","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_013"}],"evidence_span_ids":["span_003","span_013"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"补充SSRI稳定剂量的操作性定义、允许调整范围与依从性记录要求","category":"source_missing","gap_id":"gap_663_01","missing_source_classes":["SSRI稳定剂量定义与调整规则"],"target":"6.6.3 必须使用的背景治疗正文"}],"heading":"必须使用的背景治疗","missing_source_classes":["SSRI稳定剂量定义与调整规则"],"proposal_text":"既有SSRI治疗是双盲辅助治疗期的必需背景治疗，在双盲期应维持稳定剂量。受试者在随机进入双盲辅助治疗期后，应继续接受既有的SSRI治疗，并维持筛选前已经稳定的剂量。入选标准要求筛选前SSRI剂量稳定至少4周；双盲辅助治疗期内的背景治疗应延续该稳定剂量。","rationale":"依据必需背景治疗条目（既有SSRI在双盲期维持稳定剂量）和入选标准中筛选前SSRI剂量稳定至少4周。医学作者需核对稳定剂量的操作性定义及允许的调整范围。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_0cec66a7da6e_a9cf58b9b8ddc5ba","section_number":"6.6.3","source_ids":["protocol_full_draft_selection:ebe9c67a2a37bbc63fd61ecf","current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043"]},{"ai_run_id":"airun_20260922163957_44d54b12","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"研究时期：筛选期2周。；双盲辅助治疗期8周。；安全性随访期2周。","quote_sha256":"87c6ae78b837bbf27786723128a08feb35bd15499a888d7ac73a66eb0e095c2d","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_004"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"访视策略：筛选、基线及第1、2、4、6、8周访视，第10周安全性随访；MADRS由经培训且尽量保持同一的盲态评估者完成。","quote_sha256":"a5f71518e97723c4337a87f2fdb48f3243d0e56402965a4994070ccbe8182973","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_005"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"合成试验药C：20 mg，每晚一次（口服）；8周","quote_sha256":"1f0c55c863e3157770f4bf6e1ff940606190e9c627d91b15cfcb52f225870ee4","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_006"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"主要终点：第8周MADRS总分较基线变化。","quote_sha256":"7d24fedbdedcfe8cc33346a0687eeeaf0a92a196d921655654ce68ade2fb9d37","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_007"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"关键次要终点：第8周MADRS应答率（总分较基线下降≥50%）。；第8周MADRS缓解率（总分≤10）。","quote_sha256":"c6b07ab8e97508acf8ec3e6df0d7827dd61d340dc7bfa81ac3fd76b39029f057","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_008"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"其他次要终点：第8周SDS总分较基线变化。","quote_sha256":"5a098b4797e365e6b6c64280d863fe530402cee78289ce94f806735bff9bc5bc","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_009"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"安全性终点：TEAE、SAE及导致停药的不良事件发生率。；C-SSRS自杀意念与行为评价及生命体征、实验室检查、心电图变化。","quote_sha256":"7fb7bdebd2adfade50a1cdec22f0c156522f0e83018fbf487ed008f708521362","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_010"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"剂量调整：不设置计划性剂量调整；因安全性需要的暂停或永久停药按方案停药标准处理。","quote_sha256":"c5ee70f45469d0d4ef33855964e6b4348b784a0b2ab5c9011697efc45f910309","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_011"}],"evidence_span_ids":["span_004","span_005","span_006","span_007","span_008","span_009","span_010","span_011"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":8},"gap_items":[{"action":"补充各评估项目在筛选、基线、第1、2、4、6、8周及第10周访视的具体实施安排","category":"source_missing","gap_id":"gap_7_01","missing_source_classes":["访视评估时间表"],"target":"第7章研究程序和评估"},{"action":"补充研究结束定义与安全性评估窗口","category":"source_missing","gap_id":"gap_7_02","missing_source_classes":["研究结束定义","安全性评估窗口"],"target":"第7章研究程序和评估"},{"action":"补充TEAE采集窗口及给药依从性评价方法","category":"source_missing","gap_id":"gap_7_03","missing_source_classes":["TEAE采集窗口"],"target":"第7章研究程序和评估"}],"heading":"研究程序和评估","missing_source_classes":["访视评估时间表","研究结束定义","安全性评估窗口","TEAE采集窗口"],"proposal_text":"本研究程序包括筛选期、双盲辅助治疗期和安全性随访期。筛选期为2周；双盲辅助治疗期为8周；安全性随访期为2周。访视安排包括筛选、基线及第1、2、4、6、8周访视，以及第10周安全性随访。试验组受试者在既有稳定SSRI治疗基础上口服合成试验药C 20 mg，每晚一次，持续8周；对照组口服匹配安慰剂，每晚一次，持续8周。主要疗效评估为第8周MADRS总分较基线变化。关键次要疗效评估包括第8周MADRS应答率（总分较基线下降≥50%）和第8周MADRS缓解率（总分≤10）；其他次要疗效评估为第8周SDS总分较基线变化。MADRS由经培训且尽量保持同一的盲态评估者完成。安全性评估包括TEAE、SAE及导致停药的不良事件发生率，C-SSRS自杀意念与行为评价，以及生命体征、实验室检查和心电图变化。不设置计划性剂量调整；因安全性需要的暂停或永久停药按方案停药标准处理。","rationale":"依据已确认的研究时期、访视策略、给药方案、疗效终点和安全性终点。医学作者需核对各评估项目在访视中的具体实施时间、研究结束定义、TEAE采集窗口及给药依从性评价方法。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_0cec66a7da6e_fe10dd9113bdc41d","section_number":"7","source_ids":["protocol_full_draft_selection:ebe9c67a2a37bbc63fd61ecf","current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043"]}],"source_bindings":[{"content_sha256":"0717486c067526d4481e1775edcc90b988a3f7e8935f2ef9389d4785dd4c4a79","locator":"document:mwdoc_greenfield_proj_user_0cec66a7da6e_92dc32ead2551dda:full-draft:ebe9c67a2a37bbc63fd61ecf","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:ebe9c67a2a37bbc63fd61ecf","source_type":"protocol_full_draft_selection","source_version":"full-draft:c315238e8975745fc5500ae52859c14372253487b00aa4718f4224a279fcb0b5:ebe9c67a2a37bbc63fd61ecf","text_sha256":"0717486c067526d4481e1775edcc90b988a3f7e8935f2ef9389d4785dd4c4a79"},{"content_sha256":"844b3acb36f874917fb1ab2400816e3caff7f00a41b34d1a674f95d57696b803","locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","source_type":"current_project_study_definition","source_version":"mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","text_sha256":"844b3acb36f874917fb1ab2400816e3caff7f00a41b34d1a674f95d57696b803"}]}