evision:3","quote":"关键次要终点：第8周MADRS应答率（总分较基线下降≥50%）。；第8周MADRS缓解率（总分≤10）。","quote_sha256":"c6b07ab8e97508acf8ec3e6df0d7827dd61d340dc7bfa81ac3fd76b39029f057","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_key_secondary"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"其他次要终点：第8周SDS总分较基线变化。","quote_sha256":"5a098b4797e365e6b6c64280d863fe530402cee78289ce94f806735bff9bc5bc","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_other_secondary"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"安全性终点：TEAE、SAE及导致停药的不良事件发生率。；C-SSRS自杀意念与行为评价及生命体征、实验室检查、心电图变化。","quote_sha256":"7fb7bdebd2adfade50a1cdec22f0c156522f0e83018fbf487ed008f708521362","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_safety_endpoint"},{"locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","quote":"特别关注的不良事件：自杀意念或行为。","quote_sha256":"3a4e6509ee0b38269bb7622d85040be93d8adb26065fb350aacad90684e56c93","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","span_id":"span_aesi"}],"evidence_span_ids":["span_sec_712","span_intervention","span_dose","span_dose_adjust","span_conmed_allowed","span_conmed_required","span_conmed_prohibited","span_visit_strategy","span_primary_endpoint","span_key_secondary","span_other_secondary","span_safety_endpoint","span_aesi"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":12},"gap_items":[{"action":"补充剂量暂停、恢复和永久停药的具体标准与操作规则。","category":"source_missing","gap_id":"gap_treat_dose_adjust","missing_source_classes":["剂量调整与停药标准项目文件"],"target":"7.1.2 治疗期及随访：剂量暂停、恢复与永久停药"},{"action":"补充AE/SAE/SUSAR定义、采集与报告规则。","category":"source_missing","gap_id":"gap_treat_ae","missing_source_classes":["安全性报告项目文件"],"target":"7.1.2 治疗期及随访：AE/SAE采集与报告"},{"action":"补充依从性评价方法、时点与记录要求。","category":"source_missing","gap_id":"gap_treat_compliance","missing_source_classes":["依从性评价项目文件"],"target":"7.1.2 治疗期及随访：依从性评价"},{"action":"补充救援治疗定义、启动条件及处理规则。","category":"source_missing","gap_id":"gap_treat_rescue","missing_source_classes":["救援治疗与合并用药处理项目文件"],"target":"7.1.2 治疗期及随访：救援治疗与禁止用药处理"}],"heading":"治疗期及随访","missing_source_classes":["剂量调整与停药标准项目文件","安全性报告项目文件","依从性评价项目文件","救援治疗与合并用药处理项目文件"],"proposal_text":"双盲辅助治疗期为8周。受试者在既有稳定SSRI治疗基础上，试验组口服合成试验药C 20 mg，每晚一次，对照组口服匹配安慰剂，每晚一次，双盲治疗8周。双盲期维持既有SSRI稳定剂量，禁止新增其他抗抑郁药、抗精神病药或系统性心理治疗；方案规定范围内的短期失眠对症用药允许使用。不设置计划性剂量调整；因安全性需要的暂停或永久停药按方案停药标准处理。访视安排包括第1、2、4、6、8周访视，并在第10周进行安全性随访，安全性随访期为2周。第8周MADRS总分较基线变化为主要终点，关键次要终点包括第8周MADRS应答率（总分较基线下降≥50%）和第8周MADRS缓解率（总分≤10），其他次要终点包括第8周SDS总分较基线变化。安全性终点包括TEAE、SAE及导致停药的不良事件发生率，以及C-SSRS自杀意念与行为评价及生命体征、实验室检查、心电图变化。特别关注的不良事件为自杀意念或行为。MADRS评估由经培训且尽量保持同一的盲态评估者完成。","rationale":"已确认双盲辅助治疗期8周、合成试验药C 20 mg每晚一次口服、匹配安慰剂每晚一次口服、既有SSRI维持稳定、允许短期失眠对症用药、禁止新增其他抗抑郁药/抗精神病药/系统性心理治疗、不设置计划性剂量调整、第1/2/4/6/8周访视和第10周安全性随访，以及第8周MADRS主要终点和关键次要终点。医学作者需核实剂量暂停或永久停药标准、AE/SAE采集报告、依从性评价和救援治疗规则。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_0cec66a7da6e_aaf66f9b9edb8722","section_number":"7.1.2","source_ids":["protocol_full_draft_selection:9d3d266bf1661bf0fa303343","current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043"]},{"ai_run_id":"airun_20260922164110_18eba586","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"补充计划外访视定义、触发条件及评估范围的项目文件。","category":"source_missing","gap_id":"gap_unsched_definition","missing_source_classes":["计划外访视项目文件"],"target":"7.1.3 计划外访视：定义与触发条件"},{"action":"补充计划外访视数据记录、源数据核对和报告要求。","category":"source_missing","gap_id":"gap_unsched_data","missing_source_classes":["计划外访视数据记录与报告要求项目文件"],"target":"7.1.3 计划外访视：数据记录与报告"},{"action":"补充计划外访视中安全性事件识别、记录与报告衔接规则。","category":"source_missing","gap_id":"gap_unsched_safety","missing_source_classes":["安全性报告衔接项目文件"],"target":"7.1.3 计划外访视：安全性报告衔接"}],"heading":"计划外访视","missing_source_classes":["计划外访视项目文件","计划外访视数据记录与报告要求项目文件","安全性报告衔接项目文件"],"proposal_text":"","rationale":"允许来源仅确认计划外访视章节身份，未提供计划外访视定义、评估范围、数据记录与报告要求等项目实施规则。医学作者需补充相应项目文件后形成正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_0cec66a7da6e_cc48649b5d909c6c","section_number":"7.1.3","source_ids":["protocol_full_draft_selection:9d3d266bf1661bf0fa303343","current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043"]}],"source_bindings":[{"content_sha256":"2d1e009daa225ea98226309002d649db704f170595e7151110347b698519312e","locator":"document:mwdoc_greenfield_proj_user_0cec66a7da6e_92dc32ead2551dda:full-draft:9d3d266bf1661bf0fa303343","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:9d3d266bf1661bf0fa303343","source_type":"protocol_full_draft_selection","source_version":"full-draft:c315238e8975745fc5500ae52859c14372253487b00aa4718f4224a279fcb0b5:9d3d266bf1661bf0fa303343","text_sha256":"2d1e009daa225ea98226309002d649db704f170595e7151110347b698519312e"},{"content_sha256":"844b3acb36f874917fb1ab2400816e3caff7f00a41b34d1a674f95d57696b803","locator":"study_definition:mwdefinition_f76f9971b2e912d7b623:revision:3","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","source_type":"current_project_study_definition","source_version":"mwdefinition_f76f9971b2e912d7b623:r3:8c781ae0091a9043","text_sha256":"844b3acb36f874917fb1ab2400816e3caff7f00a41b34d1a674f95d57696b803"}]}