sha256":"057bf321f30180105f30781bb0d989a31b06495a3236bef84c0c313958c0fa80","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:72548c417a8f5c","span_id":"span_ec_term_ref2"},{"locator":"section:3.5.4 提前退出研究|block:556|chunk:1","quote":"研究者、申办者、伦理委员会/机构委员会因安全性、监管或其他原因要求受试者退出研究。","quote_sha256":"3c04b77ba21334b1f8bd03c450ef947382ab158a7062d8441c012b4d74077fc7","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:4e86a5ea954c95","span_id":"span_ec_wd_ref1"},{"locator":"section:8.研究者、申办者、伦理委员会/机构委员会因安全性、监管或其他原因要求试验参与者退出研究。|block:328|chunk:1","quote":"研究者、申办者、伦理委员会/机构委员会因安全性、监管或其他原因要求试验参与者退出研究。","quote_sha256":"20b439f9dbfc772ffc7943982cbf5132a63015d4571af23b9ea4534191e2e352","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:df064f51d3d147","span_id":"span_ec_wd_ref2"}],"evidence_span_ids":["span_sec_11_3","span_sd_phase_region","span_sd_center","span_ec_term_ref1","span_ec_term_ref2","span_ec_wd_ref1","span_ec_wd_ref2"],"evidence_summary":{"corpus_spans":4,"project_fact_spans":2},"heading":"伦理委员会","missing_source_classes":[],"proposal_text":"本研究在中国开展，为多中心III期临床试验。研究实施遵循《药物临床试验质量管理规范》及赫尔辛基宣言确立的伦理原则，受试者的权益、安全和健康高于对科学和社会利益的考虑。研究开始前，研究方案、知情同意书及其他需审查的文件应取得伦理委员会的批准；研究过程中对上述文件的修订，应按适用法规和伦理委员会的要求提交审查。伦理委员会可要求终止本研究；研究者、申办者、伦理委员会/机构委员会可因安全性、监管或其他原因要求受试者退出研究。受试者参加研究前应获得充分的知情信息并自愿同意参加。","rationale":"本章正文以已确认研究事实（在中国开展、多中心、III期，目标人群为成人中重度斑块状银屑病患者）和允许来源中的伦理治理条款（伦理委员会可要求终止研究；研究者、申办者、伦理委员会/机构委员会可因安全性、监管或其他原因要求受试者退出研究）为支撑，伦理审查与知情同意的一般要求按监管共性表述写入。需医学作者核对：本项目伦理审查与批准流程、定期审查与报告安排、知情同意文件版本与签署程序、伦理审查与安全性报告及保险赔偿章节的衔接，并确认治理条款与适用法规、机构要求一致。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_0a9e98cb500d9ec5","section_number":"11.3","source_ids":["protocol_full_draft_selection:9c464241dd0d051bbe922a29","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:2db65207908661","company_corpus:cms_cn_protocol_corpus_20260715_v1:72548c417a8f5c","company_corpus:cms_cn_protocol_corpus_20260715_v1:4e86a5ea954c95","company_corpus:cms_cn_protocol_corpus_20260715_v1:df064f51d3d147","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67"]},{"ai_run_id":"airun_20260922060235_4c3b7c1a","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:9c464241dd0d051bbe922a29","quote":"章节编号=11.4\n章节标题=保密与隐私\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"282749d10f5bf62ae8e0c26d7d8766a12ba00d4eea226d71950c5a6854a421bb","source_id":"protocol_full_draft_selection:9c464241dd0d051bbe922a29","span_id":"span_sec_11_4"},{"locator":"section:文档开头|block:4|chunk:1","quote":"本方案中所包含的所有信息归申办方所有，因此，仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构进行审阅。在未得到申办方书面批准的情况下，除了在与可能参加本研究的受试者签署知情同意书时，向其做必要的解释外，严禁将任何信息告知与本研究无关的第三方。","quote_sha256":"dfc9fceb41db9d941df0e3715483adaa069da4f1953600a6a37a56d7f81373dd","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","span_id":"span_confidentiality"}],"evidence_span_ids":["span_sec_11_4","span_confidentiality"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":0},"heading":"保密与隐私","missing_source_classes":[],"proposal_text":"本方案及其所包含的全部信息归申办方所有，仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构审阅。在未得到申办方书面批准的情况下，除在受试者知情同意过程中向其作必要解释外，严禁将任何研究相关信息告知与本研究无关的第三方。受试者的个人信息及健康相关数据应受到保护，仅用于本研究的实施、医学审评与监督管理目的，不得向无关人员或机构披露。","rationale":"本章正文以允许来源中的方案信息保密条款为支撑，明确信息归申办方所有、审阅主体范围以及未经书面批准的披露限制；涉及受试者个人信息与健康数据的处理按保护原则表述。需医学作者核对：个人信息保护与数据处理的适用法规要求、数据匿名化与编码方式、数据保存与销毁安排、数据共享与对外提供情形、受试者查阅与更正途径，以及与知情同意书告知内容的一致性。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_69c81a8357089814","section_number":"11.4","source_ids":["protocol_full_draft_selection:9c464241dd0d051bbe922a29","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:2db65207908661","company_corpus:cms_cn_protocol_corpus_20260715_v1:72548c417a8f5c","company_corpus:cms_cn_protocol_corpus_20260715_v1:4e86a5ea954c95","company_corpus:cms_cn_protocol_corpus_20260715_v1:df064f51d3d147","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67"]},{"ai_run_id":"airun_20260922060235_4c3b7c1a","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"heading":"保险与赔偿","missing_source_classes":["保险与赔偿相关项目文件（如临床试验保险凭证或保单条款、受试者损害处理与赔偿安排）","知情同意书中受试者损害处理与赔偿告知内容"],"proposal_text":"","rationale":"本次允许来源未提供保险与赔偿相关的项目文件或合同条款，缺少确定本章内容所需的项目事实，依据来源判定要求不生成正文。需补充的来源类别：临床试验保险凭证或保单条款、受试者损害处理与赔偿安排、知情同意书中的相应告知内容。在取得上述项目来源前，本章不得以通用原则、条件句或范围句填充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_cb95bcbc11a174bb","section_number":"11.5","source_ids":["protocol_full_draft_selection:9c464241dd0d051bbe922a29","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:2db65207908661","company_corpus:cms_cn_protocol_corpus_20260715_v1:72548c417a8f5c","company_corpus:cms_cn_protocol_corpus_20260715_v1:4e86a5ea954c95","company_corpus:cms_cn_protocol_corpus_20260715_v1:df064f51d3d147","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67"]},{"ai_run_id":"airun_20260922060235_4c3b7c1a","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"heading":"研究文件、监查和管理","missing_source_classes":["监查计划或监查管理文件","研究文件管理规程及保存要求","申办方、研究者及相关方在监查与文件管理中的职责分工文件","数据管理与质量控制相关文件"],"proposal_text":"","rationale":"本次允许来源未提供监查计划、研究文件管理规程以及监查与管理职责分工等项目来源，无法形成可审阅的实质正文，依据来源判定要求不生成正文。需补充的来源类别：监查安排相关文件、研究文件范围与保存要求、各方在监查和数据质量保障中的职责文件。在取得上述来源前，本章不得以通用监查原则填充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_df24f522766abc57","section_number":"12","source_ids":["protocol_full_draft_selection:9c464241dd0d051bbe922a29","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:2db65207908661","company_corpus:cms_cn_protocol_corpus_20260715_v1:72548c417a8f5c","company_corpus:cms_cn_protocol_corpus_20260715_v1:4e86a5ea954c95","company_corpus:cms_cn_protocol_corpus_20260715_v1:df064f51d3d147","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67"]}],"source_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:9c464241dd0d051bbe922a29","source_id":"protocol_full_draft_selection:9c464241dd0d051bbe922a29","source_type":"protocol_full_draft_selection","text_sha256":"3d9f17216edd35a8c6ddcc6b2d4c6732dc7c919c9958fb6d4c44cda9cf5bda81"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","source_type":"current_project_study_definition","text_sha256":"787313a6f081b1c9afdf03800feb1c50c317aa4aa4f0c3884e924b0594e666da"},{"locator":"section:4.3 终止研究标准|block:850|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:2db65207908661","source_type":"company_protocol_reference_corpus","text_sha256":"f19661bef01070eab86ff5119d563d2a2c9cec40e46037583009193ebb9b3555"},{"locator":"section:终止研究|block:316|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:72548c417a8f5c","source_type":"company_protocol_reference_corpus","text_sha256":"057bf321f30180105f30781bb0d989a31b06495a3236bef84c0c313958c0fa80"},{"locator":"section:3.5.4 提前退出研究|block:556|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:4e86a5ea954c95","source_type":"company_protocol_reference_corpus","text_sha256":"3c04b77ba21334b1f8bd03c450ef947382ab158a7062d8441c012b4d7