{"ai_run_id":"airun_20260922031412_9631a0f5","chunk_index":12,"job_id":"mwjob_6ea88e6715579409992c43ee","precondition_digest":"968aabd6184f764b8be1b297092e19b0d5f45b861c3a384214982b8cdb9452d9","project_id":"proj_user_8a5a00cb014a","schema_version":"protocol_full_draft_chunk_v7","section_ids":["mwsec_greenfield_proj_user_8a5a00cb014a_02ec258233d8e7ca","mwsec_greenfield_proj_user_8a5a00cb014a_7693d868c98988a2","mwsec_greenfield_proj_user_8a5a00cb014a_384005122a9ff626","mwsec_greenfield_proj_user_8a5a00cb014a_893db0e17b2da155"],"sections":[{"ai_run_id":"airun_20260922031412_9631a0f5","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:6002cd14768995da13cd45f3","quote":"SECTION_ID=mwsec_greenfield_proj_user_8a5a00cb014a_02ec258233d8e7ca\n章节编号=7.3.4\n章节标题=妊娠检查和避孕问询","quote_sha256":"da13a2583934569fc1e9397dab1be8d7ee08df32e5af99197803e8450cd12287","source_id":"protocol_full_draft_selection:6002cd14768995da13cd45f3","span_id":"A_sec_7_3_4"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"排除标准模块：非斑块型银屑病为主要表现，或存在可能干扰疗效/安全性评价的其他活动性皮肤病；活动性严重感染；妊娠或哺乳期；研究者判断不适合参加。","quote_sha256":"25de1577631d408629fd83338122249e7d0333f30cafbcf4445c1c9991fc6aee","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"B_exclusion"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"试验干预：试验组接受合成试验药A 100 mg口服，每日一次，连续16周；对照组接受匹配安慰剂。","quote_sha256":"f3eff5ef57b4691ff025db695140e4ead682562786c0dec621edcd256ef28af3","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"B_intervention"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究时期：筛选期：最长4周。；双盲治疗期：16周。；安全性随访期：4周。","quote_sha256":"1df9f3c36a7060d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"B_periods"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"访视策略：筛选后于基线/第1天随机；第2、4、8、12、16周进行治疗期访视，第20周进行安全性随访。PASI和sPGA于基线及第4、8、12、16周评价。","quote_sha256":"8c7a570d51b842be51c8689066b3d6fe50030b8229d96708644c920d085e82c5","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"B_visits"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"给药途径：口服","quote_sha256":"404b058b755608a73d13b54521a28c02b129df449774d0671b1c3f8b8a5ce42c","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"B_route"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"局部/系统暴露范围：systemic","quote_sha256":"83a8469236905f60f11fec86f93234f3ddf2027482e82bafa90802a6e138e6e2","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"B_exposure"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"目标研究人群：成人中重度斑块状银屑病患者","quote_sha256":"a1f2b59730f1d08cde8f6a85d4179e62887b3729f4175c98334b9dafda33e808","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"B_population"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"入选标准模块：年龄≥18岁；确诊斑块状银屑病≥6个月；筛选及基线时PASI≥12、受累体表面积≥10%、sPGA≥3；适合接受系统治疗或光疗。","quote_sha256":"3e9ca06af65f6aeb7e28df97f2a93f40d8966553fa5faff3f806e43f762999dd","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"B_inclusion"}],"evidence_span_ids":["A_sec_7_3_4","B_exclusion","B_intervention","B_periods","B_visits","B_route","B_exposure","B_population","B_inclusion"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":8},"heading":"妊娠检查和避孕问询","missing_source_classes":[],"proposal_text":"本研究纳入年龄≥18岁的成人中重度斑块状银屑病患者，妊娠或哺乳期女性属于排除标准。合成试验药A为口服给药且具有全身暴露，因此研究期间需对育龄女性受试者进行妊娠检查和避孕问询。妊娠检查应在筛选期进行，以确认受试者不处于妊娠状态并符合入组条件；避孕问询应了解受试者在筛选期及研究期间的避孕措施使用情况。相关评估应与本研究的访视安排相衔接，包括筛选期（最长4周）、双盲治疗期第2、4、8、12、16周访视及第20周安全性随访。","rationale":"依据已确认研究事实：目标人群为成人中重度斑块状银屑病患者，妊娠或哺乳期属于排除标准；合成试验药A为口服全身暴露药物；研究时期包括筛选期最长4周、双盲治疗期16周及安全性随访期4周，访视安排为第2、4、8、12、16周及第20周。建议医学作者核对：妊娠检查的具体方法（如尿妊娠或血妊娠）、检查时点（是否仅在筛选期或治疗期各访视均需检查）、避孕措施的具体要求与持续时间、妊娠事件报告路径与随访要求。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_02ec258233d8e7ca","section_number":"7.3.4","source_ids":["protocol_full_draft_selection:6002cd14768995da13cd45f3","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]},{"ai_run_id":"airun_20260922031412_9631a0f5","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:6002cd14768995da13cd45f3","quote":"SECTION_ID=mwsec_greenfield_proj_user_8a5a00cb014a_7693d868c98988a2\n章节编号=8\n章节标题=安全性评价","quote_sha256":"f6cbd5336fac3aa067e960327947fb65e9e0d60da577eddde818d439f33e539e","source_id":"protocol_full_draft_selection:6002cd14768995da13cd45f3","span_id":"A_sec_8"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"安全性终点：治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件发生率。；实验室检查、生命体征及12导联心电图具有临床意义的变化。","quote_sha256":"99133b9298d6b094501b14430ac89a3b690a9aa9acb4bb1df325ea3196a44236","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"B_safety_endpoints"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究时期：筛选期：最长4周。；双盲治疗期：16周。；安全性随访期：4周。","quote_sha256":"1df9f3c36a7060d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"B_periods"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"访视策略：筛选后于基线/第1天随机；第2、4、8、12、16周进行治疗期访视，第20周进行安全性随访。PASI和sPGA于基线及第4、8、12、16周评价。","quote_sha256":"8c7a570d51b842be51c8689066b3d6fe50030b8229d96708644c920d085e82c5","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"B_visits"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"统计分析策略：全分析集按随机分组采用CMH方法比较主要终点，报告应答率差、95%置信区间和P值，以优效性为目标。主要缺失处理采用无应答填补，并以多重插补和观察病例分析进行敏感性分析；安全性集按实际治疗分析。不开展期中分析。","quote_sha256":"ccd7b348358b71793f3761994bf0e928e73abcd319f577b74f5285d5c99e3b7c","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"B_stats"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"试验干预：试验组接受合成试验药A 100 mg口服，每日一次，连续16周；对照组接受匹配安慰剂。","quote_sha256":"f3eff5ef57b4691ff025db695140e4ead682562786c0dec621edcd256ef28af3","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"B_intervention"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"剂量与给药方案：合成试验药A：100 mg，每日一次（QD）（口服）；第1天至第16周。依从：通过药品计数及受试者日记评价依从性\n匹配安慰剂：每日一次（QD）（口服）；第1天至第16周双盲治疗期。依从：通过药品计数及受试者日记评价依从性","quote_sha256":"94fb65afc774da062ed601e6f161a821a0ac0ae3a448c3184db20ac0caba0782","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"B_dose"}],"evidence_span_ids":["A_sec_8","B_safety_endpoints","B_periods","B_visits","B_stats","B_intervention","B_dose"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"heading":"安全性评价","missing_source_classes":[],"proposal_text":"本研究的安全性评价旨在评估合成试验药A 100 mg每日一次口服治疗成人中重度斑块状银屑病患者的安全性。安全性评价覆盖16周双盲治疗期及4周安全性随访期，末次安全性随访访视在第20周。安全性终点包括治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件发生率，以及实验室检查、生命体征及12导联心电图具有临床意义的变化。安全性评价通过不良事件监测、实验室检查、生命体征测量和12导联心电图检查实施。安全性分析基于安全性集，按受试者实际接受的治疗进行分析。","rationale":"依据已确认研究事实：安全性终点为TEAE、严重不良事件、导致停药的不良事件发生率及实验室检查、生命体征、12导联心电图的临床意义变化；双盲治疗期16周，安全性随访期4周，第20周安全性随访；安全性集按实际治疗分析。建议医学作者核对：AE/SAE的定义、严重程度分级、因果关系判定、报告时限与报告对象；安全性数据收集的具体CRF字段和访视时点；安全性分析的具体统计方法。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_7693d868c98988a2","section_number":"8","source_ids":["protocol_full_draft_selection:6002cd14768995da13cd45f3","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]},{"ai_run_id":"airun_20260922031412_9631a0f5","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:6002cd14768995da13cd45f3","quote":"SECTION_ID=mwsec_greenfield_proj_user_8a5a00cb014a_384005122a9ff626\n章节编号=8.1\n章节标题=总则","quote_sha256":"711809953760b0c8b580b913f9f3b54b5cd77d6c62ff013dfc15e226cf49ad38","source_id":"protocol_full_draft_selection:6002cd14768995da13cd45f3","span_id":"A_sec_8_1"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"安全性终点：治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件发生率。；实验室检查、生命体征及12导联心电图具有临床意义的变化。","quote_sha256":"99133b9298d6b094501b14430ac89a3b690a9aa9acb4bb1df325ea3196a44236","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"B_safety_endpoints"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究时期：筛选期：最长4周。；双盲治疗期：16周。；安全性随访期：4周。","quote_sha256":"1df9f3c36a7060d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"B_periods"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"访视策略：筛选后于基线/第1天随机；第2、4、8、12、16周进行治疗期访视，第20周进行安全性随访。PASI和sPGA于基线及第4、8、12、16周评价。","quote_sha256":"8c7a570d51b842be51c8689066b3d6fe50030b8229d96708644c920d085e82c5","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"B_visits"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"统计分析策略：全分析集按随机分组采用CMH方法比较主要终点，报告应答率差、95%置信区间和P值，以优效性为目标。主要缺失处理采用无应答填补，并以多重插补和观察病例分析进行敏感性分析；安全性集按实际治疗分析。不开展期中分析。","quote_sha256":"ccd7b348358b71793f3761994bf0e928e73abcd319f577b74f5285d5c99e3b7c","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"B_stats"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"试验干预：试验组接受合成试验药A 100 mg口服，每日一次，连续16周；对照组接受匹配安慰剂。","quote_sha256":"f3eff5ef57b4691ff025db695140e4ead682562786c0dec621edcd256ef28af3","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"B_intervention"}],"evidence_span_ids":["A_sec_8_1","B_safety_endpoints","B_periods","B_visits","B_stats","B_intervention"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"heading":"总则","missing_source_classes":[],"proposal_text":"本研究安全性评价遵循以下总体原则。安全性评价贯穿筛选期、双盲治疗期和安全性随访期。双盲治疗期为16周，安全性随访期为4周，第20周进行安全性随访。安全性评价包括不良事件监测、实验室检查、生命体征测量和12导联心电图检查。安全性终点为治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件发生率，以及实验室检查、生命体征及12导联心电图具有临床意义的变化。安全性分析集按实际治疗进行分析。安全性数据按本研究的访视安排进行收集和评估。","rationale":"依据已确认研究事实：安全性终点为TEAE、严重不良事件、导致停药的不良事件发生率及实验室检查、生命体征、12导联心电图的临床意义变化；双盲治疗期16周，安全性随访期4周，第20周安全性随访；安全性集按实际治疗分析。建议医学作者核对：AE/SAE定义、严重程度分级、因果关系判定、报告时限与报告对象；安全性数据收集的具体CRF字段和访视时点；安全性分析的具体统计方法。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_384005122a9ff626","section_number":"8.1","source_ids":["protocol_full_draft_selection:6002cd14768995da13cd45f3","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]},{"ai_run_id":"airun_20260922031412_9631a0f5","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:6002cd14768995da13cd45f3","quote":"SECTION_ID=mwsec_greenfield_proj_user_8a5a00cb014a_893db0e17b2da155\n章节编号=8.2\n章节标题=定义\n章节类型=section\n当前正文=治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件发生率。；实验室检查、生命体征及12导联心电图具有临床意义的变化。","quote_sha256":"bb4899ffbbcaf39381e37ac625983d5477703fcce1eb5a7c20ec4d1aa9f677be","source_id":"protocol_full_draft_selection:6002cd14768995da13cd45f3","span_id":"A_sec_8_2"},{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:6002cd14768995da13cd45f3","quote":"SECTION_ID=mwsec_greenfield_proj_user_8a5a00cb014a_7693d868c98988a2\n章节编号=8\n章节标题=安全性评价","quote_sha256":"f6cbd5336fac3aa067e960327947fb65e9e0d60da577eddde818d439f33e539e","source_id":"protocol_full_draft_selection:6002cd14768995da13cd45f3","span_id":"A_sec_8"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"安全性终点：治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件发生率。；实验室检查、生命体征及12导联心电图具有临床意义的变化。","quote_sha256":"99133b9298d6b094501b14430ac89a3b690a9aa9acb4bb1df325ea3196a44236","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"B_safety_endpoints"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究时期：筛选期：最长4周。；双盲治疗期：16周。；安全性随访期：4周。","quote_sha256":"1df9f3c36a7060d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"B_periods"}],"evidence_span_ids":["A_sec_8_2","A_sec_8","B_safety_endpoints","B_periods"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"heading":"定义","missing_source_classes":[],"proposal_text":"本研究安全性评价中，治疗期间出现的不良事件（TEAE）指受试者在双盲治疗期及安全性随访期内新发生或较基线加重的任何不良医学事件。严重不良事件及导致停药的不良事件是TEAE中需要单独评价的事件类别。实验室检查、生命体征及12导联心电图的临床意义变化指经研究者判断具有临床意义的异常变化。上述事件的发生率以及实验室检查、生命体征和12导联心电图的临床意义变化共同构成本研究的安全性终点。","rationale":"已确认事实：安全性终点明确列出TEAE、严重不良事件、导致停药的不良事件发生率及实验室检查、生命体征、12导联心电图的临床意义变化；研究时期为16周双盲治疗期和4周安全性随访期。建议医学作者核对：TEAE的具体判定窗口（如末次给药后多少天内的不良事件仍计入TEAE）、严重不良事件的具体定义和分类标准、导致停药的不良事件的判定标准、临床意义变化的判定标准以及SAE报告时限与流程。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_893db0e17b2da155","section_number":"8.2","source_ids":["protocol_full_draft_selection:6002cd14768995da13cd45f3","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]}],"source_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:6002cd14768995da13cd45f3","source_id":"protocol_full_draft_selection:6002cd14768995da13cd45f3","source_type":"protocol_full_draft_selection","text_sha256":"cea1dd8d5ff563ac02bcffc02ebbd03507d94f79f3eac5044fad9404a0e6aa36"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","source_type":"current_project_study_definition","text_sha256":"787313a6f081b1c9afdf03800feb1c50c317aa4aa4f0c3884e924b0594e666da"}]}