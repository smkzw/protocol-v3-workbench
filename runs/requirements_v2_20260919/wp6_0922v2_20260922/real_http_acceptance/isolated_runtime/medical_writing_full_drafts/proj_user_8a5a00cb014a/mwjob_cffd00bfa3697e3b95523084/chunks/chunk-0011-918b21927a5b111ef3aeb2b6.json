ety_set"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"heading":"实验室检查","missing_source_classes":[],"proposal_text":"实验室检查是本研究安全性评价的组成部分，安全性终点包括实验室检查出现具有临床意义的变化。实验室检查结果用于支持对成人中重度斑块状银屑病受试者的安全性评价。本研究双盲治疗期为16周，安全性随访期为4周，第20周进行安全性随访。实验室检查结果与其他安全性数据一并纳入安全性分析，用于评价合成试验药A在目标人群中的安全性特征。","rationale":"支持依据：实验室检查具有临床意义的变化属于安全性终点；研究设16周双盲治疗期与4周安全性随访期，第20周进行安全性随访；安全性集按实际治疗分析。需医学作者核对：实验室检查项目清单、样本采集时点、检测实验室安排、参考范围及异常结果处理。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_26f3d31f974592dd","section_number":"7.3.3","source_ids":["protocol_full_draft_selection:918b21927a5b111ef3aeb2b6","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]}],"source_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:918b21927a5b111ef3aeb2b6","source_id":"protocol_full_draft_selection:918b21927a5b111ef3aeb2b6","source_type":"protocol_full_draft_selection","text_sha256":"31ff2225a79363293c7fb0069a80369002311ae02a2d7e6b2b7a91382d15397d"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","source_type":"current_project_study_definition","text_sha256":"787313a6f081b1c9afdf03800feb1c50c317aa4aa4f0c3884e924b0594e666da"}]}