{"ai_run_id":"airun_20260922042609_f8a928d9","chunk_index":11,"job_id":"mwjob_cffd00bfa3697e3b95523084","precondition_digest":"f483172f30b055a8b1e1a0031ff9bcf82f903ed2e0e2f5846600e2e4c3920808","project_id":"proj_user_8a5a00cb014a","schema_version":"protocol_full_draft_chunk_v8","section_ids":["mwsec_greenfield_proj_user_8a5a00cb014a_bd9d9224d94e0ac8","mwsec_greenfield_proj_user_8a5a00cb014a_90b6de05a57a5bcc","mwsec_greenfield_proj_user_8a5a00cb014a_bbc8a74bb7965cf9","mwsec_greenfield_proj_user_8a5a00cb014a_26f3d31f974592dd"],"sections":[{"ai_run_id":"airun_20260922042609_f8a928d9","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:918b21927a5b111ef3aeb2b6","quote":"章节编号=7.3\n章节标题=安全性评估","quote_sha256":"7683441ce564934de6aafc3d93ede754a6215e0b89814b27f457fba667257c37","source_id":"protocol_full_draft_selection:918b21927a5b111ef3aeb2b6","span_id":"span_sec_7_3"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"安全性终点：治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件发生率。；实验室检查、生命体征及12导联心电图具有临床意义的变化。","quote_sha256":"99133b9298d6b094501b14430ac89a3b690a9aa9acb4bb1df325ea3196a44236","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_safety_endpoint"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究时期：筛选期：最长4周。；双盲治疗期：16周。；安全性随访期：4周。","quote_sha256":"1df9f3c36a7060d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_study_periods"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"访视策略：筛选后于基线/第1天随机；第2、4、8、12、16周进行治疗期访视，第20周进行安全性随访。","quote_sha256":"63eabad83df6668ab707ddc556cc8da06b6cd29646215ef8e6dab242db644044","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_visit_strategy"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"安全性集按实际治疗分析","quote_sha256":"b5d2d8cf9b5ef2e165b4a8f147a26241837bc4615798ce343e781692cefb7879","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_safety_set"}],"evidence_span_ids":["span_sec_7_3","span_safety_endpoint","span_study_periods","span_visit_strategy","span_safety_set"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"heading":"安全性评估","missing_source_classes":[],"proposal_text":"本研究对合成试验药A在成人中重度斑块状银屑病患者中的安全性进行评价。安全性终点包括治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件的发生率，以及实验室检查、生命体征及12导联心电图出现具有临床意义的变化。本研究双盲治疗期为16周，安全性随访期为4周；受试者在双盲治疗期内于第2、4、8、12、16周进行访视，并于第20周进行安全性随访。安全性分析基于安全性集，按受试者实际接受的治疗进行评价，相关安全性资料用于综合评估合成试验药A在目标人群中的安全性特征。","rationale":"支持依据：安全性终点包括治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件发生率，以及实验室检查、生命体征及12导联心电图具有临床意义的变化；双盲治疗期16周、安全性随访期4周、第20周安全性随访；安全性集按实际治疗分析。需医学作者核对：不良事件与严重不良事件的定义、严重程度分级、因果关系评定、报告流程与时限，妊娠相关处理，以及安全性评估在各访视的具体安排。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_bd9d9224d94e0ac8","section_number":"7.3","source_ids":["protocol_full_draft_selection:918b21927a5b111ef3aeb2b6","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]},{"ai_run_id":"airun_20260922042609_f8a928d9","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:918b21927a5b111ef3aeb2b6","quote":"章节编号=7.3.1\n章节标题=生命体征和体格检查","quote_sha256":"e6d017a62e53729f902d2f68ec0085a77aab7663b756eba740b234b2aae42b97","source_id":"protocol_full_draft_selection:918b21927a5b111ef3aeb2b6","span_id":"span_sec_7_3_1"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"安全性终点：治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件发生率。；实验室检查、生命体征及12导联心电图具有临床意义的变化。","quote_sha256":"99133b9298d6b094501b14430ac89a3b690a9aa9acb4bb1df325ea3196a44236","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_safety_endpoint"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究时期：筛选期：最长4周。；双盲治疗期：16周。；安全性随访期：4周。","quote_sha256":"1df9f3c36a7060d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_study_periods"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"访视策略：筛选后于基线/第1天随机；第2、4、8、12、16周进行治疗期访视，第20周进行安全性随访。","quote_sha256":"63eabad83df6668ab707ddc556cc8da06b6cd29646215ef8e6dab242db644044","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_visit_strategy"}],"evidence_span_ids":["span_sec_7_3_1","span_safety_endpoint","span_study_periods","span_visit_strategy"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"heading":"生命体征和体格检查","missing_source_classes":[],"proposal_text":"生命体征和体格检查是本研究安全性评价的组成部分。安全性终点包括生命体征出现具有临床意义的变化；体格检查结果用于评估成人中重度斑块状银屑病受试者的临床状况，并为安全性评价提供支持。本研究双盲治疗期为16周，其后为4周安全性随访期，受试者在完成双盲治疗期后于第20周接受安全性随访访视。生命体征和体格检查结果与其他安全性数据一并用于安全性评价。","rationale":"支持依据：生命体征具有临床意义的变化属于安全性终点；研究设16周双盲治疗期与4周安全性随访期，第20周为安全性随访访视。需医学作者核对：生命体征与体格检查的测量项目、实施时点、测量方法及临床意义判定标准。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_90b6de05a57a5bcc","section_number":"7.3.1","source_ids":["protocol_full_draft_selection:918b21927a5b111ef3aeb2b6","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]},{"ai_run_id":"airun_20260922042609_f8a928d9","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:918b21927a5b111ef3aeb2b6","quote":"章节编号=7.3.2\n章节标题=心电图检查","quote_sha256":"42efe9bbaa902a277c9525dd9b906968cfc9ec3709c9fcf942387537a45b94f5","source_id":"protocol_full_draft_selection:918b21927a5b111ef3aeb2b6","span_id":"span_sec_7_3_2"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"安全性终点：治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件发生率。；实验室检查、生命体征及12导联心电图具有临床意义的变化。","quote_sha256":"99133b9298d6b094501b14430ac89a3b690a9aa9acb4bb1df325ea3196a44236","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_safety_endpoint"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究时期：筛选期：最长4周。；双盲治疗期：16周。；安全性随访期：4周。","quote_sha256":"1df9f3c36a7060d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_study_periods"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"访视策略：筛选后于基线/第1天随机；第2、4、8、12、16周进行治疗期访视，第20周进行安全性随访。","quote_sha256":"63eabad83df6668ab707ddc556cc8da06b6cd29646215ef8e6dab242db644044","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_visit_strategy"}],"evidence_span_ids":["span_sec_7_3_2","span_safety_endpoint","span_study_periods","span_visit_strategy"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"heading":"心电图检查","missing_source_classes":[],"proposal_text":"12导联心电图检查是本研究安全性评价的组成部分。安全性终点包括12导联心电图出现具有临床意义的变化，相关检查结果用于支持对成人中重度斑块状银屑病受试者的安全性评价。本研究设16周双盲治疗期和4周安全性随访期，第20周为安全性随访访视。12导联心电图检查结果与其他安全性数据一并分析，用于评价合成试验药A的安全性特征。","rationale":"支持依据：12导联心电图具有临床意义的变化属于安全性终点；研究设16周双盲治疗期与4周安全性随访期，第20周为安全性随访访视。需医学作者核对：心电图的采集时点、采集条件、异常结果判定与复核要求。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_bbc8a74bb7965cf9","section_number":"7.3.2","source_ids":["protocol_full_draft_selection:918b21927a5b111ef3aeb2b6","current_project_stud