e","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_project_population"}],"evidence_span_ids":["span_project_phase","span_project_region","span_project_design","span_project_center","span_project_population"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"heading":"保险与赔偿","missing_source_classes":[],"proposal_text":"本研究为在中国开展的多中心III期确证性临床研究，研究过程中涉及的保险与赔偿安排以受试者权益保护为基础，并应与适用法律法规、伦理委员会审查意见及知情同意文件中对受试者的说明保持一致。与本研究相关的保险、赔偿及受试者保障信息应在知情同意过程中向受试者充分告知，确保受试者在决定参加研究前能够获得必要信息。","rationale":"已确认项目事实支持研究背景；允许来源未提供本项目保险范围、赔偿条件、申请路径、联系人和知情同意告知细节。医学作者需核对保险与赔偿安排，并确保与适用法律法规、伦理审查意见和知情同意文件一致。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_cb95bcbc11a174bb","section_number":"11.5","source_ids":["protocol_full_draft_selection:b0a76ed0cd46607a5feb2920","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:2db65207908661","company_corpus:cms_cn_protocol_corpus_20260715_v1:72548c417a8f5c","company_corpus:cms_cn_protocol_corpus_20260715_v1:4e86a5ea954c95","company_corpus:cms_cn_protocol_corpus_20260715_v1:df064f51d3d147","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67"]},{"ai_run_id":"airun_20260922044230_ab81ac64","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究分期：III期","quote_sha256":"5ac919b18530a35e6df200dbf04b4bc9fbd8d00da2c279aa58a1ff849584b451","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_project_phase"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"开发区域：中国","quote_sha256":"cff843d358ea50e7e53ede8d1eba9b9d23baa740d2cd2134679e6483c3e50b76","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_project_region"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"总体研究设计：平行组（parallel assignment）、双盲、安慰剂对照、随机","quote_sha256":"671a62a354113705569b311f82cdff13e6dc35ab5faac84b8993f18ac7fe7ebc","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_project_design"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"中心模式：多中心","quote_sha256":"2cfa68bc992967c797bbd3113b5e0d0844d660a2050095a31f08358c5e40311f","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_project_center"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"适应症：成人中重度斑块状银屑病","quote_sha256":"dea7d22754107be0e06f2a8925034c9cf46e7a270521c79bf1c536d94b1cb3ae","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_project_population"},{"locator":"section:文档开头|block:4|chunk:1","quote":"本方案中所包含的所有信息归申办方所有，因此，仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构进行审阅。","quote_sha256":"a95f171292054da4c0e730a5808f9cf1db173b3e9368862f63a2a3c3172a88c6","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","span_id":"span_conf_ownership"}],"evidence_span_ids":["span_project_phase","span_project_region","span_project_design","span_project_center","span_project_population","span_conf_ownership"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":5},"heading":"研究文件、监查和管理","missing_source_classes":[],"proposal_text":"本研究为在中国开展的多中心III期确证性临床研究，研究文件、监查和管理应遵循适用监管要求，覆盖研究方案及其修订、伦理审查文件、知情同意文件以及研究过程中形成的关键记录，确保研究按照经伦理委员会批准的方案实施并保持数据的完整性、准确性和可溯源性。研究相关信息应按照保密要求仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构审阅。","rationale":"已确认项目事实支持多中心III期研究背景；监管参考来源支持研究信息仅向研究者、合作研究者、伦理委员会和监督管理部门等审阅的保密表述。医学作者需核对监查计划、文件保存期限、数据管理职责和源数据核查流程等具体安排。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_df24f522766abc57","section_number":"12","source_ids":["protocol_full_draft_selection:b0a76ed0cd46607a5feb2920","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:2db65207908661","company_corpus:cms_cn_protocol_corpus_20260715_v1:72548c417a8f5c","company_corpus:cms_cn_protocol_corpus_20260715_v1:4e86a5ea954c95","company_corpus:cms_cn_protocol_corpus_20260715_v1:df064f51d3d147","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67"]}],"source_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:b0a76ed0cd46607a5feb2920","source_id":"protocol_full_draft_selection:b0a76ed0cd46607a5feb2920","source_type":"protocol_full_draft_selection","text_sha256":"3d9f17216edd35a8c6ddcc6b2d4c6732dc7c919c9958fb6d4c44cda9cf5bda81"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","source_type":"current_project_study_definition","text_sha256":"787313a6f081b1c9afdf03800feb1c50c317aa4aa4f0c3884e924b0594e666da"},{"locator":"section:4.3 终止研究标准|block:850|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:2db65207908661","source_type":"company_protocol_reference_corpus","text_sha256":"f19661bef01070eab86ff5119d563d2a2c9cec40e46037583009193ebb9b3555"},{"locator":"section:终止研究|block:316|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:72548c417a8f5c","source_type":"company_protocol_reference_corpus","text_sha256":"057bf321f30180105f30781bb0d989a31b06495a3236bef84c0c313958c0fa80"},{"locator":"section:3.5.4 提前退出研究|block:556|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:4e86a5ea954c95","source_type":"company_protocol_reference_corpus","text_sha256":"3c04b77ba21334b1f8bd03c450ef947382ab158a7062d8441c012b4d74077fc7"},{"locator":"section:8.研究者、申办者、伦理委员会/机构委员会因安全性、监管或其他原因要求试验参与者退出研究。|block:328|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:df064f51d3d147","source_type":"company_protocol_reference_corpus","text_sha256":"d5df3f4866c67ed3d53fc05c1c65b34556cf4cd8587f487df447908c0ede9117"},{"locator":"section:文档开头|block:4|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","source_type":"company_protocol_reference_corpus","text_sha256":"dfc9fceb41db9d941df0e3715483adaa069da4f1953600a6a37a56d7f81373dd"}]}