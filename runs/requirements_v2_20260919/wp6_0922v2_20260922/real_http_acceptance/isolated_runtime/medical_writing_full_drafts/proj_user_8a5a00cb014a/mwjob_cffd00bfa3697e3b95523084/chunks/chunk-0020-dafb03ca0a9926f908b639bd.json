{"ai_run_id":"airun_20260922044729_db37d3dc","chunk_index":20,"job_id":"mwjob_cffd00bfa3697e3b95523084","precondition_digest":"f483172f30b055a8b1e1a0031ff9bcf82f903ed2e0e2f5846600e2e4c3920808","project_id":"proj_user_8a5a00cb014a","schema_version":"protocol_full_draft_chunk_v8","section_ids":["mwsec_greenfield_proj_user_8a5a00cb014a_804f56b825b06d7c","mwsec_greenfield_proj_user_8a5a00cb014a_071dc7d1c41ba2f5","mwsec_greenfield_proj_user_8a5a00cb014a_b9e92c2f0bf08455","mwsec_greenfield_proj_user_8a5a00cb014a_02f0fcfe33d65d34"],"sections":[{"ai_run_id":"airun_20260922044729_db37d3dc","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:dafb03ca0a9926f908b639bd","quote":"SECTION_ID=mwsec_greenfield_proj_user_8a5a00cb014a_804f56b825b06d7c\n章节编号=12.5\n章节标题=关键角色和研究管理\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"bd69435e734a876488ee97fdc72aed0a5f85013ef4ea808282cd7840aa159b60","source_id":"protocol_full_draft_selection:dafb03ca0a9926f908b639bd","span_id":"span_s1_12_5"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"总体研究设计：平行组（parallel assignment）、双盲、安慰剂对照、随机\n目标研究人群：成人中重度斑块状银屑病患者\n随机化方式：随机分配\n对照措施：匹配安慰剂\n分配模型：平行组（parallel assignment）\n中心模式：多中心","quote_sha256":"9546677f90c38af4d30a7b2ba79669a1527fc3fc8f8caced3e12f9f4b35c0ec4","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_proj_design"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究时期：筛选期：最长4周。；双盲治疗期：16周。；安全性随访期：4周。","quote_sha256":"1df9f3c36a7060d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_proj_periods"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"访视策略：筛选后于基线/第1天随机；第2、4、8、12、16周进行治疗期访视，第20周进行安全性随访。PASI和sPGA于基线及第4、8、12、16周评价。","quote_sha256":"8c7a570d51b842be51c8689066b3d6fe50030b8229d96708644c920d085e82c5","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_proj_visit"},{"locator":"section:数据质量保证|block:932|chunk:1","quote":"研究中心质量保证人员对数据转移文件、统计报告数据进行抽查，保证数据准确无误。申办者根据需要，结合试验进展情况及质量控制人员/监查员的核查结果，可对上述临床研究过程产生的数据进行不同范畴的稽查。","quote_sha256":"84e30f7a8178b6ecebc4f6b8272c753029708f78a4aea8f02201d0abf4225b0b","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db","span_id":"span_corpus_qc"}],"evidence_span_ids":["span_s1_12_5","span_proj_design","span_proj_periods","span_proj_visit","span_corpus_qc"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":3},"heading":"关键角色和研究管理","missing_source_classes":[],"proposal_text":"本研究为多中心、双盲的III期临床研究，研究实施涉及申办者、各研究中心及其研究者，以及承担监查和质量控制职能的人员。各研究中心在统一研究方案下开展受试者筛选、治疗、随访和安全性观察。研究管理覆盖筛选期、16周双盲治疗期和4周安全性随访期，受试者在第20周进行安全性随访。由于研究采用双盲设计，研究管理过程中需要保持盲态，参与研究实施和监查的人员应避免接触可能破坏盲态的信息。关键角色之间的沟通围绕受试者安全、方案偏离和研究数据完整性展开，并为质量控制、研究和研究中心关闭提供支持。","rationale":"依据已确认的多中心、双盲III期设计以及筛选期最长4周、双盲治疗期16周、安全性随访期4周和第20周安全性随访撰写。具体角色职责、监查安排、盲态维护程序和沟通机制需医学作者核对。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_804f56b825b06d7c","section_number":"12.5","source_ids":["protocol_full_draft_selection:dafb03ca0a9926f908b639bd","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]},{"ai_run_id":"airun_20260922044729_db37d3dc","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:dafb03ca0a9926f908b639bd","quote":"SECTION_ID=mwsec_greenfield_proj_user_8a5a00cb014a_071dc7d1c41ba2f5\n章节编号=12.6\n章节标题=研究和研究中心的关闭\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"f02bcfb183d447e02c687dc5dcd0111daac36f119800b57428c2b9f39c68c42f","source_id":"protocol_full_draft_selection:dafb03ca0a9926f908b639bd","span_id":"span_s1_12_6"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"总体研究设计：平行组（parallel assignment）、双盲、安慰剂对照、随机\n目标研究人群：成人中重度斑块状银屑病患者\n随机化方式：随机分配\n对照措施：匹配安慰剂\n分配模型：平行组（parallel assignment）\n中心模式：多中心","quote_sha256":"9546677f90c38af4d30a7b2ba79669a1527fc3fc8f8caced3e12f9f4b35c0ec4","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_proj_design"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究时期：筛选期：最长4周。；双盲治疗期：16周。；安全性随访期：4周。","quote_sha256":"1df9f3c36a7060d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_proj_periods"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"访视策略：筛选后于基线/第1天随机；第2、4、8、12、16周进行治疗期访视，第20周进行安全性随访。PASI和sPGA于基线及第4、8、12、16周评价。","quote_sha256":"8c7a570d51b842be51c8689066b3d6fe50030b8229d96708644c920d085e82c5","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_proj_visit"}],"evidence_span_ids":["span_s1_12_6","span_proj_design","span_proj_periods","span_proj_visit"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"heading":"研究和研究中心的关闭","missing_source_classes":[],"proposal_text":"研究和研究中心关闭涉及各研究中心完成本中心受试者相关活动后的研究收尾工作。本研究筛选期最长4周，双盲治疗期16周，安全性随访期4周，受试者在第20周进行安全性随访。研究中心关闭的范围包括核对受试者是否完成上述随访安排、整理研究数据和研究文件、汇总方案偏离和安全性信息，并确认研究文件处于可核查状态。多中心研究的关闭工作需要各研究中心与申办者之间保持协调，确保各中心收尾进度和数据质量情况得到汇总。关闭工作围绕受试者安全性随访完成情况、数据清理状态和研究文件完整性展开。","rationale":"依据筛选期最长4周、双盲治疗期16周、安全性随访期4周、第20周安全性随访以及多中心设计撰写。关闭启动条件、执行职责、文件保存期限和研究用药品处置方式需医学作者核对。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_071dc7d1c41ba2f5","section_number":"12.6","source_ids":["protocol_full_draft_selection:dafb03ca0a9926f908b639bd","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]},{"ai_run_id":"airun_20260922044729_db37d3dc","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:dafb03ca0a9926f908b639bd","quote":"SECTION_ID=mwsec_greenfield_proj_user_8a5a00cb014a_b9e92c2f0bf08455\n章节编号=12.7\n章节标题=质量控制与保证\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"8213ecd0d0af1005973f8995ddb142274fed99fa1fd1e5301a25ff7f4acc6b1e","source_id":"protocol_full_draft_selection:dafb03ca0a9926f908b639bd","span_id":"span_s1_12_7"},{"locator":"section:数据质量保证|block:932|chunk:1","quote":"研究中心质量保证人员对数据转移文件、统计报告数据进行抽查，保证数据准确无误。申办者根据需要，结合试验进展情况及质量控制人员/监查员的核查结果，可对上述临床研究过程产生的数据进行不同范畴的稽查。","quote_sha256":"84e30f7a8178b6ecebc4f6b8272c753029708f78a4aea8f02201d0abf4225b0b","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db","span_id":"span_corpus_qc"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"总体研究设计：平行组（parallel assignment）、双盲、安慰剂对照、随机\n目标研究人群：成人中重度斑块状银屑病患者\n随机化方式：随机分配\n对照措施：匹配安慰剂\n分配模型：平行组（parallel assignment）\n中心模式：多中心","quote_sha256":"9546677f90c38af4d30a7b2ba79669a1527fc3fc8f8caced3e12f9f4b35c0ec4","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_proj_design"}],"evidence_span_ids":["span_s1_12_7","span_corpus_qc","span_proj_design"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":1},"heading":"质量控制与保证","missing_source_classes":[],"proposal_text":"质量控制与保证贯穿研究数据的产生、记录、转移和统计分析过程。研究中心质量保证人员对数据转移文件和统计报告数据进行抽查，以支持数据准确无误；申办者结合试验进展以及质量控制人员和监查人员的核查结果，可对临床研究过程产生的数据开展不同范畴的稽查。本研究为多中心、双盲的III期临床研究，质量控制与保证活动覆盖各研究中心及研究数据的汇总分析。质量控制与保证的目的在于支持研究数据的准确性、完整性和可核查性，并为研究中心关闭和研究结论的形成提供依据。","rationale":"依据已确认的多中心、双盲III期设计以及数据转移文件、统计报告数据抽查和稽查的质量保证参考描述撰写。本项目质量控制与保证的具体职责、抽查范围、稽查触发条件和程序需医学作者核对。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_b9e92c2f0bf08455","section_number":"12.7","source_ids":["protocol_full_draft_selection:dafb03ca0a9926f908b639bd","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]},{"ai_run_id":"airun_20260922044729_db37d3dc","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:dafb03ca0a9926f908b639bd","quote":"SECTION_ID=mwsec_greenfield_proj_user_8a5a00cb014a_02f0fcfe33d65d34\n章节编号=14\n章节标题=附录\n章节类型=appendix\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"1f8597d589b4eebee4565b3d5ffe2c4a98fd1f2003f73c1429fd97d2a157bfcc","source_id":"protocol_full_draft_selection:dafb03ca0a9926f908b639bd","span_id":"span_s1_14"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"访视策略：筛选后于基线/第1天随机；第2、4、8、12、16周进行治疗期访视，第20周进行安全性随访。PASI和sPGA于基线及第4、8、12、16周评价。","quote_sha256":"8c7a570d51b842be51c8689066b3d6fe50030b8229d96708644c920d085e82c5","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_proj_visit"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"其他次要终点：第16周PASI评分较基线的变化。；第16周DLQI评分较基线的变化。","quote_sha256":"1f739c14310a6a5f292991854360290460a4b501e71c36ec724647d8123a4023","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_proj_other_secondary"}],"evidence_span_ids":["span_s1_14","span_proj_visit","span_proj_other_secondary"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"heading":"附录","missing_source_classes":[],"proposal_text":"本附录汇总研究实施中使用的评价工具、访视安排和常用术语。PASI和sPGA在基线及第4、8、12、16周进行评价；DLQI用于皮肤病相关生活质量的评价。研究访视包括筛选期最长4周内的筛选访视、基线/第1天随机访视、第2、4、8、12、16周治疗期访视以及第20周安全性随访。缩略语包括PASI、sPGA、DLQI、TEAE和QD等。TEAE指治疗期间出现的不良事件。","rationale":"依据已确认的PASI和sPGA评价时点、DLQI相关次要终点、研究访视安排以及TEAE和QD术语撰写。缩略语完整名称、量表版本、授权状态和培训要求需医学作者核对。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_02f0fcfe33d65d34","section_number":"14","source_ids":["protocol_full_draft_selection:dafb03ca0a9926f908b639bd","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]}],"source_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:dafb03ca0a9926f908b639bd","source_id":"protocol_full_draft_selection:dafb03ca0a9926f908b639bd","source_type":"protocol_full_draft_selection","text_sha256":"9d07413f5ead10854021471587cdc7177062292454313af2371b2d3f05139940"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","source_type":"current_project_study_definition","text_sha256":"787313a6f081b1c9afdf03800feb1c50c317aa4aa4f0c3884e924b0594e666da"},{"locator":"section:数据质量保证|block:932|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db","source_type":"company_protocol_reference_corpus","text_sha256":"84e30f7a8178b6ecebc4f6b8272c753029708f78a4aea8f02201d0abf4225b0b"}]}