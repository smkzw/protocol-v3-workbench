{"ai_run_id":"airun_20260922042041_1c885730","chunk_index":8,"job_id":"mwjob_cffd00bfa3697e3b95523084","precondition_digest":"f483172f30b055a8b1e1a0031ff9bcf82f903ed2e0e2f5846600e2e4c3920808","project_id":"proj_user_8a5a00cb014a","schema_version":"protocol_full_draft_chunk_v8","section_ids":["mwsec_greenfield_proj_user_8a5a00cb014a_f9aff27f50671f3a","mwsec_greenfield_proj_user_8a5a00cb014a_bd1ccf6487d38384","mwsec_greenfield_proj_user_8a5a00cb014a_3edc6ed0268a0557","mwsec_greenfield_proj_user_8a5a00cb014a_f2862d79759a5299"],"sections":[{"ai_run_id":"airun_20260922042041_1c885730","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:0aace9851d633f67df22685c","quote":"章节标题=剂量调整、暂停、恢复与永久停药","quote_sha256":"7dc670134c82e0e5171f0e2cdef1ecb47b79225509146700286268ef9ecfc4a1","source_id":"protocol_full_draft_selection:0aace9851d633f67df22685c","span_id":"es_63_title"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"剂量与给药方案：合成试验药A：100 mg，每日一次（QD）（口服）；第1天至第16周。依从：通过药品计数及受试者日记评价依从性","quote_sha256":"e97da70f0c9a5d6f604a29b6c054d0ed03fc9fd60470293f55ab4afbebddcff0","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_dose"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"匹配安慰剂：每日一次（QD）（口服）；第1天至第16周双盲治疗期。依从：通过药品计数及受试者日记评价依从性","quote_sha256":"6e161fdc710a0a80dfd37e8087ba89849d7bfdb2aa6b1f8d9a2466c304e8fae9","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_placebo_dose"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究时期：筛选期：最长4周。；双盲治疗期：16周。；安全性随访期：4周。","quote_sha256":"1df9f3c36a7060d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_periods"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"安全性终点：治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件发生率。；实验室检查、生命体征及12导联心电图具有临床意义的变化。","quote_sha256":"99133b9298d6b094501b14430ac89a3b690a9aa9acb4bb1df325ea3196a44236","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_safety"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"估计目标策略：治疗策略人群为所有随机受试者；比较第16周PASI 75应答。停药或使用救援治疗按复合策略判定为无应答，其他缺失数据采用无应答填补；报告组间率差及95%置信区间。","quote_sha256":"44f71070d9cdb5b6b69ad6feeeb7fbfeef4aad105693eaa3500bedd537f18414","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_estimand"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"访视策略：筛选后于基线/第1天随机；第2、4、8、12、16周进行治疗期访视，第20周进行安全性随访。PASI和sPGA于基线及第4、8、12、16周评价。","quote_sha256":"8c7a570d51b842be51c8689066b3d6fe50030b8229d96708644c920d085e82c5","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_visits"}],"evidence_span_ids":["es_63_title","es_dose","es_placebo_dose","es_periods","es_safety","es_estimand","es_visits"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"heading":"剂量调整、暂停、恢复与永久停药","missing_source_classes":[],"proposal_text":"本研究的双盲治疗期为16周，研究药物的给药方案为合成试验药A 100 mg口服、每日一次，自第1天持续至第16周；对照组接受匹配安慰剂，给药频率与疗程与试验组一致。研究期间受试者提前停用研究治疗或使用救援治疗的，其第16周疗效数据按预先确定的复合策略判定为无应答。安全性评价涵盖治疗期间出现的不良事件、严重不良事件及导致停药的不良事件发生率，因安全性原因导致的研究治疗停用通过上述安全性终点进行评价。双盲治疗期结束后设有4周安全性随访期，受试者于第20周接受安全性随访。研究治疗的依从性通过药品计数及受试者日记进行评价。","rationale":"支持本节的已确认事实：合成试验药A 100 mg口服、每日一次，第1天至第16周；匹配安慰剂给药频率与疗程一致；双盲治疗期16周；停药或使用救援治疗按复合策略判定为无应答；安全性终点包含导致停药的不良事件发生率；安全性随访期为4周、受试者于第20周接受安全性随访；依从性通过药品计数及受试者日记评价。需医学作者核对：剂量调整的触发条件与幅度、暂停与恢复的判定标准及流程、永久停药的判定标准与停药后处理。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_f9aff27f50671f3a","section_number":"6.3","source_ids":["protocol_full_draft_selection:0aace9851d633f67df22685c","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]},{"ai_run_id":"airun_20260922042041_1c885730","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:0aace9851d633f67df22685c","quote":"章节标题=药物过量与给药错误管理","quote_sha256":"c8ae8f92af66c46261ee67438edaa9d749f2d4236a1dca09db6fca831fc38ba2","source_id":"protocol_full_draft_selection:0aace9851d633f67df22685c","span_id":"es_64_title"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"给药途径：口服\n剂型：口服固体制剂","quote_sha256":"934ce82104590c65bd5a6c1f2adc09af13e196cd58012a3bfc94a42e539bae2d","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_form"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"剂量与给药方案：合成试验药A：100 mg，每日一次（QD）（口服）；第1天至第16周。依从：通过药品计数及受试者日记评价依从性","quote_sha256":"e97da70f0c9a5d6f604a29b6c054d0ed03fc9fd60470293f55ab4afbebddcff0","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_dose"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"匹配安慰剂：每日一次（QD）（口服）；第1天至第16周双盲治疗期。依从：通过药品计数及受试者日记评价依从性","quote_sha256":"6e161fdc710a0a80dfd37e8087ba89849d7bfdb2aa6b1f8d9a2466c304e8fae9","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_placebo_dose"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"安全性终点：治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件发生率。；实验室检查、生命体征及12导联心电图具有临床意义的变化。","quote_sha256":"99133b9298d6b094501b14430ac89a3b690a9aa9acb4bb1df325ea3196a44236","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_safety"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究时期：筛选期：最长4周。；双盲治疗期：16周。；安全性随访期：4周。","quote_sha256":"1df9f3c36a7060d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_periods"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"访视策略：筛选后于基线/第1天随机；第2、4、8、12、16周进行治疗期访视，第20周进行安全性随访。PASI和sPGA于基线及第4、8、12、16周评价。","quote_sha256":"8c7a570d51b842be51c8689066b3d6fe50030b8229d96708644c920d085e82c5","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_visits"}],"evidence_span_ids":["es_64_title","es_form","es_dose","es_placebo_dose","es_safety","es_periods","es_visits"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"heading":"药物过量与给药错误管理","missing_source_classes":[],"proposal_text":"研究药物合成试验药A为口服固体制剂，给药方案为100 mg口服、每日一次，自第1天至第16周，对照组接受相同给药频率与疗程的匹配安慰剂。受试者发生超过方案规定剂量的研究药物暴露，或发生漏服、错服及其他偏离既定给药方案的情形时，需评价其对安全性的影响，并与治疗期间出现的不良事件、严重不良事件及导致停药的不良事件的评价相衔接。双盲治疗期结束后设有4周安全性随访期，受试者于第20周接受安全性随访，为观察此类事件发生后的临床过程提供既定的随访安排。","rationale":"支持本节的已确认事实：研究药物为口服固体制剂、给药途径为口服；给药方案为合成试验药A 100 mg每日一次、第1天至第16周；匹配安慰剂给药频率与疗程一致；安全性终点包含治疗期间不良事件、严重不良事件及导致停药的不良事件发生率；双盲治疗期16周、安全性随访期4周、第20周随访。需医学作者核对：药物过量与给药错误的判定标准、处理流程、报告路径、随访内容及观察要求。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_bd1ccf6487d38384","section_number":"6.4","source_ids":["protocol_full_draft_selection:0aace9851d633f67df22685c","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]},{"ai_run_id":"airun_20260922042041_1c885730","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:0aace9851d633f67df22685c","quote":"章节标题=研究治疗依从性","quote_sha256":"c1322460da1681a1e9f2b33cd0d5cde06fb18a6139c155e1a771d87147f966a5","source_id":"protocol_full_draft_selection:0aace9851d633f67df22685c","span_id":"es_65_title"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"剂量与给药方案：合成试验药A：100 mg，每日一次（QD）（口服）；第1天至第16周。依从：通过药品计数及受试者日记评价依从性","quote_sha256":"e97da70f0c9a5d6f604a29b6c054d0ed03fc9fd60470293f55ab4afbebddcff0","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_dose"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"匹配安慰剂：每日一次（QD）（口服）；第1天至第16周双盲治疗期。依从：通过药品计数及受试者日记评价依从性","quote_sha256":"6e161fdc710a0a80dfd37e8087ba89849d7bfdb2aa6b1f8d9a2466c304e8fae9","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_placebo_dose"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究时期：筛选期：最长4周。；双盲治疗期：16周。；安全性随访期：4周。","quote_sha256":"1df9f3c36a7060d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_periods"}],"evidence_span_ids":["es_65_title","es_dose","es_placebo_dose","es_periods"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"heading":"研究治疗依从性","missing_source_classes":[],"proposal_text":"研究治疗的依从性通过药品计数及受试者日记进行评价，试验组与对照组采用相同的评价方式。试验组受试者自第1天至第16周接受合成试验药A 100 mg口服、每日一次；对照组受试者在同一治疗期内接受匹配安慰剂，每日一次口服。药品计数结果与受试者日记记录共同反映双盲治疗期内研究药物的实际使用情况，为评价研究治疗的依从性提供依据。依从性评价覆盖16周双盲治疗期，与研究治疗的给药方案和疗程相对应。","rationale":"支持本节的已确认事实：依从性通过药品计数及受试者日记评价；试验组给药方案为合成试验药A 100 mg口服、每日一次，第1天至第16周；对照组匹配安慰剂每日一次、第1天至第16周双盲治疗期；双盲治疗期为16周。需医学作者核对：依从性评价的实施时点、药品计数与受试者日记的具体记录要求、依从性判定阈值及低依从性受试者的处理方式。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_3edc6ed0268a0557","section_number":"6.5","source_ids":["protocol_full_draft_selection:0aace9851d633f67df22685c","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]},{"ai_run_id":"airun_20260922042041_1c885730","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:0aace9851d633f67df22685c","quote":"章节标题=合并用药/治疗","quote_sha256":"f294219f432b8068938004b35d0c17215d30bafc4913f754bd5fdc732b4e10b6","source_id":"protocol_full_draft_selection:0aace9851d633f67df22685c","span_id":"es_66_title"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"估计目标策略：治疗策略人群为所有随机受试者；比较第16周PASI 75应答。停药或使用救援治疗按复合策略判定为无应答，其他缺失数据采用无应答填补；报告组间率差及95%置信区间。","quote_sha256":"44f71070d9cdb5b6b69ad6feeeb7fbfeef4aad105693eaa3500bedd537f18414","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_estimand"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"入选标准模块：年龄≥18岁；确诊斑块状银屑病≥6个月；筛选及基线时PASI≥12、受累体表面积≥10%、sPGA≥3；适合接受系统治疗或光疗。","quote_sha256":"3e9ca06af65f6aeb7e28df97f2a93f40d8966553fa5faff3f806e43f762999dd","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_inclusion"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"排除标准模块：非斑块型银屑病为主要表现，或存在可能干扰疗效/安全性评价的其他活动性皮肤病；活动性严重感染；妊娠或哺乳期；研究者判断不适合参加。","quote_sha256":"25de1577631d408629fd83338122249e7d0333f30cafbcf4445c1c9991fc6aee","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_exclusion"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究时期：筛选期：最长4周。；双盲治疗期：16周。；安全性随访期：4周。","quote_sha256":"1df9f3c36a7060d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_periods"}],"evidence_span_ids":["es_66_title","es_estimand","es_inclusion","es_exclusion","es_periods"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"heading":"合并用药/治疗","missing_source_classes":[],"proposal_text":"研究期间受试者使用的合并用药与合并治疗属于安全性评价与疗效评价的组成部分。按照预先确定的估计目标策略，受试者在双盲治疗期内使用救援治疗的，其第16周疗效数据按复合策略判定为无应答，救援治疗的使用情况直接参与主要疗效评价的判定。本研究的目标人群为确诊为斑块状银屑病且疾病严重程度为中重度的成人受试者；入选标准要求受试者适合接受系统治疗或光疗，排除标准排除了存在可能干扰疗效或安全性评价的其他活动性皮肤病以及活动性严重感染的受试者，上述人群特征构成合并用药与合并治疗评价的背景。","rationale":"支持本节的已确认事实：停药或使用救援治疗按复合策略判定为无应答；目标人群为成人中重度斑块状银屑病患者；入选标准要求适合接受系统治疗或光疗；排除标准涵盖可能干扰疗效/安全性评价的其他活动性皮肤病及活动性严重感染；双盲治疗期为16周。需医学作者核对：合并用药与合并治疗的允许与禁止范围、洗脱要求、救援治疗的具体定义与使用条件，以及合并用药与合并治疗的信息记录与报告要求。","review_advisories":["本节提及高影响设计信息（估计目标）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_f2862d79759a5299","section_number":"6.6","source_ids":["protocol_full_draft_selection:0aace9851d633f67df22685c","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]}],"source_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:0aace9851d633f67df22685c","source_id":"protocol_full_draft_selection:0aace9851d633f67df22685c","source_type":"protocol_full_draft_selection","text_sha256":"e800064dc1ffdae25304180895952d64bb2b88c2233db9c95a9842d184fedb1c"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","source_type":"current_project_study_definition","text_sha256":"787313a6f081b1c9afdf03800feb1c50c317aa4aa4f0c3884e924b0594e666da"}]}