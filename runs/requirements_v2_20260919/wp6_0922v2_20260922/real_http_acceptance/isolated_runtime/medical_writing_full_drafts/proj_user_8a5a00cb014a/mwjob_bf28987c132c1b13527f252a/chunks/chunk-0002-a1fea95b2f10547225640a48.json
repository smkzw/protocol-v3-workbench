{"ai_run_id":"airun_20260921213028_71d7bd4b","chunk_index":2,"job_id":"mwjob_bf28987c132c1b13527f252a","precondition_digest":"67d537499c47fe4ae0d786ec4ac18714b2af7d64fc584e8f1b34e1d9f712899a","project_id":"proj_user_8a5a00cb014a","schema_version":"protocol_full_draft_chunk_v5","section_ids":["mwsec_greenfield_proj_user_8a5a00cb014a_2b3b651762037aa3","mwsec_greenfield_proj_user_8a5a00cb014a_0d1c72ba25343e73","mwsec_greenfield_proj_user_8a5a00cb014a_cf9127212cfac33d","mwsec_greenfield_proj_user_8a5a00cb014a_650a3ed48fbc8ff8"],"sections":[{"ai_run_id":"airun_20260921213028_71d7bd4b","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"药物技术类型：small_molecule\n给药途径：口服\n剂型：口服固体制剂\n局部/系统暴露范围：systemic","quote_sha256":"93d70823288385813f38b773b8c6e7bba227a7ed893796844d8834e9f3bae884","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"esp_s2_product"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"适应症：成人中重度斑块状银屑病\n研究分期：III期\n开发区域：中国","quote_sha256":"26dc5dacb53bcf058a380ba70f9daf86ad8e38f9e0c460a83f528a89decb766e","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"esp_s2_indication"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"剂量与给药方案：合成试验药A：100 mg，每日一次（QD）（口服）；第1天至第16周。依从：通过药品计数及受试者日记评价依从性\n匹配安慰剂：每日一次（QD）（口服）；第1天至第16周双盲治疗期。依从：通过药品计数及受试者日记评价依从性","quote_sha256":"94fb65afc774da062ed601e6f161a821a0ac0ae3a448c3184db20ac0caba0782","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"esp_s2_dosing"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"试验干预：试验组接受合成试验药A 100 mg口服，每日一次，连续16周；对照组接受匹配安慰剂。","quote_sha256":"f3eff5ef57b4691ff025db695140e4ead682562786c0dec621edcd256ef28af3","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"esp_s2_intervention"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"对照：匹配安慰剂对照；试验组与安慰剂组按1:1随机分配，双盲治疗16周。","quote_sha256":"bcf69f1343deaa3b4cd6b8ab0fd4fbac84bf974c3118292b17999b1ba93aa172","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"esp_s2_control"}],"evidence_span_ids":["esp_s2_product","esp_s2_indication","esp_s2_dosing","esp_s2_intervention","esp_s2_control"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"heading":"研究药物简介","missing_source_classes":[],"proposal_text":"合成试验药A为小分子药物，剂型为口服固体制剂，给药途径为口服，暴露范围为全身暴露。本研究中，合成试验药A的给药方案为100 mg、每日一次（QD），自第1天起至第16周；匹配安慰剂为每日一次（QD）口服，用于第1天至第16周的双盲治疗期。本研究设置匹配安慰剂对照。合成试验药A拟用于成人中重度斑块状银屑病患者，研究分期为III期，开发区域为中国。研究期间通过药品计数及受试者日记评价依从性。","rationale":"本节依据已确认研究事实中的药物名称、技术类型、剂型、给药途径、暴露范围、剂量方案、匹配安慰剂、依从性评价、适应症、研究分期和开发区域撰写。医学作者需核对药物名称、剂量方案、安慰剂描述及依从性评价方式，并与研究者手册保持一致。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_2b3b651762037aa3","section_number":"2.3","source_ids":["protocol_full_draft_selection:a1fea95b2f10547225640a48","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:367cbc36976ba5","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:d84680fc442c0c"]},{"ai_run_id":"airun_20260921213028_71d7bd4b","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"heading":"非临床研究结果","missing_source_classes":["研究药物非临床研究资料（药理学、毒理学、药代动力学报告）","研究者手册（IB）"],"proposal_text":"","rationale":"本节缺少可写入的非临床研究结果来源；现有来源未提供合成试验药A的药理学、毒理学或药代动力学数据。医学作者需在取得研究者手册或非临床研究报告后完成本节。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_0d1c72ba25343e73","section_number":"2.3.1","source_ids":["protocol_full_draft_selection:a1fea95b2f10547225640a48","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:367cbc36976ba5","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:d84680fc442c0c"]},{"ai_run_id":"airun_20260921213028_71d7bd4b","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"heading":"既往临床研究结果","missing_source_classes":["既往临床研究结果总结或已完成临床试验报告","研究者手册（IB）","已发表临床研究文献或摘要"],"proposal_text":"","rationale":"本节缺少可写入的既往临床研究结果来源；现有来源未提供合成试验药A已完成临床研究的安全性、疗效或剂量探索数据。医学作者需在取得既往临床研究报告或相关文献后完成本节。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_cf9127212cfac33d","section_number":"2.3.2","source_ids":["protocol_full_draft_selection:a1fea95b2f10547225640a48","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:367cbc36976ba5","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:d84680fc442c0c"]},{"ai_run_id":"airun_20260921213028_71d7bd4b","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"heading":"本研究的理论基础","missing_source_classes":["研究药物非临床研究资料（药理学、毒理学、药代动力学报告）","既往临床研究结果与剂量/终点选择依据","目标适应症流行病学与治疗现状文献","PASI、sPGA、DLQI量表授权与验证资料"],"proposal_text":"","rationale":"本节需要作用机制、非临床研究、既往临床研究、流行病学和量表授权资料以论证研究设计的理论基础；现有来源仅提供确证性研究定位及设计事实，不足以形成理论基础正文。医学作者需在取得相关来源后完成本节。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_650a3ed48fbc8ff8","section_number":"2.4","source_ids":["protocol_full_draft_selection:a1fea95b2f10547225640a48","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:367cbc36976ba5","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:d84680fc442c0c"]}],"source_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:a1fea95b2f10547225640a48","source_id":"protocol_full_draft_selection:a1fea95b2f10547225640a48","source_type":"protocol_full_draft_selection","text_sha256":"97d014fb8606cbd66b6b61b1c6d22e1f2f4a827bd24db42d4a3e3d23092232ae"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","source_type":"current_project_study_definition","text_sha256":"787313a6f081b1c9afdf03800feb1c50c317aa4aa4f0c3884e924b0594e666da"},{"locator":"section:3.6.3.3 研究药物的计数|block:620|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","source_type":"company_protocol_reference_corpus","text_sha256":"5d7954edffb46be99638e2135e77631b0c5d64bf28fd8aeb9376a387c2a93b8f"},{"locator":"section:文档开头|block:26|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","source_type":"compan