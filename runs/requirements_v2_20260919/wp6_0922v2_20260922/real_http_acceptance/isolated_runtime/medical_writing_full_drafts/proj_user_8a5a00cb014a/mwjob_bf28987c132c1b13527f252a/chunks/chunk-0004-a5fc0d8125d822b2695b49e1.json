n"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"中心模式：多中心","quote_sha256":"2cfa68bc992967c797bbd3113b5e0d0844d660a2050095a31f08358c5e40311f","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_center"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"目标研究人群：成人中重度斑块状银屑病患者","quote_sha256":"a1f2b59730f1d08cde8f6a85d4179e62887b3729f4175c98334b9dafda33e808","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_population"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"试验干预：试验组接受合成试验药A 100 mg口服，每日一次，连续16周；对照组接受匹配安慰剂。","quote_sha256":"f3eff5ef57b4691ff025db695140e4ead682562786c0dec621edcd256ef28af3","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_intervention"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究时期：筛选期：最长4周。；双盲治疗期：16周。；安全性随访期：4周。","quote_sha256":"1df9f3c36a7060d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_epochs"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"主要研究目的：评价合成试验药A相较安慰剂治疗成人中重度斑块状银屑病的疗效。","quote_sha256":"91f9668c833c01c737e00948c18613521366f596752872eef9fc69a09e681b8f","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_objective_primary"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"次要研究目的：评价合成试验药A对皮损清除程度及皮肤病相关生活质量的影响。","quote_sha256":"f60b7980df919c77b6b4674e5a8a1013c4753590e096ca6566a70adbd1e9b6e4","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_objective_secondary"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"对照：匹配安慰剂对照；试验组与安慰剂组按1:1随机分配，双盲治疗16周。","quote_sha256":"bcf69f1343deaa3b4cd6b8ab0fd4fbac84bf974c3118292b17999b1ba93aa172","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_random_ratio"}],"evidence_span_ids":["span_sel_41","span_def_design","span_def_phase","span_def_region","span_def_center","span_def_population","span_def_intervention","span_def_epochs","span_def_objective_primary","span_def_objective_secondary","span_def_random_ratio"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":10},"heading":"总体设计","missing_source_classes":[],"proposal_text":"本研究为在中国开展的多中心、随机、双盲、安慰剂对照的III期确证性临床研究，采用平行组设计，评价合成试验药A治疗成人中重度斑块状银屑病的疗效并评估其安全性。目标研究人群为确诊为斑块状银屑病、疾病严重程度为中重度的成人受试者。受试者按1:1的比例随机分配至试验药组或对照组，试验药组接受合成试验药A 100 mg口服、每日一次，对照组接受匹配安慰剂，双盲治疗期均为16周。研究设置筛选期、双盲治疗期和安全性随访期，其中筛选期最长4周，双盲治疗期16周，安全性随访期4周。研究的主要目的为评价合成试验药A相较安慰剂治疗成人中重度斑块状银屑病的疗效，次要目的为评价合成试验药A对皮损清除程度及皮肤病相关生活质量的影响。","rationale":"依据已确认的研究分期、总体研究设计、开发区域、多中心设置、目标研究人群、试验干预及研究时期撰写；平行组随机双盲安慰剂对照设计、100 mg每日一次口服给药、16周双盲治疗期和4周安全性随访均为已确认的项目研究事实。医学作者需核对：研究计划开展的中心数量与地区分布，以及本章节是否需要补充研究阶段示意图。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"required","review_reasons":["本节直接设定高影响设计或研究实施决定（总体设计），请逐卡确认。"],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_b7de17e9668663cc","section_number":"4.1","source_ids":["protocol_full_draft_selection:a5fc0d8125d822b2695b49e1","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:c3e1f164c2e657","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a"]},{"ai_run_id":"airun_20260921214154_c2b66e7d","content_status":"decision_required","decision_items":[{"blocking_section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_57a2ea891245f09c","fact_path":"picos.statistical_strategy","options":[{"label":"固定顺序检验策略","option_id":"opt_fixed_sequence","summary":"按主要终点、关键次要终点的预设顺序依次检验，前一终点达到预设显著性后方可继续检验下一终点，以控制总I类错误。"},{"label":"仅主要终点进行正式假设检验","option_id":"opt_primary_only","summary":"仅对主要终点进行正式假设检验，关键次要终点与其他次要终点结果按描述性统计呈现。"},{"label":"α分配的多重性控制策略","option_id":"opt_alpha_allocation","summary":"将总双侧α在主要终点与关键次要终点之间预先分配，各终点在分配的α水平下检验。"}],"question":"本确证性研究主要终点与关键次要终点的假设检验层级及多重性控制策略应如何规定？","rationale":"固定顺序检验可在控制总I类错误的前提下支持主要终点及关键次要终点的确证性推断，适用于以优效性为目标的III期研究；最终策略需与统计部门及监管沟通确定。","recommended_option_id":"opt_fixed_sequence"},{"blocking_section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_57a2ea891245f09c","fact_path":"picos.estimand_strategy","options":[{"label":"维持现有设定","option_id":"opt_composite_keep","summary":"治疗策略人群为所有随机受试者；停药或使用救援治疗按复合策略判定为无应答，其他缺失数据采用无应答填补，多重插补与观察病例分析作为敏感性分析。"},{"label":"采用治疗策略并调整主分析","option_id":"opt_treatment_policy_primary","summary":"以治疗策略估计目标为主分析框架，主要缺失数据处理以多重插补为主，无应答填补作为敏感性分析。"},{"label":"由统计部门另行确认","option_id":"opt_stats_department","summary":"由统计部门结合监管要求另行确认估计目标、伴发事件处理及缺失数据策略后再定稿。"}],"question":"主要疗效终点的估计目标与缺失数据处理策略应如何在确证性分析中正式规定？","rationale":"现有设定已在已确认事实中形成复合策略判定与无应答填补的主分析框架，可保持与主要终点定义一致；如需调整为治疗策略估计目标，应与统计部门及监管沟通后确认。","recommended_option_id":"opt_composite_keep"}],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:a5fc0d8125d822b2695b49e1","quote":"章节编号=4.2.1\n章节标题=确证性设计与假设依据\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"2771b80243193f5cc252eaa2ab80917f99ee3a7ef8d73f6fda7ab49f1bc55261","source_id":"protocol_full_draft_selection:a5fc0d8125d822b2695b49e1","span_id":"span_sel_421"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"内在研究目的：确证性研究","quote_sha256":"9910bf06ee75c8853c143b11ec7df385f95306b1d5f76e729515dd9609db0a9c","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_purpose"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"主要研究目的：评价合成试验药A相较安慰剂治疗成人中重度斑块状银屑病的疗效。","quote_sha256":"91f9668c833c01c737e00948c18613521366f596752872eef9fc69a09e681b8f","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_objective_primary"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"主要终点：第16周达到PASI 75应答（较基线PASI评分改善≥75%）的受试者比例。","quote_sha256":"0726a50bb0c8f1c5ec79b9e21b343bfd08fddc0a595315a5c8e3769df01ce9a7","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_primary_endpoint"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"样本量策略：假设第16周PASI 75应答率试验组为60%、安慰剂组为30%，双侧α=0.05、把握度90%、1:1随机，并考虑15%脱落，共计划入组132例（每组66例）。","quote_sha256":"2088842f2548655845b43f017bb904dc2663a94d1a5c7a802e7adf8daa68b0d2","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_sample"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"统计分析策略：全分析集按随机分组采用CMH方法比较主要终点，报告应答率差、95%置信区间和P值，以优效性为目标。主要缺失处理采用无应答填补，并以多重插补和观察病例分析进行敏感性分析；安全性集按实际治疗分析。不开展期中分析。","quote_sha256":"ccd7b348358b71793f3761994bf0e928e73abcd319f577b74f5285d5c99e3b7c","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_stats"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"样本量再估计是否计划：否","quote_sha256":"913a62236e4f4332a7188562f2625d53aa7f770cea155664564c5fb821a98efd","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_sample_reest"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"估计目标策略：治疗策略人群为所有随机受试者；比较第16周PASI 75应答。停药或使用救援治疗按复合策略判定为无应答，其他缺失数据采用无应答填补；报告组间率差及95%置信区间。","quote_sha256":"44f71070d9cdb5b6b69ad6feeeb7fbfeef4aad105693eaa3500bedd537f18414","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_estimand"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"关键次要终点：第16周sPGA达到0或1且较基线改善≥2级的受试者比例。；第16周达到PASI 90应答的受试者比例。","quote_sha256":"9ebc192fbc05715cf7f717f7f5899cd368f8790a1c880b7a2bff3665ad9ac302","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_key_secondary"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"其他次要终点：第16周PASI评分较基线的变化。；第16周DLQI评分较基线的变化。","quote_sha256":"1f739c14310a6a5f292991854360290460a4b501e71c36ec724647d8123a4023","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_other_secondary"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"安全性终点：治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件发生率。；实验室检查、生命体征及12导联心电图具有临床意义的变化。","quote_sha256":"99133b9298d6b094501b14430ac89a3b690a9aa9acb4bb1df325ea3196a44236","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_safety"}],"evidence_span_ids":["span_sel_421","span_def_purpose","span_def_objective_primary","span_def_primary_endpoint","span_def_sample","span_def_stats","span_def_sample_reest","span_def_estimand","span_def_key_secondary","span_def_other_secondary","span_def_safety"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":10},"heading":"确证性设计与假设依据","missing_source_classes":[],"proposal_text":"本研究为确证性研究，研究目的为评价合成试验药A相较安慰剂治疗成人中重度斑块状银屑病的疗效。主要疗效终点为第16周达到PASI 75应答（较基线PASI评分改善≥75%）的受试者比例。样本量估算假设试验组第16周PASI 75应答率为60%、安慰剂组为30%，采用双侧α=0.05、把握度90%、1:1随机，并考虑15%脱落，共计划入组132例，每组66例。估计目标策略规定治疗策略人群为所有随机受试者，比较第16周PASI 75应答；停药或使用救援治疗按复合策略判定为无应答，其他缺失数据采用无应答填补，并报告组间率差及95%置信区间。主要分析按全分析集、以随机分组采用CMH方法比较主要终点，报告应答率差、95%置信区间和P值，以优效性为目标；主要缺失处理采用无应答填补，并以多重插补和观察病例分析进行敏感性分析；安全性集按实际治疗分析。本研究不开展期中分析，也不计划样本量再估计。关键次要终点为第16周sPGA达到0或1且较基线改善≥2级的受试者比例，以及第16周达到PASI 90应答的受试者比例；其他次要终点包括第16周PASI评分较基线的变化和第16周DLQI评分较基线的变化。安全性终点包括治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件发生率，以及实验室检查、生命体征及12导联心电图具有临床意义的变化。","rationale":"依据已确认的确证性研究目的、主要终点、样本量假设、统计分析策略及估计目标策略撰写；60%与30%的第16周PASI 75应答率假设、双侧α=0.05、90%把握度、15%脱落率、132例（每组66例）、CMH检验方法及不开展期中分析和样本量再估计均为已确认的项目研究事实。多重性控制与假设检验层级、以及主要终点估计目标的正式表述尚未在已确认事实中规定，已列为决定项；医学作者还需核对效应量假设的临床依据是否需引用既往研究或文献。","review_advisories":["本节提及高影响设计信息（α、主要终点、估计目标、期中分析、样本量、计划入组）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"required","review_reasons":["本节直接设定高影响设计或研究实施决定（确证性设计与假设依据），请逐卡确认。"],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_57a2ea891245f09c","section_number":"4.2.1","source_ids":["protocol_full_draft_selection:a5fc0d8125d822b2695b49e1","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:c3e1f164c2e657","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a"]},{"ai_run_id":"airun_20260921214154_c2b66e7d","content_status":"decision_required","decision_items":[{"blocking_section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_a72266096758d298","fact_path":"design.randomization","options":[{"label":"中央随机化系统加分层区组随机化","option_id":"opt_central_stratified","summary":"通过中央随机化系统实施分层区组随机化，按关键预后因素分层并设置适当区组长度，以同时实现分配隐藏与组间均衡。"},{"label":"中央随机化系统加简单随机化","option_id":"opt_central_simple","summary":"通过中央随机化系统实施简单随机化，不设置分层因素，依靠样本量保障组间均衡。"},{"label":"其他经确认的分配隐藏方式","option_id":"opt_other_allocation_concealment","summary":"采用密封信封等其他可保障分配隐藏的方式实施随机分配，并预先确认操作与记录要求。"}],"question":"本项目的随机化实施方式、分层因素与分配隐藏机制应如何规定？","rationale":"中央随机化系统加分层区组随机化可同时满足分配隐藏与关键预后因素均衡的需求，适合多中心确证性研究；最终分层因素需结合人群特征与统计部门意见确定。","recommended_option_id":"opt_central_stratified"}],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:a5fc0d8125d822b2695b49e1","quote":"章节编号=4.3\n章节标题=随机化\n章节类型=section\n当前正文=采用随机化分配。随机分配","quote_sha256":"11cec80ac014bbe318b65fe063ccdf8c245c6b649392c6199d2f11b0cf14cc5a","source_id":"protocol_full_draft_selection:a5fc0d8125d822b2695b49e1","span_id":"span_sel_43"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"随机化方式：随机分配","quote_sha256":"a0b434e0929aba98b91027a87aab6b9dc58df4c52aeb8d9e9de686bf28f2cd5a","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_randomization"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"对照：匹配安慰剂对照；试验组与安慰剂组按1:1随机分配，双盲治疗16周。","quote_sha256":"bcf69f1343deaa3b4cd6b8ab0fd4fbac84bf974c3118292b17999b1ba93aa172","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_random_ratio"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"中心模式：多中心","quote_sha256":"2cfa68bc992967c797bbd3113b5e0d0844d660a2050095a31f08358c5e40311f","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_center"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"访视策略：筛选后于基线/第1天随机；第2、4、8、12、16周进行治疗期访视，第20周进行安全性随访。PASI和sPGA于基线及第4、8、12、16周评价。","quote_sha256":"8c7a570d51b842be51c8689066b3d6fe50030b8229d96708644c920d085e82c5","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_visit"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"内在研究目的：确证性研究","quote_sha256":"9910bf06ee75c8853c143b11ec7df385f95306b1d5f76e729515dd9609db0a9c","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_purpose"}],"evidence_span_ids":["span_sel_43","span_def_randomization","span_def_random_ratio","span_def_center","span_def_visit","span_def_purpose"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"heading":"随机化","missing_source_classes":[],"proposal_text":"本研究采用随机化分配，受试者在基线/第1天按1:1的比例随机分配至试验药组或对照组。随机分配在双盲治疗期开始前完成，目的是使两组在已知和未知的基线特征上尽可能保持均衡，减少选择偏倚，为确证性疗效评价提供可靠基础。本研究为多中心研究，各中心应采用统一的随机化规则分配受试者。随机分配的实施应保障分配隐藏，确保随机分配序列在揭盲前不被泄露，并保持随机化过程的可追溯性。","rationale":"依据已确认的随机化方式、1:1随机比例、多中心设置、基线/第1天随机时点及16周双盲治疗期撰写；随机化的具体实施方法、分层因素与分配隐藏机制尚未在已确认研究事实中规定，正文仅采用不含具体系统和固定方法的表述，相关选择已列为决定项供上游确认。","review_advisories":[],"review_level":"required","review_reasons":["本节直接设定高影响设计或研究实施决定（随机化），请逐卡确认。"],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_a72266096758d298","section_number":"4.3","source_ids":["protocol_full_draft_selection:a5fc0d8125d822b2695b49e1","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:c3e1f164c2e657","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a"]},{"ai_run_id":"airun_20260921214154_c2b66e7d","content_status":"decision_required","decision_items":[{"blocking_section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_818d6b6aa87464a2","fact_path":"design.blinding","options":[{"label":"通过中央随机化/药物管理系统实施紧急揭盲","option_id":"opt_iwrs","summary":"在必须知晓治疗分配时通过中央随机化/药物管理系统申请紧急揭盲，系统记录揭盲人员、原因和时间。"},{"label":"通过密封的应急揭盲信封实施","option_id":"opt_sealed_envelope","summary":"为受试者准备密封的应急揭盲信封，仅在必须知晓治疗分配时按预定流程开启并记录。"},{"label":"通过预先指定的揭盲审查流程获取治疗分配","option_id":"opt_reviewed_release","summary":"由预先指定的流程审核紧急揭盲请求，经确认必要性后提供治疗分配信息并留存记录。"}],"question":"本项目的紧急揭盲实施方式应如何规定？","rationale":"中央随机化/药物管理系统可在保障紧急揭盲可及性的同时实现权限控制与操作记录，便于维持盲态与审计追踪；最终方式需结合本项目采用的随机化系统确定。","recommended_option_id":"opt_iwrs"}],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:a5fc0d8125d822b2695b49e1","quote":"章节编号=4.4\n章节标题=盲法与揭盲\n章节类型=section\n当前正文=本研究采用双盲设计。","quote_sha256":"7662b497258064bbd4245f644e4ed5814057c21b795c4ccc2af9444ff504d348","source_id":"protocol_full_draft_selection:a5fc0d8125d822b2695b49e1","span_id":"span_sel_44"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"总体研究设计：平行组（parallel assignment）、双盲、安慰剂对照、随机","quote_sha256":"671a62a354113705569b311f82cdff13e6dc35ab5faac84b8993f18ac7fe7ebc","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_design"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"对照措施：匹配安慰剂","quote_sha256":"1cafd7b3b8755010d178eb3fa7d8660de3d2c9f3a15eedfd1f8bbf4194f91a9b","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_matching"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究时期：筛选期：最长4周。；双盲治疗期：16周。；安全性随访期：4周。","quote_sha256":"1df9f3c36a7060d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_epochs"}],"evidence_span_ids":["span_sel_44","span_def_design","span_def_matching","span_def_epochs"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"heading":"盲法与揭盲","missing_source_classes":[],"proposal_text":"本研究采用双盲设计。受试者与参与研究实施和评价的研究人员对治疗分配保持盲态。试验药组与对照组分别接受合成试验药A或匹配安慰剂，两种治疗在外观、包装和给药方式上保持一致，以保障双盲的实施。双盲治疗期为16周。盲态应在双盲治疗期内持续保持；揭盲应按照预先确定的揭盲安排实施，以保障受试者安全并尽量控制对试验完整性的影响。如遇必须知晓治疗分配才能对受试者进行恰当医疗处理的情况，可实施紧急揭盲，并应完整记录揭盲的理由与处理经过。","rationale":"依据已确认的双盲设计、匹配安慰剂对照、16周双盲治疗期撰写；紧急揭盲的实施系统、操作方式和揭盲后处理尚未在已确认研究事实中规定，正文未将具体揭盲程序写成既定要求，相关决策已列为决定项。","review_advisories":[],"review_level":"required","review_reasons":["本节直接设定高影响设计或研究实施决定（盲法与揭盲），请逐卡确认。"],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_818d6b6aa87464a2","section_number":"4.4","source_ids":["protocol_full_draft_selection:a5fc0d8125d822b2695b49e1","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:c3e1f164c2e657","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a"]}],"source_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:a5fc0d8125d822b2695b49e1","source_id":"protocol_full_draft_selection:a5fc0d8125d822b2695b49e1","source_type":"protocol_full_draft_selection","text_sha256":"4292e9084e95c885fc8c38a4acf4829f948c11a8e2cc692a42d952d273526e47"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","source_type":"current_project_study_definition","text_sha256":"787313a6f081b1c9afdf03800feb1c50c317aa4aa4f0c3884e924b0594e666da"},{"locator":"section:随机和盲法|block:352|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","source_type":"company_protocol_reference_corpus","text_sha256":"8daf6dc46d42155e29ca2768fe326bcf20208390c0e565062d237a9768f12e59"},{"locator":"section:随机和盲法|block:356|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","source_type":"company_protocol_reference_corpus","text_sha256":"9dcf0050e6908f1bf1781d1b4e78bece680543f7bd3b6d430526c8fa0873ec33"},{"locator":"section:研究揭盲|block:464|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","source_type":"company_protocol_reference_corpus","text_sha256":"1541424a072504b13dc999a7346751e32eebb848cc0771bb2ef3908b11c26ea0"},{"locator":"section:个例紧急揭盲|block:471|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:c3e1f164c2e657","source_type":"company_protocol_reference_corpus","text_sha256":"b1d5885b4afe4e5db3e8caef9a6db54129aefdb157084e23f8cc6b089099b16a"},{"locator":"section:6.3.3 揭盲|block:490|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","source_type":"company_protocol_reference_corpus","text_sha256":"561c757e6967fae66f0f9d1043dba3e313bd0ee60a03f2c3c8da5efe892b0128"}]}