1210281a3b8a0:r8:3989470f61c21914","span_id":"sd_route"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"剂量与给药方案：合成试验药A：100 mg，每日一次（QD）（口服）；第1天至第16周。依从：通过药品计数及受试者日记评价依从性","quote_sha256":"e97da70f0c9a5d6f604a29b6c054d0ed03fc9fd60470293f55ab4afbebddcff0","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"sd_dose"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"匹配安慰剂：每日一次（QD）（口服）；第1天至第16周双盲治疗期。依从：通过药品计数及受试者日记评价依从性","quote_sha256":"6e161fdc710a0a80dfd37e8087ba89849d7bfdb2aa6b1f8d9a2466c304e8fae9","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"sd_placebo"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"试验干预：试验组接受合成试验药A 100 mg口服，每日一次，连续16周；对照组接受匹配安慰剂。","quote_sha256":"f3eff5ef57b4691ff025db695140e4ead682562786c0dec621edcd256ef28af3","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"sd_intervention"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"对照：匹配安慰剂对照；试验组与安慰剂组按1:1随机分配，双盲治疗16周。","quote_sha256":"bcf69f1343deaa3b4cd6b8ab0fd4fbac84bf974c3118292b17999b1ba93aa172","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"sd_control"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"试验组与对照组：试验药组；对照组","quote_sha256":"157431c63e9361f3245765695597750d3bda2d2954ab87dacfd794109dc205db","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"sd_groups"}],"evidence_span_ids":["sel_sec_6_1_1","sd_drug","sd_type","sd_form","sd_route","sd_dose","sd_placebo","sd_intervention","sd_control","sd_groups"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":9},"heading":"研究药物信息","missing_source_classes":[],"proposal_text":"合成试验药A为小分子药物，剂型为口服固体制剂，给药途径为口服。其给药方案为100 mg每日一次，治疗期自第1天至第16周。匹配安慰剂采用口服给药，每日一次，覆盖第1天至第16周的双盲治疗期。两种试验用药品的依从性均通过药品计数及受试者日记进行评价。本研究的试验药组接受合成试验药A，对照组接受匹配安慰剂。","rationale":"依据已确认研究事实，本章节写入合成试验药A的药物技术类型、剂型、给药途径、剂量、给药频率、治疗周期，以及匹配安慰剂的给药途径、频率和覆盖周期；同时写入依从性评价方式及试验组与对照组的处理分配。医学作者需核对最终方案中药物名称、剂型、剂量及给药周期与定稿一致。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_469d7df8436fa4a2","section_number":"6.1.1","source_ids":["protocol_full_draft_selection:e306ffe1f086c33875d59197","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","company_corpus:cms_cn_protocol_corpus_20260715_v1:6b24da94f33534","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb9c14bf455dec","company_corpus:cms_cn_protocol_corpus_20260715_v1:6eab08a4bddb3d","company_corpus:cms_cn_protocol_corpus_20260715_v1:f24b1a78f9c3f8"]},{"ai_run_id":"airun_20260922020004_84b48fb3","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"heading":"制备、包装、标签、储存与管理","missing_source_classes":["试验用药品操作手册或药房手册","试验用药品包装与标签说明","试验用药品储存条件及稳定性资料","试验用药品管理计划"],"proposal_text":"","rationale":"现有已确认事实未包含试验用药品制备、包装、标签、储存与管理所需的操作规则、包装标签要求、储存条件或管理流程；已确认的剂型为口服固体制剂，不足以支撑本章节完整正文。医学作者需核对是否已有药房手册、包装标签样稿、储存条件说明或药品管理计划可用于补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_503d4369748f76ae","section_number":"6.1.2","source_ids":["protocol_full_draft_selection:e306ffe1f086c33875d59197","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","company_corpus:cms_cn_protocol_corpus_20260715_v1:6b24da94f33534","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb9c14bf455dec","company_corpus:cms_cn_pro