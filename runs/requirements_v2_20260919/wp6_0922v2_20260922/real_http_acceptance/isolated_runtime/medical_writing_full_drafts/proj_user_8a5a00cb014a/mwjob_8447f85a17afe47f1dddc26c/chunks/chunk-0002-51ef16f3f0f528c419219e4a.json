{"ai_run_id":"airun_20260922015000_86a1170a","chunk_index":2,"job_id":"mwjob_8447f85a17afe47f1dddc26c","precondition_digest":"7349d025237003fc2a71649e47dc3f181ea6e6f1b327c41c9a0c64a4929460d8","project_id":"proj_user_8a5a00cb014a","schema_version":"protocol_full_draft_chunk_v6","section_ids":["mwsec_greenfield_proj_user_8a5a00cb014a_2b3b651762037aa3","mwsec_greenfield_proj_user_8a5a00cb014a_0d1c72ba25343e73","mwsec_greenfield_proj_user_8a5a00cb014a_cf9127212cfac33d","mwsec_greenfield_proj_user_8a5a00cb014a_650a3ed48fbc8ff8"],"sections":[{"ai_run_id":"airun_20260922015000_86a1170a","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:51ef16f3f0f528c419219e4a","quote":"章节编号=2.3\n章节标题=研究药物简介\n章节类型=section\n当前正文=合成试验药A","quote_sha256":"b4bd486112a1a44995254d2e9f782bfadf90ba0f1a8bbab02be567e32862a26c","source_id":"protocol_full_draft_selection:51ef16f3f0f528c419219e4a","span_id":"span_sel_23"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"方案编号：MW-III-AEA61047-DRAFT\n方案版本：草案\n研究题目：合成试验药A用于治疗成人中重度斑块状银屑病的III期临床研究\n试验药物：合成试验药A\n适应症：成人中重度斑块状银屑病\n研究分期：III期\n开发区域：中国\n内在研究目的：确证性研究","quote_sha256":"76dd1164edfeb6275ee6e7cb777db0b433d4598185765672e36adb1252d0aa17","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_identity"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"药物技术类型：small_molecule\n给药途径：口服\n剂型：口服固体制剂\n局部/系统暴露范围：systemic","quote_sha256":"93d70823288385813f38b773b8c6e7bba227a7ed893796844d8834e9f3bae884","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_drug"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"试验干预：试验组接受合成试验药A 100 mg口服，每日一次，连续16周；对照组接受匹配安慰剂。\n剂量与给药方案：合成试验药A：100 mg，每日一次（QD）（口服）；第1天至第16周。依从：通过药品计数及受试者日记评价依从性\n匹配安慰剂：每日一次（QD）（口服）；第1天至第16周双盲治疗期。依从：通过药品计数及受试者日记评价依从性","quote_sha256":"593bba668c7b8876ab4fde41e75ef3db582fd7354f8205c66132c569107988ac","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_regimen"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"对照：匹配安慰剂对照；试验组与安慰剂组按1:1随机分配，双盲治疗16周。","quote_sha256":"bcf69f1343deaa3b4cd6b8ab0fd4fbac84bf974c3118292b17999b1ba93aa172","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_def_compare"}],"evidence_span_ids":["span_sel_23","span_def_identity","span_def_drug","span_def_regimen","span_def_compare"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"heading":"研究药物简介","missing_source_classes":[],"proposal_text":"合成试验药A为本研究的研究药物，用于治疗成人中重度斑块状银屑病。该药物属于小分子药物，剂型为口服固体制剂，经口服途径给药，具有全身暴露特征。在本研究中，试验组受试者接受合成试验药A 100 mg口服，每日一次（QD），自第1天用药至第16周；对照组受试者接受与合成试验药A匹配的安慰剂，给药途径和给药频率与试验组一致，即每日一次口服，持续至第16周双盲治疗期结束。试验组与对照组按1:1随机分配，并在双盲条件下接受治疗。受试者的用药依从性通过药品计数及受试者日记进行评价。","rationale":"本章正文由已确认研究事实支持：试验药物为合成试验药A，适应症为成人中重度斑块状银屑病，药物技术类型为小分子，剂型为口服固体制剂，给药途径为口服，暴露范围为全身；试验组给药为100 mg每日一次、第1天至第16周，对照组为匹配安慰剂且给药频率和时期一致；依从性通过药品计数及受试者日记评价。医学作者需核对：药物作用机制、规格、贮存与配制信息，匹配安慰剂的外观与包装等匹配属性，以及本章是否需纳入药物管理相关要求；上述内容不在已确认研究事实范围内。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_2b3b651762037aa3","section_number":"2.3","source_ids":["protocol_full_draft_selection:51ef16f3f0f528c419219e4a","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:367cbc36976ba5","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:d84680fc442c0c"]},{"ai_run_id":"airun_20260922015000_86a1170a","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"heading":"非临床研究结果","missing_source_classes":["研究药物非临床研究资料（药理学与毒理学研究报告）","研究者手册（IB）非临床研究部分"],"proposal_text":"","rationale":"允许来源中没有合成试验药A的药理学或毒理学研究资料，也没有研究者手册中的非临床研究内容，本章缺少可直接引用的非临床证据，正文保持为空。医学作者需补充研究药物非临床研究报告或研究者手册非临床部分后另行撰写。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_0d1c72ba25343e73","section_number":"2.3.1","source_ids":["protocol_full_draft_selection:51ef16f3f0f528c419219e4a","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:367cbc36976ba5","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:d84680fc442c0c"]},{"ai_run_id":"airun_20260922015000_86a1170a","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"heading":"既往临床研究结果","missing_source_classes":["研究药物既往临床研究资料（已完成或正在进行的临床试验结果）","研究者手册（IB）临床研究部分","研究药物人体药代动力学与安全性数据"],"proposal_text":"","rationale":"允许来源中没有合成试验药A的既往人体研究数据，包括已完成或正在进行的临床试验结果及人体药代动力学与安全性资料，本章缺少可直接引用的既往临床证据，正文保持为空。医学作者需补充既往临床研究报告或研究者手册临床部分后另行撰写。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_cf9127212cfac33d","section_number":"2.3.2","source_ids":["protocol_full_draft_selection:51ef16f3f0f528c419219e4a","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","company_corpus:cms_cn_protocol_corpus_2026