t_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"主要分析集为FAS；主要终点采用ANCOVA（基线log NT-proBNP为协变量）比较各剂量组与安慰剂组第12周变化，报告几何均值比与90%CI；安全性按SAS描述；无确证性假设检验。","quote_sha256":"6761a9b7aecbd75032ab32a3c52445a857daac1dd4639f1ea608fde1de442bff","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_stat_01"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"安全性按SAS描述；无确证性假设检验。","quote_sha256":"f0e4d56ce52224a2ec2797046c2bcb42b7e603de31e8387571a627f0993d1e71","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_stat_02"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"主要分析集为FAS","quote_sha256":"c5884e8537c333723c983013957d7a9633c73074ea69eb58a727b3b67b751b41","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_stat_03"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"每组约40例（共160例）可在双侧α=0.10下提供约80%把握检测组间差异；含约10%脱落补偿。","quote_sha256":"05ddb65548fe3856393aa5e93d253c6d82c45cd18bab3e99792c6329c28de402","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_stat_04"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"各组按1:1:1:1随机；背景GDMT按指南维持稳定。","quote_sha256":"11703ae792bcf0472032409b93b3f1d9396929248ed8481b07f37fd9c946b598","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_stat_05"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"不良事件（AE）与严重不良事件（SAE）发生率（至末次给药后28天）","quote_sha256":"c611d9ba30c95546ffa3e799347fbd198ba8fc4846c9e249a841a33b3594d437","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_stat_06"}],"evidence_review_advisories":[],"evidence_span_ids":["es_stat_01","es_stat_02","es_stat_03","es_stat_04","es_stat_05","es_stat_06"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"确认ANCOVA模型协变量集合、多重比较校正策略、亚组分析范围及敏感性分析方案","category":"source_missing","gap_id":"gap_stat_01","missing_source_classes":["项目统计分析计划（SAP）详细版本"],"target":"9节统计分析方法细节"},{"action":"确认SAS中安全性描述的具体分类标准、汇总层级及是否需要按剂量组或系统器官分类（SOC）进行描述","category":"source_missing","gap_id":"gap_stat_02","missing_source_classes":["项目安全性管理计划（SMP）","项目统计分析计划（SAP）详细版本"],"target":"9节安全性统计描述"}],"heading":"统计分析","missing_source_classes":["项目统计分析计划（SAP）详细版本","项目亚组分析与敏感性分析方案"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂平行对照的II期概念验证与剂量探索研究，设SGC-R23低剂量（2.5mg）、中剂量（5mg）、高剂量（10mg）及安慰剂四个组别，各组按1:1:1:1比例随机分配，总样本量约160例（每组约40例，含约10%脱落补偿）。主要分析集为全分析集（FAS），即所有随机化受试者均纳入主要疗效分析。主要终点为第12周NT-proBNP较基线的百分比变化（中心实验室定量），采用协方差分析（ANCOVA）模型，以基线log NT-proBNP为协变量，比较各SGC-R23剂量组与安慰剂组第12周NT-proBNP的变化，报告几何均值比及其90%置信区间。本研究为探索性研究，无确证性假设检验，双侧α水平设为0.10，每组约40例可在该显著性水平下提供约80%的把握度检测组间差异。安全性分析采用安全性分析集（SAS），以描述性统计方法汇总不良事件（AE）与严重不良事件（SAE）发生率、生命体征、12导联心电图及临床实验室检查异常发生率、症状性低血压发生率，安全性评估窗口为末次给药后28天。本研究不设置期中分析、不设置独立数据监查委员会（DMC）、不设置安全审查委员会（SRC），亦不计划样本量再估计。","rationale":"本章节正文依据项目已确认研究事实中的统计分析策略（FAS、ANCOVA、几何均值比与90%CI、SAS描述、无确证性假设检验）、样本量策略（每组约40例共160例、双侧α=0.10、约80%把握度、10%脱落补偿）、研究设计（四组1:1:1:1随机、双盲、安慰剂对照）、安全性终点定义（AE/SAE至末次给药后28天、生命体征、心电图、实验室检查、症状性低血压）及设计排除项（无期中分析、无DMC、无SRC、无样本量再估计）撰写。需医学团队与统计师确认的事项包括：ANCOVA模型是否需纳入额外协变量（如NYHA分级、基线LVEF、研究中心）、多重比较校正策略、亚组分析与敏感性分析范围、SAS中安全性描述的具体分类与汇总方式、以及90%CI的置信水平选择依据。","review_advisories":["本节复述高影响研究设计（统计分析）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（α、主要终点、期中分析、样本量）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9eb82f07945e_e34a6b3c51c4da32","section_number":"9","source_ids":["protocol_full_draft_selection:fdc540385f52a04b32bb69b8","current_project_study_definition:mwdefinition_8010953a825e6