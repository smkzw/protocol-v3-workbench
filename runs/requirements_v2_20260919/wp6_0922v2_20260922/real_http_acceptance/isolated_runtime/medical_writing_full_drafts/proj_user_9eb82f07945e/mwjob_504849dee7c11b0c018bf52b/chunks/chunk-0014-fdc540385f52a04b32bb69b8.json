ew_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9eb82f07945e_207cc2a3606de937","section_number":"8.6","source_ids":["protocol_full_draft_selection:fdc540385f52a04b32bb69b8","current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:9691f7c94f6c58","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976","company_corpus:cms_cn_protocol_corpus_20260715_v1:9895ed0bd2ffd4","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83"]},{"ai_run_id":"airun_20261003151622_0f46188d","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取本项目AE随访频率、随访终止条件（是否延续至V8之后）、随访记录载体及随访至何种结局的项目专属文件","category":"source_missing","gap_id":"gap_ae_fu_01","missing_source_classes":["项目专属AE随访规程","项目安全性管理计划"],"target":"8.7节全文"}],"heading":"不良事件的随访","missing_source_classes":["项目专属AE随访规程","项目安全性管理计划（SMP）","研究者手册（IB）安全性章节"],"proposal_text":"","rationale":"本章节需要项目专属的AE随访规则，包括随访频率、随访终止条件、随访记录方式及随访至何种结局。当前允许来源中，项目已确认研究事实仅界定安全性评估窗口为'至末次给药后28天'及访视策略含'末次给药后28天安全性随访（V8）'，但未提供AE随访的具体操作规程。公司共享语料中CMS-D017 I期方案提及'在参与者病历和eCRF不良事件上记录不良事件的结局（包括日期）'，但该条款来自I期单药研究，其随访逻辑与本项目12周多次给药设计不匹配，按语料泛化规则不得迁移其临床设计要求。需补充项目专属的AE随访规程方可撰写实质正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9eb82f07945e_7febee04f8af6682","section_number":"8.7","source_ids":["protocol_full_draft_selection:fdc540385f52a04b32bb69b8","current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:9691f7c94f6c58","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976","company_corpus:cms