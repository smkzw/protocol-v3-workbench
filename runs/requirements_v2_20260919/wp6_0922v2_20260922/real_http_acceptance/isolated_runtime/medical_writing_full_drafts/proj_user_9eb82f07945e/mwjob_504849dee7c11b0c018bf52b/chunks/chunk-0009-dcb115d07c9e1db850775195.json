gn"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":7},"gap_items":[{"action":"补充V1至V8各访视的具体评估项目清单（含NT-proBNP采样时点、心电图、实验室检查、生命体征、体格检查、依从性评价等）","category":"source_missing","gap_id":"gap_71_visit_assessments","missing_source_classes":["访视计划表/评估矩阵"],"target":"7.1节各访视评估项目分配"},{"action":"确认剂量递增与安全性暂停规则是否在本章节交叉引用或独立成章，并提供该规则内容","category":"source_missing","gap_id":"gap_71_dose_escalation","missing_source_classes":["剂量递增与安全性暂停规则章节"],"target":"7.1节剂量递增与安全性暂停规则交叉引用"}],"heading":"研究程序","missing_source_classes":["各访视评估项目分配表","剂量递增与安全性暂停规则章节","依从性评价方法","背景GDMT具体药物清单与调整规则"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂平行对照的II期概念验证与剂量探索研究，采用平行组设计，设SGC-R23低剂量组（2.5 mg）、中剂量组（5 mg）、高剂量组（10 mg）及安慰剂对照组，四组按1:1:1:1随机分配。研究全程分为三个时期：筛选期（第-28天至第-1天）、治疗期（第1天至第12周）和安全性随访期（末次给药后28天）。受试者在筛选期完成入排标准评估后，于基线随机访视（V2，第1天）接受随机化并开始每日一次口服给药，连续治疗12周。治疗期内安排第2周、第4周、第8周和第12周门诊访视（V3至V6），第12周同时作为治疗结束访视（V7）。末次给药后28天安排安全性随访访视（V8）。主要疗效评价为第12周NT-proBNP较基线的百分比变化，由中心实验室定量检测；安全性评价涵盖不良事件与严重不良事件发生率、生命体征、12导联心电图、临床实验室检查异常发生率及症状性低血压发生率，安全性数据采集窗口延续至末次给药后28天。背景指南导向药物治疗（GDMT）在整个研究期间按指南维持稳定。","rationale":"研究时期划分、访视编号与时间窗、四组1:1:1:1随机分配、SGC-R23三种剂量及每日一次口服12周、主要终点NT-proBNP第12周变化、安全性终点范围及28天安全性窗口均来源于当前项目已确认研究事实。各访视具体评估项目分配（如哪些访视采集NT-proBNP、哪些进行心电图）和剂量递增与安全性暂停规则的具体内容未在本次来源中给出，需医学经理在访视计划表和剂量递增章节中补充确认。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9eb82f07945e_327879e2414496bf","section_number":"7.1","source_ids":["protocol_full_draft_selection:dcb115d07c9e1db850775195","current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0"]},{"ai_run_id":"airun_20261003142842_e352ca1a","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"研究时期：筛选期（-28至-1天）；治疗期（第1天至第12周）；安全性随访期（末次给药后28天）","quote_sha256":"5f70702e39cadf179a52e4bdcc650c476a9afa7dee7da140adcc51db4fa0c973","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_study_periods"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"入选标准模块：年龄18–75岁，男女不限；慢性心力衰竭（HFrEF），筛选时LVEF≤40%（超声心动图）；NYHA心功能分级II–III级；筛选前已接受稳定剂量GDMT至少4周且筛选期收缩压≥100mmHg","quote_sha256":"5a238dc5207df446c8a4328e3fb7300174af4eb6df0740c9c4492b775736f889","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_inclusion"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"排除标准模块：筛选前6个月内发生心肌梗死、不稳定型心绞痛、卒中或血运重建；筛选时收缩压<100mmHg或>160mmHg；eGFR<30mL/min/1.73m²或ALT/AST>3×ULN；妊娠期、哺乳期女性或不愿采取有效避孕措施者；正在使用或筛选前30天内使用过其他sGC激动剂、PDE5抑制剂或长效硝酸酯类","quote_sha256":"482262c1c881f837ed248b740a35f7bb8cb99b268149bd1c542404523c7fa93d","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_exclusion"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"访视策略：筛选（V1，-28~-1天）、基线随机（V2，D1）、第2/4/8/12周门诊访视（V3–V6）、治疗结束访视（V7，W12）、末次给药后28天安全性随访（V8）。","quote_sha256":"f246ab1e6e3fdcf1be70f34b89965eeaf4ce6f58c8c3616c28603f43768511ad","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_visit_strategy"}],"evidence_review_advisories":[],"evidence_span_ids":["es_study_periods","es_inclusion","es_exclusion","es_visit_strategy"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"补充筛选期需完成的检查项目清单及各检查执行时点","category":"source_missing","gap_id":"gap_711_screening_assessments","missing_source_classes":["筛选期评估项目清单"],"target":"7.1.1节筛选期具体检查项目"},{"action":"确认是否允许重新筛选及重新筛选条件","category":"source_missing","gap_id":"gap_711_rescreening","missing_source_classes":["筛选失败与重新筛选规则"],"target":"7.1.1节筛选失败与重新筛选"},{"action":"确认有效避孕措施的具体定义和妊娠检查日程","category":"source_missing","gap_id":"gap_711_contraception","missing_source_classes":["避孕与妊娠管理方案"],"target":"7.1.1节避孕方法"}],"heading":"筛选期与基线","missing_source_classes":["筛选期检查项目清单","筛选失败与重新筛选规则","筛选期与基线之间重复评估规则","避孕方法具体规定"],"proposal_text":"筛选期自第-28天起至第-1天止，受试者在此期间完成入排标准评估。入选要求包括：年龄18至75岁、男女不限；经超声心动图确认LVEF≤40%的慢性心力衰竭（HFrEF）；NYHA心功能分级II至III级；筛选前已接受稳定剂量GDMT（含ACEI/ARB/ARNI、β受体阻滞剂，有指征者MRA）至少4周；筛选期收缩压≥100 mmHg。排除条件包括：筛选前6个月内发生心肌梗死、不稳定型心绞痛、卒中或血运重建；筛选时收缩压<100 mmHg或>160 mmHg；eGFR<30 mL/min/1.73m²或ALT/AST>3倍正常值上限；妊娠期、哺乳期女性或不愿采取有效避孕措施者；正在使用或筛选前30天内使用过其他sGC激动剂、PDE5抑制剂或长效硝酸酯类。筛选期访视为V1，基线随机访视为V2（第1天），符合全部入选标准且不符合任何排除标准的受试者在V2完成随机化并开始首次给药。","rationale":"筛选期时间窗（-28至-1天）、V1和V2访视安排、入排标准全部条目（含LVEF≤40%超声心动图确认、NYHA II-III、GDMT稳定≥4周、收缩压阈值、6个月心血管事件排除、eGFR和肝酶阈值、30天sGC激动剂/PDE5抑制剂/长效硝酸酯类洗脱）均来源于当前项目已确认研究事实。筛选期具体检查项目清单（如超声心动图执行时点、实验室检查套餐、心电图是否纳入筛选）、筛选失败后重新筛选规则、以及筛选期与基线访视之间是否允许重复评估的说明未在本次来源中提供，需医学经理确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9eb82f07945e_91dc1c57a5ba7407","section_number":"7.1.1","source_ids":["protocol_full_draft_selection:dcb115d07c9e1db850775195","current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0"]},{"ai_run_id":"airun_20261003142842_e352ca1a","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"研究时期：筛选期（-28至-1天）；治疗期（第1天至第12周）；安全性随访期（末次给药后28天）","quote_sha256":"5f70702e39cadf179a52e4bdcc650c476a9afa7dee7da140adcc51db4fa0c973","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_study_periods"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"访视策略：筛选（V1，-28~-1天）、基线随机（V2，D1）、第2/4/8/12周门诊访视（V3–V6）、治疗结束访视（V7，W12）、末次给药后28天安全性随访（V8）。","quote_sha256":"f246ab1e6e3fdcf1be70f34b89965eeaf4ce6f58c8c3616c28603f43768511ad","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_visit_strategy"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"安全性终点：不良事件（AE）与严重不良事件（SAE）发生率（至末次给药后28天）；生命体征、12导联心电图、临床实验室检查异常发生率；症状性低血压发生率","quote_sha256":"baf9dd2250e27943336dfa1e44f2f07081f03e6f2962e0d1e4e9e0edb166421a","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_safety_endpoints"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"试验干预：SGC-R23薄膜衣片口服，每日一次，连续给药12周；随机分配至低、中、高三个剂量组之一。","quote_sha256":"adae024dc20592a9530d7828de86b99b1a90297e941469e4ecf8ab0e585aa8fe","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_intervention"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"主要终点：主要终点：第12周NT-proBNP较基线的百分比变化（中心实验室定量）。","quote_sha256":"ecdbd2ec18da42de13fa283b48360fdd7e97841b2562c69777d5ba1f63a233db","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_primary_endpoint"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"剂量与给药方案：SMOKE-r2-3口服sGC激动剂（SGC-R23）：SGC-R23片 2.5mg/5mg/10mg（剂量组按随机分配），口服每日一次×12周；剂量递增与安全性暂停规则按方案剂量递增章节执行。","quote_sha256":"96a136d8c4f1e3dfbbca8f2359b2f75b86c9466de071b5a147004072c2b92809","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_dose_scheme"}],"evidence_review_advisories":[],"evidence_span_ids":["es_study_periods","es_visit_strategy","es_safety_endpoints","es_intervention","es_primary_endpoint","es_dose_scheme"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"补充V3至V8各访视具体评估项目（NT-proBNP采样、心电图、实验室检查、生命体征、体格检查、依从性评价等）","category":"source_missing","gap_id":"gap_712_visit_assessments","missing_source_classes":["访视计划表/评估矩阵"],"target":"7.1.2节各访视评估项目分配"},{"action":"确认依从性评价方法和频率","category":"source_missing","gap_id":"gap_712_compliance","missing_source_classes":["依从性评价方案"],"target":"7.1.2节依从性评价"},{"action":"确认V7与V8之间是否安排电话随访或远程评估","category":"source_missing","gap_id":"gap_712_remote_assessment","missing_source_classes":["访视计划表/评估矩阵"],"target":"7.1.2节治疗结束至安全性随访之间安排"}],"heading":"治疗期及随访","missing_source_classes":["各访视评估项目分配表","依从性评价方法","治疗结束至安全性随访之间远程评估安排","剂量递增与安全性暂停规则"],"proposal_text":"治疗期自第1天起至第12周止，受试者每日一次口服SGC-R23薄膜衣片（2.5 mg、5 mg或10 mg，按随机分配）或外观一致的安慰剂片，连续给药12周。治疗期内安排第2周、第4周、第8周和第12周门诊访视（V3至V6），第12周访视同时作为治疗结束访视（V7）。安全性随访期自末次给药后延续28天，安排安全性随访访视（V8）。主要疗效评价为第12周NT-proBNP较基线的百分比变化，由中心实验室定量检测。安全性评价涵盖不良事件与严重不良事件发生率、生命体征、12导联心电图、临床实验室检查异常发生率及症状性低血压发生率，安全性数据采集窗口延续至末次给药后28天。背景GDMT在治疗期和随访期内按指南维持稳定。","rationale":"治疗期时长（12周）、给药方案（每日一次口服、三种剂量）、治疗期访视安排（V3至V6对应第2/4/8/12周）、治疗结束访视（V7，W12）、安全性随访期（末次给药后28天，V8）、主要终点（第12周NT-proBNP变化）、安全性终点范围及数据采集窗口均来源于当前项目已确认研究事实。各访视具体评估项目分配（如哪些访视进行NT-proBNP采样、哪些进行心电图或实验室检查）、依从性评价方式、以及治疗结束访视与安全性随访访视之间是否安排电话随访或远程评估未在本次来源中提供，需医学经理确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9eb82f07945e_0573a76478f589ee","section_number":"7.1.2","source_ids":["protocol_full_draft_selection:dcb115d07c9e1db850775195","current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0"]},{"ai_run_id":"airun_20261003142842_e352ca1a","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"补充计划外访视的启动标准（如症状恶化、AE/SAE、依从性问题、剂量调整等）","category":"source_missing","gap_id":"gap_713_trigger_criteria","missing_source_classes":["计划外访视操作规范"],"target":"7.1.3节计划外访视触发条件"},{"action":"补充计划外访视需完成的评估项目清单","category":"source_missing","gap_id":"gap_713_assessment_content","missing_source_classes":["计划外访视操作规范","访视计划表/评估矩阵"],"target":"7.1.3节计划外访视评估内容"},{"action":"补充计划外访视的记录方式、报告对象和时限","category":"source_missing","gap_id":"gap_713_recording_reporting","missing_source_classes":["计划外访视操作规范","AE/SAE采集与报告流程"],"target":"7.1.3节计划外访视记录与报告"}],"heading":"计划外访视","missing_source_classes":["计划外访视触发条件与评估内容规范","AE/SAE采集与报告流程","安全性随访期与计划外访视衔接规则"],"proposal_text":"","rationale":"计划外访视章节需要项目级触发条件（如症状恶化、AE/SAE、依从性问题、剂量调整等）、评估内容清单、记录与报告流程及与安全性随访期的衔接规则。当前允许来源仅给出安全性数据采集窗口至末次给药后28天和访视策略中V1至V8的计划访视安排，未提供计划外访视的启动标准、评估内容、记录方式或报告时限。依据任务要求，计划外访视在缺少对应项目文件时必须标为source_gap，不能用条件句、范围句或通用原则标成complete。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9eb82f07945e_0dad742cdfc14338","section_number":"7.1.3","source_ids":["protocol_full_draft_selection:dcb115d07c9e1db850775195","current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0"]}],"source_bindings":[{"content_sha256":"4394901bca988314a556e5153eb2afc17a40197880aade252059adfb61a3617d","locator":"document:mwdoc_greenfield_proj_user_9eb82f07945e_787e4e3b7172115a:full-draft:dcb115d07c9e1db850775195","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:dcb115d07c9e1db850775195","source_type":"protocol_full_draft_selection","source_version":"full-draft:8cee17a814ab6b5d71b00ede84562669291ad122f7bab7977edc1d20f66ac9e6:dcb115d07c9e1db850775195","text_sha256":"4394901bca988314a556e5153eb2afc17a40197880aade252059adfb61a3617d"},{"content_sha256":"fc902d6acd0db3c4ae2d8a06f9d95cd2a30bf22d794f9d1663b021fd716ff12e","locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","source_type":"current_project_study_definition","source_version":"mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","text_sha256":"fc902d6acd0db3c4ae2d8a06f9d95cd2a30bf22d794f9d1663b021fd716ff12e"}]}