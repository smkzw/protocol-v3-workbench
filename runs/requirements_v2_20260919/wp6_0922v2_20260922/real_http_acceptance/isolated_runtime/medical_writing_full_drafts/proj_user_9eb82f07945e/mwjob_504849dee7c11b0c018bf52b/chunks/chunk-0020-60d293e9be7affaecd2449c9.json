_9eb82f07945e_2b26e339ae6412c4","section_number":"14.1","source_ids":["protocol_full_draft_selection:60d293e9be7affaecd2449c9","current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0"]},{"ai_run_id":"airun_20261003153831_7826799f","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"安全性终点：不良事件（AE）与严重不良事件（SAE）发生率（至末次给药后28天）；生命体征、12导联心电图、临床实验室检查异常发生率；症状性低血压发生率","quote_sha256":"baf9dd2250e27943336dfa1e44f2f07081f03e6f2962e0d1e4e9e0edb166421a","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_04"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"主要终点：主要终点：第12周NT-proBNP较基线的百分比变化（中心实验室定量）。","quote_sha256":"ecdbd2ec18da42de13fa283b48360fdd7e97841b2562c69777d5ba1f63a233db","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_05"}],"evidence_review_advisories":[],"evidence_span_ids":["es_04","es_05"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"获取项目实验室检查规程或中心实验室操作手册，确认具体检测项目、采集时点及正常值范围","category":"source_missing","gap_id":"gap_lab_01","missing_source_classes":["实验室检查项目清单","各访视采集时点","正常值参考范围","异常分级与处理规则"],"target":"14.2 实验室检查项目 具体项目清单"}],"heading":"实验室检查项目","missing_source_classes":["实验室检查项目清单","各访视采集时点","正常值参考范围","异常分级与处理规则"],"proposal_text":"本研究安全性评估涉及的实验室检查类别包括：NT-proBNP（由中心实验室定量检测，用于主要终点第12周较基线百分比变化的评估）、临床实验室检查（用于安全性终点中异常发生率的统计）以及12导联心电图。上述检查项目的具体检测指标清单、各访视采集时点、正常值参考范围、异常分级标准及异常处理流程，须依据项目实验室检查规程和中心实验室操作手册确定后写入本附录。","rationale":"已确认事实支持：主要终点为第12周NT-proBNP较基线百分比变化（中心实验室定量）；安全性终点包含临床实验室检查异常发生率和12导联心电图。但完整的实验室检查项目清单（如血常规、肝肾功能、电解质、凝血功能等具体项目）、各访视采集时点、正常值范围及异常处理规则均无项目来源支持，不得由安全性终点类别推断具体检查项目或采集频率。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9eb82f0794