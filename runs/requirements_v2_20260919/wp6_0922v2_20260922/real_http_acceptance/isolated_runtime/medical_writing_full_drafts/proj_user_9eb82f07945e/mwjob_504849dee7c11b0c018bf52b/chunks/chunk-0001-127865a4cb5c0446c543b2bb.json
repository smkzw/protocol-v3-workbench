ion_8010953a825e637fb9d3:revision:4","quote":"主要终点：第12周NT-proBNP较基线的百分比变化（中心实验室定量）。","quote_sha256":"cf93d08c04b1ed185004699e412fd4e8e81365a7a5b69ad855a2d977c17a8461","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"ES-003"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"诊断为慢性心力衰竭（HFrEF，LVEF≤40%、NYHA II–III级）、年龄18–75岁、已接受稳定GDMT（含ACEI/ARB/ARNI、β受体阻滞剂，有指征者MRA）至少4周仍保留症状的成人受试者。","quote_sha256":"6d4e4d57ce233f7ef36993d81fe9d991d2bcb86ac46b7f7b2eb29a77cf3b47f3","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"ES-004"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"探索性样本量：按NT-proBNP对数尺度组间SD约0.35估计，每组约40例（共160例）可在双侧α=0.10下提供约80%把握检测组间差异；含约10%脱落补偿。","quote_sha256":"4e57069650460e364624e7cac439e599febcd7fbc3b45f509feb6db8a6b15357","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"ES-005"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"筛选（V1，-28~-1天）、基线随机（V2，D1）、第2/4/8/12周门诊访视（V3–V6）、治疗结束访视（V7，W12）、末次给药后28天安全性随访（V8）。","quote_sha256":"dd63df4b3e66ae7ece55e746b97043dbd40d4385a8e4fccb4fbf1d3abe7c762d","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"ES-006"}],"evidence_review_advisories":[],"evidence_span_ids":["ES-001","ES-002","ES-003","ES-004","ES-005","ES-006"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"医学经理确认剂量递增方案及安全性暂停/恢复/永久停药规则后补入","category":"decision_pending","gap_id":"GAP-001","missing_source_classes":[],"target":"方案概要中剂量递增与安全性暂停规则的具体描述"},{"action":"医学经理确认legacy-derived-allowed_cm-1/2及legacy-derived-prohibited_cm-1/2对应的具体药物名称后补入","category":"decision_pending","gap_id":"GAP-002","missing_source_classes":[],"target":"方案概要中允许与禁止合并治疗的具体品种"}],"heading":"方案概要","missing_source_classes":[],"proposal_text":"本研究为一项多中心、随机、双盲、安慰剂平行对照的II期概念验证与剂量探索临床研究，旨在评价SMOKE-r2-3口服sGC激动剂（SGC-R23）在成人慢性心力衰竭（射血分数降低，HFrEF）患者中的疗效信号、安全性及耐受性，并为后续确证性研究提供剂量选择依据。研究设SGC-R23低剂量（2.5 mg）、中剂量（5 mg）和高剂量（10 mg）三个试验组及安慰剂对照组，各组按1:1:1:1比例随机分配；所有受试者在维持稳定指南导向药物治疗（GDMT）的基础上，口服每日一次研究药物或外观一致的安慰剂，连续给药12周。目标人群为年龄18至75岁、筛选时左室射血分数（LVEF）≤40%、NYHA心功能分级II至III级、已接受稳定GDMT（含ACEI/ARB/ARNI、β受体阻滞剂，有指征者MRA）至少4周仍保留中重度症状的成人HFrEF患者。主要疗效终点为第12周NT-proBNP较基线的百分比变化（中心实验室定量）；安全性终点包括不良事件与严重不良事件发生率（观察至末次给药后28天）、生命体征及12导联心电图异常、临床实验室检查异常发生率以及症状性低血压发生率。研究共设8次访视：筛选访视（V1，-28至-1天）、基线随机访视（V2，第1天）、第2/4/8/12周门诊访视（V3至V6）、治疗结束访视（V7，第12周）及末次给药后28天安全性随访访视（V8）。探索性样本量按NT-proBNP对数尺度组间标准差约0.35估计，每组约40例、共160例，含约10%脱落补偿，可在双侧α=0.10下提供约80%把握度检测组间差异。主要分析集为全分析集（FAS），主要终点采用ANCOVA（基线log NT-proBNP为协变量）比较各剂量组与安慰剂组第12周变化，报告几何均值比及90%置信区间；安全性按安全性分析集（SAS）描述；本研究不设确证性假设检验。","rationale":"设计事实（多中心、随机、双盲、安慰剂平行对照、II期、PoC与剂量探索）、药物与剂量（SGC-R23 2.5/5/10 mg QD×12周）、人群（LVEF≤40%、NYHA II-III、18-75岁、GDMT≥4周）、主要与安全性终点、访视策略（V1-V8）、样本量（每组40例共160例）及统计分析策略均来源于当前项目已确认研究事实。剂量递增与安全性暂停规则的具体内容、允许与禁止合并治疗的具体品种清单需医学经理确认后补入。","review_advisories":["本节复述高影响研究设计（方案概要）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（α、主要终点、剂量选择、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9eb82f07945e_8e4122a81666ab13","section_number":"1","source_ids":["protocol_full_draft_selection:127865a4cb5c0446c543b2bb","current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:76a6125fa7dca4","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc6f8c9ea6d34b"]},{"ai_run_id":"airun_20261003135426_9bdeeec0","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"检索并上传HFrEF流行病学、疾病负担、病理生理及当前治疗现状的项目级来源文件","category":"source_missing","gap_id":"GAP-003","missing_source_classes":["流行病学数据","疾病负担数据","心衰管理指南","治疗现状综述"],"target":"疾病背景及治疗现状全章正文"}],"heading":"疾病背景及治疗现状","missing_source_classes":["HFrEF流行病学与疾病负担数据","HFrEF病理生理与疾病自然史","现行心衰管理指南（如ESC/AHA/中国心衰指南）","HFrEF当前标准治疗现状与未满足需求"],"proposal_text":"","rationale":"本章节需要HFrEF的流行病学数据（患病率、发病率、疾病负担）、疾病自然史与病理生理概述、当前标准治疗（GDMT）的循证依据及未满足需求描述。当前允许来源中仅包含疾病名称'慢性心力衰竭（射血分数降低，HFrEF）'，无流行病学、疾病负担、指南或治疗现状的项目级来源，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9eb82f07945e_7989f37c6cb93cd6","section_number":"2.1","source_ids":["protocol_full_draft_selection:127865a4cb5c0446c543b2bb","current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:76a6125fa7dca4","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc6f8c9ea6d34b"]},{"ai_run_id":"airun_20261003135426_9bdeeec0","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"检索并上传SGC-R23的IB、作用机制文献、非临床研究报告及既往临床资料","category":"source_missing","gap_id":"GAP-004","missing_source_classes":["研究者手册","作用机制文献","非临床研究报告","既往临床资料"],"target":"研究药物简介全章正文"}],"heading":"研究药物简介","missing_source_classes":["SGC-R23作用机制与靶点药理学","非临床安全性数据（毒理学、安全性药理学）","既往人体研究资料","研究者手册（IB）"],"proposal_text":"","rationale":"本章节需要SGC-R23的作用机制详述（sGC激动剂对NO-cGMP通路的激活机制）、非临床安全性数据摘要、既往人体研究资料及研究者手册（IB）中的关键信息。当前允许来源仅确认药物名称为'SMOKE-r2-3口服sGC激动剂（SGC-R23）'、技术类型为小分子、给药途径为口服、暴露范围为全身性，缺少作用机制详述、非临床数据、既往临床资料及IB等核心来源，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9eb82f07945e_ace227b070ca823a","section_number":"2.3","source_ids":["protocol_full_draft_selection:127865a4cb5c0446c543b2bb","current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:76a6125fa7dca4","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc6f8c9ea6d34b"]},{"ai_run_id":"airun_20261003135426_9bdeeec0","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"检索并上传SGC-R23非临床研究报告（含药效学、PK、毒理学、安全性药理学）或IB中非临床章节","category":"source_missing","gap_id":"GAP-005","missing_source_classes":["非临床药效学报告","非临床PK报告","非临床毒理学报告","安全性药理学报告","非临床研究综述"],"target":"非临床研究结果全章正文"}],"heading":"非临床研究结果","missing_source_classes":["非临床药效学研究数据","非临床药代动力学数据","非临床毒理学数据（急毒/长毒/遗传毒性/生殖毒性）","安全性药理学数据"],"proposal_text":"","rationale":"本章节需要SGC-R23的非临床研究具体结果，包括药效学（sGC激动活性、cGMP生成、血流动力学效应）、药代动力学（吸收、分布、代谢、排泄、种属差异）、毒理学（急性毒性、重复给药毒性、遗传毒性、生殖毒性、安全药理学）及非临床安全性结论。当前允许来源中该章节正文为空，无任何非临床研究数据的项目级来源，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9eb82f07945e_230a94b887ae78e8","section_number":"2.3.1","source_ids":["protocol_full_draft_selection:127865a4cb5c0446c543b2bb","current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:76a6125fa7dca4","company_co