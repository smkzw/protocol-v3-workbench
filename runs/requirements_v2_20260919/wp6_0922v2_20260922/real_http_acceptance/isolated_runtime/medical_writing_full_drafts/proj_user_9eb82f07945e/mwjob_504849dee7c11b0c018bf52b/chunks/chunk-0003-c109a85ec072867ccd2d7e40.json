,"quote_sha256":"e926c8d361a08296673bf2d42bc6379d235cf1feb2f48979a4bfa55d107470a6","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_010"}],"evidence_review_advisories":[],"evidence_span_ids":["es_001","es_002","es_010"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"由医学经理确认是否将上述指标列为次要终点；若纳入需补充对应采集时点与评价方法","category":"decision_pending","gap_id":"gap_32_secondary_efficacy","missing_source_classes":[],"target":"次要终点中是否纳入NT-proBNP绝对变化值、NYHA分级变化、6分钟步行距离或KCCQ等患者报告结局"}],"heading":"次要目的和次要终点","missing_source_classes":[],"proposal_text":"本研究的次要目的为评价SGC-R23在低、中、高三个剂量水平下连续给药12周的安全性及耐受性特征，并初步探索剂量-效应关系，为后续确证性研究提供剂量选择依据。\n\n次要终点包括：（1）不良事件（AE）与严重不良事件（SAE）发生率，观察窗口至末次给药后28天；（2）生命体征、12导联心电图及临床实验室检查异常发生率；（3）症状性低血压发生率。上述安全性终点均按安全性分析集（SAS）进行描述性统计，不设确证性假设检验。\n\n本研究为概念验证与剂量探索性质的II期研究，无确证性假设检验；安全性终点以描述性方式呈现各组事件发生率及严重程度分布，用于识别剂量限制性毒性信号及支持后续剂量选择决策。","rationale":"安全性终点（AE/SAE发生率至末次给药后28天、生命体征/心电图/实验室检查异常发生率、症状性低血压发生率）及'安全性及耐受性'研究目的均来源于当前项目已确认研究事实。次要目的中'剂量-效应关系'由'剂量探索'研究目的直接支持。是否需补充NT-proBNP绝对变化、NYHA分级变化、6分钟步行距离或KCCQ等次要疗效终点，当前来源未明确，需医学经理确认。","review_advisories":["本节提及高影响设计信息（剂量选择）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9eb82f07945e_b20bc78ef1094ec2","section_number":"3.2","source_ids":["protocol_full_draft_selection:c109a85ec072867ccd2d7e40","current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7"]},{"ai_run_id":"airun_20261003140536_5c5c24d8","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids"