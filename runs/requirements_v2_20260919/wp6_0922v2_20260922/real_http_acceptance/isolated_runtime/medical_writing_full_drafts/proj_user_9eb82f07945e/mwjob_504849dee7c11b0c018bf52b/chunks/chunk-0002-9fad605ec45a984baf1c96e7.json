s":["es_002","es_003","es_009","es_010","es_011","es_012","es_013","es_014","es_016","es_017","es_018","es_019","es_020","es_021","es_022","es_023","es_024","es_025","es_026","es_027","es_028","es_029","es_030"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":23},"gap_items":[{"action":"补充sGC-cGMP通路在HFrEF中的机制文献及SGC-R23非临床数据，以充实理论基础段落","category":"source_missing","gap_id":"gap_24_01","missing_source_classes":["作用机制文献","非临床研究报告"],"target":"2.4 本研究的理论基础"},{"action":"补充既往同类sGC激动剂（如维利西呱等）在HFrEF中的临床证据，作为剂量选择与终点选择的参照","category":"source_missing","gap_id":"gap_24_02","missing_source_classes":["同类药物临床文献"],"target":"2.4 本研究的理论基础"}],"heading":"本研究的理论基础","missing_source_classes":["sGC激动剂作用机制文献","HFrEF病理生理综述","SGC-R23非临床药效学/毒理学数据","既往同类sGC激动剂临床证据"],"proposal_text":"本研究为II期概念验证与剂量探索研究，旨在评价SMOKE-r2-3口服sGC激动剂（SGC-R23）在成人慢性心力衰竭（射血分数降低，HFrEF）患者中的初步疗效信号与安全性耐受性，并为后续确证性研究确定候选剂量。研究采用多中心、随机、双盲、安慰剂平行对照设计，SGC-R23设2.5mg、5mg、10mg三个剂量组与安慰剂组按1:1:1:1比例随机分配，各组口服每日一次，连续给药12周。安慰剂片外观与SGC-R23一致，背景指南导向药物治疗（GDMT）按指南维持稳定。研究不设自适应设计、样本量再估计、期中分析、SRC或DMC。目标人群为LVEF≤40%、NYHA II–III级、已接受稳定GDMT至少4周仍保留中重度症状的成人慢性心力衰竭患者。主要疗效评价以第12周NT-proBNP较基线的百分比变化为核心指标，辅以安全性与耐受性评估。本研究的理论基础在于：sGC-cGMP信号通路在心力衰竭病理生理中参与血管舒张、心肌重构及纤维化调控，SGC-R23作为口服小分子sGC激动剂，通过系统暴露发挥全身性血流动力学与抗重构效应；12周治疗期旨在捕捉NT-proBNP这一心室壁张力生物标志物的早期变化趋势；三剂量平行设计结合约80%把握度的探索性样本量策略，为剂量-效应关系初步判断提供统计框架。","rationale":"已确认事实支持：研究分期II期、内在目的为PoC与剂量探索、设计为多中心随机双盲安慰剂平行对照、SGC-R23为口服小分子sGC激动剂、三剂量2.5/5/10mg每日一次×12周、1:1:1:1随机、不设自适应/期中/DMC/SRC、目标人群LVEF≤40% NYHA II-III、主要终点NT-proBNP。sGC-cGMP通路机制描述为基于药物类别的合理推断，需医学经理确认是否引用IB或外部文献支撑。","review_advisories":["本节提及高影响设计信息（期中分析、样本量）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9eb82f07945e_0ffcfe8a00022e43","section_number":"2.4","source_ids":["protocol_full_draft_selection:9fad605ec45a984baf1c96e7","current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261003135840_4222136b","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"内在研究目的：概念验证（PoC）；剂量探索","quote_sha256":"2d096e242bbd65d0c9236718d79e77a388e84cb9640b99bd47662a6ce8faab31","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_002"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"多中心、随机、双盲、安慰剂平行对照的II期概念验证与剂量探索研究：SGC-R23设低/中/高三个剂量组与安慰剂组平行对照，主要评价12周NT-proBNP较基线变化与安全性及耐受性。","quote_sha256":"28ee1c5d2049e6b8696d6c90f1f6ffacb54fedf472f32b2e109b7303a334414d","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_003"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"主要终点：主要终点：第12周NT-proBNP较基线的百分比变化（中心实验室定量）。","quote_sha256":"ecdbd2ec18da42de13fa283b48360fdd7e97841b2562c69777d5ba1f63a233db","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_004"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"安全性终点：不良事件（AE）与严重不良事件（SAE）发生率（至末次给药后28天）；生命体征、12导联心电图、临床实验室检查异常发生率；症状性低血压发生率","quote_sha256":"baf9dd2250e27943336dfa1e44f2f07081f03e6f2962e0d1e4e9e0edb166421a","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_005"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"估计目标：12周NT-proBNP较基线百分比变化；人群为随机化全分析集；伴发事件按治疗方针策略处理；汇总统计量为各组均值差。","quote_sha256":"625ff33f440364fc20fc6f8a2053c62306031f65cc31d16a0678ae00fe8ee8f5","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_006"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"主要终点采用ANCOVA（基线log NT-proBNP为协变量）比较各剂量组与安慰剂组第12周变化，报告几何均值比与90%CI；安全性按SAS描述；无确证性假设检验。","quote_sha256":"8868d5221b929645a1c914fbbf7726ec7671a096c05b75963afa817d869b13a6","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_007"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"主要分析集为FAS；主要终点采用ANCOVA（基线log NT-proBNP为协变量）比较各剂量组与安慰剂组第12周变化，报告几何均值比与90%CI；安全性按SAS描述；无确证性假设检验。","quote_sha256":"6761a9b7aecbd75032ab32a3c52445a857daac1dd4639f1ea608fde1de442bff","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_015"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003","es_004","es_005","es_006","es_007","es_015"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":7},"gap_items":[{"action":"确认本研究是否确实不设置探索性目的或探索性终点（如6MWD、NT-proBNP绝对变化、心衰住院率等）","category":"decision_pending","gap_id":"gap_3_01","missing_source_classes":[],"target":"3 研究目的和终点"}],"heading":"研究目的和终点","missing_source_classes":[],"proposal_text":"本研究为II期概念验证与剂量探索研究，总体目的为评价SMOKE-r2-3口服sGC激动剂（SGC-R23）在成人慢性心力衰竭（射血分数降低，HFrEF）患者中的初步疗效信号、安全性与耐受性，并为后续确证性研究的剂量选择提供依据。主要目的为评价SGC-R23三个剂量组（2.5mg、5mg、10mg，口服每日一次，连续12周）与安慰剂组相比，第12周NT-proBNP较基线的百分比变化。安全性目的为评价SGC-R23的安全性及耐受性，包括不良事件与严重不良事件发生率（至末次给药后28天）、生命体征、12导联心电图及临床实验室检查异常发生率、症状性低血压发生率。本研究不设置探索性目的或探索性终点。主要分析集为随机化全分析集（FAS），主要终点采用ANCOVA（基线log NT-proBNP为协变量）比较各剂量组与安慰剂组第12周变化，报告几何均值比与90%置信区间；安全性按安全性分析集（SAS）描述；本研究无确证性假设检验。","rationale":"已确认事实支持：研究目的为PoC与剂量探索、主要终点为第12周NT-proBNP较基线百分比变化（中心实验室定量）、安全性终点包括AE/SAE（至末次给药后28天）、生命体征、12导联心电图、实验室检查异常、症状性低血压、分析集为FAS、ANCOVA方法、几何均值比与90%CI、无确证性假设检验。'不设置探索性目的或探索性终点'为基于研究定义中未列出任何探索性内容的合理推断，需医学经理确认。","review_advisories":["本节复述高影响研究设计（研究目的和终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、剂量选择）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9eb82f07945e_d50be8125da850b5","section_number":"3","source_ids":["protocol_full_draft_selection:9fad605ec45a984baf1c96e7","current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261003135840_4222136b","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"主要终点：主要终点：第12周NT-proBNP较基线的百分比变化（中心实验室定量）。","quote_sha256":"ecdbd2ec18da42de13fa283b48360fdd7e97841b2562c69777d5ba1f63a233db","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_004"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"主要终点采用ANCOVA（基线log NT-proBNP为协变量）比较各剂量组与安慰剂组第12周变化，报告几何均值比与90%CI；安全性按SAS描述；无确证性假设检验。","quote_sha256":"8868d5221b929645a1c914fbbf7726ec7671a096c05b75963afa817d869b13a6","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_007"},{"locator":"document:mwdoc_greenfield_proj_user_9eb82f07945e_787e4e3b7172115a:full-draft:9fad605ec45a984baf1c96e7","quote":"主要终点：第12周NT-proBNP较基线的百分比变化（中心实验室定量）。","quote_sha256":"cf93d08c04b1ed185004699e412fd4e8e81365a7a5b69ad855a2d977c17a8461","source_id":"protocol_full_draft_selection:9fad605ec45a984baf1c96e7","span_id":"es_008"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"SGC-R23片 2.5mg/5mg/10mg（剂量组按随机分配），口服每日一次×12周","quote_sha256":"b6632f8d28f64c7693c8dc2a200924eb4f3c9d23161fa0b7b978b50eee70b131","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_010"},{"locator":"study_definition:mwdefinition_8010953a825e637fb9d3:revision:4","quote":"主要分析集为FAS；主要终点采用ANCOVA（基线log NT-proBNP为协变量）比较各剂量组与安慰剂组第12周变化，报告几何均值比与90%CI；安全性按SAS描述；无确证性假设检验。","quote_sha256":"6761a9b7aecbd75032ab32a3c52445a857daac1dd4639f1ea608fde1de442bff","source_id":"current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","span_id":"es_015"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004","es_007","es_008","es_010","es_015"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[],"heading":"主要目的和主要终点","missing_source_classes":[],"proposal_text":"本研究的主要目的为评价SMOKE-r2-3口服sGC激动剂（SGC-R23）2.5mg、5mg、10mg三个剂量组（口服每日一次，连续给药12周）与安慰剂组相比，对成人慢性心力衰竭（射血分数降低，HFrEF）患者第12周NT-proBNP水平的影响。主要终点为第12周NT-proBNP较基线的百分比变化，由中心实验室定量检测。主要分析集为随机化全分析集（FAS），采用ANCOVA方法（以基线log NT-proBNP为协变量）比较各剂量组与安慰剂组第12周的变化，报告几何均值比及其90%置信区间。本研究无确证性假设检验，该分析为探索性剂量-效应评估。","rationale":"已确认事实支持：主要终点为第12周NT-proBNP较基线百分比变化（中心实验室定量）、SGC-R23三剂量2.5/5/10mg每日一次×12周、FAS分析集、ANCOVA方法、几何均值比与90%CI、无确证性假设检验。","review_advisories":["本节复述高影响研究设计（主要目的和主要终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9eb82f07945e_f9ac264cf0239377","section_number":"3.1","source_ids":["protocol_full_draft_selection:9fad605ec45a984baf1c96e7","current_project_study_definition:mwdefinition_8010953a825e637fb9d3:r4:0225054d6df249e0","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]}],"source_bindings":[{"content_sha256":"7ca42c13e900836a4916e3348304c9fe