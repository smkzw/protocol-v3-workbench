56":"07ee676da9169ff7bd8873a4eb194a9fea3f97590a5af13071efd2a7848b5a32","source_id":"current_project_study_definition:mwdefinition_65980afdba6889157dd2:r4:c63e0788740b2185","span_id":"span_sd_periods"},{"locator":"study_definition:mwdefinition_65980afdba6889157dd2:revision:4","quote":"访视策略：筛选（D-14至D-1）、随机（D0）、治疗期每4周访视（W4、W8、W12）、治疗结束（W12）与安全性随访（W14）","quote_sha256":"c17bfdc6ad6bd523b4f5d0796d3671b02255e231b80563f3f2bfb1c9d2e80187","source_id":"current_project_study_definition:mwdefinition_65980afdba6889157dd2:r4:c63e0788740b2185","span_id":"span_sd_visits"},{"locator":"study_definition:mwdefinition_65980afdba6889157dd2:revision:4","quote":"估计目标策略：主要估计目标：随机化人群中第12周NT-proBNP较基线百分比变化；伴发事件为死亡、心衰住院退出治疗，采用治疗策略（while-on-treatment前访视值）处理","quote_sha256":"2d4b389debd3d92486a40640aa7aaa941f48cc425c14847bc526dfcf7a1f56c1","source_id":"current_project_study_definition:mwdefinition_65980afdba6889157dd2:r4:c63e0788740b2185","span_id":"span_sd_estimand"},{"locator":"study_definition:mwdefinition_65980afdba6889157dd2:revision:4","quote":"样本量策略：按NT-proBNP较基线变化的主要终点，假设12周时安慰剂组平均下降15%、试验组下降30%、SD=25%，双侧α=0.05、把握度80%，每组约60例；三组合计约180例，考虑10%脱落再入组约200例","quote_sha256":"40030ab0f39dc36c5c83596014e75212485687dba865ee00485c3512401272c5","source_id":"current_project_study_definition:mwdefinition_65980afdba6889157dd2:r4:c63e0788740b2185","span_id":"span_sd_sample"},{"locator":"study_definition:mwdefinition_65980afdba6889157dd2:revision:4","quote":"统计分析策略：主要终点采用ANCOVA模型（基线值为协变量，组别为固定效应）；安全性按描述统计；亚组按基线NT-proBNP中位数分层；全分析集与安全性分析集分别定义","quote_sha256":"264f2a793883d5c25a23fce6a339bc06f84eb8da0d322dbe93f24a8b712b9ece","source_id":"current_project_study_definition:mwdefinition_65980afdba6889157dd2:r4:c63e0788740b2185","span_id":"span_sd_stats"}],"evidence_review_advisories":[],"evidence_span_ids":["span_section_1","span_sd_title","span_sd_phase_region","span_sd_design","span_sd_objective","span_sd_target_pop","span_sd_population","span_sd_intervention","span_sd_arms","span_sd_placebo","span_sd_primary","span_sd_safety","span_sd_teae","span_sd_periods","span_sd_visits","span_sd_estimand","span_sd_sample","span_sd_stats"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":17},"gap_items":[],"heading":"方案概要","missing_source_classes":[],"proposal_text":"本研究为SMOKE-r1-2口服可溶性鸟苷酸环化酶（sGC）激动剂（SGC-R12）用于治疗慢性心力衰竭（射血分数降低，HFrEF）的II期临床研究，方案编号为MW-II-B7C03D14-DRAFT，开发区域为中国。研究采用随机、双盲、安慰剂对照、平行组、多中心II期剂量探索设计，内在研究目的为概念验证与剂量探索。计划入组年龄18-75岁、左心室射血分数（LVEF）≤40%、纽约心脏病协会（NYHA）II-III级，且筛选前已在稳定剂量指南导向药物治疗（GDMT，含ACEI/ARB/ARNI、β受体阻滞剂、MRA，有指征者）至少4周基础上仍残留症状的成人HFrEF受试者。受试者按1:1:1随机分配至SGC-R12低剂量组（2.5mg每日一次）、SGC-R12高剂量组（5mg每日一次）或安慰剂组（口服安慰剂每日一次），试验药与安慰剂在外观和给药频次上保持一致，双盲治疗期为12周。主要终点为第12周NT-proBNP较基线的百分比变化（中心实验室检测，访视窗±7天）；关键安全性评价包括第12周6分钟步行距离较基线变化、第4周和第12周NYHA分级应答率，以及治疗期间不良事件（TEAE）发生率与严重程度和第0、4、12周体位性低血压症状与收缩压变化。研究时期包括最长14天的筛选期、12周双盲治疗期和末次给药后14天的安全性随访期；访视安排为筛选（D-14至D-1）、随机（D0）、治疗期每4周访视（W4、W8、W12）、治疗结束（W12）与安全性随访（W14）。样本量按主要终点估算，假设12周时安慰剂组平均下降15%、试验组下降30%、标准差25%，双侧α=0.05、把握度80%，每组约60例，三组合计约180例，考虑10%脱落再入组约200例。主要分析采用以基线值为协变量、组别为固定效应的ANCOVA模型，安全性按描述统计，亚组按基线NT-proBNP中位数分层，全分析集与安全性分析集分别定义；主要估计目标为随机化人群中第12周NT-proBNP较基线的百分比变化，对死亡、心衰住院退出治疗等伴发事件采用治疗策略（while-on-treatment前访视值）处理。","rationale":"正文依据已确认研究事实中的研究题目与方案编号、II期随机双盲安慰剂对照平行组多中心剂量探索设计、1:1:1分组与2.5mg/5mg每日一次12周给药、主要终点、安全性终点、研究时期与访视策略、样本量假设与统计策略撰写；医学作者需核对样本量假设、估计目标与终点表述同方案定稿的一致性，并确认安慰剂与盲法细节的最终措辞。","review_advisories":["本节复述高影响研究设计（方案概要）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（α、主要终点、估计目标、伴发事件、样本量、计划入组）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9bed9903e9e5_1398617019c2ef13","section_number":"1","source_ids":["protocol_full_draft_selection:f337cb27c15299ae77d29e31","current_project_study_definition:mwdefinition_65980afdba6889157dd2:r4:c63e0788740b2185","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:76a6