ull_draft_selection:f337cb27c15299ae77d29e31","span_id":"span_section_23"},{"locator":"study_definition:mwdefinition_65980afdba6889157dd2:revision:4","quote":"药物技术类型：small_molecule\n给药途径：口服\n剂型：口服固体制剂\n局部/系统暴露范围：systemic","quote_sha256":"93d70823288385813f38b773b8c6e7bba227a7ed893796844d8834e9f3bae884","source_id":"current_project_study_definition:mwdefinition_65980afdba6889157dd2:r4:c63e0788740b2185","span_id":"span_sd_drugprops"},{"locator":"study_definition:mwdefinition_65980afdba6889157dd2:revision:4","quote":"试验干预：SMOKE-r1-2（SGC-R12）为口服可溶性鸟苷酸环化酶（sGC）激动剂；在标准心衰药物治疗（GDMT）基础上，低剂量组2.5mg每日一次、高剂量组5mg每日一次，口服，治疗12周","quote_sha256":"b44c937d5f847a08377dd99061839aa3a963a3d75e5c212738e6ff05f9486841","source_id":"current_project_study_definition:mwdefinition_65980afdba6889157dd2:r4:c63e0788740b2185","span_id":"span_sd_intervention"},{"locator":"study_definition:mwdefinition_65980afdba6889157dd2:revision:4","quote":"试验组与对照组：SGC-R12低剂量组：SMOKE-r1-2口服sGC激动剂 2.5mg 每日一次；SGC-R12高剂量组：SMOKE-r1-2口服sGC激动剂 5mg 每日一次；安慰剂组：口服安慰剂 每日一次","quote_sha256":"3d8440a9f62a4d38e76423a4d5e5c2ae07ce47424b4ab5214ab77beb0a966dc4","source_id":"current_project_study_definition:mwdefinition_65980afdba6889157dd2:r4:c63e0788740b2185","span_id":"span_sd_arms"}],"evidence_review_advisories":[],"evidence_span_ids":["span_section_23","span_sd_drugprops","span_sd_intervention","span_sd_arms"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"获取研究者手册或等效研究药物机制资料后撰写","category":"source_missing","gap_id":"gap_2_3_mechanism","missing_source_classes":["研究者手册（IB）或等效研究药物资料"],"target":"2.3 研究药物简介 作用机制与药理特征段落"},{"action":"获取制剂组成、规格与储存条件来源后撰写","category":"source_missing","gap_id":"gap_2_3_formulation","missing_source_classes":["研究药物制剂与规格资料"],"target":"2.3 研究药物简介 制剂、规格与储存段落"},{"action":"获取研究药物安全性参考文件后撰写","category":"source_missing","gap_id":"gap_2_3_risk","missing_source_classes":["研究药物安全性参考文件（IB或等效资料）"],"target":"2.3 研究药物简介 已知与潜在风险段落"}],"heading":"研究药物简介","missing_source_classes":["研究者手册（IB）或等效研究药物资料","研究药物制剂与规格资料","研究药物安全性参考文件（IB或等效资料）"],"proposal_text":"SMOKE-r1-2（SGC-R12）为口服可溶性鸟苷酸环化酶（sGC）激动剂，属小分子药物，经口服途径给药，剂型为口服固体制剂，呈系统暴露特征。本研究在标准心衰药物治疗（GDMT）基础上开展剂量探索，设置低剂量2.5mg每日一次与高剂量5mg每日一次两个口服给药水平，连续治疗12周。对照组使用口服安慰剂片，每日一次，与试验药在外观和给药频次上保持一致。","rationale":"正文写入的直接依据为已确认研究事实中SMOKE-r1-2（SGC-R12）的口服sGC激动剂类别、小分子技术类型、口服固体制剂、系统暴露、2.5mg与5mg每日一次12周给药及与试验药外观和给药频次一致的安慰剂；医学作者需在获得研究者手册或等效资料后核对作用机制、制剂与规格、储存条件及已知/潜在风险信息。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9bed9903e9e5_98bc05d1c48e221c","section_number":"2.3","source_ids":["protocol_full_draft_selection:f337cb27c15299ae77d29e31","current_project_study_definition:mwdefinition_65980afdba6889157dd2:r4:c63e0788740b2185","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:76a6125fa7dca4","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc6f8c9ea6d34b"]},{"ai_run_id":"airun_20260930163443_d9c53b45","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取非临床药效学、药代动力学与毒理学研究报告及研究者手册非临床部分后撰写","category":"source_missing","gap_id":"gap_2_3_1_nonclinical","missing_source_classes":["非临床药效学/药代动力学/毒理学研究报告","研究者手册（IB）非临床部分"],"target":"2.3.1 非临床研究结果 全文"}],"heading":"非临床研究结果","missing_source_classes":["非临床药效学/药代动力学/毒理学研究报告","研究者手册（IB）非临床部分"],"proposal_text":"","rationale":"非临床研究结果必须依据研究药物的非临床药效学、药代动力学与毒理学资料撰写；现有来源不含此类资料，缺少研究者手册及非临床研究报告，无法形成有实质依据的正文，缺失来源类别已列入缺口。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9bed9903e9e5_b917bb71e77af4d3","section_number":"2.3.1","source_ids":["protocol_full_draft_selection:f337cb27c15299ae77d29e31","current_project_study