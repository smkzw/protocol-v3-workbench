246cb9:r4:f0c046e418e0ae80","span_id":"es_001"},{"locator":"section:试验参与者知情同意书|block:906|chunk:1","quote":"知情同意书分为成年人、未成年人及监护人版本，经过伦理委员会的审批之后方可使用。","quote_sha256":"2acebffe2bcacc2b4c22948a73b66ff040ee70fcbe02b33a6a441bde4fe38204","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:42d49ba7a285ce","span_id":"es_004"},{"locator":"section:文档开头|block:31|chunk:1","quote":"皮肤活检（可选）：适用于决定参与并签署皮肤活检知情同意书的受试者。每位受试者将采集两份活检样本，1份来自皮损区，1份来自非皮损区。","quote_sha256":"b5e828cc23bb01d0eadef8f87b769236df2dbd73a6dc00309f3206c76fac7e45","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:99911e01a39256","span_id":"es_005"},{"locator":"section:4.1.1 筛选期|block:677|chunk:1","quote":"知情同意并签署 ICF；","quote_sha256":"289780804af814a372538eb298054487fa0ba1d93be6500affa63d01db7a2b2b","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:fc98aacc7e06ca","span_id":"es_007"}],"evidence_review_advisories":[],"evidence_span_ids":["es_001","es_004","es_005","es_007"],"evidence_summary":{"corpus_spans":3,"project_fact_spans":1},"gap_items":[{"action":"补充知情同意书具体版本编号、翻译语言及电子知情同意是否允许","category":"source_missing","gap_id":"gap_icf_version","missing_source_classes":["知情同意书具体版本编号与翻译语言","电子知情同意是否允许"],"target":"知情同意章节中知情同意书版本与语言"},{"action":"补充12~17岁受试者assent年龄分界、格式及监护人同意具体操作流程","category":"source_missing","gap_id":"gap_assent_procedure","missing_source_classes":["12~17岁assent年龄分界及格式","各中心知情同意实施流程"],"target":"知情同意章节中青少年assent流程"}],"heading":"知情同意","missing_source_classes":["知情同意书具体版本编号与翻译语言","电子知情同意是否允许","12~17岁assent年龄分界及格式","各中心知情同意实施流程"],"proposal_text":"所有受试者在接受任何研究相关程序之前须签署知情同意书。知情同意书分为成年人、未成年人及监护人版本，经过伦理委员会的审批之后方可使用。本研究纳入12~17岁青少年受试者，该年龄段受试者需同时获得监护人同意并有本人知情过程。知情同意签署为筛选期起始步骤，在签署知情同意书后方可进行后续筛选评估。若研究方案中包含可选的额外操作程序，适用于决定参与并签署相应知情同意书的受试者，须单独签署该程序的知情同意。知情同意书的具体版本、语言及电子知情同意方式须符合各参与中心伦理委员会的要求。","rationale":"知情同意书分版本及伦理审批要求来源于公司语料通用结构；青少年监护人同意及知情过程来源于当前项目已确认研究事实；知情同意签署为筛选期起始步骤来源于公司语料。知情同意书具体版本编号、翻译语言、电子知情同意是否允许及assent年龄分界等实施细节缺少项目来源。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5802328cf94b_a48e33b8c0acce32","section_number":"11.2","source_ids":["protocol_full_draft_selection:f880fdda2d369de2fc16db87","current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc98aacc7e06ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:3d4fa32554415b","company_corpus:cms_cn_protocol_corpus_20260715_v1:99911e01a39256","company_corpus:cms_cn_protocol_corpus_20260715_v1:42d49ba7a285ce"]},{"ai_run_id":"airun_20261007150414_4e798f26","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_b88e90fe0d39f0246cb9:revision:4","quote":"多中心","quote_sha256":"54fcbcccc80745a014ff6fc0df87946128108c7cc3d99aa145038879cd2838b9","source_id":"current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80","span_id":"es_002"},{"locator":"study_definition:mwdefinition_b88e90fe0d39f0246cb9:revision:4","quote":"DMC是否计划：是","quote_sha256":"9967a9a75297ced2326ab733fa3b16934acdef641fa765dd50c1cd58219f4aa5","source_id":"current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80","span_id":"es_003"},{"locator":"section:试验参与者知情同意书|block:906|chunk:1","quote":"知情同意书分为成年人、未成年人及监护人版本，经过伦理委员会的审批之后方可使用。","quote_sha256":"2acebffe2bcacc2b4c22948a73b66ff040ee70fcbe02b33a6a441bde4fe38204","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:42d49ba7a285ce","span_id":"es_004"},{"locator":"section:文档开头|block:4|chunk:1","quote":"本方案中所包含的所有信息归申办方所有，因此，仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构进行审阅。在未得到申办方书面批准的情况下，除了在与可能参加本研究的受试者签署知情同意书时，向其做必要的解释外，严禁将任何信息告知与本研究无关的第三方。","quote_sha256":"dfc9fceb41db9d941df0e3715483adaa069da4f1953600a6a37a56d7f81373dd","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","span_id":"es_006"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003","es_004","es_006"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":2},"gap_items":[{"action":"补充各参与中心伦理委员会名称、审查流程及跟踪审查频率","category":"source_missing","gap_id":"gap_ec_names","missing_source_classes":["各中心伦理委员会名称与审查流程","跟踪审查频率与年度报告要求"],"target":"伦理委员会章节中各中心伦理委员会信息"},{"action":"补充DMC章程、组成、审查频率及与申办方和研究者的信息隔离机制","category":"source_missing","gap_id":"gap_dmc_details","missing_source_classes":["数据安全监查委员会章程与组成"],"target":"伦理委员会章节中DMC运作细节"}],"heading":"伦理委员会","missing_source_classes":["各中心伦理委员会名称与审查流程","跟踪审查频率与年度报告要求","数据安全监查委员会章程与组成"],"proposal_text":"本研究为多中心设计，各参与中心在启动研究前须获得本中心伦理委员会的审查批准。知情同意书分为成年人、未成年人及监护人版本，经过伦理委员会的审批之后方可使用。研究期间设立独立数据安全监查委员会对受试者安全进行定期监查，其章程、组成及审查频率由申办方另行制定。方案中所包含的所有信息归申办方所有，仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构进行审阅。各中心伦理委员会的跟踪审查频率、年度/定期报告要求及方案修正案的再审批流程须符合各中心所在机构的规定。","rationale":"多中心设计、DMC设立来源于当前项目已确认研究事实；知情同意书须经伦理委员会审批方可使用来源于公司语料通用结构；信息保密条款来源于公司语料。各中心伦理委员会名称、具体审查流程、跟踪审查频率及年度报告要求缺少项目来源，已列入gap_items。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5802328cf94b_6a48ec24163939f9","section_number":"11.3","source_ids":["protocol_full_draft_selection:f880fdda2d369de2fc16db87","current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc98aacc7e06ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:3d4fa32554415b","company_corpus:cms_cn_protocol_corpus_20260715_v1:99911e01a39256","company_corpus:cms_cn_protocol_corpus_20260715_v1:42d49ba7a285ce"]}],"source_bindings":[{"content_sha256":"6f3ff28a63498235604210d0ae95e767284fa595684628c9aa1ef36b69f9646c","locator":"document:mwdoc_greenfield_proj_user_5802328cf94b_69278d1f7aa982ed:full-draft:f880fdda2d369de2fc16db87","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:f880fdda2d369de2fc16db87","source_type":"protocol_full_draft_selection","source