sion_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取本项目妊娠事件报告与随访的项目级文件（含报告时限、报告对象、避孕方法、妊娠检查日程、伴侣妊娠报告、新生儿随访、妊娠相关SAE定义）后撰写","category":"source_missing","gap_id":"gap_89_preg_report","missing_source_classes":["项目妊娠事件报告与随访流程文件","避孕方法具体规定","妊娠检查日程与阳性处理流程","伴侣妊娠报告与新生儿随访规则","妊娠相关SAE定义与报告时限"],"target":"8.9节全文"}],"heading":"妊娠事件的报告与随访","missing_source_classes":["项目妊娠事件报告与随访流程文件","避孕方法具体规定","妊娠检查日程与阳性处理流程","伴侣妊娠报告与新生儿随访规则"],"proposal_text":"","rationale":"本项目排除标准包含妊娠或哺乳期，育龄女性要求妊娠试验阴性并同意有效避孕，但妊娠或哺乳期排除不能推出避孕方法、伴侣妊娠报告、新生儿随访或妊娠检查日程。公司语料中的妊娠报告流程（24小时报告、签署ICF至末次给药后6个月窗口、伴侣妊娠报告、新生儿随访至分娩后三个月、先天畸形视为SAE）来自其他项目，不可直接迁移为本项目已确认规则。缺少本项目妊娠事件报告与随访的项目级文件。","review_advisories":["本节复述高影响研究设计（妊娠事件的报告与随访）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5802328cf94b_304edc8e75a8810b","section_number":"8.9","source_ids":["protocol_full_draft_selection:1571f1e4ccbd1a66ebd4e791","current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80","company_corpus:cms_cn_protocol_corpus_20260715_v1:152c1e08c78e76","company_corpus:cms_cn_protocol_corpus_20260715_v1:30fd7cd8503aae","company_corpus:cms_cn_protocol_corpus_20260715_v1:9691f7c94f6c58","company_corpus:cms_cn_protocol_corpus_20260715_v1:9895ed0bd2ffd4","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83"]},{"ai_run_id":"airun_20261007145652_44d4f869","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_b88e90fe0d39f0246cb9:revision:4","quote":"主要终点：按随机化分层的Cochran-Mantel-Haenszel检验（分层：年龄组/基线vIGA/地区），报告优势比及95%CI；敏感性分析含多重填补（补救/脱落）与logistic回归协变量校正。","quote_sha256":"084735e4c28fc4a77e3ea8e8cd4d7012e93497c33ca38a988406b49cf63e1988","source_id":"current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80","span_id":"es_stat_01"},{"locator":"study_definition:mwdefinition_b88e90fe0d39f0246cb9:revision:4","quote":"关键次要按层级顺序控制I类错误（EASI-75→瘙痒NRS4→EASI变化）；连续终点用MMRM/ANCOVA。","quote_sha256":"361682e87f96622e14aebc01f6d4d48c18c3dbc6a6b57ea8f824b165e28defcb","source_id":"current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80","span_id":"es_stat_02"},{"locator":"study_definition:mwdefinition_b88e90fe0d39f0246cb9:revision:4","quote":"安全性按组描述，52周暴露-不良反应表与皮肤肿瘤监测汇总。分析集mITT/安全性/PP依ICH E9。","quote_sha256":"d37d1b7a1cd573f376ea344ef435bdc0b35ce23aa123de198e97479d8ac155c1","source_id":"current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80","span_id":"es_stat_03"},{"locator":"study_definition:mwdefinition_b88e90fe0d39f0246cb9:revision:4","quote":"主要估计目标（治疗策略）：在≥12岁中重度AD人群中，无论是否中止研究治疗或使用补救治疗，评价磷酸芦可替尼乳膏1.5% BID相较赋形剂对第8周vIGA-AD治疗成功比例的作用。补救治疗记录为伴发事件；主期未成功者按方案进入rescue并保留于主要分析（mITT）。","quote_sha256":"e29359365d5c12a85543da38531bd377a5844a4bd64aeab38c28ca45428ba594","source_id":"current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80","span_id":"es_stat_04"}],"evidence_review_advisories":[],"evidence_span_ids":["es_stat_01","es_stat_02","es_stat_03","es_stat_04"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"获取SAP中MMRM/ANCOVA的协变量、重复测量结构及缺失数据处理方法","category":"source_not_retrieved","gap_id":"gap_9_mmrn_model","missing_source_classes":["统计分析报告（SAP）"],"target":"9节连续终点模型段落"},{"action":"获取安全性表格呈现格式、暴露-不良反应表阈值及皮肤肿瘤监测汇总方式","category":"source_not_retrieved","gap_id":"gap_9_safety_table","missing_source_classes":["安全性分析细则"],"target":"9节安全性分析段落"},{"action":"获取多重填补具体方法、logistic回归协变量选择及敏感性分析细则","category":"source_not_retrieved","gap_id":"gap_9_sensitivity","missing_source_classes":["统计分析报告（SAP）"],"target":"9节敏感性分析段落"}],"heading":"统计分析","missing_source_classes":["统计分析报告（SAP）中MMRM/ANCOVA具体模型设定","安全性表格呈现格式与阈值定义","多重填补具体方法与敏感性分析细则"],"proposal_text":"主要终点为第8周vIGA-AD治疗成功（清晰或几乎清晰且较基线下降≥2分）的受试者比例，采用按随机化分层的Cochran-Mantel-Haenszel检验，分层因素为年龄组（12至17岁与18岁及以上）、基线vIGA-AD评分（3分与4分）和地区，报告优势比及95%置信区间。敏感性分析包括多重填补（针对补救治疗与脱落）和logistic回归协变量校正。关键次要终点按层级顺序控制I类错误，顺序为第8周EASI-75应答比例、第8周周均峰值瘙痒NRS4应答（较基线下降≥4分）比例、第8周EASI较基线百分比变化；连续终点采用MMRM或ANCOVA模型。主要估计目标为治疗策略，在≥12岁中重度特应性皮炎人群中，无论是否中止研究治疗或使用补救治疗，评价磷酸芦可替尼乳膏1.5%每日两次相较赋形剂对第8周vIGA-AD治疗成功比例的作用；补救治疗记录为伴发事件，主期未成功者按方案进入rescue路径并保留于主要分析集。分析集包括修改意向治疗集（mITT）、安全性分析集和符合方案集（PP），依据ICH E9指导原则定义。安全性分析按治疗组描述，包括52周暴露-不良反应表与皮肤肿瘤监测汇总。","rationale":"主要终点检验方法（CMH分层）、关键次要终点层级顺序（EASI-75→瘙痒NRS4→EASI变化）、连续终点模型（MMRM/ANCOVA）、估计目标策略（治疗策略、rescue保留于mITT）、分析集定义（mITT/安全性/PP依ICH E9）及安全性描述方式（52周暴露-不良反应表与皮肤肿瘤监测汇总）均来自本项目已确认研究事实。MMRM/ANCOVA的具体模型设定（协变量选择、重复测量结构、缺失数据处理方法）及安全性表格的具体呈现格式和阈值需统计师与医学经理共同确认。","review_advisories":["本节复述高影响研究设计（统计分析）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、估计目标、伴发事件）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5802328cf94b_3a7bc6202e7e3385","section_number":"9","source_ids":["protocol_full_draft_selection:1571f1e4ccbd1a66ebd4e791","current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80","company_corpus:cms_cn_protocol_corpus_20260715_v1:152c1e08c78e76","company_corpus:cms_cn_protocol_corpus_20260715_v1:30fd7cd8503aae","company_corpus:cms_cn_protocol_corpus_20260715_v1:9691f7c94f6c58","company_corpus:cms_cn_protocol_corpus_20260715_v1:9895ed0bd2ffd4","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83"]}],"source_bindings":[{"content_sha256":"2c36ba1b91b63486136157dfcd1734a093c449db9052fea5b7561f2ab1656ae6","locator":"document:mwdoc_greenfield_proj_user_5802328cf94b_69278d1f7aa982ed:full-draft:1571f1e4ccbd1a66ebd4e791","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:1571f1e4ccbd1a66ebd4e791","source_type":"protocol_full_draft_selection","source_version":"full-draft:eca54904aa60ef4f68b1c37a4766294930e81de8f140fb1e8b1422cf107bedcb:1571f1e4ccbd1a66ebd4e791","text_sha256":"2c36ba1b91b63486136157dfcd1734a093c449db9052fea5b7561f2ab1656ae6"},{"content_sha2