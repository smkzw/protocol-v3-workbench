{"ai_route":{"actual_response_model":"mtplx-flash-next-optimized-speed","ai_run_id":"airun_20261007135427_9d5edd67","expected_response_model":"mtplx-flash-next-optimized-speed","fallback_chain_id":"aifb_4f1f92983e52efac583d5e58","fallback_depth":0,"fallback_reason":"","model":"mtplx-flash-next-optimized-speed","provider":"mtplx","reasoning_effort":"xhigh","route_base_url":"http://127.0.0.1:8002/v1","route_identity_hash":"c9480819205db8521fec70763515cf905334434da194fa8ae2172b40ab545075","route_profile_id":"independent_ai__mtplx_qwen38_local","thinking":"enabled"},"ai_run_id":"airun_20261007135427_9d5edd67","chunk_index":4,"job_id":"mwjob_cef05e26bc06adc6d09934dd","precondition_digest":"eca54904aa60ef4f68b1c37a4766294930e81de8f140fb1e8b1422cf107bedcb","project_id":"proj_user_5802328cf94b","schema_version":"protocol_full_draft_chunk_v10","section_ids":["mwsec_greenfield_proj_user_5802328cf94b_ca8ba2211137289d","mwsec_greenfield_proj_user_5802328cf94b_6b034b6232eaae41","mwsec_greenfield_proj_user_5802328cf94b_84d88b9eb3572e49","mwsec_greenfield_proj_user_5802328cf94b_78f78506d6cf7be3"],"sections":[{"ai_run_id":"airun_20261007135427_9d5edd67","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_b88e90fe0d39f0246cb9:revision:4","quote":"随机化按年龄组（12~17 vs ≥18岁）、基线严重度（vIGA-AD 3 vs 4）与地区分层，2:1分配（芦可替尼:赋形剂）以扩大安全性暴露经验。","quote_sha256":"664277b11214749d7f6e8070c70fd3195b2e152af6a468b10d86de131020f7a8","source_id":"current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80","span_id":"es_rand_strat"},{"locator":"study_definition:mwdefinition_b88e90fe0d39f0246cb9:revision:4","quote":"2:1分配（芦可替尼:赋形剂）以扩大安全性暴露经验。","quote_sha256":"fe9d083b5484d8bd06a9672dead61fc0514bc7426cd044b8425b45c9d0535367","source_id":"current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80","span_id":"es_rand_ratio"},{"locator":"document:mwdoc_greenfield_proj_user_5802328cf94b_69278d1f7aa982ed:full-draft:34672929112d36a9a1906e11","quote":"采用随机化分配。","quote_sha256":"abb7a27e76e1676c12ab199e8d9abdac80371053749a69fb6f2ee1faa8f01db8","source_id":"protocol_full_draft_selection:34672929112d36a9a1906e11","span_id":"es_rand_alloc"}],"evidence_review_advisories":[],"evidence_span_ids":["es_rand_strat","es_rand_ratio","es_rand_alloc"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"补充随机化实施方法的项目文件或确认采用中央交互式应答系统","category":"source_missing","gap_id":"gap_rand_method","missing_source_classes":["随机化实施方法文件"],"target":"随机化实施方法（中央随机系统类型、区组大小、序列生成方式）"}],"heading":"随机化","missing_source_classes":["随机化实施方法文件（如IWRS/IRT系统说明）","区组大小与随机化序列生成规范"],"proposal_text":"本研究采用随机化分配，受试者按2:1的比例随机分配至磷酸芦可替尼乳膏1.5%组或赋形剂乳膏对照组，以扩大试验组的安全性暴露经验。随机化采用分层设计，分层因素包括年龄组（12~17岁与≥18岁）、基线疾病严重度（vIGA-AD 3分与4分）及研究中心所在地区。随机化在基线访视（第1天）完成，受试者经筛选合格并签署知情同意后进入随机化流程。","rationale":"随机化分配方式、2:1分配比、分层因素（年龄组、基线vIGA-AD严重度、地区）及分配目的（扩大安全性暴露）均来自当前项目已确认研究事实。随机化实施方法（如中央随机系统类型、区组大小、序列生成方式）及执行责任方尚无来源支持，需医学经理补充确认。","review_advisories":["本节复述高影响研究设计（随机化）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5802328cf94b_ca8ba2211137289d","section_number":"4.3","source_ids":["protocol_full_draft_selection:34672929112d36a9a1906e11","current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80"]},{"ai_run_id":"airun_20261007135427_9d5edd67","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_b88e90fe0d39f0246cb9:revision:4","quote":"赋形剂（vehicle）乳膏对照：外观气味一致不含活性成分，同法每日两次。","quote_sha256":"594ee334f5afe06e0f3da893bd5e234e73dbc7ce9125716eaebcac0e9c235e5a","source_id":"current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80","span_id":"es_blind_design"},{"locator":"document:mwdoc_greenfield_proj_user_5802328cf94b_69278d1f7aa982ed:full-draft:34672929112d36a9a1906e11","quote":"本研究采用双盲设计。","quote_sha256":"fe6efce93e02fe3c382cf514c2c89d4778531866fbff09bb8ca822e03e54e66a","source_id":"protocol_full_draft_selection:34672929112d36a9a1906e11","span_id":"es_blind_sec"}],"evidence_review_advisories":[],"evidence_span_ids":["es_blind_design","es_blind_sec"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[{"action":"补充紧急揭盲程序的项目文件或确认揭盲规则","category":"source_missing","gap_id":"gap_unblind_proc","missing_source_classes":["紧急揭盲程序文件"],"target":"紧急揭盲触发条件、操作流程及揭盲后数据处理"},{"action":"确认各角色盲态范围及维护措施","category":"source_missing","gap_id":"gap_blind_scope","missing_source_classes":["盲态维持与揭盲操作规范"],"target":"盲态维持责任人员范围（受试者、研究者、评价者、DMC等）"}],"heading":"盲法与揭盲","missing_source_classes":["紧急揭盲程序文件","盲态维持与揭盲操作规范"],"proposal_text":"本研究采用双盲设计。试验药为磷酸芦可替尼乳膏1.5%，对照药为赋形剂（vehicle）乳膏，二者外观、气味一致且赋形剂不含活性成分，受试者与研究者均无法通过感官区分试验药与对照药。两组均按每日两次（早晚）薄涂受累部位的相同给药方式操作，以维持盲态。","rationale":"双盲设计、赋形剂外观气味一致不含活性成分、同法每日两次给药方式均来自当前项目已确认研究事实。紧急揭盲触发条件、揭盲操作流程、揭盲后数据处理规则及盲态维持责任人员范围尚无来源支持，需医学经理确认。","review_advisories":["本节复述高影响研究设计（盲法与揭盲）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5802328cf94b_6b034b6232eaae41","section_number":"4.4","source_ids":["protocol_full_draft_selection:34672929112d36a9a1906e11","current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80"]},{"ai_run_id":"airun_20261007135427_9d5edd67","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_5802328cf94b_69278d1f7aa982ed:full-draft:34672929112d36a9a1906e11","quote":"设置独立数据监查委员会（DMC）","quote_sha256":"ed66d6060d86028cbf9c8ac6cdb1e6dc05d941bc80fde1d78edc4b67f7b84a0a","source_id":"protocol_full_draft_selection:34672929112d36a9a1906e11","span_id":"es_dmc_planned"}],"evidence_review_advisories":[],"evidence_span_ids":["es_dmc_planned"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"补充DMC章程或确认DMC实施安排","category":"source_missing","gap_id":"gap_dmc_charter","missing_source_classes":["数据监查委员会章程","DMC组成与职责说明"],"target":"DMC章程、组成（成员专业背景）、会议频率与沟通机制"},{"action":"确认是否设置期中分析及停止规则，或补充相关项目文件","category":"source_missing","gap_id":"gap_dmc_rules","missing_source_classes":["停止规则与期中分析计划"],"target":"停止规则、期中分析触发条件及安全性数据审阅范围"}],"heading":"安全性审评/数据监查委员会","missing_source_classes":["数据监查委员会章程","DMC组成与职责说明","停止规则与期中分析计划","DMC与申办方沟通机制文件"],"proposal_text":"本研究设置独立数据监查委员会（DMC），负责定期审阅研究期间积累的安全性数据，包括用药部位反应、皮肤感染、皮肤恶性肿瘤与光化性角化病监测、血细胞减少信号及严重不良事件的发生情况。本研究不计划进行期中分析，DMC的审阅活动以安全性监测为主要目的。DMC的具体组成、会议频率、审阅数据范围、停止规则及与申办方的沟通机制将在DMC章程中另行规定。","rationale":"DMC计划设置（DMC是否计划：是）及不计划期中分析（期中分析是否计划：否）来自当前项目已确认研究事实；安全性监测关注内容（用药部位反应、皮肤感染、皮肤肿瘤监测、血细胞减少）来自已确认安全性终点描述。DMC章程、组成、会议频率、停止规则及沟通机制等实施细节缺少对应项目文件，需医学经理确认。","review_advisories":["本节提及高影响设计信息（期中分析）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5802328cf94b_84d88b9eb3572e49","section_number":"4.5","source_ids":["protocol_full_draft_selection:34672929112d36a9a1906e11","current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80"]},{"ai_run_id":"airun_20261007135427_9d5edd67","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_5802328cf94b_69278d1f7aa982ed:full-draft:34672929112d36a9a1906e11","quote":"筛选期（最长28天，含≥1周瘙痒日记与保湿稳定）；双盲主期（第1~8周）；长期安全延长期（第9~52周，主期治疗成功者）；安全性随访（末次用药后4周）","quote_sha256":"52f5c21b6c6594db932a6098826a8ff1238ad81328b5fae96a92a09a1a360d2b","source_id":"protocol_full_draft_selection:34672929112d36a9a1906e11","span_id":"es_study_periods"},{"locator":"study_definition:mwdefinition_b88e90fe0d39f0246cb9:revision:4","quote":"研究时期：筛选期（最长28天，含≥1周瘙痒日记与保湿稳定）；双盲主期（第1~8周）；长期安全延长期（第9~52周，主期治疗成功者）；安全性随访（末次用药后4周）","quote_sha256":"f78c4522db30e8a7f3303b9494a7424fad08e0a8f0e63e67f5754a6c115f12c3","source_id":"current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80","span_id":"es_study_periods_def"},{"locator":"study_definition:mwdefinition_b88e90fe0d39f0246cb9:revision:4","quote":"安全性随访（末次用药后4周电话/门诊）","quote_sha256":"a22785d70988a5259862449583b16257ec6f4cce3396379af6d046efe3eadad7","source_id":"current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80","span_id":"es_visit_strategy"}],"evidence_review_advisories":[],"evidence_span_ids":["es_study_periods","es_study_periods_def","es_visit_strategy"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"补充rescue路径操作细则或确认该路径是否在本方案中详述","category":"source_missing","gap_id":"gap_rescue_detail","missing_source_classes":["主期未成功者rescue路径操作细则"],"target":"主期未成功者转入开放补救路径的具体操作与随访安排"},{"action":"确认安全性随访的评估项目与记录要求","category":"source_missing","gap_id":"gap_fu_content","missing_source_classes":["安全性随访评估内容清单"],"target":"安全性随访（末次用药后4周）的具体评估内容与记录方式"}],"heading":"研究结束与研究持续时间","missing_source_classes":["主期未成功者rescue路径操作细则","安全性随访评估内容清单"],"proposal_text":"本研究总持续时间由以下四个阶段构成：筛选期最长28天，包含至少1周的瘙痒电子日记填写与基础保湿剂稳定使用；双盲主期为第1周至第8周，完成主要终点判定；主期治疗成功者进入长期安全延长期，即第9周至第52周，继续双盲给药以评估长期安全性与疗效维持；研究以安全性随访结束，随访期为末次用药后4周，采用电话或门诊方式进行。主期未治疗成功的受试者按方案转入开放补救路径，不再进入延长期。","rationale":"四个研究时期的名称、时长及内容（筛选期28天含≥1周日记与保湿稳定、双盲主期第1~8周、延长期第9~52周限主期成功者、安全性随访末次用药后4周电话/门诊）均来自当前项目已确认研究事实及章节包原文。主期未成功者转入rescue路径的具体操作细节及安全性随访的评估内容尚无来源支持，需医学经理确认。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5802328cf94b_78f78506d6cf7be3","section_number":"4.6","source_ids":["protocol_full_draft_selection:34672929112d36a9a1906e11","current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80"]}],"source_bindings":[{"content_sha256":"659c47a63a32a1e92d55d91d61bc2d7d85851b9c82416073a45f8f0d4981078f","locator":"document:mwdoc_greenfield_proj_user_5802328cf94b_69278d1f7aa982ed:full-draft:34672929112d36a9a1906e11","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:34672929112d36a9a1906e11","source_type":"protocol_full_draft_selection","source_version":"full-draft:eca54904a