<50）","quote_sha256":"f6f1085b49aaa2bcd45d7380f047a2b5b6a58f371f70f691db20279749e6ceda","source_id":"current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80","span_id":"es_exclusion_lab"},{"locator":"study_definition:mwdefinition_b88e90fe0d39f0246cb9:revision:4","quote":"全身状况与实验室筛查无临床显著异常","quote_sha256":"1fac090c8da8a9f5f173cd18dfadb530013c3dbf6f9bf3dde8e9bc67c08898e2","source_id":"current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80","span_id":"es_inclusion_lab"},{"locator":"study_definition:mwdefinition_b88e90fe0d39f0246cb9:revision:4","quote":"系统暴露极低（较口服低约90%）","quote_sha256":"720b9ac6d07785e7152ae77f881bff37ae661718793254d0bbe7d82948830424","source_id":"current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80","span_id":"es_pk_mechanism"},{"locator":"study_definition:mwdefinition_b88e90fe0d39f0246cb9:revision:4","quote":"安全性随访（末次用药后4周电话/门诊）","quote_sha256":"a22785d70988a5259862449583b16257ec6f4cce3396379af6d046efe3eadad7","source_id":"current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80","span_id":"es_safety_followup"}],"evidence_review_advisories":[],"evidence_span_ids":["es_lab_safety_endpoint","es_visit_screening","es_exclusion_lab","es_inclusion_lab","es_pk_mechanism","es_safety_followup"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"补充各访视（筛选、基线、主期第2/4/8周、延长期第16/28/40/52周、安全性随访）的实验室检查项目与采血时间点","category":"source_missing","gap_id":"gap_lab_timepoints","missing_source_classes":["实验室检查完整项目清单及各访视差异化安排"],"target":"7.3.3 实验室检查"},{"action":"明确实验室异常值触发剂量暂停、减量或永久停药的阈值","category":"source_missing","gap_id":"gap_lab_threshold","missing_source_classes":["剂量调整或暂停的实验室触发阈值"],"target":"7.3.3 实验室检查"}],"heading":"实验室检查","missing_source_classes":["实验室检查完整项目清单及各访视差异化安排","剂量调整或暂停的实验室触发阈值","延长期及安全性随访期实验室监测频率"],"proposal_text":"本研究在筛选访视（第-28天至第-1天）中完成实验室检查，作为受试者入组资格评估的组成部分。入选标准要求全身状况与实验室筛查无临床显著异常；排除标准规定ALT或AST超过2倍正常值上限、或估算肾小球滤过率低于50 mL/min/1.73m²者不得入组。安全性监测中纳入的实验室项目包括血常规、肝肾功能及血脂。鉴于磷酸芦可替尼乳膏为外用制剂，系统暴露极低（较口服途径低约90%），安全性终点中设置血细胞减少的信号监测。各访视实验室检查的具体项目组合、采血时间点、是否每次访视均重复全部项目、以及延长期（第9至52周）和安全性随访期（末次用药后4周）的实验室监测频率，需依据药物安全性特征及监管要求另行确定。","rationale":"安全性终点明确列出血常规、肝肾功能、血脂；筛选访视包含实验室环节；排除标准给出ALT/AST>2×ULN及eGFR<50阈值；入选标准要求实验室筛查无临床显著异常；药物机制描述确认系统暴露极低。但各访视具体采血安排、完整项目清单及剂量调整触发阈值在允许来源中未给出，需医学经理确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5802328cf94b_5d39b1fdab9d4ce2","section_number":"7.3.3","source_ids":["protocol_full_draft_selection:d3efca1b0f22c89f88cb054a","current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80"]},{"ai_run_id":"airun_20261007141632_e4998eba","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_b88e90fe0d39f0246cb9:revision:4","quote":"育龄女性妊娠试验阴性并同意有效避孕","quote_sha256":"7121a4b9bdeaf17cbae0628aa4ffacaca3d109cf4d3c99fa1a1282c3cd89ecad","source_id":"current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80","span_id":"es_inclusion_pregnancy"},{"locator":"study_definition:mwdefinition_b88e90fe0d39f0246cb9:revision:4","quote":"妊娠或哺乳期","quote_sha256":"b703a3d2d679f4c61fc5f87ed3017dfadd1bff9cc1d021a4c041f47c6c73ff9f","source_id":"current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80","span_id":"es_exclusion_pregnancy"}],"evidence_review_advisories":[],"evidence_span_ids":["es_inclusion_pregnancy","es_exclusion_pregnancy"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"明确妊娠检查方法（尿HCG或血清β-HCG）、各访视重复检测时点及阳性处理流程","category":"source_missing","gap_id":"gap_preg_method","missing_source_classes":["妊娠检查方法与重复检测时点"],"target":"7.3.4 妊娠检查和避孕问询"},{"action":"确定有效避孕方法类型、避孕起始与终止时点、伴侣妊娠报告要求","category":"source_missing","gap_id":"gap_contraception","missing_source_classes":["有效避孕方法的具体要求"],"target":"7.3.4 妊娠检查和避孕问询"},{"action":"获取药物生殖毒性非临床数据以支持避孕与妊娠处理条款","category":"source_missing","gap_id":"gap_repro_tox","missing_source_classes":["药物生殖毒性数据（IB或非临床报告）"],"target":"7.3.4 妊娠检查和避孕问询"}],"heading":"妊娠检查和避孕问询","missing_source_classes":["妊娠检查方法与重复检测时点","有效避孕方法的具体要求","伴侣妊娠报告与新生儿随访安排","药物生殖毒性数据（IB或非临床报告）"],"proposal_text":"本研究在筛选期对育龄女性受试者进行妊娠试验，结果为阴性方可入组；同时要求育龄女性同意在研究期间采取有效避孕措施。妊娠或哺乳期女性为排除标准，不得参与本研究。本章节涵盖妊娠检查的实施要求与避孕问询的内容范围。妊娠检查的具体方法（尿液或血清β-HCG）、各访视是否重复检测及检测时点、所要求的有效避孕方法类型、伴侣妊娠报告流程、意外妊娠的随访与新生儿观察安排，以及哺乳期受试者的处理原则，需依据药物生殖毒性数据及监管要求另行确定。","rationale":"入选标准明确育龄女性妊娠试验阴性并同意有效避孕；排除标准排除妊娠或哺乳期；目标人群描述提及育龄女性避孕。但允许来源未给出妊娠检查方法、重复检测时点、具体避孕方法要求、伴侣妊娠报告及新生儿随访安排，不得由妊娠排除条件推断上述实施细节。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5802328cf94b_948560eb74b440c8","section_number":"7.3.4","source_ids":["protocol_full_draft_selection:d3efca1b0f22c89f88cb054a","current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80"]},{"ai_run_id":"airun_20261007141632_e4998eba","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取IB或既往PK/ADME资料，明确是否设置PK评估、采样时间点、PK参数及分析计划","category":"source_missing","gap_id":"gap_pk_no_source","missing_source_classes":["研究者手册（IB）中药代动力学章节","既往PK研究或非临床ADME数据","药代动力学采样方案（时间点、参数、子集）"],"target":"7.4 药代动力学评估"}],"heading":"药代动力学评估","missing_source_classes":["研究者手册（IB）中药代动力学章节","既往PK研究或非临床ADME数据","药代动力学采样方案（时间点、参数、子集）"],"proposal_text":"","rationale":"允许来源仅描述磷酸芦可替尼乳膏为外用JAK1/JAK2抑制剂、系统暴露极低（较口服低约90%）、局部/系统暴露范围为local，但未提供药代动力学评估方案，包括PK采血时间点、PK参数（Cmax、AUC、Tmax、t½等）、PK采样受试者子集、稳态PK评估、食物或部位影响、以及PK与安全性/疗效的关联分析设计。缺少IB、既往PK研究或非临床ADME数据，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5802328cf94b_6b490e1a21af3250","section_number":"7.4","source_ids":["protocol_full_draft_selection:d3efca1b0f22c89f88cb054a","current_p