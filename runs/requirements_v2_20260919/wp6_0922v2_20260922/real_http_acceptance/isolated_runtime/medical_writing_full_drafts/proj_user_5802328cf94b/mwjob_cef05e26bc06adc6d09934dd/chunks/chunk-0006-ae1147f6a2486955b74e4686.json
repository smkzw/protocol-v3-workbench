visories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"查阅药品管理SOP及随机化系统对接文件","category":"source_missing","gap_id":"gap_613_dispense","missing_source_classes":["药品管理SOP","随机化系统文件"],"target":"各访视发药量计算规则与药品编号分配方式"},{"action":"查阅药品管理SOP","category":"source_missing","gap_id":"gap_613_recover","missing_source_classes":["药品管理SOP"],"target":"剩余药量回收核对流程与空包装处理"},{"action":"查阅药品管理SOP及申办者药品回收协议","category":"source_missing","gap_id":"gap_613_return","missing_source_classes":["药品管理SOP","药品回收协议"],"target":"药品返还申办者时限与销毁流程"},{"action":"查阅给药操作手册","category":"source_missing","gap_id":"gap_613_bsa_dose","missing_source_classes":["给药操作手册"],"target":"单周用量上限按BSA核定的具体分级阈值"}],"heading":"发放、回收与清点","missing_source_classes":["药品管理SOP（发放、回收、清点、返还、销毁全流程）","给药操作手册（BSA分级用量上限具体数值）","药品编号分配与随机化对接文件"],"proposal_text":"","rationale":"本章节需覆盖试验用药品从申办者到研究中心的发放流程、各访视发药量计算与分配、受试者用药指导、剩余药量回收与清点、空包装处理、药品返还申办者及销毁等完整链条。当前允许来源中仅确认依从性由日记与药量清点双核查、单周用量上限按BSA核定并清点回收，但未提供本项目专属的药品发放操作规程、药品编号分配方式、各访视具体发药量计算规则、回收核对流程、空包装处理要求及返还申办者时限。公司语料中CMD-D001方案的通用药品管理描述（由药品管理人员分发、记录、返还申办者销毁）仅为结构参照，不可直接作为本项目既定规则。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5802328cf94b_c20c39aac5d456a2","section_number":"6.1.3","source_ids":["protocol_full_draft_selection:ae1147f6a2486955b74e4686","current_project_study_definition:mwdefinition_b88e90fe0d39f0246cb9:r4:f0c046e418e0ae80","company_corpus:cms_cn_protocol_corpus_20260715_v1:07d6f64c91e3a6","company_corpus:cms_cn_protocol_corpus_20260715_v1:6b24da94f33534","company_corpus:cms_cn_protocol_corpus_20260715_v1:6eab08a4bddb3d","company_corpus:cms_cn_protocol_corpus_20260715_v1:19c9ebe4894c86","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791"]}],"source_bindings":[{"content_sha256":"3e94c4b23b04991459861001e2707af0496312bd1ccfe5b25b02dbc06eea076d","locator":"document:mwdoc_greenfield_proj_user_5802328cf94b_69278d1f7aa982ed:full-draft:ae1147f6a248695