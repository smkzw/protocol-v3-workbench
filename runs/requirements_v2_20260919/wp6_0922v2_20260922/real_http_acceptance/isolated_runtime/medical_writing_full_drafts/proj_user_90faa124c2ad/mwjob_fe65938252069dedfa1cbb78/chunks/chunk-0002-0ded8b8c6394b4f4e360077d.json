_full_draft_selection:0ded8b8c6394b4f4e360077d","current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261006054226_1b86a295","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_5108d1569945a1e49dcb:revision:7","quote":"靶点/作用机制：P2X3受体拮抗（高选择性P2X3:P2X2/3选择性>100倍）","quote_sha256":"74174d2ab1dfe5318c3f766cce6d4e0717304b313496d991702942c0956d0694","source_id":"current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","span_id":"es_002"},{"locator":"study_definition:mwdefinition_5108d1569945a1e49dcb:revision:7","quote":"内在研究目的：剂量探索；概念验证（PoC）","quote_sha256":"8ca66e74ba28291867d2d1378914db566ffcfebe69403ce3e95bccb019a6481e","source_id":"current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","span_id":"es_003"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"补充R5A-PX501在慢性咳嗽动物模型中的药效学数据及受体占有率-效应关系","category":"source_missing","gap_id":"gap_24_01","missing_source_classes":["非临床药效学报告","动物模型研究数据"],"target":"2.4 本研究的理论基础——非临床药效学证据"},{"action":"补充I期PK/PD数据及剂量-暴露-效应关系，以支撑20mg与40mg剂量选择","category":"source_missing","gap_id":"gap_24_02","missing_source_classes":["I期临床研究报告","PK/PD建模报告"],"target":"2.4 本研究的理论基础——剂量选择依据"}],"heading":"本研究的理论基础","missing_source_classes":["P2X3受体在咳嗽反射弧中的信号通路文献","R5A-PX501非临床药效学数据（动物模型）","P2X2/3选择性对味觉功能影响的非临床证据","既往I期PK/PD数据以支撑剂量选择逻辑"],"proposal_text":"R5A-PX501为高选择性P2X3受体拮抗剂，对P2X3受体的选择性较P2X2/3异源三聚体超过100倍。P2X3受体主要表达于感觉神经元末梢，参与外周咳嗽反射弧的传入信号转导；高选择性阻断P2X3而非P2X2/3，旨在抑制咳嗽敏化通路的同时降低对P2X2/3介导的味觉及一般感觉功能的干扰。本研究为II期剂量探索与概念验证研究，设置20mg与40mg两个活性剂量组及匹配双模拟安慰剂组，按1:1:1随机分配，40mg组第1周以20mg滴定导入以降低初始味觉相关不良事件风险。研究旨在通过客观咳嗽频率、咳嗽严重度及生活质量等多维终点，初步验证P2X3受体拮抗在难治性/不明原因慢性咳嗽人群中的疗效信号，并为III期剂量选择提供依据。","rationale":"已确认事实：靶点为P2X3受体拮抗、选择性>100倍、II期剂量探索与PoC目的、20mg/40mg双剂量、40mg组第1周20mg滴定导入、1:1:1随机、双模拟安慰剂对照。P2X3受体在咳嗽反射弧中的具体信号通路描述及非临床药效学数据（如动物模型中C5降低幅度、受体占有率-效应关系）未在允许来源中提供，上述机制描述为基于已确认靶点信息的合理推断，需医学经理核实准确性。味觉干扰的降低为选择性设计的预期优势，非临床验证数据待补充。","review_advisories":["本节提及高影响设计信息（剂量选择）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_90faa124c2ad_9e3492f90e05cdaf","section_number":"2.4","source_ids":["protocol_full_draft_selection:0ded8b8c6394b4f4e360077d","current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261006054226_1b86a295","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_5108d1569945a1e49dcb:revision:7","quote":"主要终点：治疗第8周24小时咳嗽频率（客观监测，几何均数）较基线的变化率（%）","quote_sha256":"3f11b054fb9a9e15803c3b92bf825b224efc56dfac95422a2d6cc385fbf8435b","source_id":"current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","span_id":"es_004"},{"locator":"study_definition:mwdefinition_5108d1569945a1e49dcb:revision:7","quote":"次要研究目的：评价第2、4、8周24小时咳嗽频率较基线变化（起效时间）；咳嗽严重度VAS与咳嗽相关生活质量（LCQ）较基线变化；白天/夜间咳嗽频率差异；评价安全性与耐受性，重点为味觉障碍（味觉功能问卷+客观味觉测试）","quote_sha256":"b77f55a945d9773fd7d65f5fa576e0ea41dbe11a564a4e7e8a6b420e96049c56","source_id":"current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","span_id":"es_005"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004","es_005"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[],"heading":"研究目的和终点","missing_source_classes":[],"proposal_text":"本研究的主要研究目的为评价R5A-PX501 20mg与40mg每日一次口服8周治疗难治性慢性咳嗽较安慰剂对咳嗽频率的改善，为III期剂量选择提供依据。主要终点为治疗第8周24小时咳嗽频率（客观监测，几何均数）较基线的变化率（%）。次要研究目的包括：评价第2、4、8周24小时咳嗽频率较基线变化以观察起效时间；评价咳嗽严重度视觉模拟评分（VAS）与咳嗽相关生活质量量表（LCQ）较基线变化；评价白天与夜间咳嗽频率差异；评价安全性与耐受性，重点关注味觉障碍（通过味觉功能问卷与客观味觉测试评估）。关键次要终点为第8周LCQ总分变化及咳嗽频率较基线下降≥30%的应答率。安全性终点包括治疗期间不良事件（TEAE）与严重不良事件（SAE）发生率、味觉障碍发生率与严重程度、实验室检查、12导联心电图及生命体征。","rationale":"主要目的、主要终点、次要目的、关键次要终点及安全性终点均来源于当前项目已确认研究事实（R5A-PX501-201方案定义V1.0）。需医学经理确认：LCQ量表版本及授权状态；味觉功能问卷与客观味觉测试的具体工具名称及操作规范；咳嗽频率客观监测设备型号及数据采集协议。","review_advisories":["本节复述高影响研究设计（研究目的和终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、剂量选择）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_90faa124c2ad_b27f6194aa71bf9f","section_number":"3","source_ids":["protocol_full_draft_selection:0ded8b8c6394b4f4e360077d","current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261006054226_1b86a295","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_5108d1569945a1e49dcb:revision:7","quote":"探索性研究目的：咳嗽反射敏感化（辣椒素激发试验C5）与应答的关系","quote_sha256":"e69a33d57506b29449d729337a4c7acee8b2b39b677f2174d703c3e905666cd9","source_id":"current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","span_id":"es_006"}],"evidence_review_advisories":[],"evidence_span_ids":["es_006"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[{"action":"确认辣椒素激发试验C5的浓度梯度方案、吸入装置型号、判读标准及采集时点（是否覆盖W2/W4/W8）","category":"source_missing","gap_id":"gap_33_01","missing_source_classes":["辣椒素激发试验操作手册","咳嗽反射评估方法学文献"],"target":"3.3 探索性目的和探索性终点——辣椒素激发试验操作规范"},{"action":"确认C5与主要终点及应答率的关联分析统计方法（如Pearson/Spearman相关、亚组分析切点）","category":"source_missing","gap_id":"gap_33_02","missing_source_classes":["统计分析计划（SAP）"],"target":"3.3 探索性目的和探索性终点——关联分析计划"}],"heading":"探索性目的和探索性终点","missing_source_classes":["辣椒素激发试验C5操作规范及判读标准","咳嗽反射敏感化与P2X3受体拮抗关联的非临床证据","探索性终点统计分析计划"],"proposal_text":"本研究的探索性研究目的为评价咳嗽反射敏感化（辣椒素激发试验C5）与R5A-PX501治疗应答之间的关系。辣椒素激发试验通过吸入递增浓度辣椒素气雾剂，记录引起连续5次咳嗽的最低辣椒素浓度（C5），作为咳嗽反射敏感性的客观量化指标。本研究在筛选期及治疗期访视中采集C5数据，旨在探索P2X3受体拮抗是否通过降低外周咳嗽反射敏感性发挥抗咳嗽作用，并分析基线C5水平及治疗期间C5变化与主要终点（第8周24小时咳嗽频率变化率）及关键次要终点（咳嗽频率下降≥30%应答）之间的相关性，为III期研究是否纳入咳嗽反射敏感性作为分层因素或生物标志物提供初步依据。","rationale":"探索性研究目的（咳嗽反射敏感化与应答的关系）及辣椒素激发试验C5作为评价工具已在项目研究事实中确认。辣椒素激发试验在筛选期及治疗期访视中采集的安排来源于研究时期描述。C5的具体操作方案（辣椒素浓度梯度、吸入装置、判读标准）、采集时点是否覆盖所有治疗访视、与主要终点的关联分析统计方法等实施细节未在允许来源中明确，需医学经理确认。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_90faa124c2ad_4b38923320e8a4a7","section_number":"3.3","source_ids":["protocol_full_draft_selection:0ded8b8c6394b4f4e360077d","current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]}],"source_bindings":[{"content_sha256":"890d74d44273dc2e57ef893d15fd358bcba591dec6a14872b9a8a234e15a5601","locator":"document:mwdoc_greenfield_proj_user_90faa124c2ad_246db92c9af41aa3:full-draft:0ded8b8c6394b4f4e360077d","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:0de