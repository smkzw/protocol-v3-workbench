ationale":"附录章节需要列出方案所附文件清单（如知情同意书、病例报告表、实验室操作手册、咳嗽监测设备操作指南、味觉功能问卷、LCQ量表、咳嗽VAS量表、辣椒素激发试验操作规程、药物管理记录表、安全性事件报告表等）。当前允许来源虽提及咳嗽监测设备、电子日记、LCQ、咳嗽VAS、味觉功能问卷、客观味觉测试、辣椒素激发试验C5、12导联心电图等评估工具名称，但未给出附录文件清单、各文件版本或授权状态。附录内容清单需由项目文件包或方案编写规范确认后方可撰写。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_90faa124c2ad_fb433a4142226167","section_number":"14","source_ids":["protocol_full_draft_selection:d2c71c3671b9d9528fb58f08","current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c"]},{"ai_run_id":"airun_20261006073331_49ce3a9c","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_5108d1569945a1e49dcb:revision:7","quote":"育龄女性妊娠试验阴性并同意有效避孕","quote_sha256":"7121a4b9bdeaf17cbae0628aa4ffacaca3d109cf4d3c99fa1a1282c3cd89ecad","source_id":"current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","span_id":"es2"},{"locator":"study_definition:mwdefinition_5108d1569945a1e49dcb:revision:7","quote":"妊娠或哺乳期","quote_sha256":"b703a3d2d679f4c61fc5f87ed3017dfadd1bff9cc1d021a4c041f47c6c73ff9f","source_id":"current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","span_id":"es3"}],"evidence_review_advisories":[],"evidence_span_ids":["es2","es3"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"获取研究者手册中生殖毒性数据及项目级妊娠管理方案，确定具体避孕方法、伴侣避孕要求、妊娠报告流程与随访方案","category":"source_missing","gap_id":"gap_14_1_contraception_method","missing_source_classes":["研究者手册生殖毒性章节","项目级妊娠管理方案","避孕方法具体规定"],"target":"14.1 避孕的规定与方法"}],"heading":"避孕的规定与方法","missing_source_classes":["研究者手册生殖毒性章节","项目级妊娠管理方案","避孕方法具体规定","妊娠报告与随访流程"],"proposal_text":"本研究排除妊娠或哺乳期女性。育龄期女性受试者在筛选期须接受妊娠试验且结果为阴性，并须同意在研究期间采取有效避孕措施。有效避孕方法的具体种类、伴侣避孕要求、妊娠事件报告流程、妊娠随访方案及哺乳期女性参与条件，须由医学负责人依据试验药物非临床生殖毒性数据及研究者手册中已确认的安全性信息确定后写入本章节。","rationale":"当前项目研究事实确认排除标准为'妊娠或哺乳期'，入选标准要求'育龄女性妊娠试验阴性并同意有效避孕'。上述内容支持本章节写入排除与入选层面的避孕原则。但具体避孕方法（如屏障法、激素避孕、宫内节育器或组合方案）、伴侣避孕要求、妊娠报告时限与对象、妊娠随访终点、哺乳期参与条件等实施规则在允许来源中未给出，不得自行指定。需补充研究者手册中生殖毒性章节及项目级妊娠管理方案后方可完善本章节。","review_advisories":["本节复述高影响研究设计（避孕的规定与方法）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_90faa124c2ad_03cdb2c90fd458c0","section_number":"14.1","source_ids":["protocol_full_draft_selection:d2c71c3671b9d9528fb58f08","current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c"]}],"source_bindings":[{"content_sha256":"2b54f1cc4cebe9ac5d19aff49f96f85173a07f995ae497346033f0b29c2c8d22","locator":"document:mwdoc_greenfield_proj_user_90faa124c2ad_246db92c9af41aa3:full-draft:d2c71c3671b9d9528fb58f08","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:d2c71c3671b9d9528fb58f08","source_type":"protocol_full_draft_selection","source_version":"full-draft:cef2e5b7988d9864d1b98dfb0bc95e057f2c396180e4f95d9f038e0de4071b58:d2c71c3671b9d9528fb58f08","text_sha256":"2b54f1cc4cebe9ac5d19aff49f96f85173a07f995ae497346033f0b29c2c8d22"},{"content_sha256":"01fb60f91790159b3d342d91540f420017aa470272eae36591eeb66d47b33be7","locator":"study_definition:mwdefinition_5108d1569945a1e49dcb:revision:7","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","source_type":"current_project_study_definition","source_version":"mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","text_sha256":"01fb60f91790159b3d342d91540f420017aa470272eae36591eeb66d47b33be7"}]}