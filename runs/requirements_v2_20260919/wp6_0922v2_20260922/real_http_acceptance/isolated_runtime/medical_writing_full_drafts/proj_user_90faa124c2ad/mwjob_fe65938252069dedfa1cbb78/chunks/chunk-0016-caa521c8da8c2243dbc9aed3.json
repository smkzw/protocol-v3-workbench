tocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:9939b9aa574982","source_type":"company_protocol_reference_corpus","source_version":"9939b9aa574982","text_sha256":"8c00d952902c465f026158960140334bd1b43967486ea30ba07f603c2e0ab747"},{"content_sha256":"526307b577de87d936742f3dc805ba1d7885dbae60f521db4422defd399e40f3","locator":"section:11.1 遵守法律法规|block:922|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:1e80f33ff07300","source_type":"company_protocol_reference_corpus","source_version":"1e80f33ff07300","text_sha256":"526307b577de87d936742f3dc805ba1d7885dbae60f521db4422defd399e40f3"},{"content_sha256":"88c8c4dce07b71b55d0be4236a551acdce6aa01747b0ec7fa98a4d2fa5ec8100","locator":"section:伦理委员会|block:897|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:eb9da1374976e3","source_type":"company_protocol_reference_corpus","source_version":"eb9da1374976e3","text_sha256":"88c8c4dce07b71b55d0be4236a551acdce6aa01747b0ec7fa98a4d2fa5ec8100"}]}