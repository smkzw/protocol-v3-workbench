lection:1c7062eabbdbd0504998f21f","span_id":"es_002"}],"evidence_review_advisories":[],"evidence_span_ids":["es_001","es_002"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":0},"gap_items":[{"action":"确认本项目是否涉及人类遗传资源采集，获取数据保护影响评估及隐私合规方案","category":"source_missing","gap_id":"gap_11_4_01","missing_source_classes":["项目级数据保护与隐私合规方案","人类遗传资源采集与审批文件"],"target":"受试者隐私保护与数据保护法规合规条款"}],"heading":"保密与隐私","missing_source_classes":["项目级数据保护与隐私合规方案","人类遗传资源采集与审批文件","个人信息保护影响评估报告"],"proposal_text":"本方案及其附件中包含的所有信息归申办方所有，属于保密资料。根据中国相关法律法规及药物临床试验质量管理规范的要求，本方案仅提供给参与本研究的各中心研究者、合作研究者、伦理委员会及药品监督管理部门等相关机构审阅。除在与可能参加本研究的受试者签署知情同意书时向其做必要解释外，未经申办方书面授权许可，任何个人和机构不得分发、复制、发表或向与本研究无关的第三方披露本方案及其附件的任何内容。接收本方案信息的人员应被告知其所接收的信息属于保密资料，不得进一步对外披露。各研究中心应建立本方案及研究相关文件的保密管理措施，确保受试者个人可识别信息在数据采集、传输、存储和销毁各环节受到保护，符合中华人民共和国个人信息保护法及人类遗传资源管理条例等适用法规的要求。","rationale":"保密声明的监管共性结构参照了公司语料中两份不同适应症方案的保密条款，仅取章节结构和监管共性要素，未迁移其项目事实。受试者隐私保护部分涉及个人信息保护法和人类遗传资源管理条例的合规要求，但本项目是否涉及人类遗传资源采集、具体数据保护技术措施及跨境传输安排尚无项目级来源支持，需医学经理与法务合规部门确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_90faa124c2ad_1e65da6e8a1b1167","section_number":"11.4","source_ids":["protocol_full_draft_selection:1c7062eabbdbd0504998f21f","current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:3152bfe8bf762f","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8"]},{"ai_run_id":"airun_20261006072724_56597dc6","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取本项目临床试验保险方案（含险种、保额、承保范围、理赔程序）及受试者伤害赔偿条款","category":"source_missing","gap_id":"gap_11_5_01","missing_source_classes":["项目级临床试验保险方案","受试者伤害赔偿条款与程序"],"target":"保险与赔偿章节全部正文"}],"heading":"保险与赔偿","missing_source_classes":["项目级临床试验保险方案","受试者伤害赔偿条款与程序","申办方与研究中心责任划分协议"],"proposal_text":"","rationale":"保险与赔偿章节需要项目级保险方案（险种、保额、承保范围、理赔程序）及赔偿条款（赔偿范围、责任划分、争议解决机制）作为撰写依据。当前允许来源中无任何项目级保险或赔偿文件，公司语料中亦无相关条款可作结构参照。在缺少上述来源的情况下，无法撰写有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_90faa124c2ad_d30dc04545310e34","section_number":"11.5","source_ids":["protocol_full_draft_selection:1c7062eabbdbd0504998f21f","current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:3152bfe8bf762f","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8"]},{"ai_run_id":"airun_20261006072724_56597dc6","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:参考文献：|block:48|chunk:1","quote":"国家药品监督管理局药品审评中心. 药物临床试验数据管理与统计分析计划指导原则. 2021年.","quote_sha256":"9a9f3dc0d904c2d48a939e7baaaaf39c4e89deb4067ed241f98001500d36bd56","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:3152bfe8bf762f","span_id":"es_004"},{"locator":"document:mwdoc_greenfield_proj_user_90faa124c2ad_246db92c9af41aa3:full-draft:1c7062eabbdbd0504998f21f","quote":"SECTION_ID=mwsec_greenfield_proj_user_90faa124c2ad_1ffe32331922aaf1\n章节编号=12\n章节标题=研究文件、监查和管理\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"dcb959284f551c679e3bbcc8a9da2dfc7f8b5a2e5b2687c5871991df53d37f99","source_id":"protocol_full_draft_selection:1c7062eabbdbd0504998f21f","span_id":"es_005"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004","es_005"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":0},"gap_items":[{"action":"获取项目级监查计划，明确各阶段监查频率、监查内容清单及监查报告模板","category":"source_missing","gap_id":"gap_12_01","missing_source_classes":["项目级监查计划"],"target":"监查频率、监查内容清单及监查报告模板"},{"action":"确认各中心研究文件保存期限及归档方案，明确电子数据与纸质文件的保存要求","category":"source_missing","gap_id":"gap_12_02","missing_source_classes":["文件保存期限与归档方案"],"target":"研究文件保存期限与归档方案"},{"action":"确认本项目使用的电子数据采集系统类型、验证状态及数据管理流程","category":"source_missing","gap_id":"gap_12_03","missing_source_classes":["电子数据采集系统类型及验证状态","数据管理与统计分析计划"],"target":"电子数据采集系统类型及验证状态"}],"heading":"研究文件、监查和管理","missing_source_classes":["项目级监查计划（含监查频率与监查内容清单）","文件保存期限与归档方案","电子数据采集系统类型及验证状态","数据管理与统计分析计划"],"proposal_text":"本研究的文件管理、监查与质量管理遵循药物临床试验质量管理规范及国家药品监督管理局药品审评中心发布的药物临床试验数据管理与统计分析计划指导原则的相关要求。申办方应建立并维护完整的试验主文件，包括研究方案及其修订、研究者手册、伦理委员会批件、各中心合同与授权文件、监查报告、安全性报告及数据管理文件等。各研究中心应建立研究者文件夹，保存本方案、研究者手册、知情同意书模板及签署件、受试者筛选与入组记录、原始医疗记录、病例报告表、药物发放与回收记录、不良事件记录及监查报告等文件。申办方应安排监查员对各研究中心进行定期监查，核实研究实施是否符合方案要求、数据记录是否准确完整、试验用药品管理是否规范以及受试者权益是否得到保障。监查员在监查过程中发现偏离方案或违背方案的情况，应记录并报告。研究结束后，各中心应按规定保存研究文件，保存期限应满足适用法规及申办方要求。","rationale":"章节结构参照了公司语料中引用的国家药品监督管理局药品审评中心数据管理与统计分析计划指导原则（监管共性结构），以及方案偏离章节中监查员发现偏离的记录与报告流程（监管共性结构）。本章节仅写入监管共性框架性要求，未指定具体监查频率、文件保存年限、电子数据采集系统类型及验证状态等项目实施细节，因上述内容缺少项目级来源支持。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_90faa124c2ad_1ffe32331922aaf1","section_number":"12","source_ids":["protocol_full_draft_selection:1c7062eabbdbd0504998f21f","current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:3152bfe8bf762f","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8"]},{"ai_run_id":"airun_20261006072724_56597dc6","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:12.2 方案偏离|block:950|chunk:1","quote":"研究方案中规定的所有要求，必须严格执行。任何有意或无意偏离或违背研究方案和GCP原则的行为，均视为偏离方案或违背方案。监查员在监查过程中，如果发现偏离或违背方案，应由研究者或监查员填写偏离方案记录，详细记录事件发生的时间及过程、原因及相应的处理措施，由研究者签字，并根据研究中心相关规定通报伦理委员会及申办者。其中，所有可能严重违背方案的情况都必须马上报给申办者。当发生重大方案违背时，应由研究者和申办者进行评估。必要时，申办者可以提前终止本研究。","quote_sha256":"4ad13e82fb4d9748aa0fff1e399c95e53a8a8dd52e482eea1f8ff37b51605465","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8","span_id":"es_006"},{"locator":"document:mwdoc_greenfield_proj_user_90faa124c2ad_246db92c9af41aa3:full-draft:1c7062eabbdbd0504998f21f","quote":"SECTION_ID=mwsec_greenfield_proj_user_90faa124c2ad_4021c4a3d81425eb\n章节编号=12.1\n章节标题=研究方案的依从\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"b0a8e8491fccdb54b02fc76e08dd5eeefc15c6f242d96a2503d0473a7ca0666c","source_id":"protocol_full_draft_selection:1c7062eabbdbd0504998f21f","span_id":"es_007"}],"evidence_review_advisories":[],"evidence_span_ids":["es_006","es_007"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":0},"gap_items":[{"action":"确认方案偏离报告的具体时限要求、伦理委员会通报流程及格式要求","category":"source_missing","gap_id":"gap_12_1_01","missing_source_classes":["项目级方案偏离报告时限与流程","伦理委员会通报具体流程与格式"],"target":"方案偏离报告具体时限及伦理委员会通报流程"},{"action":"确认重大方案违背的评估标准、评估流程及提前终止研究的触发条件","category":"source_missing","gap_id":"gap_12_1_02","missing_source_classes":["重大方案违背评估标准与提前终止触发条件"],"target":"重大方案违背评估标准与提前终止触发条件"}],"heading":"研究方案的依从","missing_source_classes":["项目级方案偏离报告时限与流程","伦理委员会通报具体流程与格式","重大方案违背评估标准与提前终止触发条件"],"proposal_text":"本方案中规定的所有研究要求，各研究中心及研究者必须严格执行。任何有意或无意偏离或违背研究方案及药物临床试验质量管理规范原则的行为，均视为方案偏离或方案违背。监查员在监查过程中发现方案偏离或方案违背时，应由研究者或监查员填写方案偏离记录，详细记录事件发生的时间及过程、原因及相应的处理措施，由研究者签字确认，并根据研究中心相关规定通报伦理委员会及申办方。所有可能严重违背方案的情况必须及时报告申办方。当发生重大方案违背时，应由研究者和申办方共同进行评估。必要时，申办方可以提前终止本研究。各研究中心应确保研究团队在研究启动前完成方案培训，理解并掌握方案中各项研究程序、访视安排、数据采集要求及安全性报告流程，以保证研究实施的一致性和数据质量。","rationale":"方案依从章节的监管共性结构参照了公司语料中方案偏离章节的偏离定义、记录流程、报告路径及重大违背评估机制，仅取监管共性框架，未迁移其具体项目事实。方案培训要求基于多中心研究实施的一般需要。方案偏离报告的具体时限、伦理委员会通报的具体流程与格式、重大方案违背的评估标准及提前终止的触发条件缺少项目级来源支持，需医学经理与质量管理部门确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_90faa124c2ad_4021c4a3d81425eb","section_number":"12.1","source_ids":["protocol_full_draft_selection:1c7062eabbdbd0504998f21f","current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:3152bfe8bf762f","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8"]}],"source_bindings":[{"content_sha256":"e82c71f71a614c1cce93ee8c835a6b26b79ab66628928a7b09f4389d51fbc0c9","locator":"document:mwdoc_greenfield_proj_user_90faa124c2ad_246db92c9af41aa3:full-draft:1c7062eabbdbd0504998f21f","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:1c7062eabbdbd0504998f21f","source_type":"protocol_full_draft_selection","source_version":"full-draft:cef2e5b7988d9864d1b98dfb0bc95e057f2c396180e4f95d9f038e0de4071b58:1c7062eabbdbd0504998f21f","text_sha256":"e82c71f71a614c1cce93ee8c835a6b26b79ab66628928a7b09f4389d51fbc0c9"},{"content_sha256":"01fb60f91790159b3d342d91540f420017aa470272eae36591eeb66d47b33be7","locator":"study_definition:mwdefinition_5108d1569945a1e49dcb:revision:7","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","source_type":"current_project_study_definition","source_version":"mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","text_sha256":"01fb60f91790159b3d342d91540f420017aa470272eae36591eeb66d47b33be7"},{"content_sha256":"8057617d1964e3423a8b531b36e60104d5287e4d9023114f9c3ff9663a282c5f","locator":"section:研究方案|block:3|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","source_type":"com