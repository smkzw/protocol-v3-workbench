{"ai_route":{"actual_response_model":"mtplx-flash-next-optimized-speed","ai_run_id":"airun_20261006065245_1632e028","expected_response_model":"mtplx-flash-next-optimized-speed","fallback_chain_id":"aifb_5c1c8d68e132a34cd30c649c","fallback_depth":0,"fallback_reason":"","model":"mtplx-flash-next-optimized-speed","provider":"mtplx","reasoning_effort":"xhigh","route_base_url":"http://127.0.0.1:8002/v1","route_identity_hash":"c9480819205db8521fec70763515cf905334434da194fa8ae2172b40ab545075","route_profile_id":"independent_ai__mtplx_qwen38_local","thinking":"enabled"},"ai_run_id":"airun_20261006065245_1632e028","chunk_index":7,"job_id":"mwjob_fe65938252069dedfa1cbb78","precondition_digest":"cef2e5b7988d9864d1b98dfb0bc95e057f2c396180e4f95d9f038e0de4071b58","project_id":"proj_user_90faa124c2ad","schema_version":"protocol_full_draft_chunk_v10","section_ids":["mwsec_greenfield_proj_user_90faa124c2ad_e7a7ef06be6e7e9b","mwsec_greenfield_proj_user_90faa124c2ad_11c9092f4361a370","mwsec_greenfield_proj_user_90faa124c2ad_78eee8221dd629ec","mwsec_greenfield_proj_user_90faa124c2ad_51f0e4a6253778a9"],"sections":[{"ai_run_id":"airun_20261006065245_1632e028","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_5108d1569945a1e49dcb:revision:7","quote":"R5A-PX501 20mg或40mg口服每日一次，连续8周（第1周为滴定导入：40mg组由20mg起始），匹配双模拟安慰剂","quote_sha256":"32abfdcad839d52916c367878e5c05323ff834c3895fa838a4fcb899b759140b","source_id":"current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","span_id":"es_001"},{"locator":"study_definition:mwdefinition_5108d1569945a1e49dcb:revision:7","quote":"治疗访视：W2、W4、W8（W2/W4家庭设备单次24h；W0与W8访视前各48h监测）","quote_sha256":"09cd0f0aff2083d915a94a645f50d01e02c71a97d0f830335e76d835b7c4e1e5","source_id":"current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","span_id":"es_002"},{"locator":"study_definition:mwdefinition_5108d1569945a1e49dcb:revision:7","quote":"无论是否中止研究治疗或使用补救镇咳治疗，评价R5A-PX501每日一次口服8周相较安慰剂对第8周24小时咳嗽频率（几何均数）较基线变化率的作用；补救治疗记录为伴发事件并保留于主要分析（mITT）。","quote_sha256":"5678182c91e5d567f4f08e8f434064ae22c65bfd08e361e383918fdaeddfa150","source_id":"current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","span_id":"es_006"}],"evidence_review_advisories":[],"evidence_span_ids":["es_001","es_002","es_006"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"由医学团队确定依从性评估方法（药片计数、电子给药监测或受试者日记）、评估时点、依从性阈值及不依从处理流程","category":"source_missing","gap_id":"gap_adh_method","missing_source_classes":["依从性评估SOP","电子数据采集系统字段规范"],"target":"6.5节依从性评估方法与阈值"},{"action":"确认40mg组第1周滴定导入期是否需单独记录用药依从性","category":"source_missing","gap_id":"gap_adh_titration","missing_source_classes":["依从性评估SOP"],"target":"6.5节滴定期依从性记录"}],"heading":"研究治疗依从性","missing_source_classes":["依从性评估SOP或操作手册","电子数据采集系统中依从性记录字段定义"],"proposal_text":"本研究采用口服每日一次给药方案，R5A-PX501 20mg或40mg连续服用8周，40mg组第1周由20mg起始滴定；安慰剂组服用匹配双模拟片，每日一次。治疗访视安排为第2周、第4周和第8周，其中第2周和第4周由受试者在家完成单次24小时咳嗽监测，第0周和第8周访视前各进行48小时咳嗽监测。受试者须具备使用咳嗽监测设备与电子日记的能力方可入组。主要估计目标策略明确，无论受试者是否中止研究治疗或使用补救镇咳治疗，均纳入主要分析集，补救治疗作为伴发事件记录。依从性评估的具体方法、评估时点、依从性阈值定义及不依从处理流程尚未在本项目文件中确定，需由医学团队根据口服固体制剂特点和双盲双模拟设计进一步制定。","rationale":"已确认事实支持：口服QD 8周给药方案、双模拟设计、W2/W4/W8治疗访视、W0与W8前48h监测、电子日记能力要求、估计目标中补救治疗作为伴发事件。待医学经理确认：依从性评估方法（药片计数或电子监测）、评估频率与阈值、不依从后果、滴定期是否单独记录。","review_advisories":["本节提及高影响设计信息（估计目标、伴发事件）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_90faa124c2ad_e7a7ef06be6e7e9b","section_number":"6.5","source_ids":["protocol_full_draft_selection:a1208d94d5dc97844ad5acf7","current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","company_corpus:cms_cn_protocol_corpus_20260715_v1:176c87031ef7e6","company_corpus:cms_cn_protocol_corpus_20260715_v1:69f36952e02ae0","company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","company_corpus:cms_cn_protocol_corpus_20260715_v1:06652cfb5d7add","company_corpus:cms_cn_protocol_corpus_20260715_v1:79890fa298bcdd"]},{"ai_run_id":"airun_20261006065245_1632e028","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:既往/合并治疗和洗脱期|block:498|chunk:1","quote":"参与者在研究期间，除方案禁止的合并用药外，","quote_sha256":"33fbc172e10d057b657a11a8a1411951d79db71a62e6f67b3724a6813a7b19d3","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:69f36952e02ae0","span_id":"es_003"},{"locator":"study_definition:mwdefinition_5108d1569945a1e49dcb:revision:7","quote":"无论是否中止研究治疗或使用补救镇咳治疗，评价R5A-PX501每日一次口服8周相较安慰剂对第8周24小时咳嗽频率（几何均数）较基线变化率的作用；补救治疗记录为伴发事件并保留于主要分析（mITT）。","quote_sha256":"5678182c91e5d567f4f08e8f434064ae22c65bfd08e361e383918fdaeddfa150","source_id":"current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","span_id":"es_006"},{"locator":"study_definition:mwdefinition_5108d1569945a1e49dcb:revision:7","quote":"筛选前8周内咳嗽治疗方案稳定且研究期间不新增镇咳治疗","quote_sha256":"ca8b1f7bf8834228611122de863b554bd21ca639e43f33f84c8f0f3f6580afa9","source_id":"current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","span_id":"es_007"}],"evidence_review_advisories":[],"evidence_span_ids":["es_003","es_006","es_007"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":2},"gap_items":[{"action":"确定合并用药CRF字段、采集时点、报告时限及与AE的关联判定流程","category":"source_missing","gap_id":"gap_concom_crf","missing_source_classes":["数据采集规范","安全性报告SOP"],"target":"6.6节合并用药采集与报告规则"}],"heading":"合并用药/治疗","missing_source_classes":["合并用药CRF采集规范","合并用药与AE关联判定SOP"],"proposal_text":"本研究合并用药/治疗章节涵盖允许与禁止的合并用药及治疗两个子节。受试者在研究期间除方案明确禁止的合并用药或治疗外，其余合并用药及治疗的使用由研究者根据受试者疾病情况决定。筛选前8周内咳嗽治疗方案须保持稳定，研究期间不新增镇咳治疗。主要估计目标策略规定，无论受试者是否使用补救镇咳治疗，均保留于主要分析集，补救治疗记录为伴发事件。合并用药的采集、记录与报告方式，以及合并用药与不良事件之间的关联判定规则，需依据本项目数据采集规范另行确定。","rationale":"已确认事实支持：入选标准要求筛选前8周咳嗽治疗方案稳定且研究期间不新增镇咳治疗；估计目标策略将补救镇咳治疗定义为伴发事件并保留于mITT分析。公司语料中合并用药章节的框架结构（允许/禁止二分法）仅作为章节组织参照，不迁移其具体药物清单或适应症特异规则。待医学经理确认：合并用药CRF采集字段、报告时限、与AE关联判定流程。","review_advisories":["本节提及高影响设计信息（估计目标、伴发事件）；系统未把重复提及升级为强制确认。","本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_90faa124c2ad_11c9092f4361a370","section_number":"6.6","source_ids":["protocol_full_draft_selection:a1208d94d5dc97844ad5acf7","current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","company_corpus:cms_cn_protocol_corpus_20260715_v1:176c87031ef7e6","company_corpus:cms_cn_protocol_corpus_20260715_v1:69f36952e02ae0","company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","company_corpus:cms_cn_protocol_corpus_20260715_v1:06652cfb5d7add","company_corpus:cms_cn_protocol_corpus_20260715_v1:79890fa298bcdd"]},{"ai_run_id":"airun_20261006065245_1632e028","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:既往/合并治疗和洗脱期|block:636|chunk:1","quote":"在随机前，用于其他疾病的合并用药及治疗，如非 3.6.5.3 规定的禁止的合并用药 或治疗，且研究者认为剂量稳定，可以在研究期间继续使用。研究者可根据受试者疾 病情况决定是否停用或加用/换用治疗药物。如加用/换用治疗药物，需注意记录既往病 史变化情况，是否需要记录 AE。","quote_sha256":"59f7e091aaa0fc7fbe0776c27b50433be0c3a716c7cd2d1dab87d5c3ce126cf4","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","span_id":"es_004"},{"locator":"study_definition:mwdefinition_5108d1569945a1e49dcb:revision:7","quote":"筛选前8周内咳嗽治疗方案稳定且研究期间不新增镇咳治疗","quote_sha256":"ca8b1f7bf8834228611122de863b554bd21ca639e43f33f84c8f0f3f6580afa9","source_id":"current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","span_id":"es_007"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004","es_007"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":1},"gap_items":[{"action":"依据R5A-PX501非临床及临床药理学资料确定允许合并用药类别及相互作用禁忌","category":"source_missing","gap_id":"gap_allowed_list","missing_source_classes":["IB或研究者手册","药物相互作用研究数据"],"target":"6.6.1节允许合并用药具体清单"}],"heading":"允许的合并用药/治疗","missing_source_classes":["R5A-PX501非临床药理学资料","药物相互作用研究数据","允许合并用药类别清单"],"proposal_text":"在随机化前已用于其他疾病治疗的合并用药及治疗，若不属于本方案禁止的合并用药或治疗范畴，且研究者判断其剂量处于稳定状态，受试者可在研究期间继续使用。研究者有权根据受试者合并疾病的临床需要决定是否停用、加用或换用治疗药物。受试者筛选前8周内咳嗽治疗方案须保持稳定，研究期间不得新增镇咳治疗。若受试者因合并疾病需要加用或换用治疗药物，研究者应记录既往病史变化情况，并评估是否需要将该事件记录为不良事件。允许的合并用药具体类别清单及与试验药物存在药代动力学或药效学相互作用的药物清单，需依据R5A-PX501非临床及临床药理学资料另行确定。","rationale":"已确认事实支持：入选标准要求筛选前8周咳嗽治疗方案稳定且研究期间不新增镇咳治疗。公司语料中'剂量稳定可继续使用'及'研究者根据疾病情况决定停用或加用/换用'的表述仅作为章节结构参照（来源为AD适应症方案，不可迁移具体药物清单）。待医学经理确认：允许合并用药具体类别、与R5A-PX501存在相互作用的药物清单、加用/换用药物时AE判定标准。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_90faa124c2ad_78eee8221dd629ec","section_number":"6.6.1","source_ids":["protocol_full_draft_selection:a1208d94d5dc97844ad5acf7","current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","company_corpus:cms_cn_protocol_corpus_20260715_v1:176c87031ef7e6","company_corpus:cms_cn_protocol_corpus_20260715_v1:69f36952e02ae0","company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","company_corpus:cms_cn_protocol_corpus_20260715_v1:06652cfb5d7add","company_corpus:cms_cn_protocol_corpus_20260715_v1:79890fa298bcdd"]},{"ai_run_id":"airun_20261006065245_1632e028","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:禁止的合并用药/治疗|block:506|chunk:1","quote":"接受了禁止的合并用药/治疗的参与者可能中断试验用药品治疗或退出研究，此时，应鼓励参与者继续参与研究的随访，以尽可能获得更多的数据。","quote_sha256":"fb6f127ecebe3d5e94422651907ad9690ff2d8a73be5a2c52bd06a8f93f1697b","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:79890fa298bcdd","span_id":"es_005"},{"locator":"study_definition:mwdefinition_5108d1569945a1e49dcb:revision:7","quote":"筛选前8周内咳嗽治疗方案稳定且研究期间不新增镇咳治疗","quote_sha256":"ca8b1f7bf8834228611122de863b554bd21ca639e43f33f84c8f0f3f6580afa9","source_id":"current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","span_id":"es_007"},{"locator":"section:既往/合并治疗和洗脱期|block:508|chunk:1","quote":"表4. 禁止的合并用药/治疗","quote_sha256":"931153b8de1b39f6a2246e17831cc8b764072a169e26d6612df453bdc9188641","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:176c87031ef7e6","span_id":"es_008"}],"evidence_review_advisories":[],"evidence_span_ids":["es_005","es_007","es_008"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":1},"gap_items":[{"action":"依据R5A-PX501 IB及药物相互作用数据确定禁止合并用药具体药物及治疗类别","category":"source_missing","gap_id":"gap_prohibited_list","missing_source_classes":["IB或研究者手册","药物相互作用研究数据"],"target":"6.6.2节禁止合并用药完整清单"},{"action":"确定接受禁止合并用药后的治疗中断判定标准、退出流程及随访安排","category":"source_missing","gap_id":"gap_prohibited_handling","missing_source_classes":["安全性管理计划","方案违规处理SOP"],"target":"6.6.2节违规处理流程"}],"heading":"禁止的合并用药/治疗","missing_source_classes":["R5A-PX501研究者手册","药物相互作用数据","安全性管理计划","禁止合并用药具体清单"],"proposal_text":"本方案禁止的合并用药或治疗包括：研究期间新增的镇咳治疗（入选标准要求研究期间不新增镇咳治疗）；可能干扰咳嗽频率客观监测或咳嗽严重度评估的其他干预措施；与R5A-PX501存在已知药代动力学或药效学相互作用的药物（具体清单待依据非临床及临床药理学资料确定）。受试者若接受了禁止的合并用药或治疗，研究者应评估是否需要中断试验用药品治疗或使受试者退出研究；若受试者退出，应鼓励其继续参与安全性随访以尽可能获取更多数据。禁止合并用药的完整清单、判定标准及违规处理流程需依据R5A-PX501研究者手册及本项目安全性管理计划另行确定。","rationale":"已确认事实支持：入选标准明确'研究期间不新增镇咳治疗'；估计目标策略将补救镇咳治疗作为伴发事件处理，暗示其不属于常规允许用药。公司语料中'接受禁止合并用药可能中断治疗或退出研究'的表述仅作为章节结构参照（来源为I期方案，不可迁移具体药物清单）。待医学经理确认：禁止合并用药完整清单、与试验药物相互作用的药物、违规处理流程、补救镇咳治疗与禁止用药的边界。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_90faa124c2ad_51f0e4a6253778a9","section_number":"6.6.2","source_ids":["protocol_full_draft_selection:a1208d94d5dc97844ad5acf7","current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","company_corpus:cms_cn_protocol_corpus_20260715_v1:176c87031ef7e6","company_corpus:cms_cn_protocol_corpus_20260715_v1:69f36952e02ae0","company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","company_corpus:cms_cn_protocol_corpus_20260715_v1:06652cfb5d7add","company_corpus:cms_cn_protocol_corpus_20260715_v1:79890fa298bcdd"]}],"source_bindings":[{"content_sha256":"eb95f98dc0a3db863a96b1d470f10230f18d9bfb9bdbf21939eaf17437d163