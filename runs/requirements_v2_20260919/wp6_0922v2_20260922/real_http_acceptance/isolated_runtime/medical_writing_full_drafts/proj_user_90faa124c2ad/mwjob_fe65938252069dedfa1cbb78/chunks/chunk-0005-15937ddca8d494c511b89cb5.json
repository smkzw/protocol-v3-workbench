ab73bbf5f4d6ddddb19a","source_id":"current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","span_id":"es_study_period"}],"evidence_review_advisories":[],"evidence_span_ids":["es_treatment_intervention","es_dose_regimen","es_randomization","es_study_design","es_study_period"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"由医学经理确认剂量修改规则或提供对应项目文件","category":"source_missing","gap_id":"gap_6_dose_modification","missing_source_classes":["剂量调整SOP","安全性事件处理流程"],"target":"研究治疗期间剂量调整、暂停、恢复及永久停药的具体触发条件与操作流程"},{"action":"由医学经理确认补救治疗方案","category":"source_missing","gap_id":"gap_6_rescue_therapy","missing_source_classes":["合并用药与补救治疗方案"],"target":"补救镇咳治疗的具体药物种类、使用条件、记录方式及其对主要分析的影响"},{"action":"由医学经理与统计团队确认盲法操作细则","category":"source_missing","gap_id":"gap_6_blinding_ops","missing_source_classes":["盲法操作SOP","紧急揭盲流程"],"target":"双盲维持操作、紧急揭盲流程及盲态评估"}],"heading":"研究治疗/干预","missing_source_classes":["剂量调整与暂停/恢复/永久停药规则","补救镇咳治疗具体方案","双盲维持与紧急揭盲操作细则"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂对照、三臂平行剂量探索Ⅱ期设计，采用1:1:1随机分配，分层因素为研究中心与基线24小时咳嗽频率（<25次/小时与≥25次/小时）。受试者按上述比例随机分配至以下三个治疗组：安慰剂组接受匹配双模拟安慰剂片每日一次口服；R5A-PX501 20mg组接受R5A-PX501 20mg每日一次口服；R5A-PX501 40mg组接受R5A-PX501 40mg每日一次口服，其中第1周以20mg起始进行滴定导入，第2周起增至40mg。双盲治疗期共8周，末次给药后进入2周安全性随访。所有受试者在基线访视（W0）时由研究者发放24小时咳嗽监测设备，W2与W4访视采用家庭单次24小时监测，W0与W8访视前各完成48小时监测。主要估计目标采用治疗策略，无论受试者是否中止研究治疗或使用补救镇咳治疗，均纳入主要分析集；补救镇咳治疗记录为伴发事件并保留于主要分析。","rationale":"三臂设计、1:1:1随机、分层因素、8周治疗期、40mg组第1周滴定导入、双模拟安慰剂、咳嗽监测设备发放与监测时点、主要估计目标策略均来源于当前项目已确认研究事实。剂量调整/暂停/恢复/永久停药规则、补救镇咳治疗具体种类与记录方式、双盲维持操作细节尚未在来源中明确，需医学经理补充确认。","review_advisories":["本节提及高影响设计信息（估计目标、伴发事件）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_90faa124c2ad_1cbe0ceb71968d9d","section_number":"6","source_ids":["protocol_full_draft_selection:15937ddca8d494c511b89cb5","current_project_study_definition:mwdefinition_5108d1569945a1e49dcb:r7:2b441af20540240c","company_corpus:cms_cn_