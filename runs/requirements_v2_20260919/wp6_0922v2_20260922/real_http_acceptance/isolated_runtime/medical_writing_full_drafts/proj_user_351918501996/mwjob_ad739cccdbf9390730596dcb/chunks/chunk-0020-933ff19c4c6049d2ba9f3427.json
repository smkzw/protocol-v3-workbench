3ff19c4c6049d2ba9f3427","current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","company_corpus:cms_cn_protocol_corpus_20260715_v1:61ad03eb09ac37","company_corpus:cms_cn_protocol_corpus_20260715_v1:09a09b0f63b5f3"]},{"ai_run_id":"airun_20261011090133_e443cc23","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:9.1 研究监查|block:1175|chunk:1","quote":"申办者有道德上、法律上和科学上的义务，确保研究按照已确立的研究准则、GCP 指导原则、适用的管理要求和法规进行。作为履行这些义务的协调措施，在研究中，申办者的监查员或其代表需经常电话和书面与研究中心沟通，并定期拜访研究中心进行现场监查，评价其是否遵守监管要求，确保受试者的安全、福利以及隐私受到 保护、方案依从性、CRF 录入的完整性和准确性、CRF 数据和原始文件的验证及 AE 的发生等。研究者必须向监查员提供访问所有原始资料和研究文件的权限。","quote_sha256":"308a36177f06e789510202b2b938b2a9e5084c7e222d80919f28732387e33a3e","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","span_id":"es_002"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":0},"gap_items":[{"action":"获取本项目研究文件清单、文件保存期限及电子数据管理系统说明后补充具体文件类别与管理要求","category":"source_missing","gap_id":"gap_sec12_001","missing_source_classes":["项目研究文件清单与保存期限规定","电子数据管理系统及文件管理SOP"],"target":"12 研究文件、监查和管理"}],"heading":"研究文件、监查和管理","missing_source_classes":["项目研究文件清单与保存期限规定","电子数据管理系统及文件管理SOP","研究管理组织架构与职责分工文件"],"proposal_text":"本章节涵盖MY009212A片用于治疗中重度活动性溃疡性结肠炎IIa期临床研究（方案编号MW-II-F4E76FD0）的研究文件管理、监查安排及研究管理框架。研究文件包括研究方案及其修订版本、研究者手册、知情同意书、病例报告表、监查计划、培训记录、伦理委员会批件及通信记录等。上述文件由申办方统一编制、分发和归档，研究中心须完整保存至研究结束后至少五年或适用法规要求的更长期限。研究管理涵盖方案依从性监督、定期监查访视、数据核查、安全性事件跟踪及研究质量评估等内容，具体实施要求详见本章各子节。","rationale":"父章节框架依据公司语料中研究监查与方案依从章节的通用结构撰写，项目事实（方案编号、药物名称、适应症、分期）来源于当前项目已确认研究事实。研究文件清单、保存期限及具体管理流程需医学经理与法规事务确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_351918501996_f9d1cc58a8319aba","section_number":"12","source_ids":["protocol_full_draft_selection:933ff19c4c6049d2ba9f3427","current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","company_corpus:cms_cn_protocol_corpus_20260715_v1:61ad03eb09ac37","company_corpus:cms_cn_protocol_corpus_20260715_v1:09a09b0f63b5f3"]},{"ai_run_id":"airun_20261011090133_e443cc23","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:研究方案的依从|block:904|chunk:1","quote":"研究方案经伦理委员会通过审查后，研究者应遵守本方案中规定的所有流程和程序，严格执行。任何有意或无意偏离或违反本方案和GCP原则的行为，均归类为方案偏离。临床监查员在监查过程中，如果发现偏离方案时应由研究者或监查员填写方案偏离记录表，详细记录发现的时间、事件发生的时间和过程、原因及相应的处理措施，由研究者签字，并根据要求通报机构审查委员会（IRB）和申办者。","quote_sha256":"8d638c5491bcdd049c3e258ca943b2eda62a398b2acb0fe0e356ed8957f58872","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:09a09b0f63b5f3","span_id":"es_004"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":0},"gap_items":[{"action":"获取本项目方案偏离分类标准（重大与非重大）、通报时限及方案偏离记录表模板后补充具体分类与流程","category":"source_missing","gap_id":"gap_sec121_001","missing_source_classes":["项目方案偏离分类标准与通报时限规定","方案偏离记录表模板"],"target":"12.1 研究方案的依从"}],"heading":"研究方案的依从","missing_source_classes":["项目方案偏离分类标准与通报时限规定","方案偏离记录表模板","本项目特有的方案偏离情形清单"],"proposal_text":"研究方案经伦理委员会审查批准后，研究者应严格遵守本方案中规定的所有流程和程序。任何有意或无意偏离或违反本方案及药物临床试验质量管理规范原则的行为，均归类为方案偏离。方案偏离包括但不限于：未按方案规定的访视窗口完成评估、未按要求进行内镜检查或实验室检测、合并用药超出方案允许范围、给药剂量或频率偏离方案规定、受试者未满足入选标准或满足排除标准而被纳入、知情同意签署程序不完整等。临床监查员在监查过程中发现方案偏离时，应由研究者或监查员填写方案偏离记录表，详细记录发现时间、事件发生的时间和过程、原因及相应的处理措施，由研究者签字确认，并根据严重程度和适用法规要求通报伦理委员会和申办方。研究者应配合监查员对方案偏离进行调查和纠正，确保类似偏离不再发生。","rationale":"方案偏离定义、记录表填写流程及通报路径依据公司语料中研究方案依从章节撰写。方案偏离的具体分类标准（重大与非重大）、通报时限及本项目特有的偏离情形需医学经理与法规事务确认。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_351918501996_4d5e0130d8754fa2","section_number":"12.1","source_ids":["protocol_full_draft_selection:933ff19c4c6049d2ba9f3427","current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","company_corpus:cms_cn_protocol_corpus_20260715_v1:61ad03eb09ac37","company_corpus:cms_cn_protocol_corpus_20260715_v1:09a09b0f63b5f3"]},{"ai_run_id":"airun_20261011090133_e443cc23","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:监查|block:909|chunk:1","quote":"研究者应允许申办者审阅所有eCRF及对应的源数据。监查访视是申办者评价研究进程、验证eCRF填写的准确性和完成程度的方法，目的在于确保本研究方案的所有要求、适用的管理法规和研究者义务都达到并完成，并解决研究记录中任何不一致情况。","quote_sha256":"ec447264b0c80e56c4b3b7484b8bcc6f92f59e0dee54391f0309abf2b3708232","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:61ad03eb09ac37","span_id":"es_005"}],"evidence_review_advisories":[],"evidence_span_ids":["es_005"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":0},"gap_items":[{"action":"获取本项目监查计划（含监查频率、首次监查时间点、远程与现场监查比例）及监查报告模板后补充具体实施安排","category":"source_missing","gap_id":"gap_sec122_001","missing_source_classes":["项目监查计划","监查报告模板与核查清单"],"target":"12.2 监查"}],"heading":"监查","missing_source_classes":["项目监查计划（含频率、首次监查时间、远程与现场比例）","监查报告模板与核查清单","电子数据管理系统访问权限管理方案"],"proposal_text":"申办者有道德上、法律上和科学上的义务，确保本研究按照已确立的研究准则、药物临床试验质量管理规范指导原则及适用的管理要求和法规进行。作为履行上述义务的协调措施，申办者的监查员或其代表需经常通过电话和书面方式与研究中心沟通，并定期拜访研究中心进行现场监查，评价研究中心是否遵守监管要求，确保受试者的安全、福利及隐私受到保护，核查方案依从性、电子病例报告表录入的完整性和准确性、电子病例报告表数据与原始文件的验证以及不良事件的发生与报告情况。研究者应允许申办者审阅所有电子病例报告表及对应的源数据。监查访视是申办者评价研究进程、验证电子病例报告表填写的准确性和完成程度的方法，目的在于确保本研究方案的所有要求、适用的管理法规和研究者义务都达到并完成，并解决研究记录中任何不一致情况。研究者必须向监查员提供访问所有原始资料和研究文件的权限。","rationale":"监查目的、监查员职责、现场监查与远程沟通方式、数据核查范围及研究者配合义务依据公司语料中研究监查章节撰写。本项目监查频率、首次监查时间点、远程与现场监查比例、监查报告模板及具体核查清单需医学经理与临床运营确认。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_351918501996_90716cf43cbd7545","section_number":"12.2","source_ids":["protocol_full_draft_selection:933ff19c4c6049d2ba9f3427","current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","company_corpus:cms_cn_protocol_corpus_20260715_v1:61ad03eb09ac37","company_corpus:cms_cn_protocol_corpus_20260715_v1:09a09b0f63b5f3"]}],"source_bindings":[{"content_sha256":"2400e9e75925aa80ada1fb477c348100da9f47261635ea40e5738f25bf1f986d","locator":"document:mwdoc_greenfield_proj_user_351918501996_6b224e2586cb9503:full-draft:933ff19c4c6049d2ba9f3427","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:933ff19c4c6049d2ba9f3427","source_type":"protocol_full_draft_selection","source_version":"full-draft:e3af53daf94dd8c7f3e409c1659af13d9ea9cec9aaafbd18fa6bd210768cdbd7:933ff19c4c6049d2ba9f3427","text_sha256":"2400e9e75925aa80ada1fb477c348100da9f47261635ea40e5738f25bf1f986d"},{"content_sha256":"b678adc9931cc7400f8263c27f51552f7da888d4e3a924b0b56446a47657e701","locator":"study_definition:mwdefinition_886cef95b6743095fb69:revision:5","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","source_type":"current_project_study_definition","source_version":"mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","text_sha256":"b678adc9931cc7400f8263c27f51552f7da888d4e3a924b0b56446a47657e701"},{"content_sha256":"dfc9fceb41db9d941df0e3715483adaa069da4f1953600a6a37a56d7f81373dd","locator":"section:文档开头|block:4|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_2