事实。AE/SAE/SUSAR具体采集报告规则、各安全性评估的具体访视时点及参数尚未在允许来源中明确，需医学经理结合项目安全性管理文件及研究者手册确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_351918501996_b6401917220a515e","section_number":"7.3","source_ids":["protocol_full_draft_selection:aa2875b248aeb299ff093cc5","current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21"]},{"ai_run_id":"airun_20261011082540_283a34c3","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"需方案访视流程表或安全性评估计划明确生命体征参数与测量规范","category":"source_missing","gap_id":"gap_731_vitals_params","missing_source_classes":["访视流程表","安全性评估计划"],"target":"7.3.1节生命体征具体参数（血压、心率、体温、呼吸频率等）及测量方法"},{"action":"需方案安全性评估章节明确体格检查项目与实施时点","category":"source_missing","gap_id":"gap_731_physical_exam","missing_source_classes":["安全性评估计划","访视流程表"],"target":"7.3.1节体格检查范围、频率及异常处理"}],"heading":"生命体征和体格检查","missing_source_classes":["生命体征具体参数与测量方法","体格检查范围与频率","各访视安全性评估实施明细"],"proposal_text":"","rationale":"当前项目已确认研究事实将","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_351918501996_04c1f5113897441c","section_number":"7.3.1","source_ids":["protocol_full_draft_selection:aa2875b248aeb299ff093cc5","current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21"]},{"ai_run_id":"airun_20261011082540_283a34c3","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"需方案访视流程表明确ECG采集的访视归属","category":"source_missing","gap_id":"gap_732_ecg_timing","missing_source_classes":["访视流程表","安全性评估计划"],"target":"7.3.2节12导联ECG采集时点（基线、治疗中、随访）"},{"action":"需方案安全性评估章节或研究者手册提供ECG异常判定标准","category":"source_missing","gap_id":"gap_732_e