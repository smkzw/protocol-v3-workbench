096e242bbd65d0c9236718d79e77a388e84cb9640b99bd47662a6ce8faab31","source_id":"current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","span_id":"es_pd_poc"},{"locator":"study_definition:mwdefinition_886cef95b6743095fb69:revision:5","quote":"多中心、随机、双盲、安慰剂平行对照；固定剂量平行组（160mg BID / 80mg BID / 安慰剂，3:3:3），不采用受试者内剂量递增。","quote_sha256":"1410780da624369bf08f2419a79a4315f6386100e28df4b248b6eac6cdeec573","source_id":"current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","span_id":"es_study_design"},{"locator":"study_definition:mwdefinition_886cef95b6743095fb69:revision:5","quote":"TEAE/SAE发生率及严重程度（CTCAE 5.0）\\n生命体征、12导联ECG、实验室检查较基线变化\\n妊娠检测（育龄女性）","quote_sha256":"a3cc1790bf43fe7affe6d09deaf95f917b3805a07058a0c2d4cb822f5d5f92e4","source_id":"current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","span_id":"es_safety_endpoints"},{"locator":"study_definition:mwdefinition_886cef95b6743095fb69:revision:5","quote":"分析集FAS/PPS/SS；SAP另行制定","quote_sha256":"40ebcdafcedecfd59ec5e861bff0365d566ec683a1ad7aba25b22701ac73f9d3","source_id":"current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","span_id":"es_analysis_sets"},{"locator":"study_definition:mwdefinition_886cef95b6743095fb69:revision:5","quote":"治疗策略估计目标（treatment policy），FAS；补救治疗按治疗策略纳入；细节见SAP。","quote_sha256":"38d0b491c9a4084197e71b30c6315cb83bb540538b9734cb27326a2d23d6bef2","source_id":"current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","span_id":"es_estimation_target"}],"evidence_review_advisories":[],"evidence_span_ids":["es_pd_stat","es_sap_timing","es_pd_poc","es_study_design","es_safety_endpoints","es_analysis_sets","es_estimation_target"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":6},"gap_items":[{"action":"补充研究药物IB中非临床PD数据及既往临床PD观察，确认本项目拟采集的PD生物标志物清单、采集时点与分析终点定义","category":"source_missing","gap_id":"gap_pd_markers","missing_source_classes":["研究药物IB","项目级PD采集方案"],"target":"PD数据分析章节-具体PD终点与生物标志物"},{"action":"由医学经理与统计团队确认PD分析是否采用群体PK/PD建模、暴露-效应分析或仅描述性统计，并在SAP中落实","category":"decision_pending","gap_id":"gap_pd_method","missing_source_classes":[],"target":"PD数据分析章节-统计方法"}],"heading":"PD数据分析","missing_source_classes":["研究药物IB（含非临床PD数据与既往临床PD观察）","项目级PD生物标志物清单及采集方案","SAP草案（含PD分析具体方法）"],"proposal_text":"本研究为MY009212A片（VNN1抑制剂）治疗中重度活动性溃疡性结肠炎的IIa期概念验证与剂量探索研究，药代动力学/药效学分析旨在描述MY009212A片在160mg BID、80mg BID及安慰剂三个平行组中的暴露特征及其与疗效、安全性指标之间的初步关联，为后续IIb/III期剂量选择提供依据。PD参数的分析采用描述性统计与图形化方法，按治疗组、剂量组及访视时间点汇总呈现；具体PD生物标志物的选择、采集时点、分析终点定义及统计方法将在统计分析计划中详细规定，该计划于数据库锁定前最终确定。PD分析纳入全分析集与安全性分析集；符合方案集用于敏感性分析，其成员判定标准为：无重大方案偏离且完成第12周主要疗效评估（含中心读片内镜）的受试者入集，存在重大方案偏离（包括但不限于依从性低于80%或高于120%、未按方案完成关键访视、使用禁限合并用药等）者排除。PD分析中涉及的安全性数据（TEAE/SAE按CTCAE 5.0分级、生命体征、12导联心电图、实验室检查较基线变化）在安全性分析集中按组描述汇总。本研究不设置期中分析，不采用自适应设计，PD分析结果仅用于概念验证与剂量探索目的，不作为注册性确证性证据。","rationale":"已确认事实支持：研究目的为PoC与剂量探索；PK/PD参数采用描述性统计绘图；分析集为FAS/PPS/SS；SAP另行制定；安全性终点含TEAE/SAE（CTCAE 5.0）、生命体征、12导联ECG、实验室检查。公司语料中SAP在数据库锁定前最终确定的表述为监管共性结构参照。待医学经理确认：具体PD生物标志物清单及采集时点、是否采用群体PK/PD建模或暴露-效应分析、PD分析中是否区分初治与经治亚组、PPS中重大方案偏离的具体判定阈值。","review_advisories":["本节提及高影响设计信息（剂量选择、期中分析）；系统未把重复提及升级为强制确认。","本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_351918501996_25b2160fd0194ec6","section_number":"9.7","source_ids":["protocol_full_draft_selection:f87f4b587cb4f7bce621515f","current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","company_corpus:cms_cn_protocol_corpus_20260715_v1:7450f8d809500d","company_corpus:cms_cn_protocol_corpus_20260715_v1:3f194f5112122b","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:c4c8ac382dcd25"]},{"ai_run_id":"airun_20261011085121_68e681d0","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"ev