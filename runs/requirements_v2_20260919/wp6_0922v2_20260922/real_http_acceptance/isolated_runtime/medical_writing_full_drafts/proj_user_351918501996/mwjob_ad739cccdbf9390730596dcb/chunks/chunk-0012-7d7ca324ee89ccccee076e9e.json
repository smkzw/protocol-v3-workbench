ect_fact_spans":2},"gap_items":[{"action":"需结合IB中非临床生殖毒性数据及监管要求确定妊娠检测的访视安排和检测方法","category":"source_missing","gap_id":"gap_734_01","missing_source_classes":["研究者手册（IB）","非临床生殖毒性研究资料"],"target":"妊娠检查具体访视时点与检测类型"},{"action":"需依据IB中生殖毒性数据确定育龄女性受试者避孕方法类型及使用期限","category":"source_missing","gap_id":"gap_734_02","missing_source_classes":["研究者手册（IB）","非临床生殖毒性研究资料"],"target":"避孕方法要求"},{"action":"需确定妊娠事件发现后的报告对象、时限、随访终点及新生儿随访安排","category":"source_missing","gap_id":"gap_734_03","missing_source_classes":["妊娠管理SOP","安全性报告SOP"],"target":"妊娠事件报告流程与随访方案"}],"heading":"妊娠检查和避孕问询","missing_source_classes":["研究者手册（IB）","非临床生殖毒性研究资料","妊娠管理SOP"],"proposal_text":"本研究将妊娠检测纳入育龄女性受试者的安全性评估范畴。研究人群为18至75岁成人，其中育龄期女性受试者在双盲治疗期（D1至D84）及安全性随访期（D85至D98）内存在妊娠风险，需对育龄女性进行妊娠状态监测。妊娠检测作为安全性终点之一，与TEAE/SAE发生率及严重程度（CTCAE 5.0）、生命体征、12导联ECG及实验室检查较基线变化共同构成安全性评估体系。","rationale":"允许来源将妊娠检测（育龄女性）列为安全性终点，研究人群为18-75岁成人。但妊娠检查的具体访视时点、检测类型（尿妊娠试验或血清β-hCG）、避孕方法要求、妊娠事件报告流程及随访方案均未在允许来源中给出，需结合MY009212A片非临床生殖毒性数据及监管要求确定。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_351918501996_d4f15247e058aa8e","section_number":"7.3.4","source_ids":["protocol_full_draft_selection:7d7ca324ee89ccccee076e9e","current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21"]},{"ai_run_id":"airun_20261011082909_7d7d9f1a","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_886cef95b6743095fb69:revision:5","quote":"PK/PD参数描述统计绘图；分析集FAS/PPS/SS","quote_sha256":"2195c33db6cc0e71487feede6fdbc952adde140dc69db89ee1cab681dabc0ac1","source_id":"current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","span_id":"es3"},{"locator":"study_definition:mwdefinition_886cef95b6743095fb69:revision:5","quote":"MY009212A片（VNN1抑制剂，40mg/片薄膜衣片）口服","quote_sha256":"2b36faa7c9a29834ff9a5e880d16b01ea206de6d77ca432c2fe5c8031b514359","source_id":"current_project_study_definition:mwdefinition_886cef95