抑制剂，40mg/片薄膜衣片）口服","quote_sha256":"2b36faa7c9a29834ff9a5e880d16b01ea206de6d77ca432c2fe5c8031b514359","source_id":"current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","span_id":"es4"}],"evidence_review_advisories":[],"evidence_span_ids":["es3","es4"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"需结合IB中VNN1靶点机制及非临床药效学数据确定PD生物标志物及PD终点","category":"source_missing","gap_id":"gap_75_01","missing_source_classes":["研究者手册（IB）","非临床药效学研究资料"],"target":"PD生物标志物与PD终点"},{"action":"需确定PD评估的采样时间点及对应访视","category":"source_missing","gap_id":"gap_75_02","missing_source_classes":["研究者手册（IB）","既往人体PD研究资料"],"target":"PD采样时点与采样访视安排"},{"action":"需确定PD生物标志物的检测方法","category":"source_missing","gap_id":"gap_75_03","missing_source_classes":["生物标志物检测方法资料","实验室操作手册"],"target":"PD分析方法"}],"heading":"药效动力学评估","missing_source_classes":["研究者手册（IB）","非临床药效学研究资料","既往人体PD研究资料","生物标志物检测方法资料"],"proposal_text":"本研究在双盲治疗期内对MY009212A片进行药效动力学评估。MY009212A片为VNN1抑制剂，以口服途径发挥全身性（systemic）作用。药效动力学参数采用描述性统计与绘图方式呈现，分析集为全分析集（FAS）、符合方案集（PPS）及安全性分析集（SS）。","rationale":"允许来源确认MY009212A为VNN1抑制剂、全身性暴露、PK/PD参数以描述性统计绘图呈现、分析集为FAS/PPS/SS。但PD具体生物标志物、PD终点、采样时点及分析方法均未在允许来源中给出，需结合IB中VNN1靶点相关非临床药效学数据及既往研究资料确定。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_351918501996_dd704c213830dc37","section_number":"7.5","source_ids":["protocol_full_draft_selection:7d7ca324ee89ccccee076e9e","current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21"]},{"ai_run_id":"airun_20261011082909_7d7d9f1a","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"需结合IB中PK/PD采样需求及中心实验室操作手册确定","category":"source_missing","gap_id":"gap_76_01","missing_source_classes":["研究者手册（IB）","中心实验室操作手册"],"target":"生物样本采集管型、采集体积与处理流程"},{"action":"需依据生物分析方