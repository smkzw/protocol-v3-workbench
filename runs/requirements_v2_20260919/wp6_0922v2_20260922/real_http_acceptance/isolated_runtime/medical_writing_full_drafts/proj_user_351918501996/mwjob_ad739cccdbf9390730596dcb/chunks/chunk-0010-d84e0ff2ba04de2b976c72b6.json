:"MY009212A片：每日两次（BID）、每次一片、约间隔12小时，空腹或餐后均可；药物由申办方统一提供；依从性=实际/计划服药量×100%（80%-120%）","quote_sha256":"06a1a744a9abd5ce0df63dbf6f72b7a2f024f3e4d14ee222d49da825f87ecd70","source_id":"current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","span_id":"es_dosing"}],"evidence_review_advisories":[],"evidence_span_ids":["es_treatment_period","es_visit_strategy","es_dosing"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"补充访视流程图或访视评估项目表，明确每次访视是否包含内镜、实验室检查、ECG、生命体征、依从性评价等","category":"source_missing","gap_id":"gap_712_visit_items","missing_source_classes":["访视流程图","CRF设计文档"],"target":"各访视（W2/W6/W10/W12/W14）具体评估项目清单"},{"action":"确认安全性随访期是否包含内镜复查、实验室检查频次及AE采集截止时点","category":"source_missing","gap_id":"gap_712_safety_followup_detail","missing_source_classes":["安全性评估方案","访视流程图"],"target":"安全性随访期D85-D98评估内容"}],"heading":"治疗期及随访","missing_source_classes":["访视流程图（含各访视评估项目清单）","安全性随访期评估项目明细"],"proposal_text":"本研究双盲治疗期为D1至D84，共12周；安全性随访期为D85至D98，共2周。治疗期内受试者按随机分配接受MY009212A片160mg BID、MY009212A片80mg BID或安慰剂BID，每日两次、每次一片、约间隔12小时，空腹或餐后均可服用，药物由申办方统一提供。依从性以实际服药量与计划服药量之比计算，80%至120%视为依从。访视安排如下：筛选访视（D-28至D-1）、基线/D1访视（含首剂留观2小时）、W2电话访视、W6访视、W10访视、W12终点访视（含结肠镜检查）及W14安全性随访访视；各访视允许窗口为计划日±4天。安全性随访期内继续收集不良事件、合并用药及安全性数据，直至D98完成末次安全性评估。","rationale":"治疗期与随访期时间框架、访视序列及窗口、给药方案与依从性定义均来源于当前项目已确认研究事实。W2电话访视的具体评估内容、W6/W10访视是否包含内镜或实验室检查、安全性随访期具体评估项目清单未在来源中逐项列出，需医学经理结合访视流程图与CRF设计确认。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_351918501996_fa2791e82cb7fe89","section_number":"7.1.2","source_ids":["protocol_full_draft_selection:d84e0ff2ba04de2b976c72b6","current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21"]},{"ai_run_id":"airun_20261011082349_3717afdc","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"补充项目级计划外访视触发标准（AE相关、疾病恶化、给药错误、受试者主动要求等）","category":"source_missing","gap_id":"gap_713_trigger","missing_source_classes":["计划外访视操作规程","安全性事件管理SOP"],"target":"计划外访视触发条件与分类"},{"action":"明确计划外访视需采集的数据项、是否需内镜/实验室检查、报告对象与时限","category":"source_missing","gap_id":"gap_713_procedure","missing_source_classes":["计划外访视操作规程","CRF设计文档"],"target":"计划外访视评估内容与报告流程"}],"heading":"计划外访视","missing_source_classes":["计划外访视操作规程","安全性事件触发访视流程","方案偏离管理规程"],"proposal_text":"","rationale":"允许来源仅给出计划访视序列与窗口（±4天），未提供计划外访视的触发条件（如AE、疾病恶化、给药错误）、评估内容、报告时限、是否计入方案访视窗口、与安全性随访期的衔接规则等项目实施细节。缺少对应项目文件，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_351918501996_fda1c85aedb41b45","section_number":"7.1.3","source_ids":["protocol_full_draft_selection:d84e0ff2ba04de2b976c72b6","current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21"]},{"ai_run_id":"airun_20261011082349_3717afdc","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"补充项目级治疗终止标准及对应处理流程","category":"source_missing","gap_id":"gap_714_termination_criteria","missing_source_classes":["研究治疗终止标准","AE管理SOP"],"target":"研究治疗终止标准（医学原因、AE、疾病恶化、受试者决定等）"},{"action":"明确退出研究的定义、退出后是否继续安全性随访、数据收集截止时点","category":"source_missing","gap_id":"gap_714_withdrawal","missing_source_classes":["退出研究操作规程","安全性随访终止条件"],"target":"退出研究程序与退出后随访安排"},{"action":"补充失访判定标准、追踪程序、失访后数据处理规则","category":"source_missing","gap_id":"gap_714_lost_to_followup","missing_source_classes":["失访管理规程"],"target":"失访定义与处理"}],"heading":"研究治疗终止、退出研究及失访处理","missing_source_classes":["研究治疗终止标准","退出研究操作规程","失访管理规程","安全性随访终止条件"],"proposal_text":"","rationale":"允许来源提及治疗策略估计目标下补救治疗按治疗策略纳入FAS，但未给出研究治疗终止的具体标准（如疾病恶化、AE导致停药、受试者主动退出）、退出研究程序、失访定义与处理流程、退出后安全性随访安排等项目实施规则。缺少对应项目文件，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_351918501996_069f29e276432199","section_number":"7.1.4","source_ids":["protocol_full_draft_selection:d84e0ff2ba04de2b976c72b6","current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21"]},{"ai_run_id":"airun_20261011082349_3717afdc","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_886cef95b6743095fb69:revision:5","quote":"第12周临床缓解率（改良Mayo较基线下降≥2分且绝对值≤2分，直肠出血子评分0-1分、内镜子评分0-1分）；评价时间W12中心读片内镜","quote_sha256":"f2f99e8fb2532a528e5947bc2fb5f6a0b9ec21c40efbc34d9ad7b3209403d538","source_id":"current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","span_id":"es_primary_endpoint"},{"locator":"study_definition:mwdefinition_886cef95b6743095fb69:revision:5","quote":"主要终点（W12临床缓解率）：80mg BID、160mg BID分别与安慰剂比较，CMH检验/ logistic回归（双侧α=0.10，探索性）；连续终点ANCOVA/MMRM","quote_sha256":"0bb6ab920a6edc35884d660308a5b4adca3fe43f17b332de7539c69a3b8d2e2a","source_id":"current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","span_id":"es_stat_method"},{"locator":"study_definition:mwdefinition_886cef95b6743095fb69:revision:5","quote":"分析集FAS/PPS/SS；SAP另行制定","quote_sha256":"40ebcdafcedecfd59ec5e861bff0365d566ec683a1ad7aba25b22701ac73f9d3","source_id":"current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","span_id":"es_analysis_sets"},{"locator":"study_definition:mwdefinition_886cef95b6743095fb69:revision:5","quote":"治疗策略估计目标（treatment policy），FAS；补救治疗按治疗策略纳入；细节见SAP","quote_sha256":"b0e5d0907a3163ffc7a5aa5d3f2675cf1c4336dd577e89db5845afeab9337704","source_id":"current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","span_id":"es_treatment_policy"}],"evidence_review_advisories":[],"evidence_span_ids":["es_primary_endpoint","es_stat_method","es_analysis_sets","es_treatment_policy"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"补充项目级方案偏离分类标准，明确哪些偏离构成'重大'从而排除出PPS","category":"source_missing","gap_id":"gap_72_pps_deviation","missing_source_classes":["方案偏离管理规程","SAP"],"target":"PPS中重大方案偏离的界定标准"},{"action":"明确除主要终点外的连续型有效性终点（如改良Mayo总分变化、PRO终点等）及对应分析模型","category":"source_missing","gap_id":"gap_72_continuous_endpoints","missing_source_classes":["SAP","终点定义文档"],"target":"连续型终点清单及ANCOVA/MMRM选择依据"},{"action":"确认内镜操作失败、受试者拒绝或技术不可行时的主要终点替代评估方案","category":"source_missing","gap_id":"gap_72_endoscopy_failure","missing_source_classes":["内镜操作SOP","SAP"],"target":"W12内镜失败或不可行时的替代评估路径"}],"heading":"有效性评估","missing_source_classes":["统计分析计划（SAP）","连续型终点清单及模型选择依据","重大方案偏离界定标准"],"proposal_text":"本研究主要有效性终点为第12周临床缓解率，定义为改良Mayo评分较基线下降≥2分且绝对值≤2分，同时直肠出血子评分为0至1分、内镜子评分为0至1分；评价时点为W12，由中心统一读片确认内镜结果。主要终点分析按160mg BID与安慰剂、80mg BID与安慰剂分别进行组间比较，采用CMH检验或logistic回归，双侧显著性水平α=0.10（探索性）。连续型终点采用ANCOVA或MMRM模型分析。估计目标为治疗策略估计目标（treatment policy），以全分析集（FAS）为主要分析集；补救治疗按治疗策略纳入FAS。安全性分析集（SS）包含至少接受一次研究药物治疗的受试者，用于安全性数据的描述性汇总。符合方案集（PPS）纳入无重大方案偏离且完成W12主要终点评估的受试者，存在重大方案偏离者排除出PPS。统计分析计划另行制定。","rationale":"主要终点定义、评价时点、统计方法、分析集框架及估计目标均来源于当前项目已确认研究事实。PPS成员判定中'重大方案偏离'的具体界定标准、W12内镜失败时的替代评估路径、连续型终点具体清单及对应模型选择依据未在来源中明确，需医学经理与统计师在SAP中落实。","review_advisories":["本节提及高影响设计信息（α、主要终点、估计目标）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_351918501996_7ef94a7745c96a5d","section_number":"7.2","source_ids":["protocol_full_draft_selection:d84e0ff2ba04de2b976c72b6","current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21"]}],"source_bindings":[{"content_sha256":"1030c7cea02caed50ae03ebe696bc906366947034ad7caa1033fe7dde8de1d1c","locator":"document:mwdoc_greenfield_proj_user_351918501996_6b224e2586cb9503:full-draft:d84e0ff2ba04de2b976c72b6","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:d84e0ff2ba04de2b976c72b6","source_type":"protocol_full_draft_selection","source_version":"full-draft:e3af53daf94dd8c7f3e409c1659af13d9ea9cec9aaafbd18fa6bd210768cdbd7:d84e0ff2ba04de2b976c72b6","text_sha256":"1030c7cea02caed50ae03ebe696bc906366947034ad7caa1033fe7dde8de1d1c"},{"content_sha256":"b678adc9931cc7400f8263c27f51552f7da888d4e3a924b0b56446a47657e701","locator":"study_definition:mwdefinition_886cef95b6743095fb69:revision:5","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","source_type":"current_project_study_definition","source_version":"mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","text_sha256":"b678adc9931cc7400f8263c27f51552f7da888d4e3a924b0b56446a47657e701"}]}