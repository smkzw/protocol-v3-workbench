_definition:mwdefinition_886cef95b6743095fb69:revision:5","quote":"W10","quote_sha256":"79951fb8badf38a8f2fcbe077d1da5b6d57bc0298cc1db165704f179ab666cdc","source_id":"current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","span_id":"es91"},{"locator":"study_definition:mwdefinition_886cef95b6743095fb69:revision:5","quote":"W12终点（含内镜）","quote_sha256":"0819b552190e6a682866133ca18922d00cd6fd5622c9825d7ff5c04456528b19","source_id":"current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","span_id":"es92"},{"locator":"study_definition:mwdefinition_886cef95b6743095fb69:revision:5","quote":"W14安全随访","quote_sha256":"926e188e0a03d33552a2d110cb06fee6cb280ebcbfe1a4b1592194c2ef84aaef","source_id":"current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","span_id":"es93"},{"locator":"study_definition:mwdefinition_886cef95b6743095fb69:revision:5","quote":"窗口±4天","quote_sha256":"dce6396f5bd0bab35da1f8a1500b454d0fefb705dac5c943db6a4a7ad7b3b8b2","source_id":"current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","span_id":"es94"},{"locator":"study_definition:mwdefinition_886cef95b6743095fb69:revision:5","quote":"双侧α=0.10，探索性","quote_sha256":"e838c9a104573cce138a70f208a4cc707668ada38709d8055e67127a907a5a5f","source_id":"current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","span_id":"es95"},{"locator":"study_definition:mwdefinition_886cef95b6743095fb69:revision:5","quote":"ANCOVA/MMRM","quote_sha256":"957d5df09cf3b407dd074fe3af43b4abdbee979426e9e52f9d64c0a4bb907ad1","source_id":"current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","span_id":"es96"},{"locator":"study_definition:mwdefinition_886cef95b6743095fb69:revision:5","quote":"PK/PD参数描述统计绘图","quote_sha256":"ac9f924824fa7f6bb5e7ab9dee24b82afc38d68e0232c90212311ede32768d99","source_id":"current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","span_id":"es97"},{"locator":"study_definition:mwdefinition_886cef95b6743095fb69:revision:5","quote":"FAS/PPS/SS","quote_sha256":"90688a8d34ac76929e7f4c8b5c1eabf08d0d956aca8db73415c59f818a767eef","source_id":"current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","span_id":"es98"},{"locator":"study_definition:mwdefinition_886cef95b6743095fb69:revision:5","quote":"补救治疗按治疗策略纳入","quote_sha256":"1f234b8e2cb0a81e8b9da5bf1c8d2758b3a2be2ecdc0c3b63be78dc8ea6e90ad","source_id":"current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","span_id":"es99"},{"locator":"study_definition:mwdefinition_886cef95b6743095fb69:revision:5","quote":"MY009212A片用于治疗中重度活动性溃疡性结肠炎的IIa期临床研究","quote_sha256":"20058c2b66aff8b9713c759a5b2171eb7acb494253257fb733994e1889eb2572","source_id":"current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","span_id":"es100"}],"evidence_review_advisories":[],"evidence_span_ids":["es1","es2","es3","es4","es5","es6","es7","es8","es9","es10","es11","es12","es13","es14","es15","es16","es17","es18","es19","es20","es21","es22","es23","es24","es25","es26","es27","es28","es29","es30","es31","es32","es33","es34","es35","es36","es37","es38","es39","es40","es41","es42","es43","es44","es45","es46","es47","es48","es49","es50","es51","es52","es53","es54","es55","es56","es57","es58","es59","es60","es61","es62","es63","es64","es65","es66","es67","es68","es69","es70","es71","es72","es73","es74","es75","es76","es77","es78","es79","es80","es81","es82","es83","es84","es85","es86","es87","es88","es89","es90","es91","es92","es93","es94","es95","es96","es97","es98","es99","es100"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":100},"gap_items":[],"heading":"方案概要","missing_source_classes":[],"proposal_text":"本研究为MY009212A片用于治疗中重度活动性溃疡性结肠炎的IIa期临床研究，方案编号MW-II-F4E76FD0-DRAFT，开发区域为中国。研究采用多中心、随机、双盲、安慰剂平行对照设计，设三个固定剂量平行组：MY009212A片160mg每日两次（候选RP2D）、MY009212A片80mg每日两次（低剂量探索组）及安慰剂组，按3:3:3比例随机分配，不采用受试者内剂量递增，不设阳性对照。安慰剂组口服与活性药物外观一致的模拟制剂，采用双盲双模拟方式维持盲态。目标研究人群为18至75岁中重度活动性溃疡性结肠炎成人患者（改良Mayo评分5至9分且内镜子评分2至3分），对5-ASA、糖皮质激素或免疫抑制剂等常规治疗应答不佳、失应答或不耐受，以生物制剂与小分子靶向药初治人群为主。研究时期包括筛选期（D-28至D-1，共4周）、双盲治疗期（D1至D84，共12周）及安全性随访期（D85至D98，共2周）。访视安排为筛选、基线/D1（首剂留观2小时）、W2电话访视、W6、W10、W12终点访视（含内镜检查）及W14安全随访访视，各访视窗口为正负4天。主要疗效终点为第12周临床缓解率，定义为改良Mayo评分较基线下降至少2分且绝对值不超过2分、直肠出血子评分0至1分、内镜子评分0至1分，于W12通过中心读片内镜评价。安全性终点包括TEAE及SAE发生率与严重程度（按CTCAE 5.0分级）、生命体征、12导联ECG及实验室检查较基线变化、育龄女性妊娠检测。样本量为每组40例、三组共120例，基于探索性精度考量。主要终点分析采用CMH检验或logistic回归（双侧alpha等于0.10，探索性），连续终点采用ANCOVA或MMRM，安全性按SS集描述汇总，PK/PD参数以描述性统计绘图呈现。分析集包括全分析集（FAS）、符合方案集（PPS）及安全性分析集（SS），估计目标策略为治疗策略估计目标（treatment policy），以FAS为主要分析集，补救治疗按治疗策略纳入。本研究不计划自适应设计、样本量再估计、期中分析、SRC或DMC。统计分析计划另行制定。","rationale":"本章正文依据当前项目已确认研究事实中的总体研究设计、目标人群、研究时期、访视策略、主要与安全性终点、样本量策略、统计分析策略及分析集定义撰写。需医学经理确认的事项包括：安全性评估窗口与TEAE采集起止时点、妊娠检测具体日程与避孕要求、AE/SAE报告对象与时限、PPS中重大方案偏离排除条款的具体定义、各访视实际实施的检查项目清单（不得由访视日推断所有检查均实施）、以及SAP中CMH与logistic回归的最终选择。","review_advisories":["本节复述高影响研究设计（方案概要）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（alpha、主要终点、估计目标、期中分析、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_351918501996_3a823caa8e085c42","section_number":"1","source_ids":["protocol_full_draft_selection:732610562a7337e60c49ac7e","current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:8906e921bf8a9f","company_corpus:cms_cn_protocol_corpus_20260715_v1:be5d06fd3b46ad"]},{"ai_run_id":"airun_20261011074410_3b6662eb","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"检索并纳入溃疡性结肠炎全球及中国流行病学数据（患病率、发病率、疾病负担）的权威文献或指南","category":"source_missing","gap_id":"gap_bg_01","missing_source_classes":["流行病学文献","疾病负担数据"],"target":"研究背景和立项依据-流行病学与疾病负担段落"},{"action":"纳入现行UC诊疗指南推荐及现有治疗（5-ASA、激素、免疫抑制剂、生物制剂、小分子靶向药）的疗效与局限性证据","category":"source_missing","gap_id":"gap_bg_02","missing_source_classes":["诊疗指南","治疗格局综述"],"target":"研究背景和立项依据-现有治疗与指南段落"},{"action":"基于上述证据阐述中重度UC对5-ASA/激素/免疫抑制剂应答不佳人群的未满足需求，引出VNN1抑制剂的立题逻辑","category":"source_missing","gap_id":"gap_bg_03","missing_source_classes":["未满足需求文献","VNN1靶点机制文献"],"target":"研究背景和立项依据-未满足需求与立题段落"},{"action":"纳入MY009212A非临床药效学、药代动力学、安全性及既往临床数据","category":"source_missing","gap_id":"gap_bg_04","missing_source_classes":["IB","非临床资料","既往临床数据"],"target":"研究背景和立项依据-研究药物前期数据段落"}],"heading":"研究背景和立项依据","missing_source_classes":["溃疡性结肠炎流行病学与疾病负担文献","溃疡性结肠炎诊疗指南（中国共识、ECCO、AGA等）","现有治疗格局与未满足需求综述","MY009212A研究者手册（IB）"],"proposal_text":"","rationale":"本章需要溃疡性结肠炎流行病学与疾病负担数据、现行诊疗指南（如中国IBD诊治共识、ECCO/AGA指南）、现有治疗格局（5-ASA、糖皮质激素、免疫抑制剂、生物制剂、小分子靶向药）的疗效与局限性证据，以及MY009212A的非临床与既往临床数据，方可形成有实质证据支撑的背景综述。当前允许来源仅包含项目名称、靶点名称（VNN1抑制剂）、研究分期与目的等设计标签，无流行病学文献、指南引用、治疗格局综述或IB/非临床/既往临床资料。公司语料来源均为不同适应症（炎症性皮肤病、PNH、青少年AD），不可迁移至溃疡性结肠炎背景。竞品样本不足2份，无法按竞品段落结构对齐。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_351918501996_1fbd7a58ebd6cf39","section_number":"2","source_ids":["protocol_full_draft_selection:732610562a7337e60c49ac7e","current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:8906e921bf8a9f","company_corpus:cms_cn_protocol_corpus_20260715_v1:be5d06fd3b46ad"]},{"ai_run_id":"airun_20261011074410_3b6662eb","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"纳入溃疡性结肠炎全球及中国患病率、发病率、疾病负担的权威文献或指南数据","category":"source_missing","gap_id":"gap_disease_01","missing_source_classes":["流行病学文献","疾病负担数据"],"target":"疾病背景及治疗现状-流行病学与疾病负担段落"},{"action":"纳入UC疾病自然史、免疫病理机制及中重度活动性UC临床特征的文献","category":"source_missing","gap_id":"gap_disease_02","missing_source_classes":["疾病机制文献","自然史综述"],"target":"疾病背景及治疗现状-疾病自然史与病理机制段落"},{"action":"纳入现行UC诊疗指南推荐及现有治疗（5-ASA、激素、免疫抑制剂、生物制剂、小分子靶向药）的疗效与局限性证据","category":"source_missing","gap_id":"gap_disease_03","missing_source_classes":["诊疗指南","治疗格局综述","未满足需求文献"],"target":"疾病背景及治疗现状-现有治疗格局与未满足需求段落"}],"heading":"疾病背景及治疗现状","missing_source_classes":["溃疡性结肠炎流行病学与疾病负担文献","溃疡性结肠炎诊疗指南（中国共识、ECCO、AGA等）","现有治疗格局与未满足需求综述"],"proposal_text":"","rationale":"本章需要溃疡性结肠炎的流行病学数据（全球及中国患病率、发病率、疾病负担）、疾病自然史与病理机制描述、现行诊疗指南推荐（中国IBD诊治共识、ECCO指南、AGA指南等）、现有治疗格局（5-ASA、糖皮质激素、免疫抑制剂、抗TNF生物制剂、抗整合素、抗IL-12/23、JAK抑制剂、S1P受体调节剂等）的疗效与局限性证据，方可形成有实质内容的疾病背景及治疗现状综述。当前允许来源仅标注疾病名称为中重度活动性溃疡性结肠炎，无流行病学文献、指南引用或治疗格局综述。公司语料来源均为不同适应症（炎症性皮肤病、PNH、青少年AD），不可迁移至溃疡性结肠炎疾病背景。竞品样本不足2份，无法按竞品段落结构对齐。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_351918501996_fe8693ba62c895e4","section_number":"2.1","source_ids":["protocol_full_draft_selection:732610562a7337e60c49ac7e","current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:8906e921bf8a9f","company_corpus:cms_cn_protocol_corpus_20260715_v1:be5d06fd3b46ad"]},{"ai_run_id":"airun_20261011074410_3b6662eb","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"纳入VNN1靶点在溃疡性结肠炎炎症通路中的作用机制文献及MY009212A的靶点选择性数据","category":"source_missing","gap_id":"gap_drug_01","missing_source_classes":["VNN1机制文献","靶点验证数据"],"target":"研究药物简介-靶点与机制段落"},{"action":"纳入MY009212A在DSS或TNBS结肠炎动物模型中的药效学数据","category":"source_missing","gap_id":"gap_drug_02","missing_source_classes":["非临床药效学报告"],"target":"研究药物简介-非临床药效学段落"},{"action":"纳入MY009212A的ADME数据、安全药理学及重复给药毒性研究摘要","category":"source_missing","gap_id":"gap_drug_03","missing_source_classes":["非临床PK报告","毒理学报告"],"target":"研究药物简介-非临床药代动力学与安全性段落"},{"action":"纳入MY009212A I期人体安全性、PK/PD及初步疗效数据","category":"source_missing","gap_id":"gap_drug_04","missing_source_classes":["I期临床报告","IB"],"target":"研究药物简介-既往临床数据段落"}],"heading":"研究药物简介","missing_source_classes":["MY009212A研究者手册（IB）","VNN1靶点机制文献","非临床药效学数据","非临床药代动力学数据"],"proposal_text":"","rationale":"本章需要MY009212A的研究者手册（IB）、非临床药效学研究数据（VNN1靶点验证、动物模型疗效）、非临床药代动力学数据（吸收、分布、代谢、排泄）、非临床安全性毒理学数据（急毒、长毒、安全药理学）、既往人体临床数据（I期安全性与PK/PD）以及VNN1靶点在溃疡性结肠炎中的机制文献，方可形成有实质内容的研究药物简介。当前允许来源仅包含靶点名称（VNN1抑制剂）、剂型（40mg/片薄膜衣片）、给药途径（口服）、技术类型（small_molecule）和系统暴露范围（systemic），无IB、非临床或既往临床资料。竞品样本不足2份，无法按竞品段落结构对齐。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_351918501996_fce5b404dd6e1689","section_number":"2.3","source_ids":["protocol_full_draft_selection:732610562a7337e60c49ac7e","current_project_study_definition:mwdefinition_886cef95b6743095fb69:r5:4ae3ced7ede22a21","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:8906e921bf8a9f","company_corpus:cms_cn_protocol_corpus_20260715_v1:be5d06fd3b46ad"]}],"source_bindings":[{"content_sha256":"3104a204e1905474d3ed7085ee83b96d4cdd9bd4154ba387322d07ee4f5feeba","locator":"document:mwdoc_greenfield_proj_user_351918501996_6b224e2586cb9503:full-draft:732610562a7337e60c49ac7e