655052f59ba27cf5340a552d5","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_003"}],"evidence_review_advisories":[],"evidence_span_ids":["es_003"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[{"action":"由统计团队在SAP中明确FAS、PPS及安全性集的具体纳入排除标准，包括对重大方案偏离、依从性不足及提前退出受试者的处理规则。","category":"source_missing","gap_id":"gap_92_set_def","missing_source_classes":["统计分析计划中分析集定义"],"target":"9.2 统计分析数据集"}],"heading":"统计分析数据集","missing_source_classes":["各分析集具体纳入排除标准定义"],"proposal_text":"本研究设置全分析集（FAS）与符合方案集（PPS）用于疗效评价，设置安全性分析集用于安全性评价。FAS包含所有经随机化分配的受试者，PPS在FAS基础上排除存在重大方案偏离或未按方案完成足够治疗疗程的受试者。安全性分析集包含所有至少接受一次研究药物或安慰剂给药的受试者。各分析集的具体纳入与排除标准将在统计分析计划中进一步界定。","rationale":"FAS/PPS评价疗效、安全性集评价安全为当前项目已确认的统计分析策略。各集的具体纳入排除标准（如是否要求至少一次给药、重大方案偏离定义等）未在允许来源中明确，需统计团队在SAP中界定。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_5130d2151cc813a2","section_number":"9.2","source_ids":["protocol_full_draft_selection:3d5330344e9ac1a2d8388ce8","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:2410eb4e97ccdc","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be"]},{"ai_run_id":"airun_20261006015317_19d3b649","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"统计分析策略：FAS/PPS评价疗效，安全性集评价安全；分层检验控制I类错误；DMC监查。","quote_sha256":"e7d4508cdd23c10fdf8190e2cc015b96cb72e16655052f59ba27cf5340a552d5","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_003"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"分层检验控制I类错误；DMC监查。","quote_sha256":"4defce2eeac6b014a5aade1da12fb632ea569358da136d93a5e53bfe7bc83fef","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_004"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"估计目标策略：治疗策略（treatment policy）下评价12个月新发椎体骨折及腰椎BMD变化。","quote_sha256":"04ecaae76b2308023b4bd5f0e91b2eb135fbe627160522f13728cc41bb9f8ef3","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_005"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"随机化方式：1:1随机，按中心分层；双盲；全部受试者补钙+维生素D背景治疗。","quote_sha256":"1e2525c9ccc1191eef1713b72b9ce4466d41783ca44f6fb529eb04edb44be034","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_006"},{"locator":"section:8 统计学考虑|block:1056|chunk:1","quote":"有效性评价、安全性评价、PK 评价、PD 评价、免疫原性评价以及其他分析将在本研究的统计分析计划（SAP）中详细规定，数据库锁定前将最终确定 SAP。","quote_sha256":"a635fe9c51c78cbc66090c3553c488cd453e807e61608a97e0767740d5088a03","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","span_id":"es_009"}],"evidence_review_advisories":[],"evidence_span_ids":["es_003","es_004","es_005","es_006","es_009"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":4},"gap_items":[{"action":"由医学与统计团队确认DMC的组成、审查频率、安全性触发标准及沟通机制，写入本节或DMC章程。","category":"source_missing","gap_id":"gap_93_dmc","missing_source_classes":["DMC章程或职责文件"],"target":"9.3 统计分析一般原则"},{"action":"由统计团队确定分层检验的具体统计方法（如分层CMH、分层混合效应模型等）及I类错误在两主要终点间的分配方案。","category":"source_missing","gap_id":"gap_93_method","missing_source_classes":["统计分析计划中方法学细节"],"target":"9.3 统计分析一般原则"}],"heading":"统计分析一般原则","missing_source_classes":["DMC组成与职责细则","分层检验具体统计方法","I类错误分配方案"],"proposal_text":"本研究采用分层检验策略控制I类错误，随机化按研究中心分层，统计分析中相应纳入中心作为分层因素。主要疗效分析在治疗策略估计目标下进行，即无论受试者是否依从方案、是否使用合并用药或是否提前退出，均按随机化分组进行分析。安全性分析以安全性分析集为基础，对治疗期出现的不良事件进行描述性统计。本研究设置独立数据安全监查委员会（DMC）对研究进行安全性监查。有效性评价、安全性评价及其他分析的具体方法将在统计分析计划中详细规定，统计分析计划于数据库锁定前最终确定。","rationale":"分层检验控制I类错误、DMC监查、治疗策略估计目标及按中心分层随机化均来自当前项目已确认研究事实。SAP在数据库锁定前最终确定为监管共性结构参照（来源为青少年AD方案，仅作章节结构参照，不迁移其项目事实）。DMC具体组成、审查频率及触发标准未给出。","review_advisories":["本节提及高影响设计信息（估计目标）；系统未把重复提及升级为强制确认。","本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_b1e77b2f258b43c4","section_number":"9.3","source_ids":["protocol_full_draft_selection:3d5330344e9ac1a2d8388ce8","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:2410eb4e97ccdc","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be"]},{"ai_run_id":"airun_20261006015317_19d3b649","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"复合主要终点：12个月新发椎体骨折；12个月腰椎BMD相对基线百分比变化。","quote_sha256":"a00e31b0eb90cfe086a7286688c5c937996be8b1efa66bc3c333762888270cd2","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_002"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"统计分析策略：FAS/PPS评价疗效，安全性集评价安全；分层检验控制I类错误；DMC监查。","quote_sha256":"e7d4508cdd23c10fdf8190e2cc015b96cb72e16655052f59ba27cf5340a552d5","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_003"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"估计目标策略：治疗策略（treatment policy）下评价12个月新发椎体骨折及腰椎BMD变化。","quote_sha256":"04ecaae76b2308023b4bd5f0e91b2eb135fbe627160522f13728cc41bb9f8ef3","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_005"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"关键次要终点：非椎体骨折、临床骨折、全髋/股骨颈BMD、P1NP、CTX。","quote_sha256":"b9df4adebb6512805eaaee793d2ff42fc3544ee265d8968194a133410d42a739","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_007"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"安全性终点：MACE、注射部位反应、低钙血症。","quote_sha256":"c38602080b87e31c57fb54c3b609aa01140e1f487c5dfc02da9729c1d284b322","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_008"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003","es_005","es_007","es_008"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"由统计团队确定椎体骨折终点（二分类）与BMD终点（连续变量）各自的统计模型、协变量调整及多重性控制策略，写入SAP后回填本节。","category":"source_missing","gap_id":"gap_94_model","missing_source_classes":["统计分析计划中模型与多重性方案"],"target":"9.4 有效性数据分析"}],"heading":"有效性数据分析","missing_source_classes":["各终点具体统计模型","多重性调整策略","亚组分析方案"],"proposal_text":"有效性数据分析以FAS和PPS为主要分析集。共同主要终点为12个月新发椎体骨折发生率（经影像学判读）与12个月腰椎BMD相对基线百分比变化，两项终点均按治疗策略估计目标进行分析。关键次要终点包括非椎体骨折发生率、临床骨折发生率、全髋及股骨颈BMD变化、骨转换标志物P1NP及CTX的变化。BMD测量时间点为基线、第6个月及第12个月；骨转换标志物检测时间点为基线、第1、3、6及12个月。安全性终点包括主要不良心血管事件（MACE）、注射部位反应及低钙血症，以安全性分析集进行描述性分析。各终点的具体统计模型、多重性调整策略及亚组分析将在统计分析计划中规定。","rationale":"复合主要终点、关键次要终点、安全性终点、BMD及骨转换标志物检测时间点、治疗策略估计目标及FAS/PPS分析集均来自当前项目已确认研究事实。具体统计模型（如骨折用logistic回归或Cox模型、BMD用混合效应模型等）、多重性调整策略及亚组分析方案未给出，需统计团队在SAP中确定。","review_advisories":["本节提及高影响设计信息（主要终点、估计目标）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_c30cc46a9cf6c25f","section_number":"9.4","source_ids":["protocol_full_draft_selection:3d5330344e9ac1a2d8388ce8","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","compa