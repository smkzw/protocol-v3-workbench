:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca"]},{"ai_run_id":"airun_20261006010010_66eef937","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"多中心、随机、双盲、安慰剂对照，两臂1:1（SLN-611 210mg qm SC / 匹配安慰剂），12个月双盲治疗期，全部受试者补钙+维生素D","quote_sha256":"8d302d5d34a995ab37198829b1baab75c85a322d11fc86f743930e6fde474c6a","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es1"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"筛选、随机及每月给药访视至12个月；BMD于基线、6、12个月；骨转换标志物于基线、1、3、6、12个月","quote_sha256":"14a3d4efbbd11998be73c126ed74c421aaf71517fd998d44f7831c219af8cba2","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es6"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"FAS/PPS评价疗效，安全性集评价安全；分层检验控制I类错误；DMC监查","quote_sha256":"79c329b5bb7c24449f7141e3c52c9f71023bf0f1d2218536b11ae9e0cc22259b","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es7"}],"evidence_review_advisories":[],"evidence_span_ids":["es1","es6","es7"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[],"heading":"研究设计","missing_source_classes":[],"proposal_text":"本研究为多中心、随机、双盲、安慰剂对照、平行组III期临床研究，旨在评价SLN-611（皮下注射硬骨抑素单抗，210mg每月一次皮下注射）对比匹配安慰剂在绝经后骨质疏松症受试者中的有效性和安全性。研究采用两臂1:1随机分配，按中心分层，双盲设计，全部受试者接受补钙加维生素D背景治疗。研究时期包括筛选期和12个月双盲治疗期。设置独立数据监查委员会对研究进行安全性监查。本研究不计划自适应设计、样本量再估计、期中分析或SRC。统计分析采用FAS和PPS评价疗效，安全性集评价安全性，分层检验控制I类错误。","rationale":"本段正文依据当前项目已确认研究事实中的总体研究设计、研究时期、DMC设置、自适应/期中/SRC排除及统计分析策略编写。医学经理需核实：（1）各中心是否均具备DXA及椎体影像学判读条件；（2）DMC章程中安全性监查频率与触发标准；（3）FAS/PPS定义及分层检验的具体层级结构。","review_advisories":["本节复述高影响研究设计（研究设计）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（期中分析、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_6dc31c11d096fbf9","section_number":"4","source_ids":["protocol_full_draft_selection:7ecce353d98e491c2984e249","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca"]},{"ai_run_id":"airun_20261006010010_66eef937","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"多中心、随机、双盲、安慰剂对照，两臂1:1（SLN-611 210mg qm SC / 匹配安慰剂），12个月双盲治疗期，全部受试者补钙+维生素D","quote_sha256":"8d302d5d34a995ab37198829b1baab75c85a322d11fc86f743930e6fde474c6a","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es1"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"筛选、随机及每月给药访视至12个月；BMD于基线、6、12个月；骨转换标志物于基线、1、3、6、12个月","quote_sha256":"14a3d4efbbd11998be73c126ed74c421aaf71517fd998d44f7831c219af8cba2","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es6"},{"locator":"document:mwdoc_greenfield_proj_user_d5ebc58f4bba_e54ab29f43100c76:full-draft:7ecce353d98e491c2984e249","quote":"随机化（1:1随机，按中心分层；双盲；全部受试者补钙+维生素D背景治疗。）；双盲；安慰剂对照；平行组；多中心；设置独立数据监查委员会（DMC）","quote_sha256":"e0b641b73d906520ee4c104a769461acee8a2845b4715af99b07dae877215530","source_id":"protocol_full_draft_selection:7ecce353d98e491c2984e249","span_id":"es8"}],"evidence_review_advisories":[],"evidence_span_ids":["es1","es6","es8"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[],"heading":"总体设计","missing_source_classes":[],"proposal_text":"本研究采用多中心、随机、双盲、安慰剂对照、平行组设计。受试者按1:1比例随机分配至SLN-611 210mg每月一次皮下注射组或匹配安慰剂每月一次皮下注射组，随机化按中心分层。双盲设计适用于受试者和研究者。全部受试者在研究期间接受补钙加维生素D背景治疗。研究设置独立数据监查委员会，负责定期审阅安全性数据并评估是否建议继续、修改或终止研究。研究时期包括筛选期和12个月双盲治疗期。访视安排为筛选访视、随机访视及每月给药访视至第12个月；腰椎BMD检测于基线、第6个月和第12个月进行；骨转换标志物P1NP和CTX检测于基线、第1个月、第3个月、第6个月和第12个月进行。","rationale":"本段正文依据当前项目已确认研究事实中的随机化方式、双盲设计、安慰剂对照、平行组、多中心、DMC设置、访视策略及BMD和骨转换标志物检测时间点编写。医学经理需核实：（1）双盲范围是否涵盖独立影像学判读委员会成员；（2）每月给药访视中是否每次均进行安全性评估（如注射部位检查、生命体征）；（3）BMD和骨转换标志物检测是否仅限上述时间点或存在计划外重复检测情形。","review_advisories":["本节复述高影响研究设计（总体设计）；请在合并设计摘要中统一核对。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_a8aed5c354ea2644","section_number":"4.1","source_ids":["protocol_full_draft_selection:7ecce353d98e491c2984e249","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca"]},{"ai_run_id":"airun_20261006010010_66eef937","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"治疗策略（treatment policy）下评价12个月新发椎体骨折及腰椎BMD变化","quote_sha256":"f6fd1e44af9bb8e76dca946e33cbdb1d88340374dfe6c1a3f1ff1173f13901c6","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es2"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"共同主要终点：12个月新发椎体骨折发生率（影像学判读）＋腰椎BMD较基线百分比变化","quote_sha256":"d3201dee0ef0246f30b68cff500863fb0b70bbeb2260c46d57143487d5a05478","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es3"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"次要终点：非椎体骨折；临床骨折；全髋/股骨颈BMD；骨转换标志物（P1NP/CTX）","quote_sha256":"5604f257c8b099dbabcfeaa53052f44554e3542ff4a197c941ea46570d82d30e","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es4"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"安全性终点：MACE、注射部位反应、低钙血症","quote_sha256":"562e83b95c565d558b894771bab13690d3d64c279f5d8ddb28135e441906d05e","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es5"},{"locator":"document:mwdoc_greenfield_proj_user_d5ebc58f4bba_e54ab29f43100c76:full-draft:7ecce353d98e491c2984e249","quote":"治疗策略（treatment policy）下评价12个月新发椎体骨折及腰椎BMD变化。","quote_sha256":"a680592bcdcab92749f85979c9fd807d322150b7a132363554676bee8a3b7f5c","source_id":"protocol_full_draft_selection:7ecce353d98e491c2984e249","span_id":"es9"}],"evidence_review_advisories":[],"evidence_span_ids":["es2","es3","es4","es5","es9"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"确认治疗策略估计目标是否适用于本方案所有主要终点，或需对BMD终点单独说明","category":"decision_pending","gap_id":"gap_4_2_estimation_target","missing_source_classes":[],"target":"4.2 设计依据——估计目标策略"},{"action":"确认椎体骨折影像学判读方法（如Genant半定量法或中心阅片流程）","category":"source_missing","gap_id":"gap_4_2_imaging","missing_source_classes":["项目影像学评估方案"],"target":"4.2 设计依据——椎体骨折影像学判读"}],"heading":"设计依据","missing_source_classes":["项目影像学评估方案"],"proposal_text":"本研究采用治疗策略估计目标，在12个月双盲治疗期内评价新发椎体骨折发生率及腰椎BMD较基线百分比变化。选择治疗策略估计目标的依据在于：绝经后骨质疏松症为慢性疾病，12个月治疗期内受试者可能因不良事件、合并疾病或依从性原因中断研究药物，治疗策略估计目标反映的是包含上述中断情形在内的整体治疗策略的临床获益，与真实世界中长期抗骨吸收或促骨形成治疗的决策情境更为接近。主要终点中，12个月新发椎体骨折发生率通过影像学判读确定，腰椎BMD较基线百分比变化通过DXA测量获得。关键次要终点包括非椎体骨折、临床骨折、全髋及股骨颈BMD以及骨转换标志物P1NP和CTX，用于支持主要终点的临床意义解读和药效学验证。安全性终点包括主要不良心血管事件、注射部位反应和低钙血症，与SLN-611作为硬骨抑素单抗的已知药理特征及既往同类药物安全性信号相关。","rationale":"本段正文依据当前项目已确认研究事实中的估计目标策略、共同主要终点、关键次要终点、安全性终点及药物作用机制编写。治疗策略估计目标的选择理由基于慢性骨质疏松症长期治疗决策的合理性推断，需医学经理确认：（1）是否接受治疗策略估计目标而非假设策略估计目标；（2）椎体骨折影像学判读是否采用中心阅片及具体判读标准；（3）MACE定义是否参照既往同类药物安全性信号及本方案安全性章节的具体定义。","review_advisories":["本节提及高影响设计信息（主要终点、估计目标）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_945e7c8da43c5dcf","section_number":"4.2","source_ids":["protocol_full_draft_selection:7ecce353d98e491c2984e249","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca"]}],"source_bindings":[{"content_sha256":"082467293fea609d4ecc767b1bb156ebae137bbe7d6a1c7371c8ce6861e42c97","locator":"document:mwdoc_greenfield_proj_user_d5ebc58f4bba_e54ab29f43100c76:full-draft:7ecce353d98e491c2984e249","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:7ecce353d98e491c2984e249","source_type":"protocol_full_draft_selection","source_version":"full-draft:d4bcfda355db92494e1792b8a712f5912f5c5f0842d8a34c2adf2dcffe0add9e:7ecce353d98e491c2984e249","text_sha256":"082467293fea609d4ecc767b1bb156ebae137bbe7d6a1c7371c8ce6861e42c97"},{"content_sha256":"01acde550034c139002b127618cadca82a0894fdead88903d47425241f006b8c","locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","source_type":"current_project_study_definition","source_version":"mwdefinition_e39e763face56