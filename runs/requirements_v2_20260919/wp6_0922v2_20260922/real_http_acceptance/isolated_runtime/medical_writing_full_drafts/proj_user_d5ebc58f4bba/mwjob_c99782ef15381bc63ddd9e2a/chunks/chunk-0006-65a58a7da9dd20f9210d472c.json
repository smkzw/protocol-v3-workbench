ct_fact_spans":1},"gap_items":[{"action":"由统计学团队完成基于双重主要终点的样本量计算后填入","category":"source_missing","gap_id":"gap_5_1_sample_number","missing_source_classes":["正式样本量计算报告","统计学分析计划"],"target":"计划入组人数具体数值"}],"heading":"计划入组人数","missing_source_classes":["正式样本量计算报告或统计学分析计划"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂对照III期临床研究，采用两臂1:1平行组设计，试验组接受SLN-611 210mg每月一次皮下注射，对照组接受匹配安慰剂每月一次皮下注射，双盲治疗期共12个月，全部受试者同时接受钙剂加维生素D背景治疗。计划入组人数依据12个月新发椎体骨折发生率（影像学判读）与12个月腰椎骨密度较基线百分比变化两项共同主要终点进行估算，随机分配比例为1:1，估算时已考虑受试者脱落因素。","rationale":"样本量估算策略（双重主要终点、1:1分配、考虑脱落）来源于当前项目已确认研究事实中的样本量策略条目；研究设计要素（多中心、随机、双盲、安慰剂对照、12个月、1:1、背景治疗）来源于总体研究设计条目。具体入组总人数数值未在任何允许来源中给出，需由统计学团队完成正式样本量计算后填入。","review_advisories":["本节提及高影响设计信息（主要终点、计划入组）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_246e3ad2a481b4de","section_number":"5.1","source_ids":["protocol_full_draft_selection:65a58a7da9dd20f9210d472c","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]},{"ai_run_id":"airun_20261006011923_85d3f5ca","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"55–90岁、绝经≥1年、腰椎或全髋BMD T值≤−2.5（无椎体骨折史，或仅1处轻度）","quote_sha256":"d1c3f02abb58583e9cce7bcac25196f02057b90836bb32a6cd91f7da1bc87c20","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_003"},{"locator":"document:mwdoc_greenfield_proj_user_d5ebc58f4bba_e54ab29f43100c76:full-draft:65a58a7da9dd20f9210d472c","quote":"自愿签署知情同意","quote_sha256":"074c0c70e960a8bc458530ca9dbdadf3bf6b4f184543d29bf772c5307ba5f3b1","source_id":"protocol_full_draft_selection:65a58a7da9dd20f9210d472c","span_id":"es_004"}],"evidence_review_advisories":[],"evidence_span_ids":["es_003","es_004"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[{"action":"医学经理确认上述两项条件应列入入选标准还是排除标准","category":"decision_pending","gap_id":"gap_5_3_criteria_ownership","missing_source_classes":[],"target":"近6个月骨抑制类药物使用史及心血管事件史的入选/排除归属"}],"heading":"入选标准","missing_source_classes":["项目级入选标准完整清单（含是否排除骨抑制类药物使用史、心血管事件史等条件的最终归属）"],"proposal_text":"受试者须同时满足以下全部条件方可入组：（1）年龄55至90岁（含）的绝经后女性，自然绝经时间不少于1年；（2）基线腰椎或全髋骨密度T值≤−2.5；（3）无椎体骨折史，或仅存在1处轻度椎体骨折；（4）自愿参加本研究并签署书面知情同意书。","rationale":"年龄范围、绝经年限、BMD T值阈值及椎体骨折限制来源于当前项目已确认研究事实中的目标研究人群和研究人群概述条目；知情同意要求来源于全文初稿章节包中入选标准模块。来源中'近6个月使用骨抑制类药物'和'入组前12个月内心梗/卒中/冠脉重建等心血管事件'同时出现在入选标准模块和排除标准模块，语义上更符合排除条件，需医学经理确认归属后决定是否纳入本章。","review_advisories":["本节复述高影响研究设计（入选标准）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_a910563e50d15228","section_number":"5.3","source_ids":["protocol_full_draft_selection:65a58a7da9dd20f9210d472c","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]},{"ai_run_id":"airun_20261006011923_85d3f5ca","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"入组前12个月内心梗/卒中/冠脉重建等心血管事件","quote_sha256":"d249ec78f7bb0c2b4fdce97309105b2f027ab9d2c493bbaf6575370287e11f7c","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_005"},{"locator":"document:mwdoc_greenfield_proj_user_d5ebc58f4bba_e54ab29f43100c76:full-draft:65a58a7da9dd20f9210d472c","quote":"eGFR<35 mL/min/1.73m2","quote_sha256":"e4dc367f2935de8df9ffdf889bd97afb4df2d9cb2ea9fb9b1d07d9ecd23e0dba","source_id":"protocol_full_draft_selection:65a58a7da9dd20f9210d472c","span_id":"es_006"},{"locator":"document:mwdoc_greenfield_proj_user_d5ebc58f4bba_e54ab29f43100c76:full-draft:65a58a7da9dd20f9210d472c","quote":"两处及以上骨折或重度椎体骨折","quote_sha256":"10470309577f9da8bb38eab72b7699cb51d2a7da2a048f30250143e20576bfd5","sourc