tion:0f1a154d6e968534e3054ef4","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54"]},{"ai_run_id":"airun_20261006013533_3b72592e","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"主要终点：复合主要终点：12个月新发椎体骨折；12个月腰椎BMD相对基线百分比变化。","quote_sha256":"dbfa88595fa4814b9bffcef4f52ed771e00655a917ba26a14e678d699f0410d8","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_study_def_02"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"关键次要终点：非椎体骨折、临床骨折、全髋/股骨颈BMD、P1NP、CTX。","quote_sha256":"b9df4adebb6512805eaaee793d2ff42fc3544ee265d8968194a133410d42a739","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_study_def_03"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"访视策略：筛选、随机及每月给药访视至12个月；BMD于基线、6、12个月；骨转换标志物于基线、1、3、6、12个月。","quote_sha256":"263892173e743acc3ddd0ab62c4d9222d68b0b37b46d49ca79ee253a43ff407f","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_study_def_04"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"统计分析策略：FAS/PPS评价疗效，安全性集评价安全；分层检验控制I类错误；DMC监查。","quote_sha256":"e7d4508cdd23c10fdf8190e2cc015b96cb72e16655052f59ba27cf5340a552d5","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_study_def_05"}],"evidence_review_advisories":[],"evidence_span_ids":["es_study_def_02","es_study_def_03","es_study_def_04","es_study_def_05"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"确认新发椎体骨折影像学判读方法（如Genant半定量法）及中心阅片流程","category":"source_missing","gap_id":"gap_72_01","missing_source_classes":["影像学判读操作手册"],"target":"7.2 有效性评估 - 影像学判读方法"},{"action":"确认P1NP/CTX检测的实验室方法学、参考范围及采集窗口","category":"source_missing","gap_id":"gap_72_02","missing_source_classes":["中心实验室方案"],"target":"7.2 有效性评估 - 骨转换标志物检测方法"},{"action":"确认各有效性终点在双盲治疗期内的采集窗口及缺失数据处理规则","category":"source_missing","gap_id":"gap_72_03","missing_source_classes":["统计分析计划"],"target":"7.2 有效性评估 - 缺失数据处理"}],"heading":"有效性评估","missing_source_classes":["影像学判读操作手册","中心实验室方案","统计分析计划中缺失数据处理细则"],"proposal_text":"本研究的有效性评估采用治疗策略（treatment policy）估计目标，在12个月双盲治疗期内评价SLN-611 210mg每月一次皮下注射相对于匹配安慰剂的疗效。主要有效性终点为复合终点，包括12个月新发椎体骨折发生率（经影像学判读确认）和12个月腰椎骨密度（BMD）较基线的百分比变化。关键次要有效性终点包括非椎体骨折发生率、临床骨折发生率、全髋及股骨颈BMD较基线变化，以及骨转换标志物P1NP和CTX较基线变化。腰椎BMD检测安排在基线、第6个月和第12个月访视进行；骨转换标志物P1NP和CTX的采集时点为基线、第1个月、第3个月、第6个月和第12个月。疗效分析在全分析集（FAS）和符合方案集（PPS）中进行，采用分层检验控制I类错误。新发椎体骨折的影像学判读方法及中心阅片流程、BMD检测的仪器与质控要求、骨转换标志物检测的实验室方法学及参考范围，以及各终点在双盲治疗期内的具体采集窗口和缺失数据处理规则，需依据项目操作手册和中心实验室方案进一步确认。","rationale":"已确认事实支持：复合主要终点（12个月新发椎体骨折＋腰椎BMD百分比变化）、关键次要终点（非椎体骨折、临床骨折、全髋/股骨颈BMD、P1NP/CTX）、BMD和骨转换标志物的采集时点、治疗策略估计目标、FAS/PPS分析集和分层检验策略。需医学经理确认：影像学判读方法、BMD仪器质控、骨转换标志物实验室方法、各终点采集窗口及缺失数据处理规则。","review_advisories":["本节提及高影响设计信息（估计目标）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_ffae7395ce791b51","section_number":"7.2","source_ids":["protocol_full_draft_selection:0f1a154d6e968534e3054ef4","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54"]},{"ai_run_id":"airun_20261006013533_3b72592e","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"安全性终点：MACE、注射部位反应、低钙血症。","quote_sha256":"c38602080b87e31c57fb54c3b609aa01140e1f487c5dfc02da9729c1d284b322","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_study_def_06"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"产品安全性关注点：心血管事件监察（MACE类）；注射部位反应；低钙血症；该类药既往有心血管安全性信号；入组前12个月内心梗/卒中/冠脉重建等心血管事件为主要排除标准","quote_sha256":"77b27fc19a1fe9c7138a72bfabe3feda22ae0a7bc68733dce2ac09d1eebd1bd4","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_study_def_07"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"DMC是否计划：是","quote_sha256":"9967a9a75297ced2326ab733fa3b16934acdef641fa765dd50c1cd58219f4aa5","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_study_def_08"}],"evidence_review_advisories":[],"evidence_span_ids":["es_study_def_06","es_study_def_07","es_study_def_08"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"获取项目AE/SAE/SUSAR定义、采集窗口、报告对象与时限、因果关系判定标准","category":"source_missing","gap_id":"gap_73_01","missing_source_classes":["项目安全性管理规范","AE/SAE/SUSAR报告操作规范"],"target":"7.3 安全性评估 - AE/SAE/SUSAR定义与报告"},{"action":"确认注射部位反应和低钙血症的具体监测方案、干预措施及停药标准","category":"source_missing","gap_id":"gap_73_02","missing_source_classes":["研究者手册","项目安全性管理规范"],"target":"7.3 安全性评估 - 注射部位反应与低钙血症监测"},{"action":"确认DMC审阅频率、触发标准及沟通机制","category":"source_missing","gap_id":"gap_73_03","missing_source_classes":["DMC章程"],"target":"7.3 安全性评估 - DMC运作"}],"heading":"安全性评估","missing_source_classes":["项目安全性管理规范","研究者手册","AE/SAE/SUSAR报告操作规范","DMC章程"],"proposal_text":"本研究的安全性评估以主要关注MACE类心血管事件、注射部位反应和低钙血症为核心安全性终点，同时全面收集不良事件（AE）和严重不良事件（SAE）。鉴于SLN-611所属硬骨抑素单抗类药物既往存在心血管安全性信号，本研究将入组前12个月内心梗、卒中或冠脉重建等心血管事件作为主要排除标准，并在双盲治疗期内对MACE类事件进行专项监察。安全性数据在安全性分析集中进行评价。本研究设置独立数据安全监查委员会（DMC），对累积安全性数据进行定期审阅，以保障受试者安全。不良事件和严重不良事件的定义、因果关系判定标准、采集窗口、报告对象与报告时限、可疑且非预期严重不良反应（SUSAR）的判定与报告流程，以及注射部位反应和低钙血症的具体监测方案与干预措施，需依据项目安全性管理规范和研究者手册进一步确认。","rationale":"已确认事实支持：安全性终点（MACE、注射部位反应、低钙血症）、产品安全性关注点（心血管事件监察、该类药既往心血管安全性信号）、排除标准（入组前12个月内心血管事件）、DMC设置、安全性分析集。需医学经理确认：AE/SAE/SUSAR定义与报告规则、注射部位反应和低钙血症监测方案、DMC审阅频率与触发标准。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_952a608f3ad595af","section_number":"7.3","source_ids":["protocol_full_draft_selection:0f1a154d6e968534e3054ef4","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54"]},{"ai_run_id":"airun_20261006013533_3b72592e","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取项目生命体征评估项目清单、评估频率、异常判定标准及体格检查范围","category":"source_missing","gap_id":"gap_731_01","missing_source_classes":["项目安全性评估操作规范","访视操作手册"],"target":"7.3.1 生命体征和体格检查"},{"action":"确认生命体征和体格检查与MACE、注射部位反应、低钙血症等安全性终点的关联监测规则","category":"source_missing","gap_id":"gap_731_02","missing_source_classes":["项目安全性评估操作规范"],"target":"7.3.1 生命体征和体格检查 - 与安全性终点关联"}],"heading":"生命体征和体格检查","missing_source_classes":["项目安全性评估操作规范","访视操作手册","生命体征与体格检查评估标准"],"proposal_text":"","rationale":"允许来源仅列出访视策略中'每月给药访视'和BMD/骨转换标志物采集时点，但未明确生命体征（血压、心率、体温等）和体格检查的具体评估项目、评估频率、异常判定标准、与安全性终点的关联规则，以及是否在每个给药访视均实施。不得由'每月给药访视'推断所有安全性评估在每个访视均实施。该章节需要项目安全性评估操作规范或访视操作手册支持。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_e6fb06c924acc54d","section_number":"7.3.1","source_ids":["protocol_full_draft_selection:0f1a154d6e968534e3054ef4","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54"]}],"source_bindings":[{"content_sha256":"54690d9568f0590af422e5bfe21d5f4cb2475ec82f2854a5611c7a276d1ec08a","locator":"document:mwdoc_greenfield_proj_user_d5ebc58f4bba_e54ab29f43100c76:full-draft:0f1a154d6e968534e3054ef4","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:0f1a154d6e968534e3054ef4","source_type":"protocol_full_draft_selection","source_version":"full-draft:d4bcfda355db92494e1792b8a712f5912f5c5f0842d8a34c2adf2dcffe0add9e:0f1a154d6e968534e3054ef4","text_sha256":"54690d9568f0590af422e5bfe21d5f4cb2475ec82f2854a5611c7a276d1ec08a"},{"content_sha256":"01acde550034c13