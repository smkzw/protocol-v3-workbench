":0,"project_fact_spans":2},"gap_items":[{"action":"获取项目CRF设计文档及EDC系统选型与验证状态","category":"source_missing","gap_id":"gap_crf_form_design","missing_source_classes":["CRF设计文档","EDC系统验证报告"],"target":"10.1节CRF表单结构与字段定义"},{"action":"确认MACE、注射部位反应、低钙血症的采集窗口、判定标准及报告时限","category":"source_missing","gap_id":"gap_safety_collection_window","missing_source_classes":["安全性事件采集SOP","研究者手册安全性章节"],"target":"10.1节安全性数据采集窗口与判定标准"},{"action":"确认各访视是否包含生命体征、体格检查、心电图、依从性评价等通用项目","category":"source_missing","gap_id":"gap_visit_general_assessments","missing_source_classes":["访视流程表","数据管理计划"],"target":"10.1节各访视通用评估项目"}],"heading":"病例报告表","missing_source_classes":["CRF设计文档","电子数据采集系统验证报告","数据管理计划","安全性事件采集与报告SOP"],"proposal_text":"本研究采用电子病例报告表采集受试者数据。数据采集范围涵盖以下已确认研究要素：人口学信息与既往病史（含入组前12个月内心血管事件、近6个月骨抑制类药物使用史及eGFR水平）；干预给药记录（SLN-611 210 mg或匹配安慰剂每月一次皮下注射，共12个月双盲治疗期，以及全部受试者补钙加维生素D背景治疗的依从性记录）；影像学数据采集（腰椎及全髋BMD于基线、第6个月和第12个月采集，新发椎体骨折以影像学判读为终点依据）；骨转换标志物采集（P1NP与CTX于基线、第1个月、第3个月、第6个月和第12个月采集）；安全性数据采集（主要关注MACE类心血管事件、注射部位反应及低钙血症）。访视结构为筛选访视、随机访视及每月给药访视至第12个月。疗效评价采用治疗策略原则，以FAS和PPS评价疗效、安全性集评价安全性。","rationale":"已确认事实支持：访视策略明确BMD采集时点（基线、6、12个月）和骨转换标志物采集时点（基线、1、3、6、12个月）；主要终点为影像学判读新发椎体骨折及腰椎BMD百分比变化；安全性关注点为MACE、注射部位反应、低钙血症；统计分析策略明确FAS/PPS及安全性集。未确认事项：CRF具体表单设计、电子采集系统、各访视通用检查项目、安全性事件采集窗口与判定标准均无项目来源支持，不得由访视日推断。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_388c0a48c7e5b3fd","section_number":"10.1","source_ids":["protocol_full_draft_selection:bab9153e9b5b2c0cb2140658","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]},{"ai_run_id":"airun_20261006020000_d2478173","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取项目数据管理计划，明确源文件类型、采集层级及数据流路径","category":"source_missing","gap_id":"gap_data_source_definition","missing_source_classes":["数据管理计划","源文件类型清单","数据采集层级定义"],"target":"10.2节数据源类型与采集层级"}],"heading":"数据源的定义","missing_source_classes":["数据管理计划","源文件类型清单","数据采集层级定义","电子数据采集系统数据流图"],"proposal_text":"","rationale":"数据源定义章节需要明确本项目中各类数据的源文件类型（如影像学DICOM文件、实验室检验报告、心电图原始记录、给药记录单）、采集层级（源文件到CRF到数据库的转录或直采路径）、以及各数据项的原始记录载体。当前允许来源中，项目研究定义仅列出终点和访视时点，未定义数据源类型或采集层级；公司语料仅涉及数据抽查与稽查的监管共性结构，不包含数据源定义的项目事实。无法在不臆造的前提下形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_b631e58b11cfdaed","section_number":"10.2","source_ids":["protocol_full_draft_selection:bab9153e9b5b2c0cb2140658","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]},{"ai_run_id":"airun_20261006020000_d2478173","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"统计分析策略：FAS/PPS评价疗效，安全性集评价安全；分层检验控制I类错误；DMC监查。","quote_sha256":"e7d4508cdd23c10fdf8190e2cc015b96cb72e16655052f59ba27cf5340a552d5","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es2"},{"locator":"section:数据质量保证|block:932|chunk:1","quote":"研究中心质量保证人员对数据转移文件、统计报告数据进行抽查，保证数据准确无误。申办者根据需要，结合试验进展情况及质量控制人员/监查员的核查结果，可对上述临床研究过程产生的数据进行不同范畴的稽查。","quote_sha256":"84e30f7a8178b6ecebc4f6b8272c753029708f78a4aea8f02201d0abf4225b0b","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db","span_id":"es3"}],"evidence_review_advisories":[],"evidence_span_ids":["es2","es3"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":1},"gap_items":[{"action":"获取DMC章程及数据审查计划","category":"source_missing","gap_id":"gap_dmc_review_process","missing_source_classes":["DMC章程","DMC数据审查计划"],"target":"10.3节DMC数据审查流程与频率"},{"action":"获取项目监查计划及质量保证计划","category":"source_missing","gap_id":"gap_monitoring_frequency","missing_source_classes":["监查计划","质量保证计划"],"target":"10.3节监查频率与稽查触发条件"},{"action":"获取数据管理计划中的数据清理与质疑规则","category":"source_missing","gap_id":"gap_data_cleaning_rules","missing_source_classes":["数据管理计划"],"target":"10.3节数据清理规则"}],"heading":"数据质量保证","missing_source_classes":["数据管理计划","质量保证计划","DMC章程","监查计划"],"proposal_text":"本研究的数据质量保证体系依托独立数据安全监查委员会对研究数据进行定期审查，以保障受试者安全和数据完整性。疗效评价采用全分析集和符合方案集，安全性评价采用安全性分析集，分层检验控制I类错误。研究中心质量保证人员对数据转移文件及统计报告数据进行抽查，以保证数据准确无误。申办者根据研究进展情况及质量控制人员和监查员的核查结果，可对临床研究过程产生的数据进行不同范畴的稽查。","rationale":"已确认事实支持：项目研究定义明确DMC监查、FAS/PPS/安全性集分析策略及分层检验控制I类错误。公司语料（I期方案）提供数据抽查与稽查的监管共性结构表述，仅作章节结构参照，不构成本项目III期数据质量保证的具体实施规则。未确认事项：监查频率、稽查触发条件、DMC审查流程与频率、数据清理规则均无项目来源支持。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_c2a067e59fee6266","section_number":"10.3","source_ids":["protocol_full_draft_selection:bab9153e9b5b2c0cb2140658","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]},{"ai_run_id":"airun_20261006020000_d2478173","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"确认项目资料保存年限、保存地点及电子数据备份策略","category":"source_missing","gap_id":"gap_data_retention_period","missing_source_classes":["资料保存计划","数据管理计划"],"target":"10.4节资料保存年限与保存地点"},{"action":"确认加密方式、访问权限控制、数据跨境传输合规路径","category":"source_missing","gap_id":"gap_data_protection_measures","missing_source_classes":["数据保护影响评估","信息安全方案"],"target":"10.4节数据保护技术措施"},{"action":"确认受试者查阅、更正、删除个人数据的响应流程与时限","category":"source_missing","gap_id":"gap_subject_data_rights","missing_source_classes":["受试者数据权利响应SOP"],"target":"10.4节受试者数据权利响应机制"}],"heading":"资料保存与数据保护","missing_source_classes":["数据保护影响评估","资料保存计划","数据跨境传输合规评估","受试者数据权利响应SOP"],"proposal_text":"","rationale":"资料保存与数据保护章节需要明确本项目中研究资料的保存年限与保存地点、电子数据的备份与恢复策略、受试者个人信息的保护技术措施（加密方式、访问权限控制）、数据跨境传输的合规路径、受试者数据权利响应机制，以及研究结束后资料移交或销毁的安排。当前允许来源中，项目研究定义未涉及资料保存年限、数据保护技术措施或跨境传输规则；公司语料仅涉及数据抽查与稽查，不包含资料保存或数据保护的项目事实。无法在不臆造的前提下形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_ae188f73ca130ab8","section_number":"10.4","source_ids":["protocol_full_draft_selection:bab9153e9b5b2c0cb2140658","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]}],"source_bindings":[{"content_sha256":"a47be2b0d9d5e9faa1d861159a418df0bee50b88c396a537c39ddda5c3a2061d","locator":"document:mwdoc_greenfield_proj_user_d5ebc58f4bba_e54ab29f43100c76:full-draft:bab9153e9b5b2c0cb2140658","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:bab9153e9b5b2c0cb2140658","source_type":"protocol_full_draft_selection","source_version":"full-draft:d4bcfda355db92494e1792b8a712f5912f5c5f0842d8a34c2adf2dcffe0add9e:bab9153e9b5b2c0cb2140658","text_sha256":"a47be2b0d9d5e9faa1d861159a418df0bee50b88c396a537c39ddda5c3a2061d"},{"content_sha256":"01acde550034c139002b127618cadca82a0894fdead88903d47425241f006b8c","locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","source_type":"current_project_study_definition","source_version":"mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","text_sha256":"01acde550034c139002b127618cadca82a0894fdead88903d47425241f006b8c"},{"content_sha256":"84e30f7a8178b6ecebc4f6b8272c753029708f78a4aea8f02201d0abf4225b0b","locator":"section:数据质量保证|block:932|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db","source_type":"c