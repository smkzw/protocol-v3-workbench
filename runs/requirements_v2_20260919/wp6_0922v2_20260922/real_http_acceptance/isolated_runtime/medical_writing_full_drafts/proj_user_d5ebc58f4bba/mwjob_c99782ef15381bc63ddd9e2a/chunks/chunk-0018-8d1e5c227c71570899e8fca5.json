9a75297ced2326ab733fa3b16934acdef641fa765dd50c1cd58219f4aa5","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_dmc"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"产品安全性关注点：心血管事件监察（MACE类）；注射部位反应；低钙血症；该类药既往有心血管安全性信号","quote_sha256":"27215b3a2dc040e9e0b7e9c4d5a35185ca49ca96d58473361e8a538fd20c7aa3","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_safety_concerns"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"治疗策略（treatment policy）下评价12个月新发椎体骨折及腰椎BMD变化。","quote_sha256":"a680592bcdcab92749f85979c9fd807d322150b7a132363554676bee8a3b7f5c","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_treatment_policy"},{"locator":"section:8 统计学考虑|block:1056|chunk:1","quote":"有效性评价、安全性评价、PK 评价、PD 评价、免疫原性评价以及其他分析将在本研究的统计分析计划（SAP）中详细规定，数据库锁定前将最终确定 SAP。","quote_sha256":"a635fe9c51c78cbc66090c3553c488cd453e807e61608a97e0767740d5088a03","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","span_id":"es_sap_wording"}],"evidence_review_advisories":[],"evidence_span_ids":["es_safety_endpoints","es_safety_set","es_dmc","es_safety_concerns","es_treatment_policy","es_sap_wording"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":5},"gap_items":[{"action":"补充项目级安全性事件定义与报告操作文件","category":"source_missing","gap_id":"gap_safety_ae_definition","missing_source_classes":["AE/SAE/SUSAR定义与报告时限项目文件"],"target":"安全性数据分析章节中AE/SAE分级标准、报告时限及SUSAR处理流程"},{"action":"确认是否设置独立心血管事件裁定委员会及其操作规范","category":"source_missing","gap_id":"gap_mace_adjudication","missing_source_classes":["MACE adjudication操作规范"],"target":"MACE事件adjudication流程与委员会组成"}],"heading":"安全性数据分析","missing_source_classes":["AE/SAE/SUSAR定义与报告时限项目文件","MACE adjudication操作规范","注射部位反应分级工具说明","低钙血症实验室监测方案"],"proposal_text":"安全性数据分析以安全性分析集为评价人群，该集包含至少接受一次研究药物或安慰剂给药的全部随机化受试者。安全性评价涵盖以下重点关注领域：主要不良心血管事件（MACE）的监察与汇总分析，注射部位反应的发生率与严重程度分布，以及低钙血症的实验室监测与临床事件报告。鉴于硬骨抑素单抗类药物既往存在心血管安全性信号，MACE相关事件的收集、分类与汇总分析将作为安全性评价的核心模块。安全性数据的分析将在治疗策略（treatment policy）框架下进行，即无论受试者是否完成全部计划给药或是否因任何原因退出研究，其安全性数据均纳入分析。安全性评价的具体统计方法、不良事件按系统器官分类和首选术语的汇总方式、实验室检查异常值的判定标准、以及严重不良事件与可疑非预期严重不良反应的识别与报告流程，将在统计分析计划中详细规定，并于数据库锁定前最终确定。独立数据安全监查委员会将对研究期间累积的安全性数据进行定期审阅，以评估受试者安全风险并就是否继续、修改或终止研究提出建议。","rationale":"安全性终点（MACE、注射部位反应、低钙血症）、安全性集定义、DMC监查安排及treatment policy策略均来自当前项目已确认研究事实。SAP作为分析细则载体的表述参照公司语料中同分期方案的监管章节结构。需医学经理确认：MACE adjudication流程、注射部位反应分级工具、低钙血症监测频率、AE/SAE报告时限及SUSAR处理路径。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_d5eed99e8b629a96","section_number":"9.5","source_ids":["protocol_full_draft_selection:8d1e5c227c71570899e8fca5","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","company_corpus:cms_cn_protocol_corpus_20260715_v1:df51ff33eb77d6","company_corpus:cms_cn_protocol_corpus_20260715_v1:df064f51d3d147","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5acd10ce8e436","company_corpus:cms_cn_protocol_corpus_20260715_v1:7450f8d809500d"]},{"ai_run_id":"airun_20261006015643_14b06d7e","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取SLN-611的PK特征资料（IB、既往I/II期研究数据或PK/PD建模报告），确认PK采样设计、分析方法及PK-PD关联策略","category":"source_missing","gap_id":"gap_pk_no_data","missing_source_classes":["SLN-611 PK特征描述（IB或既往研究资料）","PK采样时间点与分析方法","PK-PD关联分析策略"],"target":"PK数据分析章节全部正文"}],"heading":"PK数据分析","missing_source_classes":["SLN-611 PK特征描述（IB或既往研究资料）","PK采样时间点与分析方法","PK-PD关联分析策略","免疫原性评价方案"],"proposal_text":"","rationale":"当前项目研究事实明确标注'PK特征本轮未提供'，缺少SLN-611的PK采样时间点、分析方法（非房室模型或群体PK）、PK参数集、PK-PD关联分析策略及免疫原性评价方案等核心来源。公司语料中PK评价措辞来自青少年AD项目（不同适应症、不同药物），仅可作为章节结构参照，不得迁移其具体PK设计事实。在缺少本项目PK研究方案或IB中PK章节的情况下，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_1687ac7ab4f2436f","section_number":"9.6","source_ids":["protocol_full_draft_selection:8d1e5c227c71570899e8fca5","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","company_corpus:cms_cn_protocol_corpus_20260715_v1:df51ff33eb77d6","company_corpus:cms_cn_protocol_corpus_20260715_v1:df064f51d3d147","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5acd10ce8e436","company_corpus:cms_cn_protocol_corpus_20260715_v1:7450f8d809500d"]},{"ai_run_id":"airun_20261006015643_14b06d7e","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"以骨转换标志物P1NP/CTX作为药效学监测指标（次要终点）","quote_sha256":"97af7d79163a9df724dd252b9210ae25caea5d530f15715f577340ae28c14555","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_pd_markers"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"骨转换标志物于基线、1、3、6、12个月。","quote_sha256":"626a57226e9b2634bce2e89628c77c8aa09ff9307b8c2c03bc628adb74850363","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_pd_timepoints"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"药效学：中和硬骨抑素产生促骨形成与抑制骨吸收的双向骨代谢效应","quote_sha256":"b0ab7bf6689cfec3b8f3e21e4a63afeff95d81d087840503234344a1387602d9","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_pd_mechanism"},{"locator":"section:8 统计学考虑|block:1056|chunk:1","quote":"有效性评价、安全性评价、PK 评价、PD 评价、免疫原性评价以及其他分析将在本研究的统计分析计划（SAP）中详细规定，数据库锁定前将最终确定 SAP。","quote_sha256":"a635fe9c51c78cbc66090c3553c488cd453e807e61608a97e0767740d5088a03","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","span_id":"es_sap_wording"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"FAS/PPS评价疗效，安全性集评价安全；分层检验控制I类错误；DMC监查。","quote_sha256":"6f374396b1c2715514dab3ee6181e4e8633e8447bcf8d5194e6358ea3e5dce8d","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_safety_set"}],"evidence_review_advisories":[],"evidence_span_ids":["es_pd_markers","es_pd_timepoints","es_pd_mechanism","es_sap_wording","es_safety_set"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":4},"gap_items":[{"action":"确认P1NP/CTX检测试剂盒、中心实验室及批间质控方案","category":"source_missing","gap_id":"gap_pd_assay","missing_source_classes":["P1NP/CTX检测试剂盒及实验室标准化方案"],"target":"PD数据分析章节中骨转换标志物检测方法与实验室标准化"},{"action":"确认是否设置PD-影像学终点关联分析及其统计方法","category":"source_missing","gap_id":"gap_pd_imaging_linkage","missing_source_classes":["PD与影像学终点关联分析策略"],"target":"PD数据分析章节中骨转换标志物与椎体骨折/BMD的关联分析"}],"heading":"PD数据分析","missing_source_classes":["P1NP/CTX检测试剂盒及实验室标准化方案","PD与影像学终点关联分析策略","免疫原性对骨代谢影响的评价方案"],"proposal_text":"药效学数据分析以骨转换标志物血清I型前胶原氨基端前肽（P1NP）和血清I型胶原C端肽（CTX）为核心监测指标，用于评价SLN-611中和硬骨抑素后产生的促骨形成与抑制骨吸收双向骨代谢效应。P1NP和CTX的采集时间点为基线、第1个月、第3个月、第6个月和第12个月。药效学分析将描述各时间点P1NP和CTX的绝对值及较基线变化，比较SLN-611组与安慰剂组间骨转换标志物水平的组间差异。药效学数据同时作为次要终点纳入疗效评价，其分析在FAS和PPS中进行。药效学分析的具体统计方法、骨转换标志物检测的实验室标准化要求、以及药效学指标与影像学终点（椎体骨折、BMD）之间的关联分析策略，将在统计分析计划中详细规定，并于数据库锁定前最终确定。","rationale":"P1NP/CTX作为PD监测指标、采集时间点（基线、1、3、6、12个月）、双向骨代谢效应描述及FAS/PPS分析集均来源于当前项目已确认研究事实。SAP措辞参照公司语料中同分期方案的监管章节结构。需医学经理确认：P1NP/CTX检测试剂盒及实验室标准化方案、PD分析是否需纳入免疫原性对骨代谢的影响、PD与影像学终点的关联分析是否纳入主要分析或探索性分析。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_93f2fe2070957ba5","section_number":"9.7","source_ids":["protocol_full_draft_selection:8d1e5c227c71570899e8fca5","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","company_corpus:cms_cn_protocol_corpus_20260715_v1:df51ff33eb77d6","company_corpus:cms_cn_protocol_corpus_20260715_v1:df064f51d3d147","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5acd10ce8e436","company_corpus:cms_cn_protocol_corpus_20260715_v1:7450f8d809500d"]},{"ai_run_id":"airun_20261006015643_14b06d7e","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:7.3.7 严重不良事件一致性比对|block:1049|chunk:1","quote":"EDC 中 SAE 关键数据点应与安全性数据库进行一致性比对。","quote_sha256":"89137f59a7a4b6b574df06af2472181735de0125de055f6939636b33ffcf7e2c","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:df51ff33eb77d6","span_id":"es_edc_sae"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"筛选、随机及每月给药访视至12个月；BMD于基线、6、12个月；骨转换标志物于基线、1、3、6、12个月。","quote_sha256":"733474da7f59731435f87c38a2b7042f7ccf5f2be816b3d72f270d0747694db8","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_visit_strategy"},{"locator":"section:8 统计学考虑|block:1056|chunk:1","quote":"有效性评价、安全性评价、PK 评价、PD 评价、免疫原性评价以及其他分析将在本研究的统计分析计划（SAP）中详细规定，数据库锁定前将最终确定 SAP。","quote_sha256":"a635fe9c51c78cbc66090c3553c488cd453e807e61608a97e0767740d5088a03","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","span_id":"es_sap_wording"}],"evidence_review_advisories":[],"evidence_span_ids":["es_edc_sae","es_visit_strategy","es_sap_wording"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":1},"gap_items":[{"action":"确认本项目EDC系统选型、数据核查频率及逻辑核查规则","category":"source_missing","gap_id":"gap_edc_system","missing_source_classes":["本项目EDC系统选型与功能配置","数据核查频率与规则"],"target":"数据采集与管理章节中EDC系统具体配置与核查规则"},{"action":"确认源数据验证比例、核查范围及监查频率","category":"source_missing","gap_id":"gap_sdv_strategy","missing_source_classes":["源数据验证策略"],"target":"数据采集与管理章节中源数据验证策略"},{"action":"确认数据锁定触发条件、审批流程及数据库解锁规范","category":"source_missing","gap_id":"gap_data_lock","missing_source_classes":["数据锁定与CRF设计流程"],"target":"数据采集与管理章节中数据锁定与解锁流程"}],"heading":"数据采集与管理","missing_source_classes":["本项目EDC系统选型与功能配置","数据核查频率与规则","源数据验证策略","数据锁定与CRF设计流程"],"proposal_text":"本研究采用电子数据采集系统进行全部临床数据的录入、核查与管理。数据采集范围涵盖受试者筛选与入组信息、人口学及疾病基线资料、研究药物给药记录、不良事件与合并用药、实验室检查结果、影像学检查（椎体X线及DXA骨密度）以及各访视时间点的评估数据。严重不良事件的关键数据点将在电子数据采集系统中录入，并与安全性数据库进行一致性比对，以确保安全性信息的完整性和准确性。数据管理流程包括数据录入、逻辑核查、质疑管理与关闭、数据锁定及数据库解锁的规范操作。数据采集与管理的具体操作规程、电子数据采集系统的功能配置、数据核查频率与规则、源数据验证策略以及数据锁定的触发条件与审批流程，将在数据管理计划中详细规定。","rationale":"EDC中SAE关键数据点与安全性数据库一致性比对的要求参照公司语料中同分期方案的监管章节结构。数据采集范围（影像学、骨转换标志物、给药记录等）依据当前项目已确认的访视策略和终点设计。需医学经理确认：本项目EDC系统选型、数据核查频率、源数据验证比例、数据锁定流程及CRF设计。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_c615cedb69b7395b","section_number":"10","source_ids":["protocol_full_draft_selection:8d1e5c227c71570899e8fca5","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","company_corpus:cms_cn_protocol_corpus_20260715_v1:df51ff33eb77d6","company_corpus:cms_cn_protocol_corpus_20260715_v1:df064f51d3d147","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5acd10ce8e436","company_corpus:cms_cn_protocol_corpus_20260715_v1:7450f8d809500d"]}],"source_bindings":[{"content_sha256":"800a6d4163df85598ee0467d1d84f590711fc918147efa98bf1acafb101c44cc","locator":"document:mwdoc_greenfield_proj_user_d5ebc58f4bba_e54ab29f43100c76:full-draft:8d1e5c227c71570899e8fca5","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:8d1e5c227c71570899e8fca5","source_type":"protocol_full_draft_selection","source_version":"full-draft:d4bcfda355db92494e1792b8a712f5912f5c5f0842d8a34c2adf2dcffe0add9e:8d1e5c227c71570899e8fca5","text_sha256":"800a6d4163df85598ee0467d1d84f590711fc918147efa98bf1acafb101c44cc"},