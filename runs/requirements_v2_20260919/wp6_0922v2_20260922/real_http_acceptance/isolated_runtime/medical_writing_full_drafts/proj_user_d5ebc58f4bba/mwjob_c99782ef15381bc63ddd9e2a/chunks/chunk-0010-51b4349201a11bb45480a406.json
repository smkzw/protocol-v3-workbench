下注射，12个月双盲治疗期；全部受试者补钙+维生素D。","quote_sha256":"72ba25b8bb9da83b8b5de05ac95a0b7dcafa3150d248aa0daac20748ce1ffa05","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es003"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"随机化方式：1:1随机，按中心分层；双盲；全部受试者补钙+维生素D背景治疗。","quote_sha256":"1e2525c9ccc1191eef1713b72b9ce4466d41783ca44f6fb529eb04edb44be034","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es004"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"估计目标策略：治疗策略（treatment policy）下评价12个月新发椎体骨折及腰椎BMD变化。","quote_sha256":"04ecaae76b2308023b4bd5f0e91b2eb135fbe627160522f13728cc41bb9f8ef3","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es005"}],"evidence_review_advisories":[],"evidence_span_ids":["es001","es002","es003","es004","es005"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"补充各访视日具体评估项目清单及允许时间窗","category":"source_missing","gap_id":"gap_7_1_01","missing_source_classes":["访视评估项目清单"],"target":"7.1节各访视日评估项目组合及时间窗"},{"action":"确认治疗策略估计目标下受试者退出后是否继续随访及随访内容","category":"source_missing","gap_id":"gap_7_1_02","missing_source_classes":["估计目标实施细则"],"target":"7.1节治疗策略下退出后随访安排"}],"heading":"研究程序","missing_source_classes":["各访视日评估项目清单","筛选期时长及筛选评估项目","计划外访视实施规则","治疗策略下退出后随访方案"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂对照III期临床研究，研究时期包括筛选期和12个月双盲治疗期。受试者经筛选合格后进入随机化，按1:1比例随机分配至SLN-611 210mg每月一次皮下注射组或匹配安慰剂每月一次皮下注射组，随机化按中心分层，采用双盲设计。全部受试者在研究期间接受钙剂加维生素D背景治疗。治疗期访视安排为筛选访视、随机访视及此后每月一次给药访视，持续至第12个月。骨密度检测于基线、第6个月和第12个月进行；骨转换标志物P1NP和CTX于基线、第1个月、第3个月、第6个月和第12个月采集。疗效评价采用治疗策略估计目标，在12个月时评价新发椎体骨折发生率及腰椎骨密度较基线百分比变化。安全性监测重点关注主要不良心血管事件、注射部位反应及低钙血症。","rationale":"研究时期、访视策略、干预方案、随机化方式、估计目标策略及安全性关注点均来源于当前项目已确认研究事实。各访视日具体评估项目组合、筛选期时长、计划外访视规则及治疗策略下退出后随访安排尚未在项目来源中逐项明确，需医学经理补充确认后方可定稿。","review_advisories":["本节提及高影响设计信息（估计目标）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_a8564ded26827220","section_number":"7.1","source_ids":["protocol_full_draft_selection:51b4349201a11bb45480a406","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54"]},{"ai_run_id":"airun_20261006013202_7ac50260","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"研究时期：筛选期、12个月双盲治疗期（III期确证）。","quote_sha256":"4cd8dd81a434445bfa05d24da70f9dfd4cd0f614ad137e6bf9ebe311acd46089","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es001"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"访视策略：筛选、随机及每月给药访视至12个月；BMD于基线、6、12个月；骨转换标志物于基线、1、3、6、12个月。","quote_sha256":"263892173e743acc3ddd0ab62c4d9222d68b0b37b46d49ca79ee253a43ff407f","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es002"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"目标研究人群：55–90岁、绝经≥1年、腰椎或全髋BMD T值≤−2.5（无椎体骨折史，或仅1处轻度）；主要排除：入组前12个月内心梗/卒中/冠脉重建等心血管事件、eGFR<35、近6个月用过骨抑制类药物","quote_sha256":"8153aa0f7026257b2f920a80817dfd48bb37a0f4b5ec36feccea0c6f99526921","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es006"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"排除标准模块：eGFR<35 mL/min/1.73m2；两处及以上骨折或重度椎体骨折","quote_sha256":"50275c3b3c64ee0fb15f61ba1b251b0783b0baf47bbcb8493c0684a98a0199fd","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es007"}],"evidence_review_advisories":[],"evidence_span_ids":["es001","es002","es006","es007"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"确认筛选期允许天数及筛选评估完成时限","category":"source_missing","gap_id":"gap_7_1_1_01","missing_source_classes":["筛选期操作规范"],"target":"7.1.1节筛选期时长"},{"action":"补充筛选期需完成的实验室检查、影像学、体格检查等具体项目","category":"source_missing","gap_id":"gap_7_1_1_02","missing_source_classes":["访视评估项目清单"],"target":"7.1.1节筛选期评估项目清单"},{"action":"确认是否允许筛选失败后重新筛选及间隔要求","category":"source_missing","gap_id":"gap_7_1_1_03","missing_source_classes":["筛选失败与重新筛选规则"],"target":"7.1.1节筛选失败与重新筛选"}],"heading":"筛选期与基线","missing_source_classes":["筛选期时长","筛选期评估项目完整清单","筛选失败与重新筛选规则"],"proposal_text":"筛选期用于确认受试者是否符合本研究的入选与排除标准。目标人群为55至90岁绝经后女性，绝经时间不少于1年，腰椎或全髋骨密度T值不高于负2.5，无椎体骨折史或仅有1处轻度椎体骨折。主要排除条件包括：入组前12个月内发生过心肌梗死、卒中或冠脉重建等心血管事件；估算肾小球滤过率低于35 mL/min/1.73m2；近6个月内使用过骨抑制类药物；存在两处及以上骨折或重度椎体骨折。筛选期访视中需完成骨密度检测以确认基线腰椎及全髋骨密度，并采集基线骨转换标志物P1NP和CTX。受试者签署知情同意书后方可进行筛选期评估。筛选期具体时长、各评估项目的完成时限、筛选失败后是否允许重新筛选及重新筛选的间隔要求，需依据项目实施方案进一步确定。","rationale":"目标人群年龄范围、绝经年限、骨密度阈值、排除标准中的心血管事件时限、eGFR阈值、骨抑制类药物洗脱期及骨折排除条件均来源于当前项目已确认研究事实。筛选期时长、筛选期评估项目完整清单及筛选失败后重新筛选规则未在项目来源中给出，需补充项目实施方案或操作手册后完善。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_152ff0af3fe758b4","section_number":"7.1.1","source_ids":["protocol_full_draft_selection:51b4349201a11bb45480a406","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54"]},{"ai_run_id":"airun_20261006013202_7ac50260","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"访视策略：筛选、随机及每月给药访视至12个月；BMD于基线、6、12个月；骨转换标志物于基线、1、3、6、12个月。","quote_sha256":"263892173e743acc3ddd0ab62c4d9222d68b0b37b46d49ca79ee253a43ff407f","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es002"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"试验干预：SLN-611（硬骨抑素单抗）210mg每月一次皮下注射，12个月双盲治疗期；全部受试者补钙+维生素D。","quote_sha256":"72ba25b8bb9da83b8b5de05ac95a0b7dcafa3150d248aa0daac20748ce1ffa05","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es003"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"随机化方式：1:1随机，按中心分层；双盲；全部受试者补钙+维生素D背景治疗。","quote_sha256":"1e2525c9ccc1191eef1713b72b9ce4466d41783ca44f6fb529eb04edb44be034","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es004"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"估计目标策略：治疗策略（treatment policy）下评价12个月新发椎体骨折及腰椎BMD变化。","quote_sha256":"04ecaae76b2308023b4bd5f0e91b2eb135fbe627160522f13728cc41bb9f8ef3","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es005"}],"evidence_review_advisories":[],"evidence_span_ids":["es002","es003","es004","es005"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"补充每次给药访视需完成的评估项目（生命体征、注射部位检查、依从性核查等）","category":"source_missing","gap_id":"gap_7_1_2_01","missing_source_classes":["访视评估项目清单"],"target":"7.1.2节各给药访视日评估项目组合"},{"action":"确认治疗策略估计目标下受试者提前退出后是否继续随访至12个月及随访内容","category":"source_missing","gap_id":"gap_7_1_2_02","missing_source_classes":["估计目标实施细则"],"target":"7.1.2节治疗策略下退出后随访"}],"heading":"治疗期及随访","missing_source_classes":["各给药访视日评估项目清单","治疗策略下退出后随访方案","注射部位反应评估方法"],"proposal_text":"治疗期为12个月双盲治疗期。受试者按1:1随机分配后，试验组接受SLN-611 210mg每月一次皮下注射，对照组接受匹配安慰剂每月一次皮下注射，两组均同时接受钙剂加维生素D背景治疗。治疗期访视安排为随机访视及此后每月一次给药访视，持续至第12个月。骨密度检测于基线、第6个月和第12个月进行，用于评价腰椎及全髋骨密度变化。骨转换标志物P1NP和CTX于基线、第1个月、第3个月、第6个月和第12个月采集，作为药效学监测指标。疗效评价采用治疗策略估计目标，在12个月时评价新发椎体骨折发生率及腰椎骨密度较基线百分比变化。安全性监测重点关注主要不良心血管事件、注射部位反应及低钙血症。","rationale":"治疗期时长、给药方案、访视策略、BMD及骨转换标志物采集时点、估计目标策略和安全性关注点均来源于当前项目已确认研究事实。各给药访视日是否均包含生命体征、注射部位检查、依从性核查等评估项目未逐项列出，治疗策略下受试者提前退出后的随访安排亦未明确，需医学经理确认。","review_advisories":["本节提及高影响设计信息（估计目标）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_58e5291f662722cb","section_number":"7.1.2","source_ids":["protocol_full_draft_selection:51b4349201a11bb45480a406","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54"]},{"ai_run_id":"airun_20261006013202_7ac50260","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"补充计划外访视的触发情形、需完成的评估项目、与计划访视的衔接方式","category":"source_missing","gap_id":"gap_7_1_3_01","missing_source_classes":["计划外访视实施规则"],"target":"7.1.3节计划外访视触发条件与评估内容"}],"heading":"计划外访视","missing_source_classes":["计划外访视实施规则","访视评估项目清单"],"proposal_text":"","rationale":"当前项目来源仅给出访视策略为筛选、随机及每月给药访视至12个月，未提供计划外访视的触发条件、评估内容、与计划访视的衔接规则、是否影响后续计划访视安排等实施细节。计划外访视属于研究实施规则，缺少对应项目文件时不得以通用原则或条件句替代。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_6646ae3da1b9ff77","section_number":"7.1.3","source_ids":["protocol_full_draft_selection:51b4349201a11bb45480a406","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54"]}],"source_bindings":[{"content_sha256":"cecc2bcab78063e604f9aca74bb8cb0d8ed77d89b33f241445e693d3ff9a859a","locator":"document:mwdoc_greenfield_proj_user_d5ebc58f4bba_e54ab29f43100c76:full-draft:51b4349201a11bb45480a406","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:51b4349201a11bb45480a406","source_type":"protocol_full_draft_selection","source_version":"full-draft:d4bcfda355db92494e1792b8a712f5912f5c5f0842d8a34c2adf2dcffe0add9e:51b4349201a11bb45480a406","text_sha256":"cecc2bcab78063e604f9aca74bb8cb0d8ed77d89b33f241445e693d3ff9a859a"},{"content_sha256":"01acde550034c139002b127618cadca82a0894fdead88903d47425241f006b8c","locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","role":"confirmed_project_facts","source