dence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取或起草项目级妊娠事件报告与随访规程，明确妊娠报告时限与对象、女性受试者妊娠后处理、伴侣妊娠报告要求、避孕方法、妊娠检查日程、新生儿随访方案","category":"source_missing","gap_id":"gap_88_01","missing_source_classes":["项目级妊娠事件报告与随访规程"],"target":"8.8节全文"}],"heading":"妊娠事件的报告与随访","missing_source_classes":["项目级妊娠事件报告与随访规程","避孕方法要求","妊娠检查日程","伴侣妊娠报告流程"],"proposal_text":"","rationale":"本章节需要项目级妊娠事件报告与随访规程。公司语料中妊娠报告流程（24小时报告、退出研究、随访至妊娠结局或新生儿出生后三个月）来自青少年AD 3期方案和I期方案，适应症、分期、药物机制均与本项目不同。按语料泛化规则，跨适应症来源仅可用于章节结构和监管共性条款参照，不得迁移避孕方法、伴侣妊娠报告、新生儿随访时限或妊娠检查日程等项目实施规则。项目研究定义中排除标准提及绝经后女性（55-90岁），但未提供妊娠报告与随访的项目级规程。","review_advisories":["本节复述高影响研究设计（妊娠事件的报告与随访）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_81f6e951f119c649","section_number":"8.8","source_ids":["protocol_full_draft_selection:03a5406895072060e885e192","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:152c1e08c78e76","company_corpus:cms_cn_protocol_corpus_20260715_v1:30fd7cd8503aae","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976"]},{"ai_run_id":"airun_20261006015137_8b6d6d62","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"统计分析策略：FAS/PPS评价疗效，安全性集评价安全；分层检验控制I类错误；DMC监查。","quote_sha256":"e7d4508cdd23c10fdf8190e2cc015b96cb72e16655052f59ba27cf5340a552d5","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_004"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"估计目标策略：治疗策略（treatment policy）下评价12个月新发椎体骨折及腰椎BMD变化。","quote_sha256":"04ecaae76b2308023b4bd5f0e91b2eb135fbe627160522f13728cc41bb9f8ef3","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_005"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"主要终点：复合主要终点：12个月新发椎体骨折；12个月腰椎BMD相对基线百分比变化。","quote_sha256":"dbfa88595fa4814b9bffcef4f52ed771e00655a917ba26a14e678d699f0410d8","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_006"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"关键次要终点：非椎体骨折、临床骨折、全髋/股骨颈BMD、P1NP、CTX。","quote_sha256":"b9df4adebb6512805eaaee793d2ff42fc3544ee265d8968194a133410d42a739","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_007"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"安全性终点：MACE、注射部位反应、低钙血症。","quote_sha256":"c38602080b87e31c57fb54c3b609aa01140e1f487c5dfc02da9729c1d284b322","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_008"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"随机化方式：1:1随机，按中心分层；双盲；全部受试者补钙+维生素D背景治疗。","quote_sha256":"1e2525c9ccc1191eef1713b72b9ce4466d41783ca44f6fb529eb04edb44be034","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_009"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"样本量策略：按12个月新发椎体骨折及腰椎BMD双重主要终点估算，1:1分配，考虑脱落。","quote_sha256":"9214544c4c6a6f38104109cb21b5aba406a93abd5150d987b5c6621740ac7706","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_010"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004","es_005","es_006","es_007","es_008","es_009","es_010"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":7},"gap_items":[{"action":"确认椎体骨折终点采用的统计模型（如logistic回归或Cox模型）、BMD终点采用的模型（如ANCOVA或线性混合模型）、双重主要终点的多重性控制策略","category":"source_missing","gap_id":"gap_9_01","missing_source_classes":["具体统计模型与多重性调整方法"],"target":"9节统计模型与多重性调整"},{"action":"确认缺失数据处理策略（如多重插补、LOCF或其他方法）及敏感性分析计划","category":"source_missing","gap_id":"gap_9_02","missing_source_classes":["缺失数据处理策略"],"target":"9节缺失数据处理"},{"action":"确认是否设置预设亚组分析及其分层因素","category":"source_missing","gap_id":"gap_9_03","missing_source_classes":["亚组分析计划"],"target":"9节亚组分析"},{"action":"确认DMC章程中安全性监查频率、触发标准及期中分析安排","category":"source_missing","gap_id":"gap_9_04","missing_source_classes":["DMC章程"],"target":"9节DMC监查"}],"heading":"统计分析","missing_source_classes":["具体统计模型与多重性调整方法","缺失数据处理策略","亚组分析计划","DMC章程"],"proposal_text":"本研究采用治疗策略（treatment policy）估计目标，在12个月双盲治疗期内评价12个月新发椎体骨折发生率及腰椎BMD相对基线百分比变化。疗效分析基于全分析集（FAS）和符合方案集（PPS）进行；安全性分析基于安全性分析集。主要疗效终点为复合主要终点，包括12个月新发椎体骨折（影像学判读）和12个月腰椎BMD相对基线百分比变化；关键次要终点包括非椎体骨折、临床骨折、全髋及股骨颈BMD、P1NP和CTX。随机化采用1:1分配，按中心分层。统计分析中采用分层检验控制I类错误。安全性终点包括MACE、注射部位反应和低钙血症。本研究设置独立数据安全监查委员会（DMC）进行安全性监查。","rationale":"项目研究定义已确认：治疗策略估计目标、FAS/PPS疗效评价、安全性集评价安全、分层检验控制I类错误、DMC监查、复合主要终点（椎体骨折+BMD）、关键次要终点（非椎体骨折、临床骨折、全髋/股骨颈BMD、P1NP、CTX）、安全性终点（MACE、注射部位反应、低钙血症）、1:1随机按中心分层。但具体统计模型（椎体骨折的回归模型类型、BMD的ANCOVA或混合模型）、多重性调整策略、缺失数据处理方法、亚组分析计划、DMC章程细节等未在项目来源中给出，需医学经理与统计师确认。","review_advisories":["本节复述高影响研究设计（统计分析）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、估计目标）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_8b87615237b502e4","section_number":"9","source_ids":["protocol_full_draft_selection:03a5406895072060e885e192","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:152c1e08c78e76","company_corpus:cms_cn_protocol_corpus_20260715_v1:30fd7cd8503aae","company_corpus:cms_cn_protocol