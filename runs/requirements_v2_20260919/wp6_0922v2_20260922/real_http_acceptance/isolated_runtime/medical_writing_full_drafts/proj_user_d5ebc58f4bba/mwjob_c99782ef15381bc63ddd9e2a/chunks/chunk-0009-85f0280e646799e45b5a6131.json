1914e067a1c25813125511f7a3b565b71c979c0a27bfcba7d89","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_safety_concerns"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"PK特征本轮未提供","quote_sha256":"29285f2fc2904bb8e0c8926060a0274a46e8f3f91b871d091700919ede64ac55","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_pk_gap"},{"locator":"document:mwdoc_greenfield_proj_user_d5ebc58f4bba_e54ab29f43100c76:full-draft:85f0280e646799e45b5a6131","quote":"当前正文=（当前为空，需生成实质正文）","quote_sha256":"d4f6c00478fea4ab2473939d37eb0a133f508d43a8b0a1e5356af486741ffce2","source_id":"protocol_full_draft_selection:85f0280e646799e45b5a6131","span_id":"es_section_empty"}],"evidence_review_advisories":[],"evidence_span_ids":["es_bg_therapy","es_exclusion_drug","es_safety_concerns","es_pk_gap","es_section_empty"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"待IB及非临床资料提供后，由医学负责人确定具体禁限用药类别及药物相互作用结论","category":"source_missing","gap_id":"gap_66_concomitant_list","missing_source_classes":["研究者手册（IB）","非临床安全性与药代动力学资料"],"target":"6.6节合并用药允许与禁止清单"},{"action":"待项目合并用药管理规则文件提供后补充","category":"source_missing","gap_id":"gap_66_rescue","missing_source_classes":["项目合并用药管理规则文件"],"target":"6.6节救援治疗与合并用药管理规则"},{"action":"待PK特征及药物相互作用研究数据提供后补充","category":"source_missing","gap_id":"gap_66_pk_interaction","missing_source_classes":["药代动力学资料","药物相互作用研究数据"],"target":"6.6节药物相互作用评估"}],"heading":"合并用药/治疗","missing_source_classes":["研究者手册（IB）","非临床安全性与药代动力学资料","项目合并用药管理规则文件","药物相互作用研究数据"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂对照III期临床研究，试验组接受SLN-611（硬骨抑素单抗）210mg每月一次皮下注射，对照组接受匹配安慰剂每月一次皮下注射，双盲治疗期共12个月。全部受试者在研究期间接受钙剂加维生素D背景治疗。入组前6个月内使用过骨抑制类药物的受试者不得入组，提示研究期间应避免使用骨抗吸收类药物。SLN-611为皮下注射单克隆抗体，其药代动力学特征资料尚不完整，与合并用药之间的潜在相互作用需依据研究者手册及非临床资料进一步阐明。本章节涵盖研究期间允许与禁止的合并用药及治疗类别、合并用药的记录与报告要求、以及合并用药对疗效和安全性评价的影响处理原则。","rationale":"已确认事实支持：全部受试者补钙加维生素D背景治疗；入组前6个月骨抑制类药物为排除标准；产品安全性关注点包括MACE、注射部位反应和低钙血症；PK特征资料尚不完整。需医学负责人确认：具体禁限用药清单、药物相互作用评估结论、合并用药记录与报告流程、救援治疗方案。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_2414a709e168ea4c","section_number":"6.6","source_ids":["protocol_full_draft_selection:85f0280e646799e45b5a6131","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54"]},{"ai_run_id":"airun_20261006012737_447ecd04","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"全部受试者补钙+维生素D","quote_sha256":"b426158c1c599db6b4f61fdcb137b495865ca9596cd6263916fdf1e62d1d5b55","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_bg_therapy"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"PK特征本轮未提供","quote_sha256":"29285f2fc2904bb8e0c8926060a0274a46e8f3f91b871d091700919ede64ac55","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_pk_gap"},{"locator":"document:mwdoc_greenfield_proj_user_d5ebc58f4bba_e54ab29f43100c76:full-draft:85f0280e646799e45b5a6131","quote":"当前正文=（当前为空，需生成实质正文）","quote_sha256":"d4f6c00478fea4ab2473939d37eb0a133f508d43a8b0a1e5356af486741ffce2","source_id":"protocol_full_draft_selection:85f0280e646799e45b5a6131","span_id":"es_section_empty"}],"evidence_review_advisories":[],"evidence_span_ids":["es_bg_therapy","es_pk_gap","es_section_empty"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"待IB及项目合并用药管理规则文件提供后，由医学负责人确定允许合并用药的类别、药物及剂量限制","category":"source_missing","gap_id":"gap_661_allowed_list","missing_source_classes":["研究者手册（IB）","项目合并用药管理规则文件"],"target":"6.6.1节允许的合并用药具体清单"},{"action":"待PK特征及药物相互作用研究数据提供后补充","category":"source_missing","gap_id":"gap_661_pk_basis","missing_source_classes":["药代动力学资料","药物相互作用研究数据"],"target":"6.6.1节药物相互作用评估依据"}],"heading":"允许的合并用药/治疗","missing_source_classes":["研究者手册（IB）","非临床安全性与药代动力学资料","项目合并用药管理规则文件"],"proposal_text":"本研究全部受试者在12个月双盲治疗期间接受钙剂加维生素D背景治疗，该背景治疗作为骨质疏松症基础支持治疗，在试验组和对照组中均予实施，不视为合并用药。除上述背景治疗外，研究期间其他合并用药的允许范围、具体药物类别及剂量限制，需依据研究者手册中SLN-611的药代动力学特征、药物相互作用数据及非临床安全性资料确定。SLN-611为皮下注射硬骨抑素单克隆抗体，其全身暴露特征与口服小分子药物存在差异，与合并用药之间的相互作用风险评估需以完整非临床及临床药理学资料为依据。","rationale":"已确认事实支持：全部受试者补钙加维生素D背景治疗；SLN-611为皮下注射单抗、全身暴露；PK特征资料尚不完整。需医学负责人确认：除钙剂加维生素D外，是否允许其他骨质疏松辅助治疗、心血管合并用药、镇痛药等；需IB提供药物相互作用数据以界定允许范围。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_7adc7882e16149dc","section_number":"6.6.1","source_ids":["protocol_full_draft_selection:85f0280e646799e45b5a6131","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54"]},{"ai_run_id":"airun_20261006012737_447ecd04","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"近6个月用过骨抑制类药物","quote_sha256":"c54da072d0ab1dcd54f3320c564444b92c0f4cab4c7213546cac04f3348fb207","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_exclusion_drug"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"心血管事件监察（MACE类）；注射部位反应；低钙血症；该类药既往有心血管安全性信号","quote_sha256":"1f1d0063cd3041914e067a1c25813125511f7a3b565b71c979c0a27bfcba7d89","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_safety_concerns"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"入组前12个月内心梗/卒中/冠脉重建等心血管事件","quote_sha256":"d249ec78f7bb0c2b4fdce97309105b2f027ab9d2c493bbaf6575370287e11f7c","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_exclusion_cardio"},{"locator":"document:mwdoc_greenfield_proj_user_d5ebc58f4bba_e54ab29f43100c76:full-draft:85f0280e646799e45b5a6131","quote":"当前正文=（当前为空，需生成实质正文）","quote_sha256":"d4f6c00478fea4ab2473939d37eb0a133f508d43a8b0a1e5356af486741ffce2","source_id":"protocol_full_draft_selection:85f0280e646799e45b5a6131","span_id":"es_section_empty"}],"evidence_review_advisories":[],"evidence_span_ids":["es_exclusion_drug","es_safety_concerns","es_exclusion_cardio","es_section_empty"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"待IB及项目合并用药管理规则文件提供后，由医学负责人确定禁止用药的完整类别与品种","category":"source_missing","gap_id":"gap_662_prohibited_list","missing_source_classes":["研究者手册（IB）","项目合并用药管理规则文件"],"target":"6.6.2节禁止的合并用药完整清单"},{"action":"待IB非临床及临床安全性数据提供后，由医学负责人确定是否限制特定心血管药物","category":"source_missing","gap_id":"gap_662_cardio_drugs","missing_source_classes":["研究者手册（IB）","非临床安全性资料"],"target":"6.6.2节心血管相关合并用药限制"},{"action":"待项目合并用药管理规则文件提供后补充","category":"source_missing","gap_id":"gap_662_washout","missing_source_classes":["项目合并用药管理规则文件"],"target":"6.6.2节禁止用药的洗脱期要求"}],"heading":"禁止的合并用药/治疗","missing_source_classes":["研究者手册（IB）","非临床安全性资料","项目合并用药管理规则文件"],"proposal_text":"入组前6个月内使用过骨抑制类药物的受试者不得入组本研究，据此，研究期间禁止使用骨抗吸收类药物（包括但不限于双膦酸盐类、地舒单抗、降钙素等），以避免对主要终点腰椎BMD变化及新发椎体骨折发生率产生干扰。鉴于SLN-611的药理作用为中和硬骨抑素、产生促骨形成与抑制骨吸收的双向骨代谢效应，研究期间使用其他影响骨代谢的药物可能干扰药效学终点（P1NP、CTX）的解读。此外，产品安全性关注点提示该类硬骨抑素单抗既往存在心血管安全性信号，本研究的排除标准已将入组前12个月内心梗、卒中及冠脉重建等心血管事件列为主要排除条件，研究期间是否需限制特定心血管药物的使用，需结合研究者手册中的非临床及临床安全性数据进一步确定。","rationale":"已确认事实支持：入组前6个月骨抑制类药物为排除标准；SLN-611作用机制为中和硬骨抑素、双向促骨形成并抑制骨吸收；骨转换标志物P1NP/CTX为次要终点；产品安全性关注点包括MACE类心血管事件及该类药既往心血管安全性信号；排除标准含入组前12个月内心血管事件。需医学负责人确认：禁止合并用药的完整清单（是否涵盖所有抗骨吸收药及具体品种）、心血管药物限制的具体范围、禁止用药的洗脱期要求。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_76940a4bce8c49d4","section_number":"6.6.2","source_ids":["protocol_full_draft_selection:85f0280e646799e45b5a6131","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54"]},{"ai_run_id":"airun_20261006012737_447ecd04","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"研究时期：筛选期、12个月双盲治疗期（III期确证）","quote_sha256":"b5124c5fd7ff452ff89c5671a5a6aac269a4c9277ce52d046c8c0f5e6177a50a","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_study_periods"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"筛选、随机及每月给药访视至12个月","quote_sha256":"858a2c9e335d6fdfb4e7238f9bd4503ea6e17d9d8f0c375d419aee2e8677c5fa","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_visit_dosing"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"BMD于基线、6、12个月","quote_sha256":"105eba94695e387e63126ee5c37192d93ddadaee763c3b16a48a8ddbcea80be8","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_visit_bmd"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"骨转换标志物于基线、1、3、6、12个月","quote_sha256":"b26371f3d008989510b3ab6ecef14660f0fc0f05df4ce7f3ab956471e3f7cc74","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_visit_btm"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"DMC监查","quote_sha256":"ec4959a18bd7aecf1f64ba52caa564a27b9be5e7931a64aaf08153b47a44abce","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_dmc"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"FAS/PPS评价疗效，安全性集评价安全；分层检验控制I类错误；DMC监查","quote_sha256":"79c329b5bb7c24449f7141e3c52c9f71023bf0f1d2218536b11ae9e0cc22259b","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_stats"},{"locator":"document:mwdoc_greenfield_proj_user_d5ebc58f4bba_e54ab29f43100c76:full-draft:85f0280e646799e45b5a6131","quote":"当前正文=（当前为空，需生成实质正文）","quote_sha256":"d4f6c00478fea4ab2473939d37eb0a133f508d43a8b0a1e5356af486741ffce2","source_id":"protocol_full_draft_selection:85f0280e646799e45b5a6131","span_id":"es_section_empty"}],"evidence_review_advisories":[],"evidence_span_ids":["es_study_periods","es_visit_dosing","es_visit_bmd","es_visit_btm","es_dmc","es_stats","es_section_empty"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"待研究程序与评估项目文件及实验室检查方案提供后补充","category":"source_missing","gap_id":"gap_7_labs","missing_source_classes":["研究程序与评估项目文件","实验室检查方案"],"target":"7节各访视实验室检查项目与频率"},{"action":"待研究程序与评估项目文件提供后补充","category":"source_missing","gap_id":"gap_7_vitals_ecg","missing_source_classes":["研究程序与评估项目文件"],"target":"7节生命体征与心电图采集时点"},{"action":"待研究程序与评估项目文件提供后补充","category":"source_missing","gap_id":"gap_7_physical_exam","missing_source_classes":["研究程序与评估项目文件"],"target":"7节体格检查安排"},{"action":"待研究程序与评估项目文件提供后补充","category":"source_missing","gap_id":"gap_7_adherence","missing_source_classes":["研究程序与评估项目文件"],"target":"7节依从性评价方式"},{"action":"待安全性评估操作规程提供后补充","category":"source_missing","gap_id":"gap_7_safety_window","missing_source_classes":["安全性评估操作规程"],"target":"7节安全性评估窗口与不良事件采集规则"},{"action":"待影像学评估手册提供后补充","category":"source_missing","gap_id":"gap_7_imaging","missing_source_classes":["影像学评估手册"],"target":"7节椎体骨折影像学判读流程"}],"heading":"研究程序和评估","missing_source_classes":["研究程序与评估项目文件","实验室检查方案","安全性评估操作规程","影像学评估手册"],"proposal_text":"本研究包括筛选期和12个月双盲治疗期两个研究时期。访视安排为：筛选访视、随机访视，此后每月进行一次给药访视，持续至第12个月。骨密度（BMD）检测安排在基线、第6个月和第12个月进行，用于评价主要终点腰椎BMD较基线百分比变化及次要终点全髋和股骨颈BMD。骨转换标志物（P1NP和CTX）检测安排在基线、第1个月、第3个月、第6个月和第12个月进行，用于评价药效学及次要终点。主要疗效终点为12个月新发椎体骨折发生率（影像学判读）和12个月腰椎BMD较基线百分比变化；次要终点包括非椎体骨折、临床骨折、全髋及股骨颈BMD、P1NP和CTX；安全性终点包括主要不良心血管事件（MACE）、注射部位反应和低钙血症。疗效评价采用全分析集（FAS）和符合方案集（PPS），安全性评价采用安全性集，分层检验控制I类错误，由数据安全监查委员会（DMC）进行安全性监查。","rationale":"已确认事实支持：研究时期为筛选期和12个月双盲治疗期；访视策略为筛选、随机及每月给药访视至12个月；BMD于基线、6、12个月；骨转换标志物于基线、1、3、6、12个月；主要终点为12个月新发椎体骨折及腰椎BMD变化；次要终点含非椎体骨折、临床骨折、全髋/股骨颈BMD、P1NP、CTX；安全性终点含MACE、注射部位反应、低钙血症；统计策略为FAS/PPS评价疗效、安全性集评价安全、分层检验、DMC监查。需医学负责人确认：各访视的实验室检查项目与频率、生命体征与心电图采集时点、体格检查安排、依从性评价方式、安全性评估窗口、不良事件采集规则、椎体骨折影像学判读流程、注射部位反应评估方法。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_2620c92880dee0a8","section_number":"7","source_ids":["protocol_full_draft_selection:85f0280e646799e45b5a6131","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54"]}],"source_bindings":[{"content_sha256":"44c871b15b9e8478ea67e77a1e54408a266b1d82adbec56d6426508d01af2a51","locator":"document:mwdoc_greenfield_proj_user_d5ebc58f4bba_e54ab29f43100c76:full-draft:85f0280e646799e45b5a6131","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:85f0280e646799e45b5a6131","source_type":"protocol_full_draft_selection","source_version":"full-draft:d4bcfda355db92494e1792b8a712f5912f5c5f0842d8a34c2adf2dcffe0add9e:85f0280e646799e45b5a6131","text_sha256":"44c871b15b9e8478ea67e77a1e54408a266b1d82adbec56d6426508d01af2a51"},{"content_sha256":"01acde550034c139002b127618cadca82a0894fdead88903d47425241f006b8c","locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","source_type":"current_project_study_definition","source_version":"mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","text_sha256":"01acde550034c139002b127618cadca82a0894fdead88903d47425241f006b8c"}]}