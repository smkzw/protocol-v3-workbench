c17b90802e7352c6e81b5fdc853989b74ea1499901f514a4","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_no_interim"}],"evidence_review_advisories":[],"evidence_span_ids":["es_dmc_planned","es_safety_concerns","es_no_interim"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"获取DMC章程草案及安全性监查计划，确认MACE类事件监查频率与暂停阈值","category":"source_missing","gap_id":"gap_dmc_charter","missing_source_classes":["DMC章程","安全性监查计划"],"target":"4.5节DMC组成、会议频率、暂停建议触发条件"},{"action":"检索SLN-611或同类硬骨抑素单抗IB中既往临床心血管安全性章节","category":"source_not_retrieved","gap_id":"gap_ib_cardio","missing_source_classes":["研究者手册（IB）"],"target":"4.5节'该类药既往有心血管安全性信号'的具体数据来源与严重程度描述"}],"heading":"安全性审评/数据监查委员会","missing_source_classes":["DMC章程","研究者手册（IB）中既往同类药物心血管安全性数据","安全性监查计划（含MACE累积阈值定义）"],"proposal_text":"本研究设置独立数据监查委员会（DMC），由具备骨质疏松症、心血管医学及生物统计学背景的独立专家组成，负责在12个月双盲治疗期内对累积安全性数据进行定期审阅。鉴于SLN-611为皮下注射硬骨抑素单抗且该类药既往存在心血管安全性信号，DMC的监查重点包括主要不良心血管事件（MACE）的累积发生率、注射部位反应的发生频率与严重程度分级、以及低钙血症的发生与转归。本研究不计划期中分析，DMC的职能以持续性安全性监测为主，而非疗效终止判断；DMC依据预设的安全性监查计划对不良事件趋势进行审阅，当出现超出预期安全性特征的事件聚集或达到预设安全性关注阈值时，向申办方提出暂停或终止研究的建议。DMC的具体组成、会议频率、数据审阅范围、安全性暂停建议的触发条件及与申办方之间的沟通机制，由DMC章程另行规定。","rationale":"DMC设置已确认为本研究计划内容；安全性关注点（MACE、注射部位反应、低钙血症）及'该类药既往有心血管安全性信号'为已确认项目事实；期中分析不计划为已确认设计决定。DMC章程细节、会议频率、具体暂停阈值需项目文件及IB支持，当前来源未提供。","review_advisories":["本节提及高影响设计信息（期中分析）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_e51af7c0a08f9b60","section_number":"4.5","source_ids":["protocol_full_draft_selection:14c405c85a106ba2a16b2d53","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54"]},{"ai_run_id":"airun_20261006010817_8947013a","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"研究时期：筛选期、12个月双盲治疗期（III期确证）。","quote_sha256":"4cd8dd81a434445bfa05d24da70f9dfd4cd0f614ad137e6bf9ebe311acd46089","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_study_periods"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"访视策略：筛选、随机及每月给药访视至12个月；BMD于基线、6、12个月；骨转换标志物于基线、1、3、6、12个月。","quote_sha256":"263892173e743acc3ddd0ab62c4d9222d68b0b37b46d49ca79ee253a43ff407f","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_visit_strategy"}],"evidence_review_advisories":[],"evidence_span_ids":["es_study_periods","es_visit_strategy"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"确认是否存在治疗结束后独立随访期及其时长；确认研究整体结束判定标准","category":"source_missing","gap_id":"gap_post_treatment_followup","missing_source_classes":["研究设计补充文件","访视计划表"],"target":"4.6节研究结束后随访期及末次给药后观察窗"}],"heading":"研究结束与研究持续时间","missing_source_classes":["研究结束后随访期设计","末次给药后安全性观察窗定义"],"proposal_text":"本研究由筛选期和12个月双盲治疗期两个阶段组成，属III期确证性研究。筛选期用于完成知情同意、入选与排除标准核查、基线腰椎及全髋骨密度（BMD）检测、骨转换标志物（P1NP、CTX）基线采集及安全性基线评估。随机化后进入12个月双盲治疗期，受试者按每月一次皮下注射给药访视，直至完成第12个月末次给药及相应评估访视。BMD检测安排于基线、第6个月和第12个月；骨转换标志物采集安排于基线、第1个月、第3个月、第6个月和第12个月。研究整体结束以全部受试者完成12个月双盲治疗期末次访视为标志。","rationale":"研究时期（筛选期、12个月双盲治疗期）和访视策略（筛选、随机及每月给药访视至12个月；BMD于基线、6、12个月；骨转换标志物于基线、1、3、6、12个月）为已确认项目事实。研究结束后是否存在独立安全性随访期、末次给药后观察窗长度及研究整体结束判定标准未在允许来源中明确，需项目文件确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_e056fd6dfd1130b6","section_number":"4.6","source_ids":["protocol_full_draft_selection:14c405c85a106ba2a16b2d53","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54"]},{"ai_run_id":"airun_20261006010817_8947013a","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取项目级研究暂停和终止标准文件，明确MACE、注射部位反应、低钙血症等安全性关注点的暂停/终止触发阈值及决策流程","category":"source_missing","gap_id":"gap_stopping_criteria","missing_source_classes":["研究暂停和终止标准","DMC章程","安全性监查计划"],"target":"4.7节研究暂停和终止标准"}],"heading":"研究暂停和终止标准","missing_source_classes":["研究暂停和终止标准（项目级）","DMC章程中暂停/终止建议条款","安全性监查计划中预设阈值"],"proposal_text":"","rationale":"本研究不计划期中分析，DMC已确认设置，但允许来源中未提供研究暂停和终止的具体量化标准（如MACE累积发生率阈值、注射部位反应严重程度分级触发条件、低钙血症聚集性事件判定规则）及暂停/终止的决策权限与执行流程。缺少项目级暂停终止标准文件，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_8e8919757ea478e4","section_number":"4.7","source_ids":["protocol_full_draft_selection:14c405c85a106ba2a16b2d53","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54"]},{"ai_run_id":"airun_20261006010817_8947013a","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"55–90岁、绝经≥1年、腰椎或全髋BMD T值≤−2.5（无椎体骨折史，或仅1处轻度）","quote_sha256":"d1c3f02abb58583e9cce7bcac25196f02057b90836bb32a6cd91f7da1bc87c20","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_population"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"入组前12个月内心梗/卒中/冠脉重建等心血管事件、eGFR<35、近6个月用过骨抑制类药物","quote_sha256":"6bde2822b0caada0d34bb67261c914dd9e04181e7f8446ba69be40ee5ce72c5f","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_exclusions"}],"evidence_review_advisories":[],"evidence_span_ids":["es_population","es_exclusions"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"确认完整入选标准清单（含绝经确认方法、椎体骨折'轻度'影像学判定标准）及排除标准完整列表，消除'入选标准模块'与'排除标准模块'间的条目交叉","category":"source_missing","gap_id":"gap_inclusion_exclusion_full","missing_source_classes":["完整入选/排除标准清单","椎体骨折分级标准"],"target":"5节完整入选与排除标准条目"},{"action":"确认绝经≥1年的临床判定方法（如末次月经时间、FSH水平或临床评估）","category":"source_missing","gap_id":"gap_menopause_confirmation","missing_source_classes":["研究人群定义补充文件"],"target":"5节绝经状态确认方法"}],"heading":"研究人群","missing_source_classes":["完整入选标准清单","完整排除标准清单","绝经状态确认方法","椎体骨折'轻度'判定标准"],"proposal_text":"本研究目标人群为55至90岁绝经后女性，绝经时间不少于1年。入选受试者须满足腰椎或全髋骨密度T值≤−2.5，且无椎体骨折史或仅有1处轻度椎体骨折。主要排除条件包括：入组前12个月内发生过心肌梗死、卒中或冠脉重建等心血管事件；估算肾小球滤过率（eGFR）低于35 mL/min/1.73m²；入组前6个月内使用过骨抑制类药物；存在两处及以上骨折或重度椎体骨折。所有受试者须自愿签署知情同意书。全部入组受试者在研究期间接受钙剂联合维生素D背景治疗。","rationale":"目标人群年龄范围（55–90岁）、绝经年限（≥1年）、BMD T值阈值（≤−2.5）、椎体骨折限制（无或仅1处轻度）、主要排除条件（心血管事件12个月窗口、eGFR<35、骨抑制类药物6个月窗口、两处及以上骨折或重度椎体骨折）及背景治疗（钙剂+维生素D）均为已确认项目事实。'入选标准模块'中'近6个月使用骨抑制类药物'和'入组前12个月内心梗/卒中/冠脉重建等心血管事件'在语义上为排除条件，与'排除标准模块'存在条目交叉，最终纳入/排除条目归属及完整清单需医学经理确认。","review_advisories":["本节复述高影响研究设计（研究人群）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_508315fdd9822e13","section_number":"5","source_ids":["protocol_full_draft_selection:14c405c85a106ba2a16b2d53","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54"]}],"source_bindings":[{"content_sha256":"498442bffbb8daf57ccce8e3ca1ac52f86ea65d83529c0e5e22a39c52736cdf5","locator":"document:mwdoc_greenfield_proj_user_d5ebc58f4bba_e54ab29f43100c76:full-draft:14c405c85a106ba2a16b2d53","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:14c405c85a106ba2a16b2d53","source_type":"protocol_full_draft_selection","source_version":"full-draft:d4bcfda355db92494e1792b8a712f5912f5c5f0842d8a34c2adf2dcffe0add9e:14c405c85a106ba2a16b2d53","text_sha256":"498442bffbb8daf57ccce8e3ca1ac52f86ea65d83529c0e5e22a39c52736cdf5"},{"content_sha256":"01acde550034c139002b127618cadca82a0894fdead88903d47425241f006b8c","locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","source_type":"current_project_study_definition","source_version":"mwdef