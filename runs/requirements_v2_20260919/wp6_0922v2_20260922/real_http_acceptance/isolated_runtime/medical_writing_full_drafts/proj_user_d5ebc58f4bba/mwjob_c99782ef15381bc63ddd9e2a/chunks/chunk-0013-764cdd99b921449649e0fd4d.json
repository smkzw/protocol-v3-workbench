:"b0ab7bf6689cfec3b8f3e21e4a63afeff95d81d087840503234344a1387602d9","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_pd_mechanism"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"PK特征本轮未提供","quote_sha256":"29285f2fc2904bb8e0c8926060a0274a46e8f3f91b871d091700919ede64ac55","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_pk_not_provided"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"次要终点：非椎体骨折；临床骨折；全髋/股骨颈BMD；骨转换标志物（P1NP/CTX）","quote_sha256":"5604f257c8b099dbabcfeaa53052f44554e3542ff4a197c941ea46570d82d30e","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_secondary_endpoints"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"12个月双盲治疗期（III期确证）","quote_sha256":"fb28cde8a9703d245f4b1bb8751f45c672010a681e31c70faadce076de096ae9","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_treatment_period"}],"evidence_review_advisories":[],"evidence_span_ids":["es_pd_markers","es_pd_timepoints","es_pd_mechanism","es_pk_not_provided","es_secondary_endpoints","es_treatment_period"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"待PK特征资料提供后补充PK采样时点、PK/PD建模方法","category":"source_missing","gap_id":"gap_pd_pk","missing_source_classes":["药代动力学研究方案","PK/PD建模分析计划"],"target":"药效动力学评估章节中PK/PD关联分析部分"},{"action":"检索P1NP/CTX检测试剂盒方法学验证资料及中心实验室操作规范","category":"source_not_retrieved","gap_id":"gap_pd_assay","missing_source_classes":["中心实验室检测方法学验证文件"],"target":"药效动力学评估章节中检测方法描述"}],"heading":"药效动力学评估","missing_source_classes":["药代动力学/药效动力学关联研究方案","骨转换标志物检测方法学验证文件"],"proposal_text":"SLN-611为皮下注射硬骨抑素单克隆抗体，通过中和循环中硬骨抑素发挥促骨形成与抑制骨吸收的双向骨代谢调节作用。本研究以血清骨转换标志物I型前胶原氨基端前肽（P1NP）和I型胶原C端肽（CTX）作为药效动力学监测指标，用于反映药物对骨形成和骨吸收的调节效应。P1NP和CTX的采集时点为基线、第1个月、第3个月、第6个月和第12个月，与每月给药访视安排相衔接。骨转换标志物同时作为本研究的次要终点，用于评价SLN-611对骨代谢的干预效果。药效动力学数据的分析将结合治疗策略（treatment policy）进行，在FAS和PPS中评价P1NP和CTX较基线的变化。本研究未设置独立的药效动力学终点作为主要疗效判定依据，P1NP和CTX的疗效意义以次要终点形式呈现。","rationale":"药效动力学监测指标（P1NP/CTX）及采集时点（基线、1、3、6、12个月）来源于当前项目已确认研究事实中的访视策略和次要终点定义；双向骨代谢效应描述来源于药理/PD考虑条目。PK特征本轮未提供，PK/PD关联分析设计待后续补充。骨转换标志物作为次要终点的统计检验层级和多重性控制策略需医学经理与统计团队确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_576a0bb4b1b6376c","section_number":"7.5","source_ids":["protocol_full_draft_selection:764cdd99b921449649e0fd4d","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54"]},{"ai_run_id":"airun_20261006013955_d947e35e","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"药物技术类型：monoclonal_antibody","quote_sha256":"2d005aca90d5db3d74b97d639e59141880b99d35c55f04793932888f17ca8efa","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_drug_type"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"给药途径：皮下注射（SC）","quote_sha256":"a3fb47cdb6a0668507244b6b90a0c30448a788608ba33d9e6fd03b39c3b7f4bd","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_route"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"以骨转换标志物P1NP/CTX作为药效学监测指标（次要终点）","quote_sha256":"97af7d79163a9df724dd252b9210ae25caea5d530f15715f577340ae28c14555","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_pd_markers"}],"evidence_review_advisories":[],"evidence_span_ids":["es_drug_type","es_route","es_pd_markers"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"待免疫原性采样时点设计确定后补充具体访视日安排","category":"source_missing","gap_id":"gap_immune_timepoints","missing_source_classes":["免疫原性采样时点设计依据"],"target":"免疫原性评估章节中采样时点描述"},{"action":"待方法学验证完成后补充ADA筛查、确认及NAb检测方法","category":"source_missing","gap_id":"gap_immune_method","missing_source_classes":["免疫原性检测方法学验证报告"],"target":"免疫原性评估章节中检测方法描述"}],"heading":"免疫原性评估","missing_source_classes":["免疫原性检测方法学验证报告","抗药抗体及中和抗体检测操作规程","免疫原性采样时点设计依据"],"proposal_text":"SLN-611为皮下注射用单克隆抗体，给药途径为皮下注射，具有系统性暴露特征。鉴于试验药物为生物制品且经皮下途径反复给药，本研究将开展免疫原性评估，以检测受试者体内是否产生抗药抗体（anti-drug antibody, ADA）及中和抗体（neutralizing antibody, NAb）。免疫原性评估的目的包括：描述ADA和NAb的发生率、滴度及持续时间；评价免疫原性对药物药代动力学特征、药效动力学指标（P1NP/CTX）及安全性特征（包括注射部位反应）的潜在影响；为药物长期安全性评价提供支持性证据。免疫原性样本的采集时点、检测方法（包括筛查、确认及中和抗体确认试验）、阳性判定阈值及结果判读标准依据方法学验证结果确定，具体参数详见中心实验室操作手册。","rationale":"药物技术类型为单克隆抗体、给药途径为皮下注射、系统性暴露范围等信息来源于当前项目已确认研究事实。免疫原性评估的必要性由药物类型和给药途径支持。但允许来源中未提供免疫原性采样的具体时点、检测方法、阳性判定标准或中和抗体确认流程，上述内容需方法学验证完成后确定。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_90985dd2f444620b","section_number":"7.6","source_ids":["protocol_full_draft_selection:764cdd99b921449649e0fd4d","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54"]},{"ai_run_id":"airun_20261006013955_d947e35e","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"骨转换标志物于基线、1、3、6、12个月","quote_sha256":"b26371f3d008989510b3ab6ecef14660f0fc0f05df4ce7f3ab956471e3f7cc74","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_pd_timepoints"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"BMD于基线、6、12个月","quote_sha256":"105eba94695e387e63126ee5c37192d93ddadaee763c3b16a48a8ddbcea80be8","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_bmd_timepoints"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"全部受试者补钙+维生素D背景治疗","quote_sha256":"cd293264f226718bd74f70e7c7d63773ad8b1ea989f351f51fa2d3e7826fb177","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_background_therapy"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"筛选、随机及每月给药访视至12个月；BMD于基线、6、12个月；骨转换标志物于基线、1、3、6、12个月","quote_sha256":"14a3d4efbbd11998be73c126ed74c421aaf71517fd998d44f7831c219af8cba2","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_visit_strategy"}],"evidence_review_advisories":[],"evidence_span_ids":["es_pd_timepoints","es_bmd_timepoints","es_background_therapy","es_visit_strategy"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"待中心实验室操作手册定稿后补充管型、抗凝剂、离心条件、运输及保存温度","category":"source_missing","gap_id":"gap_bio_sample_ops","missing_source_classes":["中心实验室操作手册","生物样本管理规程"],"target":"生物样本采集、处置与保存章节中具体操作参数"},{"action":"待伦理批件及生物样本管理规程确定后补充样本保存期限及销毁条件","category":"source_missing","gap_id":"gap_bio_sample_destruction","missing_source_classes":["生物样本管理规程","伦理批件"],"target":"生物样本采集、处置与保存章节中样本销毁条款"}],"heading":"生物样本采集、处置与保存","missing_source_classes":["中心实验室操作手册","生物样本采集与处理操作规程","生物样本运输与保存条件规范"],"proposal_text":"本研究在12个月双盲治疗期内，于各访视时点采集生物样本用于药效动力学评估、免疫原性评估及安全性评价。药效动力学相关样本（P1NP、CTX）的采集时点为基线、第1个月、第3个月、第6个月和第12个月。骨密度（BMD）检测于基线、第6个月和第12个月进行，作为影像学评估而非生物样本采集。全部受试者在研究期间接受钙剂联合维生素D背景治疗，相关依从性记录与生物样本采集同步进行。生物样本的采集管型、抗凝剂选择、离心条件、运输温度、保存温度及保存期限等具体操作规程详见中心实验室操作手册。样本的采集、处理、运输、接收、储存及销毁流程须遵循中心实验室操作手册及申办方生物样本管理规程。","rationale":"生物样本采集时点（骨转换标志物基线、1、3、6、12个月；BMD基线、6、12个月）来源于当前项目已确认研究事实中的访视策略。背景治疗（补钙+维生素D）来源于已确认研究事实。但允许来源未提供具体管型、抗凝剂、离心条件、运输及保存温度等实验室操作细节，上述内容需中心实验室操作手册支持。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_29c0904fd1e071dd","section_number":"7.7","source_ids":["protocol_full_draft_selection:764cdd99b921449649e0fd4d","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54"]},{"ai_run_id":"airun_20261006013955_d947e35e","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"安全性终点：MACE、注射部位反应、低钙血症","quote_sha256":"562e83b95c565d558b894771bab13690d3d64c279f5d8ddb28135e441906d05e","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_safety_endpoints"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"心血管事件监察（MACE类）；注射部位反应；低钙血症；该类药既往有心血管安全性信号","quote_sha256":"1f1d0063cd3041914e067a1c25813125511f7a3b565b71c979c0a27bfcba7d89","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_cardio_concern"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"入组前12个月内心梗/卒中/冠脉重建等心血管事件为主要排除标准","quote_sha256":"a79796810193f6e4af4a651fee382d01263ca790557ec09f3beaf7d495701e9f","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_cardio_exclusion"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"DMC是否计划：是","quote_sha256":"9967a9a75297ced2326ab733fa3b16934acdef641fa765dd50c1cd58219f4aa5","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_dmc"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"12个月双盲治疗期（III期确证）","quote_sha256":"fb28cde8a9703d245f4b1bb8751f45c672010a681e31c70faadce076de096ae9","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_treatment_period"}],"evidence_review_advisories":[],"evidence_span_ids":["es_safety_endpoints","es_cardio_concern","es_cardio_exclusion","es_dmc","es_treatment_period"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"待AE/SAE/SUSAR定义及报告规程确定后补充具体定义、分级标准、报告时限及报告对象","category":"source_missing","gap_id":"gap_ae_definition","missing_source_classes":["AE/SAE/SUSAR定义与报告规程"],"target":"安全性评价章节中AE/SAE/SUSAR定义与报告"},{"action":"待MACE裁定流程确定后补充独立裁定委员会设置、裁定标准及流程","category":"source_missing","gap_id":"gap_mace_adjudication","missing_source_classes":["MACE独立裁定委员会章程"],"target":"安全性评价章节中MACE监察实施方法"},{"action":"待低钙血症监测方案确定后补充监测频率、干预阈值及处理流程","category":"source_missing","gap_id":"gap_hypocalcemia_protocol","missing_source_classes":["低钙血症监测与干预方案"],"target":"安全性评价章节中低钙血症监测与干预"},{"action":"待DMC章程确定后补充会议频率、安全性数据审阅范围及暂停/终止标准","category":"source_missing","gap_id":"gap_dmc_frequency","missing_source_classes":["DMC章程"],"target":"安全性评价章节中DMC监查安排"}],"heading":"安全性评价","missing_source_classes":["AE/SAE/SUSAR定义与报告规程","MACE独立裁定委员会章程","低钙血症监测与干预方案","DMC章程及会议频率安排"],"proposal_text":"本研究的安全性评价涵盖主要关注的安全性终点和一般不良事件监测。主要安全性关注点包括：主要心血管不良事件（MACE）的监察，鉴于硬骨抑素单抗类药物既往存在心血管安全性信号，且入组前12个月内心梗、卒中或冠脉重建等心血管事件为本研究主要排除标准；注射部位反应，与皮下注射给药途径相关；低钙血症，与骨代谢调节机制相关。安全性评估在12个月双盲治疗期内持续进行，由独立数据安全监查委员会（DMC）对累积安全性数据进行定期监查。安全性数据的分析基于安全性分析集，在FAS和PPS中同步评价疗效相关安全性指标。本研究未设置独立的期中安全性分析，安全性信息的定期审阅通过DMC会议完成。","rationale":"安全性终点（MACE、注射部位反应、低钙血症）及心血管安全性关注点来源于当前项目已确认研究事实中的产品安全性关注点和安全性终点条目。DMC设置来源于已确认研究事实。心血管事件排除标准来源于排除标准模块。但允许来源未提供AE/SAE/SUSAR的具体定义、报告时限、分级标准、MACE裁定流程、低钙血症干预阈值及DMC会议频率等实施细节。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_072becb3da90d3c4","section_number":"8","source_ids":["protocol_full_draft_selection:764cdd99b921449649e0fd4d","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54"]}],"source_bindings":[{"content_sha256":"52f7666406d296734f1c719835498dbc90f23f35bc873d54ff4274936b28d924","locator":"document:mwdoc_greenfield_proj_user_d5ebc58f4bba_e54ab29f43100c76:full-draft:764cdd99b921449649e0fd4d","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:764cdd9