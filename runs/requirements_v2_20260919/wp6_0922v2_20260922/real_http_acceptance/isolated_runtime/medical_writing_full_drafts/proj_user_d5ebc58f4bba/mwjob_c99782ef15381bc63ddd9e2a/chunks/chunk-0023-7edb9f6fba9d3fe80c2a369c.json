_spans":0,"project_fact_spans":2},"gap_items":[{"action":"获取项目管理计划或角色职责矩阵","category":"source_missing","gap_id":"gap_125_01","missing_source_classes":["项目管理计划","角色职责矩阵"],"target":"各关键角色具体职责定义与汇报关系"},{"action":"获取DMC章程草案","category":"source_missing","gap_id":"gap_125_02","missing_source_classes":["DMC章程"],"target":"DMC章程、会议频率及数据监查报告流程"},{"action":"获取多中心管理SOP或协调中心职能说明","category":"source_missing","gap_id":"gap_125_03","missing_source_classes":["多中心管理SOP"],"target":"多中心协调机制与各中心PI管理职责"}],"heading":"关键角色和研究管理","missing_source_classes":["项目管理计划","DMC章程","研究中心管理SOP","CRO职能协议"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂对照III期临床研究，采用1:1随机分配并按中心分层，设置独立数据安全监查委员会对研究进行安全性监查。研究管理架构涵盖申办者、各参与研究中心主要研究者、研究协调员、独立统计团队及数据安全监查委员会等关键角色。申办者负责整体研究管理、方案执行监督、数据质量保证及与监管机构的沟通；各研究中心主要研究者对本中心受试者安全、方案依从性及数据真实性承担直接责任；独立统计团队负责按方案规定的分层检验策略控制I类错误并执行FAS与PPS疗效评价及安全性集分析；数据安全监查委员会依据其章程对累积安全性数据进行定期审阅，对研究继续、修改或终止提出建议。各角色的具体职责边界、汇报路径、会议频率及文件签署要求由项目管理计划及相应章程另行规定。","rationale":"已确认事实支持：多中心设计、1:1按中心分层随机、DMC存在、FAS/PPS及分层检验统计策略。各角色具体职责分工、DMC章程细节、CRO与申办者职能划分、研究中心管理SOP等实施细节缺少项目来源，需医学经理与项目管理团队确认后补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_0c30d102f736c3cf","section_number":"12.5","source_ids":["protocol_full_draft_selection:7edb9f6fba9d3fe80c2a369c","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]},{"ai_run_id":"airun_20261006024659_ea1d6669","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取研究中心关闭SOP或项目管理计划中关闭章节","category":"source_missing","gap_id":"gap_126_01","missing_source_classes":["研究中心关闭SOP"],"target":"研究中心关闭触发条件与程序步骤"},{"action":"获取药物管理SOP及文件归档清单","category":"source_missing","gap_id":"gap_126_02","missing_source_classes":["药物管理SOP","文件归档清单"],"target":"试验药物回收、销毁及文件归档要求"},{"action":"获取数据管理计划及统计分析报告计划","category":"source_missing","gap_id":"gap_126_03","missing_source_classes":["数据管理计划","SAP"],"target":"数据锁定、数据库关闭及最终统计报告流程"}],"heading":"研究和研究中心的关闭","missing_source_classes":["研究中心关闭SOP","文件归档与药物回收流程","数据锁定与数据库关闭程序","研究终止/提前关闭预案"],"proposal_text":"","rationale":"本章节需要描述研究整体关闭及单个研究中心关闭的触发条件、程序步骤、文件归档、药物回收、数据锁定及最终报告等实施规则。当前允许来源中无任何项目文件描述上述内容，公司语料中Phase I方案片段仅涉及数据质量保证抽查，不涉及中心关闭程序。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_62c86b677d029808","section_number":"12.6","source_ids":["protocol_full_draft_selection:7edb9f6fba9d3fe80c2a369c","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]},{"ai_run_id":"airun_20261006024659_ea1d6669","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:数据质量保证|block:932|chunk:1","quote":"研究中心质量保证人员对数据转移文件、统计报告数据进行抽查，保证数据准确无误。申办者根据需要，结合试验进展情况及质量控制人员/监查员的核查结果，可对上述临床研究过程产生的数据进行不同范畴的稽查。","quote_sha256":"84e30f7a8178b6ecebc4f6b8272c753029708f78a4aea8f02201d0abf4225b0b","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db","span_id":"es_qa_01"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"多中心、随机、双盲、安慰剂对照，两臂1:1（SLN-611 210mg qm SC / 匹配安慰剂），12个月双盲治疗期","quote_sha256":"97941ce7d3aef772477742c55024ab76111c59ec896dfc4da7cbbb0decd724eb","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_multicenter_01"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"DMC是否计划：是","quote_sha256":"9967a9a75297ced2326ab733fa3b16934acdef641fa765dd50c1cd58219f4aa5","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_dmc_01"}],"evidence_review_advisories":[],"evidence_span_ids":["es_qa_01","es_multicenter_01","es_dmc_01"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":2},"gap_items":[{"action":"获取项目质量保证计划","category":"source_missing","gap_id":"gap_127_01","missing_source_classes":["项目质量保证计划"],"target":"本项目QA/QC计划、监查频率及稽查触发条件"},{"action":"获取数据管理计划及SAP","category":"source_missing","gap_id":"gap_127_02","missing_source_classes":["数据管理计划","SAP"],"target":"数据核查范围、数据转移验证及统计报告审核流程"},{"action":"检索多中心管理SOP或协调中心质控文件","category":"source_not_retrieved","gap_id":"gap_127_03","missing_source_classes":["多中心管理SOP"],"target":"多中心间质量一致性核查及协调中心质控职能"}],"heading":"质量控制与保证","missing_source_classes":["项目质量保证计划","监查计划","稽查SOP","数据管理计划"],"proposal_text":"本研究的质量控制与保证体系覆盖数据质量保证和临床研究过程稽查两个层面。在数据质量保证方面，研究中心质量保证人员对数据转移文件及统计报告数据进行抽查，以保证数据准确无误；申办者根据研究进展情况及质量控制人员与监查员的核查结果，可对临床研究过程产生的数据进行不同范畴的稽查。本研究为多中心设计，各参与中心均须接受申办者或其委托方的常规监查与稽查；数据安全监查委员会对累积安全性数据进行独立审阅，为研究继续或终止提供建议。具体监查频率、稽查触发条件、数据核查范围及质量保证报告流程由项目质量保证计划另行规定。","rationale":"已确认事实支持：多中心设计、DMC存在及安全性监查职能。公司语料（CMS-D017 Phase I方案）提供了研究中心QA抽查数据转移文件及申办者稽查的监管共性结构描述，本章节借用该结构框架，未迁移该Phase I方案的具体药物、人群或剂量信息。本项目QA/QC计划、监查频率、稽查触发条件及数据质量保证具体流程缺少项目来源，需医学经理与质量部门确认后补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_e5a147a0ffb1bd22","section_number":"12.7","source_ids":["protocol_full_draft_selection:7edb9f6fba9d3fe80c2a369c","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]},{"ai_run_id":"airun_20261006024659_ea1d6669","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取项目知情同意书草案","category":"source_missing","gap_id":"gap_14_01","missing_source_classes":["知情同意书模板"],"target":"知情同意书模板及受试者招募材料"},{"action":"获取中心实验室手册或方案附件","category":"source_missing","gap_id":"gap_14_02","missing_source_classes":["中心实验室手册"],"target":"实验室检查正常值范围及采集操作规范"},{"action":"获取项目合并用药管理文件","category":"source_missing","gap_id":"gap_14_03","missing_source_classes":["合并用药清单"],"target":"合并用药及禁限用药清单"},{"action":"获取eCRF设计文档及访视计划表","category":"source_missing","gap_id":"gap_14_04","missing_source_classes":["CRF示例","访视流程图"],"target":"CRF示例及访视流程图"}],"heading":"附录","missing_source_classes":["知情同意书模板","实验室正常值范围","合并用药及禁限用药清单","CRF示例"],"proposal_text":"","rationale":"附录章节通常包含知情同意书模板、实验室检查正常值范围、合并用药及禁限用药清单、CRF示例、访视流程图、量表授权文件等。当前允许来源中无任何项目文件提供上述附录内容，研究定义中虽提及BMD、P1NP/CTX等检查项目但未给出正常值范围或采集操作规范，公司语料片段亦不涉及附录材料。整章无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_bef54521e05b46f0","section_number":"14","source_ids":["protocol_full_draft_selection:7edb9f6fba9d3fe80c2a369c","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]}],"source_bindings":[{"content_sha256":"365e38eb701252b3c57c62f8af9e79164cfe05d4b3f8a9813f12818abaaea52e","locator":"document:mwdoc_greenfield_proj_user_d5ebc58f4bba_e54ab29f43100c76:full-draft:7edb9f6fba9d3fe80c2a369c","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:7edb9f6fba9d3fe80c2a369c","source_type":"protocol_full_draft_selection","source_version":"full-draft:d4bcfda355db92494e1792b8a712f5912f5c5f0842d8a34c2adf2dcffe0add9e:7edb9f6fba9d3fe80c2a369c","text_sha256":"365e38eb701252b3c57c62f8af9e79164cfe05d4b3f8a9813f12818abaaea52e"},{"content_sha256":"01acde550034c139002b127618cadca82a0894fdead88903d47425241f006b8c","locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","source_type":"current_project_study_definition","source_version":"mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","text_sha256":"01acde550034c139002b127618cadca