s:cms_cn_protocol_corpus_20260715_v1:4e86a5ea954c95","span_id":"es_004"}],"evidence_review_advisories":[],"evidence_span_ids":["es_001","es_003","es_004"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":1},"gap_items":[{"action":"补充本项目各参与中心伦理委员会清单及主审/分审协调方案","category":"source_missing","gap_id":"gap_ec_001","missing_source_classes":["项目伦理审查机构清单及递交计划","多中心伦理协调机制文件"],"target":"伦理委员会章节中各中心伦理审查机构名称、主审与分审安排"},{"action":"补充DMC章程及向伦理委员会通报程序","category":"source_missing","gap_id":"gap_ec_002","missing_source_classes":["DMC章程及向伦理委员会报告程序"],"target":"伦理委员会章节中DMC向伦理委员会报告安全信号的频率、内容与格式"},{"action":"确认各中心伦理委员会对持续审查周期的具体要求","category":"source_missing","gap_id":"gap_ec_003","missing_source_classes":["伦理委员会持续审查频率要求"],"target":"伦理委员会章节中持续审查频率及年度跟踪审查要求"}],"heading":"伦理委员会","missing_source_classes":["项目伦理审查机构清单及递交计划","多中心伦理协调机制文件","DMC章程及向伦理委员会报告程序","伦理委员会持续审查频率要求"],"proposal_text":"本研究为在中国开展的多中心、随机、双盲、安慰剂对照III期临床研究，各参与中心在启动任何研究相关活动之前，须获得本中心伦理委员会的书面批准。研究方案、知情同意书、受试者招募材料及其他需伦理审查的文件，应在首次受试者入组前提交伦理委员会审查并取得批准函。研究过程中，方案修正、严重不良事件、可能影响受试者安全或研究完整性的新信息，应按伦理委员会要求的时限和方式报告。伦理委员会有权因安全性、监管或其他原因要求终止研究或要求受试者退出研究。本研究设置独立数据监查委员会，对累积安全性数据进行定期审查，数据监查委员会的审查结论及建议将按既定程序向伦理委员会通报。各中心伦理委员会的审查批件、年度跟踪审查记录及任何附加条件，由研究者保存于研究中心备查。","rationale":"已确认事实支持：本研究为III期、中国开发区域、多中心设计、DMC已计划。公司语料中伦理委员会终止权及受试者退出权条款来自青少年AD和炎症性皮肤病方案，仅作为监管共性结构参照，未迁移其项目事实。缺少本项目具体伦理审查机构清单、递交与批准流程、持续审查频率、多中心主审与分审协调机制、DMC向伦理委员会报告的具体频率与内容格式。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_1aab2f18c05cdbbc","section_number":"11.3","source_ids":["protocol_full_draft_selection:9ded8e4d3d31d5e77dfc51ef","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:2db65207908661","company_corpus:cms_cn_protocol_corpus_20260715_v1:72548c417a8f5c","company_corpus:cms_cn_protocol_corpus_20260715_v1:4e86a5ea954c95","company_corpus:cms_cn_protocol_corpus_20260715_v1:df064f51d3d147","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67"]},{"ai_run_id":"airun_20261006024054_72f27f62","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:文档开头|block:4|chunk:1","quote":"本方案中所包含的所有信息归申办方所有，因此，仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构进行审阅。在未得到申办方书面批准的情况下，除了在与可能参加本研究的受试者签署知情同意书时，向其做必要的解释外，严禁将任何信息告知与本研究无关的第三方。","quote_sha256":"dfc9fceb41db9d941df0e3715483adaa069da4f1953600a6a37a56d7f81373dd","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","span_id":"es_005"}],"evidence_review_advisories":[],"evidence_span_ids":["es_005"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":0},"gap_items":[{"action":"确认本项目是否涉及跨境数据传输及人类遗传资源出境，补充相应合规安排","category":"source_missing","gap_id":"gap_privacy_001","missing_source_classes":["数据保护影响评估文件","跨境数据传输合规方案"],"target":"保密与隐私章节中受试者个人健康信息保护的具体合规路径"},{"action":"补充生物样本管理方案及实验室合规要求","category":"source_missing","gap_id":"gap_privacy_002","missing_source_classes":["生物样本存储与销毁政策"],"target":"保密与隐私章节中生物样本（骨转换标志物P1NP/CTX等）的存储、传输与销毁安排"},{"action":"确认EDC、IWRS等系统的验证状态及数据安全措施","category":"source_missing","gap_id":"gap_privacy_003","missing_source_classes":["电子数据采集系统验证与合规认证"],"target":"保密与隐私章节中电子数据采集与管理系统的安全与合规描述"}],"heading":"保密与隐私","missing_source_classes":["数据保护影响评估文件","跨境数据传输合规方案","生物样本存储与销毁政策","电子数据采集系统验证与合规认证"],"proposal_text":"本研究方案及其附件中包含的所有信息归申办方所有，仅供研究者、合作研究者、伦理委员会和监督管理部门等相关机构为审阅和研究实施目的使用。在未获得申办方书面批准的情况下，除在知情同意过程中向潜在受试者做必要解释外，不得将任何方案信息、受试者数据或研究资料披露给与本研究无关的第三方。各研究中心应建立受试者身份与医疗记录之间的对应关系，以受试者筛选编号或随机编号替代直接标识符进行数据记录与传输。受试者个人健康信息的收集、存储、传输和销毁应遵循中国现行个人信息保护法律法规及人类遗传资源管理相关规定。研究结束后，各中心应按规定期限保存原始文件，保存期满后按申办方指示进行安全销毁。","rationale":"已确认事实支持：本研究在中国开展，涉及皮下注射用单克隆抗体及骨转换标志物等生物样本检测。公司语料中保密条款来自炎症性皮肤病方案，仅作为监管共性结构参照，未迁移其项目事实。缺少本项目数据保护影响评估、跨境数据传输安排（如有）、生物样本存储与销毁具体政策、电子数据采集系统合规认证状态、人类遗传资源审批状态等项目专属信息。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_38e298b0399dcb85","section_number":"11.4","source_ids":["protocol_full_draft_selec