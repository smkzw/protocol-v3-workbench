urce_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_018"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"自适应设计是否计划：否","quote_sha256":"c71bda4d6101542f8a3c2bb0087631982c72176be9ca9a2526dc2c08ed0ee52a","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_019"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"样本量再估计是否计划：否","quote_sha256":"913a62236e4f4332a7188562f2625d53aa7f770cea155664564c5fb821a98efd","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_020"}],"evidence_review_advisories":[],"evidence_span_ids":["es_001","es_002","es_003","es_004","es_012","es_013","es_014","es_017","es_018","es_019","es_020"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":11},"gap_items":[{"action":"补充既往I/II期研究数据及PMO流行病学来源以支撑确证性假设论证","category":"source_missing","gap_id":"gap_421_01","missing_source_classes":["既往临床研究数据","流行病学数据"],"target":"4.2.1节假设依据段落"},{"action":"确认复合主要终点是否要求两项终点均达到统计学显著，或采用其他联合检验规则","category":"decision_pending","gap_id":"gap_421_02","missing_source_classes":[],"target":"4.2.1节复合主要终点检验策略"}],"heading":"确证性设计与假设依据","missing_source_classes":["既往I/II期临床研究数据","PMO流行病学及疾病负担数据","国内外骨质疏松症诊疗指南","复合主要终点联合检验策略文件"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂对照的III期确证性临床研究，采用平行组设计，试验组与对照组按1:1比例随机分配，全部受试者接受补钙联合维生素D背景治疗。试验组给予SLN-611（皮下注射硬骨抑素单抗）210mg每月一次皮下注射，对照组给予匹配安慰剂每月一次皮下注射，双盲治疗期共12个月。主要疗效评价采用复合主要终点，即12个月新发椎体骨折发生率（影像学判读）与12个月腰椎骨密度较基线百分比变化，估计目标策略为治疗策略（treatment policy），即在考虑受试者实际接受的治疗方案条件下评价上述两项终点。疗效评价基于全分析集（FAS）和符合方案集（PPS），安全性评价基于安全性分析集；统计检验采用分层检验策略控制I类错误。本研究不设置期中分析、自适应设计或样本量再估计，由独立数据安全监查委员会（DMC）对研究进行安全性监查。设计依据方面，SLN-611通过中和硬骨抑素产生促骨形成与抑制骨吸收的双向骨代谢效应，该机制为选择骨密度变化与椎体骨折作为复合主要终点提供了药理学基础；以骨转换标志物P1NP和CTX作为药效学监测指标（列为次要终点），用于支持机制验证。","rationale":"设计结构、复合主要终点、估计目标策略、统计分析策略及DMC安排均来自当前项目已确认研究事实。作用机制描述来自项目定义。但缺少既往I/II期研究数据、PMO流行病学及指南来源，无法在正文中引用具体文献论证假设；复合主要终点的联合检验规则（是否要求双终点均显著）未在项目事实中明确，需医学负责人确认。","review_advisories":["本节复述高影响研究设计（确证性设计与假设依据）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、估计目标、期中分析、样本量）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_e0d87116122be777","section_number":"4.2.1","source_ids":["protocol_full_draft_selection:11e196591f6f3c6f83e8c8da","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb71242d679bdb","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a"]},{"ai_run_id":"airun_20261006010405_d83ec914","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"PK特征本轮未提供","quote_sha256":"29285f2fc2904bb8e0c8926060a0274a46e8f3f91b871d091700919ede64ac55","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_005"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"以骨转换标志物P1NP/CTX作为药效学监测指标（次要终点）","quote_sha256":"97af7d79163a9df724dd252b9210ae25caea5d530f15715f577340ae28c14555","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_006"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"访视策略：筛选、随机及每月给药访视至12个月；BMD于基线、6、12个月；骨转换标志物于基线、1、3、6、12个月","quote_sha256":"5bc2dcc6b37ea18e7b0a4e16a989a211cf11ae4769456f0aa410e9652fb94ee2","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_011"},{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"药效学：中和硬骨抑素产生促骨形成与抑制骨吸收的双向骨代谢效应","quote_sha256":"b0ab7bf6689cfec3b8f3e21e4a63afeff95d81d087840503234344a1387602d9","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_014"}],"evidence_review_advisories":[],"evidence_span_ids":["es_005","es_006","es_011","es_014"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"补充SLN-611 PK特征数据（半衰期、达峰时间、稳态时间等）以确定PK采集点","category":"source_missing","gap_id":"gap_422_01","missing_source_classes":["PK特征数据","非临床/既往临床PK资料"],"target":"4.2.2节PK采集点设计依据"},{"action":"确认是否计划PK/PD联合建模及相应采样设计","category":"source_missing","gap_id":"gap_422_02","missing_source_classes":["PK/PD建模方案"],"target":"4.2.2节PK/PD联合建模"}],"heading":"PK/PD采集点设计依据","missing_source_classes":["PK特征数据","PK采集点设计依据","PK/PD联合建模方案"],"proposal_text":"本研究以骨转换标志物P1NP（I型前胶原氨基端前肽）和CTX（I型胶原C端肽）作为药效学监测指标，列为次要终点，用于支持SLN-611中和硬骨抑素后产生促骨形成与抑制骨吸收双向骨代谢效应的机制验证。骨转换标志物采集时点为基线、第1个月、第3个月、第6个月和第12个月，与每月给药访视及BMD评估访视相协调。BMD评估于基线、第6个月和第12个月进行。本研究不设置PK/PD联合建模，PK采集点设计依据待后续补充SLN-611药代动力学特征数据后另行确定。","rationale":"PD监测指标（P1NP/CTX）及采集时点（基线、1、3、6、12个月）来自当前项目已确认研究事实。BMD评估时点（基线、6、12个月）同样来自项目事实。PK特征在本轮研究定义中明确标注为未提供，因此PK采集点设计依据无法在本稿中形成实质内容，已列入待确认项。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_4f17ff4c1976344e","section_number":"4.2.2","source_ids":["protocol_full_draft_selection:11e196591f6f3c6f83e8c8da","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb71242d679bdb","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a"]},{"ai_run_id":"airun_20261006010405_d83ec914","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","quote":"1:1随机，按中心分层；双盲；全部受试者补钙+维生素D背景治疗","quote_sha256":"ddaa9b66aac37727fcbb8f57e6323d0e10b88944ac0ffa7720e7a4ad12477b0c","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","span_id":"es_007"},{"locator":"document:mwdoc_greenfield_proj_user_d5ebc58f4bba_e54ab29f43100c76:full-draft:11e196591f6f3c6f83e8c8da","quote":"采用随机化分配。1:1随机，按中心分层；双盲；全部受试者补钙+维生素D背景治疗。","quote_sha256":"fc51fd02e90ce488f4887040c019ef0fca80c1fb39a175fa36dfcceba4374f1b","source_id":"protocol_full_draft_selection:11e196591f6f3c6f83e8c8da","span_id":"es_015"}],"evidence_review_advisories":[],"evidence_span_ids":["es_007","es_015"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[{"action":"补充随机化实施方案，明确随机化方法（如区组随机、分层因素）、区组大小、随机化系统（IWRS/IRT）及随机化执行人员","category":"source_missing","gap_id":"gap_43_01","missing_source_classes":["随机化实施方案"],"target":"4.3节随机化实施细节"}],"heading":"随机化","missing_source_classes":["随机化实施方案（区组大小、随机化方法、IWRS/IRT系统配置）","随机化执行人员及时间窗规定"],"proposal_text":"本研究采用随机化分配，试验组（SLN-611 210mg每月一次皮下注射）与对照组（匹配安慰剂每月一次皮下注射）按1:1比例随机分配，随机化按研究中心进行分层。全部受试者均接受补钙联合维生素D背景治疗。随机化在受试者完成筛选并确认符合入排标准后、首次给药前完成。","rationale":"1:1随机、按中心分层、双盲及全部受试者补钙+维生素D背景治疗均来自当前项目已确认研究事实。随机化实施的具体操作细节（如随机化方法、区组大小、随机化系统、随机化执行人员及时间窗）未在项目事实中明确，需项目文件确认。","review_advisories":["本节复述高影响研究设计（随机化）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_29253d21b89a48fd","section_number":"4.3","source_ids":["protocol_full_draft_selection:11e196591f6f3c6f83e8c8da","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb71242d679bdb","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a"]},{"ai_run_id":"airun_20261006010405_d83ec914","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:随机和盲法|block:352|chunk:1","quote":"本研究为双盲随机设计，试验参与者、研究者、监查员以及数据分析人员等对试验参与者接受某剂量试验用药品类别属于试验药物/安慰剂均不知情。在研究开始之前由一名独立的随机化统计师撰写随机化方案，并根据随机化方案使用SAS 9.4（或更新版本）统计软件生成试验参与者随机表和药物随机表。","quote_sha256":"8daf6dc46d42155e29ca2768fe326bcf20208390c0e565062d237a9768f12e59","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","span_id":"es_009"},{"locator":"section:随机和盲法|block:356|chunk:1","quote":"在紧急情况时，研究者如果必须知道某一试验参与者是否在试验药物组以便开展对试验参与者治疗，需要对某一试验参与者进行紧急揭盲（在揭盲之前应告知申办者及临床监查员），研究者通过IWRS进行紧急揭盲，紧急揭盲之后该试验参与者将退出本研究。","quote_sha256":"ed20b992b38a3ba53c1bb731927abdf521ebfb1180ec248a7e95f0092a8fdade","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","span_id":"es_010"},{"locator":"document:mwdoc_greenfield_proj_user_d5ebc58f4bba_e54ab29f43100c76:full-draft:11e196591f6f3c6f83e8c8da","quote":"本研究采用双盲设计。","quote_sha256":"fe6efce93e02fe3c382cf514c2c89d4778531866fbff09bb8ca822e03e54e66a","source_id":"protocol_full_draft_selection:11e196591f6f3c6f83e8c8da","span_id":"es_016"}],"evidence_review_advisories":[],"evidence_span_ids":["es_009","es_010","es_016"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":0},"gap_items":[{"action":"确认盲态覆盖的具体角色范围（受试者、研究者、监查员、数据分析人员、PK/PD实验室人员等）","category":"source_missing","gap_id":"gap_44_01","missing_source_classes":["盲态范围定义文件"],"target":"4.4节盲态范围"},{"action":"补充紧急揭盲的具体操作流程、IWRS/IRT系统配置、权限人员及培训要求","category":"source_missing","gap_id":"gap_44_02","missing_source_classes":["紧急揭盲操作规程"],"target":"4.4节紧急揭盲操作"},{"action":"确认研究结束时整体揭盲的流程、时机及数据处理规则","category":"source_missing","gap_id":"gap_44_03","missing_source_classes":["揭盲流程文件"],"target":"4.4节研究结束揭盲"}],"heading":"盲法与揭盲","missing_source_classes":["盲态范围定义（哪些角色保持盲态）","紧急揭盲具体操作流程及权限规定","揭盲后数据处理规则","研究结束揭盲流程"],"proposal_text":"本研究采用双盲设计，试验组给予SLN-611 210mg每月一次皮下注射，对照组给予匹配安慰剂每月一次皮下注射，两组药物在外观、气味及注射操作方式上保持一致，使受试者和研究者无法区分所接受的治疗。在紧急情况下，若研究者必须知晓某一受试者所接受的实际治疗以指导临床决策，可启动紧急揭盲程序；紧急揭盲前研究者应告知申办者及临床监查员，揭盲后该受试者退出本研究。研究人员应详细记录紧急揭盲的理由、日期、处理情况及结果。","rationale":"双盲设计及匹配安慰剂来自当前项目已确认研究事实。紧急揭盲的触发条件（研究者需知晓实际治疗以指导临床决策）、告知申办者及监查员、揭盲后退出研究及记录要求，参照公司语料中同类方案的监管共性结构，但具体操作细节（如IWRS系统配置、揭盲权限人员、培训要求）未在本项目文件中确认，需项目文件补充。盲态范围（哪些角色保持盲态）未在项目事实中明确列出，不得自行指定。","review_advisories":["本节复述高影响研究设计（盲法与揭盲）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d5ebc58f4bba_86aae0f26d89596c","section_number":"4.4","source_ids":["protocol_full_draft_selection:11e196591f6f3c6f83e8c8da","current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb71242d679bdb","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a"]}],"source_bindings":[{"content_sha256":"5511680d111f90b0b69ab641b761b2e5fe3d1a9e234a0cceddb152c1bfa308ad","locator":"document:mwdoc_greenfield_proj_user_d5ebc58f4bba_e54ab29f43100c76:full-draft:11e196591f6f3c6f83e8c8da","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:11e196591f6f3c6f83e8c8da","source_type":"protocol_full_draft_selection","source_version":"full-draft:d4bcfda355db92494e1792b8a712f5912f5c5f0842d8a34c2adf2dcffe0add9e:11e196591f6f3c6f83e8c8da","text_sha256":"5511680d111f90b0b69ab641b761b2e5fe3d1a9e234a0cceddb152c1bfa308ad"},{"content_sha256":"01acde550034c139002b127618cadca82a0894fdead88903d47425241f006b8c","locator":"study_definition:mwdefinition_e39e763face5655bdf2f:revision:5","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_e39e763face5655bdf2f:r5:c11fc9a99a007d54","source_type":"current_project_study_definition","source_version":"mwdefinition_e39e763face5655bdf