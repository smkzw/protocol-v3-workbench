3ff:r4:f1a05b39d74b96a7","span_id":"ev_safety_endpoints"},{"locator":"study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:revision:4","quote":"研究时期：筛选期（第-28至-1天）；12周双盲治疗期（第0天随机给药至第12周）；治疗结束访视（第12周±3天）；安全随访期（末次给药后2周）\n访视策略：V0筛选（-28~-1d）：病史、查体、ECHO、实验室、NT-proBNP、ECG\nV1随机入组（D0）\nV2（W4）：疗效与安全性评价\nV3（W8）：疗效与安全性评价\nV4治疗结束（W12±3d）：主要终点评价与全面安全性\nV5安全随访（W14）：AE转归确认","quote_sha256":"cebf219bf72f4c14796fe8ef6c2d5a5464800d95850f0f08a45af13dff035a6e","source_id":"current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","span_id":"ev_study_periods_visits"},{"locator":"study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:revision:4","quote":"统计分析策略：FAS为主要分析集；主要终点NT-proBNP百分比变化采用ANCOVA（基线校正）并检验剂量-反应趋势；安全性采用描述统计；次要终点按预先层级顺序分析。","quote_sha256":"9cf37f0df8f4d6bd00beb8c92cebe88f07431911c16227896760d446ca13e075","source_id":"current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","span_id":"ev_statistical"}],"evidence_review_advisories":[],"evidence_span_ids":["ev_overall_design","ev_safety_endpoints","ev_study_periods_visits","ev_statistical"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"补充已确认的次要终点完整清单及其与次要目的的对应关系","category":"source_missing","gap_id":"gap_3_2_secondary_endpoint_list","missing_source_classes":["次要终点定义清单","次要目的与次要终点对应关系"],"target":"3.2 次要目的和次要终点"},{"action":"补充次要终点预先层级顺序及多重性控制策略的已确认来源","category":"source_missing","gap_id":"gap_3_2_hierarchy","missing_source_classes":["次要终点层级检验顺序","多重性控制策略"],"target":"3.2 次要目的和次要终点"}],"heading":"次要目的和次要终点","missing_source_classes":["次要终点定义清单","次要目的与次要终点对应关系","次要终点层级检验顺序","多重性控制策略"],"proposal_text":"本研究的次要目的为评价KZ-sGC1001在18-75岁慢性稳定性射血分数降低的心力衰竭成年患者中的安全性和耐受性，并观察其在标准指南导向药物治疗（GDMT）背景治疗基础上对临床安全指标的影响。与次要目的相对应的安全性评价指标包括不良事件与严重不良事件发生率、症状性低血压与体位性低血压、生命体征（血压、心率）、肝肾功能及电解质实验室指标和12导联心电图。上述指标结合筛选期、第4周和第8周疗效与安全性评价、第12周±3天治疗结束访视及末次给药后2周安全随访进行观察和记录，以支持对主要终点第12周NT-proBNP较基线百分比变化结果的解释。次要终点按预先设定的层级顺序进行分析，以支持主要结果的稳健性判断。","rationale":"依据已确认研究事实，安全性终点、访视策略及次要终点层级分析原则已明确，因此正文写入已确认的安全指标和第12周主要终点衔接关系。次要终点清单尚缺失，医学作者需核对安全性终点是否全部作为次要终点呈现，并补充层级顺序。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_250ba24c78cf_3571d5752c6358f4","section_number":"3.2","source_ids":["protocol_full_draft_selection:f513e35afcdeb92640a3aed4","current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7"]},{"ai_run_id":"airun_20261007104933_0c4fb904","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"恢复本章节正文与当前项目来源的证据绑定后重新核对。","category":"mapping_failed","gap_id":"gap:evidence-binding","missing_source_classes":[],"target":"mwsec_greenfield_proj_user_250ba24c78cf_02774d1b9d28d897"}],"heading":"探索性目的和探索性终点","missing_source_classes":["支持本章节正文的当前项目直接来源"],"proposal_text":"","rationale":"本次输出未能把正文绑定到有效证据；需补充或重新绑定支持本章节的当前项目直接来源。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_250ba24c78cf_02774d1b9d28d897","section_number":"3.3","source_ids":["protocol_full_draft_selection:f513e35afcdeb92640a3aed4","current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7"]},{"ai_run_id":"airun_20261007104933_0c4fb904","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:revision:4","quote":"研究题目：SMOKE-r10-1AB口服sGC刺激剂（KZ-sGC1001）用于治疗射血分数降低的心力衰竭（HFrEF）的II期临床研究\n试验药物：SMOKE-r10-1AB口服sGC刺激剂（KZ-sGC1001）\n适应症：射血分数降低的心力衰竭（HFrEF）\n研究分期：II期\n开发区域：中国\n内在研究目的：概念验证（PoC）；剂量探索","quote_sha256":"7e9f7d6914c009bfa6c058c0ac0ea0311e2ebe01be8838bf2650b13741493f02","source_id":"current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","span_id":"ev_study_title"},{"locator":"study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:revision:4","quote":"总体研究设计：随机、双盲、安慰剂对照、平行组、多中心；II期概念验证+剂量探索，KZ-sGC1001三个剂量组与安慰剂对照，治疗12周\n目标研究人群：年龄段：成人；疾病状态：中重度；经治情况：经治疗效不佳；18-75岁慢性稳定性HFrEF，LVEF≤40%，NYHA II-III级，稳定GDMT≥4周仍症状未控制","quote_sha256":"4dbc88e33bc6207f580e1d5e9fa7da1feaa21751831e86560048fafd96dec6bf","source_id":"current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","span_id":"ev_overall_design"},{"locator":"study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:revision:4","quote":"研究人群概述：18-75岁慢性稳定性HFrEF成人，LVEF≤40%，NYHA II-III级，筛选前已接受稳定GDMT至少4周仍有症状。\n入选标准模块：年龄18-75岁，性别不限；LVEF≤40%（ECHO评估）且NYHA II-III级；筛选前≥4周稳定剂量GDMT仍有心衰症状\n排除标准模块：坐位SBP<90 mmHg或有症状性低血压；90天内急性心衰失代偿住院或30天内ACS/PCI/CABG；合并硝酸酯类或PDE5抑制剂；eGFR<30；妊娠或哺乳","quote_sha256":"677ad55699fee6951d318e3bbf7a63f99d6aaeb604838f56bd986d687c71d04d","source_id":"current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","span_id":"ev_population"},{"locator":"study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:revision:4","quote":"试验干预：KZ-sGC1001片剂每日一次口服，低/中/高三个剂量水平，双盲双模拟，治疗期12周，联合标准GDMT背景治疗。\n剂量与给药方案：SMOKE-r10-1AB口服sGC刺激剂（KZ-sGC1001）：低剂量2.5 mg qd、中剂量5 mg qd、高剂量10 mg qd，每日晨起随餐口服；每4周随访评估耐受性，按方案规定剂量调整。\n安慰剂：安慰剂平行对照：外观与气味与试验药一致的模拟片，每日一次，给药与访视安排同试验组，联合相同GDMT背景，按1:1:1:1随机分配。","quote_sha256":"4123b6950a5fb5da3b0354d928fc1f8334359b18596ddacfbb3b562cdf7f6e40","source_id":"current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","span_id":"ev_intervention"},{"locator":"study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:revision:4","quote":"主要终点：主要终点：第12周NT-proBNP较基线的百分比变化（双盲期）。评价时间点：基线、第4/8/12周。","quote_sha256":"161db75499e2f57b4c26d1e22eabe8a3ca40273b7dc79a8bf7277c712e931de9","source_id":"current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","span_id":"ev_primary_endpoint"},{"locator":"study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:revision:4","quote":"安全性终点：不良事件与严重不良事件发生率；症状性低血压与体位性低血压；生命体征（血压、心率）；肝肾功能、电解质实验室指标；12导联心电图","quote_sha256":"e77501ca084e2f1e9fa18684d494f2252570a19a158da14e097274f13b01fb6b","source_id":"current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","span_id":"ev_safety_endpoints"},{"locator":"study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:revision:4","quote":"研究时期：筛选期（第-28至-1天）；12周双盲治疗期（第0天随机给药至第12周）；治疗结束访视（第12周±3天）；安全随访期（末次给药后2周）\n访视策略：V0筛选（-28~-1d）：病史、查体、ECHO、实验室、NT-proBNP、ECG\nV1随机入组（D0）\nV2（W4）：疗效与安全性评价\nV3（W8）：疗效与安全性评价\nV4治疗结束（W12±3d）：主要终点评价与全面安全性\nV5安全随访（W14）：AE转归确认","quote_sha256":"cebf219bf72f4c14796fe8ef6c2d5a5464800d95850f0f08a45af13dff035a6e","source_id":"current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","span_id":"ev_study_periods_visits"},{"locator":"study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:revision:4","quote":"样本量策略：II期探索性设计：每组约60例（共约240例），基于NT-proBNP组间差值文献效应量与80%把握度估算，用于概念验证与剂量选择。","quote_sha256":"5f598e1d608dd27ea2bd6080417002fe0f5e763c866e33ca8a5c13c697490e10","source_id":"current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","span_id":"ev_sample_size"},{"locator":"study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:revision:4","quote":"估计目标策略：治疗策略（treatment policy）：无论是否剂量调整或合并用药变化，均按随机分组分析；终点前事件按复合策略处理。","quote_sha256":"eb44177581223de72875983b0f1d70b25c2bbcf98304d5b17e2c2764beca8e56","source_id":"current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","span_id":"ev_estimand"},{"locator":"study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:revision:4","quote":"统计分析策略：FAS为主要分析集；主要终点NT-proBNP百分比变化采用ANCOVA（基线校正）并检验剂量-反应趋势；安全性采用描述统计；次要终点按预先层级顺序分析。","quote_sha256":"9cf37f0df8f4d6bd00beb8c92cebe88f07431911c16227896760d446ca13e075","source_id":"current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","span_id":"ev_statistical"},{"locator":"study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:revision:4","quote":"自适应设计是否计划：否\n样本量再估计是否计划：否\n期中分析是否计划：否\nSRC是否计划：否\nDMC是否计划：否","quote_sha256":"d192609ccba318766cd82ff78063ce30f2b165b2a2fe910e39eed2bf9435a059","source_id":"current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","span_id":"ev_no_adaptive"}],"evidence_review_advisories":[],"evidence_span_ids":["ev_study_title","ev_overall_design","ev_population","ev_intervention","ev_primary_endpoint","ev_safety_endpoints","ev_study_periods_visits","ev_sample_size","ev_estimand","ev_statistical","ev_no_adaptive"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":11},"gap_items":[{"action":"补充已确认的剂量调整、暂停、恢复和永久停药规则来源","category":"source_missing","gap_id":"gap_4_dose_modification","missing_source_classes":["剂量调整与停药规则"],"target":"4 研究设计（剂量调整、暂停、恢复及永久停药规则）"},{"action":"补充已确认的救援治疗和合并/禁限用药规则来源","category":"source_missing","gap_id":"gap_4_rescue","missing_source_classes":["合并用药与救援治疗规则"],"target":"4 研究设计（救援治疗与合并用药限制）"},{"action":"补充已确认的紧急揭盲程序与职责来源","category":"source_missing","gap_id":"gap_4_unblinding","missing_source_classes":["紧急揭盲程序"],"target":"4 研究设计（紧急揭盲程序）"},{"action":"补充已确认的试验药包装、储存、发放和回收规程及研究者手册或研究药物风险来源","category":"source_missing","gap_id":"gap_4_ip_handling_and_drug_risk","missing_source_classes":["试验药管理与研究者手册"],"target":"4 研究设计（试验药包装、储存、发放回收及研究药物风险）"}],"heading":"研究设计","missing_source_classes":["剂量调整与停药规则","合并用药与救援治疗规则","紧急揭盲程序","试验药管理与研究者手册"],"proposal_text":"本研究为在中国开展的多中心、随机、双盲、安慰剂对照、平行组的II期临床研究，受试者为18-75岁慢性稳定性射血分数降低的心力衰竭（HFrEF）成人患者，筛选时LVEF≤40%、NYHA心功能II-III级，且在筛选前至少4周接受稳定剂量指南导向药物治疗（GDMT）后仍有心衰症状。研究采用概念验证与剂量探索设计，受试者按1:1:1:1随机分配至KZ-sGC1001低剂量2.5 mg每日一次、中剂量5 mg每日一次、高剂量10 mg每日一次或安慰剂组；试验药为口服片剂，每日晨起随餐口服，安慰剂为外观与气味与试验药一致的模拟片，每日一次，给药与访视安排同试验组，所有受试者均联合标准GDMT背景治疗，双盲治疗期为12周。主要终点为第12周NT-proBNP较基线的百分比变化，评价时间点为基线、第4周、第8周和第12周；安全性终点包括不良事件与严重不良事件发生率、症状性低血压与体位性低血压、生命体征（血压、心率）、肝肾功能及电解质实验室指标和12导联心电图。研究时期包括筛选期（第-28至-1天）、12周双盲治疗期（第0天随机给药至第12周）、治疗结束访视（第12周±3天）和安全随访期（末次给药后2周）；访视安排包括V0筛选、V1随机入组（第0天）、V2第4周、V3第8周、V4第12周±3天治疗结束访视和V5第14周安全随访。计划每组约60例、共约240例，样本量基于NT-proBNP组间差值文献效应量和80%把握度估算，用于概念验证与剂量选择。估计目标采用治疗策略，无论是否发生剂量调整或合并用药变化，均按随机分组分析，终点前事件按复合策略处理；主要分析集为FAS，主要终点采用基线校正的ANCOVA并检验剂量-反应趋势，安全性采用描述统计，次要终点按预先层级顺序分析。本研究不计划自适应设计、样本量再估计、期中分析、SRC或DMC。","rationale":"依据已确认研究事实，正文已写入随机、双盲、安慰剂对照、平行组、多中心设计，三个剂量组与安慰剂1:1:1:1分配，12周双盲治疗期，主要终点、安全性终点、访视安排、样本量、估计目标和统计分析原则。剂量调整、救援治疗、紧急揭盲和试验药管理规则在已确认来源中缺失，医学作者需补充相应项目文件或职能确认。","review_advisories":["本节复述高影响研究设计（研究设计）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、估计目标、剂量选择、期中分析、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_250ba24c78cf_38febd27a9064957","section_number":"4","source_ids":["protocol_full_draft_selection:f513e35afcdeb92640a3aed4","current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7"]},{"ai_run_id":"airun_20261007104933_0c4fb904","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:revision:4","quote":"总体研究设计：随机、双盲、安慰剂对照、平行组、多中心；II期概念验证+剂量探索，KZ-sGC1001三个剂量组与安慰剂对照，治疗12周\n目标研究人群：年龄段：成人；疾病状态：中重度；经治情况：经治疗效不佳；18-75岁慢性稳定性HFrEF，LVEF≤40%，NYHA II-III级，稳定GDMT≥4周仍症状未控制","quote_sha256":"4dbc88e33bc6207f580e1d5e9fa7da1feaa21751831e86560048fafd96dec6bf","source_id":"current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","span_id":"ev_overall_design"},{"locator":"study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:revision:4","quote":"试验干预：KZ-sGC1001片剂每日一次口服，低/中/高三个剂量水平，双盲双模拟，治疗期12周，联合标准GDMT背景治疗。\n剂量与给药方案：SMOKE-r10-1AB口服sGC刺激剂（KZ-sGC1001）：低剂量2.5 mg qd、中剂量5 mg qd、高剂量10 mg qd，每日晨起随餐口服；每4周随访评估耐受性，按方案规定剂量调整。\n安慰剂：安慰剂平行对照：外观与气味与试验药一致的模拟片，每日一次，给药与访视安排同试验组，联合相同GDMT背景，按1:1:1:1随机分配。","quote_sha256":"4123b6950a5fb5da3b0354d928fc1f8334359b18596ddacfbb3b562cdf7f6e40","source_id":"current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","span_id":"ev_intervention"},{"locator":"study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:revision:4","quote":"主要终点：主要终点：第12周NT-proBNP较基线的百分比变化（双盲期）。评价时间点：基线、第4/8/12周。","quote_sha256":"161db75499e2f57b4c26d1e22eabe8a3ca40273b7dc79a8bf7277c712e931de9","source_id":"current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","span_id":"ev_primary_endpoint"},{"locator":"study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:revision:4","quote":"研究时期：筛选期（第-28至-1天）；12周双盲治疗期（第0天随机给药至第12周）；治疗结束访视（第12周±3天）；安全随访期（末次给药后2周）\n访视策略：V0筛选（-28~-1d）：病史、查体、ECHO、实验室、NT-proBNP、ECG\nV1随机入组（D0）\nV2（W4）：疗效与安全性评价\nV3（W8）：疗效与安全性评价\nV4治疗结束（W12±3d）：主要终点评价与全面安全性\nV5安全随访（W14）：AE转归确认","quote_sha256":"cebf219bf72f4c14796fe8ef6c2d5a5464800d95850f0f08a45af13dff035a6e","source_id":"current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","span_id":"ev_study_periods_visits"},{"locator":"study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:revision:4","quote":"样本量策略：II期探索性设计：每组约60例（共约240例），基于NT-proBNP组间差值文献效应量与80%把握度估算，用于概念验证与剂量选择。","quote_sha256":"5f598e1d608dd27ea2bd6080417002fe0f5e763c866e33ca8a5c13c697490e10","source_id":"current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","span_id":"ev_sample_size"},{"locator":"study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:revision:4","quote":"估计目标策略：治疗策略（treatment policy）：无论是否剂量调整或合并用药变化，均按随机分组分析；终点前事件按复合策略处理。","quote_sha256":"eb44177581223de72875983b0f1d70b25c2bbcf98304d5b17e2c2764beca8e56","source_id":"current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","span_id":"ev_estimand"},{"locator":"study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:revision:4","quote":"统计分析策略：FAS为主要分析集；主要终点NT-proBNP百分比变化采用ANCOVA（基线校正）并检验剂量-反应趋势；安全性采用描述统计；次要终点按预先层级顺序分析。","quote_sha256":"9cf37f0df8f4d6bd00beb8c92cebe88f07431911c16227896760d446ca13e075","source_id":"current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","span_id":"ev_statistical"},{"locator":"study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:revision:4","quote":"自适应设计是否计划：否\n样本量再估计是否计划：否\n期中分析是否计划：否\nSRC是否计划：否\nDMC是否计划：否","quote_sha256":"d192609ccba318766cd82ff78063ce30f2b165b2a2fe910e39eed2bf9435a059","source_id":"current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","span_id":"ev_no_adaptive"}],"evidence_review_advisories":[],"evidence_span_ids":["ev_overall_design","ev_intervention","ev_primary_endpoint","ev_study_periods_visits","ev_sample_size","ev_estimand","ev_statistical","ev_no_adaptive"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":8},"gap_items":[],"heading":"总体设计","missing_source_classes":[],"proposal_text":"本研究采用随机、双盲、安慰剂对照、平行组、多中心设计，计划在中国开展。研究为II期概念验证与剂量探索研究，设置KZ-sGC1001低剂量2.5 mg每日一次、中剂量5 mg每日一次、高剂量10 mg每日一次和安慰剂四个组，受试者按1:1:1:1随机分配。试验药为口服片剂，每日晨起随餐口服；安慰剂为外观与气味与试验药一致的模拟片，每日一次，给药与访视安排同试验组；所有受试者均联合标准GDMT背景治疗，双盲治疗期为12周。研究时期包括筛选期（第-28至-1天）、第0天随机给药、第4周和第8周疗效与安全性评价、第12周±3天治疗结束访视以及末次给药后2周安全随访，主要终点在第12周评价NT-proBNP较基线的百分比变化。计划每组约60例、共约240例。本研究不计划自适应设计、样本量再估计、期中分析、SRC或DMC，估计目标采用治疗策略，主要分析集为FAS。","rationale":"依据已确认研究事实，正文写入随机、双盲、安慰剂对照、平行组、多中心设计，1:1:1:1随机，低/中/高剂量2.5/5/10 mg每日一次与匹配安慰剂，12周双盲治疗期，访视时间点、样本量、估计目标及不计划自适应/期中分析/SRC/DMC等已确认事实。医学作者需核对盲态范围等未在已确认来源中给出的实施细节不得扩写。","review_advisories":["本节复述高影响研究设计（总体设计）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、估计目标、期中分析、样本量）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_250ba24c78cf_2d3ed384535d8707","section_number":"4.1","source_ids":["protocol_full_draft_selection:f513e35afcdeb92640a3aed4","current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7"]}],"source_bindings":[{"content_sha256":"c58f474f43f8a4d7069945b8bffb65bce9a11f8762491f2af9e0100f6ef605f2","locator":"document:mwdoc_greenfield_proj_user_250ba24c78cf_d3ca9fe4d59c7e9b:full-draft:f513e35afcdeb92640a3aed4","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:f513e35afcdeb92640a3aed4","source_type":"protocol_full_draft_selection","source_version":"full-draft:2c8f732861f79e322ecf9243dfaff2185a226e2aaae78179679aa662d68a9ebd:f513e35afcdeb92640a3aed4","text_sha256":"c58f474f43f8a4d7069945b8bffb65bce9a11f8762491f2af9e0100f6ef605f2"},{"content_sha256":"e920b1143f72802fed81f94cbf5c915eddd00ad94aa48f0f40e335da362a79ca","locator":"study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","source_type":"current_project_study_definition","source_version":"mwdefinition_4f3fe74ca1c73e90e3ff:r4:f1a05b39d74b96a7","text_sha256":"e920b1143f72802fed81f94cbf5c915eddd00ad94aa48f0f40e335da362a79ca"},{"content_sha256":"d201ce569054cbbf7236ebc38a81549ab6777a6cd5f2fedc31a501f7bd4655a7","locator":"section:6.3.3 揭盲|block:488|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","source_type":"company_protocol_reference_corpus","source_version":"46d82ed9e2e3ef","text_sha256":"d201ce569054cbbf7236ebc38a81549ab6777a6cd5f2fedc31a501f7bd4655a7"},{"content_sha256":"2a6939e28805b7316a6881a03b7effe8a21e0d13733b8c1592fa1004ecf0b24f","locator":"section:9.2 统计分析数据集|block:859|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","source_type":"company_protocol_reference_corpus","source_version":"3809927f2ae07b","text_sha256":"2a6939e28805b7316a6881a03b7effe8a21e0d13733b8c1592fa1004ecf0b24f"},{"content_sha256":"a081fa03f5ce0ceb2ca2444ea6b2a850997611938884f75fa4f6b5e188b3af68","locator":"section:7.3.1 病例报告表的设计|block:1037|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","source_type":"company_protocol_reference_corpus","source_version":"a5f4a227d6404a","text_sha256":"a081fa03f5ce0ceb2ca2444ea6b2a850997611938884f75fa4f6b5e188b3af68"},{"content_sha256":"288c4151aa03e0bb0feffeb19ae4b67d399ea214ab90d8f02d3dd67800bdd070","locator":"section:统计分析单位签字页|block:57|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","source_type":"company_protocol_reference_corpus","source_version":"abb423601f76d0","text_sha256":"288c4151aa03e0bb0feffeb19ae4b67d399ea214ab90d8f02d3dd67800bdd070"},{"content_sha256":"a635fe9c51c78cbc66090c3553c488cd453e807e61608a97e0767740d5088a03","locator":"section:8 统计学考虑|block:1056|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","source_type":"company_protocol_reference_corpus","source_version":"a3cf98aab983c7","text_sha256":"a635fe9c51c78cbc66090c3553c488cd453e807e61608a97e0767740d5088a03"}]}