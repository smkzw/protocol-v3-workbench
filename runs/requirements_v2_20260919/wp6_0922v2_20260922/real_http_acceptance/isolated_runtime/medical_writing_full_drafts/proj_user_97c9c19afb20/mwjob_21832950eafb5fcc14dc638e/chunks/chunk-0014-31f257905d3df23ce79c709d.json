ber":"8.6","source_ids":["protocol_full_draft_selection:31f257905d3df23ce79c709d","current_project_study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:9691f7c94f6c58","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976","company_corpus:cms_cn_protocol_corpus_20260715_v1:9895ed0bd2ffd4","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83"]},{"ai_run_id":"airun_20261003183936_7079859b","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:revision:7","quote":"安全随访期（末次给药后2周）","quote_sha256":"a237fbd5db01292d7023e8380dd693f6efe7f87c8530b840521a43ff8049f53a","source_id":"current_project_study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef","span_id":"es_002"},{"locator":"study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:revision:7","quote":"V5安全随访（W14）：AE转归确认","quote_sha256":"a0d0d5f20813f69874e61d0ee747ce0cf211395a3ba1eb7461504efd7528fe58","source_id":"current_project_study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef","span_id":"es_003"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"确认安全随访期内AE随访的终止条件、随访频率及是否需重复安全性检查","category":"source_missing","gap_id":"gap_87_01","missing_source_classes":["项目专属AE随访操作细则"],"target":"8.7节安全随访期内随访操作细则"},{"action":"确认本项目eCRF中AE转归记录的具体字段与源数据核查要求","category":"source_missing","gap_id":"gap_87_02","missing_source_classes":["电子数据采集规范或eCRF设计文件"],"target":"8.7节记录载体与源数据核查要求"}],"heading":"不良事件的随访","missing_source_classes":["项目专属AE随访操作细则（随访终止条件、频率、记录载体）","安全随访期内是否需重复实验室检查或心电图的项目规定"],"proposal_text":"本研究设置安全随访期，自末次给药后持续2周。治疗结束访视（第12周±3天）完成全面安全性评价后，受试者进入安全随访期，并于第14周接受安全随访访视，该访视的主要目的为确认治疗期间已报告不良事件的转归。研究期间已报告的不良事件，其转归信息应在受试者病历及电子病例报告表中记录，包括转归日期，以便源数据核查。安全随访期内新发或持续存在的不良事件，研究者应持续追踪至事件转归或安全随访期结束。","rationale":"安全随访期时长（末次给药后2周）和V5访视目的（AE转归确认）来源于本项目已确认研究事实。随访期间记录转归日期及便于源数据核查的表述参照跨适应症语料结构，但具体随访终止条件、随访频率、是否需额外实验室检查或心电图等实施细节缺少项目来源，需医学经理与安全性团队确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97c9c19afb20_364504afabf93eb7","section_number":"8.7","source_ids":["protocol_full_draft_selection:31f257905d3df23ce79c709d","current_project_study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:9691f7c94f6c58","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976","company_corpus:cms_cn_protocol_corpus_20260715_v1:9895ed0bd2ffd4","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83"]},{"ai_run_id":"airun_20261003183936_7079859b","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:revision:7","quote":"妊娠或哺乳期","quote_sha256":"b703a3d2d679f4c61fc5f87ed3017dfadd1bff9cc1d021a4c041f47c6c73ff9f","source_id":"current_project_study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef","span_id":"es_004"},{"locator":"section:8.6.2 妊娠事件的随访|block:846|chunk:1","quote":"所有妊娠的过程，包括围产期和新生儿结局，无论参与者是否已停止参与研究，将随访至结局","quote_sha256":"024dbcad78dd92d92c98989b92ae5cced7b872c3e13760fa7cf331ee26e37c4b","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:9895ed0bd2ffd4","span_id":"es_005"},{"locator":"section:妊娠事件的报告要求|block:839|chunk:1","quote":"妊娠既不是AE也不是SAE，不应记录在eCRF的不良事件上","quote_sha256":"c4bc52186da73b50755c6761ad0b51d61d95d28fa288afae8982955c1d18eff3","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976","span_id":"es_006"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004","es_005","es_006"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":1},"gap_items":[{"action":"确认本项目妊娠事件的报告时限、报告对象及报告载体","category":"source_missing","gap_id":"gap_88_01","missing_source_classes":["项目专属妊娠报告规程"],"target":"8.8节妊娠报告时限与报告对象"},{"action":"确认本项目是否要求避孕措施、妊娠检查日程及伴侣妊娠报告","category":"source_missing","gap_id":"gap_88_02","missing_source_classes":["项目避孕与妊娠监测方案"],"target":"8.8节避孕方法与妊娠检查"},{"action":"确认妊娠随访的终止条件（如健康婴儿首次访视、末次月经后特定时间等）","category":"source_missing","gap_id":"gap_88_03","missing_source_classes":["项目妊娠随访终止规则"],"target":"8.8节妊娠随访终止时点"}],"heading":"妊娠事件的报告与随访","missing_source_classes":["项目专属妊娠报告时限与报告对象规定","妊娠检查日程与避孕方法要求","伴侣妊娠报告规则","妊娠随访终止时点与新生儿随访方案"],"proposal_text":"妊娠或哺乳期女性为本研究的排除人群。研究期间如发生妊娠事件，其报告与随访应遵循以下原则：妊娠本身不作为不良事件或严重不良事件记录，但妊娠相关并发症（包括自然流产、因医学或健康原因导致的人工流产、死胎、新生儿严重不良事件）应按严重不良事件报告。所有妊娠事件应随访至妊娠结局，包括围产期及新生儿结局，无论受试者是否已停止参与研究。随访内容包括分娩细节、是否存在出生缺陷或先天性异常、孕产妇及新生儿并发症。对出生结果的随访根据个案情况进行处理。","rationale":"妊娠或哺乳期排除来源于本项目已确认排除标准。妊娠不作为AE/SAE、妊娠相关并发症按SAE报告、随访至妊娠结局及围产期新生儿结局的结构参照来自跨适应症语料，仅用于章节结构与监管共性条款，不得迁移其24小时报告时限、妊娠报告表格式或具体随访终止时点作为本项目已确认事实。本项目缺少妊娠报告的具体时限、报告对象、妊娠检查日程、避孕方法要求及伴侣妊娠报告规则。","review_advisories":["本节复述高影响研究设计（妊娠事件的报告与随访）；请在合并设计摘要中统一核对。","本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97c9c19afb20_560ebf60873f91c7","section_number":"8.8","source_ids":["protocol_full_draft_selection:31f257905d3df23ce79c709d","current_project_study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:9691f7c94f6c58","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976","company_corpus:cms_cn_protocol_corpus_20260715_v1:9895ed0bd2ffd4","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83"]},{"ai_run_id":"airun_20261003183936_7079859b","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:revision:7","quote":"FAS为主要分析集；主要终点NT-proBNP百分比变化采用ANCOVA（基线校正）并检验剂量-反应趋势；安全性采用描述统计；次要终点按预先层级顺序分析，探索性终点仅作描述。","quote_sha256":"a272afcc3ab286ab8fcc79474b762d0ee460c867dcd24b993c5e23bb1392cf66","source_id":"current_project_study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef","span_id":"es_007"},{"locator":"study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:revision:7","quote":"估计目标策略：治疗策略（treatment policy）：无论是否发生剂量调整或合并用药变化，均按随机分组分析；死亡等终点前发生的因果事件按复合策略处理。","quote_sha256":"322da69493614bb7be98fec12bee421cec03acef7856b4c3d1b02391d7679f56","source_id":"current_project_study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef","span_id":"es_008"}],"evidence_review_advisories":[],"evidence_span_ids":["es_007","es_008"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"确认ANCOVA除基线NT-proBNP外的协变量选择及多重比较校正策略","category":"source_missing","gap_id":"gap_9_01","missing_source_classes":["统计分析报告或统计分析计划"],"target":"9节ANCOVA协变量与多重比较"},{"action":"确认主要终点及次要终点的缺失数据插补方法","category":"source_missing","gap_id":"gap_9_02","missing_source_classes":["统计分析报告或统计分析计划"],"target":"9节缺失数据处理"},{"action":"确认是否设置预设亚组分析及敏感性分析方案","category":"source_missing","gap_id":"gap_9_03","missing_source_classes":["统计分析报告或统计分析计划"],"target":"9节亚组分析与敏感性分析"}],"heading":"统计分析","missing_source_classes":["统计分析报告（SAP）或统计分析计划","多重比较校正策略","缺失数据处理方法","亚组分析与敏感性分析方案"],"proposal_text":"本研究采用治疗策略（treatment policy）估计目标：无论是否发生剂量调整或合并用药变化，均按随机分组进行分析；死亡等终点前发生的因果事件按复合策略处理。主要分析集为全分析集（FAS），包含所有随机化受试者。主要终点第12周NT-proBNP较基线的百分比变化采用协方差分析（ANCOVA），以基线NT-proBNP为协变量，并检验剂量-反应趋势。安全性数据采用描述性统计方法进行分析。次要终点按预先设定的层级顺序进行分析。探索性终点仅作描述性分析。","rationale":"FAS为主要分析集、ANCOVA（基线校正）检验剂量-反应趋势、安全性描述统计、次要终点层级分析、探索性终点仅描述、治疗策略估计目标及复合策略处理均来源于本项目已确认统计分析策略。ANCOVA中除基线NT-proBNP外的其他协变量选择、多重比较校正策略、缺失数据插补方法、亚组分析计划及敏感性分析方案未在已确认事实中明确，需统计师与医学经理共同确认。","review_advisories":["本节复述高影响研究设计（统计分析）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、估计目标）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97c9c19afb20_89f6fb6b93ee5a1d","section_number":"9","source_ids":["protocol_full_draft_select