":[{"action":"需项目实验室检查项目清单或访视流程表，明确各访视具体检测项目（血常规、凝血、尿常规等是否纳入）及采血时间点","category":"source_missing","gap_id":"gap_lab_001","missing_source_classes":["项目实验室检查项目清单","访视流程表"],"target":"14.2节实验室检查项目完整清单"},{"action":"需确认实验室正常值范围是否采用中心实验室统一标准，以及ALT/AST>3×ULN、eGFR<30是否同时作为安全性监测的停药或减量触发标准","category":"source_missing","gap_id":"gap_lab_002","missing_source_classes":["实验室正常值范围表","剂量调整/停药标准"],"target":"14.2节正常值范围及异常判定标准"}],"heading":"实验室检查项目","missing_source_classes":["项目实验室检查项目清单及访视检测矩阵","实验室正常值范围及异常判定标准","各访视具体采血时间点"],"proposal_text":"本研究安全性评估涉及的实验室检查项目包括肝功能（ALT、AST、总胆红素、碱性磷酸酶）、肾功能（血肌酐、eGFR）及电解质（钠、钾、氯、钙、镁）指标，同时纳入12导联心电图检查。筛选期（V0，第-28至-1天）须完成基线实验室检查、NT-proBNP测定及12导联心电图，用于确认受试者符合入选与排除标准；排除标准中eGFR低于30 mL/min/1.73m²或ALT/AST超过3倍正常值上限者不得入组。治疗期间及治疗结束访视（V4，第12周±3天）须进行全面安全性评价，具体实验室检测项目及各访视采血时间点详见方案访视流程表。安全随访期（V5，第14周）须确认不良事件转归，必要时复查相关实验室指标。具有临床意义的实验室检查值异常应在eCRF不良事件页面记录，并标明检查结果高于或低于正常值范围的描述符。","rationale":"安全性终点明确列出肝肾功能、电解质实验室指标及12导联心电图；V0访视列出实验室、NT-proBNP、ECG；排除标准给出eGFR和ALT/AST阈值。但完整实验室检查项目清单、各访视具体检测项目、采血时间点及正常值范围未由项目文件明确，需医学经理确认。公司语料中实验室异常记录方式仅作结构参照，不构成本项目已确认规则。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97c9c19afb20_861d4c9266c8b8da","section_number":"14.2","source_ids":["protocol_full_draft_selection:7720e381752f2a124f168f59","current_project_study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1d8a6d3b64541","company_corpus:cms_cn_protocol_corpus_20260715_v1:76a6125fa7dca4","company_corpus:cms_cn_protocol_corpus_20260715_v1:eed6fd877d0a24","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb5ffffeb64ac7","company_corpus:cms_cn_protocol_corpus_20260715_v1:20ca67d1098144"]},{"ai_run_id":"airun_20261003190509_ca6c79d2","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"需本项目专属的AE/SAE/SUSAR定义文件，明确因果关系判定标准、严重程度分级、预期性判定依据","category":"source_missing","gap_id":"gap_safety_001","missing_source_classes":["项目AE/SAE/SUSAR定义文件","研究者手册（IB）"],"target":"14.3节AE/SAE/SUSAR定义与分类"},{"action":"需确认SAE报告时限（获知后24小时或7天）、报告对象（申办者、伦理委员会、省级药监部门）、SUSAR报告流程及紧急破盲后安全信息处理","category":"source_missing","gap_id":"gap_safety_002","missing_source_classes":["安全信息报告SOP","伦理委员会报告要求","药监报告要求"],"target":"14.3节报告时限与报告对象"},{"action":"需确认安全事件在eCRF中的记录方式、实验室异常是否作为AE记录、症状性低血压与体位性低血压的采集与报告规则","category":"source_missing","gap_id":"gap_safety_003","missing_source_classes":["eCRF填写指南","安全性数据采集规范"],"target":"14.3节eCRF记录规则"}],"heading":"安全信息报告途径","missing_source_classes":["本项目AE/SAE/SUSAR定义及分类标准","安全事件报告时限与报告对象","eCRF安全事件记录规则","SUSAR报告流程"],"proposal_text":"","rationale":"安全信息报告途径章节需要本项目专属的AE/SAE/SUSAR定义、报告时限、报告对象、报告格式及eCRF记录规则。公司语料中CMD-D001-AD方案（阿尔茨海默病适应症）的24小时报告要求及ICH GCP通用AE定义仅作监管语境结构参照，不可迁移为本项目已确认规则。本项目研究定义仅列出安全性终点类别（AE/SAE发生率、症状性低血压、生命体征、肝肾功能、心电图），未给出报告途径、时限、对象及记录方式。","review_advisories":["本节复述高影响研究设计（安全信息报告途径）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97c9c19afb20_943f8e7cdf2386f1","section_number":"14.3","source_ids":["protocol_full_draft_selection:7720e381752f2a124f168f59","current_project_study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1d8a6d3b64541","company_corpus:cms_cn_protocol_corpus_20260715_v1:76a6125fa7dca4","company_corpus:cms_cn_protocol_corpus_20260715_v1:eed6fd877d0a24","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb5ffffeb64ac7","company_corpus:cms_cn_protocol_corpus_20260715_v1:20ca67d1098144"]},{"ai_run_id":"airun_20261003190509_ca6c79d2","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"需确认本项目附录应包含哪些内容（实验室正常值范围、合并用药清单、剂量调整算法、CRF指南、破盲流程等），以及各附录内容的具体来源文件","category":"source_mis