"ae2e5ed819c840f883cc928c6e69bc3fbdbb3327977aeffb86a679b27700b0e5","locator":"section:不良事件的收集与记录|block:713|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:100e0300d2949b","source_type":"company_protocol_reference_corpus","source_version":"100e0300d2949b","text_sha256":"ae2e5ed819c840f883cc928c6e69bc3fbdbb3327977aeffb86a679b27700b0e5"}]}