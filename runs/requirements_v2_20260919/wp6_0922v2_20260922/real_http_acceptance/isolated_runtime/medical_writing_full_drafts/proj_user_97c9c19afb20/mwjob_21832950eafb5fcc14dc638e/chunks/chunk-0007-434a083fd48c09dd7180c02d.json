easons":[],"section_id":"mwsec_greenfield_proj_user_97c9c19afb20_bcb4100c8c2dea58","section_number":"6.4","source_ids":["protocol_full_draft_selection:434a083fd48c09dd7180c02d","current_project_study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef"]},{"ai_run_id":"airun_20261003181252_89764ec8","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:revision:7","quote":"KZ-sGC101片剂每日一次口服，设低/中/高三个剂量水平，双盲双模拟，治疗期12周，联合标准GDMT背景治疗。","quote_sha256":"f66e10b25038be50d3983abdd7028f8ac15133d03edd23bde9d75d53a1406970","source_id":"current_project_study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef","span_id":"es_02"},{"locator":"study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:revision:7","quote":"低剂量2.5 mg qd、中剂量5 mg qd、高剂量10 mg qd，每日晨起随餐口服；每4周随访评估耐受性，按方案规定进行剂量调整。","quote_sha256":"bc46ea689321db30ef5b0f1d4b4370355d0976959c3d8ff7363bb7be55d830d7","source_id":"current_project_study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef","span_id":"es_03"},{"locator":"study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:revision:7","quote":"V1随机入组（D0）：发放研究药、依从性宣教","quote_sha256":"5f379cdf96dd533a96cf2cc02ded20b3f4b6d627f4777649aed94e6cae9fed6b","source_id":"current_project_study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef","span_id":"es_04"},{"locator":"study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:revision:7","quote":"V2（W4）：疗效与安全性评价、剂量耐受评估","quote_sha256":"075f283fdd029af5d2ced944ae24d0af24c24a27b6879659196bd4a9fc820ccd","source_id":"current_project_study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef","span_id":"es_05"}],"evidence_review_advisories":[],"evidence_span_ids":["es_02","es_03","es_04","es_05"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"确认依从性监测方法（药物回收计数、电子服药日志或其他）、合格阈值及记录工具","category":"source_missing","gap_id":"gap_65_01","missing_source_classes":["依从性管理SOP","依从性评价方法与阈值文件"],"target":"6.5 研究治疗依从性 依从性评价方法与合格阈值"},{"action":"确认CRF或电子日志中依从性数据的记录方式、报告频率及不依从事件的处理流程","category":"source_missing","gap_id":"gap_65_02","missing_source_classes":["CRF或电子日志记录规范"],"target":"6.5 研究治疗依从性 依从性记录与报告"}],"heading":"研究治疗依从性","missing_source_classes":["依从性管理SOP","依从性评价方法与阈值文件","CRF或电子日志记录规范"],"proposal_text":"本研究采用口服双盲双模拟设计，KZ-sGC101片剂与外观及气味一致的安慰剂模拟片均于每日晨起随餐口服，治疗期为12周。受试者于随机入组访视接受研究药物发放及依从性宣教，此后于第4周访视接受疗效与安全性评价及剂量耐受评估。依从性监测贯穿整个双盲治疗期，研究者于每次访视时核查受试者自上次访视以来的用药记录与剩余药物数量，以评估实际给药依从情况。依从性评价的具体方法、合格阈值及记录工具由项目依从性管理文件规定。","rationale":"已确认事实支持：口服每日一次随餐给药、双盲双模拟设计、12周治疗期、V1发放研究药与依从性宣教、V2至V4每4周随访含耐受评估。依从性监测方法（药物回收计数或电子日志）、合格阈值（如≥80%）及记录工具未在项目来源中明确，需医学经理确认后方可定稿。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97c9c19afb20_848421bfa3519595","section_number":"6.5","source_ids":["protocol_full_draft_selection:434a083fd48c09dd7180c02d","current_project_study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef"]}],"source_bindings":[{"content_sha256":"7b9eaaf841a5290af9438005a8a5e995cafb3f12c875adbd2c5782d2055e785b","locator":"document:mwdoc_greenfield_proj_user_97c9c19afb20_3ca0b7d63139a40d:full-draft:434a083fd48c09dd7180c02d","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:434a083fd48c09dd7180c02d","source_type":"protocol_full_draft_selection","source_version":"full-draft:37951f01a223f5139db92d521476f5a2fe19794aed517dcc7c13c280f135381c:434a083fd48c09dd7180c02d","text_sha256":"7b9eaaf841a5290af9438005a8a5e995cafb3f12c875adbd2c5782d2055e785b"},{"content_sha256":"00e5e1415979e8e30a0f6d769ecb81b21eba15336144284b187fc19d0f5e571f","locator":"study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:revision:7","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef","source_type":"current_project_study_definition","source_version":"mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef","text_s