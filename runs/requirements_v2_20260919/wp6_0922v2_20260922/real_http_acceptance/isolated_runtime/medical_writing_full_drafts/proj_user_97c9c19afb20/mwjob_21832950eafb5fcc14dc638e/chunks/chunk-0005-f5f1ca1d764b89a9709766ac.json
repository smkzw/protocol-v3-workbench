任何研究暂停或终止的具体触发标准、安全性阈值或无效性边界。研究药物KZ-sGC101的已知风险特征、非临床安全性数据及既往临床安全性信息均未在允许来源中提供，无法据此制定有实质内容的暂停/终止条款。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97c9c19afb20_cb8f44d3a0f73075","section_number":"4.7","source_ids":["protocol_full_draft_selection:f5f1ca1d764b89a9709766ac","current_project_study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]},{"ai_run_id":"airun_20261003180122_782c36fd","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:revision:7","quote":"慢性稳定性HFrEF成人患者（年龄18-75岁，LVEF≤40%，NYHA II-III级），已接受稳定剂量指南导向药物治疗（GDMT，含ACEI/ARB/ARNI、β受体阻滞剂、MRA，有指征者加用SGLT2抑制剂）至少4周仍症状未控制","quote_sha256":"acfcc641a967a994a8dc43110a41d97721a93975df0b244691ede7b66c58c4ed","source_id":"current_project_study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef","span_id":"es2"}],"evidence_review_advisories":[],"evidence_span_ids":["es2"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[{"action":"检索项目级筛选操作手册或中心启动文件，确认各中心筛选期具体检查项目、复测规则及知情同意操作细节","category":"source_not_retrieved","gap_id":"gap_5_01","missing_source_classes":["项目筛选操作手册","中心启动文件"],"target":"5 研究人群"}],"heading":"研究人群","missing_source_classes":[],"proposal_text":"本研究计划纳入慢性稳定性射血分数降低的心力衰竭（HFrEF）成人受试者。入选人群须满足以下条件：年龄18至75岁，性别不限；经超声心动图评估左室射血分数（LVEF）≤40%，且纽约心脏协会（NYHA）心功能分级为II至III级；筛选前已接受稳定剂量指南导向药物治疗（GDMT）至少4周，GDMT方案包含血管紧张素转换酶抑制剂或血管紧张素受体拮抗剂或血管紧张素受体脑啡肽酶抑制剂（ACEI/ARB/ARNI）、β受体阻滞剂及盐皮质激素受体拮抗剂（MRA），有指征者加用钠-葡萄糖协同转运蛋白2（SGLT2）抑制剂，但上述治疗后仍残留心衰症状。排除标准涵盖：筛选前90天内因急性心衰失代偿住院，或30天内发生急性冠脉综合征、经皮冠脉介入治疗或冠脉搭桥术；合并使用硝酸酯类或磷酸二酯酶5抑制剂；估算肾小球滤过率（eGFR）<30 mL/min/1.73m²；丙氨酸氨基转移酶或天冬氨酸氨基转移酶>3倍正常值上限；妊娠或哺乳期女性。","rationale":"入选与排除标准直接来源于项目已确认研究事实中的研究人群概述及排除标准模块。各中心具体筛选操作流程、知情同意实施细节及筛选期检查项目清单需由医学经理结合中心实际确认。","review_advisories":["本节复述高影响研究设计（研究人群）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97c9c19afb20_6a105d6130e4d9fc","section_number":"5","source_ids":["protocol_full_draft_selection:f5f1ca1d764b89a9709766ac","current_project_study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]},{"ai_run_id":"airun_20261003180122_782c36fd","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:revision:7","quote":"II期探索性设计：每组约60例（共约240例），基于NT-proBNP组间差值的文献效应量与80%把握度估算，用于概念验证与剂量选择，不作确证性结论","quote_sha256":"d85a5c65808ba6922dccfec0591435cfe14a0fde5542ed1cc1dd5ed50fd2e6a4","source_id":"current_project_study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef","span_id":"es3"}],"evidence_review_advisories":[],"evidence_span_ids":["es3"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[],"heading":"计划入组人数","missing_source_classes":[],"proposal_text":"本研究为II期探索性设计，计划入组约240例受试者，按1:1:1:1比例随机分配至KZ-sGC101低剂量组（2.5 mg每日一次）、中剂量组（5 mg每日一次）、高剂量组（10 mg每日一次）及安慰剂对照组，每组约60例。样本量估算基于NT-proBNP组间差值的文献效应量，设定80%把握度，用于概念验证与剂量选择，不作确证性结论。","rationale":"样本量、分组比例、剂量水平及估算依据均直接来源于项目已确认研究事实。所引用的文献效应量具体出处及假设参数需医学经理核实其是否适用于KZ-sGC101在HFrEF中的预期效应。","review_advisories":["本节提及高影响设计信息（剂量选择、样本量、计划入组）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97c9c19afb20_6a9c2b6823a8948e","section_number":"5.1","source_ids":["protocol_full_draft_selection:f5f1ca1d764b89a9709766ac","current_project_study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]},{"ai_run_id":"airun_20261003180122_782c36fd","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"检索项目级筛选操作手册，确认是否将LVEF复测、NT-proBNP复测等心衰特异性检查纳入允许重复检查范围，以及重新筛选的有效期规则","category":"source_not_retrieved","gap_id":"gap_5_5_01","missing_source_classes":["项目筛选操作手册","中心启动文件"],"target":"5.5 筛选失败与重新筛选"},{"action":"确认重新筛选时是否需重新签署知情同意书及原知情同意书的效力终止规则","category":"source_not_retrieved","gap_id":"gap_5_5_02","missing_source_classes":["项目知情同意操作规范"],"target":"5.5 筛选失败与重新筛选"}],"heading":"筛选失败与重新筛选","missing_source_classes":["项目筛选操作手册","中心启动文件","项目知情同意操作规范"],"proposal_text":"","rationale":"筛选失败与重新筛选属于研究实施规则，需由项目级操作文件直接规定。公司共享语料中的通用定义和规则仅作为章节结构参照，不得直接决定本项目的筛选操作规则。本项目缺少项目级筛选操作手册或中心启动文件，无法确认HFrEF特异性复测项目（如LVEF复测、NT-proBNP复测）是否纳入允许重复检查范围，也无法确认重新筛选的有效期、是否需重新签署知情同意书及各中心操作时限。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97c9c19afb20_8d5d0c84f139f48a","section_number":"5.5","source_ids":["protocol_full_draft_selection:f5f1ca1d764b89a9709766ac","current_project_study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]}],"source_bindings":[{"content_sha256":"4a36d5044d567b3b361ada74cbb4cfb8ae1f42676ca5de818a738efcda7790e2","locator":"document:mwdoc_greenfield_proj_user_97c9c19afb20_3ca0b7d63139a40d:full-draft:f5f1ca1d764b89a9709766ac","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:f5f1ca1d764b89a9709766ac","source_type":"protocol_full_draft_selection","source_version":"full-draft:37951f01a223f5139db92d521476f5a2fe19794aed517dcc7c13c280f135381c:f5f1ca1d764b89a9709766ac","text_sha256":"4a36d5044d567b3b361ada74cbb4cfb8ae1f42676ca5de818a738efcda7790e2"},{"content_sha256":"00e5e1415979e8e30a0f6d769ecb81b21eba15336144284b187fc19d0f5e571f","locator":"study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:revision:7","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_3dde4168e2fcd3ecbf9f:r7:04624e78a95822ef","source_type":"current_project_study_definition","source_version":"mwdefinition_3dde4168e2fcd3ecbf9f:r7:0462