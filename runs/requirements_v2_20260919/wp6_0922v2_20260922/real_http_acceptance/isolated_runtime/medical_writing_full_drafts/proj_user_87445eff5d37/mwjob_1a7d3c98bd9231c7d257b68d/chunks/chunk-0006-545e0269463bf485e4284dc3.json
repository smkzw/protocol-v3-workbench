的入选标准模块，数值与表述与项目定义一致。医学经理需确认：GDMT具体涵盖的药物类别（如ARNI/ACEI/ARB、β受体阻滞剂、MRA、SGLT2抑制剂等）及'稳定剂量'的判定标准是否需在方案正文或附录中逐项列明；ECHO评估的质控要求与NYHA分级的判定主体是否需另行规定。","review_advisories":["本节复述高影响研究设计（入选标准）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_87445eff5d37_9552a4d77627f4bb","section_number":"5.3","source_ids":["protocol_full_draft_selection:545e0269463bf485e4284dc3","current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]},{"ai_run_id":"airun_20261006101653_49840c5f","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"需由医学经理或方案撰写团队提供本项目筛选失败定义、重复检查次数与条件、重新筛选触发条件及编号管理规则的项目专属文件","category":"source_missing","gap_id":"gap_screening_failure_rules","missing_source_classes":["本项目筛选失败与重新筛选实施规则文件"],"target":"5.5节正文"}],"heading":"筛选失败与重新筛选","missing_source_classes":["本项目筛选失败与重新筛选实施规则文件","筛选期实验室检查重复与重新筛选操作规范"],"proposal_text":"","rationale":"本章节需要本项目专属的筛选失败定义、筛选期间重复检查规则、重新筛选的触发条件与编号管理规则。公司语料中CMD-D001-AD II期方案含有相关条款，但该来源为跨适应症（非心衰）研究，按语料泛化规则仅可用于章节结构参照，不得迁移为本项目的研究实施规则。当前项目已确认研究事实中未包含筛选失败与重新筛选的具体条款。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_87445eff5d37_a76fd474433737e2","section_number":"5.5","source_ids":["protocol_full_draft_selection:545e0269463bf485e4284dc3","current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]},{"ai_run_id":"airun_20261006101653_49840c5f","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_7caf4ee56243f34753ab:revision:6","quote":"总体研究设计：随机、双盲、安慰剂对照、平行组、多中心；II期概念验证+剂量探索，KZ-sGC601三个剂量组与安慰剂对照，治疗12周","quote_sha256":"d1be9793bd83d559b42919a7c52f3efa557e9a01c7270f87803076d51812192d","source_id":"current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","span_id":"es_treatment_design"},{"locator":"study_definition:mwdefinition_7caf4ee56243f34753ab:revision:6","quote":"剂量与给药方案：SMOKE-r6-1X口服sGC刺激剂（KZ-sGC601）：低剂量2.5 mg qd、中剂量5 mg qd、高剂量10 mg qd，每日晨起随餐口服；每4周随访评估耐受性，按方案规定剂量调整。","quote_sha256":"c467acc7d3fbddf5d2adba46af7a7f5739097edefc8ce0c4dde1456608b6eb94","source_id":"current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","span_id":"es_dose_regimen"},{"locator":"study_definition:mwdefinition_7caf4ee56243f34753ab:revision:6","quote":"安慰剂平行对照：外观与气味与试验药一致的模拟片，每日一次，给药与访视安排同试验组，联合相同GDMT背景，按1:1:1:1随机分配。","quote_sha256":"be1f2f8d5224812fb65406cf191b819e4bb7668a1995791a1358f3ee011d1fcc","source_id":"current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","span_id":"es_placebo_control"},{"locator":"study_definition:mwdefinition_7caf4ee56243f34753ab:revision:6","quote":"试验干预：KZ-sGC601片剂每日一次口服，低/中/高三个剂量水平，双盲双模拟，治疗期12周，联合标准GDMT背景治疗。","quote_sha256":"bcd5bdb18903988a6619b839d34617e409c42bc97bac0b58031ac11d168e0e9c","source_id":"current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","span_id":"es_trial_intervention"}],"evidence_review_advisories":[],"evidence_span_ids":["es_treatment_design","es_dose_regimen","es_placebo_control","es_trial_intervention"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"需补充本项目剂量调整的触发条件（如症状性低血压阈值）、调整幅度、恢复条件及永久停药标准","category":"source_missing","gap_id":"gap_dose_adjustment_rules","missing_source_classes":["剂量调整/暂停/恢复/永久停药具体规则"],"target":"6节正文'剂量调整'相关段落"},{"action":"需确认双模拟片剂的具体规格、数量及匹配方式，以及盲态维持与紧急揭盲流程","category":"source_missing","gap_id":"gap_double_dummy_detail","missing_source_classes":["双盲双模拟实施操作细则"],"target":"6节正文双盲双模拟描述"}],"heading":"研究治疗/干预","missing_source_classes":["剂量调整/暂停/恢复/永久停药具体规则","双盲双模拟实施操作细则"],"proposal_text":"本研究为随机、双盲、安慰剂对照、平行组、多中心II期临床研究，旨在进行概念验证与剂量探索。受试者按1:1:1:1的比例随机分配至KZ-sGC601低剂量组（2.5 mg每日一次）、中剂量组（5 mg每日一次）、高剂量组（10 mg每日一次）或安慰剂组，治疗期共12周。所有组别均联合标准GDMT背景治疗。KZ-sGC601为口服固体制剂，每日晨起随餐口服；安慰剂为外观与气味与试验药一致的模拟片，每日一次，给药与访视安排同试验组。采用双盲双模拟设计，受试者与研究者均不知晓具体分组。每4周随访评估耐受性，剂量调整按方案规定执行。","rationale":"研究设计类型、随机比例、三个剂量水平及安慰剂对照信息均来源于当前项目已确认研究事实中的总体研究设计、试验干预、剂量与给药方案及安慰剂条目。'按方案规定剂量调整'的具体触发条件、调整幅度、恢复与永久停药规则未在允许来源中给出，需后续补充。双盲双模拟的具体实施细节（如双模拟片剂数量、匹配方式）需医学经理确认。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_87445eff5d37_d3a6bd18a9c92fd9","section_number":"6","source_ids":["protocol_full_draft_selection:545e0269463bf485e4284dc3","current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]},{"ai_run_id":"airun_20261006101653_49840c5f","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_7caf4ee56243f34753ab:revision:6","quote":"试验药物：SMOKE-r6-1X口服sGC刺激剂（KZ-sGC601）","quote_sha256":"b3209b8014ed9c2be2a20adb96b313544d0a842e55d14ab82bea76601054062d","source_id":"current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","span_id":"es_drug_identity"},{"locator":"study_definition:mwdefinition_7caf4ee56243f34753ab:revision:6","quote":"药物技术类型：small_molecule\n给药途径：口服\n剂型：口服固体制剂\n局部/系统暴露范围：systemic","quote_sha256":"93d70823288385813f38b773b8c6e7bba227a7ed893796844d8834e9f3bae884","source_id":"current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","span_id":"es_drug_tech"}],"evidence_review_advisories":[],"evidence_span_ids":["es_drug_identity","es_drug_tech"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"需补充KZ-sGC601的sGC刺激作用机制、非临床药理学/毒理学摘要及既往临床安全性数据","category":"source_missing","gap_id":"gap_drug_mechanism","missing_source_classes":["研究者手册（IB）","非临床药理学与毒理学资料","既往人体研究数据"],"target":"6.1节药物特征与机制描述"},{"action":"需从IB中提取已知安全性风险、禁忌及注意事项","category":"source_missing","gap_id":"gap_drug_safety_profile","missing_source_classes":["研究者手册（IB）"],"target":"6.1节安全性概述"}],"heading":"试验用药品","missing_source_classes":["研究者手册（IB）","KZ-sGC601作用机制与非临床资料","既往人体研究数据"],"proposal_text":"本研究试验用药品为SMOKE-r6-1X口服sGC刺激剂（KZ-sGC601），属小分子化合物，给药途径为口服，剂型为口服固体制剂（片剂），系统暴露。安慰剂为外观与气味与KZ-sGC601片剂一致的模拟片。","rationale":"药物名称、技术类型（small_molecule）、给药途径（口服）、剂型（口服固体制剂）及暴露范围（systemic）均来源于当前项目已确认研究事实。本章节尚缺少KZ-sGC601的sGC刺激作用机制描述、非临床药理学与毒理学摘要、既往人体研究数据及研究者手册（IB）中的安全性概述，无法形成完整的药物特征与安全性信息段落。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_87445eff5d37_2f7465d91b4dfdf0","section_number":"6.1","source_ids":["protocol_full_draft_selection:545e0269463bf485e4284dc3","current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]}],"source_bindings":[{"content_sha256":"a408a6df5a327fa2c53d3c36dfa3571ef0e080ef9f7e99d5abd7a286bfeb3737","locator":"document:mwdoc_greenfield_proj_user_87445eff5d37_b8c9b3f47b0875c6:full-draft:545e0269463bf485e4284dc3","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:545e0269463bf485e4284dc3","source_type":"protocol_full_draft_selection","source_version":"full-draft:25a7217475b50b466cc6b697814dfa2235e5469cc4b976bd0f382ab589d56d96:545e0269463bf485e4284dc3","text_sha256":"a408a6df5a327fa2c53d3c36dfa3571ef0e080ef9f7e99d5abd7a286bfeb3737"},{"content_sha256":"45ac26fc10926c13572b30670ac47eb806a07665e78bfee4d62ec8ceeaf701a9","locator":"study_definition:mwdefinition_7caf4ee56243f34753ab:revision:6","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","source_type":"current_project_study_definition","source_version":"mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","text_sha256":"45ac26fc10926c13572b30670