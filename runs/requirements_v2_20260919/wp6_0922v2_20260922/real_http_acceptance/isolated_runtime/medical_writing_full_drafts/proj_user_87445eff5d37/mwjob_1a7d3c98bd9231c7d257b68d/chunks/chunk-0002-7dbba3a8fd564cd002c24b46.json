id":"es_007"}],"evidence_review_advisories":[],"evidence_span_ids":["es_001","es_004","es_005","es_007"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"确认是否设置次要目的与次要终点（如NT-proBNP绝对变化、NYHA分级变化、6分钟步行距离、心衰住院率等），若设置则明确定义与评价时点","category":"source_missing","gap_id":"gap_3_01","missing_source_classes":["次要目的与次要终点定义"],"target":"3 研究目的和终点——次要目的与次要终点"},{"action":"确认本研究是否设置探索性目的与终点；若不设置则明确声明本研究不设置探索性目的与终点","category":"source_missing","gap_id":"gap_3_02","missing_source_classes":["探索性目的与终点定义"],"target":"3 研究目的和终点——探索性目的与终点"}],"heading":"研究目的和终点","missing_source_classes":["次要目的与次要终点定义","探索性目的与终点定义"],"proposal_text":"本研究为II期概念验证与剂量探索研究，主要目的为评估口服sGC刺激剂KZ-sGC601在慢性稳定性HFrEF成人患者中降低NT-proBNP的初步疗效信号，并探索2.5 mg、5 mg、10 mg三个剂量水平与安慰剂之间的剂量-反应关系，为后续确证性研究提供剂量选择依据。主要终点为第12周NT-proBNP较基线的百分比变化，评价时间点为基线、第4周、第8周和第12周。安全性评价内容包括不良事件与严重不良事件发生率、症状性低血压与体位性低血压、生命体征（血压、心率）、肝肾功能与电解质实验室指标及12导联心电图。主要分析集为全分析集，主要终点采用以基线NT-proBNP为协变量的ANCOVA并检验剂量-反应趋势，安全性数据采用描述统计，次要终点按预先设定的层级顺序分析。","rationale":"本章节依据已确认研究事实撰写：研究目的（PoC与剂量探索）、主要终点（第12周NT-proBNP百分比变化）、评价时点（基线/第4/8/12周）、安全性终点清单、分析集与统计方法。次要目的与次要终点、探索性目的与终点在允许来源中未明确列出，需医学经理确认是否设置及具体内容。","review_advisories":["本节复述高影响研究设计（研究目的和终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、剂量选择）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_87445eff5d37_1891dcac9ce48912","section_number":"3","source_ids":["protocol_full_draft_selection:7dbba3a8fd564cd002c24b46","current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261006100456_57d217d7","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_7caf4ee56243f34753ab:revision:6","quote":"主要终点：主要终点：第12周NT-proBNP较基线的百分比变化（双盲期）。评价时间点：基线、第4/8/12周。","quote_sha256":"161db75499e2f57b4c26d1e22eabe8a3ca40273b7dc79a8bf7277c712e931de9","source_id":"current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","span_id":"es_004"},{"locator":"study_definition:mwdefinition_7caf4ee56243f34753ab:revision:6","quote":"样本量策略：II期探索性设计：每组约60例（共约240例），基于NT-proBNP组间差值文献效应量与80%把握度估算，用于概念验证与剂量选择。","quote_sha256":"5f598e1d608dd27ea2bd6080417002fe0f5e763c866e33ca8a5c13c697490e10","source_id":"current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","span_id":"es_006"},{"locator":"study_definition:mwdefinition_7caf4ee56243f34753ab:revision:6","quote":"统计分析策略：FAS为主要分析集；主要终点NT-proBNP百分比变化采用ANCOVA（基线校正）并检验剂量-反应趋势；安全性采用描述统计；次要终点按预先层级顺序分析。","quote_sha256":"9cf37f0df8f4d6bd00beb8c92cebe88f07431911c16227896760d446ca13e075","source_id":"current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","span_id":"es_007"},{"locator":"study_definition:mwdefinition_7caf4ee56243f34753ab:revision:6","quote":"试验干预：KZ-sGC601片剂每日一次口服，低/中/高三个剂量水平，双盲双模拟，治疗期12周，联合标准GDMT背景治疗。","quote_sha256":"bcd5bdb18903988a6619b839d34617e409c42bc97bac0b58031ac11d168e0e9c","source_id":"current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","span_id":"es_009"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004","es_006","es_007","es_009"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"确认NT-proBNP百分比变化是否具有预设的临床意义阈值或仅作为连续变量分析","category":"source_missing","gap_id":"gap_3_1_01","missing_source_classes":["NT-proBNP替代终点文献支持"],"target":"3.1 主要目的和主要终点——NT-proBNP临床意义阈值"},{"action":"确认ANCOVA协变量选择（除基线NT-proBNP外是否纳入其他协变量）及剂量-反应趋势检验的具体方法","category":"source_missing","gap_id":"gap_3_1_02","missing_source_classes":["统计分析计划（SAP）"],"target":"3.1 主要目的和主要终点——统计方法细节"}],"heading":"主要目的和主要终点","missing_source_classes":["NT-proBNP临床意义阈值定义","ANCOVA协变量详细选择依据","剂量-反应趋势检验具体方法"],"proposal_text":"本研究的主要目的为评估KZ-sGC601在慢性稳定性HFrEF成人患者中降低NT-proBNP的初步疗效信号，并探索三个剂量水平（2.5 mg、5 mg、10 mg每日一次）与安慰剂之间的剂量-反应关系。主要终点为第12周NT-proBNP较基线的百分比变化，在双盲期内评价。NT-proBNP采集时间点为基线（随机入组前）、第4周、第8周和第12周。主要分析集为全分析集，主要终点分析采用以基线NT-proBNP为协变量的协方差分析，同时检验剂量-反应趋势。","rationale":"本章节依据已确认研究事实撰写：主要终点为第12周NT-proBNP较基线百分比变化（双盲期），评价时点为基线、第4/8/12周；主要分析集为FAS；统计方法为ANCOVA（基线校正）并检验剂量-反应趋势；三个剂量组与安慰剂1:1:1:1随机分配。NT-proBNP作为HFrEF替代终点的临床意义阈值、ANCOVA具体协变量选择及趋势检验方法需医学与统计团队联合确认。","review_advisories":["本节复述高影响研究设计（主要目的和主要终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_87445eff5d37_d51a426c7648abaf","section_number":"3.1","source_ids":["protocol_full_draft_selection:7dbba3a8fd564cd002c24b46","current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]}],"source_bindings":[{"content_sha256":"17a074f635ad8318a9393750da743047b3a80751b8ab33994d3912f3e875f6d5","locator":"document:mwdoc_greenfield_proj_user_87445eff5d37_b8c9b3f47b0875c6:full-draft:7dbba3a8fd564cd002c24b46","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:7dbba3a8fd564cd002c24b46","source_type":"protocol_full_draft_selection","source_version":"full-draft:25a7217475b50b466cc6b697814dfa2235e5469cc4b976bd0f382ab589d56d96:7dbba3a8fd564cd002c24b46","text_sha256":"17a074f635ad8318a9393750da743047b3a80751b8ab33994d3912f3e875f6d5"},{"content_sha256":"45ac26fc10926c13572b30670ac47eb806a07665e78bfee4d62ec8ceeaf701a9","locator":"study_definition:mwdefinition_7caf4ee56243f34753ab:revision:6","role":"co