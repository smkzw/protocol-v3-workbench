proj_user_87445eff5d37_b8c9b3f47b0875c6:full-draft:a38521b8470066b3c3f603bd","quote":"SECTION_ID=mwsec_greenfield_proj_user_87445eff5d37_1b5e314aaf20ddba\n章节编号=12.6\n章节标题=研究和研究中心的关闭\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"a229bd27da6eff6a28c2301adf3bc8c4656c6c2c633217234936bf1cfe8aeb4a","source_id":"protocol_full_draft_selection:a38521b8470066b3c3f603bd","span_id":"es3_section_packet"}],"evidence_review_advisories":[],"evidence_span_ids":["es1_study_design","es6_study_periods","es3_section_packet"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"补充项目执行层面的中心关闭标准操作规程或申办方SOP","category":"source_missing","gap_id":"gap_12_6_01","missing_source_classes":["研究中心关闭操作程序文件"],"target":"研究中心关闭的具体操作程序与时限"},{"action":"确认是否设置独立安全监测委员会及提前终止标准","category":"source_missing","gap_id":"gap_12_6_02","missing_source_classes":["提前终止标准与决策流程文件"],"target":"提前终止的量化触发条件与决策层级"},{"action":"补充数据管理计划及记录保存政策","category":"source_missing","gap_id":"gap_12_6_03","missing_source_classes":["数据管理与锁定规程","记录保存与归档政策"],"target":"数据锁定流程与记录保存年限"}],"heading":"研究和研究中心的关闭","missing_source_classes":["研究中心关闭操作程序文件","提前终止标准与决策流程文件","数据管理与锁定规程","记录保存与归档政策"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂对照、平行组II期临床研究，涉及多个研究中心的同步启动与关闭。研究中心关闭程序应涵盖以下方面：研究提前终止或中心关闭的触发条件与决策流程；关闭前对受试者安全随访的完成安排，包括末次给药后2周安全随访期内尚未完成访视的受试者的后续处理；研究药物及安慰剂的剩余库存清点、回收与销毁记录；受试者原始医疗记录、知情同意文件及病例报告表的归档与保存；向伦理委员会和药品监督管理部门的关闭通知；数据锁定前对未解决安全性事件的确认与记录。研究中心关闭的具体操作时限、数据锁定流程、记录保存年限及提前终止的量化触发标准，需依据项目执行文件及适用法规进一步确定。","rationale":"研究设计确认为多中心、双盲、12周治疗加2周安全随访，安全随访期存在未关闭访视的受试者管理需求。但关闭程序的具体操作细节（提前终止标准、数据锁定、记录保存年限、通知时限）在允许来源中无对应规定，需项目执行文件补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_87445eff5d37_1b5e314aaf20ddba","section_number":"12.6","source_ids":["protocol_full_draft_selection:a38521b8470066b3c3f603bd","current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c"]},{"ai_run_id":"airun_20261006111840_537492a7","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_7caf4ee56243f34753ab:revision:6","quote":"总体研究设计：随机、双盲、安慰剂对照、平行组、多中心；II期概念验证+剂量探索，KZ-sGC601三个剂量组与安慰剂对照，治疗12周","quote_sha256":"d1be9793bd83d559b42919a7c52f3efa557e9a01c7270f87803076d51812192d","source_id":"current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","span_id":"es1_study_design"},{"locator":"study_definition:mwdefinition_7caf4ee56243f34753ab:revision:6","quote":"研究时期：筛选期（第-28至-1天）；12周双盲治疗期（第0天随机给药至第12周）；治疗结束访视（第12周±3天）；安全随访期（末次给药后2周）","quote_sha256":"10c99dea1b0a818522b70098d13975242ac4a1084684b588ce76dbdbb8237f6c","source_id":"current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","span_id":"es6_study_periods"},{"locator":"study_definition:mwdefinition_7caf4ee56243f34753ab:revision:6","quote":"安全性终点：不良事件与严重不良事件发生率；症状性低血压与体位性低血压；生命体征（血压、心率）；肝肾功能、电解质实验室指标；12导联心电图","quote_sha256":"e77501ca084e2f1e9fa18684d494f2252570a19a158da14e097274f13b01fb6b","source_id":"current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","span_id":"es7_safety_endpoints"},{"locator":"document:mwdoc_greenfield_proj_user_87445eff5d37_b8c9b3f47b0875c6:full-draft:a38521b8470066b3c3f603bd","quote":"SECTION_ID=mwsec_greenfield_proj_user_87445eff5d37_cd3fa26608bfb425\n章节编号=12.7\n章节标题=质量控制与保证\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"8f147f44d6cb9c4c68cd830c85e2547a665fa880115f0227c8ca19cc34fb7d1f","source_id":"protocol_full_draft_selection:a38521b8470066b3c3f603bd","span_id":"es4_section_packet_qc"}],"evidence_review_advisories":[],"evidence_span_ids":["es1_study_design","es6_study_periods","es7_safety_endpoints","es4_section_packet_qc"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"补充项目监查计划，明确各阶段监查频率与核查要点","category":"source_missing","gap_id":"gap_12_7_01","missing_source_classes":["监查计划与频率规定"],"target":"监查频率与监查内容清单"},{"action":"确认是否设置独立QA职能及稽查频率","category":"source_missing","gap_id":"gap_12_7_02","missing_source_classes":["项目质量管理计划","稽查计划"],"target":"质量保证稽查计划与职能分工"},{"action":"补充盲态维护操作规程，包括紧急揭盲流程","category":"source_missing","gap_id":"gap_12_7_03","missing_source_classes":["盲态维护操作规程"],"target":"双盲完整性维护的具体措施"}],"heading":"质量控制与保证","missing_source_classes":["项目质量管理计划","监查计划与频率规定","稽查计划","数据核查方法文件"],"proposal_text":"本研究为多中心、双盲、安慰剂对照设计，质量控制与保证体系应覆盖研究全过程，包括筛选期、12周双盲治疗期及末次给药后2周安全随访期。质量控制措施应确保各研究中心在受试者筛选、随机化、给药、安全性事件采集与报告、实验室检测及心电图评估等环节的操作一致性。质量保证活动应涵盖对研究中心的定期监查、对关键数据的独立核查、对方案偏离的识别与记录，以及对双盲完整性的维护。鉴于本研究为多中心设计且涉及三个剂量组与安慰剂组的1:1:1:1随机分配，各中心在药物发放、剂量调整执行及盲态维护方面的操作规范需通过培训与监查予以保障。具体的监查频率、稽查计划、质量保证职能分工及数据核查方法，需依据项目质量管理计划及适用法规进一步确定。","rationale":"研究设计确认多中心、双盲、1:1:1:1随机分配、12周治疗加2周安全随访，安全性评估涵盖AE/SAE、生命体征、实验室指标及心电图。但具体监查频率、稽查计划、QA职能分工及数据核查方法在允许来源中未规定。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_87445eff5d37_cd3fa26608bfb425","section_number":"12.7","source_ids":["protocol_full_draft_selection:a38521b8470066b3c3f603bd","current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c"]},{"ai_run_id":"airun_20261006111840_537492a7","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"由医学经理确认本方案附录应包含的文件种类与编号","category":"source_missing","gap_id":"gap_14_01","missing_source_classes":["附录文件清单"],"target":"附录文件清单及编号"},{"action":"补充知情同意书模板、实验室正常值范围、合并用药清单、CRF示例等文件","category":"source_missing","gap_id":"gap_14_02","missing_source_classes":["知情同意书模板","实验室正常值范围","合并用药清单","CRF示例"],"target":"各附录文件的具体内容"}],"heading":"附录","missing_source_classes":["附录文件清单","知情同意书模板","实验室正常值范围","合并用药清单"],"proposal_text":"","rationale":"附录章节需要列出本方案所附文件清单及其编号。当前允许来源仅确认了研究设计、药物、人群、终点和访视结构，但未提供附录应包含的具体文件清单（如知情同意书模板、实验室正常值范围、合并用药清单、CRF示例、研究者手册摘要、统计分析计划等）。在缺少附录文件清单来源的情况下，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_87445eff5d37_d218de972f4f4b49","section_number":"14","source_ids":["protocol_full_draft_selection:a38521b8470066b3c3f603bd","current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c"]},{"ai_run_id":"airun_20261006111840_537492a7","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"依据研究者手册中生殖毒性数据确定避孕方法要求","category":"source_missing","gap_id":"gap_14_1_01","missing_source_classes":["研究者手册（含生殖毒性数据）","避孕方法规定文件"],"target":"避孕方法种类与使用要求"},{"action":"补充妊娠检查与报告规程","category":"source_missing","gap_id":"gap_14_1_02","missing_source_classes":["妊娠检查与报告规程"],"target":"妊娠检查频率、时点及报告流程"},{"action":"确认是否设置伴侣妊娠报告及新生儿随访条款","category":"source_missing","gap_id":"gap_14_1_03","missing_source_classes":["妊娠检查与报告规程"],"target":"伴侣妊娠报告及新生儿随访要求"},{"action":"检索并补充KZ-sGC601或同类sGC刺激剂的非临床生殖毒性研究资料","category":"source_not_retrieved","gap_id":"gap_14_1_04","missing_source_classes":["既往非临床生殖毒性研究资料"],"target":"sGC刺激剂类既往非临床生殖毒性资料"}],"heading":"避孕的规定与方法","missing_source_classes":["研究者手册（含生殖毒性数据）","避孕方法规定文件","妊娠检查与报告规程","既往非临床生殖毒性研究资料"],"proposal_text":"","rationale":"排除标准确认妊娠或哺乳为排除条件，研究人群为18-75岁成人。但允许来源未规定具体避孕方法种类、妊娠检查频率与时点、伴侣妊娠报告要求、新生儿随访方案或避孕起始与终止时点。sGC刺激剂类药物的生殖毒性数据及相应避孕要求需参考研究者手册或既往非临床资料，当前允许来源未包含此类信息。在缺少避孕实施规则来源的情况下，不得将排除标准中的妊娠排除条件推断为具体避孕方案。","review_advisories":["本节复述高影响研究设计（避孕的规定与方法）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_87445eff5d37_a393d5c4561ebbf6","section_number":"14.1","source_ids":["protocol_full_draft_selection:a38521b8470066b3c3f603bd","current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c"]}],"source_bindings":[{"content_sha256":"28f8237c737c921b6374645ce1931bea7841c564c4ce579cbdcfa85043ccbe60","locator":"document:mwdoc_greenfield_proj_user_87445eff5d