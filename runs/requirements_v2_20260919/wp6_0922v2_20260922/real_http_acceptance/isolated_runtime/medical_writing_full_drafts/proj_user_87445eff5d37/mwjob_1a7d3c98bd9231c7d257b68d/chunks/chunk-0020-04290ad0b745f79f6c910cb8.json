s":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"确认方案偏离分类标准（重大偏离与一般偏离的界定）、报告时限及报告对象","category":"source_missing","gap_id":"gap_deviation_01","missing_source_classes":["项目方案偏离管理SOP"],"target":"12.4 方案偏离 方案偏离分类标准及报告时限"},{"action":"确认是否允许前瞻性偏离请求及处理流程","category":"source_missing","gap_id":"gap_deviation_02","missing_source_classes":["项目方案偏离管理SOP"],"target":"12.4 方案偏离 前瞻性偏离请求处理"}],"heading":"方案偏离","missing_source_classes":["项目方案偏离管理SOP或计划","方案偏离分类标准（重大/一般）","偏离报告时限及报告对象","前瞻性偏离请求处理规则"],"proposal_text":"","rationale":"公司语料中CMD-D001-AD方案提供了申办者审查方案偏离及评估GCP违背的通用结构，本章节据此结构撰写。但本项目未提供方案偏离分类标准、报告时限、伦理委员会及监管部门报告流程、前瞻性偏离请求处理规则等项目级实施细节，上述内容需医学经理确认是否引用公司通用SOP或需单独制定项目文件。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_87445eff5d37_6914c1fa61b60a13","section_number":"12.4","source_ids":["protocol_full_draft_selection:04290ad0b745f79f6c910cb8","current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261006111529_c59d2976","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:12.4 管理结构|block:957|chunk:1","quote":"申办者或其代理人将执行项目管理、研究管理、监查、供应商管理和统计编程。可使用IWRS进行参与者筛查和随机分组，以及研究药物申请和运输的管理。研究中心将负责生物样品在运输至申办者或其指定分析单位之前的保存。数据将使用eCRFs通过EDC系统记录，或以电子方式转发给申办者（例如，药代动力学数据）。","quote_sha256":"6c7271f4ed3fd8fedd8e75159484480005fc72345847383d098e28d5130237d6","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","span_id":"es_corpus_roles"},{"locator":"study_definition:mwdefinition_7caf4ee56243f34753ab:revision:6","quote":"总体研究设计：随机、双盲、安慰剂对照、平行组、多中心；II期概念验证+剂量探索，KZ-sGC601三个剂量组与安慰剂对照，治疗12周","quote_sha256":"d1be9793bd83d559b42919a7c52f3efa557e9a01c7270f87803076d51812192d","source_id":"current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","span_id":"es_study_def_design"},{"locator":"study_definition:mwdefinition_7caf4ee56243f34753ab:revision:6","quote":"FAS为主要分析集；主要终点NT-proBNP百分比变化采用ANCOVA（基线校正）并检验剂量-反应趋势；安全性采用描述统计；次要终点按预先层级顺序分析。","quote_sha256":"067b3f77e20da2222b9c91da7106a0b612b21542c62f4e68cae8bb2ae7c09367","source_id":"current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","span_id":"es_study_def_stats"},{"locator":"section:文档开头|block:4|chunk:1","quote":"本方案中所包含的所有信息归申办方所有，因此，仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构进行审阅。","quote_sha256":"a95f171292054da4c0e730a5808f9cf1db173b3e9368862f63a2a3c3172a88c6","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","span_id":"es_corpus_confidentiality"}],"evidence_review_advisories":[],"evidence_span_ids":["es_corpus_roles","es_study_def_design","es_study_def_stats","es_corpus_confidentiality"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":2},"gap_items":[{"action":"确认本项目是否使用IWRS及EDC系统，明确数据管理职责分工","category":"source_missing","gap_id":"gap_roles_01","missing_source_classes":["项目管理计划","数据管理计划"],"target":"12.5 关键角色和研究管理 数据管理系统及IWRS"},{"action":"确认研究者、监查员、数据管理员、统计师、中心实验室等角色的具体职责及签署要求","category":"source_missing","gap_id":"gap_roles_02","missing_source_classes":["项目管理计划","各职能SOP"],"target":"12.5 关键角色和研究管理 各角色职责分工"}],"heading":"关键角色和研究管理","missing_source_classes":["项目管理计划","数据管理系统确认（EDC/IWRS）","中心实验室及生物样品运输安排","统计编程供应商及职责"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂对照、平行组设计，由申办者负责整体项目管理与研究管理。申办者或其代理人将执行项目管理、研究管理、监查、供应商管理和统计编程。研究中心负责受试者筛选、知情同意、研究药物发放与受试者用药指导、不良事件观察与记录、生物样品采集及在运输至申办者或其指定分析单位之前的保存。数据记录采用电子数据采集系统，研究中心通过该系统录入受试者数据。本研究的统计分析以全分析集为主要分析集，主要终点NT-proBNP百分比变化采用协方差分析并检验剂量-反应趋势，安全性数据采用描述统计。本方案中所包含的所有信息归申办方所有，仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构进行审阅；在未得到申办方书面批准的情况下，严禁将任何信息告知与本研究无关的第三方。","rationale":"本章节依据公司语料中CMD-D001-AD方案的管理结构描述及MY004567方案的保密声明结构撰写。项目已确认事实支持多中心、双盲、安慰剂对照设计，FAS为主要分析集，NT-proBNP采用ANCOVA分析，安全性采用描述统计。但本项目未确认是否使用IWRS、具体数据管理系统、中心实验室安排、统计编程供应商、各角色具体职责分工及签署要求等实施细节。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。","本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_87445eff5d37_54c9984f6ee1880f","section_number":"12.5","source_ids":["protocol_full_draft_selection:04290ad0b745f79f6c910cb8","current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]}],"source_bindings":[{"content_sha256":"db0c702b59f2ddc24c96beb717acc5967f2abce5c8e3dac95d8c06913549e351","locator":"document:mwdoc_greenfield_proj_user_87445eff5d37_b8c9b3f47b0875c6:full-draft:04290ad0b745f79f6c910cb8","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:04290ad0b745f79f6c910cb8","source_type":"protocol_full_draft_selection","source_version":"full-draft:25a7217475b50b466cc6b697814dfa2235e5469cc4b976bd0f382ab589d56d96:04290ad0b745f79f6c910cb8","text_sha256":"db0c702b59f2ddc24c96beb717acc5967f2abce5c8e3dac95d8c06913549e351"},{"content_sha256":"45ac26fc10926c13572b30670ac47eb806a07665e78bfee4d62ec8ceeaf701a9","locator":"study_definition:mwdefinition_7caf4ee56243f34753ab:revision:6","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","source_type":"current_project_study_definition","source_version":"mwdefinition_7caf4ee56243f34753ab:r6:ab8a1fd8e763e40c","text_sha256":"45ac26fc10926c13572b30670ac47eb8