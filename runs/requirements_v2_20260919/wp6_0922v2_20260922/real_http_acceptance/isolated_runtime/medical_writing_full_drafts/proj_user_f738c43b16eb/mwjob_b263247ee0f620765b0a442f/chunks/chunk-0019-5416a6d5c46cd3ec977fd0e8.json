0eab4db03421cf0e1faa453fa9141924116638ec5","source_id":"current_project_study_definition:mwdefinition_24ae925c5f71136af903:r6:2324e1714eed68be","span_id":"es_project_multicenter"}],"evidence_review_advisories":[],"evidence_span_ids":["es_conf_01","es_conf_02","es_project_multicenter"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":1},"gap_items":[{"action":"获取本项目数据管理计划及电子数据采集系统安全规范","category":"source_missing","gap_id":"gap_privacy_01","missing_source_classes":["项目数据管理计划","电子数据采集系统安全规范"],"target":"保密与隐私章节中跨中心数据传输加密方式、电子数据采集系统访问权限控制及受试者去标识化方案"},{"action":"确认本项目合同架构中各参与方的保密义务范围","category":"source_not_retrieved","gap_id":"gap_privacy_02","missing_source_classes":["项目合同架构文件","CRO及供应商保密协议"],"target":"保密条款中'相关机构'是否涵盖CRO、中心实验室及数据管理供应商"}],"heading":"保密与隐私","missing_source_classes":["项目数据管理计划","电子数据采集系统安全规范","受试者隐私影响评估文件"],"proposal_text":"本方案及其附件中包含的全部信息，包括但不限于研究设计、药物信息、受试者数据及统计分析方法，其所有权归申办者所有。依据中国现行法律法规及药物临床试验质量管理规范的要求，本方案仅提供给参与本项目的研究者、合作研究者、伦理委员会及药品监督管理部门等相关机构进行审阅。除在与可能参加本研究的受试者签署知情同意书时向其做必要的方案解释外，未经申办者书面授权许可，任何个人和机构不得分发、复制、发表或向与本研究无关的第三方披露本方案中的任何内容。接收本方案信息的人员应当被告知其所接收的信息属于保密资料，不得进一步对外传播。本方案涉及多中心数据采集，各研究中心在超声心动图、NT-proBNP检测、心电图及实验室检查等过程中产生的受试者个人健康信息，应遵循最小必要原则进行采集、传输和存储，确保受试者隐私权益不受侵害。","rationale":"保密条款的限定审阅对象、禁止未经授权分发及知情同意例外等结构依据监管共性条款；多中心数据采集范围依据本项目已确认的访视策略（V0含ECHO、NT-proBNP、ECG）及多中心设计。需医学经理确认：跨中心数据传输中CRO、中心实验室及数据管理供应商是否纳入保密条款约束对象；受试者去标识化及电子数据访问权限控制的具体实施要求。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f738c43b16eb_8acae150aefa1644","section_number":"11.4","source_ids":["protocol_full_draft_selection:5416a6d5c46cd3ec977fd0e8","current_project_study_definition:mwdefinition_24ae925c5f71136af903:r6:2324e1714eed68be","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:3152bfe8bf762f","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8"]},{"ai_run_id":"airun_20261005230923_8d5165f5","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取本项目临床试验保险方案、受试者损害赔偿协议及申办者与研究中心责任划分文件","category":"source_missing","gap_id":"gap_ins_01","missing_source_classes":["临床试验保险方案","受试者损害赔偿协议","申办者与研究中心责任划分文件","理赔流程及争议解决机制"],"target":"保险与赔偿章节全部实施内容"}],"heading":"保险与赔偿","missing_source_classes":["临床试验保险方案","受试者损害赔偿协议","申办者与研究中心责任划分文件","理赔流程及争议解决机制"],"proposal_text":"","rationale":"保险与赔偿章节需要项目专属的保险类型（如临床试验责任险）、承保范围、赔偿限额、理赔流程、申办者与研究中心之间的责任划分、受试者因研究相关伤害的补偿机制及争议解决途径等具体条款。当前允许来源中无任何项目文件提供上述信息，公司语料中的保密声明和方案偏离条款均不涉及保险赔偿内容，无法据此形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f738c43b16eb_6ce889255f0e1916","section_number":"11.5","source_ids":["protocol_full_draft_selection:5416a6d5c46cd3ec977fd0e8","current_project_study_definition:mwdefinition_24ae925c5f71136af903:r6:2324e1714eed68be","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:3152bfe8bf762f","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8"]},{"ai_run_id":"airun_20261005230923_8d5165f5","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:参考文献：|block:48|chunk:1","quote":"国家药品监督管理局药品审评中心. 药物临床试验数据管理与统计分析计划指导原则. 2021年.","quote_sha256":"9a9f3dc0d904c2d48a939e7baaaaf39c4e89deb4067ed241f98001500d36bd56","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:3152bfe8bf762f","span_id":"es_dmg_01"},{"locator":"section:12.2 方案偏离|block:950|chunk:1","quote":"任何有意或无意偏离或违背研究方案和GCP原则的行为，均视为偏离方案或违背方案。监查员在监查过程中，如果发现偏离或违背方案，应由研究者或监查员填写偏离方案记录，详细记录事件发生的时间及过程、原因及相应的处理措施，由研究者签字，并根据研究中心相关规定通报伦理委员会及申办者。","quote_sha256":"451e8676a6664eec5d3e7aa873bed27c2ac49daf78a786b2c3641d3bb6d8250a","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8","span_id":"es_dev_01"}],"evidence_review_advisories":[],"evidence_span_ids":["es_dmg_01","es_dev_01"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":0},"gap_items":[{"action":"获取本项目监查计划及源数据核查方案","category":"source_missing","gap_id":"gap_mgmt_01","missing_source_classes":["项目监查计划","源数据核查方案"],"target":"监查频率、监查报告模板及源数据核查范围"},{"action":"确认本项目电子数据采集系统合规性要求及文件保存与销毁政策","category":"source_missing","gap_id":"gap_mgmt_02","missing_source_classes":["电子记录合规性规范","文件保存与销毁政策"],"target":"电子记录合规性要求及文件保存期限"}],"heading":"研究文件、监查和管理","missing_source_classes":["项目监查计划","源数据核查方案","电子记录合规性规范","文件保存与销毁政策"],"proposal_text":"本项目的研究文件管理、监查活动及研究管理遵循药物临床试验质量管理规范及国家药品监督管理局药品审评中心发布的药物临床试验数据管理与统计分析计划指导原则的相关要求。各研究中心应建立并维护完整的研究文件体系，包括研究方案及其修订版本、伦理委员会批准文件、研究者手册、知情同意书模板、受试者筛选与入组记录、原始病历及检查报告、不良事件记录、合并用药记录、监查报告及方案偏离记录等。监查员在监查过程中对研究数据的真实性、完整性和可溯源性进行核查，对发现的偏离或违背方案行为应填写偏离方案记录，详细记录事件发生的时间及过程、原因及相应的处理措施，由研究者签字确认，并根据研究中心相关规定通报伦理委员会及申办者。研究期间产生的所有原始数据、电子记录及纸质文件应妥善保存，保存期限及销毁方式应符合中国法律法规及申办者数据管理政策的要求。","rationale":"研究文件与监查管理的章节结构依据监管共性条款；数据管理与统计分析计划指导原则作为监管共性参考；方案偏离的记录、报告及评估流程依据公司语料中的监管共性结构。本项目为多中心II期研究，涉及超声心动图、NT-proBNP、心电图及实验室检查等多类数据采集，文件管理需覆盖上述原始记录。需医学经理确认：本项目监查频率、源数据核查范围、电子记录合规性要求及文件保存期限的具体实施参数。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f738c43b16eb_de5afd3cf8808e27","section_number":"12","source_ids":["protocol_full_draft_selection:5416a6d5c46cd3ec977fd0e8","current_project_study_definition:mwdefinition_24ae925c5f71136af903:r6:2324e1714eed68be","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:3152bfe8bf762f","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8"]},{"ai_run_id":"airun_20261005230923_8d5165f5","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:12.2 方案偏离|block:950|chunk:1","quote":"任何有意或无意偏离或违背研究方案和GCP原则的行为，均视为偏离方案或违背方案。监查员在监查过程中，如果发现偏离或违背方案，应由研究者或监查员填写偏离方案记录，详细记录事件发生的时间及过程、原因及相应的处理措施，由研究者签字，并根据研究中心相关规定通报伦理委员会及申办者。","quote_sha256":"451e8676a6664eec5d3e7aa873bed27c2ac49daf78a786b2c3641d3bb6d8250a","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8","span_id":"es_dev_01"}],"evidence_review_advisories":[],"evidence_span_ids":["es_dev_01"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":0},"gap_items":[{"action":"获取本项目方案偏离管理规程及重大方案违背判定标准","category":"source_missing","gap_id":"gap_comp_01","missing_source_classes":["项目方案偏离管理规程","重大方案违背判定标准"],"target":"重大方案违背的判定标准及提前终止研究的触发条件"},{"action":"确认本项目多中心管理架构中非现场环节的依从性监督方式","category":"source_not_retrieved","gap_id":"gap_comp_02","missing_source_classes":["项目多中心管理架构文件"],"target":"方案依从性管理是否覆盖中心实验室检测及远程随访等非现场环节"}],"heading":"研究方案的依从","missing_source_classes":["项目方案偏离管理规程","重大方案违背判定标准","研究提前终止条件与流程"],"proposal_text":"研究方案中规定的所有要求，各研究中心及研究者必须严格执行。任何有意或无意偏离或违背研究方案和药物临床试验质量管理规范原则的行为，均视为偏离方案或违背方案。监查员在监查过程中，如果发现偏离或违背方案，应由研究者或监查员填写偏离方案记录，详细记录事件发生的时间及过程、原因及相应的处理措施，由研究者签字，并根据研究中心相关规定通报伦理委员会及申办者。所有可能严重违背方案的情况都必须立即报告申办者。当发生重大方案违背时，应由研究者和申办者共同进行评估，必要时申办者可以提前终止本研究。本项目的方案依从性管理覆盖筛选期至安全随访期（末次给药后2周）的全部研究活动，包括入排标准的执行、随机化与给药操作、访视时间窗的遵守、合并用药的记录、不良事件的采集与报告以及研究药物的发放与回收等环节。","rationale":"方案偏离的定义、记录、报告及评估流程依据公司语料中的监管共性结构；研究时期覆盖范围（筛选期至安全随访期）及访视安排依据本项目已确认的研究时期与访视策略。需医学经理确认：本项目'重大方案违背'的具体判定标准、提前终止研究的触发条件及审批流程；方案依从性管理是否需覆盖中心实验室检测及远程随访等非现场环节。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f738c43b16eb_0b858c7cc43a96f6","section_number":"12.1","source_ids":["protocol_full_draft_selection:5416a6d5c46cd3ec977fd0e8","current_project_study_definition:mwdefini