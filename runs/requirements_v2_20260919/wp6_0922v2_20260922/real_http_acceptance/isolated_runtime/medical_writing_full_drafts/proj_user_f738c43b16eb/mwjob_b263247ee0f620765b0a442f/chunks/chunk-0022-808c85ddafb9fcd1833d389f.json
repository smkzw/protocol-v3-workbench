on:mwdefinition_24ae925c5f71136af903:revision:6","quote":"V0筛选（-28~-1d）：病史、查体、ECHO、实验室、NT-proBNP、ECG","quote_sha256":"90111573aff2e6c1b9e0788dc8223f116513fc23252ef181c835c23c89de487a","source_id":"current_project_study_definition:mwdefinition_24ae925c5f71136af903:r6:2324e1714eed68be","span_id":"span_v0_lab"},{"locator":"study_definition:mwdefinition_24ae925c5f71136af903:revision:6","quote":"排除标准模块：坐位SBP<90 mmHg或有症状性低血压；90天内急性心衰失代偿住院或30天内ACS/PCI/CABG；合并硝酸酯类或PDE5抑制剂；eGFR<30；妊娠或哺乳","quote_sha256":"5cd078a9d273779e6afafad339be3003fbbdaf83a038ea45408389ba84af023c","source_id":"current_project_study_definition:mwdefinition_24ae925c5f71136af903:r6:2324e1714eed68be","span_id":"span_excl_egfr"}],"evidence_review_advisories":[],"evidence_span_ids":["span_sel_142","span_safety_endpoints","span_v0_lab","span_excl_egfr"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"补充项目实验室手册或检测项目清单后写入肝功能、肾功能、电解质及其他相关检测项目","category":"source_missing","gap_id":"GAP-14.2-01","missing_source_classes":["实验室检查项目清单"],"target":"实验室检查项目清单（具体检测项目与组合）"},{"action":"依据项目实验室手册补充样本类型、采集时点、处理与运输条件及检测单位","category":"source_missing","gap_id":"GAP-14.2-02","missing_source_classes":["中心实验室手册/样本操作流程"],"target":"样本采集、处理、运输与检测单位"},{"action":"依据项目实验室手册及安全性报告文件补充参考范围、异常值复检及临床意义评估与报告要求","category":"source_missing","gap_id":"GAP-14.2-03","missing_source_classes":["实验室检查异常值管理文件","安全性报告流程"],"target":"参考范围、异常值判定、复检与报告流程"},{"action":"检索项目完整研究日程与访视评估表，确认除筛选期外各访视是否安排实验室检查及具体项目","category":"source_not_retrieved","gap_id":"GAP-14.2-04","missing_source_classes":["研究日程与访视评估表"],"target":"完整研究日程与访视评估表（除筛选期外实验室检查安排）"}],"heading":"实验室检查项目","missing_source_classes":["实验室检查项目清单","样本采集与处理流程","实验室检查参考范围与异常值报告流程"],"proposal_text":"本研究将肝肾功能与电解质实验室指标纳入安全性终点，实验室检查结果作为安全性评价的组成部分。筛选期V0（第-28至-1天）安排实验室检查，检查结果与病史、体格检查、超声心动图、NT-proBNP及12导联心电图共同用于筛选评估。肾功能相关实验室指标同时服务于入选与排除判断，筛选期eGFR<30者不纳入本研究。基于已确认的安全性监测范围，实验室检查覆盖肝功能、肾功能与电解质。","rationale":"已确认研究事实支持：安全性终点包含肝肾功能与电解质实验室指标；筛选期V0安排实验室检查；筛选期eGFR<30为排除标准。医学负责人需核对实验室检查项目清单、样本采集与处理、检测单位、参考范围及异常值判定与报告流程，并在项目实验室手册到位后补充实施细节。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f738c43b16eb_c1e2fc3e341afcb0","section_number":"14.2","source_ids":["protocol_full_draft_selection:808c85ddafb9fcd1833d389f","current_project_study_definition:mwdefinition_24ae925c5f71136af903:r6:2324e1714eed68be","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1d8a6d3b64541","company_corpus:cms_cn_protocol_corpus_20260715_v1:76a6125fa7dca4","company_corpus:cms_cn_protocol_corpus_20260715_v1:eed6fd877d0a24","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb5ffffeb64ac7","company_corpus:cms_cn_protocol_corpus_20260715_v1:20ca67d1098144"]},{"ai_run_id":"airun_20261005233219_d834248f","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取项目安全性报告流程文件，明确不良事件与严重不良事件的报告路径、对象、时限与方式","category":"source_missing","gap_id":"GAP-14.3-01","missing_source_classes":["项目安全性信息报告流程"],"target":"项目安全性信息报告流程（报告对象、报告时限与报告方式）"},{"action":"获取项目SAE/SUSAR处理文件，明确判定标准、记录要求与报告路径","category":"source_missing","gap_id":"GAP-14.3-02","missing_source_classes":["SAE/SUSAR定义与处理文件"],"target":"SAE/SUSAR判定、记录与报告流程"},{"action":"获取安全性数据管理计划，明确安全性数据采集、核查与交换职责","category":"source_missing","gap_id":"GAP-14.3-03","missing_source_classes":["安全性数据管理计划"],"target":"安全性数据管理职责与数据交换约定"}],"heading":"安全信息报告途径","missing_source_classes":["项目特异性安全性信息报告流程","SAE/SUSAR定义与处理文件","安全性数据管理计划"],"proposal_text":"","rationale":"已确认研究事实支持：安全性终点包含不良事件与严重不良事件发生率；安全随访期为末次给药后2周，V5访视用于AE转归确认。报告对象、报告时限、报告方式及SAE/SUSAR处理流程缺少本项目文件支持，未写入正文。医学负责人需确认项目安全性报告流程文件来源后补充本节内容。","review_advisories":["本节复述高影响研究设计（安全信息报告途径）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f738c43b16eb_77e1bbe07554bd15","section_number":"14.3","source_ids":["protocol_full_draft_selection:80