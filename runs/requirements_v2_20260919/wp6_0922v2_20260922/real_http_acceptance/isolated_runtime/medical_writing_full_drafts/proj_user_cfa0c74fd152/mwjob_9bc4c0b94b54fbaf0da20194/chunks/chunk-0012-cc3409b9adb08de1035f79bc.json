:7","quote":"依从：第1天-第85天（12周）","quote_sha256":"85a386997751a9b0ad1e8cca547aa8fd2f721922e258f3ff2be92106471ff17d","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"es_duration"},{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"试验干预：KZ-sGC2201片（口服sGC刺激剂）25mg/50mg每日一次，GDMT基础上加用","quote_sha256":"a5ed048647ca7656f1d8a26b4b6ab465ddffa2341a8a9ad75dac573d62c715c0","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"es_drug"}],"evidence_review_advisories":[],"evidence_span_ids":["es_safety_endpoint","es_secondary_endpoint","es_duration","es_drug"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"需获取KZ-sGC2201非临床安全性研究数据及同类sGC刺激剂既往临床安全性报告，确定需监测的实验室检查项目及采集访视时点","category":"source_missing","gap_id":"gap_lab_panel","missing_source_classes":["Investigator's Brochure","非临床安全性研究报告","同类药物既往临床安全性数据"],"target":"7.3.3 实验室检查"},{"action":"需确定实验室检查异常的临床意义判定标准及是否需要中心实验室","category":"source_missing","gap_id":"gap_lab_threshold","missing_source_classes":["安全性评估标准文件","中心实验室方案"],"target":"7.3.3 实验室检查"}],"heading":"实验室检查","missing_source_classes":["实验室检查项目清单与采集时点","正常值范围与临床意义判定阈值","药物非临床安全性数据（IB）"],"proposal_text":"本研究将实验室检查纳入安全性评估体系，作为关键次要终点和安全性终点的组成部分，用于监测KZ-sGC2201在慢性心力衰竭成人患者中的全身性安全性。实验室检查异常与生命体征、12导联心电图及症状性低血压事件共同构成安全性终点评价内容。治疗期为第1天至第85天（12周），受试者在GDMT基础上加用KZ-sGC2201片（25mg或50mg每日一次口服）或匹配安慰剂。实验室检查结果的采集、记录与临床意义判定应贯穿整个治疗期及安全性随访期，以支持对药物相关实验室异常的识别和归因分析。具体检查项目、采集访视时点、正常值参考范围及临床意义判定阈值将在方案附件中列明。","rationale":"研究定义确认实验室检查异常为关键次要终点和安全性终点组成部分，治疗期为12周，药物为口服sGC刺激剂（全身暴露）。但具体检查项目清单、采集时点、阈值及正常值范围未在允许来源中给出，需医学经理依据药物非临床安全性数据和同类sGC刺激剂既往临床安全性特征确定。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_cfa0c74fd152_e16fdec25da622bb","section_number":"7.3.3","source_ids":["protocol_full_draft_selection:cc3409b9adb08de1035f79bc","current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11"]},{"ai_run_id":"airun_20261015013015_b5cb37eb","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"需依据KZ-sGC2201非临床生殖毒性数据确定避孕方法要求、避孕起始与终止时点、妊娠检查类型及检查频率","category":"source_missing","gap_id":"gap_contraception","missing_source_classes":["Investigator's Brochure","非临床生殖毒性研究报告"],"target":"7.3.4 妊娠检查和避孕问询"},{"action":"需确定妊娠报告流程、伴侣妊娠报告要求、新生儿随访期限及终止条件","category":"source_missing","gap_id":"gap_pregnancy_followup","missing_source_classes":["妊娠随访方案","安全性报告SOP"],"target":"7.3.4 妊娠检查和避孕问询"}],"heading":"妊娠检查和避孕问询","missing_source_classes":["避孕方法要求","妊娠检查类型与日程","伴侣妊娠报告规则","新生儿随访安排"],"proposal_text":"","rationale":"研究定义确认妊娠或哺乳为排除标准，药物为具有全身血管舒张作用的sGC刺激剂。但允许来源未提供具体避孕方法、妊娠检查日程、伴侣妊娠报告规则及新生儿随访安排。sGC刺激剂的血管舒张机制提示潜在胎儿风险，但具体生殖毒性数据需IB支持。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_cfa0c74fd152_43f8147016441721","section_number":"7.3.4","source_ids":["protocol_full_draft_selection:cc3409b9adb08de1035f79bc","current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11"]},{"ai_run_id":"airun_20261015013015_b5cb37eb","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"安全性终点：治疗期TEAE发生率与严重程度；生命体征、12导联ECG与实验室检查异常；症状性低血压事件","quote_sha256":"26fe165993a771549750ad69c91c668ad27129ddb0fa2c072b733c33ca51c43b","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"es_safety_endpoint"},{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"关键次要终点：治疗期TEAE发生率与严重程度、生命体征/ECG/实验室检查异常、症状性低血压事件","quote_sha256":"0ce06352a6862134f81794bc2529717728174c324ed0d3f4bf48bd3fa84ce40b","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"es_secondary_endpoint"},{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"依从：第1天-第85天（12周）","quote_sha256":"85a386997751a9b0ad1e8cca547aa8fd2f721922e258f3ff2be92106471ff17d","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"es_duration"},{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"安慰剂匹配双模拟；试验药高剂量/低剂量/安慰剂，随机2:1:1分配，双盲","quote_sha256":"6fb5c9f577cc12518dfd3db6b21c275c94c27d09d74e511b640a7e7d137590e5","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"es_blind"},{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"试验干预：KZ-sGC2201片（口服sGC刺激剂）25mg/50mg每日一次，GDMT基础上加用","quote_sha256":"a5ed048647ca7656f1d8a26b4b6ab465ddffa2341a8a9ad75dac573d62c715c0","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"es_drug"},{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"慢性心力衰竭（LVEF≤40%）成人患者，NYHA II-III级，GDMT稳定至少4周症状未充分控制","quote_sha256":"536d0873c8b13816de5bdc8a2652e4fbc14f07f18813d5e82b220ce3ffb3d0b4","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"es_population"}],"evidence_review_advisories":[],"evidence_span_ids":["es_safety_endpoint","es_secondary_endpoint","es_duration","es_blind","es_drug","es_population"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"需确定TEAE采集窗口及安全性评估结束时间点","category":"source_missing","gap_id":"gap_tea_window","missing_source_classes":["安全性评估标准文件","ICH E2A/E2F指南适用条款"],"target":"8 安全性评价"},{"action":"需确定AE/SAE/SUSAR定义、报告对象及报告时限","category":"source_missing","gap_id":"gap_ae_definition","missing_source_classes":["安全性报告SOP","中国GCP安全性报告条款","ICH E2A"],"target":"8 安全性评价"},{"action":"需确认安全性分析集是否包含仅随机化但未接受任何研究药物治疗的受试者","category":"source_missing","gap_id":"gap_safety_set","missing_source_classes":["统计分析计划"],"target":"8 安全性评价"}],"heading":"安全性评价","missing_source_classes":["TEAE采集窗口定义","AE/SAE/SUSAR分类与报告标准","安全性评估结束时间点","安全性分析集精确定义"],"proposal_text":"本研究的安全性评价旨在系统收集、记录和评估KZ-sGC2201在慢性心力衰竭（LVEF≤40%）成人患者中的安全性特征。安全性评价覆盖治疗期（第1天至第85天）及末次给药后的安全性随访期。安全性评估内容包括：治疗期治疗期间不良事件（TEAE）的发生率与严重程度；生命体征、12导联心电图及实验室检查异常；症状性低血压事件。安全性数据按随机分组（KZ-sGC2201 25mg组、50mg组与安慰剂组，2:1:1分配）进行比较分析。安全性评价采用双盲设计，安慰剂为匹配双模拟。安全性分析基于安全性分析集，该集包含至少接受一次研究药物治疗的所有随机化受试者。安全性评价的最终目的是为KZ-sGC2201的II期概念验证和剂量探索提供安全性依据，支持后续III期研究设计决策。","rationale":"研究定义确认安全性终点包括TEAE、生命体征/ECG/实验室检查异常及症状性低血压事件，治疗期12周，双盲2:1:1设计，安全性分析集为至少接受一次研究药物治疗的随机化受试者。但TEAE采集窗口、AE/SAE/SUSAR具体定义与报告时限、安全性评估结束时间点未在允许来源中给出。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_cfa0c74fd152_8c0f7489e434f87b","section_number":"8","source_ids":["protocol_full_draft_selection:cc3409b9adb08de1035f79bc","current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11"]},{"ai_run_id":"airun_20261015013015_b5cb37eb","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"安全性终点：治疗期TEAE发生率与严重程度；生命体征、12导联ECG与实验室检查异常；症状性低血压事件","quote_sha256":"26fe165993a771549750ad69c91c668ad27129ddb0fa2c072b733c33ca51c43b","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"es_safety_endpoint"},{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"安慰剂匹配双模拟；试验药高剂量/低剂量/安慰剂，随机2:1:1分配，双盲","quote_sha256":"6fb5c9f577cc12518dfd3db6b21c275c94c27d09d74e511b640a7e7d137590e5","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"es_blind"},{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"依从：第1天-第85天（12周）","quote_sha256":"85a386997751a9b0ad1e8cca547aa8fd2f721922e258f3ff2be92106471ff17d","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"es_duration"},{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"关键次要终点：治疗期TEAE发生率与严重程度、生命体征/ECG/实验室检查异常、症状性低血压事件","quote_sha256":"0ce06352a6862134f81794bc2529717728174c324ed0d3f4bf48bd3fa84ce40b","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"es_secondary_endpoint"}],"evidence_review_advisories":[],"evidence_span_ids":["es_safety_endpoint","es_blind","es_duration","es_secondary_endpoint"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"需确定AE因果关系判定标准及严重程度分级标准","category":"source_missing","gap_id":"gap_ae_causality","missing_source_classes":["安全性评估标准文件","ICH E2A"],"target":"8.1 总则"},{"action":"需确定安全性评估结束时间点及随访期安排","category":"source_missing","gap_id":"gap_safety_end","missing_source_classes":["安全性评估标准文件"],"target":"8.1 总则"},{"action":"需确定不设置DMC情况下安全性信息审阅与决策的具体操作机制","category":"source_missing","gap_id":"gap_dmc_replacement","missing_source_classes":["安全性治理SOP","申办方内部安全监测规程"],"target":"8.1 总则"}],"heading":"总则","missing_source_classes":["AE因果关系判定与严重程度分级标准","安全性报告时限与对象","安全性评估结束时间点","DMC替代机制操作细则"],"proposal_text":"本章节阐述安全性评价的总体原则与实施框架。本研究为随机、双盲、安慰剂对照、平行组、多中心II期概念验证与剂量探索研究，安全性评价贯穿整个研究周期。安全性评价遵循以下原则：第一，所有在研究期间发生的不良事件均须由研究者进行因果关系判定和严重程度分级；第二，安全性数据的收集、记录和报告应确保完整性和及时性；第三，安全性分析以安全性分析集为基础，该集包含至少接受一次研究药物治疗的所有随机化受试者；第四，安全性评价采用双盲设计，安慰剂为匹配双模拟，随机分配比例为2:1:1；第五，安全性评估内容包括治疗期TEAE发生率与严重程度、生命体征、12导联心电图、实验室检查异常及症状性低血压事件。本研究不设置独立数据安全监查委员会（DMC），安全性信息的审阅与决策由申办方医学团队负责。","rationale":"研究定义确认双盲、2:1:1随机、安慰剂匹配双模拟设计，安全性终点内容，不设置DMC，安全性分析集为至少接受一次研究药物治疗的随机化受试者。但AE因果关系判定标准、严重程度分级标准、报告时限、安全性评估结束时间点及DMC替代机制的具体操作规则未在允许来源中给出。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_cfa0c74fd152_7877c6a580bfb7c1","section_number":"8.1","source_ids":["protocol_full_draft_selection:cc3409b9adb08de1035f79bc","current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11"]}],"source_bindings":[{"content_sha256":"0266d8d49c8e9cdcbce868c92d138edae150d710c0b4e429dd972ecbcea4f5ab","locator":"document:mwdoc_greenfield_proj_user_cfa0c74fd152_8da7757297dced36:full-draft:cc3409b9adb08de1035f79bc","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:cc3409b9adb08de1035f79bc","source_type":"protocol_full_draft_selection","source_version":"full-draft:117560101db1e47f594d905644303284433ed2af23812133b5006c4338e03c31:cc3409b9adb08de1035f79bc","text_sha256":"0266d8d49c8e9cdcbce868c92d138edae150d710c0b4e429dd972ecbcea4f5ab"},{"content_sha256":"20c8729f60dff625677c49ffc7ab286aafe054d33280a6459750fca3289a6963","locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","source_type":"current_project_study_definition","source_version":"mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","text_sha256":"20c8729f60dff625677c49ffc7ab286aafe054d33280a6459750fca3289a6963"}]}