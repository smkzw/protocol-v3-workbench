3fd7ab767640a11","span_id":"es_003"},{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"剂型：口服固体制剂","quote_sha256":"2c22ee80756bfd178af43cee3c8a0a1b4058aaecb83d264b4107972a334b5bf4","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"es_004"}],"evidence_review_advisories":[],"evidence_span_ids":["es_003","es_004"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"确认依从性评估方法（药片计数、电子给药监测、受试者日记等）、评估时点及依从性判定阈值","category":"source_missing","gap_id":"gap_65_01","missing_source_classes":["项目级依从性管理文件","访视操作手册"],"target":"6.5节依从性评估方法与阈值"},{"action":"确认连续漏服或依从性低于阈值时的处理流程（是否暂停、是否退出、是否影响分析集归属）","category":"source_missing","gap_id":"gap_65_02","missing_source_classes":["项目级依从性管理文件"],"target":"6.5节非依从处理"}],"heading":"研究治疗依从性","missing_source_classes":["项目级依从性管理文件","访视操作手册"],"proposal_text":"本研究治疗期为第1天至第85天（共12周），受试者在随机分组后接受KZ-sGC2201片（25mg或50mg）或匹配安慰剂，每日一次口服给药。研究治疗依从性评估覆盖整个12周治疗期，自首次给药起至末次给药止。受试者应每日按方案规定剂量和给药时间自行服用研究药物，不得自行增减剂量或更改给药时间。研究药物为口服固体制剂，受试者须整片吞服，不得掰开、碾碎或咀嚼。","rationale":"治疗周期（第1天至第85天，12周）、剂型（口服固体制剂）和给药频率（每日一次）来源于当前项目已确认研究事实。依从性评估方法（药片计数、电子监测、日记卡等）、具体评估访视时点、依从性阈值及非依从后果在允许来源中未给出，不得自行设定。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_cfa0c74fd152_eecdbe57fefdfc02","section_number":"6.5","source_ids":["protocol_full_draft_selection:980f7635aa7597c5833fac78","current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11"]},{"ai_run_id":"airun_20261015011846_38feba11","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"GDMT稳定至少4周症状未充分控制","quote_sha256":"9d1dee0a06dac65f13150ff6d74fdde8b686bf39b3e2ef6814b13f35719e8bbf","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"es_005"},{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"排除标准模块：近6个月心梗/不稳定心绞痛；强效CYP3A4抑制剂或诱导剂；妊娠或哺乳","quote_sha256":"83597fb8c0b890e4c27c8bf743753b5dfb58ddd1a9cb00eeca4333709529ed1d","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"es_006"}],"evidence_review_advisories":[],"evidence_span_ids":["es_005","es_006"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"确认GDMT具体组成清单、研究期间是否允许调整GDMT方案及调整时的处理流程","category":"source_missing","gap_id":"gap_66_01","missing_source_classes":["项目级合并用药管理文件","GDMT组成与调整规则文件"],"target":"6.6节GDMT组成与调整"},{"action":"确认除CYP3A4强效抑制剂/诱导剂外的其他禁限用药清单、救援治疗定义与使用规则、合并用药报告时限","category":"source_missing","gap_id":"gap_66_02","missing_source_classes":["项目级合并用药管理文件","救援治疗操作规程"],"target":"6.6节禁限用药与救援治疗"},{"action":"确认合并禁限用药或救援治疗是否构成方案偏离、是否影响PPS归属","category":"source_missing","gap_id":"gap_66_03","missing_source_classes":["统计分析计划","项目级合并用药管理文件"],"target":"6.6节合并用药对分析集的影响"}],"heading":"合并用药/治疗","missing_source_classes":["项目级合并用药管理文件","GDMT组成与调整规则文件","救援治疗操作规程"],"proposal_text":"本研究在慢性心力衰竭（LVEF≤40%）成人患者中开展，受试者入组前须接受指南指导的药物治疗（GDMT）稳定至少4周且症状未充分控制，研究期间GDMT方案原则上维持不变。KZ-sGC2201片作为GDMT基础上的附加治疗给药。合并用药方面，方案排除正在使用强效CYP3A4抑制剂或强效CYP3A4诱导剂的受试者；研究期间如需使用上述药物，应视为方案偏离并报告。","rationale":"GDMT稳定至少4周作为入组前提、KZ-sGC2201作为GDMT基础上加用、强效CYP3A4抑制剂或诱导剂为排除标准，均来源于当前项目已确认研究事实。GDMT具体组成是否允许调整、禁限用药完整清单、救援治疗规则、合并用药报告时限及是否影响分析集归属等实施细节在允许来源中未给出，不得自行设定。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_cfa0c74fd152_033f9b7b19afa1e9","section_number":"6.6","source_ids":["protocol_full_draft_selection:980f7635aa7597c5833fac78","current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11"]}],"source_bindings":[{"content_sha256":"b2d7c88e1c75f9e7c607b3e66ccb8ef5aecab0e39eae1da2cf0da39be0cf68de","locator":"document:mwdoc_greenfield_proj_user_cfa0c74fd152_8da7757297dced36:full-draft:980f7635aa7597c5833fac78","role":"curre