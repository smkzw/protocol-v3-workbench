51a9b0ad1e8cca547aa8fd2f721922e258f3ff2be92106471ff17d","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"ES-04"},{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"主要终点ANCOVA基线校正；分层因素校正；敏感性分析预定义；次要终点层次检验","quote_sha256":"ca258b20c8d28b41b478a1254b0aed096307b09b11e66f2f541fee90708b935e","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"ES-06"}],"evidence_review_advisories":[],"evidence_span_ids":["ES-01","ES-02","ES-04","ES-06"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"参照访视计划或方案附录确认NT-proBNP采集时点","category":"source_missing","gap_id":"GAP-7.2-01","missing_source_classes":["访视计划"],"target":"NT-proBNP除基线和第12周外是否还有其他采集时点"},{"action":"与统计师确认主要终点计算方式","category":"source_missing","gap_id":"GAP-7.2-02","missing_source_classes":["统计分析计划"],"target":"NT-proBNP变化百分比的具体计算公式及是否对数转换"},{"action":"与统计师确认层次检验顺序","category":"source_missing","gap_id":"GAP-7.2-03","missing_source_classes":["统计分析计划"],"target":"次要终点层次检验的具体顺序"}],"heading":"有效性评估","missing_source_classes":["访视计划中NT-proBNP具体采集时点","NT-proBNP检测方法学及质控要求","层次检验具体顺序定义"],"proposal_text":"本研究的主要有效性终点为第12周N末端B型利钠肽前体（NT-proBNP）较基线变化百分比，由中心实验室统一检测，以随机分组间比较作为主要疗效判定依据。主要终点统计分析采用协方差分析（ANCOVA），以基线NT-proBNP值为协变量，纳入分层因素校正，并预定义敏感性分析与亚组分析。次要终点按层次顺序进行检验，以控制整体I类错误率。有效性评估贯穿治疗期（第1天至第85天，共12周），NT-proBNP检测在基线及第12周访视时由中心实验室完成。","rationale":"主要终点、ANCOVA方法、层次检验及治疗期时长均来自当前项目已确认研究事实。NT-proBNP具体检测时点（除基线和第12周外是否还有其他时点）、变化百分比的计算公式（是否对数转换）、层次检验的具体顺序及多重性校正方法需医学负责人与统计师确认。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_cfa0c74fd152_5afb328086ae3b8c","section_number":"7.2","source_ids":["protocol_full_draft_selection:6b459e8b3b2494a080318a53","current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11"]},{"ai_run_id":"airun_20261015012622_d5e43572","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"安全性终点：治疗期TEAE发生率与严重程度；生命体征、12导联ECG与实验室检查异常；症状性低血压事件","quote_sha256":"26fe165993a771549750ad69c91c668ad27129ddb0fa2c072b733c33ca51c43b","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"ES-03"},{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"依从：第1天-第85天（12周）","quote_sha256":"85a386997751a9b0ad1e8cca547aa8fd2f721922e258f3ff2be92106471ff17d","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"ES-04"},{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"关键次要终点：治疗期TEAE发生率与严重程度、生命体征/ECG/实验室检查异常、症状性低血压事件","quote_sha256":"0ce06352a6862134f81794bc2529717728174c324ed0d3f4bf48bd3fa84ce40b","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"ES-05"}],"evidence_review_advisories":[],"evidence_span_ids":["ES-03","ES-04","ES-05"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"确认TEAE采集窗口（如末次给药后30天）及严重不良事件报告时限","category":"source_missing","gap_id":"GAP-7.3-01","missing_source_classes":["安全性管理计划","方案安全性章节"],"target":"TEAE采集窗口定义及报告时限"},{"action":"确认症状性低血压的收缩压/舒张压阈值及伴随症状定义","category":"source_missing","gap_id":"GAP-7.3-02","missing_source_classes":["安全性管理计划"],"target":"症状性低血压事件的具体判定阈值"},{"action":"参照访视计划确认各安全性评估项目的实施时点","category":"source_missing","gap_id":"GAP-7.3-03","missing_source_classes":["访视计划"],"target":"安全性评估的具体访视时点安排"}],"heading":"安全性评估","missing_source_classes":["TEAE采集窗口与报告时限","严重程度分级标准","症状性低血压判定阈值","安全性评估具体访视时点"],"proposal_text":"本研究的安全性评估贯穿治疗期（第1天至第85天，共12周），涵盖以下方面：治疗期治疗期间不良事件（TEAE）的发生率与严重程度；生命体征、12导联心电图（ECG）与实验室检查异常；症状性低血压事件。上述安全性指标同时作为关键次要终点纳入疗效与安全性综合评价。安全性数据的采集、分类、严重程度判定及报告遵循方案规定的统一标准，由研究者依据临床判断进行记录。","rationale":"安全性评估范围（TEAE、生命体征、12导联ECG、实验室检查异常、症状性低血压事件）及治疗期时长均来自当前项目已确认研究事实。TEAE的采集窗口定义（如是否包含首次给药后一定时间窗）、严重程度分级标准（如CTCAE版本）、报告时限及症状性低血压的具体判定阈值未在当前来源中明确，需医学负责人确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_cfa0c74fd152_5e81567cbd8c5150","section_number":"7.3","source_ids":["protocol_full_draft_selection:6b459e8b3b2494a080318a53","current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11"]},{"ai_run_id":"airun_20261015012622_d5e43572","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"安全性终点：治疗期TEAE发生率与严重程度；生命体征、12导联ECG与实验室检查异常；症状性低血压事件","quote_sha256":"26fe165993a771549750ad69c91c668ad27129ddb0fa2c072b733c33ca51c43b","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"ES-03"},{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"依从：第1天-第85天（12周）","quote_sha256":"85a386997751a9b0ad1e8cca547aa8fd2f721922e258f3ff2be92106471ff17d","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"ES-04"}],"evidence_review_advisories":[],"evidence_span_ids":["ES-03","ES-04"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"参照访视计划或方案附录确认生命体征测量参数与体位要求","category":"source_missing","gap_id":"GAP-7.3.1-01","missing_source_classes":["访视计划","方案附录"],"target":"生命体征具体测量参数（血压、心率、呼吸、体温等）及测量体位"},{"action":"参照访视计划确认体格检查项目与实施频率","category":"source_missing","gap_id":"GAP-7.3.1-02","missing_source_classes":["访视计划"],"target":"体格检查具体项目及是否每次访视均实施"}],"heading":"生命体征和体格检查","missing_source_classes":["生命体征具体测量参数与体位","体格检查具体项目","各访视实施时点"],"proposal_text":"本研究在治疗期（第1天至第85天，共12周）内对受试者进行生命体征监测和体格检查，作为安全性评估的组成部分。生命体征监测旨在识别与试验药物相关的血流动力学变化，重点关注血压和心率等与sGC刺激剂药理作用相关的指标。体格检查用于评估受试者整体健康状况及有无新发或加重的临床体征。具体测量参数、测量体位、测量时点及体格检查项目依据访视计划执行。","rationale":"生命体征作为安全性评估组成部分及治疗期时长来自当前项目已确认研究事实。sGC刺激剂的药理作用涉及血管舒张，因此血压和心率监测具有药理学合理性，但具体监测参数、体位要求、各访视是否均实施及体格检查具体项目未在当前来源中明确，需参照访视计划确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_cfa0c74fd152_f4729353bdd9e49a","section_number":"7.3.1","source_ids":["protocol_full_draft_selection:6b459e8b3b2494a080318a53","current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11"]},{"ai_run_id":"airun_20261015012622_d5e43572","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"安全性终点：治疗期TEAE发生率与严重程度；生命体征、12导联ECG与实验室检查异常；症状性低血压事件","quote_sha256":"26fe165993a771549750ad69c91c668ad27129ddb0fa2c072b733c33ca51c43b","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"ES-03"},{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"依从：第1天-第85天（12周）","quote_sha256":"85a386997751a9b0ad1e8cca547aa8fd2f721922e258f3ff2be92106471ff17d","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"ES-04"},{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"生命体征、12导联ECG与实验室检查异常","quote_sha256":"ba8a3f25d99be3ebc5299d7352ac2b37833b6bc0795a7f88b197483d027919e3","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"ES-07"}],"evidence_review_advisories":[],"evidence_span_ids":["ES-03","ES-04","ES-07"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"参照访视计划确认ECG检查的实施时点","category":"source_missing","gap_id":"GAP-7.3.2-01","missing_source_classes":["访视计划"],"target":"12导联ECG的具体访视时点安排"},{"action":"确认ECG测量条件及临床意义判定标准","category":"source_missing","gap_id":"GAP-7.3.2-02","missing_source_classes":["访视计划","安全性管理计划"],"target":"ECG测量条件（静息时间、测量体位）及异常判定标准"},{"action":"与心脏安全专家确认QTc校正方法及判读流程","category":"source_missing","gap_id":"GAP-7.3.2-03","missing_source_classes":["安全性管理计划"],"target":"QTc校正方法（QTcF或QTcB）及是否需中心判读"}],"heading":"心电图检查","missing_source_classes":["ECG具体访视时点","ECG测量条件与判读标准","QTc校正方法"],"proposal_text":"本研究在治疗期（第1天至第85天，共12周）内对受试者进行12导联心电图（ECG）检查，作为安全性评估的组成部分。12导联ECG用于监测与试验药物相关的电生理变化，重点关注心率、PR间期、QRS时限及QT间期等参数。心电图检查由研究者或经培训的技术人员操作，结果由研究者判读并记录。具体检查时点、测量条件及异常判定标准依据访视计划执行。","rationale":"12导联ECG作为安全性评估组成部分及治疗期时长来自当前项目已确认研究事实。sGC刺激剂可能影响心脏电生理，12导联ECG监测具有药理学合理性。但具体访视时点、测量条件（如静息时间）、QTc校正方法（如QTcF）、异常判定阈值及是否需中心判读未在当前来源中明确，需医学负责人与心脏安全专家确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_cfa0c74fd152_95d350a429d3fdc8","section_number":"7.3.2","source_ids":["protocol_full_draft_selection:6b459e8b3b2494a080318a53","current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11"]}],"source_bindings":[{"content_sha256":"c0b84cdf30f7894e10a66a453abe331563cb751f67ec1bdff0715332e66b07e1","locator":"document:mwdoc_greenfield_proj_user_cfa0c74fd152_8da7757297dced36:full-draft:6b459e8b3b2494a080318a53","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:6b459e8b3b2494a080318a53","source_type":"protocol_full_draft_selection","source_version":"full-draft:117560101db1e47f594d905644303284433ed2af23812133b5006c4338e03c31:6b459e8b3b2494a080318a53","text_sha256":"c0b84cdf30f7894e10a66a453abe331563cb751f67ec1bdff0715332e66b07e1"},{"content_sha256":"20c8729f60dff625677c49ffc7ab286aafe054d33280a6459750fca3289a6963","locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","source_type":"current_project_study_definition","source_version":"mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","text_sha256":"20c8729f60dff625677c49ffc7ab286aafe054d33280a6459750fca3289a6963"}]}