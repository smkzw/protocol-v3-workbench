v1:ac6ee929ab7d83"]},{"ai_run_id":"airun_20261015014110_a00043ea","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"主要终点ANCOVA协方差分析（基线为协变量）；分层因素校正；敏感性分析与亚组分析预定义","quote_sha256":"11e4fa46547945b730614d496932139893991df26c5efda28f12352a6b83f230","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"es_003"},{"locator":"study_definition:mwdefinition_38af9a3da602952b599f:revision:7","quote":"次要终点按层次顺序校正","quote_sha256":"dfc4e2a81714a09574aab99ee7092a328ba311ce4833bf720b7b2ea2872077bd","source_id":"current_project_study_definition:mwdefinition_38af9a3da602952b599f:r7:a3fd7ab767640a11","span_id":"es_004"}],"evidence_review_advisories":[],"evidence_span_ids":["es_003","es_004"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"需确认重大方案偏离的具体判定标准（如给药依从性阈值、主要终点评估缺失定义、违反入选排除标准的范围），由医学经理与统计师在SAP中明确。","category":"source_missing","gap_id":"gap_9_pps_deviation","missing_source_classes":["统计分析计划"],"target":"9 统计分析 - 符合方案集成员判定"}],"heading":"统计分析","missing_source_classes":["统计分析计划（SAP）中分析集逐集成员判定的具体方案偏离条款"],"proposal_text":"本研究为随机、双盲、安慰剂对照、平行组、多中心II期概念验证与剂量探索研究，试验药KZ-sGC2201高剂量组、低剂量组与安慰剂组按2:1:1比例随机分配。主要终点为第12周NT-proBNP较基线变化百分比，采用协方差分析（ANCOVA）进行主分析，以基线NT-proBNP变化百分比为协变量，并校正随机化分层因素。敏感性分析与亚组分析在方案中预定义。关键次要终点及安全性终点（治疗期TEAE发生率与严重程度、生命体征与12导联ECG异常、实验室检查异常、症状性低血压事件）按层次顺序进行检验校正。全分析集（FAS）纳入所有随机化受试者，以随机化分组为分析分组依据，用于主要终点及次要疗效终点的分析。安全性分析集（SS）纳入至少接受一次研究药物或安慰剂给药的受试者，以实际接受的治疗为分析分组依据，用于安全性指标的分析。符合方案集（PPS）纳入完成关键评估且无重大方案偏离的受试者；存在重大方案偏离者（包括但不限于未按方案给药、主要终点评估缺失、违反主要入选或排除标准等）排除出符合方案集。符合方案集用于主要终点的敏感性分析。","rationale":"主要终点ANCOVA方法、分层因素校正、敏感性分析与亚组预定义、次要终点层次检验顺序均由项目已确认研究事实（研究时期、估计目标策略、统计分析策略）直接支持。分析集成员规则（FAS/SS/PPS）为监管共性结构，PPS排除条款依据用户指令要求写入；具体方案偏离判定标准需医学经理与统计师在统计分析计划中进一步细化。","review_advisories":["本节复述高影响研究设计（统计分析）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"stand