{"ai_route":{"actual_response_model":"mtplx-flash-next-optimized-speed","ai_run_id":"airun_20260923222629_1f70ff69","expected_response_model":"mtplx-flash-next-optimized-speed","fallback_chain_id":"aifb_62c70d3ea6716ef518c4bfa0","fallback_depth":0,"fallback_reason":"","model":"mtplx-flash-next-optimized-speed","provider":"mtplx","reasoning_effort":"xhigh","route_base_url":"http://127.0.0.1:8002/v1","route_identity_hash":"c9480819205db8521fec70763515cf905334434da194fa8ae2172b40ab545075","route_profile_id":"independent_ai__mtplx_qwen38_local","thinking":"enabled"},"ai_run_id":"airun_20260923222629_1f70ff69","chunk_index":7,"job_id":"mwjob_4f6a049a1fdcdb11b55d71a7","precondition_digest":"e0db448ca9e9c30f8689e72152f89adc6af4b067c20418fcdb5752611d7c8a49","project_id":"proj_user_97189da36a75","schema_version":"protocol_full_draft_chunk_v10","section_ids":["mwsec_greenfield_proj_user_97189da36a75_12f207334a748ea5","mwsec_greenfield_proj_user_97189da36a75_5206e5cc1f60bf2d","mwsec_greenfield_proj_user_97189da36a75_7968600547f490cc","mwsec_greenfield_proj_user_97189da36a75_8c3cc0c755b7d730"],"sections":[{"ai_run_id":"airun_20260923222629_1f70ff69","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"本研究为固定剂量双盲治疗设计，不设置计划性常规剂量调整","quote_sha256":"0b6022fb55f9783515cead635a664837555f8e365c34bd7b269c94abbb0785f4","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"es_dose_fixed"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"若出现严重心动过缓或重度淋巴细胞减少按方案规定执行安全中断或永久停药","quote_sha256":"d242c4c999a5056c4c2d6115e704b699273f84992a900bb2816e742c679f408b","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"es_dose_triggers"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"合成药M8：0.5mg每日一次（口服）；双盲治疗期（第1天至第24周）","quote_sha256":"1f2b4f3b4e8e649bb49ace886d5f8af6da23960ff6f58e6007307e85194decf1","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"es_dose_regimen"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"有症状的心动过缓或二度/三度房室传导阻滞；严重或机会性感染（疱疹病毒、PML筛查）；黄斑水肿；重度淋巴细胞减少（ALC < 0.2×10^9/L）；转氨酶显著升高（ALT/AST > 5×ULN）","quote_sha256":"204138d01a00a236ab60ebc73f9037b725a7065cd59fa07d4e432aeedc82e8c2","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"es_safety_endpoints"}],"evidence_review_advisories":[],"evidence_span_ids":["es_dose_fixed","es_dose_triggers","es_dose_regimen","es_safety_endpoints"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"需从研究者手册或安全性管理规程中获取恢复标准后补写","category":"source_missing","gap_id":"gap_6_3_recovery","missing_source_classes":["安全性管理规程","研究者手册"],"target":"安全中断后恢复给药的前置条件与操作流程"},{"action":"需确认永久停药后是否延续安全随访期监测及具体随访内容","category":"source_missing","gap_id":"gap_6_3_permanent","missing_source_classes":["安全性管理规程"],"target":"永久停药后的随访安排与安全性监测要求"}],"heading":"剂量调整、暂停、恢复与永久停药","missing_source_classes":["安全性管理规程","研究者手册中剂量调整与停药操作章节"],"proposal_text":"本研究采用固定剂量双盲治疗设计，合成药M8以0.5mg每日一次口服给药，双盲治疗期自第1天持续至第24周，不设置计划性常规剂量调整。受试者在整个双盲治疗期内维持同一剂量水平，不因疗效反应或轻度不良事件而进行剂量递增或递减。当出现有症状的心动过缓或二度及以上房室传导阻滞时，研究者应立即暂停研究药物给药，并依据安全性评估结果决定是否永久停药。当外周血绝对淋巴细胞计数降至0.2×10^9/L以下时，应暂停给药并密切监测淋巴细胞恢复情况。上述安全中断或永久停药的具体操作流程、恢复给药的前置条件及永久停药后的随访安排，需依据研究者手册及安全性管理规程进一步细化后纳入方案正文。","rationale":"已确认事实支持固定剂量设计、无计划性剂量调整、以及以严重心动过缓和重度淋巴细胞减少为安全中断触发条件。但中断后恢复标准、永久停药后随访路径及具体操作流程尚无项目文件明确，需医学经理结合研究者手册和安全性管理规程补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97189da36a75_12f207334a748ea5","section_number":"6.3","source_ids":["protocol_full_draft_selection:6b0b7504fd49e7f4b0c3c983","current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe"]},{"ai_run_id":"airun_20260923222629_1f70ff69","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"需从研究者手册或安全性管理规程中获取过量定义后补写","category":"source_missing","gap_id":"gap_6_4_overdose_def","missing_source_classes":["研究者手册","安全性管理规程"],"target":"药物过量的定义阈值与分类"},{"action":"需确认给药错误报告对象、时限及紧急处理措施","category":"source_missing","gap_id":"gap_6_4_procedure","missing_source_classes":["安全性报告操作手册","安全性管理规程"],"target":"给药错误的识别、报告与处理流程"}],"heading":"药物过量与给药错误管理","missing_source_classes":["药物过量与给药错误管理规程","研究者手册中过量处理章节","安全性报告操作手册"],"proposal_text":"","rationale":"已确认研究事实仅载明固定剂量给药方案（0.5mg每日一次口服），未提供药物过量的定义阈值、给药错误的分类标准、过量或错误给药后的紧急处理措施、报告流程及后续随访要求。本章节需要的项目级管理规程来源缺失，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97189da36a75_5206e5cc1f60bf2d","section_number":"6.4","source_ids":["protocol_full_draft_selection:6b0b7504fd49e7f4b0c3c983","current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe"]},{"ai_run_id":"airun_20260923222629_1f70ff69","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"依从：每日服药，依从性保持80%-120%","quote_sha256":"56b86609075d4273a8ed9ad13b03eb9bc93b1f836efd5a42be4651724307f0fc","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"es_compliance"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"设筛选访视（V1，Day -28~-1）、基线及首剂给药（V2，Day 1）、第2周（V3）、第4周（V4）、第8周（V5）、第12周（V6）、第16周（V7）、第20周（V8）、第24周/EOT访视（V9）、第28周/EOS随访（V10）","quote_sha256":"1c445fd9ff7227155ca5b7aca5e1056167a091081cf3b28d456d5a6f3232632c","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"es_visit_strategy"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"合成药M8：0.5mg每日一次（口服）；双盲治疗期（第1天至第24周）","quote_sha256":"1f2b4f3b4e8e649bb49ace886d5f8af6da23960ff6f58e6007307e85194decf1","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"es_dose_regimen"}],"evidence_review_advisories":[],"evidence_span_ids":["es_compliance","es_visit_strategy","es_dose_regimen"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"需确认采用药片计数、电子监测还是其他方法，以及是否每次访视均执行","category":"source_missing","gap_id":"gap_6_5_method","missing_source_classes":["依从性管理规程","访视操作手册"],"target":"依从性评估的具体方法与执行频率"},{"action":"需确认低于或高于目标范围时是否触发安全性评估、是否影响继续用药资格","category":"source_missing","gap_id":"gap_6_5_deviation","missing_source_classes":["依从性管理规程"],"target":"依从性偏离80%-120%范围时的处理措施"}],"heading":"研究治疗依从性","missing_source_classes":["依从性管理规程","访视操作手册"],"proposal_text":"本研究要求受试者每日口服一次研究药物（合成药M8 0.5mg或匹配安慰剂），双盲治疗期自第1天至第24周。依从性目标为实际服药量占应服药量的80%至120%。研究访视安排包括第2周、第4周、第8周、第12周、第16周、第20周及第24周共七次治疗期访视，各访视时由研究者或指定人员核查受试者用药依从情况。依从性评估的具体方法、各访视是否均执行药片计数或其他核查手段、以及依从性低于80%或高于120%时的处理措施，需依据方案访视操作手册和依从性管理规程进一步确认后纳入正文。","rationale":"已确认事实支持每日一次口服给药、依从性目标80%-120%、以及第2/4/8/12/16/20/24周共七次治疗期访视。但依从性评估方法（药片计数、电子监测或患者日记）、各访视是否均执行核查、以及偏离依从性目标时的处理措施未在项目来源中明确。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97189da36a75_7968600547f490cc","section_number":"6.5","source_ids":["protocol_full_draft_selection:6b0b7504fd49e7f4b0c3c983","current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe"]},{"ai_run_id":"airun_20260923222629_1f70ff69","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"对症治疗药物（解热镇痛药、抗组胺药、维生素等）（筛选期至随访期；洗脱/窗口=无；阶段=全周期；时序=全程；剂量规则=常规临床治疗剂量；允许合并对症治疗用药）","quote_sha256":"eaae87c0869552f3b52fe64d5997b39db7295e9436f788521bf2b062a5d9b99b","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"es_allowed_meds"},{"locator":"document:mwdoc_greenfield_proj_user_97189da36a75_1a5fada092706d6c:full-draft:6b0b7504fd49e7f4b0c3c983","quote":"对症治疗药物（解热镇痛药、抗组胺药、维生素等）（筛选期至随访期；洗脱/窗口=无；阶段=全周期；时序=全程；剂量规则=常规临床治疗剂量；允许合并对症治疗用药）","quote_sha256":"eaae87c0869552f3b52fe64d5997b39db7295e9436f788521bf2b062a5d9b99b","source_id":"protocol_full_draft_selection:6b0b7504fd49e7f4b0c3c983","span_id":"es_section_661"}],"evidence_review_advisories":[],"evidence_span_ids":["es_allowed_meds","es_section_661"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[{"action":"需确认解热镇痛药、抗组胺药、维生素等是否限定具体品种和剂量上限","category":"source_missing","gap_id":"gap_6_6_1_dose_range","missing_source_classes":["合并用药管理规程"],"target":"常规临床治疗剂量的具体范围界定"},{"action":"需确认合并用药审批流程及记录要求","category":"source_missing","gap_id":"gap_6_6_1_approval","missing_source_classes":["合并用药管理规程"],"target":"允许合并用药是否需研究者逐例审批"},{"action":"需确认是否需药理学评估或研究者判断后方可合并使用","category":"source_missing","gap_id":"gap_6_6_1_interaction","missing_source_classes":["药理学相互作用资料","合并用药管理规程"],"target":"与背景干扰素β的相互作用评估要求"}],"heading":"允许的合并用药/治疗","missing_source_classes":["合并用药管理规程","药理学相互作用资料"],"proposal_text":"本研究允许受试者在筛选期至安全随访期全程合并使用对症治疗药物，包括解热镇痛药、抗组胺药及维生素等，剂量遵循常规临床治疗剂量，无需设置洗脱期或用药窗口期。上述允许合并用药适用于双盲治疗期及安全随访期全部阶段，时序为全程允许。受试者在筛选期及整个研究期间可维持既往稳定的背景注射干扰素β治疗，但须保持既往稳定剂量不变。其他S1P受体调节剂、其他疾病修正治疗药物、强CYP3A4抑制剂或诱导剂及活疫苗为禁止合并用药，须在筛选前至少3个月完成洗脱。允许合并用药中'常规临床治疗剂量'的具体范围界定、是否需要研究者逐例审批、以及与背景干扰素β的相互作用评估要求，需依据合并用药管理规程和药理学资料进一步确认后纳入正文。","rationale":"已确认事实支持允许合并对症治疗药物（解热镇痛药、抗组胺药、维生素等）、全程无洗脱窗口、常规临床治疗剂量规则，以及背景干扰素β维持稳定剂量。但'常规临床治疗剂量'的具体范围、逐例审批要求、与背景治疗的相互作用评估标准未在项目来源中明确。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97189da36a75_8c3cc0c755b7d730","section_number":"6.6.1","source_ids":["protocol_full_draft_selection:6b0b7504fd49e7f4b0c3c983","current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe"]}],"source_bindings":[{"content_sha256":"21030ffbb30e453ee0ad3ae5539aef0f1de4a26eaefad7240ff60542827b5ca8","locator":"document:mwdoc_greenfield_proj_user_97189da36a75_1a5fada092706d6c:full-draft:6b0b7504fd49e7f4b0c3c983","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:6b0b7504fd49e7f4b0c3c983","source_type":"protocol_full_draft_selection","source_version":"full-draft:e0db448ca9e9c30f8689e72152f89adc6af4b067c20418fcdb5752611d7c8a49:6b0b7504fd49e7f4b0c3c983","text_sha256":"21030ffbb30e453ee0ad3ae5539aef0f1de4a26eaefad7240ff60542827b5ca8"},{"content_sha256":"f595aff1b9563247d3d31c3503929c23ec850918946e04762ebae8a0f5bee24e","locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","source_type":"current_project_study_definition","source_version":"mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","text_sha256":"f595aff1b9563247d3d31c3503929c23ec850918946e04762ebae8a0f5bee24e"}]}