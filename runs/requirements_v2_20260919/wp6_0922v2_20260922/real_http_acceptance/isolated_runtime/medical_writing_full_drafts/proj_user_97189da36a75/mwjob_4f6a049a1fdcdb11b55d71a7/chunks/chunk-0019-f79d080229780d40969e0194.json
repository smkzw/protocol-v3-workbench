e_span_ids":["es_corpus_qa","es_study_design","es_study_design7","es_study_design8"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":3},"gap_items":[{"action":"获取项目级质量保证计划及独立质量保证职能架构文件","category":"source_missing","gap_id":"gap_qa_plan","missing_source_classes":["项目级质量保证计划","稽查计划与频率规定","独立质量保证职能架构文件"],"target":"稽查频率、稽查范围与抽样比例、源数据验证方法、独立质量保证职能的汇报线与独立性保障"},{"action":"获取项目级源数据验证规程","category":"source_missing","gap_id":"gap_sdv_method","missing_source_classes":["源数据验证规程"],"target":"源数据验证的具体方法、核查比例、核查时点及偏差处理流程"}],"heading":"质量控制与保证","missing_source_classes":["项目级质量保证计划","源数据验证规程","稽查计划与频率规定","独立质量保证职能架构文件"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂对照的II期临床研究，开发区域为中国，研究中心质量保证人员对数据转移文件及统计报告数据进行抽查，以保证数据准确无误。申办者根据研究进展情况及质量控制人员与监查员的核查结果，可对临床研究过程产生的数据进行不同范畴的稽查。本研究的疗效评估涉及年化复发率、脑部MRI钆增强T1病灶累计总数、新发或扩大的T2高信号病灶数、无临床复发受试者比例及扩展残疾状态量表评分较基线变化，安全性评估涵盖不良事件与严重不良事件发生率、首次给药后6小时心率与血压动态监测、12导联心电图PR间期与房室传导阻滞监测、外周血绝对淋巴细胞计数变化及黄斑水肿光学相干断层扫描检查异常率。上述终点与安全性指标的采集、记录与核查应纳入质量控制与保证的覆盖范围。","rationale":"公司语料提供了数据质量保证的监管共性结构参照（数据抽查与稽查机制），已确认项目事实提供了多中心设计、开发区域、疗效终点与安全性评估指标清单。本章节正文基于上述两类来源撰写，但缺少项目级质量保证计划文件，无法确定稽查频率、源数据验证比例、独立质量保证职能汇报线及具体核查方法。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97189da36a75_d9c0ac2adaf6b3ae","section_number":"12.7","source_ids":["protocol_full_draft_selection:f79d080229780d40969e0194","current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]}],"source_bindings":[{"content_sha256":"69faf2f568d2e246319d7f8965bb31160079cc323b515a190caa53bace8b3c99","locator":"document:mwdoc_greenfield_proj_user_97189da36a75_1a5fada092706d6c:full-draft:f79d080229780d40969e0194","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:f79d080229780d40969e0194","source_type":"protocol_full_draft_selection","source_version":"full-draft:e0db448ca9e9c30f8689e72152f89adc6af4b067c20418fcdb5752611d7c8a49:f79d080229780d40969e