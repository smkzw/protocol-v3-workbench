finition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"es2"}],"evidence_review_advisories":[],"evidence_span_ids":["es1","es2"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"由医学经理确认各子章节是否需在本附录中给出完整操作细则或仅引用独立操作手册","category":"source_missing","gap_id":"gap_appendix_01","missing_source_classes":["项目级附录操作细则"],"target":"附录各子章节具体操作参数"}],"heading":"附录","missing_source_classes":[],"proposal_text":"本附录汇集本研究方案正文中引用的操作性技术文件与参考清单，供研究者、监查员及伦理委员会在方案执行与核查时查阅。附录涵盖的内容包括：避孕的规定与方法、实验室检查项目、安全信息报告途径。上述各子章节分别对应方案正文中安全性监测、妊娠预防及不良事件报告条款所引用的具体操作细则。本研究所设安全性监测项目包括首次给药后6小时心率与血压动态监测、12导联心电图PR间期与房室传导阻滞监测、外周血绝对淋巴细胞计数变化及黄斑水肿光学相干断层扫描检查；访视安排自筛选访视至第28周研究结束随访共设10次访视，脑部MRI于基线、第12周及第24周执行。各子章节的具体操作参数、报告时限及职责分工以项目最终定稿文件为准。","rationale":"项目已确认研究事实中列出了安全性监测项目（心率血压动态监测、心电图、ALC、OCT）及访视策略（V1至V10、MRI时点），本章节据此描述附录所涵盖的技术文件范围。各子章节的具体实施参数尚无项目级来源，需医学经理在子章节中逐项确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97189da36a75_d88f5aad3d25bdbf","section_number":"14","source_ids":["protocol_full_draft_selection:d1a591552f0723bade1bf63b","current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","company_corpus:cms_cn_protocol_corpus_20260715_v1:semantic_window:6520ebbe09a51d:c0f9d8189ccfc6:85ee0ac32bdcdc:ed8c7e23cb9a85:f4b0433bf35190:c9b1b1d4f3b846","company_corpus:cms_cn_protocol_corpus_20260715_v1:semantic_window:c0f9d8189ccfc6:85ee0ac32bdcdc:ed8c7e23cb9a85:f4b0433bf35190:c9b1b1d4f3b846:e7a96b3314e879"]},{"ai_run_id":"airun_20260924011926_a3472786","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取本项目避孕方法清单、妊娠检查时点与频率、妊娠报告流程及伴侣妊娠报告规定的项目级来源","category":"source_missing","gap_id":"gap_contraception_01","missing_source_classes":["项目级避孕与妊娠管理方案条款"],"target":"14.1避孕的规定与方法"}],"heading":"避孕的规定与方法","missing_source_classes":["项目级避孕与妊娠管理方案条款","项目级妊娠检查日程与报告流程","项目级男性受试者伴侣妊娠报告规定"],"proposal_text":"","rationale":"本项目已确认研究事实中未包含避孕方法、妊娠检查日程、妊娠报告流程或伴侣妊娠报告的项目级规定。公司参考语料为I期方案（CMS-D017），其避孕条款不得作为本项目已确认实施规则直接写入。需项目级避孕与妊娠管理文件方可形成实质正文。","review_advisories":["本节复述高影响研究设计（避孕的规定与方法）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97189da36a75_eded606b7478250d","section_number":"14.1","source_ids":["protocol_full_draft_selection:d1a591552f0723bade1bf63b","current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","company_corpus:cms_cn_protocol_corpus_20260715_v1:semantic_window:6520ebbe09a51d:c0f9d8189ccfc6:85ee0ac32bdcdc:ed8c7e23cb9a85:f4b0433bf35190:c9b1b1d4f3b846","company_corpus:cms_cn_protocol_corpus_20260715_v1:semantic_window:c0f9d8189ccfc6:85ee0ac32bdcdc:ed8c7e23cb9a85:f4b0433bf35190:c9b1b1d4f3b846:e7a96b3314e879"]},{"ai_run_id":"airun_20260924011926_a3472786","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"安全性终点：不良事件（AE）与严重不良事件（SAE）发生率；首次给药6小时心率、血压动态监测及心动过缓发生率；12导联心电图PR间期与房室传导阻滞监测；外周血绝对淋巴细胞计数（ALC）变化；黄斑水肿OCT检查异常率","quote_sha256":"062082d6c3797f28d4923b5a1da2ef780bfcafe9672279cf56a1e37647d01ba2","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"es1"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"访视策略：设筛选访视（V1，Day -28~-1）、基线及首剂给药（V2，Day 1）、第2周（V3）、第4周（V4）、第8周（V5）、第12周（V6）、第16周（V7）、第20周（V8）、第24周/EOT访视（V9）、第28周/EOS随访（V10）。MRI于基线、第12周及第24周进行；首剂V2完成6小时心电与生命体征监测。","quote_sha256":"d83d8882f2bba6decb0b6935bcd68094777744ae92c8e5de8ab4573ceda4bad2","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"es2"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"特别关注的不良事件：有症状的心动过缓或二度/三度房室传导阻滞；严重或机会性感染（疱疹病毒、PML筛查）；黄斑水肿；重度淋巴细胞减少（ALC < 0.2×10^9/L）；转氨酶显著升高（ALT/AST > 5×ULN）","quote_sha256":"9b13c6cddf87be622b486be9598c70a28a94908fb1b9fadb499d23771993bf68","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"es3"}],"evidence_review_advisories":[],"evidence_span_ids":["es1","es2","es3"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"获取本项目完整实验室检查项目清单（含血常规分类、肝肾功能、尿常规、凝血、血脂、免疫球蛋白等）及各访视对应检查组合","category":"source_missing","gap_id":"gap_lab_01","missing_source_classes":["项目级完整实验室检查项目清单","项目级访视操作手册"],"target":"14.2实验室检查项目"},{"action":"确认OCT检查是否仅在基线及特定访视执行还是每次访视均执行","category":"source_missing","gap_id":"gap_lab_02","missing_source_classes":["项目级访视操作手册"],"target":"14.2实验室检查项目"}],"heading":"实验室检查项目","missing_source_classes":["项目级完整实验室检查项目清单","项目级各访视检查组合与采集时点操作手册"],"proposal_text":"本研究所设安全性相关实验室及辅助检查项目包括：外周血绝对淋巴细胞计数（ALC）监测，用于评估S1P受体调节剂相关淋巴细胞减少风险，特别关注阈值为ALC低于0.2×10^9/L；12导联心电图检查，监测PR间期延长及房室传导阻滞，特别关注二度或三度房室传导阻滞；首次给药后6小时心率与血压动态监测，用于识别有症状心动过缓；黄斑水肿光学相干断层扫描（OCT）检查，用于监测黄斑水肿异常。上述检查在方案访视策略中对应V2（基线及首剂给药）、V3（第2周）、V4（第4周）、V5（第8周）、V6（第12周）、V7（第16周）、V8（第20周）、V9（第24周/EOT）及V10（第28周/EOS随访）执行，具体各访视是否全部包含上述全部项目以及各项目的采集时点与频率，以项目最终定稿的访视操作手册为准。","rationale":"项目已确认研究事实中安全性终点明确列出ALC变化、12导联心电图PR间期与房室传导阻滞监测、首次给药6小时心率血压动态监测及黄斑水肿OCT检查，特别关注的不良事件亦包含上述对应风险。访视策略确认V2至V10共9次治疗期及随访访视。但完整实验室检查清单（如血常规分类、肝肾功能全套、尿常规、凝血功能、血脂、免疫球蛋白等）及各访视具体检查组合尚无项目级来源，本章节仅写入已确认项目，未确认项目列入待确认项。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97189da36a75_05af3641386d56bf","section_number":"14.2","source_ids":["protocol_full_draft_selection:d1a591552f0723bade1bf63b","current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","company_corpus:cms_cn_protocol_corpus_20260715_v1:semantic_window:6520ebbe09a51d:c0f9d8189ccfc6:85ee0ac32bdcdc:ed8c7e23cb9a85:f4b0433bf35190:c9b1b1d4f3b846","company_corpus:cms_cn_protocol_corpus_20260715_v1:semantic_window:c0f9d8189ccfc6:85ee0ac32bdcdc:ed8c7e23cb9a85:f4b0433bf35190:c9b1b1d4f3b846:e7a96b3314e879"]},{"ai_run_id":"airun_20260924011926_a3472786","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取本项目安全信息报告途径（报告对象、时限、格式、SUSAR上报路径、研究者与申办方职责分工）的项目级来源","category":"source_missing","gap_id":"gap_safety_report_01","missing_source_classes":["项目级安全信息报告途径与操作细则","项目级药物警戒操作手册"],"target":"14.3安全信息报告途径"}],"heading":"安全信息报告途径","missing_source_classes":["项目级安全信息报告途径与操作细则","项目级AE/SAE/SUSAR定义与采集报告规程","项目级药物警戒操作手册"],"proposal_text":"","rationale":"本项目已确认研究事实中未包含安全信息报告途径的项目级来源，包括报告对象（伦理委员会、药品监督管理部门、申办方药物安全部门）、报告时限（SAE 24小时或7天等）、报告格式（纸质或电子）、SUSAR上报路径、研究者与申办方职责分工及随访报告要求。公司参考语料为I期方案，其报告条款不得作为本项目已确认实施规则直接写入。需项目级安全信息报告操作文件方可形成实质正文。","review_advisories":["本节复述高影响研究设计（安全信息报告途径）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97189da36a75_f73fb0fd363b886c","section_number":"14.3","source_ids":["protocol_full_draft_selection:d1a591552f0723bade1bf63b","current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","company_corpus:cms_cn_protocol_corpus_20260715_v1:semantic_window:6520ebbe09a51d:c0f9d8189ccfc6:85ee0ac32bdcdc:ed8c7e23cb9a85:f4b0433bf35190:c9b1b1d4f3b846","company_corpus:cms_cn_protocol_corpus_20260715_v1:semantic_window:c0f9d8189ccfc6:85ee0ac32bdcdc:ed8c7e23cb9a85:f4b0433bf35190:c9b1b1d4f3b846:e7a96b3314e879"]}],"source_bindings":[{"content_sha256":"4b03ea535352199e4194290c51512612dca5cd511f0f353c2db6f801f94ab79a","locator":"document:mwdoc_greenfield_proj_user_97189da36a75_1a5fada092706d6c:full-draft:d1a591552f0723bade1bf63b","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:d1a591552f0723bade1bf63b","source_type":"protocol_full_draft_selection","source_version":"full-draft:e0db448ca9e9c30f8689e72152f89adc6af4b067c20418fcdb5752611d7c8a49:d1a591552f0723bade1bf63b","text_