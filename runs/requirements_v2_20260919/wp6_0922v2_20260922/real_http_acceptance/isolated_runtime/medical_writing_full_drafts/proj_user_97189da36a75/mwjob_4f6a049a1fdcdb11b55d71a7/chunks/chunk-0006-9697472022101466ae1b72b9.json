finition_52648d82de1f5b1add03:revision:7","quote":"本研究为固定剂量双盲治疗设计，不设置计划性常规剂量调整；若出现严重心动过缓或重度淋巴细胞减少按方案规定执行安全中断或永久停药。","quote_sha256":"67e54579fc0488db047b9376ed4bfd1b3e25c167613927cab898ca279955288b","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"es_study_def_dose_adj"}],"evidence_review_advisories":[],"evidence_span_ids":["es_drug_identity","es_study_def_mech","es_study_def_dose_adj"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"获取合成药M8研究者手册，补充化学名称、结构、非临床安全性及既往临床数据","category":"source_missing","gap_id":"gap_61_ib","missing_source_classes":["研究者手册（IB）"],"target":"6.1 试验用药品"}],"heading":"试验用药品","missing_source_classes":["研究者手册（IB）","非临床药理学与毒理学报告","既往临床试验数据"],"proposal_text":"本研究的试验用药品为合成药M8，系新一代口服选择性1-磷酸鞘氨醇（S1P）受体调节剂，药物技术类型为小分子化合物，剂型为口服固体制剂，给药途径为口服，产生系统暴露。合成药M8的规格为每片含0.5 mg活性成分，推荐剂量为0.5 mg每日一次口服给药，双盲治疗期自第1天至第24周。对照组给予与合成药M8外观、气味、大小及包装完全一致的口服匹配安慰剂，每日一次口服给药，双盲治疗期同为第1天至第24周。本研究采用固定剂量双盲治疗设计，不设置计划性常规剂量调整；若出现严重心动过缓或重度淋巴细胞减少，按方案规定执行安全中断或永久停药。","rationale":"药物名称、技术类型、剂型、给药途径、剂量、给药频率、治疗周期、安慰剂匹配描述及剂量调整规则均来源于当前项目已确认研究事实。缺少IB及非临床/既往临床资料，本章仅覆盖已确认的药品基本属性与给药方案，未涉及化学结构、非临床安全性及既往临床数据。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97189da36a75_b85f68687fe33dfe","section_number":"6.1","source_ids":["protocol_full_draft_selection:9697472022101466ae1b72b9","current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","company_corpus:cms_cn_protocol_corpus_20260715_v1:6eab08a4bddb3d","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","company_corpus:cms_cn_protocol_corpus_20260715_v1:f24b1a78f9c3f8","company_corpus:cms_cn_protocol_corpus_20260715_v1:6b24da94f33534","company_corpus:cms_cn_protocol_corpus_20260715_v1:36c8fd703b73e4"]},{"ai_run_id":"airun_20260923221655_36c375d7","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinit