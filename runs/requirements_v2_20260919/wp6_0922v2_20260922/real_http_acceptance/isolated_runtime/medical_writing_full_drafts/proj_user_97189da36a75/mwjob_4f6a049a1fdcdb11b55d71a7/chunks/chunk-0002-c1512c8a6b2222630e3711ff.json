79a4e01da29d8b725d58bed6947026cd5df6793747fc033935e5af603a2","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"es_secondary"}],"evidence_review_advisories":[],"evidence_span_ids":["es_mech","es_poc","es_design","es_secondary"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"补充RRMS中国及全球流行病学数据、疾病负担描述及当前标准治疗现状","category":"source_missing","gap_id":"gap_24_epidemiology","missing_source_classes":["流行病学文献","疾病负担报告","治疗指南"],"target":"2.4 本研究的理论基础"},{"action":"补充合成药M8非临床药效学数据（如EAE动物模型疗效）及S1P受体亚型选择性数据","category":"source_missing","gap_id":"gap_24_nonclinical","missing_source_classes":["非临床研究摘要","IB"],"target":"2.4 本研究的理论基础"},{"action":"补充S1P受体调节剂类既往临床证据以支持类效应推断","category":"source_missing","gap_id":"gap_24_class_evidence","missing_source_classes":["同类药物临床文献"],"target":"2.4 本研究的理论基础"}],"heading":"本研究的理论基础","missing_source_classes":["RRMS流行病学及疾病负担数据","RRMS当前标准治疗指南或综述","合成药M8非临床药效学及动物模型数据","S1P受体调节剂类既往临床证据"],"proposal_text":"合成药M8为新一代口服选择性1-磷酸鞘氨醇（S1P）受体调节剂，其作用机制为促使淋巴细胞滞留于次级淋巴器官，减少自体反应性淋巴细胞向中枢神经系统的浸润，从而减轻神经炎性损伤。基于上述机制，本研究以概念验证（PoC）为内在研究目的，采用随机、双盲、安慰剂对照、多中心、平行组设计，疗程24周，在符合2017版McDonald诊断标准的RRMS成年患者中评估合成药M8的有效性与安全性。研究以治疗第24周年化复发率（ARR）和脑部MRI钆增强T1病灶累计总数作为主要疗效终点，以新发或扩大T2高信号病灶数、无临床复发受试者比例及EDSS评分较基线变化作为关键次要终点，旨在验证S1P受体调节策略在RRMS人群中的疾病修正效应。","rationale":"机制描述及PoC定位来源于项目研究定义中试验干预与内在研究目的字段；研究设计要素来源于总体研究设计字段；主要及次要终点来源于项目已确认终点定义。疾病背景部分（RRMS流行病学、疾病负担及当前标准治疗现状）缺少外部来源，未写入正文。需医学经理确认S1P机制表述是否完整反映合成药M8的非临床及既往临床证据链。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97189da36a75_52f0fed8a2430e26","section_number":"2.4","source_ids":["protocol_full_draft_selection:c1512c8a6b2222630e3711ff","current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20260923211310_c293f203","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"内在研究目的：概念验证（PoC）","quote_sha256":"76367fa8cfabad1cad164ff4f834e0e62843d5a8567ea38e394ea20af2692a8f","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"es_poc"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"安全性终点：不良事件（AE）与严重不良事件（SAE）发生率；首次给药6小时心率、血压动态监测及心动过缓发生率；12导联心电图PR间期与房室传导阻滞监测；外周血绝对淋巴细胞计数（ALC）变化；黄斑水肿OCT检查异常率","quote_sha256":"062082d6c3797f28d4923b5a1da2ef780bfcafe9672279cf56a1e37647d01ba2","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"es_safety"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"主要估计目标基于ICH E9(R1)：目标人群为RRMS成年患者；主要终点变量为24周ARR与Gd增强T1病灶数；伴随事件采用治疗策略属性处理；组间效应采用率比（Rate Ratio）。","quote_sha256":"9cf94cfabe8fde5dc0c42171c5fda00ec9706e31281f0d910d8345ae98cdd55e","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"es_estimand"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"特别关注的不良事件：有症状的心动过缓或二度/三度房室传导阻滞；严重或机会性感染（疱疹病毒、PML筛查）；黄斑水肿；重度淋巴细胞减少（ALC < 0.2×10^9/L）；转氨酶显著升高（ALT/AST > 5×ULN）","quote_sha256":"9b13c6cddf87be622b486be9598c70a28a94908fb1b9fadb499d23771993bf68","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"es_aes"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"总体研究设计：随机、双盲、安慰剂对照、多中心、平行组设计，疗程24周，允许背景注射干扰素β","quote_sha256":"80a088f7a51342e4fdaecab8ce775999cb3335f5dca1b6486753881421ecea02","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"es_design"}],"evidence_review_advisories":[],"evidence_span_ids":["es_poc","es_safety","es_estimand","es_aes","es_design"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"确认本研究是否设置探索性目的与终点（如PK、生物标志物、PRO）；若不设置则明确声明","category":"decision_pending","gap_id":"gap_3_exploratory","missing_source_classes":[],"target":"3 研究目的和终点"},{"action":"明确TEAE采集窗口起止时点及安全性评估窗口的精确定义","category":"source_missing","gap_id":"gap_3_safety_window","missing_source_classes":["安全性评估窗口定义"],"target":"3 研究目的和终点"}],"heading":"研究目的和终点","missing_source_classes":["探索性目的与终点定义（如药代动力学、生物标志物）","安全性评估窗口的精确定义（TEAE采集起止时点）","次要安全性终点（如实验室检查异常率）"],"proposal_text":"本研究的内在研究目的为概念验证（PoC），旨在验证合成药M8作为口服选择性S1P受体调节剂在复发缓解型多发性硬化（RRMS）成年患者中的疾病修正效应。主要研究目的为评估合成药M8连续口服24周对RRMS患者疾病活动度的抑制作用。主要终点包括：（1）治疗第24周时的年化复发率（Annualized Relapse Rate, ARR）；（2）治疗第24周时脑部MRI检查的钆（Gd）增强T1病灶累计总数。主要估计目标基于ICH E9(R1)框架，目标人群为RRMS成年患者，主要终点变量为24周ARR与Gd增强T1病灶数，伴随事件采用治疗策略属性处理，组间效应采用率比（Rate Ratio）进行评价。安全性目的为评估合成药M8在24周治疗期及停药后4周安全随访期内的安全性与耐受性。安全性终点包括：不良事件（AE）与严重不良事件（SAE）发生率；首次给药6小时心率、血压动态监测及心动过缓发生率；12导联心电图PR间期与房室传导阻滞监测；外周血绝对淋巴细胞计数（ALC）变化；黄斑水肿OCT检查异常率。特别关注的不良事件包括：有症状的心动过缓或二度/三度房室传导阻滞；严重或机会性感染（疱疹病毒、PML筛查）；黄斑水肿；重度淋巴细胞减少（ALC < 0.2×10^9/L）；转氨酶显著升高（ALT/AST > 5×ULN）。","rationale":"研究目的（PoC）、主要终点（ARR、Gd增强T1病灶数）、估计目标策略（ICH E9(R1)、率比）、安全性终点及特别关注不良事件均来源于项目研究定义中已确认字段。安全性评估窗口（24周治疗期加4周随访）来源于研究时期定义。需医学经理确认：双主要终点的统计策略是否需进一步细化；安全性终点中各监测项目的具体实施时点与频率是否需与访视计划逐一对应；探索性目的与终点是否设置。","review_advisories":["本节复述高影响研究设计（研究目的和终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、估计目标）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97189da36a75_75b55676556847bb","section_number":"3","source_ids":["protocol_full_draft_selection:c1512c8a6b2222630e3711ff","current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20260923211310_c293f203","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"关键次要终点：治疗第24周时新发或扩大的T2高信号病灶数；治疗24周期间无临床复发的受试者比例；治疗第24周时扩展残疾状态量表（EDSS）评分较基线的变化","quote_sha256":"ed84e79a4e01da29d8b725d58bed6947026cd5df6793747fc033935e5af603a2","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"es_secondary"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"总体研究设计：随机、双盲、安慰剂对照、多中心、平行组设计，疗程24周，允许背景注射干扰素β","quote_sha256":"80a088f7a51342e4fdaecab8ce775999cb3335f5dca1b6486753881421ecea02","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"es_design"}],"evidence_review_advisories":[],"evidence_span_ids":["es_secondary","es_design"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"确认T2病灶数评价是否仅基于第24周MRI还是包含第12周MRI","category":"source_missing","gap_id":"gap_32_mri_timing","missing_source_classes":["MRI采集时点定义"],"target":"3.2 次要目的和次要终点"},{"action":"确认EDSS评分较基线变化的评价时点是否仅限第24周","category":"source_missing","gap_id":"gap_32_edss_timing","missing_source_classes":["EDSS评价时点定义"],"target":"3.2 次要目的和次要终点"},{"action":"明确无临床复发比例的分母定义及脱落受试者处理规则","category":"source_missing","gap_id":"gap_32_noclinrec","missing_source_classes":["次要终点统计定义"],"target":"3.2 次要目的和次要终点"}],"heading":"次要目的和次要终点","missing_source_classes":["次要终点中MRI采集时点的完整定义","EDSS评价时点是否包含中间访视","无临床复发比例的分母与脱落处理规则"],"proposal_text":"本研究的次要研究目的为在主要终点基础上进一步评估合成药M8对RRMS患者亚临床疾病活动及残疾进展的影响。关键次要终点包括：（1）治疗第24周时新发或扩大的T2高信号病灶数；（2）治疗24周期间无临床复发的受试者比例；（3）治疗第24周时扩展残疾状态量表（EDSS）评分较基线的变化。上述三项关键次要终点与主要终点共同构成对S1P受体调节策略在RRMS中疾病修正效应的多维度评价：T2病灶数反映亚临床炎性活动，无临床复发比例反映临床疾病控制，EDSS变化反映残疾进展趋势。","rationale":"三项关键次要终点名称及评价时点（第24周）来源于项目研究定义中关键次要终点字段。次要研究目的的表述为基于已确认终点内容的合理归纳。需医学经理确认：EDSS评分较基线变化是否仅在第24周评价，还是包含中间访视时点；T2病灶数的MRI采集是否仅限第24周或包含第12周；无临床复发比例的分母定义（是否包含脱落受试者）。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97189da36a75_b887533bfea62317","section_number":"3.2","source_ids":["protocol_full_draft_selection:c1512c8a6b2222630e3711ff","current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]}],"source_bindings":[{"content_sha256":"c45ecf5f72c653f9ee8989983fa3b86f936f547cf6b572e84b0c24133401f1ec","locator":"document:mwdoc_greenfield_proj_user_97189da36a75_1a5fada092706d6c:full-draft:c1512c8a6b2222630e3711ff","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:c1512c8a6b2222630e3711ff","source_type":"protocol_full_draft_selection","source_version":"full-draft:e0db448ca9e9c30f8689e72152f89adc6af4b067c20418fcdb5752611d7c8a49:c1512c8a6b2222630e3711ff","text_sha256":"c45ecf5f72c653f9ee8989983fa3b86f936f547cf6b572e84b0c24133401f1ec"},{"content_sha256":"f595aff1b9563247d3d31c3503929c23ec850918946e04762ebae8a0f5bee24e","locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","source_type":"current_project_study_definition","source_version":"mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","text_sha256":"f595aff1b9563247d3d31c3503929c23ec85091