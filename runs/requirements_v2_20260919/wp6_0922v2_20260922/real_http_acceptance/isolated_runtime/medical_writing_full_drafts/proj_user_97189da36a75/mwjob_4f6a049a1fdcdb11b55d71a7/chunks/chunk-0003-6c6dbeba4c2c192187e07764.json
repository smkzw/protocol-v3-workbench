1add03:r7:13b90e8dcf1462fe","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0"]},{"ai_run_id":"airun_20260923213536_92b8d016","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"研究题目：合成药M8用于治疗复发缓解型多发性硬化的II期临床研究","quote_sha256":"21d09f62af2b48002ca50594df9d9e8757b037c72cb640ecb606dcc25ffb500a","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-TITLE"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"研究分期：II期","quote_sha256":"0cd03d3b6552ef4d709f859513123058d34ed8e8f0e5ae9b9b7e718967255947","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-PHASE"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"开发区域：中国","quote_sha256":"cff843d358ea50e7e53ede8d1eba9b9d23baa740d2cd2134679e6483c3e50b76","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-REGION"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"内在研究目的：概念验证（PoC）","quote_sha256":"76367fa8cfabad1cad164ff4f834e0e62843d5a8567ea38e394ea20af2692a8f","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-PURPOSE"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"总体研究设计：随机、双盲、安慰剂对照、多中心、平行组设计，疗程24周，允许背景注射干扰素β","quote_sha256":"80a088f7a51342e4fdaecab8ce775999cb3335f5dca1b6486753881421ecea02","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-DESIGN"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"对照：采用双盲安慰剂对照设计，受试者按1:1比例随机分配至合成药M8组（0.5mg qd）或匹配的口服安慰剂对照组。安慰剂外观、气味、大小及包装与合成药M8片剂完全一致。允许受试者在筛选期及整个研究期间维持既有稳定的背景注射干扰素β（IFN-β）治疗，以保障受试者伦理与基础疾病控制；组间分层随机化保持背景干扰素β使用比例均衡。","quote_sha256":"0bd04d84bf7750f45c4d3162498089654e2dd1d1989028816100b378feb7de0e","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-CONTROL"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"剂量与给药方案：合成药M8：0.5mg每日一次（口服）；双盲治疗期（第1天至第24周）。依从：每日服药，依从性保持80%-120%","quote_sha256":"a7f80ade0be07817af56119089e867ad3f27d3368d4c67b2a0bdcd07626d02fb","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-DOSE"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"必需背景治疗：背景注射干扰素β（IFN-β）（筛选期至第24周；策略=allowed_if_stable；洗脱/窗口=保持既往稳定剂量；阶段=筛选期及双盲治疗期；时序=全程；剂量规则=保持稳定剂量；允许维持既往稳定的背景注射干扰素β治疗）","quote_sha256":"7134f4ecfebfd38dc5046c2282db81a73b2e04086000d95c6f025b6dc7eaa8f4","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-BG"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"研究人群概述：符合2017版McDonald诊断标准的复发缓解型多发性硬化（RRMS）成年患者（18-55岁），筛选前1年内至少有1次有记录的临床复发，或筛选前2年内至少有2次临床复发，或筛选期基线脑部MRI检查存在至少1个钆（Gd）增强T1病灶；筛选时扩展残疾状态量表（EDSS）评分在0至5.5分之间（含边界值）。","quote_sha256":"e44e185a34662168fce1d7ac63cb343b6a0db2b4aa71bc169ffb9de6c3d6f9b9","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-POP"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"入选标准模块：1. 年龄18-55周岁（含边界值），男女不限；2. 经2017版McDonald标准确诊为复发缓解型多发性硬化（RRMS）；3. 筛选前1年至少有1次复发，或筛选前2年至少有2次复发，或筛选前6个月内MRI显示至少1个钆（Gd）增强T1病灶；4. 筛选期EDSS评分0-5.5分；5. 愿意签署知情同意书并遵循试验方案。","quote_sha256":"5a8b7f90c913885fbd3e03c2dafcf18558ca02ba064175ab1772e74abee73f47","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-INCL"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"研究时期：筛选期（Day -28 ~ Day -1）；双盲治疗期（Day 1 ~ Week 24）；安全随访期（停药后4周/Week 28）","quote_sha256":"1e596b24162bd6f501583ffd1dff87033faf600bd9949f61f43a0bd0ef7f47be","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-PERIODS"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"访视策略：设筛选访视（V1，Day -28~-1）、基线及首剂给药（V2，Day 1）、第2周（V3）、第4周（V4）、第8周（V5）、第12周（V6）、第16周（V7）、第20周（V8）、第24周/EOT访视（V9）、第28周/EOS随访（V10）。MRI于基线、第12周及第24周进行；首剂V2完成6小时心电与生命体征监测。","quote_sha256":"d83d8882f2bba6decb0b6935bcd68094777744ae92c8e5de8ab4573ceda4bad2","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-VISITS"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"样本量策略：假设安慰剂组24周ARR为0.60，合成药M8组相对降低50%至0.30，设定双侧α=0.05，把握度80%，1:1比例分配，考虑15%脱落率，计划入组约200例（每组100例），对Gd增强病灶数差异把握度>90%。","quote_sha256":"85b6b82ce9fd3cb04508ac8565d58580abd088786cf3fa0675c556de115543ce","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-SAMPLE"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"主要终点：1. 治疗第24周时的年化复发率（Annualized Relapse Rate, ARR）；","quote_sha256":"3b30bc679bd7d8cdb6b4e47e32b78b485c85998e03d01ed6bccfcbece94da4aa","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-PRIMARY"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"2. 治疗第24周时脑部MRI检查的钆（Gd）增强T1病灶累计总数。","quote_sha256":"1d559e7bfb76e297deb5c80cb69c028701478682173e6c2c74f6606a5795cdf9","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-PRIMARY2"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"关键次要终点：治疗第24周时新发或扩大的T2高信号病灶数；治疗24周期间无临床复发的受试者比例；治疗第24周时扩展残疾状态量表（EDSS）评分较基线的变化","quote_sha256":"ed84e79a4e01da29d8b725d58bed6947026cd5df6793747fc033935e5af603a2","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-KEY-SEC"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"自适应设计是否计划：否","quote_sha256":"c71bda4d6101542f8a3c2bb0087631982c72176be9ca9a2526dc2c08ed0ee52a","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-ADAPT"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"样本量再估计是否计划：否","quote_sha256":"913a62236e4f4332a7188562f2625d53aa7f770cea155664564c5fb821a98efd","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-REEST"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"期中分析是否计划：否","quote_sha256":"31ef70e7f5cd03d6c17b90802e7352c6e81b5fdc853989b74ea1499901f514a4","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-INTERIM"}],"evidence_review_advisories":[],"evidence_span_ids":["E-S2-TITLE","E-S2-PHASE","E-S2-REGION","E-S2-PURPOSE","E-S2-DESIGN","E-S2-CONTROL","E-S2-DOSE","E-S2-BG","E-S2-POP","E-S2-INCL","E-S2-PERIODS","E-S2-VISITS","E-S2-SAMPLE","E-S2-PRIMARY","E-S2-PRIMARY2","E-S2-KEY-SEC","E-S2-ADAPT","E-S2-REEST","E-S2-INTERIM"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":19},"gap_items":[],"heading":"研究设计","missing_source_classes":[],"proposal_text":"本研究为在中国开展的II期临床研究，研究药物为合成药M8，适应症为复发缓解型多发性硬化（RRMS），内在研究目的为概念验证。研究采用随机、双盲、安慰剂对照、多中心、平行组设计，受试者按1:1比例随机分配至合成药M8 0.5mg每日一次口服组或匹配的口服安慰剂组，双盲治疗期自第1天至第24周，随后进入停药后4周的安全随访期（第28周）。本研究不计划自适应设计、样本量再估计或期中分析。目标人群为符合2017版McDonald诊断标准的RRMS成人患者，年龄18至55周岁（含边界值），筛选时扩展残疾状态量表（EDSS）评分为0至5.5分（含边界值），且筛选前1年内至少有1次有记录的临床复发，或筛选前2年内至少有2次临床复发，或筛选期基线脑部MRI检查存在至少1个钆（Gd）增强T1病灶。研究允许受试者在筛选期及双盲治疗期维持既往稳定的背景注射干扰素β治疗，并通过分层随机化保持组间背景干扰素β使用比例均衡。计划入组约200例受试者，每组100例。主要终点为治疗第24周时的年化复发率（ARR）以及治疗第24周时脑部MRI检查的钆（Gd）增强T1病灶累计总数；关键次要终点为治疗第24周时新发或扩大的T2高信号病灶数、治疗24周期间无临床复发的受试者比例以及治疗第24周时EDSS评分较基线的变化。研究按筛选期、双盲治疗期和安全随访期实施，设筛选访视、基线及首剂给药访视、第2周、第4周、第8周、第12周、第16周、第20周、第24周及第28周访视。","rationale":"正文中的研究分期、开发区域、内在研究目的、设计类型、目标人群、给药方案、背景治疗、主要与关键次要终点、研究时期、访视安排及计划入组例数均来自已确认研究事实。医学作者需核对最终方案版本、统计分析文件与入排标准措辞的一致性，并确认本章不含未获来源支持的设计要素。","review_advisories":["本节复述高影响研究设计（研究设计）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、期中分析、样本量、计划入组）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97189da36a75_eef7a35816cb7286","section_number":"4","source_ids":["protocol_full_draft_selection:6c6dbeba4c2c192187e07764","current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0"]},{"ai_run_id":"airun_20260923213536_92b8d016","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"总体研究设计：随机、双盲、安慰剂对照、多中心、平行组设计，疗程24周，允许背景注射干扰素β","quote_sha256":"80a088f7a51342e4fdaecab8ce775999cb3335f5dca1b6486753881421ecea02","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-DESIGN"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"对照：采用双盲安慰剂对照设计，受试者按1:1比例随机分配至合成药M8组（0.5mg qd）或匹配的口服安慰剂对照组。安慰剂外观、气味、大小及包装与合成药M8片剂完全一致。允许受试者在筛选期及整个研究期间维持既有稳定的背景注射干扰素β（IFN-β）治疗，以保障受试者伦理与基础疾病控制；组间分层随机化保持背景干扰素β使用比例均衡。","quote_sha256":"0bd04d84bf7750f45c4d3162498089654e2dd1d1989028816100b378feb7de0e","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-CONTROL"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"剂量与给药方案：合成药M8：0.5mg每日一次（口服）；双盲治疗期（第1天至第24周）。依从：每日服药，依从性保持80%-120%","quote_sha256":"a7f80ade0be07817af56119089e867ad3f27d3368d4c67b2a0bdcd07626d02fb","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-DOSE"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"必需背景治疗：背景注射干扰素β（IFN-β）（筛选期至第24周；策略=allowed_if_stable；洗脱/窗口=保持既往稳定剂量；阶段=筛选期及双盲治疗期；时序=全程；剂量规则=保持稳定剂量；允许维持既往稳定的背景注射干扰素β治疗）","quote_sha256":"7134f4ecfebfd38dc5046c2282db81a73b2e04086000d95c6f025b6dc7eaa8f4","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-BG"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"研究时期：筛选期（Day -28 ~ Day -1）；双盲治疗期（Day 1 ~ Week 24）；安全随访期（停药后4周/Week 28）","quote_sha256":"1e596b24162bd6f501583ffd1dff87033faf600bd9949f61f43a0bd0ef7f47be","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-PERIODS"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"自适应设计是否计划：否","quote_sha256":"c71bda4d6101542f8a3c2bb0087631982c72176be9ca9a2526dc2c08ed0ee52a","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-ADAPT"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"样本量再估计是否计划：否","quote_sha256":"913a62236e4f4332a7188562f2625d53aa7f770cea155664564c5fb821a98efd","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-REEST"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"期中分析是否计划：否","quote_sha256":"31ef70e7f5cd03d6c17b90802e7352c6e81b5fdc853989b74ea1499901f514a4","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-INTERIM"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"SRC是否计划：否","quote_sha256":"c313c8ef9ed6e2107818bc5d2c8caa143c85bf55ac51060b4e8cc53c959daf6e","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-SRC"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"DMC是否计划：否","quote_sha256":"7463c7eb67cd6a318d836f289e02648d5296c8dfe0b2f415f8f2bed6e14be4a2","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-DMC"}],"evidence_review_advisories":[],"evidence_span_ids":["E-S2-DESIGN","E-S2-CONTROL","E-S2-DOSE","E-S2-BG","E-S2-PERIODS","E-S2-ADAPT","E-S2-REEST","E-S2-INTERIM","E-S2-SRC","E-S2-DMC"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":10},"gap_items":[],"heading":"总体设计","missing_source_classes":[],"proposal_text":"本研究采用随机、双盲、安慰剂对照、多中心、平行组设计。受试者按1:1比例随机分配至合成药M8组或匹配的口服安慰剂组；合成药M8组接受0.5mg每日一次口服给药，安慰剂组所接受的安慰剂在外观、气味、大小及包装方面与合成药M8片剂完全一致。双盲治疗期自第1天至第24周，治疗结束后进入停药后4周的安全随访期。研究允许受试者在筛选期及整个研究期间维持既往稳定的背景注射干扰素β（IFN-β）治疗，以保障受试者伦理与基础疾病控制，并通过分层随机化保持组间背景干扰素β使用比例均衡。本研究不计划自适应设计、样本量再估计或期中分析，不设置SRC与DMC。","rationale":"总体设计、1:1随机、匹配安慰剂、24周双盲治疗期与4周安全随访期、背景注射干扰素β稳定使用及分层随机化均衡安排均来自已确认研究事实，不设置自适应设计、样本量再估计、期中分析、SRC与DMC亦由已确认事实支持。医学作者需核对分层因素、随机化实施描述与最终随机化方案的表述一致性。","review_advisories":["本节复述高影响研究设计（总体设计）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（期中分析、样本量）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97189da36a75_037ca0c762dc8aee","section_number":"4.1","source_ids":["protocol_full_draft_selection:6c6dbeba4c2c192187e07764","current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0"]},{"ai_run_id":"airun_20260923213536_92b8d016","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"试验干预：合成药M8为新一代口服选择性1-磷酸鞘氨醇（S1P）受体调节剂，通过促使淋巴细胞滞留于次级淋巴器官，减少自体反应性淋巴细胞向中枢神经系统的浸润，从而减轻神经炎性损伤。本试验中合成药M8连续治疗24周，评估其在RRMS患者中的有效性与安全性。","quote_sha256":"22234fe052cdbe66b4531cd87737fc8c03707687953fb84c52ab5207e94074b2","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-INTERV"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"剂量与给药方案：合成药M8：0.5mg每日一次（口服）；双盲治疗期（第1天至第24周）。依从：每日服药，依从性保持80%-120%","quote_sha256":"a7f80ade0be07817af56119089e867ad3f27d3368d4c67b2a0bdcd07626d02fb","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-DOSE"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"给药途径：口服","quote_sha256":"404b058b755608a73d13b54521a28c02b129df449774d0671b1c3f8b8a5ce42c","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-ROUTE"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"剂型：口服固体制剂","quote_sha256":"2c22ee80756bfd178af43cee3c8a0a1b4058aaecb83d264b4107972a334b5bf4","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-FORM"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"局部/系统暴露范围：systemic","quote_sha256":"83a8469236905f60f11fec86f93234f3ddf2027482e82bafa90802a6e138e6e2","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-EXPOSURE"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"剂量调整：本研究为固定剂量双盲治疗设计，不设置计划性常规剂量调整","quote_sha256":"596e7e13e13d68851d472ae98be2231eac169bcdd3813f8b4f755ec3d20f0910","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-DOSE-ADJ"},{"locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","quote":"安全性终点：不良事件（AE）与严重不良事件（SAE）发生率；首次给药6小时心率、血压动态监测及心动过缓发生率；12导联心电图PR间期与房室传导阻滞监测；外周血绝对淋巴细胞计数（ALC）变化；黄斑水肿OCT检查异常率","quote_sha256":"062082d6c3797f28d4923b5a1da2ef780bfcafe9672279cf56a1e37647d01ba2","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","span_id":"E-S2-SAFETY"}],"evidence_review_advisories":[],"evidence_span_ids":["E-S2-INTERV","E-S2-DOSE","E-S2-ROUTE","E-S2-FORM","E-S2-EXPOSURE","E-S2-DOSE-ADJ","E-S2-SAFETY"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":7},"gap_items":[{"action":"补充检索并纳入研究药物研究者手册、非临床药理毒理资料、既往临床研究与剂量递增资料及暴露-效应分析资料，用于完善0.5mg每日一次剂量选择的完整论证。","category":"source_not_retrieved","gap_id":"GAP-4.2.1-DOSE-BASIS","missing_source_classes":["研究药物研究者手册（IB）","非临床药理毒理研究资料","既往临床研究与剂量递增资料","暴露-效应分析资料"],"target":"4.2.1 剂量选择依据"}],"heading":"剂量选择依据","missing_source_classes":["研究药物研究者手册（IB）","非临床药理毒理研究资料","既往临床研究与剂量递增资料","暴露-效应分析资料"],"proposal_text":"合成药M8为新一代口服选择性1-磷酸鞘氨醇（S1P）受体调节剂，通过促使淋巴细胞滞留于次级淋巴器官，减少自体反应性淋巴细胞向中枢神经系统的浸润，从而减轻神经炎性损伤。本研究选择的给药方案为0.5mg每日一次口服，剂型为口服固体制剂，给药途径为口服，药物暴露范围为全身性，双盲治疗期自第1天至第24周连续给药。本研究为固定剂量双盲治疗设计，不设置计划性常规剂量调整；受试者每日服药，依从性保持80%-120%。与合成药M8给药相关的安全性观察项目包括：不良事件与严重不良事件发生率，首次给药6小时心率、血压动态监测及心动过缓发生率，12导联心电图PR间期与房室传导阻滞监测，外周血绝对淋巴细胞计数（ALC）变化，以及黄斑水肿OCT检查异常率。","rationale":"正文写入的是已确认研究事实支持的内容：合成药M8的作用机制类别、0.5mg每日一次口服给药、口服固体制剂、全身暴露、24周连续给药、固定剂量设计、依从性范围以及与给药相关的安全性观察项目。0.5mg剂量的完整选择依据需要研究药物研究者手册、非临床药理毒理资料与既往临床及暴露-效应资料支持，相关来源类别已列入缺口项，由医学作者在来源补充后完善剂量选择的完整论证。","review_advisories":["本节复述高影响研究设计（剂量选择依据）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_97189da36a75_06390d95c7202b34","section_number":"4.2.1","source_ids":["protocol_full_draft_selection:6c6dbeba4c2c192187e07764","current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0"]}],"source_bindings":[{"content_sha256":"86cf0eab126797d36a26df0af5cb3a355a572b832b23121cfa4b97cf21241916","locator":"document:mwdoc_greenfield_proj_user_97189da36a75_1a5fada092706d6c:full-draft:6c6dbeba4c2c192187e07764","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:6c6dbeba4c2c192187e07764","source_type":"protocol_full_draft_selection","source_version":"full-draft:e0db448ca9e9c30f8689e72152f89adc6af4b067c20418fcdb5752611d7c8a49:6c6dbeba4c2c192187e07764","text_sha256":"86cf0eab126797d36a26df0af5cb3a355a572b832b23121cfa4b97cf21241916"},{"content_sha256":"f595aff1b9563247d3d31c3503929c23ec850918946e04762ebae8a0f5bee24e","locator":"study_definition:mwdefinition_52648d82de1f5b1add03:revision:7","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","source_type":"current_project_study_definition","source_version":"mwdefinition_52648d82de1f5b1add03:r7:13b90e8dcf1462fe","text_sha256":"f595aff1b9563247d3d31c3503929c23ec850918946e04762ebae8a0f5bee24e"},{"content_sha256":"d201ce569054cbbf7236ebc38a81549ab6777a6cd5f2fedc31a501f7bd4655a7","locator":"section:6.3.3 揭盲|block:488|chunk:1","role":