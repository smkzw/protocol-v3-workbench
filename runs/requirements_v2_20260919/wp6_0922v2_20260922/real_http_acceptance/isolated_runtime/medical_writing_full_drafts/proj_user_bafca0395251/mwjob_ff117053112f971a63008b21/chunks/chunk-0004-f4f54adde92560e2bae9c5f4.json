sha256":"d8ca21a7e62cbca0e65228c7147e2ce5e59273b60f0d0cc55ed216f48e27710c","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_026"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"局部/系统暴露范围：systemic","quote_sha256":"83a8469236905f60f11fec86f93234f3ddf2027482e82bafa90802a6e138e6e2","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_027"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"随机、双盲、安慰剂对照、平行组、多中心II期剂量探索研究","quote_sha256":"39c08a5a5286b28cb5a9b165fa342ae8ee7ba16282905492b660d6c91cffd1c1","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_028"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"主要分析：ANCOVA比较组间第12周NT-proBNP较基线变化（对数转换），基线值为协变量","quote_sha256":"5cb6ce2a9219ec9693fc9319d034ed078024f463707b3858a87a991f33f7e54f","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_029"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"安全性采用描述性统计","quote_sha256":"a3c1e11391a9baaf9c1df28fe19132f252a6179bbcff23d233ebd9a36341b93c","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_030"}],"evidence_review_advisories":[],"evidence_span_ids":["es_001","es_002","es_003","es_009","es_010","es_011","es_012","es_013","es_014","es_015","es_016","es_017","es_018","es_019","es_020","es_021","es_022","es_023","es_024","es_025","es_026","es_027","es_028","es_029","es_030"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":25},"gap_items":[],"heading":"总体设计","missing_source_classes":[],"proposal_text":"本研究为一项随机、双盲、安慰剂对照、平行组、多中心II期剂量探索研究，旨在评价口服可溶性鸟苷酸环化酶（sGC）刺激剂KZ-sGC1501薄膜衣片在中国成年慢性心力衰竭（射血分数降低，HFrEF）患者中的有效性与安全性。研究人群为中国成年慢性心力衰竭（LVEF≤40%，NYHA II-III级）患者，在标准心衰治疗基础上症状仍持续。受试者按随机分配接受KZ-sGC1501 2.5mg、5mg、10mg每日一次（口服，随餐）或匹配安慰剂薄膜衣片每日一次，治疗期为第1天至第12周。研究采用双模拟设计，安慰剂与试验药同步使用12周。研究时期包括筛选期（-28至-1天）、治疗期（第1天至第12周）和治疗结束后30天安全性随访期。访视安排为筛选（V1）、基线（V2，第1天）、第2周（V3）、第4周（V4）、第8周（V5）、第12周（V6，终点）及30天安全性随访。主要终点为第12周NT-proBNP较基线的变化百分比（中心实验室检测）。主要估计目标采用疗法策略，伴发事件按抢救治疗策略处理。主要分析采用ANCOVA比较组间第12周NT-proBNP较基线变化（对数转换），以基线值为协变量；安全性采用描述性统计。样本量按主要终点NT-proBNP组间差异估算，每组约100例，考虑15%脱落率，总样本量约240例。","rationale":"本章正文依据当前项目已确认研究事实中的总体研究设计、研究分期、研究人群概述、剂量与给药方案、安慰剂设计、研究时期、访视策略、主要终点、估计目标策略、统计分析策略及样本量策略逐项写入。医学经理需核实：（1）双盲的具体覆盖范围（哪些角色处于盲态）；（2）安慰剂双模拟设计的操作细节是否完整；（3）样本量估算中每组约100例对应的组数（3个剂量组加安慰剂组共4组，4×100=400与总样本量约240存在差异，需确认实际分组与每组例数）；（4）ANCOVA分析中是否需按中心或分层因素调整。","review_advisories":["本节复述高影响研究设计（总体设计）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、估计目标、伴发事件、样本量）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bafca0395251_39d1ac6d9947daf8","section_number":"4.1","source_ids":["protocol_full_draft_selection:f4f54adde92560e2bae9c5f4","current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:97a2bd7fcf7302"]},{"ai_run_id":"airun_20261009191638_b6c4ca4d","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"估计目标策略：主要估计目标：第12周NT-proBNP较基线变化（疗法策略）；伴发事件按抢救治疗策略处理","quote_sha256":"946b21c4a9281366ebf399361fb40e12dba3e06676db8a90a4c1ef15cb627c84","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_003"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"靶点/作用机制：直接刺激sGC酶并稳定一氧化氮-sGC-cGMP通路，提高细胞内cGMP水平","quote_sha256":"a884dd972c849b4e696ca8d01923d01caf87ecc856153929b527966894291aa9","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_007"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"内在研究目的：概念验证（PoC）；剂量探索","quote_sha256":"2d096e242bbd65d0c9236718d79e77a388e84cb9640b99bd47662a6ce8faab31","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_008"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"主要终点：第12周NT-proBNP较基线的变化百分比（中心实验室检测）","quote_sha256":"9d5bacc777ee318a4c129cba33a5402c741235ab7876aa731edcc277c02f5520","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_009"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"统计分析策略：主要分析：ANCOVA比较组间第12周NT-proBNP较基线变化（对数转换），基线值为协变量；安全性采用描述性统计","quote_sha256":"1449b60ca0784e680b7fb4135cdb426ba88fcf90006947d20304d3e668764f5c","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_011"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"安全性终点：不良事件与严重不良事件发生率；生命体征与低血压事件；肝肾功能、血常规、心电图变化","quote_sha256":"722787d06ac5743572cd922187c49fbb8c5efe7d7e11e26f072c2d223c2e5271","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_018"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"主要分析：ANCOVA比较组间第12周NT-proBNP较基线变化（对数转换），基线值为协变量","quote_sha256":"5cb6ce2a9219ec9693fc9319d034ed078024f463707b3858a87a991f33f7e54f","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_029"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"安全性采用描述性统计","quote_sha256":"a3c1e11391a9baaf9c1df28fe19132f252a6179bbcff23d233ebd9a36341b93c","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_030"}],"evidence_review_advisories":[],"evidence_span_ids":["es_003","es_007","es_008","es_009","es_011","es_018","es_029","es_030"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":8},"gap_items":[{"action":"补充NT-proBNP在HFrEF临床试验中作为替代终点的方法学依据及既往sGC刺激剂研究终点选择文献","category":"source_missing","gap_id":"gap_42_01","missing_source_classes":["方法学论证文献","既往临床研究资料"],"target":"4.2节设计依据中NT-proBNP终点选择论证"},{"action":"明确本研究中伴发事件的具体类型（如心衰住院、紧急再血管化、死亡等）及抢救治疗策略下数据截断规则","category":"source_missing","gap_id":"gap_42_02","missing_source_classes":["估计目标策略操作细则"],"target":"4.2节设计依据中伴发事件定义与抢救治疗策略操作细则"},{"action":"补充KZ-sGC1501非临床药效学数据及既往人体PK/PD资料以支持2.5mg/5mg/10mg剂量选择","category":"source_missing","gap_id":"gap_42_03","missing_source_classes":["非临床研究资料","既往人体研究数据"],"target":"4.2节设计依据中剂量探索的剂量-暴露-效应关系论证"}],"heading":"设计依据","missing_source_classes":["NT-proBNP作为主要终点的方法学论证文献","sGC刺激剂类药物的剂量-暴露-效应关系资料","伴发事件定义与抢救治疗策略操作细则"],"proposal_text":"本研究的估计目标策略如下：主要估计目标为第12周NT-proBNP较基线变化，采用疗法策略（treatment policy），即无论受试者是否依从方案规定的给药方案、是否因任何原因中断或退出治疗，均按随机分配组别进行分析。伴发事件（intercurrent events）按抢救治疗策略（while-on-treatment）处理，即伴发事件发生后的数据不纳入主要分析。主要终点为第12周NT-proBNP较基线的变化百分比，由中心实验室检测。主要分析采用ANCOVA比较组间第12周NT-proBNP较基线变化（对数转换），以基线值为协变量。安全性终点包括不良事件与严重不良事件发生率、生命体征与低血压事件、肝肾功能、血常规及心电图变化，安全性数据采用描述性统计。本研究内在目的为概念验证（PoC）与剂量探索，靶点作用机制为直接刺激sGC酶并稳定一氧化氮-sGC-cGMP通路、提高细胞内cGMP水平。","rationale":"本章正文依据当前项目已确认研究事实中的估计目标策略、主要终点、统计分析策略、安全性终点、内在研究目的及靶点/作用机制写入。医学经理需核实：（1）疗法策略与抢救治疗策略的适用理由及伴发事件的具体定义（如哪些事件视为伴发事件、抢救治疗的具体操作定义）；（2）NT-proBNP作为主要终点的方法学论证（为何选择NT-proBNP而非临床硬终点或复合终点）；（3）对数转换的合理性依据；（4）安全性终点中低血压事件的判定阈值与报告标准；（5）剂量探索目的下各剂量组间的比较策略（趋势检验或两两比较）。","review_advisories":["本节提及高影响设计信息（主要终点、估计目标、伴发事件）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bafca0395251_57dbfe4b2d7568b9","section_number":"4.2","source_ids":["protocol_full_draft_selection:f4f54adde92560e2bae9c5f4","current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:97a2bd7fcf7302"]},{"ai_run_id":"airun_20261009191638_b6c4ca4d","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取KZ-sGC1501非临床药效学、毒理学及PK/PD研究资料，以及既往人体研究（如有）的剂量-暴露-效应数据","category":"source_missing","gap_id":"gap_421_01","missing_source_classes":["非临床研究资料","既往人体研究数据","sGC刺激剂类药物文献"],"target":"4.2.1节剂量选择依据全文"},{"action":"补充各剂量水平对应的靶点占有率、cGMP升高幅度、安全窗及同类药物（如维利西呱）剂量参考","category":"source_missing","gap_id":"gap_421_02","missing_source_classes":["非临床药效学数据","同类药物临床资料"],"target":"4.2.1节剂量选择依据中2.5mg/5mg/10mg剂量水平的药理学依据"}],"heading":"剂量选择依据","missing_source_classes":["KZ-sGC1501非临床研究资料（药效学、毒理学、PK/PD）","KZ-sGC1501既往人体研究数据","sGC刺激剂类药物剂量-暴露-效应关系文献","研究者手册（IB）中剂量选择章节"],"proposal_text":"","rationale":"剂量选择依据章节需要KZ-sGC1501的非临床研究资料（药效学、毒理学、PK/PD）、既往人体研究数据（I期或早期II期）以及sGC刺激剂类药物的剂量-暴露-效应关系来源，方可形成有实质信息的剂量选择论证。当前允许来源仅给出剂量方案（2.5mg、5mg、10mg每日一次）和疗程（12周），未提供选择这些剂量水平的药理学依据、非临床安全窗、既往人体暴露数据或同类药物剂量参考。缺少上述核心来源时无法形成任何有实质信息的正文。","review_advisories":["本节复述高影响研究设计（剂量选择依据）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bafca0395251_f0b5f466caaecacb","section_number":"4.2.1","source_ids":["protocol_full_draft_selection:f4f54adde92560e2bae9c5f4","current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:97a2bd7fcf7302"]},{"ai_run_id":"airun_20261009191638_b6c4ca4d","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_bafca0395251_9fd3cd56f36cf28f:full-draft:f4f54adde92560e2bae9c5f4","quote":"采用随机化分配。","quote_sha256":"abb7a27e76e1676c12ab199e8d9abdac80371053749a69fb6f2ee1faa8f01db8","source_id":"protocol_full_draft_selection:f4f54adde92560e2bae9c5f4","span_id":"es_005"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"安慰剂对照（双模拟）：安慰剂薄膜衣片口服每日一次，与KZ-sGC1501同步使用12周；受试者按随机分配至安慰剂组或不同剂量试验组。","quote_sha256":"6b7d7fdec53fb4db92eb6539bb0b8e02055025f887cfebcc3c69155fae0ccfb9","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_006"}],"evidence_review_advisories":[],"evidence_span_ids":["es_005","es_006"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[{"action":"确认本项目随机化方法、分层因素、随机化比例、随机表生成工具及随机化实施系统","category":"source_missing","gap_id":"gap_43_01","missing_source_classes":["随机化实施方案"],"target":"4.3节随机化方法（区组/分层/比例/工具/系统）"},{"action":"确认紧急揭盲的触发条件、操作流程、权限人员及揭盲后处理","category":"source_missing","gap_id":"gap_43_02","missing_source_classes":["紧急揭盲程序"],"target":"4.3节紧急揭盲程序"},{"action":"明确双盲设计下哪些角色（受试者、研究者、评价者、数据分析人员等）处于盲态","category":"source_missing","gap_id":"gap_43_03","missing_source_classes":["盲态范围界定"],"target":"4.3节双盲覆盖范围"}],"heading":"随机化","missing_source_classes":["本项目随机化实施方案（随机化方法、分层因素、随机化比例、生成工具、实施系统、时机与流程）","紧急揭盲程序","双盲覆盖范围界定"],"proposal_text":"本研究采用随机化分配，受试者按随机分配至安慰剂组或不同剂量试验组。研究为双盲设计，采用安慰剂对照（双模拟），安慰剂薄膜衣片与KZ-sGC1501薄膜衣片在外观上保持一致，受试者按随机分配接受试验药或安慰剂。","rationale":"本章正文依据当前项目已确认研究事实中随机化分配、双盲设计、安慰剂对照（双模拟）及受试者按随机分配至安慰剂组或不同剂量试验组等要素写入。医学经理需核实：（1）随机化方法（区组随机、分层随机或其他）及分层因素；（2）随机化比例（如1:1:1:1或其他）；（3）随机化生成工具与实施系统；（4）随机化时机与操作流程；（5）紧急揭盲程序；（6）双盲的具体覆盖范围（哪些角色处于盲态）。","review_advisories":["本节复述高影响研究设计（随机化）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bafca0395251_3619fd45718f0b59","section_number":"4.3","source_ids":["protocol_full_draft_selection:f4f54adde92560e2bae9c5f4","current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:97a2bd7fcf7302"]}],"source_bindings":[{"content_sha256":"0b2754dc21c98d97225ca3c5a3970d857d444155317740e8cf30667c680158d5","locator":"document:mwdoc_greenfield_proj_user_bafca0395251_9fd3cd56f36cf28f:full-draft:f4f54adde92560e2bae9c5f4","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:f4f54adde92560e2bae9c5f4","source_type":"protocol_full_draft_selection","source_version":"full-draft:c8460866c5aa03eb30cb338b8abb43320cd4a47996b12e2d46cac9b1f65523d5:f4f54adde92560e2bae9c5f4","text_sha256":"0b2754dc21c98d97225ca3c5a3970d857d444155317740e8cf30667c680158d5"},{"content_sha256":"eb34fd213ecdb9215770125864b8749f288c1c1e5b244eb8b8de3bee283f4aab","locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","source_type":"current_project_study_definition","source_version":"mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","text_sha256":"eb34fd213ecdb9215770125864b8749f288c1c1e5b244eb8b8de3bee283f4aab"},{"content_sha256":"561c757e6967fae66f0f9d1043dba3e313bd0ee60a03f2c3c8da5efe892b0128","locator":"section:6.3.3 揭盲|block:490|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","source_type":"company_protocol_reference_corpus","source_version":"dbed66cc1d7b3a","text_sha256":"561c757e6967fae