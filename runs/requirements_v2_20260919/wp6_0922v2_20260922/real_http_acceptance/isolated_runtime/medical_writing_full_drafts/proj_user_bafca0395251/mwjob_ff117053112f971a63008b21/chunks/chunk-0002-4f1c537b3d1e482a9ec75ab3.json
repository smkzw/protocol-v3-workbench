sons":[],"section_id":"mwsec_greenfield_proj_user_bafca0395251_e1743d9c6cf2458e","section_number":"2.3.2","source_ids":["protocol_full_draft_selection:4f1c537b3d1e482a9ec75ab3","current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:5425c4f8e6c0a6"]},{"ai_run_id":"airun_20261009190836_6fd51bd6","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"靶点/作用机制：直接刺激sGC酶并稳定一氧化氮-sGC-cGMP通路，提高细胞内cGMP水平","quote_sha256":"a884dd972c849b4e696ca8d01923d01caf87ecc856153929b527966894291aa9","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_002"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"内在研究目的：概念验证（PoC）；剂量探索","quote_sha256":"2d096e242bbd65d0c9236718d79e77a388e84cb9640b99bd47662a6ce8faab31","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_003"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"总体研究设计：随机、双盲、安慰剂对照、平行组、多中心II期剂量探索研究","quote_sha256":"2f5022140d2275d33560ae4bdb963c9a887859c61977316b91cfd69524bb8143","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_004"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"主要终点：第12周NT-proBNP较基线的变化百分比（中心实验室检测）","quote_sha256":"9d5bacc777ee318a4c129cba33a5402c741235ab7876aa731edcc277c02f5520","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_007"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"试验干预：KZ-sGC1501为口服可溶性鸟苷酸环化酶（sGC）刺激剂，与标准心衰基础治疗联用；探索2-3个剂量水平的有效性与安全性，疗程12周。","quote_sha256":"0c8dd1e6ef0d5bfadebb992e6bd1e8b0a09e8c3fbeab851794d939dea803b2c6","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_008"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"研究人群概述：中国成年慢性心力衰竭（LVEF≤40%，NYHA II-III级）患者，标准治疗基础上症状仍持续","quote_sha256":"ed44c04b1f88a889bf8d7264714350d5b0fde3fb141cea19aec4bdbe3fbde3fe","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_009"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"剂量与给药方案：KZ-sGC1501薄膜衣片：2.5mg、5mg、10mg每日一次（口服）；第1天至第12周（每日一次，随餐）。依从：每日服药日记卡记录","quote_sha256":"f0249c88c0a073ef05ced49a07ae93d1ebbedcfb5c17ffd9e9b0edc741c6a5fc","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_010"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003","es_004","es_007","es_008","es_009","es_010"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":7},"gap_items":[{"action":"提供KZ-sGC1501非临床药理学与毒理学摘要，补充动物模型中sGC刺激对心功能、纤维化和血管张力的影响数据。","category":"source_missing","gap_id":"gap_24_01","missing_source_classes":["非临床药理学数据","非临床毒理学摘要"],"target":"2.4节非临床证据段落"},{"action":"确认是否需要引用sGC-cGMP通路在HFrEF中的转化医学证据或同类药物（如维利西呱VICTORIA研究）的机制验证数据。","category":"source_missing","gap_id":"gap_24_02","missing_source_classes":["转化医学文献","同类药物临床证据"],"target":"2.4节靶点验证文献"}],"heading":"本研究的理论基础","missing_source_classes":["KZ-sGC1501非临床药理学数据（动物模型疗效、sGC选择性、cGMP组织分布）","KZ-sGC1501非临床毒理学摘要","支持sGC-cGMP通路作为HFrEF治疗靶点的既往临床或转化医学文献"],"proposal_text":"慢性心力衰竭伴射血分数降低（HFrEF）的核心病理生理特征为心肌收缩力下降、心室重构及神经内分泌代偿性激活，导致心输出量不足和器官灌注减少。一氧化氮（NO）-可溶性鸟苷酸环化酶（sGC）-环磷酸鸟苷（cGMP）信号通路在维持血管张力、抑制心肌纤维化和改善心肌舒张功能中发挥关键调节作用。HFrEF状态下，内皮功能障碍和氧化应激导致NO生物利用度下降，sGC酶发生氧化或脱敏，cGMP生成减少，进而加重血管收缩、心肌重构和心室僵硬度增加。KZ-sGC1501为口服小分子sGC刺激剂，其作用机制为直接刺激sGC酶活性并稳定NO-sGC-cGMP通路，提高细胞内cGMP水平，从而在不依赖内源性NO的前提下恢复cGMP介导的血管舒张和抗纤维化效应。本研究为II期概念验证与剂量探索研究，旨在在标准心衰基础治疗之上，评估KZ-sGC1501在LVEF≤40%、NYHA II-III级、经标准治疗症状仍持续的中国成年HFrEF患者中的初步疗效信号和安全性特征，为后续确证性研究确定候选剂量。研究采用随机、双盲、安慰剂对照、平行组、多中心设计，探索2.5mg、5mg和10mg每日一次三个剂量水平，疗程12周，以第12周NT-proBNP较基线变化百分比为主要疗效终点。","rationale":"机制描述（直接刺激sGC酶、稳定NO-sGC-cGMP通路、提高cGMP）和PoC/剂量探索定位来自当前项目已确认研究事实。HFrEF病理生理中NO-sGC-cGMP通路失调的描述为基于已确认靶点机制的合理推论，需核实其准确性及是否需要引用具体文献。三个剂量水平、12周疗程、NT-proBNP主要终点、LVEF≤40%/NYHA II-III级人群均为已确认事实。本章节未包含非临床数据（如动物模型疗效、受体选择性、药代动力学参数），因允许来源中无此类信息。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bafca0395251_7a21a81fd60e79d5","section_number":"2.4","source_ids":["protocol_full_draft_selection:4f1c537b3d1e482a9ec75ab3","current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:5425c4f8e6c0a6"]},{"ai_run_id":"airun_20261009190836_6fd51bd6","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"目标研究人群：年龄段：成人；疾病状态：中重度；经治情况：经治疗效不佳","quote_sha256":"f69c8795de5b66ee328f0af0c3a353c5763d1e33e9f35141e09c4bab0146ff33","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_005"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"安全性终点：不良事件与严重不良事件发生率；生命体征与低血压事件；肝肾功能、血常规、心电图变化","quote_sha256":"722787d06ac5743572cd922187c49fbb8c5efe7d7e11e26f072c2d223c2e5271","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_006"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"研究人群概述：中国成年慢性心力衰竭（LVEF≤40%，NYHA II-III级）患者，标准治疗基础上症状仍持续","quote_sha256":"ed44c04b1f88a889bf8d7264714350d5b0fde3fb141cea19aec4bdbe3fbde3fe","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_009"}],"evidence_review_advisories":[],"evidence_span_ids":["es_005","es_006","es_009"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"提供IB或同类药物安全性数据，确认低血压、头痛、视觉障碍等风险信号的具体发生率、严重程度及监测要求。","category":"source_missing","gap_id":"gap_25_01","missing_source_classes":["研究者手册（IB）","同类药物安全性数据"],"target":"2.5节sGC刺激剂类已知风险信号描述"},{"action":"确认是否需要引用当前HFrEF治疗指南或流行病学数据以支撑未满足需求论述。","category":"source_missing","gap_id":"gap_25_02","missing_source_classes":["HFrEF治疗指南","流行病学数据"],"target":"2.5节HFrEF标准治疗现状与残余风险描述"}],"heading":"获益/风险评估","missing_source_classes":["KZ-sGC1501研究者手册（IB）中已知风险与安全性信号","同类sGC刺激剂在HFrEF中的安全性数据（如VICTORIA研究）","HFrEF标准治疗指南中关于残余风险和治疗现状的描述"],"proposal_text":"本研究的目标人群为中国成年慢性心力衰竭（LVEF≤40%，NYHA II-III级）患者，疾病状态为中重度，且经标准心衰治疗后症状仍持续，即经治疗效不佳。该人群在标准治疗基础上仍存在残余心衰恶化风险和心血管死亡风险，具有未满足的治疗需求。KZ-sGC1501作为口服sGC刺激剂，通过直接激活sGC酶、提高细胞内cGMP水平，理论上可改善血管舒张、减轻心肌纤维化和心室重构，从而在标准治疗之上提供额外的血流动力学和抗重构获益。安全性方面，本研究将系统监测不良事件与严重不良事件发生率、生命体征与低血压事件、肝肾功能、血常规及心电图变化。sGC刺激剂类药物的药理相关风险包括血管扩张引起的低血压、头痛及视觉障碍，在HFrEF合并低血压或肾功能不全（eGFR<30mL/min/1.73m²）的患者中风险可能增加，因此本研究将收缩压<90mmHg和eGFR<30mL/min/1.73m²列为排除标准。获益/风险评估将基于第12周NT-proBNP较基线变化百分比的组间差异及上述安全性指标的综合分析，具体风险信号描述和监测要求需结合研究者手册及同类药物安全性数据进一步核实。","rationale":"目标人群特征（成人、中重度、经治疗效不佳）、安全性监测维度（AE/SAE发生率、生命体征与低血压、肝肾功能、血常规、心电图）及排除标准（eGFR<30、收缩压<90）均来自当前项目已确认研究事实。sGC刺激剂类药物的已知风险信号（低血压、头痛、视觉障碍）为基于靶点机制的合理推论，需结合IB或同类药物安全性数据核实。标准心衰治疗药物类别的列举为HFrEF领域通用背景知识，需确认是否需在本章节具体列出。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bafca0395251_028b6bc5ad5b2855","section_number":"2.5","source_ids":["protocol_full_draft_selection:4f1c537b3d1e482a9ec75ab3","current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:5425c4f8e6c0a6"]},{"ai_run_id":"airun_20261009190836_6fd51bd6","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"内在研究目的：概念验证（PoC）；剂量探索","quote_sha256":"2d096e242bbd65d0c9236718d79e77a388e84cb9640b99bd47662a6ce8faab31","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_003"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"总体研究设计：随机、双盲、安慰剂对照、平行组、多中心II期剂量探索研究","quote_sha256":"2f5022140d2275d33560ae4bdb963c9a887859c61977316b91cfd69524bb8143","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_004"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"安全性终点：不良事件与严重不良事件发生率；生命体征与低血压事件；肝肾功能、血常规、心电图变化","quote_sha256":"722787d06ac5743572cd922187c49fbb8c5efe7d7e11e26f072c2d223c2e5271","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_006"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"主要终点：第12周NT-proBNP较基线的变化百分比（中心实验室检测）","quote_sha256":"9d5bacc777ee318a4c129cba33a5402c741235ab7876aa731edcc277c02f5520","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_007"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"试验干预：KZ-sGC1501为口服可溶性鸟苷酸环化酶（sGC）刺激剂，与标准心衰基础治疗联用；探索2-3个剂量水平的有效性与安全性，疗程12周。","quote_sha256":"0c8dd1e6ef0d5bfadebb992e6bd1e8b0a09e8c3fbeab851794d939dea803b2c6","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_008"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"研究人群概述：中国成年慢性心力衰竭（LVEF≤40%，NYHA II-III级）患者，标准治疗基础上症状仍持续","quote_sha256":"ed44c04b1f88a889bf8d7264714350d5b0fde3fb141cea19aec4bdbe3fbde3fe","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_009"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"剂量与给药方案：KZ-sGC1501薄膜衣片：2.5mg、5mg、10mg每日一次（口服）；第1天至第12周（每日一次，随餐）。依从：每日服药日记卡记录","quote_sha256":"f0249c88c0a073ef05ced49a07ae93d1ebbedcfb5c17ffd9e9b0edc741c6a5fc","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_010"}],"evidence_review_advisories":[],"evidence_span_ids":["es_003","es_004","es_006","es_007","es_008","es_009","es_010"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":7},"gap_items":[{"action":"确认是否设置次要疗效终点（如6分钟步行距离、NYHA分级变化、NT-proBNP绝对值变化、心衰住院率等），若设置则需明确定义、采集时点和统计方法。","category":"source_missing","gap_id":"gap_3_01","missing_source_classes":["次要终点定义","探索性终点定义"],"target":"第3章次要疗效终点"},{"action":"确认各访视（V1-V6及30天随访）的具体评估项目清单，包括实验室检查、生命体征、心电图、体格检查、依从性评价等是否在每个访视均实施。","category":"source_missing","gap_id":"gap_3_02","missing_source_classes":["访视评估项目清单"],"target":"第3章各访视评估项目"}],"heading":"研究目的和终点","missing_source_classes":["次要疗效终点定义（如6分钟步行距离、NYHA分级变化、心衰住院率等）","探索性终点定义","各访视具体评估项目清单"],"proposal_text":"本研究为II期概念验证与剂量探索研究，总体研究设计为随机、双盲、安慰剂对照、平行组、多中心设计。研究目的为在标准心衰基础治疗之上，评估口服sGC刺激剂KZ-sGC1501（2.5mg、5mg、10mg每日一次，疗程12周）在中国成年慢性心力衰竭（LVEF≤40%，NYHA II-III级）患者中的初步疗效信号和安全性特征，为后续确证性研究确定候选剂量。主要疗效终点为第12周NT-proBNP较基线的变化百分比（中心实验室检测）。安全性终点包括不良事件与严重不良事件发生率、生命体征与低血压事件、肝肾功能、血常规及心电图变化。研究时期包括筛选期（-28至-1天）、治疗期（第1天至第12周）和治疗结束后30天安全性随访。访视安排为筛选（V1）、基线（V2，第1天）、V3第2周、V4第4周、V5第8周、V6第12周（终点）与30天安全性随访。样本量按主要终点NT-proBNP组间差异估算，每组约100例，考虑脱落率15%，总样本量约240例。主要分析采用ANCOVA比较组间第12周NT-proBNP较基线变化（对数转换），基线值为协变量；安全性采用描述性统计。主要估计目标为第12周NT-proBNP较基线变化（疗法策略），伴发事件按抢救治疗策略处理。本研究不设置探索性目的或探索性终点。","rationale":"研究目的（PoC、剂量探索）、设计类型（随机、双盲、安慰剂对照、平行组、多中心II期）、主要终点（第12周NT-proBNP较基线变化百分比）、安全性终点、研究时期、访视安排、样本量（每组约100例、总计约240例）、统计分析策略（ANCOVA、对数转换）及估计目标策略均来自当前项目已确认研究事实。是否设置次要疗效终点（如6分钟步行距离、NYHA分级变化、心衰住院率等）及探索性终点，允许来源未提供，本章节暂按不设置处理，需确认。","review_advisories":["本节复述高影响研究设计（研究目的和终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、估计目标、伴发事件、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bafca0395251_2019e7beac39701c","section_number":"3","source_ids":["protocol_full_draft_selection:4f1c537b3d1e482a9ec75ab3","current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:5425c4f8e6c0a6"]}],"source_bindings":[{"content_sha256":"2d57a61111f794d65892befefa8758fd88bbb7922ac1ab22b94f0fc10a67b3e7","locator":"document:mwdoc_greenfield_proj_user_bafca0395251_9fd3cd56f36cf28f:full-draft:4f1c537b3d1e482a9ec75ab3","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:4f1c537b3d1e482a9ec75ab3","source_type":"protocol_full_draft_selection","source_version":"full-draft:c8460866c5aa03eb30cb338b8abb43320cd4a47996b12e2d46cac9b1f65523d5:4f1c537b3d1e482a9ec75ab3","text_sha256":"2d57a61111f794d65892befefa8758fd88bbb7922ac1ab22b94f0fc10a67b3e7"},{"content_sha256":"eb34fd213ecdb9215770125864b8749f288c1c1e5b244eb8b8de3bee283f4aab","locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","source_type":"current_project_study_definition","source_version":"mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","text_sha256":"eb34fd213ecdb9215770125864b8749f288c1c1e5b244eb8b8de3bee283f4aab"},{"content_sha256":"dfc9fceb41db9d941df0e3715483adaa069da4f1953600a6a37a56d7f81373dd","locator":"section:文档开头|block:4|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","source_type":"company_protocol_reference_corpus","source_version":"342cfc57d67b67","text_sha256":"dfc9fceb41db9d941df0e3715483adaa069da4f1953600a6a37a56d7f81373dd"},{"content_sha256":"68663fd612a1770f44cc3c20e025cf77d568a22b8c10c9a906d5ceb40702d87e","locator":"section:文档开头|block:25|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","source_type":"company_protocol_reference_corpus","source_version":"7252de902642cb","text_sha256":"68663fd612a1770f44cc3c20e025cf77d568a22b8c10c9a906d5ceb40702d87e"},{"content_sha256":"7a420e4850cce755cc434762b140d45b44b660dc6f7422f0a5336ae891763c04","locator":"section:方案摘要|block:78|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","source_type":"company_protocol_reference_corpus","source_version":"fb714bc3c01de1","text_sha256":"7a420e4850cce755cc434762b140d45b44b660dc6f7422f0a5336ae891763c04"},{"content_sha256":"fc70c6739c40d8cd0f5ace2c27bb8679f2ed3de81a272f72ab76aa30b8b65a75","locator":"section:11.2 知情同意|block:926|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","source_type":"company_protocol_reference_corpus","source_version":"a1616fe22868fa","text_sha256":"fc70c6739c40d8cd0f5ace2c27bb8679f2ed3de81a272f72ab76aa30b8b65a75"},{"content_sha256":"813b64b084d34