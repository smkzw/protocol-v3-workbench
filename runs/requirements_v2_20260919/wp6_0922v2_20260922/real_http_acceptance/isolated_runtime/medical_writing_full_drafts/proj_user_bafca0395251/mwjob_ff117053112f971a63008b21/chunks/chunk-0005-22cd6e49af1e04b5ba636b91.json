2"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"需项目方案或盲法管理计划明确哪些角色设盲及盲态维持方式","category":"source_missing","gap_id":"gap_blind_scope","missing_source_classes":["盲态范围定义"],"target":"盲态覆盖人员范围"},{"action":"需项目文件明确紧急揭盲触发条件、操作流程及揭盲后数据处理","category":"source_missing","gap_id":"gap_unblinding","missing_source_classes":["揭盲程序文件"],"target":"紧急揭盲程序"}],"heading":"盲法与揭盲","missing_source_classes":["盲态范围定义（受试者/研究者/评价者/数据监查委员会等）","紧急揭盲程序与条件","揭盲后数据处理规则"],"proposal_text":"本研究采用随机、双盲、安慰剂对照、平行组、多中心II期剂量探索设计。受试者按随机分配至安慰剂组或不同剂量试验组（KZ-sGC1501 2.5mg、5mg、10mg每日一次），安慰剂组接受与试验药外观一致的安慰剂薄膜衣片口服每日一次，与KZ-sGC1501同步使用12周，采用双模拟方式维持盲态。","rationale":"已确认事实支持双盲、安慰剂对照（双模拟）及随机分配至安慰剂组或不同剂量试验组。盲态覆盖范围（哪些人员设盲）及紧急揭盲程序无项目来源，需医学经理补充确认。","review_advisories":["本节复述高影响研究设计（盲法与揭盲）；请在合并设计摘要中统一核对。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bafca0395251_b16f8313f2027413","section_number":"4.4","source_ids":["protocol_full_draft_selection:22cd6e49af1e04b5ba636b91","current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc"]},{"ai_run_id":"airun_20261009192027_2aeeb56e","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"研究时期：筛选期：-28至-1天；治疗期：第1天至第12周；随访期：治疗结束后30天安全性随访","quote_sha256":"6d2ffc7852b9e349b8539673d0c52951b04fc124307d79f1a27bc778fac1d5cc","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_dur_01"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"访视策略：筛选（V1）、基线（V2，第1天）、V3第2周、V4第4周、V5第8周、V6第12周（终点）与30天安全性随访","quote_sha256":"8c1d7ca018b8e46d9855ddbef7bd76b1aaf361c4c16d87cdef4a5ba0fb2cc13e","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_dur_02"}],"evidence_review_advisories":[],"evidence_span_ids":["es_dur_01","es_dur_02"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[],"heading":"研究结束与研究持续时间","missing_source_classes":[],"proposal_text":"本研究总周期包括筛选期、治疗期和随访期三个阶段。筛选期为第-28天至第-1天，用于完成知情同意、入选与排除标准评估及基线检查。治疗期为第1天至第12周，受试者接受KZ-sGC1501或安慰剂每日一次口服给药。随访期为治疗结束后30天安全性随访。访视安排如下：筛选访视（V1）、基线访视（V2，第1天）、V3第2周、V4第4周、V5第8周、V6第12周（治疗终点）及治疗结束后30天安全性随访访视。","rationale":"研究时期与访视策略均由当前项目已确认研究事实直接给出，各阶段起止时间和访视编号、时间点一一对应，无需额外推断。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bafca0395251_8e86f150005f700c","section_number":"4.5","source_ids":["protocol_full_draft_selection:22cd6e49af1e04b5ba636b91","current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc"]},{"ai_run_id":"airun_20261009192027_2aeeb56e","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"需获取项目安全性监测计划、DSMB章程或同类sGC刺激剂既往安全性数据后方可撰写","category":"source_missing","gap_id":"gap_suspension_termination","missing_source_classes":["研究暂停与终止标准项目文件","既往同类药物安全性数据","安全性监测计划"],"target":"研究暂停和终止标准"}],"heading":"研究暂停和终止标准","missing_source_classes":["研究暂停与终止标准项目文件","既往同类药物安全性数据","独立数据监查委员会章程或安全性监测计划"],"proposal_text":"","rationale":"当前允许来源中无任何关于研究暂停或终止标准的项目文件、既往研究数据或安全性信号信息，无法形成有实质内容的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bafca0395251_7e69ff923ee405b8","section_number":"4.6","source_ids":["protocol_full_draft_selection:22cd6e49af1e04b5ba636b91","current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc"]},{"ai_run_id":"airun_20261009192027_2aeeb56e","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"研究人群概述：中国成年慢性心力衰竭（LVEF≤40%，NYHA II-III级）患者，标准治疗基础上症状仍持续","quote_sha256":"ed44c04b1f88a889bf8d7264714350d5b0fde3fb141cea19aec4bdbe3fbde3fe","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_pop_01"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"入选标准模块：年龄18-75岁；筛选期LVEF≤40%；NYHA II-III级；稳定标准心衰治疗≥4周；签署知情同意","quote_sha256":"9b5c11f1282564f053da70bcc4d8992c056a043cc57f937c542daba8c6d3b5d7","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_pop_02"},{"locator":"study_definition:mwdefinition_e97013fe074855a4e4ff:revision:10","quote":"排除标准模块：eGFR<30mL/min/1.73m2；收缩压<90mmHg；近6个月内心肌梗死或卒中；妊娠或哺乳期；对sGC类药物过敏","quote_sha256":"87570baae0ec9acd27353807c7203c8af459cedec3c6c31f5d4e2cf0505f9ae5","source_id":"current_project_study_definition:mwdefinition_e97013fe074855a4e4ff:r10:7ac5d92b5b3b1ddc","span_id":"es_pop_03"}],"evidence_review_advisories":[],"evidence_span_ids":["es_pop_01","es_pop_02","es_pop_03"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"需项目方案或安全性管理文件明确避孕方法、妊娠检查时点及意外妊娠处理流程","category":"source_missing","gap_id":"gap_contraception","missing_source_classes":["避孕方法要求","妊娠检查日程"],"target":"避孕方法要求与妊娠检查日程"},{"action":"需项目方案或药物相互作用研究资料明确允许合并用药及禁止合并用药","category":"source_missing","gap_id":"gap_concomitant_meds","missing_source_classes":["合并用药限制清单"],"target":"合并用药与禁限用药清单"}],"heading":"研究人群","missing_source_classes":["避孕方法要求","妊娠检查日程","哺乳期处理规则","合并用药限制清单"],"proposal_text":"本研究拟纳入中国成年慢性心力衰竭（射血分数降低，HFrEF）患者，即左室射血分数≤40%、纽约心功能分级II至III级、在标准心衰治疗基础上症状仍持续的患者。入选标准包括：年龄18至75岁；筛选期左室射血分数≤40%；纽约心功能分级II至III级；已接受稳定标准心衰治疗≥4周；签署知情同意书。排除标准包括：估算肾小球滤过率<30mL/min/1.73m²；收缩压<90mmHg；近6个月内心肌梗死或卒中；妊娠或哺乳期；对sGC类药物过敏。","rationale":"研究人群概述、入选标准模块和排除标准模块均由当前项目已确认研究事实直接提供，各数值和条件为原值写入。排除标准中'妊娠或哺乳期'仅描述排除条件，未涉及避孕方法、妊娠检查日程或哺乳期处理规则，需医学经理确认是否需补充相关实施条款。","review_advisories":["本节复述高影响研究设计（研究人群）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenf