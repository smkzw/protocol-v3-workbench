整；出现特定不良反应时按方案规定暂停用药或永久停药。","quote_sha256":"4ef95c72280de597c8555b7c85bdbb6b65b08647363fd4dacf2b1da4e0b8cafa","source_id":"current_project_study_definition:mwdefinition_9c9a9705ef196a2fb834:r6:e13f4bd8c4a41e4e","span_id":"es_dose_adj"}],"evidence_review_advisories":[],"evidence_span_ids":["es_drug_identity","es_first_dose","es_dose_adj"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"获取合成药M8研究者手册或项目安全性管理文件后补充","category":"source_missing","gap_id":"gap_61_ib","missing_source_classes":["研究者手册（IB）"],"target":"6.1节中合成药M8药理分类、已知风险信号及AESI完整定义"},{"action":"由医学负责人结合IB确定暂停/停药触发标准","category":"decision_pending","gap_id":"gap_61_dose_threshold","missing_source_classes":[],"target":"6.1节中'特定不良反应'触发暂停或永久停药的具体阈值"}],"heading":"试验用药品","missing_source_classes":["研究者手册（IB）","项目药物管理SOP","首次给药监测操作细则"],"proposal_text":"本研究的试验用药品包括活性药物合成药M8及其匹配安慰剂。合成药M8为小分子口服固体制剂（胶囊或片剂），规格为0.5mg，每日一次口服给药，治疗期24周。匹配安慰剂为胶囊或片剂，其外观、规格、气味及包装与合成药M8完全一致，每日一次口服给药，治疗期24周。受试者按1:1比例随机分配至合成药M8 0.5mg每日一次组或匹配安慰剂每日一次组。本研究为固定剂量设计，不设计划性剂量调整；出现特定不良反应时按方案规定暂停用药或永久停药。首次给药需在研究中心进行至少6小时心电图及生命体征监测，观察一过性心率减慢并防范房室传导阻滞。","rationale":"试验用药品名称、技术类型、剂型、给药途径、剂量、治疗周期、安慰剂匹配描述及首次给药监测要求均来源于当前项目已确认研究事实（MW-II-ACB50FEC-DRAFT修订6）。固定剂量设计与暂停/停药原则亦来源于同一来源。需医学负责人确认：（1）胶囊与片剂是否同时存在或仅保留一种剂型；（2）首次给药6小时监测的具体操作细则与终止标准；（3）触发暂停或永久停药的具体不良反应阈值。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5354f3dc97d7_bc97daae6ad96252","section_number":"6.1","source_ids":["protocol_full_draft_selection:e64b0268ef287f065a6d7f7f","current_project_study_definition:mwdefinition_9c9a9705ef196a2fb834:r6:e13f4bd8c4a41e4e","company_corpus:cms_cn_protocol_corpus_20260715_v1:6eab08a4bddb3d","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","company_corpus:cms_cn_protocol_corpus_20260715_v1:f24b1a78f9c3f8","company_corpus:cms_cn_protocol_corpus_20260715_v1:6b24da94f33534","company_corpus:cms_cn_protocol_corpus_20260715_v1:36c8fd703b73e4"]},{"ai_run_id":"airun_20260923135835_2c2af98e","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_9c9a9705ef196a2fb834:revision:6","quote":"合成药M8口服胶囊/片剂，受试者每日一次口服给药，连续治疗24周。","quote_sha256":"2776bb5afacba8e176ddd2ee20b6550f0531e6d916928011b61463b26adde0ea","source_id":"current_project_study_definition:mwdefinition_9c9a9705ef196a2fb834:r6:e13f4bd8c4a41e4e","span_id":"es_drug_identity"},{"locator":"study_definition:mwdefinition_9c9a9705ef196a2fb834:revision:6","quote":"首次给药需在研究中心进行至少6小时心电图及生命体征监测，观察一过性心率减慢并防范房室传导阻滞。","quote_sha256":"f318f5dc16375628e6af597b146fe039311a241eb0d62a75a7bda8b5b5808e45","source_id":"current_project_study_definition:mwdefinition_9c9a9705ef196a2fb834:r6:e13f4bd8c4a41e4e","span_id":"es_first_dose"},{"locator":"study_definition:mwdefinition_9c9a9705ef196a2fb834:revision:6","quote":"本研究为固定剂量设计，不设计划性剂量调整；出现特定不良反应时按方案规定暂停用药或永久停药。","quote_sha256":"4ef95c72280de597c8555b7c85bdbb6b65b08647363fd4dacf2b1da4e0b8cafa","source_id":"current_project_study_definition:mwdefinition_9c9a9705ef196a2fb834:r6:e13f4bd8c4a41e4e","span_id":"es_dose_adj"}],"evidence_review_advisories":[],"evidence_span_ids":["es_drug_identity","es_first_dose","es_dose_adj"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"获取IB后补充药物基本信息段落","category":"source_missing","gap_id":"gap_611_mechanism","missing_source_classes":["研究者手册（IB）","非临床研究报告"],"target":"6.1.1节中合成药M8作用机制、非临床安全性及既往临床数据"},{"action":"由药学与医学负责人确认最终剂型","category":"decision_pending","gap_id":"gap_611_formulation","missing_source_classes":[],"target":"6.1.1节中胶囊与片剂是否同时存在"}],"heading":"研究药物信息","missing_source_classes":["研究者手册（IB）","合成药M8非临床研究报告","项目药物管理SOP"],"proposal_text":"合成药M8为小分子化合物，给药途径为口服，剂型为口服固体制剂（胶囊或片剂），系统暴露。活性药物规格为0.5mg，每日一次口服给药，餐前或餐后服用均可，连续治疗24周。匹配安慰剂为胶囊或片剂，外观、规格、气味及包装与合成药M8完全一致，每日一次口服给药，治疗期24周。本研究为固定剂量设计，不设计划性剂量调整；出现特定不良反应时按方案规定暂停用药或永久停药。首次给药需在研究中心进行至少6小时心电图及生命体征监测，观察一过性心率减慢并防范房室传导阻滞。","rationale":"药物技术类型（small_molecule）、给药途径（口服）、剂型（口服固体制剂）、暴露范围（systemic）、剂量（0.5mg QD）、治疗周期（24周）、依从性说明（餐前或餐后）、安慰剂匹配描述、固定剂量设计原则及首次给药监测要求均来源于当前项目已确认研究事实（MW-II-ACB50FEC-DRAFT修订6）。需医学负责人确认：（1）胶囊与片剂是否同时存在或仅保留一种；（2）合成药M8的作用机制、非临床安全性数据及已知风险信号（需IB）；（3）首次给药6小时监测的具体操作细则。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5354f3dc97d7_219254a66619d116","section_number":"6.1.1","source_ids":["protocol_full_draft_selection:e64b0268ef287f065a6d7f7f","current_project_study_definition:mwdefinition_9c9a9705ef196a2fb834:r6:e13f4bd8c4a41e4e","company_corpus:cms_cn_protocol_corpus_20260715_v1:6eab08a4bddb3d","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","company_corpus:cms_cn_protocol_corpus_20260715_v1:f24b1a78f9c3f8","company_corpus:cms_cn_protocol_corpus_20260715_v1:6b24da94f33534","company_corpus:cms_cn_protocol_corpus_20260715_v1:36c8fd703b73e4"]},{"ai_run_id":"airun_20260923135835_2c2af98e","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取本项目药物制备与包装规范及研究中心药物管理SOP后撰写","category":"source_missing","gap_id":"gap_612_prep","missing_source_classes":["项目药物制备与包装规范","项目药物储存与运输SOP"],"target":"6.1.2节中制备工艺、包装规格、标签要素、储存条件、运输及验收流程"}],"heading":"制备、包装、标签、储存与管理","missing_source_classes":["项目药物制备与包装规范","项目药物标签模板","项目药物储存与运输SOP","研究中心药物接收验收流程文件"],"proposal_text":"","rationale":"本章节需要描述试验用药品的制备工艺、包装规格、标签内容要素、储存条件（温度、湿度）、有效期管理、运输条件及研究中心接收验收流程。当前允许来源中无本项目专属的药物制备与包装文件。公司语料中CMS-D017（I期、不同药物）和CMD-D001-AD（特应性皮炎、不同适应症）的IMP储存管理条款仅可作为监管共性结构参照，不可迁移为本项目已确认实施规则。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5354f3dc97d7_14ca1260ecfe402a","section_number":"6.1.2","source_ids":["protocol_full_draft_selection:e64b0268ef287f065a6d7f7f","current_project_study_definition:mwdefinition_9c9a9705ef196a2fb834:r6:e13f4bd8c4a41e4e","company_corpus:cms_cn_protocol_corpus_20260715_v1:6eab08a4bddb3d","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","company_corpus:cms_cn_protocol_corpus_20260715_v1:f24b1a78f9c3f8","company_corpus:cms_cn_protocol_corpus_20260715_v1:6b24da94f33534","company_corpus:cms_cn_protocol_corpus_20260715_v1:36c8fd703b73e4"]},{"ai_run_id":"airun_20260923135835_2c2af98e","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取本项目药物发放与回收SOP及药物管理系统操作规范后撰写","category":"source_missing","gap_id":"gap_613_dist","missing_source_classes":["项目药物发放与回收SOP","IWRS或药物管理系统操作规范"],"target":"6.1.3节中发放触发条件、回收时限、清点频率、丢失处理及销毁程序"}],"heading":"发放、回收与清点","missing_source_classes":["项目药物发放与回收SOP","IWRS或药物管理系统操作规范","研究中心药物清点与销毁流程"],"proposal_text":"","rationale":"本章节需要描述试验用药品从研究中心接收、储存、发放至受试者、回收、清点直至最终返还或销毁的全流程管理规则，包括发放触发条件、回收时限、清点频率、丢失或误用处理及销毁程序。当前允许来源中无本项目专属的药物发放与回收管理文件。公司语料中CMD-D001-AD（特应性皮炎）和CMS-D017（I期）的发放回收条款来自不同适应症和不同分期，仅可作为监管共性结构参照，不可迁移为本项目已确认实施规则。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5354f3dc97d7_d2965900455d8a79","section_number":"6.1.3","source_ids":["protocol_full_draft_selection:e64b0268ef287f065a6d7f7f","current_project_study_definition:mwdefinition_9c9a9705ef196a2fb834:r6:e13f4bd8c4a41e4e","company_corpus:cms_cn_protocol_corpus_20260715_v1:6eab08a4bddb3d","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","company_corpus:cms_cn_protocol_corpus_20260715_v1:f24b1a78f9c3f8","company_corpus:cms_cn_protocol_corpus_20260715_v1:6b24da94f33534","company_corpus:cms_cn_protocol_corpus_20260715_v1:36c8fd703b73e4"]}],"source_bindings":[{"content_sha256":"5d1907d1ebcabc3aa7c56873476de37afd83c623259d8b38e040128387ab413e","locator":"document:mwdoc_greenfield_proj_user_5354f3dc97d7_79f9edba6dfe591d:full-draft:e64b0268ef287f065a6d7f7f","role":"current_working_draft_packet","source_id":"protoco