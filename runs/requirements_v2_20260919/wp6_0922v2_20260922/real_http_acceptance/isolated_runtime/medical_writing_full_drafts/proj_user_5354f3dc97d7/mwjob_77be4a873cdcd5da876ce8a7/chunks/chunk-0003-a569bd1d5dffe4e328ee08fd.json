6:e13f4bd8c4a41e4e","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0"]},{"ai_run_id":"airun_20260923134538_954e1989","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_9c9a9705ef196a2fb834:revision:6","quote":"总体研究设计：随机、双盲、安慰剂对照、平行组、多中心","quote_sha256":"d7a6ba716caf7614dad4867561836fa06b23a4cdb81bf26c79300f5b86032526","source_id":"current_project_study_definition:mwdefinition_9c9a9705ef196a2fb834:r6:e13f4bd8c4a41e4e","span_id":"es1"},{"locator":"study_definition:mwdefinition_9c9a9705ef196a2fb834:revision:6","quote":"合成药M8：0.5mg QD（口服）；24周。依从：每日一次口服，餐前或餐后服用","quote_sha256":"3827b9497e44db6c5b263f5a5fdfc99e90b70921041b3e6936f9193ec8fddf23","source_id":"current_project_study_definition:mwdefinition_9c9a9705ef196a2fb834:r6:e13f4bd8c4a41e4e","span_id":"es2"},{"locator":"study_definition:mwdefinition_9c9a9705ef196a2fb834:revision:6","quote":"主要终点包括两个共同主要终点：1. 治疗第24周时的年化复发率（Annualized Relapse Rate, ARR）；2. 治疗第24周脑部MRI扫描显示的钆增强（Gd-enhancing）T1加权病灶累计数量。","quote_sha256":"48e1259a258f58a40ada23a2a3dcb56155e3bc492a004df8310c4293b7e9673c","source_id":"current_project_study_definition:mwdefinition_9c9a9705ef196a2fb834:r6:e13f4bd8c4a41e4e","span_id":"es3"},{"locator":"study_definition:mwdefinition_9c9a9705ef196a2fb834:revision:6","quote":"计划总样本量约200例，按1:1随机分配至合成药M8组（约100例）与安慰剂组（约100例）。","quote_sha256":"7b0367d8af9172d051acad97da990972a732889f926290b760e10a52700d32b2","source_id":"current_project_study_definition:mwdefinition_9c9a9705ef196a2fb834:r6:e13f4bd8c4a41e4e","span_id":"es4"},{"locator":"study_definition:mwdefinition_9c9a9705ef196a2fb834:revision:6","quote":"研究时期：筛选期（Day -28 ~ Day -1）；双盲治疗期（Day 1 ~ Week 24）；安全随访期（Week 28，停药后4周）","quote_sha256":"8878f1877ff9eefa735d3d2c1e9118ce1f5da79bd926299918d382d8bfc8fafc","source_id":"current_project_study_definition:mwdefinition_9c9a9705ef196a2fb834:r6:e13f4bd8c4a41e4e","span_id":"es5"},{"locator":"study_definition:mwdefinition_9c9a9705ef196a2fb834:revision:6","quote":"首次给药需在研究中心进行至少6小时心电图及生命体征监测，观察一过性心率减慢并防范房室传导阻滞。","quote_sha256":"f318f5dc16375628e6af597b146fe039311a241eb0d62a75a7bda8b5b5808e45","source_id":"current_project_study_definition:mwdefinition_9c9a9705ef196a2fb834:r6:e13f4bd8c4a41e4e","span_id":"es7"},{"locator":"study_definition:mwdefinition_9c9a9705ef196a2fb834:revision:6","quote":"全分析集（FAS）为主要疗效人群（ITT原则）；安全分析集（SS）包含所有用药受试者。主要终点ARR采用负二项回归模型分析，以对数暴露时间为offset，纳入治疗组、基线EDSS、过去1年复发数及干扰素β背景治疗为协变量；Gd病灶数采用负二项模型；安全性采用描述性统计。","quote_sha256":"03926417798a2a440b8f5e76f98456c42c7044bdd39b17dcad3f91232939a417","source_id":"current_project_study_definition:mwdefinition_9c9a9705ef196a2fb834:r6:e13f4bd8c4a41e4e","span_id":"es10"}],"evidence_review_advisories":[],"evidence_span_ids":["es1","es2","es3","es4","es5","es7","es10"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":7},"gap_items":[{"action":"确认设盲人员范围（受试者、研究者、评价者、数据监查人员等）及紧急揭盲条件和程序","category":"source_missing","gap_id":"gap_4_01","missing_source_classes":["项目研究设计决策记录","随机化与揭盲操作规范"],"target":"4 研究设计 - 盲法实施细节"},{"action":"确认随机化方法（如中央随机、区组随机）、区组大小及分层因素（如是否按干扰素β背景治疗分层）","category":"source_missing","gap_id":"gap_4_02","missing_source_classes":["项目研究设计决策记录","随机化与揭盲操作规范"],"target":"4 研究设计 - 随机化方法"}],"heading":"研究设计","missing_source_classes":["项目研究设计决策记录","随机化与揭盲操作规范"],"proposal_text":"本研究为随机、双盲、安慰剂对照、平行组、多中心II期临床研究，旨在评估合成药M8 0.5mg每日一次口服给药治疗复发缓解型多发性硬化受试者24周的疗效和安全性。研究采用1:1随机分配，受试者被随机分配至合成药M8 0.5mg每日一次组或匹配安慰剂每日一次组，两组均允许维持原有稳定剂量的干扰素β背景治疗。研究时期包括筛选期（第-28天至第-1天）、双盲治疗期（第1天至第24周）和安全随访期（第28周，即停药后4周）。计划总样本量约200例，按1:1比例随机分配至合成药M8组（约100例）与安慰剂组（约100例）。主要疗效终点为治疗第24周时的年化复发率和第24周脑部MRI扫描显示的钆增强T1加权病灶累计数量。关键次要终点包括第24周时新发或新扩大的T2高信号脑部病灶累计数量、至第24周首次经确诊的临床复发时间以及第24周时经确认的3个月残疾进展受试者比例。安全性评估涵盖首次给药后6小时内心率监测、治疗期不良事件及特别关注不良事件的发生率、生命体征、心电图、实验室安全指标及眼科OCT检查。本研究不计划自适应设计、样本量再估计、期中分析、SRC或DMC。统计分析以全分析集为主要疗效分析人群，主要终点采用负二项回归模型分析。","rationale":"本章节正文依据项目已确认的研究设计事实（随机、双盲、安慰剂对照、平行组、多中心）、干预方案（合成药M8 0.5mg QD与匹配安慰剂1:1）、研究时期划分、样本量、主要和次要终点、安全性评估内容及统计分析策略撰写。盲法的具体实施范围（设盲人员类别、紧急揭盲程序）及随机化方法（区组大小、分层因素）在项目事实中未明确，需医学经理补充确认。","review_advisories":["本节复述高影响研究设计（研究设计）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、期中分析、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5354f3dc97d7_df2b9979df9e55bd","section_number":"4","source_ids":["protocol_full_draft_selection:a569bd1d5dffe4e328ee08fd","current_project_study_definition:mwdefinition_9c9a9705ef196a2fb834:r6:e13f4bd8c4a41e4e","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0"]},{"ai_run_id":"airun_20260923134538_954e1989","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_9c9a9705ef196a2fb834:revision:6","quote":"总体研究设计：随机、双盲、安慰剂对照、平行组、多中心","quote_sha256":"d7a6ba716caf7614dad4867561836fa06b23a4cdb81bf26c79300f5b86032526","source_id":"current_project_study_definition:mwdefinition_9c9a9705ef196a2fb834:r6:e13f4bd8c4a41e4e","span_id":"es1"},{"locator":"study_definition:mwdefinition_9c9a9705ef196a2fb834:revision:6","quote":"合成药M8：0.5mg QD（口服）；24周。依从：每日一次口服，餐前或餐后服用","quote_sha256":"3827b9497e44db6c5b263f5a5fdfc99e90b70921041b3e6936f9193ec8fddf23","source_id":"current_project_study_definition:mwdefinition_9c9a9705ef196a2fb834:r6:e13f4bd8c4a41e4e","span_id":"es2"},{"locator":"study_definition:mwdefinition_9c9a9705ef196a2fb834:revision:6","quote":"研究时期：筛选期（Day -28 ~ Day -1）；双盲治疗期（Day 1 ~ Week 24）；安全随访期（Week 28，停药后4周）","quote_sha256":"8878f1877ff9eefa735d3d2c1e9118ce1f5da79bd926299918d382d8bfc8fafc","source_id":"current_project_study_definition:mwdefinition_9c9a9705ef196a2fb834:r6:e13f4bd8c4a41e4e","span_id":"es5"},{"locator":"study_definition:mwdefinition_9c9a9705ef196a2fb834:revision:6","quote":"首次给药需在研究中心进行至少6小时心电图及生命体征监测，观察一过性心率减慢并防范房室传导阻滞。","quote_sha256":"f318f5dc16375628e6af597b146fe039311a241eb0d62a75a7bda8b5b5808e45","source_id":"current_project_study_definition:mwdefinition_9c9a9705ef196a2fb834:r6:e13f4bd8c4a41e4e","span_id":"es7"}],"evidence_review_advisories":[],"evidence_span_ids":["es1","es2","es5","es7"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"与方案流程图核对各访视具体评估项目，确认是否每次访视均包含实验室检查、心电图、OCT等","category":"source_missing","gap_id":"gap_4_1_01","missing_source_classes":["方案流程图","访视操作手册"],"target":"4.1 总体设计 - 各访视检查项目清单"},{"action":"确认参与研究中心数量、地域分布及中心筛选标准","category":"source_missing","gap_id":"gap_4_1_02","missing_source_classes":["项目研究设计决策记录"],"target":"4.1 总体设计 - 多中心数量与分布"}],"heading":"总体设计","missing_source_classes":["方案流程图","访视操作手册","项目研究设计决策记录"],"proposal_text":"本研究采用随机、双盲、安慰剂对照、平行组、多中心设计。受试者按1:1比例随机分配至合成药M8 0.5mg每日一次口服组或匹配安慰剂每日一次口服组，治疗期共24周。合成药M8为口服固体制剂（胶囊或片剂），匹配安慰剂在外观、规格、气味及包装上与合成药M8完全一致。两组均允许维持筛选期已稳定使用至少1个月的干扰素β背景治疗。研究在多个研究中心开展。筛选期为第-28天至第-1天，双盲治疗期为第1天至第24周，安全随访期为第28周（停药后4周）。首次给药须在研究中心进行至少6小时心电图及生命体征监测，以观察一过性心率减慢并防范房室传导阻滞。治疗期访视安排在第2、4、8、12、16、20、24周，第12周和第24周复查脑部增强MRI，第28周进行停药后安全随访。","rationale":"本章节依据项目已确认的总体设计类型、干预与对照方案、1:1分配比例、治疗周期、研究时期划分、首剂监测要求及访视策略撰写。各访视具体检查项目清单（如每次访视是否均含完整实验室检查、心电图、OCT等）需与方案流程图核对确认；多中心具体中心数量及分布未在项目事实中给出。","review_advisories":["本节复述高影响研究设计（总体设计）；请在合并设计摘要中统一核对。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5354f3dc97d7_2c03fdd6d1cfbf3e","section_number":"4.1","source_ids":["protocol_full_draft_selection:a569bd1d5dffe4e328ee08fd","current_project_study_definition:mwdefinition_9c9a9705ef196a2fb834:r6:e13f4bd8c4a41e4e","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0"]},{"ai_run_id":"airun_20260923134538_954e1989","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取合成药M8的IB及非临床研究摘要（动物毒理、PK/PD、心脏安全性、S1P亚型选择性）","category":"source_missing","gap_id":"gap_4_2_1_01","missing_source_classes":["研究者手册","非临床研究报告"],"target":"4.2.1 剂量选择依据 - 非临床数据"},{"action":"获取合成药M8既往I期或早期II期人体研究数据（剂量-暴露-效应关系、安全性特征）","category":"source_missing","gap_id":"gap_4_2_1_02","missing_source_classes":["既往临床研究报告","文献检索报告"],"target":"4.2.1 剂量选择依据 - 既往人体研究"},{"action":"获取S1P受体调节剂同类药物的剂量选择文献或参考方案（仅限结构参照，不得迁移其项目事实）","category":"source_missing","gap_id":"gap_4_2_1_03","missing_source_classes":["同类药物文献","参考方案"],"target":"4.2.1 剂量选择依据 - 同类药物参考"}],"heading":"剂量选择依据","missing_source_classes":["研究者手册","非临床研究报告","既往临床研究报告","文献检索报告"],"proposal_text":"","rationale":"本章节需要合成药M8的IB（研究者手册）、非临床研究数据（包括动物毒理学、药代动力学/药效学、S1P受体亚型选择性及心脏安全性数据）以及既往人体研究资料（如I期或早期II期剂量探索数据）来论证0.5mg QD剂量的选择依据。当前允许来源中未包含上述任何核心资料，无法撰写有实质内容的剂量选择论证。项目事实仅确认了最终剂量方案（0.5mg QD、24周、固定剂量设计），但未提供剂量选择的科学依据链条。","review_advisories":["本节复述高影响研究设计（剂量选择依据）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5354f3dc97d7_65035bdc4dce924d","section_number":"4.2.1","source_ids":["protocol_full_draft_selection:a569bd1d5dffe4e328ee08fd","current_project_study_definition:mwdefinition_9c9a9705ef196a2fb834:r6:e13f4bd8c4a41e4e","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a