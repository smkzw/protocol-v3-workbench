15_v1:46d82ed9e2e3ef","source_type":"company_protocol_reference_corpus","source_version":"46d82ed9e2e3ef","text_sha256":"d201ce569054cbbf7236ebc38a81549ab6777a6cd5f2fedc31a501f7bd4655a7"},{"content_sha256":"11c21094429a4d9b6fd36d28e6d6b787c134a8c7397ecc704a35c832857515fe","locator":"section:文档开头|block:29|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","source_type":"company_protocol_reference_corpus","source_version":"04ac0381ef4b49","text_sha256":"11c21094429a4d9b6fd36d28e6d6b787c134a8c7397ecc704a35c832857515fe"}]}