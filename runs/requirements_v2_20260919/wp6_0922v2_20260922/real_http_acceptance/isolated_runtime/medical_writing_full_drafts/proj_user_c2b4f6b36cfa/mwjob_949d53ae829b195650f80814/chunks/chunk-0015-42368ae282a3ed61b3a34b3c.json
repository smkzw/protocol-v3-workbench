n:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","span_id":"es_010"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003","es_004","es_005","es_006","es_010"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"需项目统计分析计划明确分层因素、亚组分析变量、敏感性分析具体方法及次要终点层次检验顺序","category":"source_missing","gap_id":"gap_9_sap_detail","missing_source_classes":["项目统计分析计划"],"target":"9 统计分析"},{"action":"需项目确认重大方案偏离的完整清单及PP/PPS排除的具体判定标准","category":"source_missing","gap_id":"gap_9_pp_deviation","missing_source_classes":["方案偏离分级标准"],"target":"9 统计分析"}],"heading":"统计分析","missing_source_classes":["项目统计分析计划（SAP）","方案偏离分级标准","分层因素具体定义"],"proposal_text":"本研究为随机、双盲、安慰剂对照、平行组、多中心II期概念验证与剂量探索研究，采用2:1:1随机化比例（KZ-sGC2301 50mg组、KZ-sGC2301 25mg组、安慰剂组），以安慰剂匹配双模拟对照实现双盲。主要终点为第12周NT-proBNP较基线变化百分比（中心实验室检测），采用ANCOVA模型进行基线校正分析，并纳入分层校正。次要终点按预定义的层次检验顺序进行校正。敏感性分析与亚组分析在方案中预定义。主要估计目标采用治疗政策策略，伴发事件的处置在方案中预定义。安全性分析涵盖治疗期TEAE发生率与严重程度、生命体征/ECG/实验室异常及症状性低血压。分析集包括全分析集（FAS）、安全性分析集（SS）和符合方案集（PP/PPS）。FAS包含所有随机化受试者，按随机化分组进行分析，用于主要疗效终点和次要疗效终点的分析。SS包含至少接受一次研究药物或安慰剂给药的受试者，按实际接受的治疗分组进行分析，用于安全性终点分析。PP/PPS包含完成关键评估且无重大方案偏离的受试者；存在重大方案偏离的受试者不纳入PP/PPS，重大方案偏离包括但不限于未按方案给药、违反主要入选或排除标准、未完成主要终点评估等情形。","rationale":"随机化比例2:1:1、双盲、安慰剂匹配双模拟对照、主要终点ANCOVA基线校正、分层校正、敏感性分析与亚组分析预定义、次要终点层次检验、治疗政策策略估计目标、安全性终点类别及分析集名称均来自项目已确认研究事实。FAS/SS/PP/PPS的成员判定规则为基于研究设计结构的合理推导，但具体方案偏离排除条款的完整清单需项目统计分析计划确认。","review_advisories":["本节复述高影响研究设计（统计分析）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、估计目标、伴发事件）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_c2b4f6b36cfa_a88e4cb33e091de9","section_number":"9","source_ids":["protocol_full_draft_selection:42368ae282a3ed61b3a34b3c","current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:9691f7c94f6c58","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976","company_corpus:cms_cn_protocol_corpus_20260715_v1:9895ed0bd2ffd4","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83"]},{"ai_run_id":"airun_20261015080431_9e93a41a","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_56b96348f0f97cd896c4:revision:5","quote":"双侧α=0.10、效能85%，每组85例总计255例（含脱落补偿）","quote_sha256":"c01b830c42bf6a7ed1dc31d8d39332caf74ecca6643431e33eea621343f01d30","source_id":"current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","span_id":"es_001"},{"locator":"study_definition:mwdefinition_56b96348f0f97cd896c4:revision:5","quote":"安慰剂匹配双模拟对照，随机2:1:1（高剂量/低剂量/安慰剂），双盲","quote_sha256":"85987a4a57e6d50e7ee5d4148e4576b6850146838b44368fa4c5292250dd1e8e","source_id":"current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","span_id":"es_002"},{"locator":"study_definition:mwdefinition_56b96348f0f97cd896c4:revision:5","quote":"第12周NT-proBNP较基线变化百分比（中心实验室）","quote_sha256":"e777be2e531186c75bac394b932a9171a08569e18bcb0166caf7ea5e61a9665e","source_id":"current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","span_id":"es_003"}],"evidence_review_advisories":[],"evidence_span_ids":["es_001","es_002","es_003"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"需项目提供样本量计算所依据的NT-proBNP变化百分比组间差值及标准差，以完成公式复算验证","category":"source_missing","gap_id":"gap_91_effect_size","missing_source_classes":["样本量计算依据","项目统计分析计划"],"target":"9.1 样本量"}],"heading":"样本量","missing_source_classes":["样本量计算依据（效应量、标准差）","项目统计分析计划"],"proposal_text":"本研究样本量基于主要终点第12周NT-proBNP较基线变化百分比的组间比较确定。统计假设采用双侧α=0.10、把握度85%。按2:1:1随机化比例（KZ-sGC2301 50mg组、KZ-sGC2301 25mg组、安慰剂组）分配，每组计划入组85例，总计255例（含脱落补偿）。该样本量计算所依据的效应量（NT-proBNP变化百分比的组间差值）和标准差参数需由项目统计分析计划或前期数据支持确认。","rationale":"样本量参数（双侧α=0.10、效能85%、每组85例、总计255例含脱落补偿）及随机化比例2:1:1来自项目已确认研究事实。但样本量计算所依据的效应量（NT-proBNP变化百分比的组间差值）和标准差未在项目来源中明确给出，无法进行公式复算验证，需项目统计分析计划或前期数据支持。","review_advisories":["本节复述高影响研究设计（样本量）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（α、主要终点、样本量、计划入组）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_c2b4f6b36cfa_ede6426d638af1f2","section_number":"9.1","source_ids":["protocol_full_draft_selection:42368ae282a3ed61b3a34b3c","current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:9691f7c94f6c58","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976","company_corpus:cms_cn_protocol_corpus_20260715_v1:9895ed0bd2ffd4","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83"]}],"source_bindings":[{"content_sha256":"930a6f23f37260bd39b06ef277d0ec19757a39fc9c933765159ab8597d2645d7","locator":"document:mwdoc_greenfield_proj_user_c2b4f6b36cfa_d32f1403e36f9644:full-draft:42368ae282a3ed61b3a34b3c","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:42368ae282a3ed61b3a34b3c","source_type":"protocol_full_draft_selection","source_version":"full-draft:7229634723277c379be3a99d4611fda439d7e6ff2650264fc5bc232e6c02c8ce:42368ae282a3ed61b3a34b3c","text_sha256":"930a6f23f37260bd39b06ef277d0ec19757a39fc9c933765159ab8597d2645d7"},{"content_sha256":"db6e25d19d6b2cdb6cd0e334c08e2c596588bee9fea02a764494dd819a5dc6b4","locator":"study_definition:mwdefinition_56b96348f0f97cd896c4:revision:5","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","source_type":"current_project_study_definition","source_version":"mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","text_sha256":"db6e25d19d6b2cdb6cd0e334c08e2c596588bee9fea02a764494dd819a5dc6b4"},{"content_sha256":"e9a73951b4b81029575c055f51e285b89ca3c683bf8d59bb10d324446e599f88","locator":"section:不良事件的随访|block:831|chunk:1","role":"company_sop_or_protocol_re