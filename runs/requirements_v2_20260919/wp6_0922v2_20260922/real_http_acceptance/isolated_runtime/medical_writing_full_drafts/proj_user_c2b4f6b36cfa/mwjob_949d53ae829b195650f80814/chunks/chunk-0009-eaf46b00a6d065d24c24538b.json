evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"由医学团队依据IB药代动力学/相互作用数据及GDMT指南确认允许合并用药的完整清单及剂量调整规则","category":"source_missing","gap_id":"gap_661_01","missing_source_classes":["研究者手册","心衰GDMT指南"],"target":"6.6.1节-允许合并用药具体清单"}],"heading":"允许的合并用药/治疗","missing_source_classes":["研究者手册（IB）中药物相互作用章节","方案正文中合并用药具体允许/禁止清单"],"proposal_text":"本研究以慢性心力衰竭（射血分数降低，LVEF≤40%）成人患者的指南指导药物治疗（GDMT）为背景治疗，试验药物KZ-sGC2301在GDMT基础上加用。受试者在筛选前须已接受GDMT稳定治疗至少4周，入组后GDMT方案原则上维持不变。允许继续使用的合并用药包括：受试者在筛选前已稳定使用的GDMT药物（如血管紧张素转换酶抑制剂、血管紧张素受体拮抗剂、血管紧张素受体脑啡肽酶抑制剂、β受体阻滞剂、盐皮质激素受体拮抗剂、钠-葡萄糖协同转运蛋白2抑制剂等），以及经研究者判断对受试者合并疾病管理所必需且与试验药物无已知药代动力学或药效学相互作用的非心血管合并用药。合并用药的起始、剂量调整或停用须由研究者根据临床判断决定，并在病例报告表中如实记录药物名称、剂量、给药途径、起止日期及与试验药物的时间关系。若受试者在研究期间因合并疾病需要新增或调整合并用药，研究者应评估该用药是否可能影响主要终点或安全性终点的判读，并在方案偏离记录中说明。","rationale":"已确认研究事实明确试验干预为'GDMT基础上加用'且入选标准要求'GDMT稳定≥4周'，据此可确定GDMT为允许且要求的背景治疗框架。但GDMT具体药物组成、是否允许剂量调整、非心血管合并用药的完整允许清单及相互作用评估标准未在来源中给出，需医学团队依据研究者手册和药理学数据补充确认。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_c2b4f6b36cfa_1885c7565192485b","section_number":"6.6.1","source_ids":["protocol_full_draft_selection:eaf46b00a6d065d24c24538b","current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75"]},{"ai_run_id":"airun_20261015075450_cf56f3f7","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_56b96348f0f97cd896c4:revision:5","quote":"排除标准模块：近6个月心梗/不稳定心绞痛；强效CYP3A4抑制剂或诱导剂；妊娠哺乳","quote_sha256":"9b3ce11f8ad697d3a68ec7e21aa9a4be9b53a6180770f6ef703ad513bd762df4","source_id":"current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","span_id":"es_cyp3a4_excl"},{"locator":"study_definition:mwdefinition_56b96348f0f97cd896c4:revision:5","quote":"SMOKE-r3-1口服sGC刺激剂（KZ-sGC2301）：25mg或50mg口服每日一次晨服，连续12周","quote_sha256":"4410ce08f60975c93c4e9b796a970cfb2104b1ea1b4e09294fae8f63dd135980","source_id":"current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","span_id":"es_dose_regimen"}],"evidence_review_advisories":[],"evidence_span_ids":["es_cyp3a4_excl","es_dose_regimen"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"由医学团队依据IB及非临床数据确认sGC刺激剂相关禁忌药物（如硝酸酯类、PDE5抑制剂等）并列入方案","category":"source_missing","gap_id":"gap_662_01","missing_source_classes":["研究者手册","非临床药理学报告"],"target":"6.6.2节-完整禁止合并用药清单"},{"action":"由医学团队和药代动力学团队确认各禁止药物的洗脱期及研究期间使用禁止药物后的处理流程","category":"source_missing","gap_id":"gap_662_02","missing_source_classes":["药代动力学报告","方案实施操作手册"],"target":"6.6.2节-洗脱期时长及禁止用药后退出规则"}],"heading":"禁止的合并用药/治疗","missing_source_classes":["研究者手册（IB）中药物相互作用及禁忌章节","非临床毒理学及药代动力学报告","既往临床研究中合并用药安全性数据"],"proposal_text":"本研究禁止使用的合并用药和治疗包括：（1）强效细胞色素P450 3A4（CYP3A4）抑制剂或诱导剂，此类药物在筛选期及整个研究治疗期间均不得使用，因其可能显著改变KZ-sGC2301的血药浓度，影响疗效和安全性评估；（2）其他已知与sGC刺激剂存在药效学叠加或药代动力学相互作用的药物，具体清单由医学团队依据非临床及既往临床数据确定后列入方案；（3）可能干扰NT-proBNP检测或心衰状态评估的治疗措施。受试者在筛选前若正在使用上述禁止药物，须在入组前经过充分洗脱期，洗脱期时长由研究者根据药物半衰期及药代动力学特征确定。研究期间若受试者因合并疾病确需使用禁止类药物，研究者应评估是否继续参与研究，必要时按方案规定的退出程序处理。所有禁止合并用药的使用情况须在病例报告表中记录，包括药物名称、剂量、起止日期及研究者对受试者继续参与研究的判断。","rationale":"已确认研究事实的排除标准明确列出'强效CYP3A4抑制剂或诱导剂'为排除项，据此可确定该类药物的禁止使用。但sGC刺激剂与硝酸酯类、PDE5抑制剂、其他血管扩张剂等的潜在药效学相互作用，以及完整禁止药物清单、洗脱期具体时长、禁止用药后是否强制退出等实施规则，均未在来源中给出，需依据IB和药理学评估补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_c2b4f6b36cfa_dcdf282f95beabee","section_number":"6.6.2","source_ids":["protocol_full_draft_selection:eaf46b00a6d065d24c24538b","current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75"]},{"ai_run_id":"airun_20261015075450_cf56f3f7","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_56b96348f0f97cd896c4:revision:5","quote":"总体研究设计：随机、双盲、安慰剂对照、平行组、多中心II期概念验证与剂量探索研究","quote_sha256":"c3276946ddacaabca03a738f9292af1cb444b7807a5d494206fd2e6782c0a016","source_id":"current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","span_id":"es_study_design"},{"locator":"study_definition:mwdefinition_56b96348f0f97cd896c4:revision:5","quote":"安慰剂：安慰剂匹配双模拟对照，随机2:1:1（高剂量/低剂量/安慰剂），双盲","quote_sha256":"3b0c9d3ef132515b8171da11e61635e867e881cdc42cf44ca814dba4fa2b879e","source_id":"current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","span_id":"es_placebo"},{"locator":"study_definition:mwdefinition_56b96348f0f97cd896c4:revision:5","quote":"主要终点：第12周NT-proBNP较基线变化百分比（中心实验室）","quote_sha256":"c4c9452f18140a86c39e38e95c2b890a088b84429c9a26d1c60984544955b3fc","source_id":"current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","span_id":"es_primary_ep"},{"locator":"study_definition:mwdefinition_56b96348f0f97cd896c4:revision:5","quote":"安全性终点：治疗期TEAE发生率与严重程度；生命体征/ECG/实验室异常；症状性低血压","quote_sha256":"f8549b4978ce8209d5fc1411a29b450e113aaa1c7d1160a5b8a98deb6c79524a","source_id":"current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","span_id":"es_safety_ep"},{"locator":"study_definition:mwdefinition_56b96348f0f97cd896c4:revision:5","quote":"访视策略：双侧α=0.10、效能85%，每组约85例总计255例（含脱落补偿）","quote_sha256":"18fb9d41c86f0540a6f1ac826165bd4630e44a4c3bcf1c4f57673f6a48196908","source_id":"current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","span_id":"es_visit_strategy"},{"locator":"study_definition:mwdefinition_56b96348f0f97cd896c4:revision:5","quote":"SMOKE-r3-1口服sGC刺激剂（KZ-sGC2301）：25mg或50mg口服每日一次晨服，连续12周","quote_sha256":"4410ce08f60975c93c4e9b796a970cfb2104b1ea1b4e09294fae8f63dd135980","source_id":"current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","span_id":"es_dose_regimen"}],"evidence_review_advisories":[],"evidence_span_ids":["es_study_design","es_placebo","es_primary_ep","es_safety_ep","es_visit_strategy","es_dose_regimen"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"由医学团队和临床运营团队制定访视日程表，明确各访视日的评估项目、时间窗及NT-proBNP采集时点","category":"source_missing","gap_id":"gap_7_01","missing_source_classes":["访视日程表","评估操作手册"],"target":"第7章-具体访视日程与评估项目清单"},{"action":"由医学团队确认生命体征、ECG、实验室检查的采集频率及TEAE采集窗口定义","category":"source_missing","gap_id":"gap_7_02","missing_source_classes":["安全性评估方案","TEAE定义与采集窗口"],"target":"第7章-安全性评估频率与窗口"}],"heading":"研究程序和评估","missing_source_classes":["访视日程表（Schedule of Assessments）","各评估项目的具体时点与窗口定义","依从性评价方法"],"proposal_text":"本研究为随机、双盲、安慰剂对照、平行组、多中心II期概念验证与剂量探索研究，采用2:1:1随机分配（KZ-sGC2301 50mg组、KZ-sGC2301 25mg组、安慰剂组），双盲设计通过安慰剂匹配双模拟实现。研究程序涵盖筛选期、治疗期和随访期。治疗期持续12周，受试者每日晨起口服一次试验药物或安慰剂。主要疗效终点为第12周NT-proBNP较基线变化百分比，由中心实验室检测。安全性评估内容包括治疗期治疗期间不良事件（TEAE）的发生率与严重程度、生命体征、心电图及实验室检查异常，以及症状性低血压事件。统计分析采用ANCOVA基线校正模型，分层校正，敏感性分析与亚组分析预定义，次要终点按层次检验顺序校正。样本量按双侧α=0.10、效能85%计算，每组约85例，总计255例（含脱落补偿）。","rationale":"研究设计、随机比例、双盲方式、主要终点、安全性终点、统计策略及样本量参数均来自已确认研究事实。但具体访视日程（筛选期天数、治疗期各访视日、随访期时长）、各访视对应的评估项目清单（如NT-proBNP采集时点、ECG/实验室检查频率）、依从性评价方式及计划外访视触发条件未在来源中给出。","review_advisories":["本节提及高影响设计信息（α、样本量）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_c2b4f6b36cfa_4bedc782626e6f53","section_number":"7","source_ids":["protocol_full_draft_selection:eaf46b00a6d065d24c24538b","current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75"]},{"ai_run_id":"airun_20261015075450_cf56f3f7","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_56b96348f0f97cd896c4:revision:5","quote":"SMOKE-r3-1口服sGC刺激剂（KZ-sGC2301）：25mg或50mg口服每日一次晨服，连续12周","quote_sha256":"4410ce08f60975c93c4e9b796a970cfb2104b1ea1b4e09294fae8f63dd135980","source_id":"current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","span_id":"es_dose_regimen"},{"locator":"study_definition:mwdefinition_56b96348f0f97cd896c4:revision:5","quote":"安慰剂：安慰剂匹配双模拟对照，随机2:1:1（高剂量/低剂量/安慰剂），双盲","