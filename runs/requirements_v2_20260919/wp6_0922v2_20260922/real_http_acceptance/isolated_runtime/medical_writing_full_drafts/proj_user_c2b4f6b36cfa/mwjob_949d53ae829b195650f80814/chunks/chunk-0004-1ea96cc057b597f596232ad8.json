":"1541424a072504b13dc999a7346751e32eebb848cc0771bb2ef3908b11c26ea0"},{"content_sha256":"8daf6dc46d42155e29ca2768fe326bcf20208390c0e565062d237a9768f12e59","locator":"section:随机和盲法|block:352|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","source_type":"company_protocol_reference_corpus","source_version":"046677b43d417b","text_sha256":"8daf6dc46d42155e29ca2768fe326bcf20208390c0e565062d237a9768f12e59"},{"content_sha256":"9dcf0050e6908f1bf1781d1b4e78bece680543f7bd3b6d430526c8fa0873ec33","locator":"section:随机和盲法|block:356|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","source_type":"company_protocol_reference_corpus","source_version":"8b49478f82c322","text_sha256":"9dcf0050e6908f1bf1781d1b4e78bece680543f7bd3b6d430526c8fa0873ec33"},{"content_sha256":"7e25516aff883ef38cd01d1e5148f546cd19e8736af26ae42a50c4ca7588c324","locator":"section:随机|block:441|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:97a2bd7fcf7302","source_type":"company_protocol_reference_corpus","source_version":"97a2bd7fcf7302","text_sha256":"7e25516aff883ef38cd01d1e5148f546cd19e8736af26ae42a50c4ca7588c324"}]}