t_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]},{"ai_run_id":"airun_20261015074912_1b134251","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_56b96348f0f97cd896c4:revision:5","quote":"试验干预：KZ-sGC2301片（口服sGC刺激剂）25mg/50mg每日一次，GDMT基础上加用","quote_sha256":"f3ed160abbc61a8b77434cf85d0dd9ad8c7cbc97c2d8544baf6ca5b4802322eb","source_id":"current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","span_id":"es_006"},{"locator":"study_definition:mwdefinition_56b96348f0f97cd896c4:revision:5","quote":"剂量与给药方案：SMOKE-r3-1口服sGC刺激剂（KZ-sGC2301）：25mg或50mg口服每日一次晨服，连续12周","quote_sha256":"d1bd418f85b80f5098c4484876327b49c84fb6ecfcc9244a17509c0832653a47","source_id":"current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","span_id":"es_007"},{"locator":"study_definition:mwdefinition_56b96348f0f97cd896c4:revision:5","quote":"安慰剂：安慰剂匹配双模拟对照，随机2:1:1（高剂量/低剂量/安慰剂），双盲","quote_sha256":"3b0c9d3ef132515b8171da11e61635e867e881cdc42cf44ca814dba4fa2b879e","source_id":"current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","span_id":"es_008"}],"evidence_review_advisories":[],"evidence_span_ids":["es_006","es_007","es_008"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"获取项目专属剂量调整、暂停、恢复及永久停药规则","category":"source_missing","gap_id":"gap_dose_adjustment","missing_source_classes":["项目专属剂量调整规则"],"target":"研究治疗/干预章节-剂量调整段落"},{"action":"获取项目专属合并用药与禁限用药清单","category":"source_missing","gap_id":"gap_concomitant_meds","missing_source_classes":["合并用药与禁限用药清单"],"target":"研究治疗/干预章节-合并用药段落"},{"action":"获取洗脱期定义及救援治疗方案","category":"source_missing","gap_id":"gap_washout_rescue","missing_source_classes":["洗脱期定义","救援治疗方案"],"target":"研究治疗/干预章节-洗脱与救援治疗段落"}],"heading":"研究治疗/干预","missing_source_classes":["项目专属剂量调整规则","合并用药与禁限用药清单","洗脱期定义","救援治疗方案"],"proposal_text":"本研究为随机、双盲、安慰剂对照、平行组、多中心II期概念验证与剂量探索研究。受试者在GDMT基础上接受以下干预之一：KZ-sGC2301片25mg每日一次晨服（低剂量组）、KZ-sGC2301片50mg每日一次晨服（高剂量组）或匹配安慰剂每日一次晨服（安慰剂组），治疗周期为连续12周。随机化比例为高剂量组∶低剂量组∶安慰剂组＝2∶1∶1，采用中央随机系统按中心分层进行分配。所有受试者、研究者及疗效评价者对治疗分配保持双盲。KZ-sGC2301为口服sGC刺激剂，以口服固体制剂形式给药，属全身暴露。","rationale":"剂量（25mg/50mg）、给药频率（每日一次晨服）、治疗周期（连续12周）、对照形式（安慰剂匹配双模拟）、随机比例（2:1:1）及双盲设计均直接来源于当前项目已确认研究事实。剂量调整/暂停/恢复/永久停药规则、合并用药与禁限用药清单、洗脱期定义及救援治疗方案缺少项目专属来源，需补充后方可定稿。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_c2b4f6b36cfa_7adc7efd6d6eb2df","section_number":"6","source_ids":["protocol_full_draft_selection:3928a58f7ead73eece6b4845","current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]}],"source_bindings":[{"content_sha256":"e7ae0a1acb775398caa6c3b0c4510b81a8434a75352d371b2817cedd3c50ff00","locator":"document:mwdoc_greenfield_proj_user_c2b4f6b36cfa_d32f1403e36f9644:full-draft:3928a58f7ead73eece6b4845","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:3928a58f7ead73eece6b4845","source_type":"protocol_full_draft_selection","source_version":"full-draft:7229634723277c379be3a99d4611fda439d7e6ff2650264fc5bc232e6c02c8ce:3928a58f7ead73eece6b4845","text_sha256":"e7ae0a1acb775398caa6c3b0c4510b81a8434a75352d371b2817cedd3c50ff00"},{"content_sha256":"db6e25d19d6b2cdb6cd0e334c08e2c596588bee9fea02a764494dd819a5dc6b4","locator":"study_definition:mwdefinition_56b96348f0f97cd896c4:revision:5","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","source_type":"current_project_study_definition","source_version":"mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","text_sha256":"db6e25d19d6b2cdb6cd0e334c08e2c596588bee9fea02a764494dd819a5dc6b4"},{"content_sha256":"abe327b691816a29b09e2ea049d5e7c9be77469b1d15bea0d