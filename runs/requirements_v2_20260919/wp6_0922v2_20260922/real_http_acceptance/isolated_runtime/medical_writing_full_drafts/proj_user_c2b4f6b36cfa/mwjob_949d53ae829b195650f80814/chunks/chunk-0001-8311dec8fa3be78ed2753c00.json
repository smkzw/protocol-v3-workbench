uote_sha256":"c4c9452f18140a86c39e38e95c2b890a088b84429c9a26d1c60984544955b3fc","source_id":"current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","span_id":"ES003"},{"locator":"study_definition:mwdefinition_56b96348f0f97cd896c4:revision:5","quote":"样本量策略：双侧α=0.10、效能85%，每组85例总计255例（含脱落补偿）","quote_sha256":"42a83d4b5b2ab2d73a327c16e1bb7624e321b9c3cb4f12f402aca556c2baa0c2","source_id":"current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","span_id":"ES004"},{"locator":"study_definition:mwdefinition_56b96348f0f97cd896c4:revision:5","quote":"剂量与给药方案：SMOKE-r3-1口服sGC刺激剂（KZ-sGC2301）：25mg或50mg口服每日一次晨服，连续12周","quote_sha256":"d1bd418f85b80f5098c4484876327b49c84fb6ecfcc9244a17509c0832653a47","source_id":"current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","span_id":"ES005"},{"locator":"study_definition:mwdefinition_56b96348f0f97cd896c4:revision:5","quote":"研究人群概述：慢性心力衰竭成人患者（LVEF≤40%），NYHA II-III级，GDMT稳定至少4周症状未充分控制","quote_sha256":"2ff065840f6d0c261e064decbe3038f5a98e6f87e401f15c4df5a6e45e1fec2d","source_id":"current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","span_id":"ES006"}],"evidence_review_advisories":[],"evidence_span_ids":["ES001","ES002","ES003","ES004","ES005","ES006"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[],"heading":"方案概要","missing_source_classes":[],"proposal_text":"本研究为一项随机、双盲、安慰剂对照、平行组、多中心II期概念验证与剂量探索研究，旨在评价SMOKE-r3-1口服sGC刺激剂（KZ-sGC2301）在慢性心力衰竭（射血分数降低，HFrEF）成人患者中的疗效与安全性。目标研究人群为左室射血分数≤40%、NYHA心功能II至III级、在指南指导的药物治疗（GDMT）稳定至少4周后症状仍未充分控制的成人患者，年龄18至75岁。研究设三个治疗组：KZ-sGC2301 50mg每日一次组、KZ-sGC2301 25mg每日一次组及安慰剂组，按2:1:1比例随机分配，采用安慰剂匹配双模拟对照，受试者与研究者均设盲。所有受试者在GDMT基础上加用研究药物或安慰剂，口服每日一次晨服，连续给药12周。主要疗效终点为第12周NT-proBNP较基线变化百分比，由中心实验室检测。安全性评价包括治疗期治疗期间不良事件（TEAE）发生率与严重程度、生命体征与心电图异常、实验室检查异常及症状性低血压。样本量按双侧α=0.10、统计效能85%计算，每组85例，总计255例（含脱落补偿）。主要终点采用ANCOVA基线校正分析，辅以分层校正、预定义敏感性分析与亚组分析；次要终点按层次检验顺序进行多重性校正。本研究不设置自适应设计、样本量再估计、期中分析、独立安全审查委员会或数据安全监查委员会。","rationale":"本段正文全部依据当前项目已确认研究事实（方案编号MW-II-D3EEA119-DRAFT，修订5）中的研究设计、人群、干预、对照、终点、样本量及统计策略字段。医学经理需核实：（1）样本量255例的统计假设参数（率差/差值、SD、α、效能）是否与实际计算一致；（2）'不设置DMC/SRC'是否符合本阶段监管沟通要求；（3）双盲范围是否仅限受试者与研究者，还是扩展至其他评估人员。","review_advisories":["本节复述高影响研究设计（方案概要）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（α、主要终点、期中分析、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_c2b4f6b36cfa_df84f0ad9ddf8a47","section_number":"1","source_ids":["protocol_full_draft_selection:8311dec8fa3be78ed2753c00","current_project_study_definition:mwdefinition_56b96348f0f97cd896c4:r5:3b8925778cb6ff75","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:76a6125fa7dca4","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc6f8c9ea6d34b"]},{"ai_run_id":"airun_20261015072405_c7b82999","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"补充HFrEF流行病学数据、疾病负担统计、现行诊疗指南及治疗格局综述来源后重新生成","category":"source_missing","gap_id":"GAP-001","missing_source_classes":["HFrEF流行病学与疾病负担数据","中国及国际心衰诊疗指南","HFrEF当前标准治疗方案与未满足需求综述"],"target":"疾病背景及治疗现状章节正文"}],"heading":"疾病背景及治疗现状","missing_source_classes":["HFrEF流行病学与疾病负担数据","中国及国际心衰诊疗指南","HFrEF当前标准治疗方案与未满足需求综述","sGC刺激剂类药物的疾病领域背景资料"],"proposal_text":"","rationale":"本章节需要HFrEF流行病学与疾病负担数据、现行中国及国际心衰诊疗指南（如中国心衰指南、ESC/AHA指南）中关于GDMT四联方案及残余风险描述、当前标准治疗格局与未满足需求等来源。当前允许来源中无上述任何内容，公司语料为PNH、炎症性皮肤病及特应性皮炎方案，适应症不匹配，不可迁移疾病背景事实。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_c2b4f6b36cfa_d045910b70b33954","section_number":"2.1","source_ids":["protocol_full_draft_selection:8311dec8fa3be78ed2753c00","current_project_study