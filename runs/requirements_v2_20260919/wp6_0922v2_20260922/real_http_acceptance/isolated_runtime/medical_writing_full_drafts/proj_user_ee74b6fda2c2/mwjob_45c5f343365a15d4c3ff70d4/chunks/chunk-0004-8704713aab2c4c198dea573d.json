summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"确认分层因素具体清单及是否按中心分层","category":"source_missing","gap_id":"gap_rand_01","missing_source_classes":["随机化操作程序文件"],"target":"随机化章节-分层因素"},{"action":"确认区组大小、随机化生成工具及分配比例监控规则","category":"source_missing","gap_id":"gap_rand_02","missing_source_classes":["随机化操作程序文件"],"target":"随机化章节-区组与分配方法"}],"heading":"随机化","missing_source_classes":["随机化操作程序文件","分层因素确认清单"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂对照的平行组设计，共设两个治疗组：KRX-451 2 mg每日两次口服组与匹配安慰剂组，两组按1:1比例随机分配。随机化采用中央随机化方式，由独立于研究中心的随机化系统生成分配序列，确保各中心入组受试者按预定比例均衡分配至试验组或对照组。统计分析计划中，主要终点协方差分析将基线WI-NRS及分层因素纳入协变量，应答率采用分层CMH检验，提示随机化过程需考虑分层因素以保障组间可比性。本研究不计划自适应设计、样本量再估计或期中分析，随机化方案在研究启动前确定后不再调整。","rationale":"已确认事实支持：多中心、随机、双盲、安慰剂对照、两臂1:1、平行组、不计划自适应/样本量再估计/期中分析；统计分析提及分层因素。需医学经理确认：具体分层因素清单（如中心、透析频率等）、区组大小、随机化生成工具及分配比例监控规则。","review_advisories":["本节复述高影响研究设计（随机化）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、期中分析、样本量）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ee74b6fda2c2_1311d001335ef972","section_number":"4.3","source_ids":["protocol_full_draft_selection:8704713aab2c4c198dea573d","current_project_study_definition:mwdefinition_466a0de7c48143873a5a:r6:fba9cc6529136766"]},{"ai_run_id":"airun_20261006130853_7c8f8d48","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_466a0de7c48143873a5a:revision:6","quote":"多中心、随机、双盲、安慰剂对照 II 期试验。两臂 1:1（KRX-451 2mg bid / 匹配安慰剂），12 周双盲治疗 + 4 周安全随访。","quote_sha256":"cceaa0b3181433bed5b07e3758770a9df017d9740be3402fd284910e540dd47d","source_id":"current_project_study_definition:mwdefinition_466a0de7c48143873a5a:r6:fba9cc6529136766","span_id":"es_03"}],"evidence_review_advisories":[],"evidence_span_ids":["es_03"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[{"action":"确认各角色盲态范围及非盲人员职责","category":"source_missing","gap_id":"gap_blind_01","missing_source_classes":["盲法操作程序文件"],"target":"盲法章节-盲态范围"},{"action":"确认紧急揭盲触发条件、操作流程及揭盲后数据处理","category":"source_missing","gap_id":"gap_blind_02","missing_source_classes":["紧急揭盲程序文件"],"target":"盲法章节-揭盲程序"}],"heading":"盲法与揭盲","missing_source_classes":["盲法操作程序文件","紧急揭盲程序文件"],"proposal_text":"本研究采用双盲设计。试验药KRX-451 2 mg与匹配安慰剂在外观、气味、包装及给药方式上保持一致，使受试者和研究中心工作人员无法通过感官区分所接受的治疗。两组按1:1比例随机分配，每位受试者接受KRX-451 2 mg每日两次口服或匹配安慰剂每日两次口服，双盲治疗期共12周。安慰剂为与KRX-451匹配的安慰剂，确保双盲条件下受试者无法辨别所接受的是活性药物还是安慰剂。","rationale":"已确认事实支持：双盲设计、匹配安慰剂、1:1分配、KRX-451 2mg bid与匹配安慰剂。需医学经理确认：各角色（受试者、研究者、评价者、数据监查人员、统计人员）的盲态范围、紧急揭盲触发条件与操作程序、揭盲后数据处理规则。","review_advisories":["本节复述高影响研究设计（盲法与揭盲）；请在合并设计摘要中统一核对。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ee74b6fda2c2_b97b375f63880f20","section_number":"4.4","source_ids":["protocol_full_draft_selection:8704713aab2c4c198dea573d","current_project_study_definition:mwdefinition_466a0de7c48143873a5a:r6:fba9cc6529136766"]},{"ai_run_id":"airun_20261006130853_7c8f8d48","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_466a0de7c48143873a5a:revision:6","quote":"双盲治疗期 12 周；安全随访期 4 周","quote_sha256":"fa67bfee3e346857c24e9b22b05fdb5ef79f7afeb5f973490030fdb4c2722106","source_id":"current_project_study_definition:mwdefinition_466a0de7c48143873a5a:r6:fba9cc6529136766","span_id":"es_04"},{"locator":"study_definition:mwdefinition_466a0de7c48143873a5a:revision:6","quote":"访视策略：原文未提供完整访视计划","quote_sha256":"2421804a3b3c3d243a23ff651fe7f55b8ab3436b5847b87d08ed768dfb188c0e","source_id":"current_project_study_definition:mwdefinition_466a0de7c48143873a5a:r6:fba9cc6529136766","span_id":"es_05"}],"evidence_review_advisories":[],"evidence_span_ids":["es_04","es_05"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"获取完整访视计划，确认各访视实施内容及安全随访期访视安排","category":"source_missing","gap_id":"gap_dur_01","missing_source_classes":["完整访视计划文件"],"target":"研究结束与持续时间章节-访视计划"},{"action":"确认研究结束的具体定义及末次数据收集时点","category":"source_missing","gap_id":"gap_dur_02","missing_source_classes":["研究结束定义文件"],"target":"研究结束与持续时间章节-研究结束定义"}],"heading":"研究结束与研究持续时间","missing_source_classes":["完整访视计划文件","研究结束定义文件"],"proposal_text":"本研究总持续时间为16周，由两个连续阶段组成：双盲治疗期12周和安全随访期4周。双盲治疗期自受试者首次接受研究药物（KRX-451 2 mg每日两次或匹配安慰剂）起算，持续12周；安全随访期自双盲治疗期结束后起算，持续4周，用于观察停药后安全性事件及不良事件的转归。每位受试者从随机化入组至研究结束（含安全随访期）的总参与时间约为16周。安全随访期内不再给予研究药物，但继续收集不良事件、生命体征、实验室检查及心电图等安全性数据。","rationale":"已确认事实支持：双盲治疗期12周、安全随访期4周、安全性终点含不良事件/生命体征/实验室检查/心电图。需医学经理确认：完整访视计划及各访视具体实施内容（原文未提供完整访视计划）、安全随访期具体访视次数与时间点、研究结束定义（末次访视或末次数据收集）。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ee74b6fda2c2_a078ded62cedb0e7","section_number":"4.6","source_ids":["protocol_full_draft_selection:8704713aab2c4c198dea573d","current_project_study_definition:mwdefinition_466a0de7c48143873a5a:r6:fba9cc6529136766"]},{"ai_run_id":"airun_20261006130853_7c8f8d48","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取研究暂停的触发条件、决策主体及暂停后恢复条件","category":"source_missing","gap_id":"gap_term_01","missing_source_classes":["研究暂停和终止标准文件"],"target":"研究暂停和终止标准章节-暂停触发标准"},{"action":"获取研究提前终止的触发条件、决策流程及终止后受试者随访安排","category":"source_missing","gap_id":"gap_term_02","missing_source_classes":["研究暂停和终止标准文件"],"target":"研究暂停和终止标准章节-终止标准"},{"action":"确认在无DMC/SRC条件下安全性信号的监测与升级路径","category":"source_missing","gap_id":"gap_term_03","missing_source_classes":["安全性监查与决策程序文件"],"target":"研究暂停和终止标准章节-安全性监查机制"}],"heading":"研究暂停和终止标准","missing_source_classes":["研究暂停和终止标准文件","安全性监查与决策程序文件"],"proposal_text":"","rationale":"本研究不计划设立独立数据监查委员会（DMC）和安全审查委员会（SRC），也不计划进行期中分析。研究暂停和终止的具体触发标准、决策主体、暂停后恢复条件及终止后随访安排缺少对应项目文件支持，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfie