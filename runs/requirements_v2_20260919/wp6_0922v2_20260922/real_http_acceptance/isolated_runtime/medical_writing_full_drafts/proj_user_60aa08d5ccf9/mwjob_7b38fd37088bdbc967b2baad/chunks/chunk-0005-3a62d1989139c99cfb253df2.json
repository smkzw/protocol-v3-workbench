0b4e8cc53c959daf6e","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_no_src"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"TEAE发生率与严重程度（CTCAE 5.0）；生命体征、12导联心电图、实验室检查较基线变化；听力与前庭功能专项评估。","quote_sha256":"3ce2f09168995715680fd055c9fc2d8bb5f7eed4494649440ccc7177cfbddc85","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_safety_endpoints"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"抑郁/情绪改变（H3反向激动剂类风险）；肝酶升高；症状性心动过缓。","quote_sha256":"79d9279bffb0df3daad7f07026db5f1f4c58ba821045c2315f906899be1e2587","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_special_ae"}],"evidence_review_advisories":[],"evidence_span_ids":["es_dmc_no_interim","es_no_interim_src","es_no_src","es_safety_endpoints","es_special_ae"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"获取项目DMC章程或安全性监查计划后补充","category":"source_missing","gap_id":"gap_dmc_operational","missing_source_classes":["DMC章程","安全性监查计划"],"target":"DMC会议频率、法定人数、投票机制、安全性信号触发阈值及暂停/终止建议流程"}],"heading":"安全性审评/数据监查委员会","missing_source_classes":["DMC章程","安全性监查计划"],"proposal_text":"本研究设置独立数据监查委员会（DMC），由具备梅尼埃病、前庭医学、耳科学及生物统计学背景的独立专家组成，负责在研究全程对受试者安全性数据进行定期审阅。DMC审阅范围涵盖治疗期与安全性随访期内全部不良事件（含特别关注的抑郁/情绪改变、肝酶升高及症状性心动过缓）、生命体征、12导联心电图、实验室检查及听力与前庭功能专项评估结果。本研究不设置期中有效性分析，亦不设置安全审查委员会（SRC）；DMC的职能限于安全性监督，不对疗效终点进行期中判定。DMC审阅频率、会议形式、法定人数、投票规则及向申办方提出暂停或终止建议的具体触发条件，将在DMC章程中另行规定。","rationale":"DMC设置、无期中分析、无SRC、安全性终点范围及特别关注不良事件类别均来自当前项目已确认研究事实。DMC具体运作参数（频率、章程、触发阈值）在允许来源中未给出，需项目DMC章程或安全性监查计划补充后方可定稿。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_60aa08d5ccf9_a443ed23fc4b1b94","section_number":"4.5","source_ids":["protocol_full_draft_selection:3a62d1989139c99cfb253df2","current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317"]},{"ai_run_id":"airun_20261009231332_28c4f811","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"研究时期：筛选与基线期（3个月，含前瞻性电子日记）；双盲治疗期（24周）；安全性随访期（4周）","quote_sha256":"4cdb546aace591d03ad6d290d9fa1df3fc960c917f00e25e6bc78372d68104d6","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_study_periods"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"基线期日记培训（V0）、随机（V1）、治疗期第8/16/24周（V2-V4，含纯音听阈与前庭评估）、安全性随访（V5）；电子日记每日填写，评估窗口±5天。","quote_sha256":"ed77aa52bb5994bddd8daa8d96c46e2c4f004deed846fdcbca935de336edbd65","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_visit_strategy"}],"evidence_review_advisories":[],"evidence_span_ids":["es_study_periods","es_visit_strategy"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[],"heading":"研究结束与研究持续时间","missing_source_classes":[],"proposal_text":"本研究总持续时间由三个连续阶段构成：筛选与基线期共3个月，期间完成知情同意、入选与排除标准核查、基线评估及前瞻性电子日记培训与填写；双盲治疗期共24周，受试者按1:1随机分配至KZ-MD601组或安慰剂组，治疗期访视安排为第8周（V2）、第16周（V3）和第24周（V4），其中V2至V4含纯音听阈与前庭功能评估；安全性随访期共4周，安排V5访视。每位受试者自签署知情同意至完成安全性随访的总研究参与时间约为31个月。研究整体结束以最后一名受试者完成安全性随访访视为标志。电子日记在筛选与基线期及双盲治疗期内每日填写，各访视评估窗口为计划访视日前后5天。","rationale":"三段研究时期（3个月+24周+4周）、访视策略（V0至V5）、评估窗口±5天及电子日记每日填写要求均来自当前项目已确认研究事实。总参与时间31个月由三段时长直接加和得出。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_60aa08d5ccf9_a1f919b93faae1c5","section_number":"4.6","source_ids":["protocol_full_draft_selection:3a62d1989139c99cfb253df2","current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317"]},{"ai_run_id":"airun_20261009231332_28c4f811","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取项目DMC章程、安全性监查计划或方案安全性章节中关于暂停/终止条件的规定后补充","category":"source_missing","gap_id":"gap_pause_termination","missing_source_classes":["DMC章程","安全性监查计划","方案安全性章节（暂停/终止条款）"],"target":"研究暂停和终止标准（个体层面与整体研究层面）"}],"heading":"研究暂停和终止标准","missing_source_classes":["DMC章程","安全性监查计划","方案安全性章节（暂停/终止条款）"],"proposal_text":"","rationale":"研究暂停和终止标准（含个体层面暂停/终止条件与整体研究暂停/终止条件）在允许来源中无任何项目级规定。当前章节原始内容为空，且无对应项目文件（如DMC章程、安全性监查计划、方案安全性章节）可供引用。依据任务要求，缺少对应项目文件时必须标记source_gap，不得以通用原则或条件句替代。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_60aa08d5ccf9_3359f7516b30751c","section_number":"4.7","source_ids":["protocol_full_draft_selection:3a62d1989139c99cfb253df2","current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317"]},{"ai_run_id":"airun_20261009231332_28c4f811","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"18-75岁，单侧或双侧梅尼埃病按AAO-HNS标准确诊；筛选期前3个月发作性眩晕≥2次/月并有日记记录；纯音听阈存在波动性证据；签署知情同意。","quote_sha256":"fac99ae207d739b7d73362805204ae719789cc15da4a8b813764e674e8a8998c","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_inclusion"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"前庭性偏头痛或前庭神经炎等其他前庭疾病为主的眩晕；噪声性或药物性听力损失；内听道MRI提示听神经瘤；重度肝肾功能异常（ALT/AST>2.5×ULN或eGFR<50）；妊娠或哺乳期。","quote_sha256":"ad47636f2da69593cae59f6d1de5344b23ba8a37ed20707aea8743e805f693ca","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_exclusion"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"入组前14天内使用庆大霉素鼓室内注射或全身使用耳毒性药物者须洗脱；倍他司汀须稳定≥4周方可入组且研究期间不调量；禁用其他试验性前庭药物。","quote_sha256":"ad6ca4243be618d4e3a9ae8d3c8693725890b9cccf89b84f74135d492cfaebd8","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_washout"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"多中心、随机、双盲、安慰剂平行对照II期概念验证研究；受试者1:1随机至KZ-MD601组或安慰剂组，双盲治疗期24周","quote_sha256":"6174cb0e318d7fc1b09a6202a37bb6cbe7ea31c510c9ae9b2c2bba8ae2ad9173","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_design"}],"evidence_review_advisories":[],"evidence_span_ids":["es_inclusion","es_exclusion","es_washout","es_design"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[],"heading":"研究人群","missing_source_classes":[],"proposal_text":"本研究拟纳入18至75岁（含两端）的梅尼埃病患者，单侧或双侧患病均可，须按AAO-HNS标准确诊。入选要求：筛选期前3个月内发作性眩晕每月不少于2次，且具备前瞻性电子日记记录；纯音听阈检查存在波动性听力损失证据；受试者须签署书面知情同意。排除标准包括：以前庭性偏头痛或前庭神经炎等其他前庭疾病为主要表现的眩晕；噪声性或药物性听力损失；内听道MRI提示听神经瘤；重度肝肾功能异常（ALT或AST超过2.5倍正常值上限，或eGFR低于50 mL/min/1.73m²）；妊娠或哺乳期女性。合并用药方面，允许稳定倍他司汀背景治疗（不超过48 mg/日）且须稳定使用不少于4周方可入组，研究期间倍他司汀剂量不得调整；入组前14天内接受过庆大霉素鼓室内注射或全身使用耳毒性药物者须完成洗脱方可入组；禁止使用其他试验性前庭药物。","rationale":"年龄范围、诊断标准（AAO-HNS）、眩晕频次与日记要求、波动性听力证据、排除标准（含肝肾功能阈值ALT/AST>2.5×ULN、eGFR<50）、倍他司汀背景治疗规则（≤48 mg/日、稳定≥4周、不调量）、洗脱要求（14天）及禁用其他试验性前庭药物均来自当前项目已确认研究事实。AAO-HNS与EUPOD标准的具体操作化定义（如听力损失分贝阈值、眩晕持续时间界定）需医学负责人进一步确认。","review_advisories":["本节复述高影响研究设计（研究人群）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_60aa08d5ccf9_7a92379e26d62fed","section_number":"5","source_ids":["protocol_full_draft_selection:3a62d1989139c99cfb253df2","current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317"]}],"source_bindings":[{"content_sha256":"84ee6186d20a3e7a44a36a7496a3ca22686c55456d083ca3910b0b8338c362c6","locator":"document:mwdoc_greenfield_proj_user_60aa08d5ccf9_9eaec061c1b07dd7:full-draft:3a62d1989139c99cfb253df2","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:3a62d1989139c99cfb253df2","source_type":"protocol_full_d