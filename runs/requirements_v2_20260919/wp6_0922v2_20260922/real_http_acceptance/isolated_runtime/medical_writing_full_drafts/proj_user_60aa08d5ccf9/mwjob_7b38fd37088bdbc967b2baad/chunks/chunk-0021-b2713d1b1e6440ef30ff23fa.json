ry":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"由医学经理依据本项目IB v1.2、安全性管理计划及中国GCP要求确认避孕方法、实验室项目清单、安全报告流程后定稿","category":"source_missing","gap_id":"gap_14_01","missing_source_classes":["安全性管理计划","IB v1.2安全性章节","实验室检查项目清单"],"target":"附录各子章节具体实施规则"}],"heading":"附录","missing_source_classes":["安全性管理计划","实验室检查项目清单及采集时点","避孕方法规定","安全信息报告流程"],"proposal_text":"本附录收录本研究方案正文中引用的辅助性技术文件与操作规范，涵盖避孕的规定与方法、实验室检查项目以及安全信息报告途径三个子章节。安全性评估所采用的不良事件严重程度分级依据CTCAE 5.0标准；安全性终点涵盖生命体征、12导联心电图、实验室检查较基线变化以及听力与前庭功能专项评估。特别关注的不良事件类别包括抑郁或情绪改变（H3受体反向激动剂类风险）、肝酶升高及症状性心动过缓，相关监测与报告要求详见各附录子章节及方案正文安全性章节。各子章节的具体实施规则须依据本项目IB v1.2安全性章节及安全性管理计划确定后写入。","rationale":"项目研究事实确认安全性终点包含CTCAE 5.0分级、12导联心电图、实验室检查及听力前庭专项评估，并列出三类特别关注不良事件。附录作为容器章节，其子章节具体实施规则尚无项目来源支持，需医学经理依据IB及安全性管理计划补充确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_60aa08d5ccf9_fa501a5e6aa5049f","section_number":"14","source_ids":["protocol_full_draft_selection:b2713d1b1e6440ef30ff23fa","current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","company_corpus:cms_cn_protocol_corpus_20260715_v1:semantic_window:6520ebbe09a51d:c0f9d8189ccfc6:85ee0ac32bdcdc:ed8c7e23cb9a85:f4b0433bf35190:c9b1b1d4f3b846","company_corpus:cms_cn_protocol_corpus_20260715_v1:semantic_window:c0f9d8189ccfc6:85ee0ac32bdcdc:ed8c7e23cb9a85:f4b0433bf35190:c9b1b1d4f3b846:e7a96b3314e879"]},{"ai_run_id":"airun_20261010000827_b3914dbc","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"依据KZ-MD601非临床生殖毒性数据及IB v1.2确定本项目适用避孕方法","category":"source_missing","gap_id":"gap_14_1_01","missing_source_classes":["IB v1.2生殖毒性章节","非临床生殖毒性研究报告"],"target":"避孕方法清单（可接受与不可接受）"},{"action":"由医学经理确认妊娠检查起始时间、检查频率及月经延迟处理规则","category":"source_missing","gap_id":"gap_14_1_02","missing_source_classes":["安全性管理计划","IB v1.2"],"target":"妊娠检查时点与频率"