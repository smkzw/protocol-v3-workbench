:["es_001","es_004"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"需项目医学团队确认筛选期及治疗期妊娠检查安排","category":"source_missing","gap_id":"gap_734_01","missing_source_classes":["妊娠检查与避孕方案项目文件"],"target":"妊娠检查具体时点与频率"},{"action":"需确认是否指定具体避孕方式及伴侣避孕要求","category":"source_missing","gap_id":"gap_734_02","missing_source_classes":["避孕方案项目文件"],"target":"避孕方法要求"},{"action":"需确认报告对象、时限及随访要求","category":"source_missing","gap_id":"gap_734_03","missing_source_classes":["妊娠报告SOP"],"target":"意外妊娠报告流程与时限"}],"heading":"妊娠检查和避孕问询","missing_source_classes":["妊娠检查与避孕方案项目文件","生殖毒性非临床数据","妊娠报告与随访SOP"],"proposal_text":"本方案将妊娠或哺乳期女性列为排除标准，育龄期女性受试者在筛选期须确认非妊娠且非哺乳状态方可入组。KZ-MD601为首次人体试验，其生殖毒性数据有限，妊娠期间暴露的安全性风险尚未充分表征。研究总观察期涵盖筛选与基线期3个月、双盲治疗期24周及安全性随访期4周，合计约31周，在此期间须对育龄期女性受试者进行妊娠状态监测与避孕问询。本章节覆盖妊娠检查时点与频率、研究期间避孕方法要求、意外妊娠的报告与处理流程以及伴侣妊娠报告等事项，上述具体实施规则因缺少对应项目文件而暂无法写入正文。","rationale":"排除标准中明确列出妊娠或哺乳期；研究时期合计约31周。但允许来源未提供妊娠检查具体日程、避孕方法、报告时限或伴侣妊娠报告要求，上述内容不可从排除标准推导。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_60aa08d5ccf9_515246c242b05421","section_number":"7.3.4","source_ids":["protocol_full_draft_selection:0d255801f136ede9b4cd5021","current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317"]},{"ai_run_id":"airun_20261009234506_ff1f709a","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"安全性终点：TEAE发生率与严重程度（CTCAE 5.0）；生命体征、12导联心电图、实验室检查较基线变化；听力与前庭功能专项评估。","quote_sha256":"3e7dbbc138fd999418628c786dea80f3e5c298d3e7206e4f4c3cdec3ede731de","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_002"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"特别关注的不良事件：抑郁/情绪改变（H3反向激动剂类风险）；肝酶升高；症状性心动过缓。","quote_sha256":"8cb8c512a735aa749fa0f397333524a8ebb1890c694162a24098ef2269ac0815","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_003"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"研究时期：筛选与基线期（3个月，含前瞻性电子日记）；双盲治疗期（24周）；安全性随访期（4周）","quote_sha256":"4cdb546aace591d03ad6d290d9fa1df3fc960c917f00e25e6bc78372d68104d6","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_004"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"访视策略：基线期日记培训（V0）、随机（V1）、治疗期第8/16/24周（V2-V4，含纯音听阈与前庭评估）、安全性随访（V5）；电子日记每日填写，评估窗口±5天。","quote_sha256":"8e43c1dc4bf27a721750f215e8883db85c8ad52765a60dac80043bda6578bbed","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_005"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003","es_004","es_005"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"需项目安全性文件明确TEAE采集窗口、SAE报告时限及SUSAR处理流程","category":"source_missing","gap_id":"gap_8_01","missing_source_classes":["AE/SAE/SUSAR定义与报告SOP"],"target":"AE/SAE/SUSAR定义与报告时限"},{"action":"需与统计团队确认SS定义及与FAS/PPS的关系","category":"source_missing","gap_id":"gap_8_02","missing_source_classes":["统计分析计划"],"target":"安全性分析集（SS）成员规则"},{"action":"需确认DMC审查内容、频率及暂停标准","category":"source_missing","gap_id":"gap_8_03","missing_source_classes":["DMC章程"],"target":"DMC职责与安全性监测频率"}],"heading":"安全性评价","missing_source_classes":["AE/SAE/SUSAR定义与报告SOP","安全性分析集成员定义文件","DMC章程"],"proposal_text":"本研究安全性评价涵盖双盲治疗期24周及安全性随访期4周内所有不良事件的收集、分类、严重程度判定与报告。安全性评估内容包括：不良事件发生率与严重程度（采用CTCAE 5.0分级）；生命体征、12导联心电图及实验室检查较基线变化；听力与前庭功能专项评估。特别关注的不良事件类别包括：抑郁或情绪改变（与H3受体反向激动剂类风险相关）、肝酶升高及症状性心动过缓。安全性数据在双盲治疗期及安全性随访期内持续收集，安全性随访访视（V5）安排于治疗结束后进行。安全性分析以描述性汇总为主，纳入安全性分析集。","rationale":"安全性终点、特别关注不良事件类别、研究时期及访视策略均来自当前项目已确认研究事实。但AE/SAE/SUSAR具体定义、报告时限、报告对象及安全性分析集成员规则未在允许来源中完整给出，需项目文件补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_60aa08d5ccf9_bdb2a95f58e91b45","section_number":"8","source_ids":["protocol_full_draft_selection:0d255801f136ede9b4cd5021","current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317"]},{"ai_run_id":"airun_20261009234506_ff1f709a","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"研究时期：筛选与基线期（3个月，含前瞻性电子日记）；双盲治疗期（24周）；安全性随访期（4周）","quote_sha256":"4cdb546aace591d03ad6d290d9fa1df3fc960c917f00e25e6bc78372d68104d6","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_004"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"访视策略：基线期日记培训（V0）、随机（V1）、治疗期第8/16/24周（V2-V4，含纯音听阈与前庭评估）、安全性随访（V5）；电子日记每日填写，评估窗口±5天。","quote_sha256":"8e43c1dc4bf27a721750f215e8883db85c8ad52765a60dac80043bda6578bbed","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_005"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"统计分析策略：FAS主分析集，PPS敏感性；主要终点采用MMRM（或负二项敏感性分析）比较两组第9-24周发作月均频次较基线变化，双侧α=0.05；关键次要终点按Holm递阶控制多重性；安全性描述汇总。","quote_sha256":"5122255db572bda493798da4c1d093c618c860ddfbef7cbf1b5db74a0d7711f0","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_006"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004","es_005","es_006"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"需确认V5是否包含实验室检查、心电图、听力评估等","category":"source_missing","gap_id":"gap_81_01","missing_source_classes":["访视操作手册"],"target":"安全性随访期（V5）具体评估项目"},{"action":"需与统计团队确认SS与FAS/PPS的包含关系及成员判定","category":"source_missing","gap_id":"gap_81_02","missing_source_classes":["统计分析计划"],"target":"安全性分析集（SS）精确定义"}],"heading":"总则","missing_source_classes":["安全性分析集成员定义文件","各访视安全性评估项目清单","DMC章程"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂平行对照II期概念验证研究，KZ-MD601组与安慰剂组按1:1比例随机分配。安全性评价贯穿筛选与基线期（3个月）、双盲治疗期（24周）及安全性随访期（4周），总观察期约31周。访视安排包括：基线期日记培训访视（V0）、随机访视（V1）、治疗期第8周（V2）、第16周（V3）、第24周（V4）及安全性随访访视（V5），其中V2至V4含纯音听阈与前庭功能评估；电子日记由受试者每日填写，评估窗口为±5天。安全性分析采用全分析集（FAS）作为主分析集，符合方案集（PPS）作为敏感性分析集；安全性数据以描述性汇总方式呈现。FAS纳入所有随机化受试者，无论其是否实际接受研究药物或完成治疗；PPS纳入无重大方案偏离且完成关键安全性评估的受试者，存在重大方案偏离者不纳入PPS。安全性分析集（SS）纳入至少接受一次研究药物或安慰剂给药且至少有一次安全性评估记录的受试者。","rationale":"研究设计、访视策略、研究时期及分析集策略均来自当前项目已确认研究事实。FAS与PPS成员规则依据统计分析策略中'FAS主分析集，PPS敏感性'的描述推导，SS定义需与统计团队确认。安全性随访期4周内具体评估项目（是否含实验室检查、心电图等）未在来源中逐项列出。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_60aa08d5ccf9_e1628bd2e075b7a0","section_number":"8.1","source_ids":["protocol_full_draft_selection:0d255801f136ede9b4cd5021","current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317"]},{"ai_run_id":"airun_20261009234506_ff1f709a","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"安全性终点：TEAE发生率与严重程度（CTCAE 5.0）；生命体征、12导联心电图、实验室检查较基线变化；听力与前庭功能专项评估。","quote_sha256":"3e7dbbc138fd999418628c786dea80f3e5c298d3e7206e4f4c3cdec3ede731de","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_002"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"特别关注的不良事件：抑郁/情绪改变（H3反向激动剂类风险）；肝酶升高；症状性心动过缓。","quote_sha256":"8cb8c512a735aa749fa0f397333524a8ebb1890c694162a24098ef2269ac0815","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_003"},{"locator":"document:mwdoc_greenfield_proj_user_60aa08d5ccf9_9eaec061c1b07dd7:full-draft:0d255801f136ede9b4cd5021","quote":"TEAE发生率与严重程度（CTCAE 5.0）；生命体征、12导联心电图、实验室检查较基线变化；听力与前庭功能专项评估。","quote_sha256":"3ce2f09168995715680fd055c9fc2d8bb5f7eed4494649440ccc7177cfbddc85","source_id":"protocol_full_draft_selection:0d255801f136ede9b4cd5021","span_id":"es_007"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003","es_007"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"需项目安全性文件提供AE、SAE、SUSAR的操作性定义","category":"source_missing","gap_id":"gap_82_01","missing_source_classes":["AE/SAE/SUSAR定义与报告SOP"],"target":"AE/SAE/SUSAR完整定义文本"},{"action":"需确认TEAE采集窗口是否从首次给药至末次给药后特定天数","category":"source_missing","gap_id":"gap_82_02","missing_source_classes":["安全性数据采集SOP"],"target":"TEAE采集窗口起止时点"},{"action":"需确认24小时/7天等报告时限及向申办方、伦理委员会、监管机构的报告路径","category":"source_missing","gap_id":"gap_82_03","missing_source_classes":["AE/SAE/SUSAR定义与报告SOP"],"target":"SAE/SUSAR报告时限与报告对象"}],"heading":"定义","missing_source_classes":["AE/SAE/SUSAR定义与报告SOP","TEAE采集窗口定义","SUSAR处理流程文件"],"proposal_text":"本章节定义安全性评价中使用的术语与评估标准。不良事件（AE）指受试者接受研究药物后出现的任何不良医学事件，无论是否与研究药物存在因果关系。治疗期间不良事件（TEAE）的严重程度分级采用CTCAE 5.0标准。安全性评估内容包括：生命体征、12导联心电图、实验室检查较基线变化；听力与前庭功能专项评估。特别关注的不良事件类别为：抑郁或情绪改变（与H3受体反向激动剂类风险相关）、肝酶升高及症状性心动过缓。上述特别关注不良事件在安全性数据汇总中单独列示。","rationale":"CTCAE 5.0、安全性评估项目（生命体征、12导联心电图、实验室检查、听力与前庭功能）及特别关注不良事件类别均来自当前项目已确认研究事实及章节包定义。但AE/SAE/SUSAR的完整定义文本、TEAE采集窗口起止时点、SAE报告时限与报告对象、SUSAR处理流程在允许来源中未提供，不可从现有信息推导。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_60aa08d5ccf9_f33d648c19d7e6bb","section_number":"8.2","source_ids":["protocol_full_draft_selection:0d255801f136ede9b4cd5021","current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317"]}],"source_bindings":[{"content_sha256":"1e6f2decfd5d1a6c2e611250e44e44ce6ddb1c6c444a1e76474fe31e18146cb1","locator":"document:mwdoc_greenfield_proj_user_60aa08d5ccf9_9eaec061c1b07dd7:full-draft:0d255801f136ede9b4cd5021","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:0d255801f136ede9b4cd5021","source_type":"protocol_full_draft_selection","source_version":"full-draft:861172e6b952fc5c2a078ace1a9f91473d8b46589dafe35c80c75521bdc04d58:0d255801f136ede