"source_ids":["protocol_full_draft_selection:351251a98c0ecc195131fda3","current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317"]},{"ai_run_id":"airun_20261009231946_3ed22732","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"漏服当日不补服","quote_sha256":"366a9191c18f69af06aeb7f76f6552eb5876cda797924068521b9a9c838fe8e9","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_study_def_02"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"电子日记每日填写，评估窗口±5天","quote_sha256":"be3f822c844c8709775d636b1d50eec2896b2335a962833288a4725194e6fb5a","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_study_def_03"}],"evidence_review_advisories":[],"evidence_span_ids":["es_study_def_02","es_study_def_03"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"确认依从性不足量化标准（如完成率<80%）及连续漏服处理流程","category":"source_missing","gap_id":"gap_65_compliance_threshold","missing_source_classes":["依从性管理规程"],"target":"6.5节依从性不足定义与处理"},{"action":"确认V2-V4各访视是否均执行药片计数及电子日记完成率核查","category":"source_missing","gap_id":"gap_65_visit_compliance_check","missing_source_classes":["访视操作清单"],"target":"6.5节各访视依从性核查"}],"heading":"研究治疗依从性","missing_source_classes":["项目依从性管理规程","各访视操作清单（含依从性核查项）"],"proposal_text":"本研究双盲治疗期共24周，受试者须每日晨起口服KZ-MD601缓释片或外观一致的安慰剂一片，整片吞服不可掰开。漏服当日不补服，次日按原计划继续给药。依从性通过电子日记每日填写记录与每次访视药片计数相结合的方式进行评估，电子日记评估窗口为±5天。治疗期访视安排为第8周（V2）、第16周（V3）和第24周（V4），各访视时研究者核查电子日记完成率与药片回收数量。依从性不足的量化判定阈值、连续漏服达到何种程度需暂停或终止治疗、以及依从性偏差的报告与记录方式，由项目依从性管理规程规定。","rationale":"已确认事实支持：给药方案（20 mg每日一次、整片吞服、漏服不补服）、电子日记每日填写、评估窗口±5天、V2-V4访视安排。缺少：依从性不足量化阈值、连续漏服处理规则、各访视是否均执行药片计数（来源仅列出访视编号与评估内容，未逐访视指定依从性检查项目）。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_60aa08d5ccf9_17cf1cbadeed11c4","section_number":"6.5","source_ids":["protocol_full_draft_selection:351251a98c0ecc195131fda3","current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317"]},{"ai_run_id":"airun_20261009231946_3ed22732","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"允许稳定倍他司汀背景治疗并分层","quote_sha256":"b0c4d2467498d45ea518e806f1c69b19ddc39ed9dc8e418ba6961f09777716d0","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_study_def_04"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"禁用其他试验性前庭药物","quote_sha256":"5ffce46be329e8be1ebbf6d57e4682588051b41c1378a74f01eb5d9463280e42","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_study_def_05"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"允许稳定倍他司汀背景（≤48 mg/日）并作为分层因素","quote_sha256":"8536272f9adbe0c9227c884f0d243416a210419aaee48b16f529a3fe3c814476","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_study_def_06"}],"evidence_review_advisories":[],"evidence_span_ids":["es_study_def_04","es_study_def_05","es_study_def_06"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"获取项目完整禁限用药清单及合并用药审批流程","category":"source_missing","gap_id":"gap_66_concomitant_list","missing_source_classes":["合并用药管理规程"],"target":"6.6节禁限用药清单"},{"action":"确认'既定救援方案'具体药物、剂量、触发条件及记录方式","category":"source_missing","gap_id":"gap_66_rescue_detail","missing_source_classes":["救援方案文件"],"target":"6.6节救援方案"}],"heading":"合并用药/治疗","missing_source_classes":["项目合并用药管理规程","完整禁限用药清单","救援方案具体药物与剂量"],"proposal_text":"本研究允许受试者在筛选前已稳定使用倍他司汀（≤48 mg/日）作为背景治疗，该用药须稳定≥4周方可入组，且研究期间不得调整倍他司汀剂量；倍他司汀使用状态作为随机分层因素之一。除倍他司汀外，禁用其他试验性前庭药物。急性眩晕发作时按既定救援方案处理并记录。入组前14天内使用庆大霉素鼓室内注射或全身使用耳毒性药物者须完成洗脱方可入组。其他合并用药的允许与禁止清单、合并用药记录与审批流程、以及非前庭类合并用药（如降压药、抗抑郁药等）对研究药物安全性评估的影响判定规则，由项目合并用药管理文件规定。","rationale":"已确认事实支持：倍他司汀≤48 mg/日允许且稳定≥4周、研究期间不调量、作为分层因素；禁用其他试验性前庭药物；急性眩晕按既定救援方案处理；庆大霉素及耳毒性药物14天洗脱。缺少：完整禁限用药清单、合并用药审批与记录流程、非前庭类合并用药处理规则。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_60aa08d5ccf9_fd372d479dd67d69","section_number":"6.6","source_ids":["protocol_full_draft_selection:351251a98c0ecc195131fda3","current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317"]},{"ai_run_id":"airun_20261009231946_3ed22732","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"允许稳定倍他司汀背景（≤48 mg/日）并作为分层因素","quote_sha256":"8536272f9adbe0c9227c884f0d243416a210419aaee48b16f529a3fe3c814476","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_study_def_06"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"急性眩晕发作按既定救援方案处理并记录","quote_sha256":"8ed33366e7964c5a58f96bb9ed401eba1f0284e9093099cd186d2c99245c88c3","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_study_def_07"}],"evidence_review_advisories":[],"evidence_span_ids":["es_study_def_06","es_study_def_07"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"确认救援方案具体药物名称、剂量、给药途径及触发条件","category":"source_missing","gap_id":"gap_661_rescue_drug","missing_source_classes":["救援方案文件"],"target":"6.6.1节救援方案"},{"action":"确认除倍他司汀与救援方案外是否允许其他合并用药及审批要求","category":"source_missing","gap_id":"gap_661_other_allowed","missing_source_classes":["合并用药管理规程"],"target":"6.6.1节其他允许合并用药"}],"heading":"允许的合并用药/治疗","missing_source_classes":["救援方案具体药物与剂量","合并用药管理规程"],"proposal_text":"本研究允许在筛选前已稳定使用≥4周的倍他司汀（每日总量≤48 mg）作为背景治疗继续用于研究全程，研究期间不得调整其剂量或给药频次；倍他司汀使用状态（使用/未使用）作为随机分层因素。急性眩晕发作时允许按既定救援方案给予救援治疗，救援药物使用频次作为关键次要终点之一予以记录。除上述倍他司汀背景治疗与救援方案外，其他合并用药的允许范围、需研究者审批方可使用的药物类别、以及合并用药与试验药物潜在相互作用的监测要求，由项目合并用药管理文件规定。","rationale":"已确认事实支持：倍他司汀≤48 mg/日允许、稳定≥4周、研究期间不调量、作为分层因素；急性眩晕按既定救援方案处理；救援药物使用频次为关键次要终点。缺少：救援方案具体药物与剂量、其他允许合并用药类别、合并用药审批流程。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_60aa08d5ccf9_8cacc0f0aceb4774","section_number":"6.6.1","source_ids":["protocol_full_draft_selection:351251a98c0ecc195131fda3","current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317"]}],"source_bindings":[{"content_sha256":"e58678b75530052b9e5d911e7263a7b0dbb7289513375cce5794224fe8f8d9fb","locator":"document:mwdoc_greenfield_proj_user_60aa08d5ccf9_9eaec061c1b07dd7:full-draft:351251a98c0ecc195131fda3","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:351251a98c0ecc195131fda3","source_type":"protocol_full_draft_selection","source_version":"full-draft:861172e6b952fc5c2a078ace1a9f91473d8b46589dafe35c80c75521bdc04d58:351251a98c0ecc195131fda3","text_sha256":"e58678b75530052b9e5d911e7263a7b0dbb7289513375cce5794224fe8f8d9fb"},{"content_sha256":"aac7656795aa239d613ae05aa9d631e7ef9d76a69f15468f6ed0b7692b2c4392","locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","source_type":"current_project_study_definition","source_version":"mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","text_sha256":"aac7656795aa239d613ae05aa9d631e7ef9d76a69f15468f6ed0b7692b2c4392"}]}