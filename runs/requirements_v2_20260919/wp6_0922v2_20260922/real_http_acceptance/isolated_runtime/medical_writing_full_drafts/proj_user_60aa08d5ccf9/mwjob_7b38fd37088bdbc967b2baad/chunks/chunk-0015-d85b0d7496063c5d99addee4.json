":"company_corpus:cms_cn_protocol_corpus_20260715_v1:9691f7c94f6c58","source_type":"company_protocol_reference_corpus","source_version":"9691f7c94f6c58","text_sha256":"e9ad40b728471c27bc7d951dc933b62de2ff8c7d067d9d4a14286b5864662b52"},{"content_sha256":"47df0c8a2632cc84ac2e3ae3ab1f29ba4d8df5fa38bbe112a6fd876ff4e4047b","locator":"section:妊娠事件的报告要求|block:839|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976","source_type":"company_protocol_reference_corpus","source_version":"5cb5f7385bb976","text_sha256":"47df0c8a2632cc84ac2e3ae3ab1f29ba4d8df5fa38bbe112a6fd876ff4e4047b"},{"content_sha256":"8faccf98599249546f17c815737ae497589afb5a40d8d75d748658c51e0012bc","locator":"section:8.6.2 妊娠事件的随访|block:846|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:9895ed0bd2ffd4","source_type":"company_protocol_reference_corpus","source_version":"9895ed0bd2ffd4","text_sha256":"8faccf98599249546f17c815737ae497589afb5a40d8d75d748658c51e0012bc"},{"content_sha256":"15c0e0648fb1262269fbc08e6dc67ec9615feeae6b6fd1d8cce97600976fd30f","locator":"section:妊娠、哺乳与避孕|block:779|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83","source_type":"company_protocol_reference_corpus","source_version":"ac6ee929ab7d83","text_sha256":"15c0e0648fb1262269fbc08e6dc67ec9615feeae6b6fd1d8cce97600976fd30f"}]}