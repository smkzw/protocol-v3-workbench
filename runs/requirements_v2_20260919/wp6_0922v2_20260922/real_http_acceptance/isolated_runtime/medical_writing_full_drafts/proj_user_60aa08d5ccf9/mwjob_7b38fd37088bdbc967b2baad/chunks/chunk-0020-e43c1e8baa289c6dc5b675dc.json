uote_sha256":"5f8b798cbc0f64e62f5265d53490297ddd90e92e5967e822f76181b61a64bc52","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_visit_strategy"}],"evidence_review_advisories":[],"evidence_span_ids":["es_multicenter","es_dmc","es_blind","es_placebo","es_mmrn","es_holm","es_sample_size","es_visit_strategy"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":8},"gap_items":[{"action":"需申办者提供项目组织架构图及角色职责矩阵，明确申办者、研究者、监查员、DMC、数据管理、统计、中心药房等角色的权限与汇报关系","category":"source_missing","gap_id":"gap_role_responsibility","missing_source_classes":["项目组织架构图","角色职责矩阵"],"target":"各角色具体职责边界与汇报线"},{"action":"需申办者监查计划明确各阶段监查频率、核查重点及偏离处理流程","category":"source_missing","gap_id":"gap_monitoring_plan","missing_source_classes":["监查计划"],"target":"监查频率、范围与核查内容"},{"action":"需DMC章程明确审查时点、安全性信号触发标准及向申办者建议的路径","category":"source_missing","gap_id":"gap_dmc_charter","missing_source_classes":["DMC章程"],"target":"DMC审查频率、触发条件与建议流程"}],"heading":"关键角色和研究管理","missing_source_classes":["项目组织架构图","角色职责矩阵","监查计划","DMC章程"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂平行对照II期概念验证研究，涉及申办者、研究中心主要研究者、研究协调员、监查员、独立数据安全监查委员会（DMC）、数据管理部门、统计部门及中心药房等多方角色。申办者负责研究整体设计、方案制定、试验药物供应与质控、监查与稽查、数据管理与统计分析、安全性报告及监管沟通。各研究中心主要研究者对受试者安全、知情同意、方案依从性及数据真实性承担最终责任，负责识别和报告方案偏离及不良事件。研究协调员协助受试者管理、电子日记培训与依从性监测、访视安排及原始文件维护。监查员按申办者监查计划对研究中心进行定期核查，确认数据完整性、方案依从性和药物管理合规性。DMC作为独立安全监督机构，在研究期间定期审查累积安全性数据，对可能影响受试者安全或研究继续进行的重大事件向申办者提出建议。数据管理部门负责电子数据采集系统的配置、数据清理与质疑管理；统计部门负责统计分析计划的制定与执行，包括主要终点MMRM分析及关键次要终点Holm递阶多重性控制。中心药房负责试验药物与安慰剂的接收、储存、分发及回收，确保双盲条件下药物外观一致且由不参与评估的药师发放。各角色的具体职责边界、汇报线、权限及培训要求由申办者项目执行计划及研究中心启动文件进一步细化。","rationale":"本段依据已确认研究事实中多中心设计、DMC设置、双盲安慰剂对照、中心药房发放、电子日记、MMRM与Holm统计方法、234例样本量等要素描述角色框架。各角色具体职责分工、汇报线和权限边界缺少项目组织架构图或角色职责矩阵，已列入gap_items。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_60aa08d5ccf9_7fa11cbbec754d96","section_number":"12.5","source_id