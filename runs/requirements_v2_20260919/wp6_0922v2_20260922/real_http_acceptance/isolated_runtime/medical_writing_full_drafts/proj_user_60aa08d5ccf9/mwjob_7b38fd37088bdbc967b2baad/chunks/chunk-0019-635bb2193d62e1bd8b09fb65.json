udy_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"多中心、随机、双盲、安慰剂平行对照II期概念验证研究；受试者1:1随机至KZ-MD601组或安慰剂组，双盲治疗期24周","quote_sha256":"6174cb0e318d7fc1b09a6202a37bb6cbe7ea31c510c9ae9b2c2bba8ae2ad9173","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_04"}],"evidence_review_advisories":[],"evidence_span_ids":["es_01","es_03","es_04"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":1},"gap_items":[{"action":"需项目监查计划明确现场监查与远程监查的适用条件、频率及报告模板","category":"source_missing","gap_id":"gap_12_01","missing_source_classes":["项目级监查计划"],"target":"本章节总体框架中监查频率与方式"},{"action":"需项目稽查计划明确稽查范围、频率、触发条件及监管核查应对流程","category":"source_missing","gap_id":"gap_12_02","missing_source_classes":["项目级稽查计划","核查应对预案"],"target":"本章节总体框架中稽查触发与核查应对"}],"heading":"研究文件、监查和管理","missing_source_classes":["项目级监查计划","项目级稽查计划","核查应对预案"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂平行对照II期概念验证研究，涉及多个研究中心的协调管理与数据质量控制。研究方案及其修订版本、研究者手册、知情同意书、病例报告表、监查报告、稽查报告及监管往来函件等构成研究文件体系，所有文件归申办方所有，仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构进行审阅；在未得到申办方书面批准的情况下，除在与可能参加本研究的受试者签署知情同意书时向其做必要解释外，严禁将任何信息告知与本研究无关的第三方。研究期间产生的源文件不得被清除或销毁，研究者和研究中心须允许申办方因研究相关的监查、申办者稽查和伦理委员会审查而直接访问源文件和报告，并允许监管当局对源数据与源文件进行检查。本章节涵盖研究文件管理、方案依从、监查及稽查核查的总体框架，各子章节分别规定具体操作要求。","rationale":"多中心双盲设计事实来自当前项目研究定义；文件保密与分发限制、源文件保存与访问权限的表述参照公司语料中监管共性条款（MY004567片方案摘要、CMD-D001-AD方案），仅借用结构框架，未继承竞品项目事实。本章节作为父级概述，具体监查频率、稽查触发条件及核查应对流程缺少项目级文件支持，已列入gap_items。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_60aa08d5ccf9_c0ca8754a050f262","section_number":"12","source_ids":["protocol_full_draft_selection:635bb2193d62e1bd8b09fb65","current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8","company_corpus:cms_cn_protocol_corpus_20260715_v1:bc1113fc7a275b","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261010000058_a25303ba","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:12.2 方案偏离|block:950|chunk:1","quote":"研究方案中规定的所有要求，必须严格执行。任何有意或无意偏离或违背研究方案和GCP原则的行为，均视为偏离方案或违背方案。监查员在监查过程中，如果发现偏离或违背方案，应由研究者或监查员填写偏离方案记录，详细记录事件发生的时间及过程、原因及相应的处理措施，由研究者签字，并根据研究中心相关规定通报伦理委员会及申办者。其中，所有可能严重违背方案的情况都必须马上报给申办者。当发生重大方案违背时，应由研究者和申办者进行评估。必要时，申办者可以提前终止本研究。","quote_sha256":"4ad13e82fb4d9748aa0fff1e399c95e53a8a8dd52e482eea1f8ff37b51605465","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8","span_id":"es_02"}],"evidence_review_advisories":[],"evidence_span_ids":["es_02"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":0},"gap_items":[{"action":"需项目质量管理文件明确偏离分级定义及对应处理流程","category":"source_missing","gap_id":"gap_12_1_01","missing_source_classes":["项目级方案偏离分级标准"],"target":"方案偏离分级标准（轻微/重大/严重）"},{"action":"需项目文件明确一般偏离与严重违背的报告时限及通报对象","category":"source_missing","gap_id":"gap_12_1_02","missing_source_classes":["项目级方案偏离报告时限规定"],"target":"方案偏离报告时限"}],"heading":"研究方案的依从","missing_source_classes":["项目级方案偏离分级标准","项目级方案偏离报告时限规定","伦理委员会通报路径文件"],"proposal_text":"研究方案中规定的所有要求，必须严格执行。任何有意或无意偏离或违背研究方案和药物临床试验质量管理规范原则的行为，均视为偏离方案或违背方案。监查员在监查过程中，如果发现偏离或违背方案，应由研究者或监查员填写偏离方案记录，详细记录事件发生的时间及过程、原因及相应的处理措施，由研究者签字，并根据研究中心相关规定通报伦理委员会及申办者。所有可能严重违背方案的情况都必须马上报给申办者。当发生重大方案违背时，应由研究者和申办者进行评估；必要时，申办者可以提前终止本研究。本研究的方案偏离分级标准、报告时限、伦理委员会通报路径及重大方案违背的判定准则，以项目质量管理文件及伦理委员会要求为准。","rationale":"方案偏离定义、记录、报告及重大违背评估流程的表述参照公司语料中CMD-D001-AD方案第12.2节，属于监管共性结构条款，未继承该竞品项目的具体药物、人群或剂量信息。本项目的方案偏离分级阈值、报告时限（如24小时或48小时）及伦理通报具体路径缺少项目级文件，已列入gap_items。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_60aa08d5ccf9_046116791fa953f9","section_number":"12.1","source_ids":["protocol_full_draft_selection:635bb2193d62e1bd8b09fb65","current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff57