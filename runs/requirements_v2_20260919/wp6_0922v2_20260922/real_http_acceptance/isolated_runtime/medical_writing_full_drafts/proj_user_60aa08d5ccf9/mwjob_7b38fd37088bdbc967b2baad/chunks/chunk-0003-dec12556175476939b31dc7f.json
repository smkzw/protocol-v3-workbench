span_ids":["es_001","es_005"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[],"heading":"次要目的和次要终点","missing_source_classes":[],"proposal_text":"本研究的次要目的为评估KZ-MD601对梅尼埃病多维度疾病负担的影响，包括眩晕发作的时间特征、听力功能变化、耳鸣及眩晕相关生活质量改善，以及救援药物使用需求。与上述次要目的对应的关键次要终点如下：（1）至首次发作性眩晕事件的时间；（2）纯音听阈（PTA）较基线的变化；（3）耳鸣Handicap量表（THI）评分较基线的变化；（4）眩晕障碍量表（DHI）评分较基线的变化；（5）救援药物使用频次。上述终点均与安慰剂组进行比较。PTA、THI和DHI的采集时点与访视安排详见研究流程图，具体评价窗口为±5天。","rationale":"关键次要终点清单直接来源于项目研究定义中关键次要终点字段，五项终点名称与项目已确认事实一致。PTA、THI、DHI的采集时点需医学经理确认是否仅在V2-V4访视实施，以及THI和DHI量表版本与版权授权状态。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_60aa08d5ccf9_557f5229331a9e9c","section_number":"3.2","source_ids":["protocol_full_draft_selection:dec12556175476939b31dc7f","current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7"]},{"ai_run_id":"airun_20261009230655_d3207544","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"恢复本章节正文与当前项目来源的证据绑定后重新核对。","category":"mapping_failed","gap_id":"gap:evidence-binding","missing_source_classes":[],"target":"mwsec_greenfield_proj_user_60aa08d5ccf9_8a20b985ba42ab2b"}],"heading":"探索性目的和探索性终点","missing_source_classes":["支持本章节正文的当前项目直接来源"],"proposal_text":"","rationale":"本次输出未能把正文绑定到有效证据；需补充或重新绑定支持本章节的当前项目直接来源。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_60aa08d5ccf9_8a20b985ba42ab2b","section_number":"3.3","source_ids":["protocol_full_draft_selection:dec12556175476939b31dc7f","current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7"]},{"ai_run_id":"airun_20261009230655_d3207544","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"总体研究设计：多中心、随机、双盲、安慰剂平行对照II期概念验证研究；受试者1:1随机至KZ-MD601组或安慰剂组，双盲治疗期24周，以发作性眩晕月均频次较基线变化为主要评价基础。","quote_sha256":"98e95ed8f34dee9589e8ac09b665b28c6c62a613a202f2f472d205325716653d","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_003"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"研究时期：筛选与基线期（3个月，含前瞻性电子日记）；双盲治疗期（24周）；安全性随访期（4周）","quote_sha256":"4cdb546aace591d03ad6d290d9fa1df3fc960c917f00e25e6bc78372d68104d6","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_004"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"访视策略：基线期日记培训（V0）、随机（V1）、治疗期第8/16/24周（V2-V4，含纯音听阈与前庭评估）、安全性随访（V5）；电子日记每日填写，评估窗口±5天。","quote_sha256":"8e43c1dc4bf27a721750f215e8883db85c8ad52765a60dac80043bda6578bbed","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_005"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"DMC是否计划：是","quote_sha256":"9967a9a75297ced2326ab733fa3b16934acdef641fa765dd50c1cd58219f4aa5","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_006"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"估计目标策略：治疗策略估计目标：无论是否使用救援药物或调整倍他司汀背景，均按随机分组分析第9-24周确认发作月均频次较基线变化；提前退出者按观察期归一化并采用混合模型处理。","quote_sha256":"bf86019fe9bfece8d2dfaad8d97c24ec3ee49073ee2fbaa7bc01b009c3998eba","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_008"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"统计分析策略：FAS主分析集，PPS敏感性；主要终点采用MMRM（或负二项敏感性分析）比较两组第9-24周发作月均频次较基线变化，双侧α=0.05；关键次要终点按Holm递阶控制多重性；安全性描述汇总。","quote_sha256":"5122255db572bda493798da4c1d093c618c860ddfbef7cbf1b5db74a0d7711f0","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_009"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"安慰剂平行对照1:1随机；分层：单侧vs双侧患病、基线3个月眩晕频次（2-4次/月 vs ≥5次/月）、倍他司汀背景使用；安慰剂外观与KZ-MD601一致由不参与评估药师发放。","quote_sha256":"3373fdda93012f9797cb2cc1a1e26d7bd644302a599c1566dbabeb45533fe3ef","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_010"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"试验干预：KZ-MD601缓释片口服20 mg每日一次；双盲治疗期24周；剂量依据内部IB v1.2（§5.3 推荐剂量方案）设定；安慰剂组外观一致；急性眩晕发作按既定救援方案处理并记录。","quote_sha256":"4419bc0bcd924482801b0af9e6cc33d007129c57575f468acce5c5132c59c4c2","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_011"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"安全性终点：TEAE发生率与严重程度（CTCAE 5.0）；生命体征、12导联心电图、实验室检查较基线变化；听力与前庭功能专项评估。","quote_sha256":"3e7dbbc138fd999418628c786dea80f3e5c298d3e7206e4f4c3cdec3ede731de","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_012"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"特别关注的不良事件：抑郁/情绪改变（H3反向激动剂类风险）；肝酶升高；症状性心动过缓。","quote_sha256":"8cb8c512a735aa749fa0f397333524a8ebb1890c694162a24098ef2269ac0815","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_013"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"样本量策略：样本量假设：发作月均频次组间差1.0次、标准差SD 2.5次、双侧α=0.05、把握度80%；复算需每组99例（两组合计198例）；考虑15%脱落放大后每组117例，共234例。","quote_sha256":"ee24989ba9bfb6054e40520eb5bf207b4e61626e382152e6a08c833cb1a4c6ce","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_014"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"主要终点：治疗期第9-24周发作性眩晕月均频次较基线的变化（次/月，经电子日记与研究者确认）；评价时间：基线期3个月 vs 治疗期第9-24周；与安慰剂比较。","quote_sha256":"bf1ecf835f014289fb8dbc1f98a9d281b1d67beaa51e9a276e55a40eed4d071e","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_015"},{"locator":"document:mwdoc_greenfield_proj_user_60aa08d5ccf9_9eaec061c1b07dd7:full-draft:dec12556175476939b31dc7f","quote":"随机化；双盲；安慰剂对照；平行组；多中心；设置独立数据监查委员会（DMC）","quote_sha256":"6450935204c952de9a1386cd7302806bc0614ad879abfc9cd9bee935286169c3","source_id":"protocol_full_draft_selection:dec12556175476939b31dc7f","span_id":"es_016"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"目标研究人群：18-75岁确诊梅尼埃病患者（AAO-HNS/EUPOD标准），筛选前3个月内每月发作性眩晕≥2次且伴波动性听力证据；允许稳定倍他司汀背景治疗并分层。","quote_sha256":"76c743c7b378a96a3109f6371377ed222648cea4d6f436e7175db3e281805aa6","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_017"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"洗脱要求：入组前14天内使用庆大霉素鼓室内注射或全身使用耳毒性药物者须洗脱；倍他司汀须稳定≥4周方可入组且研究期间不调量；禁用其他试验性前庭药物。","quote_sha256":"0aae6b100254ea2e1f4a9072a2d3e9185559962513c9dab06da595ca91af180c","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_018"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"剂量与给药方案：KZ-MD601（口服选择性组胺H3受体反向激动剂缓释片）：KZ-MD601 20 mg 口服每日一次晨服（缓释片整片吞服不可掰开），连续24周；漏服当日不补服；剂量出处：内部IB v1.2 §5.3（立项剂量方案）。","quote_sha256":"853b37b6c6dc92ef3fe3c628e87afef0ec661569a3911d25a04cecc5bfaf55da","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_019"}],"evidence_review_advisories":[],"evidence_span_ids":["es_003","es_004","es_005","es_006","es_008","es_009","es_010","es_011","es_012","es_013","es_014","es_015","es_016","es_017","es_018","es_019"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":15},"gap_items":[],"heading":"研究设计","missing_source_classes":[],"proposal_text":"本研究为多中心、随机、双盲、安慰剂平行对照的II期概念验证研究，在中国开展，旨在评估口服选择性组胺H3受体反向激动剂缓释片KZ-MD601治疗梅尼埃病（反复发作性眩晕伴波动性感音神经性听力损失）的有效性与安全性，同时为后续剂量选择提供依据。研究采用首次患者试验设计，兼具概念验证与剂量探索功能。受试者按1:1比例随机分配至KZ-MD601组（20 mg口服每日一次晨服）或安慰剂组，双盲治疗期持续24周。随机化采用分层区组方法，分层因素包括：单侧与双侧患病、基线3个月眩晕频次（2至4次/月与≥5次/月）、以及倍他司汀背景使用状态。安慰剂外观与KZ-MD601缓释片一致，由不参与疗效评估的药师负责发放。研究设置独立数据监查委员会（DMC）对安全性数据进行定期审查，但不设置期中有效性分析、自适应设计或安全性审查委员会（SRC）。研究时期包括筛选与基线期（3个月，含前瞻性电子日记记录）、双盲治疗期（24周）和安全性随访期（4周）。主要评价以治疗期第9至24周发作性眩晕月均频次较基线的变化为基础，与安慰剂组比较。估计目标采用治疗策略策略，即无论是否使用救援药物或调整倍他司汀背景治疗，均按随机分组进行分析；提前退出者按观察期归一化并采用混合模型处理。统计分析以全分析集（FAS）为主分析集，符合方案集（PPS）为敏感性分析集；主要终点采用混合效应模型重复测量（MMRM）或负二项模型敏感性分析，双侧显著性水平α=0.05；关键次要终点按Holm递阶法控制多重性；安全性数据以描述性汇总呈现。样本量基于发作月均频次组间差1.0次、标准差2.5次、双侧α=0.05、把握度80%的假设，复算需每组99例（两组合计198例），考虑15%脱落率后每组纳入117例，共234例。","rationale":"研究设计全部要素（多中心、随机、双盲、安慰剂平行对照、II期、PoC、1:1随机、24周治疗期、分层因素、DMC设置、无期中分析/自适应/SRC、估计目标策略、分析集定义、统计方法、样本量）均直接来源于项目研究定义中已确认字段。DMC章程与审查频率、MMRM具体协变量结构、负二项模型适用条件等实施细节需项目文件进一步确认。","review_advisories":["本节复述高影响研究设计（研究设计）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（α、主要终点、估计目标、剂量选择、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_60aa08d5ccf9_4ba5b593d87ed93a","section_number":"4","source_ids":["protocol_full_draft_selection:dec12556175476939b31dc7f","current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7"]},{"ai_run_id":"airun_20261009230655_d3207544","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"总体研究设计：多中心、随机、双盲、安慰剂平行对照II期概念验证研究；受试者1:1随机至KZ-MD601组或安慰剂组，双盲治疗期24周，以发作性眩晕月均频次较基线变化为主要评价基础。","quote_sha256":"98e95ed8f34dee9589e8ac09b665b28c6c62a613a202f2f472d205325716653d","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_003"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"研究时期：筛选与基线期（3个月，含前瞻性电子日记）；双盲治疗期（24周）；安全性随访期（4周）","quote_sha256":"4cdb546aace591d03ad6d290d9fa1df3fc960c917f00e25e6bc78372d68104d6","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_004"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"访视策略：基线期日记培训（V0）、随机（V1）、治疗期第8/16/24周（V2-V4，含纯音听阈与前庭评估）、安全性随访（V5）；电子日记每日填写，评估窗口±5天。","quote_sha256":"8e43c1dc4bf27a721750f215e8883db85c8ad52765a60dac80043bda6578bbed","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_005"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"DMC是否计划：是","quote_sha256":"9967a9a75297ced2326ab733fa3b16934acdef641fa765dd50c1cd58219f4aa5","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_006"},{"locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","quote":"安慰剂平行对照1:1随机；分层：单侧vs双侧患病、基线3个月眩晕频次（2-4次/月 vs ≥5次/月）、倍他司汀背景使用；安慰剂外观与KZ-MD601一致由不参与评估药师发放。","quote_sha256":"3373fdda93012f9797cb2cc1a1e26d7bd644302a599c1566dbabeb45533fe3ef","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","span_id":"es_010"},{"locator":"document:mwdoc_greenfield_proj_user_60aa08d5ccf9_9eaec061c1b07dd7:full-draft:dec12556175476939b31dc7f","quote":"随机化；双盲；安慰剂对照；平行组；多中心；设置独立数据监查委员会（DMC）","quote_sha256":"6450935204c952de9a1386cd7302806bc0614ad879abfc9cd9bee935286169c3","source_id":"protocol_full_draft_selection:dec12556175476939b31dc7f","span_id":"es_016"}],"evidence_review_advisories":[],"evidence_span_ids":["es_003","es_004","es_005","es_006","es_010","es_016"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[],"heading":"总体设计","missing_source_classes":[],"proposal_text":"本研究总体设计为多中心、随机、双盲、安慰剂平行对照的II期概念验证研究，设置独立数据监查委员会（DMC）。研究在中国境内多中心开展，采用1:1随机分配，受试者进入KZ-MD601组或安慰剂组。双盲治疗期持续24周，以发作性眩晕月均频次较基线变化为主要评价基础。研究时期依次为筛选与基线期（3个月，含前瞻性电子日记）、双盲治疗期（24周）和安全性随访期（4周）。访视安排包括：V0基线期日记培训、V1随机化访视、V2至V4治疗期第8周/第16周/第24周访视（含纯音听阈与前庭功能评估）、V5安全性随访访视；电子日记由受试者每日填写，各访视评估窗口为±5天。随机化采用分层区组方法，分层因素为单侧与双侧患病、基线3个月眩晕频次（2至4次/月与≥5次/月）及倍他司汀背景使用。安慰剂外观与KZ-MD601缓释片一致，由不参与评估的药师发放。本研究不设置期中有效性分析、自适应设计或安全性审查委员会（SRC）。","rationale":"总体设计框架（随机化、双盲、安慰剂对照、平行组、多中心、DMC）来源于项目研究定义及章节包中已确认的设计标签。研究时期、访视策略、分层因素、安慰剂发放方式及无期中分析/自适应/SRC等要素均直接来源于项目研究定义。各访视是否均包含实验室检查、心电图和生命体征采集未在来源中明确，不得由访视策略推断为所有访视均实施全部安全性检查。","review_advisories":["本节复述高影响研究设计（总体设计）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_60aa08d5ccf9_974362baf85b6707","section_number":"4.1","source_ids":["protocol_full_draft_selection:dec12556175476939b31dc7f","current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7"]}],"source_bindings":[{"content_sha256":"5780ecfb9fe2cfefc7d76651922249c43dad4e818bdcef0ae27dac7976bf4b8d","locator":"document:mwdoc_greenfield_proj_user_60aa08d5ccf9_9eaec061c1b07dd7:full-draft:dec12556175476939b31dc7f","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:dec12556175476939b31dc7f","source_type":"protocol_full_draft_selection","source_version":"full-draft:861172e6b952fc5c2a078ace1a9f91473d8b46589dafe35c80c75521bdc04d58:dec12556175476939b31dc7f","text_sha256":"5780ecfb9fe2cfefc7d76651922249c43dad4e818bdcef0ae27dac7976bf4b8d"},{"content_sha256":"aac7656795aa239d613ae05aa9d631e7ef9d76a69f15468f6ed0b7692b2c4392","locator":"study_definition:mwdefinition_8f0bceaab777ef645d88:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","source_type":"current_project_study_definition","source_version":"mwdefinition_8f0bceaab777ef645d88:r4:cbb1bfff5749c317","text_sha256":"aac7656795aa239d613ae05aa9d631e7ef9d76a69f15468f6ed0b7692b2c4392"},{"content_sha256":"d201ce569054cbbf7236ebc38a81549ab6777a6cd5f2fedc31a501f7bd4655a7","locator":"section:6.3.3 揭盲|block:488|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","source_type":"company_protocol_reference_corpus","source_version":"46d82ed9e2e3ef","text_sha256":"d201ce569054cbbf7236ebc38a81549ab6777a6cd5f2fedc31a501f7bd4655a7"},{"content_sha256":"2a6939e28805b7316a6881a03b7effe8a21e0d13733b8c1592fa1004ecf0b24f","locator":"section:9.2 统计分析数据集|block:859|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","source_type":"company_protocol_reference_corpus","source_version":"3809927f2ae07b","text_sha256":"2a6939e28805b7316a6881a03b7effe8a21e0d13733b8c1592fa1004ecf0b24f"},{"content_sha256":"a081fa03f5ce0ceb2ca2444ea6b2a850997611938884f75fa4f6b5e188b3af68","locator":"section:7.3.1 病例报告表的设计|block:1037|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","source_type":"company_protocol_reference_corpus","source_version":"a5f4a227d6404a","text_sha256":"a081fa03f5ce0ceb2ca2444ea6b2a850997611938884f75fa4f6b5e188b3af68"},{"content_sha256":"288c4151aa03e0bb0feffeb19ae4b67d399ea214ab90d8f02d3dd67800bdd070","locator":"section:统计分析单位签字页|block:57|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","source_type":"company_protocol_reference_corpus","source_version":"abb423601f76d0","text_sha256":"288c4151aa03e0bb0feffeb19ae4b67d399ea214ab90d8f02d3dd67800bdd070"},{"content_sha256":"a635fe9c51c78cbc66090c3553c488cd453e807e61608a97e0767740d5088a03","locator":"section:8 统计学考虑|block:1056|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","source_type":"company_protocol_reference_corpus","source_version":"a3cf98aab983c7","text_sha256":"a635fe9c51c78cbc66090c3553c488cd453e807e61608a97e0767740d5088a03"}]}