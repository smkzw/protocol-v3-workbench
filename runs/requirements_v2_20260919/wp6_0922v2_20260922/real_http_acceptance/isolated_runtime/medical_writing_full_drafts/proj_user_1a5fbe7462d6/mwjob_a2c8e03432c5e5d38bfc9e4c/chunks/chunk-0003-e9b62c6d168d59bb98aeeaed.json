:r4:ead0c1d8f19b0cb6","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca"]},{"ai_run_id":"airun_20261004035808_6d1166a5","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","quote":"随机、双盲、双模拟、三臂1:1:1对照研究（ZB-4107 50mg qd / 坦索罗辛0.2mg qd / 安慰剂），12周双盲主治疗期+40周安全延长期","quote_sha256":"1f5a27222dd7cd6bc76f132c21046cdd45ca11cb220ab1e5e152931289ad8339","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","span_id":"es1"},{"locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","quote":"主要终点：第12周IPSS总分较基线的变化。评价时点：基线、第4、8、12周。","quote_sha256":"60a2d5000271f0f6e3ad63d70785fa71b40a824153c7d859f53ea9111f4073c2","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","span_id":"es2"},{"locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","quote":"关键次要终点：第12周Qmax较基线变化；第12周PVR较基线变化；第12周夜尿次数较基线变化；第12周IPSS-QoL较基线变化","quote_sha256":"71c985be84b3e02c025b12bef9d5174c401d8886f4ad4b6daa40f21281177d44","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","span_id":"es3"},{"locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","quote":"安全性终点：治疗期不良事件、严重不良事件；坐位血压和心率变化；急性尿潴留；尿路感染；因AE停药。","quote_sha256":"37093d37a7db3429cd2cf0c2dbc98db4c1423bdc7e25c3eafb4057df626b7d33","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","span_id":"es4"},{"locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","quote":"主要终点采用协方差分析（ANCOVA），协变量含基线IPSS与中心；多重性按层级检验主要终点后再检验关键次要终点。","quote_sha256":"dfd3bd32adb7cb706390c974ea67336f517f857026ffd447950037b921e4b2d9","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","span_id":"es5"},{"locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","quote":"DMC是否计划：是","quote_sha256":"9967a9a75297ced2326ab733fa3b16934acdef641fa765dd50c1cd58219f4aa5","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","span_id":"es6"},{"locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","quote":"研究时期：筛选期（最长4周）；12周双盲主治疗期；40周双盲双模拟安全延长期；随访期（末次给药后4周）","quote_sha256":"b1de2ae8fb796990467e6ec879b99112188687b67d9978fb38c2972caebd4e5c","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","span_id":"es7"}],"evidence_review_advisories":[],"evidence_span_ids":["es1","es2","es3","es4","es5","es6","es7"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":7},"gap_items":[],"heading":"研究设计","missing_source_classes":[],"proposal_text":"本研究为随机、双盲、双模拟、三臂平行组、多中心、设置独立数据监查委员会的III期确证性临床研究，同时包含长期延展性研究阶段。研究药物为口服选择性β3肾上腺素受体激动剂R1D-W2-BPH-ZB4107（ZB-4107），适应症为良性前列腺增生伴中重度下尿路症状。受试者按1:1:1比例随机分配至ZB-4107 50mg每日一次组、坦索罗辛0.2mg每日一次组（阳性对照）或安慰剂组，采用双盲双模拟给药方式。研究时期依次为筛选期（最长4周）、12周双盲主治疗期、40周双盲双模拟安全延长期及末次给药后4周随访期。主要疗效终点为第12周国际前列腺症状评分总分较基线的变化，评价时点为基线、第4周、第8周和第12周。关键次要终点包括第12周最大尿流率、残余尿量、夜尿次数及IPSS生活质量评分较基线的变化。安全性评价涵盖治疗期不良事件与严重不良事件、坐位血压和心率变化、急性尿潴留、尿路感染及因不良事件停药。主要终点采用协方差分析，协变量包括基线国际前列腺症状评分与研究中心；多重性按层级检验策略，先检验主要终点再检验关键次要终点。分析集以全分析集和符合方案集为主。本研究不计划期中分析、自适应设计、样本量再估计或安全审查委员会，但设置独立数据监查委员会对研究进行安全性与有效性监查。","rationale":"本章正文依据当前项目已确认研究事实中的总体研究设计、研究时期、主要与关键次要终点、安全性终点、统计分析策略及DMC设置等条目直接撰写。医学经理需核实：（1）40周安全延长期是否确为双盲双模拟且给药方案不变；（2）随访期具体评估内容；（3）ANCOVA协变量是否仅限基线IPSS与中心；（4）层级检验的具体顺序与α分配。","review_advisories":["本节复述高影响研究设计（研究设计）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、期中分析、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_1a5fbe7462d6_e77769fb6b9be2a2","section_number":"4","source_ids":["protocol_full_draft_selection:e9b62c6d168d59bb98aeeaed","current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca"]},{"ai_run_id":"airun_20261004035808_6d1166a5","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","quote":"随机、双盲、双模拟、三臂1:1:1对照研究（ZB-4107 50mg qd / 坦索罗辛0.2mg qd / 安慰剂），12周双盲主治疗期+40周安全延长期","quote_sha256":"1f5a27222dd7cd6bc76f132c21046cdd45ca11cb220ab1e5e152931289ad8339","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","span_id":"es1"},{"locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","quote":"DMC是否计划：是","quote_sha256":"9967a9a75297ced2326ab733fa3b16934acdef641fa765dd50c1cd58219f4aa5","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","span_id":"es6"}],"evidence_review_advisories":[],"evidence_span_ids":["es1","es6"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[],"heading":"总体设计","missing_source_classes":[],"proposal_text":"本研究采用随机、双盲、双模拟、三臂平行组、多中心设计，设置独立数据监查委员会。随机化比例为1:1:1，受试者被分配至ZB-4107 50mg每日一次组、坦索罗辛0.2mg每日一次组或安慰剂组。双盲通过双模拟技术实现：ZB-4107组受试者服用ZB-4107活性制剂及坦索罗辛安慰剂，坦索罗辛组服用坦索罗辛活性制剂及ZB-4107安慰剂，安慰剂组服用两种安慰剂，使三组受试者外观与给药方案一致。研究为多中心开展，具体中心数量与名单在方案附件中列明。独立数据监查委员会负责定期审阅安全性与有效性数据，本研究不设置期中分析、自适应设计、样本量再估计或安全审查委员会。","rationale":"本章依据已确认的总体设计要素（随机、双盲、双模拟、三臂1:1:1、平行组、多中心、DMC）及不计划期中分析/自适应/样本量再估计/SRC的条目撰写。双模拟的具体实现方式（三组各服用两种制剂）系从双盲双模拟及三臂设计推断，需医学经理确认双模拟制剂的具体匹配方案。多中心具体数量与名单未在当前研究事实中给出。","review_advisories":["本节复述高影响研究设计（总体设计）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（期中分析、样本量）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_1a5fbe7462d6_c1c748fd177c1fbb","section_number":"4.1","source_ids":["protocol_full_draft_selection:e9b62c6d168d59bb98aeeaed","current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca"]},{"ai_run_id":"airun_20261004035808_6d1166a5","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","quote":"主要终点：第12周IPSS总分较基线的变化。评价时点：基线、第4、8、12周。","quote_sha256":"60a2d5000271f0f6e3ad63d70785fa71b40a824153c7d859f53ea9111f4073c2","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","span_id":"es2"},{"locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","quote":"关键次要终点：第12周Qmax较基线变化；第12周PVR较基线变化；第12周夜尿次数较基线变化；第12周IPSS-QoL较基线变化","quote_sha256":"71c985be84b3e02c025b12bef9d5174c401d8886f4ad4b6daa40f21281177d44","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","span_id":"es3"},{"locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","quote":"安全性终点：治疗期不良事件、严重不良事件；坐位血压和心率变化；急性尿潴留；尿路感染；因AE停药。","quote_sha256":"37093d37a7db3429cd2cf0c2dbc98db4c1423bdc7e25c3eafb4057df626b7d33","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","span_id":"es4"},{"locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","quote":"主要终点采用协方差分析（ANCOVA），协变量含基线IPSS与中心；多重性按层级检验主要终点后再检验关键次要终点。","quote_sha256":"dfd3bd32adb7cb706390c974ea67336f517f857026ffd447950037b921e4b2d9","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","span_id":"es5"}],"evidence_review_advisories":[],"evidence_span_ids":["es2","es3","es4","es5"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[],"heading":"确证性设计与假设依据","missing_source_classes":[],"proposal_text":"本研究为确证性III期临床研究，旨在评价口服选择性β3肾上腺素受体激动剂ZB-4107 50mg每日一次治疗良性前列腺增生伴中重度下尿路症状的疗效与安全性。主要比较为ZB-4107相对安慰剂的优效性检验，关键次要比较包括ZB-4107相对坦索罗辛0.2mg每日一次的优效或非劣效检验。主要疗效终点为第12周国际前列腺症状评分总分较基线的变化，采用协方差分析，以基线国际前列腺症状评分和研究中心为协变量。多重性控制采用层级检验策略：首先检验主要终点（ZB-4107对比安慰剂），通过后依次检验关键次要终点。关键次要终点包括第12周最大尿流率、残余尿量、夜尿次数及IPSS生活质量评分较基线的变化。安全性以安全集进行描述性分析，重点关注坐位血压和心率变化、急性尿潴留、尿路感染及因不良事件停药。分析集以全分析集和符合方案集为主。主要估计目标为比较ZB-4107 50mg每日一次与安慰剂在第12周国际前列腺症状评分总分较基线变化上的差异。","rationale":"本章依据已确认的内在研究目的（确证性研究）、主要与关键次要终点、估计目标策略、统计分析策略及安全性分析描述撰写。医学经理需核实：（1）层级检验中各关键次要终点的具体检验顺序；（2）非劣效界值（若适用）；（3）ANCOVA中是否需纳入其他协变量；（4）安全集定义与安全性分析的具体描述性方法。","review_advisories":["本节复述高影响研究设计（确证性设计与假设依据）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、估计目标）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_1a5fbe7462d6_0c8a40fd5125f460","section_number":"4.2.1","source_ids":["protocol_full_draft_selection:e9b62c6d168d59bb98aeeaed","current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca"]}],"source_bindings":[{"content_sha256":"48d11a670b256ac1737aadfbf3dbd6459c990b29abafd6a07b526ceb0a2434eb","locator":"document:mwdoc_greenfield_proj_user_1a5fbe7462d6_9eb304f2127c4d93:full-draft:e9b62c6d168d59bb98aeeaed","role":"current_working_draft_packet","source_id":"protocol_