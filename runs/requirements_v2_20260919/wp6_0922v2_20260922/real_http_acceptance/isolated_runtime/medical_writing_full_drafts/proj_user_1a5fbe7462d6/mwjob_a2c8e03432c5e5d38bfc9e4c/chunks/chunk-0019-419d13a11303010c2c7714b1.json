tocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","source_type":"company_protocol_reference_corpus","source_version":"544d5795fdc791","text_sha256":"9d5bb308153441df0cf0a282e48e71b5918f97f81ec06babdf8e969557541291"},{"content_sha256":"ce0d2dfe125632cc5d7e00e964022f9cd73382987f5a821bb4cc70694b086ad9","locator":"section:统计分析单位签字页|block:56|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","source_type":"company_protocol_reference_corpus","source_version":"21fb7445eed9f6","text_sha256":"ce0d2dfe125632cc5d7e00e964022f9cd73382987f5a821bb4cc70694b086ad9"},{"content_sha256":"dfc9fceb41db9d941df0e3715483adaa069da4f1953600a6a37a56d7f81373dd","locator":"section:文档开头|block:4|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","source_type":"company_protocol_reference_corpus","source_version":"342cfc57d67b67","text_sha256":"dfc9fceb41db9d941df0e3715483adaa069da4f1953600a6a37a56d7f81373dd"}]}