ion_number":"2.3.2","source_ids":["protocol_full_draft_selection:e958d28af0ce804ae6fc0cec","current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:367cbc36976ba5","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","company_corpus:cms_cn_protocol_corpus_20260715_v1:1f3f6b81aae8ee","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca"]},{"ai_run_id":"airun_20261004034616_bfffbb74","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","quote":"内在研究目的：确证性研究；长期延展性研究（OLE）；评价ZB-4107 50mg qd治疗BPH伴中重度LUTS的疗效与安全性，主要终点为第12周IPSS总分较基线变化","quote_sha256":"4ce89ca2ee03b6262fa9473deffc2ac9522af155fa6541373b9a7531fb454fcf","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","span_id":"es1"},{"locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","quote":"总体研究设计：随机、双盲、双模拟、三臂1:1:1对照研究（ZB-4107 50mg qd / 坦索罗辛0.2mg qd / 安慰剂），12周双盲主治疗期+40周安全延长期","quote_sha256":"acdb279ece30bfd80ad7656e943d5caed63f431501b54e3a682336af70bbd377","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","span_id":"es2"},{"locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","quote":"主要终点：第12周IPSS总分较基线的变化。评价时点：基线、第4、8、12周。","quote_sha256":"60a2d5000271f0f6e3ad63d70785fa71b40a824153c7d859f53ea9111f4073c2","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","span_id":"es3"},{"locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","quote":"关键次要终点：第12周Qmax较基线变化；第12周PVR较基线变化；第12周夜尿次数较基线变化；第12周IPSS-QoL较基线变化","quote_sha256":"71c985be84b3e02c025b12bef9d5174c401d8886f4ad4b6daa40f21281177d44","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","span_id":"es4"},{"locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","quote":"安全性终点：治疗期不良事件、严重不良事件；坐位血压和心率变化；急性尿潴留；尿路感染；因AE停药。","quote_sha256":"37093d37a7db3429cd2cf0c2dbc98db4c1423bdc7e25c3eafb4057df626b7d33","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","span_id":"es5"},{"locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","quote":"统计分析策略：主要终点采用协方差分析（ANCOVA），协变量含基线IPSS与中心；多重性按层级检验主要终点后再检验关键次要终点。安全性以安全集描述性分析血压、心率、急性尿潴留和尿路感染。","quote_sha256":"ae7edcce7581dae776a84d50d3fb73947dc6976f3e3d43d406e6df9a36e0fedc","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","span_id":"es6"}],"evidence_review_advisories":[],"evidence_span_ids":["es1","es2","es3","es4","es5","es6"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[],"heading":"研究目的和终点","missing_source_classes":[],"proposal_text":"本研究为确证性III期临床研究，旨在评价口服选择性β3肾上腺素受体激动剂ZB-4107 50mg每日一次治疗良性前列腺增生伴中重度下尿路症状的疗效与安全性，并设置40周双盲双模拟安全延长期以进一步观察长期安全性。研究采用随机、双盲、双模拟、三臂1:1:1平行对照设计，试验组为ZB-4107 50mg每日一次，阳性对照组为坦索罗辛0.2mg每日一次，安慰剂对照组为匹配安慰剂，主要比较ZB-4107相对安慰剂的优效性，关键次要比较ZB-4107相对坦索罗辛的优效性或非劣效性。主要疗效终点为第12周国际前列腺症状评分（IPSS）总分较基线的变化，评价时点为基线、第4周、第8周和第12周。关键次要疗效终点包括第12周最大尿流率（Qmax）较基线变化、第12周残余尿量（PVR）较基线变化、第12周夜尿次数较基线变化以及第12周IPSS生活质量评分（IPSS-QoL）较基线变化。安全性评价涵盖治疗期不良事件和严重不良事件的发生情况、坐位血压和心率较基线变化、急性尿潴留、尿路感染以及因不良事件停药等指标。主要终点统计分析采用协方差分析（ANCOVA），以基线IPSS和中心为协变量，多重性检验按层级策略先检验主要终点再检验关键次要终点。","rationale":"研究目的、设计框架、主要终点（IPSS及基线/第4/8/12周时点）、四项关键次要终点（Qmax、PVR、夜尿次数、IPSS-QoL）、安全性终点类别、ANCOVA统计方法及层级多重性策略均由项目已确认研究事实直接支持。需医学经理确认：（1）OLE是否作为独立研究目的陈述；（2）坐位血压和心率变化归类为正式次要终点还是安全性描述性指标；（3）相对坦索罗辛的比较假设为优效还是非劣或两者兼有。","review_advisories":["本节复述高影响研究设计（研究目的和终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_1a5fbe7462d6_b0832983fb408434","section_number":"3","source_ids":["protocol_full_draft_selec