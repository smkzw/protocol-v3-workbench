},"gap_items":[{"action":"由统计师在SAP或随机化方案中确定后回填","category":"source_missing","gap_id":"gap_rand_01","missing_source_classes":["SAP","随机化方案"],"target":"随机化具体方法（区组大小、分层因素、随机化算法）"},{"action":"确认是否采用中央交互式网络应答系统（IWRS）及具体供应商","category":"source_missing","gap_id":"gap_rand_02","missing_source_classes":["IWRS操作手册","随机化方案"],"target":"随机化执行主体与系统"}],"heading":"随机化","missing_source_classes":["随机化操作方案","统计分析报告计划（SAP）中随机化方法描述"],"proposal_text":"本研究为多中心、平行组、随机、双盲、双模拟、三臂对照设计。符合入选标准的受试者按1:1:1的比例随机分配至ZB-4107 50mg每日一次组、坦索罗辛0.2mg每日一次组或安慰剂组。随机化在受试者完成筛选期评估并确认符合全部入选与排除标准后、首次给药前完成。随机化分配的具体区组大小、分层因素及随机化算法由统计师在随机化方案中确定，不在本方案正文中列明。","rationale":"三臂1:1:1、平行组、多中心、双盲双模拟为已确认研究设计事实。中央随机化、区组大小、分层因素等实施细节需医学经理与统计师确认后补充。","review_advisories":["本节复述高影响研究设计（随机化）；请在合并设计摘要中统一核对。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_1a5fbe7462d6_8ab8f40c22380915","section_number":"4.3","source_ids":["protocol_full_draft_selection:49f0c9b2a0538d7f1d0f0fd5","current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6"]},{"ai_run_id":"airun_20261004040341_e3905d92","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","quote":"双盲双模拟给药。受试者按1:1:1随机分配至ZB-4107、坦索罗辛或安慰剂。","quote_sha256":"6c05cda08ede976f03de5da832004772dac82d1fc6f2f0614ff922f4a6e582c4","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","span_id":"es_03"}],"evidence_review_advisories":[],"evidence_span_ids":["es_03"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[{"action":"由医学经理确认各角色是否设盲及盲态核查方式","category":"source_missing","gap_id":"gap_blind_01","missing_source_classes":["盲态维持方案"],"target":"受试者、研究者、评价者、DMC成员等人员的盲态范围"},{"action":"由医学经理与安全性团队制定揭盲操作规范","category":"source_missing","gap_id":"gap_blind_02","missing_source_classes":["揭盲操作规范","安全性管理计划"],"target":"紧急揭盲条件、流程、记录与报告要求"}],"heading":"盲法与揭盲","missing_source_classes":["揭盲操作规范","盲态维持与核查方案","各角色盲态范围定义"],"proposal_text":"本研究采用双盲、双模拟设计。三臂（ZB-4107 50mg每日一次、坦索罗辛0.2mg每日一次、安慰剂）之间通过双模拟实现盲态维持，即ZB-4107组受试者同时服用ZB-4107活性制剂与坦索罗辛匹配安慰剂，坦索罗辛组受试者同时服用坦索罗辛活性制剂与ZB-4107匹配安慰剂，安慰剂组受试者同时服用两种匹配安慰剂，使各组受试者每日服用相同外观与数量的制剂。随机化与盲态维持贯穿12周双盲主治疗期及40周双盲双模拟安全延长期。","rationale":"双盲、双模拟、三臂1:1:1为已确认设计事实。双模拟的具体实现方式依据三臂双模拟设计逻辑推导。受试者、研究者、评价者及其他人员的盲态范围未在来源中明确，按指令不自行指定。揭盲程序需另行制定。","review_advisories":["本节复述高影响研究设计（盲法与揭盲）；请在合并设计摘要中统一核对。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_1a5fbe7462d6_4558df67b60d6636","section_number":"4.4","source_ids":["protocol_full_draft_selection:49f0c9b2a0538d7f1d0f0fd5","current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6"]},{"ai_run_id":"airun_20261004040341_e3905d92","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"由申办方医学与统计团队确定DMC组成后写入","category":"source_missing","gap_id":"gap_dmc_01","missing_source_classes":["DMC章程"],"target":"DMC组成（成员专业背景、人数、独立主席）"},{"action":"由DMC主席与申办方协商确定","category":"source_missing","gap_id":"gap_dmc_02","missing_source_classes":["DMC章程","数据递交规范"],"target":"DMC会议频率、远程或现场形式、数据递交内容"},{"action":"由医学经理与安全性团队制定安全性监测计划","category":"source_missing","gap_id":"gap_dmc_03","missing_source_classes":["安全性监测计划","DSMB/DMC操作手册"],"target":"安全性监测具体操作（特别关注不良事件的监测阈值、报告路径、暂停或终止研究准则）"}],"heading":"安全性审评/数据监查委员会","missing_source_classes":["DMC章程","安全性监测计划","数据监查操作规范"],"proposal_text":"","rationale":"已确认DMC计划设置且无计划期中分析，但DMC组成、会议频率、章程、安全性监测操作规则、停止准则及与申办方的沟通机制在允许来源中均未给出，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_1a5fbe7462d6_ffa9b50ee695acb5","section_number":"4.5","source_ids":["protocol_full_draft_selection:49f0c9b2a0538d7f1d0f0fd5","current_project_study_de