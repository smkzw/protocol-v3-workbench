spans":0,"project_fact_spans":5},"gap_items":[{"action":"补充项目安全性管理规程或方案实施手册中AE/SAE/SUSAR定义与报告流程","category":"source_missing","gap_id":"gap_73_01","missing_source_classes":["项目安全性管理规程","方案实施手册"],"target":"不良事件和严重不良事件的定义、采集窗口、报告对象与时限"},{"action":"补充研究者手册或项目安全性管理规程中AESI判定标准","category":"source_missing","gap_id":"gap_73_02","missing_source_classes":["研究者手册","项目安全性管理规程"],"target":"特别关注不良事件（有临床意义的血压升高或心率增快）的具体判定阈值"}],"heading":"安全性评估","missing_source_classes":["项目安全性管理规程","研究者手册","AE/SAE/SUSAR定义与报告标准操作规程"],"proposal_text":"本研究安全性评估涵盖治疗期不良事件和严重不良事件的采集与报告，重点关注坐位血压和心率变化、急性尿潴留、尿路感染以及因不良事件停药。特别关注的不良事件包括急性尿潴留、有临床意义的血压升高或心率增快、症状性尿路感染。安全性数据在每次访视时采集，包括筛选访视、随机/基线访视、第4周、第8周、第12周访视及此后每8至12周安全访视至第52周，每次访视记录不良事件、急性尿潴留和尿路感染事件。安全性分析以安全集为基础，对血压、心率、急性尿潴留和尿路感染进行描述性分析。不良事件和严重不良事件的定义、采集窗口、报告对象、报告时限以及特别关注不良事件的具体判定阈值，需依据项目安全性管理规程和研究者手册确定。","rationale":"项目已确认安全性终点包含治疗期不良事件、严重不良事件、坐位血压和心率变化、急性尿潴留、尿路感染、因AE停药；特别关注不良事件为急性尿潴留、有临床意义的血压升高或心率增快、症状性尿路感染；访视策略明确每次访视记录AE/急性尿潴留/UTI；统计分析策略明确安全性以安全集描述性分析。但AE/SAE/SUSAR定义、采集报告时限、AESI具体阈值在项目来源中未给出。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_1a5fbe7462d6_fed6ac8afa5a4dfb","section_number":"7.3","source_ids":["protocol_full_draft_selection:46eb1d44352e4e86683bbffe","current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6"]},{"ai_run_id":"airun_20261004051354_28881d2a","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","quote":"每次访视测IPSS、Qmax、PVR、坐位血压和心率，记录AE/急性尿潴留/UTI。","quote_sha256":"f6895bfd3571e70a8a6c7bd74119046e86cd2b34cadaa7347019a3aa0c851913","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","span_id":"es_009"},{"locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","quote":"筛选、随机/基线、第4、8、12周（主要终点）、此后每8–12周安全访视至第52周","quote_sha256":"f01387057182911a1e88b7586e9f2bd48914ce1f5dfb32b729f77857de412174","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","span_id":"es_010"},{"locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","quote":"安全性以安全集描述性分析血压、心率、急性尿潴留和尿路感染。","quote_sha256":"ae9e3f177bda101d07101dffc5cac7cf88ceffdae9c1e7ffe7853129639b65c9","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","span_id":"es_008"}],"evidence_review_advisories":[],"evidence_span_ids":["es_009","es_010","es_008"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"补充方案实施手册中体格检查项目清单","category":"source_missing","gap_id":"gap_731_01","missing_source_classes":["方案实施手册"],"target":"体格检查具体项目清单（是否包含腹部触诊、直肠指检、外生殖器检查等）"},{"action":"补充研究中心操作手册或生命体征测量标准操作规程","category":"source_missing","gap_id":"gap_731_02","missing_source_classes":["研究中心操作手册","生命体征测量标准操作规程"],"target":"生命体征测量标准操作规程（血压测量体位、袖带规格、测量次数、心率测量方式）"},{"action":"确认访视流程中体格检查的执行频率","category":"source_missing","gap_id":"gap_731_03","missing_source_classes":["方案实施手册"],"target":"体格检查是否在所有访视均执行或仅在特定访视执行"}],"heading":"生命体征和体格检查","missing_source_classes":["方案实施手册","研究中心操作手册","生命体征测量标准操作规程"],"proposal_text":"本研究在每次访视时测量坐位血压和心率，作为安全性评估的组成部分。访视安排包括筛选访视、随机/基线访视、第4周、第8周、第12周访视，以及此后每8至12周安全访视直至第52周。坐位血压和心率的变化作为安全性终点纳入分析，以安全集进行描述性统计。体格检查的具体项目清单、生命体征测量的标准操作规程（包括血压测量体位、袖带规格、测量次数和取值方法）以及体格检查是否在所有访视均执行或仅在特定访视执行，需依据项目方案实施手册和研究中心操作手册确定。","rationale":"项目已确认每次访视测坐位血压和心率，访视策略为筛选、随机/基线、第4、8、12周及此后每8至12周安全访视至第52周；安全性终点包含坐位血压和心率变化；统计分析以安全集描述性分析血压和心率。但体格检查具体项目清单和生命体征测量方法细节在项目来源中未明确，不能从访视策略推断体格检查在每个访视均实施。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_1a5fbe7462d6_073090613ee6e548","section_number":"7.3.1","source_ids":["protocol_full_draft_selection:46eb1d44352e4e86683bbffe","current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6"]}],"source_bindings":[{"content_sha256":"3bdba8bf67c716dd190a8111ae87e4f850288fcb38a2b53d022531d7681b53d5","locator":"document:mwdoc_greenfield_proj_user_1a5fbe7462d6_9eb304f2127c4d93:full-draft:46eb1d44352e4e86683bbffe","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:46eb1d44352e4e86683bbffe","source_type":"protocol_full_draft_selection","source_version":"full-draft:fc45e3ab93ce78225e4661142ee38946c79bada2613eb28e7bf2c7bf75feb86a:46eb1d44352e4e86683bbffe","text_sha256":"3bdba8bf67c716dd190a8111ae87e4f850288fcb38a2b53d022531d7681b53d5"},{"content_sha256":"24269f7d3cc0a0a32897aceb7a6a0680d23a25caa40ec4acecdef191934aee83","locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","source_type":"current_project_study_definition","source_version":"mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","text_sha256":"24269f7d3cc0a0a32897aceb7a6a0680d23a25caa40ec4acecdef191934aee83"}]}