tudy_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6"]},{"ai_run_id":"airun_20261004050151_34bc0996","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"需医学团队确认并列出本方案允许使用的合并用药类别及具体药物","category":"source_missing","gap_id":"gap_661_01","missing_source_classes":["项目允许合并用药清单"],"target":"6.6.1节允许的合并用药/治疗"}],"heading":"允许的合并用药/治疗","missing_source_classes":["项目允许合并用药清单","合并用药管理SOP"],"proposal_text":"","rationale":"项目来源未列出本方案允许使用的合并用药类别或具体药物，仅提及入选标准允许既往α1阻滞剂治疗，该信息属于既往用药史而非合并用药许可清单，不足以支撑允许合并用药章节正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_1a5fbe7462d6_1c06abcca0b78282","section_number":"6.6.1","source_ids":["protocol_full_draft_selection:a5f036b95afa37838eb79033","current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6"]},{"ai_run_id":"airun_20261004050151_34bc0996","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"需医学团队基于IB及药物相互作用数据确认禁止合并用药清单","category":"source_missing","gap_id":"gap_662_01","missing_source_classes":["项目禁止合并用药清单","药物相互作用研究资料"],"target":"6.6.2节禁止的合并用药/治疗"}],"heading":"禁止的合并用药/治疗","missing_source_classes":["项目禁止合并用药清单","药物相互作用研究资料","IB中药物相互作用章节"],"proposal_text":"","rationale":"项目来源未提供禁止合并用药清单。排除标准中提及对β3激动剂或坦索罗辛过敏，但这是入排标准而非合并用药禁忌；β3激动剂与α1阻滞剂、抗胆碱能药物、CYP代谢相关药物的相互作用数据尚未在允许来源中给出，无法形成有实质内容的禁止合并用药正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_1a5fbe7462d6_bbb7f32cc024e411","section_number":"6.6.2","source_ids":["protocol_full_draft_selection:a5f036b95afa37838eb79033","current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6"]},{"ai_run_id":"airun_20261004050151_34bc0996","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_e601516c714f682d2304:revision:4","quote":"筛选、随机/基线、第4、8、12周（主要终点）、此后每8–12周安全访视至第52周；每次访视测IPSS、Qmax、PVR、坐位血压和心率，记录AE/急性尿潴留/UTI。","quote_sha256":"5358a43119d64cdce3f77a23a29a79f02b7690a29e2392cd5c68494770aa0ddc","source_id":"current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f19b0cb6","span_id":"es2"}],"evidence_review_advisories":[],"evidence_span_ids":["es2"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[{"action":"需确认每次访视是否包含实验室检查、心电图、体格检查、依从性评价及具体时间窗","category":"source_missing","gap_id":"gap_7_01","missing_source_classes":["完整访视日程表","实验室检查计划"],"target":"7节各访视评估项目明细"},{"action":"需确认TEAE采集窗口、研究结束时点及安全性评估窗口的具体定义","category":"source_missing","gap_id":"gap_7_02","missing_source_classes":["安全性评估方案"],"target":"7节安全性评估窗口与AE采集时点"}],"heading":"研究程序和评估","missing_source_classes":["完整访视日程表（含各访视评估项目明细）","实验室检查与心电图实施计划","依从性评价方法"],"proposal_text":"本研究为随机、双盲、双模拟、三臂1:1:1对照设计，设ZB-4107 50mg每日一次组、坦索罗辛0.2mg每日一次组和安慰剂组。研究时期包括筛选期（最长4周）、12周双盲主治疗期、40周双盲双模拟安全延长期及末次给药后4周随访期。访视安排为筛选访视、随机/基线访视、第4周、第8周、第12周（主要终点评估访视），此后每8至12周进行一次安全访视直至第52周。每次访视评估项目包括IPSS量表、最大尿流率（Qmax）、残余尿量（PVR）、坐位血压和心率，并记录不良事件、急性尿潴留及尿路感染。主要终点为第12周IPSS总分较基线的变化，评价时点为基线、第4周、第8周和第12周。关键次要终点包括第12周Qmax、PVR、夜尿次数及IPSS-QoL较基线的变化。安全性评估涵盖治疗期不良事件、严重不良事件、坐位血压和心率变化、急性尿潴留、尿路感染及因不良事件停药。特别关注的不良事件包括急性尿潴留、有临床意义的血压升高或心率增快以及症状性尿路感染。","rationale":"访视策略、评估项目（IPSS、Qmax、PVR、坐位血压和心率）、主要及关键次要终点、安全性终点和AESI均来源于当前项目已确认研究事实。各访视是否额外实施实验室检查、心电图、体格检查、依从性评价及具体访视窗口尚未在来源中明确，需医学团队确认后方可补入。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_1a5fbe7462d6_59040ad253655b4b","section_number":"7","source_ids":["protocol_full_draft_selection:a5f036b95afa37838eb79033","current_project_study_definition:mwdefinition_e601516c714f682d2304:r4:ead0c1d8f