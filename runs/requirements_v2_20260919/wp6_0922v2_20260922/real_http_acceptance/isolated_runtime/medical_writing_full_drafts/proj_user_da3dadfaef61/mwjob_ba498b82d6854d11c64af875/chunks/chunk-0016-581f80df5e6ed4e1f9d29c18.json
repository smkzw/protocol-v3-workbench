pus_spans":1,"project_fact_spans":1},"gap_items":[{"action":"确认是否设置探索性PD终点及具体生物标志物","category":"source_missing","gap_id":"gap_pd_endpoint","missing_source_classes":["探索性PD终点/生物标志物清单","IB非临床药效学章节"],"target":"9.6 PD数据分析"},{"action":"确认PD分析方法（如群体PK/PD建模、暴露-效应分析）及是否纳入方案正文","category":"source_missing","gap_id":"gap_pd_method","missing_source_classes":["群体药动学/药效学建模计划","SAP草案"],"target":"9.6 PD数据分析"}],"heading":"PD数据分析","missing_source_classes":["研究者手册（IB）中非临床药效学数据","探索性PD终点/生物标志物清单","群体药动学/药效学建模计划","统计分析计划（SAP）草案"],"proposal_text":"本研究将药理/药效探索列为内在研究目的之一，旨在初步评价KZ-NC401作为选择性食欲素2受体激动剂在1型发作性睡病患者中的药效学特征。药效学评价的具体内容、分析指标及统计方法将在统计分析计划中详细规定，并于数据库锁定前最终确定。当前阶段，药效学数据的采集范围、评价时点及分析方法尚未最终确认，待相关研究文件（包括研究者手册中非临床药效学数据、探索性生物标志物清单及群体药动学/药效学建模计划）经医学团队审核后方可纳入正式方案。","rationale":"项目研究定义明确将'药理/药效探索'列为内在研究目的；公司语料中关于PD评价在SAP中规定的表述仅作为章节结构参照，不构成本项目具体PD终点或方法的确认依据。医学经理需确认：是否设置探索性PD终点（如食欲素通路相关生物标志物）、PD数据采集时点是否与MWT/MSLT访视对齐、是否进行群体PK/PD建模，以及上述内容是否纳入本方案正文或仅在SAP中规定。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_c52483beb588bfa9","section_number":"9.6","source_ids":["protocol_full_draft_selection:581f80df5e6ed4e1f9d29c18","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","company_corpus:cms_cn_protocol_corpus_20260715_v1:20561fabeffbb0","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","company_corpus:cms_cn_protocol_corpus_20260715_v1:2bfb4cb52d6d07","company_corpus:cms_cn_protocol_corpus_20260715_v1:f47cbe0a2614ad"]},{"ai_run_id":"airun_20261009014438_1c2a26f6","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:14 附录 100|block:198|chunk:1","quote":"本研究将完全按照ICH E6和我国GCP指导原则、赫尔辛基宣言、相关法律法规及伦理委员会审核意见进行，以提供并加强对个人的保护。","quote_sha256":"efd84e876c243abd91f664e7c8c77bb26a7587e642a435378598f9519e8dc904","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:20561fabeffbb0","span_id":"es_gcp_data"},{"locator":"section:评价CMS-D001在中度至重度特应性皮炎患者中的有效性和安全性的多中心、随机、双盲、安慰剂对照的Ⅱ期临床研究|block:42|chunk:1","quote":"本统计单位将根据《药物临床试验质量管理规范》的规定，认真履行统计人员职责，保证遵循已批准的方案进行统计分析和处理，保证本研究所有信息、数据真实准确、完整无误，且不用于其他临床试验中。","quote_sha256":"85c12adb57d7e4840e02d045e114b2097ce5d40213d4a0f4198e48166b460b6a","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:2bfb4cb52d6d07","span_id":"es_stat_unit"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"筛选（V1）、基线随机（V2）、治疗期第2/4/8/12周（V3-V6，含MWT/MSLT与ESS评估、猝倒日记核查）、安全性随访（V7，停药后4周内）；MWT与MSLT在基线和第12周各进行一次，评估窗口±3天。","quote_sha256":"c0df3df66d24da24345f6f828b5309e8132cb16927738c78f43757d4a54294c9","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_visit_strategy"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"主要分析集为FAS（所有随机受试者），符合方案集PPS为敏感性分析；主要终点采用MMRM比较各组与安慰剂第12周MWT平均睡眠潜伏期较基线变化，组间比较经Holm程序多重性校正；关键次要终点按Holm递阶策略控制族I类错误；安全性分析采用SS集描述性汇总。","quote_sha256":"9f835924c4bfd72dfdf4fe10ca57aa7f7345252d63de28124b0c9ce53cef69d5","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_stat_strategy"}],"evidence_review_advisories":[],"evidence_span_ids":["es_gcp_data","es_stat_unit","es_visit_strategy","es_stat_strategy"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":2},"gap_items":[{"action":"确认数据采集工具（EDC/纸质）及具体配置","category":"source_missing","gap_id":"gap_data_collection_tool","missing_source_classes":["数据管理计划","EDC系统选型文件"],"target":"10 数据采集与管理"},{"action":"确认源数据验证比例、方式及数据核查流程","category":"source_missing","gap_id":"gap_data_verification","missing_source_classes":["SDV方案","数据核查流程文件"],"target":"10 数据采集与管理"}],"heading":"数据采集与管理","missing_source_classes":["数据管理计划（DMP）","EDC系统选型及配置说明","源数据验证（SDV）方案","数据核查与质疑流程文件"],"proposal_text":"本研究的数据采集与管理遵循《药物临床试验质量管理规范》、ICH E6指导原则及赫尔辛基宣言的相关要求，确保所有研究数据的真实性、准确性、完整性和可追溯性。统计单位将依据上述法规履行统计人员职责，保证遵循已批准的方案进行统计分析和数据处理，保证本研究所有信息、数据真实准确、完整无误，且不用于其他临床试验。数据采集贯穿筛选期（不超过28天）、双盲治疗期（12周）及安全随访期（4周），涵盖各访视中采集的MWT、MSLT、ESS评估、猝倒日记、生命体征、12导联心电图、临床实验室检查、C-SSRS及不良事件等信息。具体数据采集工具、核查流程、源数据验证方式及数据库锁定程序将在方案实施阶段由数据管理部门与统计单位协商确定。","rationale":"项目研究定义确认了研究时期（筛选≤28天、双盲治疗12周、安全随访4周）及各访视采集内容（MWT/MSLT/ESS/猝倒日记/生命体征/ECG/实验室检查/C-SSRS/TEAE）；公司语料中GCP合规及统计单位职责表述作为监管共性结构参照。医学经理需确认：本项目是否采用电子数据采集系统（EDC）或纸质CRF、源数据验证比例及方式、数据核查与质疑流程、数据库锁定前数据清理时限，以及上述内容是否在本章节详述或引用独立的数据管理计划。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_ca86a1505c88175f","section_number":"10","source_ids":["protocol_full_draft_selection:581f80df5e6ed4e1f9d29c18","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","company_corpus:cms_cn_protocol_corpus_20260715_v1:20561fabeffbb0","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","company_corpus:cms_cn_protocol_corpus_20260715_v1:2bfb4cb52d6d07","company_corpus:cms_cn_protocol_corpus_20260715_v1:f47cbe0a2614ad"]},{"ai_run_id":"airun_20261009014438_1c2a26f6","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取本项目CRF设计文件或EDC配置说明后撰写本章节","category":"source_missing","gap_id":"gap_crf_design","missing_source_classes":["CRF设计文件","EDC配置说明","数据采集规范"],"target":"10.1 病例报告表"}],"heading":"病例报告表","missing_source_classes":["病例报告表（CRF）设计文件","EDC系统配置及字段清单","数据采集规范（Data Collection Guidelines）","CRF与原始病历对应关系说明"],"proposal_text":"","rationale":"本章节需要明确本项目病例报告表的具体设计（电子或纸质）、字段清单、与原始病历的对应关系、数据采集频率及CRF填写规范。当前允许来源中未包含本项目CRF设计文件、EDC配置说明或数据采集规范，无法形成有实质信息的正文。公司语料中关于AE记录原则（签署知情同意至首次用药前为病史、用药后为AE）仅为通用结构参照，不能直接作为本项目CRF字段设计的依据。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_9aa72996e6de8a0f","sec