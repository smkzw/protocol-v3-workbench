{"ai_route":{"actual_response_model":"mtplx-flash-next-optimized-speed","ai_run_id":"airun_20261009014238_3c3593c9","expected_response_model":"mtplx-flash-next-optimized-speed","fallback_chain_id":"aifb_7d68c8c323be13e587a56992","fallback_depth":0,"fallback_reason":"","model":"mtplx-flash-next-optimized-speed","provider":"mtplx","reasoning_effort":"xhigh","route_base_url":"http://127.0.0.1:8002/v1","route_identity_hash":"c9480819205db8521fec70763515cf905334434da194fa8ae2172b40ab545075","route_profile_id":"independent_ai__mtplx_qwen38_local","thinking":"enabled"},"ai_run_id":"airun_20261009014238_3c3593c9","chunk_index":15,"job_id":"mwjob_ba498b82d6854d11c64af875","precondition_digest":"0a23c46d968d2956bfe3c207f38be7f5b3d7420a2c11ea1770996d13a41d1c19","project_id":"proj_user_da3dadfaef61","schema_version":"protocol_full_draft_chunk_v10","section_ids":["mwsec_greenfield_proj_user_da3dadfaef61_ce9cf0949bfbfcd3","mwsec_greenfield_proj_user_da3dadfaef61_8747af08b0ed485c","mwsec_greenfield_proj_user_da3dadfaef61_8e0cf6d187483f8c","mwsec_greenfield_proj_user_da3dadfaef61_166c1db0846ddfe4"],"sections":[{"ai_run_id":"airun_20261009014238_3c3593c9","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"特别关注的不良事件：睡眠瘫痪恶性加重；日间过度镇静相关事件（跌倒/交通事故风险）；5-羟色胺综合征样事件。","quote_sha256":"5dc835022b257256afcf5f893bb9f326416e6b77e90ab7ce9e15d2850fa8a9ae","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_01"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"自杀风险量表（C-SSRS）动态监测。","quote_sha256":"82cbb2b1792050d832f33e11e18f00fcd7aff116f13eb5ecfaeea793888c4d60","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_08"}],"evidence_review_advisories":[],"evidence_span_ids":["es_01","es_08"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"需从IB v2.3或项目安全性管理计划中获取AESI的主动监测频率、报告窗口及分级处理流程","category":"source_missing","gap_id":"gap_aes_01","missing_source_classes":["研究药物非临床安全性数据","项目安全性管理计划"],"target":"AESI监测频率与报告时限"},{"action":"需医学经理确认5-羟色胺综合征样事件作为AESI的纳入依据及与OX2R激动剂机制的关联性论证","category":"source_missing","gap_id":"gap_aes_02","missing_source_classes":["研究药物作用机制资料","非临床毒理学数据"],"target":"5-羟色胺综合征样事件的判定标准与机制关联性"}],"heading":"特别关注的不良事件","missing_source_classes":["研究药物非临床安全性数据（IB v2.3具体章节）","AESI监测与报告操作规程","剂量调整与永久停药触发标准"],"proposal_text":"本研究将以下不良事件列为特别关注的不良事件（AESI），由研究者在每次访视及电话随访中主动询问并记录：（1）睡眠瘫痪恶性加重，指发作性睡病原有睡眠瘫痪症状在频率、持续时间或严重程度方面出现临床显著恶化；（2）日间过度镇静相关事件，包括但不限于因日间嗜睡加重导致的跌倒、交通事故或其他意外伤害；（3）5-羟色胺综合征样事件，指出现符合5-羟色胺综合征临床特征（如肌阵挛、高热、意识改变、自主神经功能紊乱等）的不良事件。上述AESI的识别、分级、报告及处理流程将在方案正文中进一步规定。安全性评估中纳入自杀风险量表（C-SSRS）动态监测，以辅助识别与日间过度镇静及情绪相关的不良事件。","rationale":"AESI清单（睡眠瘫痪恶性加重、日间过度镇静相关事件、5-羟色胺综合征样事件）及C-SSRS动态监测均来源于本项目已确认研究事实。AESI的具体监测频率、报告时限、剂量调整触发阈值及永久停药标准在本项目来源中未给出，需医学经理结合KZ-NC401非临床安全性数据及内部IB v2.3补充确认。5-羟色胺综合征样事件与OX2R激动剂药理机制的关联性论证需医学经理审核。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_ce9cf0949bfbfcd3","section_number":"8.8","source_ids":["protocol_full_draft_selection:42011bdcc83ecdc08704cd43","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:9691f7c94f6c58","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976","company_corpus:cms_cn_protocol_corpus_20260715_v1:9895ed0bd2ffd4","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83"]},{"ai_run_id":"airun_20261009014238_3c3593c9","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"需确认本项目是否要求妊娠报告表、报告时限（如24小时）、报告对象（申办者药物警戒部门、伦理委员会）及妊娠与AE/SAE的关系定义","category":"source_missing","gap_id":"gap_preg_01","missing_source_classes":["项目妊娠事件报告与随访规程","项目安全性管理计划"],"target":"妊娠事件报告流程与时限"},{"action":"需确认研究期间及停药后一定时间内是否要求避孕、避孕方法类型、妊娠检查频率及阳性后处理流程","category":"source_missing","gap_id":"gap_preg_02","missing_source_classes":["项目避孕要求","研究药物生殖毒性数据"],"target":"避孕方法与妊娠检查要求"},{"action":"需确认是否要求男性受试者伴侣妊娠报告、新生儿随访终点及随访时长","category":"source_missing","gap_id":"gap_preg_03","missing_source_classes":["项目妊娠事件报告与随访规程"],"target":"伴侣妊娠报告与新生儿随访"}],"heading":"妊娠事件的报告与随访","missing_source_classes":["项目妊娠事件报告与随访规程","研究药物生殖毒性数据（IB相关章节）","避孕方法要求","妊娠检查日程"],"proposal_text":"","rationale":"本项目排除标准明确将妊娠或哺乳期女性排除在研究人群之外，但研究期间意外妊娠的报告流程、随访终点、避孕要求、伴侣妊娠报告及新生儿随访方案在本项目来源中均未确认。公司语料中妊娠报告与随访条款（CMS-D017、CMD-D001-AD、1-3-4-1-2方案）仅为其他项目的结构参照，不可直接迁移为本项目已确认规则。本章节需由医学经理根据KZ-NC401生殖毒性数据及项目安全性管理要求确定具体条款。","review_advisories":["本节复述高影响研究设计（妊娠事件的报告与随访）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_8747af08b0ed485c","section_number":"8.9","source_ids":["protocol_full_draft_selection:42011bdcc83ecdc08704cd43","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:9691f7c94f6c58","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976","company_corpus:cms_cn_protocol_corpus_20260715_v1:9895ed0bd2ffd4","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83"]},{"ai_run_id":"airun_20261009014238_3c3593c9","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"主要分析集为FAS（所有随机受试者），符合方案集PPS为敏感性分析；主要终点采用MMRM比较各组与安慰剂第12周MWT平均睡眠潜伏期较基线变化，组间比较经Holm程序多重性校正；关键次要终点按Holm递阶策略控制族I类错误；安全性分析采用SS集描述性汇总。","quote_sha256":"9f835924c4bfd72dfdf4fe10ca57aa7f7345252d63de28124b0c9ce53cef69d5","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_03"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"样本量假设：MWT平均睡眠潜伏期较安慰剂组间差2.0分钟、标准差SD 4.0分钟、双侧α=0.05、把握度90%；复算需每组85例（三组合计255例）；考虑15%脱落放大后每组100例，共300例。","quote_sha256":"2f197d60039b297e42c21f6d4cac1aaf76428122f3502a5f528542cb8096465a","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_04"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"主要估计目标采用治疗策略（treatment policy）：无论是否启用 rescue 药物或改变莫达非尼背景治疗，均按随机分组分析第12周 MWT 平均睡眠潜伏期较基线变化；对提前退出者在其退出前末次评估采用MMRM框架下的无懊悔插补。","quote_sha256":"55ba4e2bb5af6e0e8e46d1ccf99d24697a8d115f1ca3a8cd0b7627e4995f40ff","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_05"}],"evidence_review_advisories":[],"evidence_span_ids":["es_03","es_04","es_05"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"需与统计师确认依从性阈值、禁限用药定义、关键评估缺失的判定标准等PPS排除细则","category":"source_missing","gap_id":"gap_stat_01","missing_source_classes":["统计分析计划","方案偏离分类标准"],"target":"PPS重大方案偏离排除条款的具体阈值"},{"action":"需确认关键次要终点在Holm递阶中的具体排列顺序","category":"source_missing","gap_id":"gap_stat_02","missing_source_classes":["统计分析计划"],"target":"Holm递阶策略中各终点的排列顺序及层级"}],"heading":"统计分析","missing_source_classes":["统计分析计划（SAP）详细条款","PPS中重大方案偏离的具体排除标准","多重性校正的完整层级结构"],"proposal_text":"本研究统计分析遵循以下原则。分析集定义如下：全分析集（FAS）包含所有完成随机化的受试者，无论其是否实际接受研究药物或完成治疗，用于主要疗效终点及关键次要终点的分析；符合方案集（PPS）为敏感性分析集，纳入完成全部关键评估且无重大方案偏离的受试者，存在重大方案偏离（包括但不限于未按方案完成MWT/MSLT评估、合并使用禁限用药、依从性低于方案规定阈值等）的受试者不纳入PPS；安全性分析集（SS）包含所有至少接受一次研究药物或安慰剂给药的受试者，用于安全性数据的描述性汇总。主要终点为第12周维持觉醒试验（MWT）平均睡眠潜伏期较基线的变化（分钟），采用混合效应模型重复测量（MMRM）比较各活性药组与安慰剂组，组间比较经Holm程序进行多重性校正。关键次要终点（第12周ESS总分校基线变化、第12周MSLT平均睡眠潜伏期较基线变化、每周猝倒发作次数较基线变化）按Holm递阶策略控制族I类错误。主要估计目标采用治疗策略（treatment policy），无论是否启用救援药物或改变莫达非尼背景治疗，均按随机分组进行分析；对提前退出者在其退出前末次评估采用MMRM框架下的无懊悔插补。样本量基于MWT平均睡眠潜伏期较安慰剂组间差2.0分钟、标准差4.0分钟、双侧α=0.05、把握度90%的假设，每组需85例（三组合计255例），考虑15%脱落率后每组纳入100例，共300例。","rationale":"分析集定义（FAS、PPS、SS）、主要终点（MWT）、MMRM方法、Holm校正、treatment policy估计目标、样本量参数（2.0分钟差值、SD 4.0、α=0.05、90%把握度、每组100例共300例）均来源于本项目已确认研究事实。PPS中重大方案偏离的具体排除条款（如依从性阈值、禁限用药定义）需医学经理与统计师共同确认。","review_advisories":["本节复述高影响研究设计（统计分析）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（α、主要终点、估计目标、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_8e0cf6d187483f8c","section_number":"9","source_ids":["protocol_full_draft_selection:42011bdcc83ecdc08704cd43","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:9691f7c94f6c58","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976","company_corpus:cms_cn_protocol_corpus_20260715_v1:9895ed0bd2ffd4","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83"]},{"ai_run_id":"airun_20261009014238_3c3593c9","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"安全性终点：治疗中出现的不良事件（TEAE）发生率与严重程度（CTCAE 5.0）；生命体征、12导联心电图、临床实验室检查较基线变化；自杀风险量表（C-SSRS）动态监测。","quote_sha256":"9fc3c1f63e76620376de07f7230b1966d7ab3c3814a2865c81bb07f987e4ef10","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_02"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"主要分析集为FAS（所有随机受试者），符合方案集PPS为敏感性分析；主要终点采用MMRM比较各组与安慰剂第12周MWT平均睡眠潜伏期较基线变化，组间比较经Holm程序多重性校正；关键次要终点按Holm递阶策略控制族I类错误；安全性分析采用SS集描述性汇总。","quote_sha256":"9f835924c4bfd72dfdf4fe10ca57aa7f7345252d63de28124b0c9ce53cef69d5","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_03"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"自杀风险量表（C-SSRS）动态监测。","quote_sha256":"82cbb2b1792050d832f33e11e18f00fcd7aff116f13eb5ecfaeea793888c4d60","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_08"}],"evidence_review_advisories":[],"evidence_span_ids":["es_02","es_03","es_08"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"需确认TEAE采集窗口（如首次给药至末次给药后28天或其他时限）","category":"source_missing","gap_id":"gap_safety_01","missing_source_classes":["项目安全性管理计划","方案访视流程"],"target":"TEAE采集窗口定义"},{"action":"需确认各访视是否均实施生命体征、ECG、实验室检查及C-SSRS评估，或仅在特定访视实施","category":"source_missing","gap_id":"gap_safety_02","missing_source_classes":["方案访视流程","安全性评估计划"],"target":"安全性评估时点与实验室检查频率"},{"action":"需确认C-SSRS在哪些访视实施及评估窗口","category":"source_missing","gap_id":"gap_safety_03","missing_source_classes":["方案访视流程","安全性评估计划"],"target":"C-SSRS具体评估时间点"}],"heading":"安全性数据分析","missing_source_classes":["TEAE采集窗口定义","安全性评估访视时点明细","实验室检查频率与项目清单","C-SSRS具体评估时间点"],"proposal_text":"安全性数据分析采用安全性分析集（SS），即所有至少接受一次研究药物或安慰剂给药的受试者。不良事件按系统器官分类（SOC）和首选术语（PT）进行编码，严重程度依据CTCAE 5.0标准分级。安全性分析以描述性汇总为主，包括各治疗组不良事件发生率、严重程度分布、与药物的因果关系判定、导致治疗中断或退出的不良事件、特别关注的不良事件（睡眠瘫痪恶性加重、日间过度镇静相关事件、5-羟色胺综合征样事件）的发生情况。生命体征、12导联心电图及临床实验室检查以各时间点较基线变化的描述性统计呈现。自杀风险量表（C-SSRS）评分按访视时点汇总，关注评分较基线的变化及达到临床关注阈值的个案。安全性分析不设正式的假设检验，以描述性统计和个案列表方式呈现。","rationale":"安全性分析集（SS）定义、CTCAE 5.0分级、描述性汇总方法、AESI清单、C-SSRS动态监测均来源于本项目已确认研究事实。TEAE的采集窗口定义（如从首次给药至末次给药后多少天）、安全性评估的具体访视时点、实验室检查频率及C-SSRS评估时间点在本项目来源中未逐项列出，需医学经理与统计师确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_166c1db0846ddfe4","section_number":"9.5","source_ids":["protocol_full_draft_selection:42011bdcc83ecdc08704cd43","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:9691f7c94f6c58","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976","company_corpus:cms_c