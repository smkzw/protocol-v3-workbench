87db323","span_id":"es5"}],"evidence_review_advisories":[],"evidence_span_ids":["es2","es4","es7","es5"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"补充KZ-NC401 IB中非临床药效学摘要及OX2R激动剂在发作性睡病模型中的机制证据","category":"source_missing","gap_id":"gap_24_01","missing_source_classes":["IB非临床章节","机制文献"],"target":"2.4节作用机制段落"},{"action":"确认IB v2.3 §5.1中25 mg与75 mg剂量选择的非临床依据（如受体占有率、安全窗）","category":"source_missing","gap_id":"gap_24_02","missing_source_classes":["IB剂量方案章节"],"target":"2.4节剂量选择依据段落"}],"heading":"本研究的理论基础","missing_source_classes":["OX2R激动剂作用机制文献","KZ-NC401非临床药效学及药代动力学数据","同类靶点药物既往临床证据"],"proposal_text":"KZ-NC401为口服选择性食欲素2受体激动剂薄膜衣片，本研究为首次患者试验，研究定位涵盖药理与药效探索、概念验证及剂量探索三个层次。在药理与药效层面，本研究旨在初步观察KZ-NC401在1型发作性睡病患者中的靶点结合效应、药代动力学特征及与觉醒维持功能改善之间的量效关系，为后续确证性研究提供药效学依据。在概念验证层面，本研究通过第12周维持觉醒试验平均睡眠潜伏期较基线的变化评价KZ-NC401对日间过度嗜睡的改善作用，同时以Epworth嗜睡量表总分校基线变化、多次睡眠潜伏期试验平均睡眠潜伏期较基线变化及每周猝倒发作次数较基线变化作为关键次要终点，初步验证食欲素2受体激动策略对发作性睡病核心症状的干预价值。在剂量探索层面，本研究设置25 mg与75 mg两个活性剂量组及安慰剂对照组，受试者按1:1:1比例随机分配，高剂量组经2周滴定后于第3周起增至75 mg每日一次，以初步比较不同暴露水平下的疗效与安全性特征，为后续III期剂量选择提供依据。本研究为多中心、随机、双盲、安慰剂平行对照设计，双盲治疗期12周，安全随访期4周。","rationale":"研究定位（首次患者试验、药理药效探索、概念验证、剂量探索）来自项目研究定义及章节包当前正文；双盲治疗期12周、25 mg与75 mg剂量及2周滴定方案、1:1:1随机分配、主要终点及关键次要终点均来自项目研究定义。食欲素2受体激动剂在发作性睡病中的具体作用机制文献及非临床药效学数据未在允许来源中提供，正文中关于靶点结合效应与量效关系的表述为基于研究定位的框架性描述，需医学经理核实并补充机制依据。","review_advisories":["本节提及高影响设计信息（剂量选择）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_b3002867bd7f6453","section_number":"2.4","source_ids":["protocol_full_draft_selection:f306e5a6b2465086f3ba1608","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261009002731_61e203cd","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_da3dadfaef61_9398bdf768fa86cc:full-draft:f306e5a6b2465086f3ba1608","quote":"第12周维持觉醒试验（MWT）平均睡眠潜伏期较基线的变化（分钟）；评价时间：基线与第12周各一次MWT，治疗期访视窗口±3天；与安慰剂比较。","quote_sha256":"26a28c29c255cc7240b95171c68d555c88dab9da6137b7039d2bd621a56c78f8","source_id":"protocol_full_draft_selection:f306e5a6b2465086f3ba1608","span_id":"es3"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"第12周ESS总分校基线变化；第12周MSLT平均睡眠潜伏期较基线变化；每周猝倒发作次数较基线变化（患者日记，第4/8/12周）。","quote_sha256":"e0ee454a0567404002c2dd8fcebcb23a50055e2caec78828f740fdd2bf8d1886","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es5"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"安全性终点：治疗中出现的不良事件（TEAE）发生率与严重程度（CTCAE 5.0）；生命体征、12导联心电图、临床实验室检查较基线变化；自杀风险量表（C-SSRS）动态监测。","quote_sha256":"9fc3c1f63e76620376de07f7230b1966d7ab3c3814a2865c81bb07f987e4ef10","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es6"},{"locator":"document:mwdoc_greenfield_proj_user_da3dadfaef61_9398bdf768fa86cc:full-draft:f306e5a6b2465086f3ba1608","quote":"首次患者试验（first-in-patient）；药理/药效探索；概念验证（PoC）；剂量探索","quote_sha256":"3b2417ee5b43b93ae6b6f660d769e8970b7ef99d9050ef4a3afef4178bba1847","source_id":"protocol_full_draft_selection:f306e5a6b2465086f3ba1608","span_id":"es2"}],"evidence_review_advisories":[],"evidence_span_ids":["es3","es5","es6","es2"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"由医学经理确认本研究是否设置探索性目的与终点；若不设置则删除相关段落","category":"decision_pending","gap_id":"gap_3_01","missing_source_classes":[],"target":"3节探索性目的与终点"},{"action":"确认C-SSRS及各安全性评估的具体访视时点与频率","category":"source_missing","gap_id":"gap_3_02","missing_source_classes":["访视计划表","安全性评估方案"],"target":"3节安全性终点评估时点"}],"heading":"研究目的和终点","missing_source_classes":[],"proposal_text":"本研究的主要目的为评价KZ-NC401口服选择性食欲素2受体激动剂薄膜衣片在成人1型发作性睡病患者中改善日间过度嗜睡的疗效，主要终点为第12周维持觉醒试验平均睡眠潜伏期较基线的变化（分钟），评价时间为基线与第12周各进行一次维持觉醒试验，治疗期访视窗口为±3天，与安慰剂比较。关键次要目的为评价KZ-NC401对嗜睡主观感受、客观睡眠倾向及猝倒发作频率的影响，关键次要终点包括：第12周Epworth嗜睡量表总分校基线变化；第12周多次睡眠潜伏期试验平均睡眠潜伏期较基线变化；每周猝倒发作次数较基线变化，通过患者日记于第4周、第8周及第12周采集。安全性目的为评价KZ-NC401在12周双盲治疗期及4周安全随访期内的安全性与耐受性，安全性终点包括：治疗中出现的不良事件发生率与严重程度（按CTCAE 5.0分级）；生命体征、12导联心电图及临床实验室检查较基线变化；自杀风险量表动态监测。特别关注的不良事件包括睡眠瘫痪恶性加重、日间过度镇静相关事件（跌倒及交通事故风险）及5-羟色胺综合征样事件。本研究为首次患者试验，研究目的涵盖药理与药效探索、概念验证及剂量探索；是否设置探索性目的与终点由医学经理根据研究定位决定。","rationale":"主要终点定义、评价时间（基线与第12周各一次MWT，窗口±3天）、与安慰剂比较的对照方式来自章节包当前正文及项目研究定义。关键次要终点中猝倒日记采集时点（第4/8/12周）已确认。安全性终点中CTCAE 5.0分级、C-SSRS动态监测及特别关注不良事件来自项目研究定义。探索性目的与终点是否设置未在允许来源中明确，需医学经理决定。","review_advisories":["本节复述高影响研究设计（研究目的和终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_0573d08111c13829","section_number":"3","source_ids":["protocol_full_draft_selection:f306e5a6b2465086f3ba1608","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261009002731_61e203cd","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_da3dadfaef61_9398bdf768fa86cc:full-draft:f306e5a6b2465086f3ba1608","quote":"第12周维持觉醒试验（MWT）平均睡眠潜伏期较基线的变化（分钟）；评价时间：基线与第12周各一次MWT，治疗期访视窗口±3天；与安慰剂比较。","quote_sha256":"26a28c29c255cc7240b95171c68d555c88dab9da6137b7039d2bd621a56c78f8","source_id":"protocol_full_draft_selection:f306e5a6b2465086f3ba1608","span_id":"es3"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"多中心、随机、双盲、安慰剂平行对照 II期概念验证与剂量探索研究；受试者1:1:1随机至三个剂量组序贯推进（剂量探索部分安全导入了隐藏的安慰剂对照），确证部分两剂量组+安慰剂。","quote_sha256":"d52e03c6bbb7265a389ad0d63f4d719a2700bacb8d9721ab5d89e23e1a16142c","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es4"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"样本量假设：MWT平均睡眠潜伏期较安慰剂组间差2.0分钟、标准差SD 4.0分钟、双侧α=0.05、把握度90%；复算需每组85例（三组合计255例）；考虑15%脱落放大后每组100例，共300例。","quote_sha256":"2f197d60039b297e42c21f6d4cac1aaf76428122f3502a5f528542cb8096465a","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es8"}],"evidence_review_advisories":[],"evidence_span_ids":["es3","es4","es8"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[],"heading":"主要目的和主要终点","missing_source_classes":[],"proposal_text":"本研究的主要目的为评价KZ-NC401口服选择性食欲素2受体激动剂薄膜衣片在成人1型发作性睡病患者中改善日间过度嗜睡的疗效。主要终点为第12周维持觉醒试验平均睡眠潜伏期较基线的变化（分钟）。评价时间为基线与第12周各进行一次维持觉醒试验，治疗期访视窗口为±3天。主要终点分析以安慰剂为对照，比较KZ-NC401低剂量组（25 mg每日一次）及高剂量组（75 mg每日一次）与安慰剂对照组在第12周维持觉醒试验平均睡眠潜伏期较基线变化上的组间差异。主要分析采用混合效应模型重复测量方法，以基线值及访视时间为协变量，组间比较经Holm程序进行多重性校正。主要分析集为全分析集，包含所有随机化受试者，无论其是否完成治疗或存在方案偏离；符合方案集作为敏感性分析集，纳入无重大方案偏离且完成第12周主要终点评估的受试者，存在重大方案偏离者排除于符合方案集之外。安全性分析集包含所有接受至少一次研究药物给药的受试者，用于不良事件及安全性指标的描述性汇总。","rationale":"主要终点定义、评价时间（基线与第12周各一次MWT，窗口±3天）、与安慰剂比较的对照方式、剂量组设置（25 mg与75 mg）及1:1:1随机分配来自项目研究定义。统计分析策略中混合效应模型重复测量方法、Holm多重性校正、全分析集与符合方案集定义及安全性分析集用途来自项目研究定义中统计分析策略条目。符合方案集成员判定规则（无重大方案偏离且完成关键评估者入集，重大方案偏离者排除）依据项目研究定义中符合方案集为敏感性分析的表述及方案撰写规范推导，需医学经理确认具体方案偏离排除条款的措辞。","review_advisories":["本节复述高影响研究设计（主要目的和主要终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_52e16ddf07f5b794","section_number":"3.1","source_ids":["protocol_full_draft_selection:f306e5a6b2465086f3ba1608","