6c17b90802e7352c6e81b5fdc853989b74ea1499901f514a4","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_no_interim"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"安全性终点：治疗中出现的不良事件（TEAE）发生率与严重程度（CTCAE 5.0）；生命体征、12导联心电图、临床实验室检查较基线变化；自杀风险量表（C-SSRS）动态监测。","quote_sha256":"9fc3c1f63e76620376de07f7230b1966d7ab3c3814a2865c81bb07f987e4ef10","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_safety_endpoints"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"特别关注的不良事件：睡眠瘫痪恶性加重；日间过度镇静相关事件（跌倒/交通事故风险）；5-羟色胺综合征样事件。","quote_sha256":"5dc835022b257256afcf5f893bb9f326416e6b77e90ab7ce9e15d2850fa8a9ae","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_sae_interest"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"研究时期：筛选期（≤28天）；双盲治疗期（12周）；安全随访期（4周）","quote_sha256":"a377431067b15c1efa1915f6a4e4d020f2baa804fad94a5ef6a0cb9f321e30d0","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_periods"}],"evidence_review_advisories":[],"evidence_span_ids":["es_dmc_planned","es_fip","es_no_interim","es_safety_endpoints","es_sae_interest","es_periods"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"需医学经理确认DMC审阅频率（如每入组一定例数或每固定周期）及是否设置安全性暂停审查点","category":"source_missing","gap_id":"gap_dmc_01","missing_source_classes":["DMC章程","安全性监测计划"],"target":"4.5节DMC会议频率与审阅节点"},{"action":"需结合IB v2.3非临床安全性数据及首次人体试验剂量递增经验确定具体阈值","category":"source_missing","gap_id":"gap_dmc_02","missing_source_classes":["研究者手册（IB）","非临床安全性报告"],"target":"4.5节DMC暂停或终止建议触发阈值"}],"heading":"安全性审评/数据监查委员会","missing_source_classes":["DMC章程","安全性监测计划","首次人体试验安全性评估框架"],"proposal_text":"本研究设置独立数据监查委员会（DMC），由具备睡眠医学、药理学及生物统计学背景的独立专家组成，负责在研究全程对安全性数据进行定期审阅。鉴于KZ-NC401为首次人体试验（first-in-patient），且本研究为II期概念验证与剂量探索研究，DMC的安全监测职能尤为关键。本研究不计划期中分析，DMC的审阅重点为安全性数据而非疗效终点。安全性监测范围涵盖治疗中出现的不良事件（按CTCAE 5.0分级）、生命体征、12导联心电图、临床实验室检查较基线变化及自杀风险量表（C-SSRS）动态监测结果。特别关注的不良事件包括睡眠瘫痪恶性加重、日间过度镇静相关事件（跌倒及交通事故风险）和5-羟色胺综合征样事件，DMC在审阅中应重点关注上述事件的发生率、严重程度及组间分布。安全随访期为停药后4周，DMC应在该期间内完成对全部安全性数据的最终审阅。DMC的具体组成人数、会议频率、数据递交格式、暂停或终止建议的触发阈值及向申办方报告的流程，将在DMC章程中另行规定。","rationale":"DMC设置、首次人体试验性质、无期中分析、安全性终点（CTCAE 5.0、C-SSRS）、特别关注不良事件及4周安全随访期均来自当前项目已确认研究事实。DMC章程中的操作细节（会议频率、触发阈值、组成人数）无项目级来源支持，已列入待确认项。","review_advisories":["本节提及高影响设计信息（期中分析）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_4fcb3822c755ce77","section_number":"4.5","source_ids":["protocol_full_draft_selection:d23abb86b5d8342f2bc3f639","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323"]},{"ai_run_id":"airun_20261009004353_b0494c37","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"研究时期：筛选期（≤28天）；双盲治疗期（12周）；安全随访期（4周）","quote_sha256":"a377431067b15c1efa1915f6a4e4d020f2baa804fad94a5ef6a0cb9f321e30d0","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_periods"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"访视策略：筛选（V1）、基线随机（V2）、治疗期第2/4/8/12周（V3-V6，含MWT/MSLT与ESS评估、猝倒日记核查）、安全性随访（V7，停药后4周内）；MWT与MSLT在基线和第12周各进行一次，评估窗口±3天。","quote_sha256":"efc1979e6bb6290d332475e2a77d1c55921e3945e30c1a7aec691ff4f234b78a","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_visits"}],"evidence_review_advisories":[],"evidence_span_ids":["es_periods","es_visits"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[],"heading":"研究结束与研究持续时间","missing_source_classes":[],"proposal_text":"本研究由三个连续时期组成：筛选期不超过28天，双盲治疗期12周，安全随访期4周。一名受试者从首次筛选访视至研究结束的最长总持续时间为20周（含筛选期）。筛选期（V1）用于完成知情同意、病史采集、体格检查、实验室检查、12导联心电图、多导睡眠图（nPSG）及多次睡眠潜伏期试验（MSLT）等基线评估，并确认入选与排除标准。基线随机访视（V2）完成随机分组、首次给药及基线MWT与MSLT评估。双盲治疗期设第2周（V3）、第4周（V4）、第8周（V5）和第12周（V6）四次访视，其中第12周访视包含MWT与MSLT评估（评估窗口±3天）、ESS评估及猝倒日记核查。安全随访访视（V7）在停药后4周内完成，用于安全性终点评估及末次研究药物回收。维持觉醒试验（MWT）与多次睡眠潜伏期试验（MSLT）仅在基线（V2）和第12周（V6）各进行一次。研究结束定义为受试者完成V7访视或提前退出研究。","rationale":"研究时期（筛选≤28天、治疗12周、随访4周）、访视策略（V1至V7）、MWT与MSLT评估时点及±3天窗口均来自当前项目已确认研究事实。总持续时间20周由三时期累加推算。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_24653457727cd9d1","section_number":"4.6","source_ids":["protocol_full_draft_selection:d23abb86b5d8342f2bc3f639","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323"]},{"ai_run_id":"airun_20261009004353_b0494c37","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"需获取项目级暂停标准文件，明确何种安全性信号触发部分或全部剂量组暂停","category":"source_missing","gap_id":"gap_pause_01","missing_source_classes":["研究暂停和终止标准项目文件","DMC章程"],"target":"4.7节研究暂停触发条件与程序"},{"action":"需确认终止阈值、终止后已入组受试者的随访安排及数据收集截止规则","category":"source_missing","gap_id":"gap_pause_02","missing_source_classes":["研究暂停和终止标准项目文件","安全性监测计划"],"target":"4.7节研究终止标准与受试者退出后随访"}],"heading":"研究暂停和终止标准","missing_source_classes":["研究暂停和终止标准项目文件","DMC章程（含暂停/终止条款）","研究者手册（IB）安全性章节","首次人体试验剂量递增安全性规则"],"proposal_text":"","rationale":"当前允许来源中无任何关于研究暂停或终止标准的项目级文件。本研究为首次人体试验且设置DMC，暂停与终止标准对受试者安全至关重要，但具体触发条件（如特定不良事件发生率阈值、剂量组暂停规则）、DMC建议权限、申办方决定流程及受影响受试者的退出后随访安排均无来源支持，不得以通用原则或条件句替代。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_ccce7e08af8545d3","section_number":"4.7","source_ids":["protocol_full_draft_selection:d23abb86b5d8342f2bc3f639","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323"]},{"ai_run_id":"airun_20261009004353_b0494c37","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"入选标准模块：年龄18-65岁（含），确诊1型发作性睡病≥1年（ICSD-3标准，含nPSG+MSLT记录）；基线ESS≥14且MWT平均睡眠潜伏期≤14分钟；受试者本人签署知情同意并能遵守访视安排。","quote_sha256":"b7a1d4b4360ccf8eacd6be38cd2f033e813d215c56ffc88796c5ee39587af9f5","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_inclusion"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"排除标准模块：筛选前3个月内参与其他干预性研究；存在未经治疗的重度阻塞性睡眠呼吸暂停或发作性睡病以外的显著睡眠病理；有临床意义的肝肾功能异常（ALT/AST>2×ULN或eGFR<50 mL/min/1.73m²）；妊娠或哺乳期女性。；筛选期12导联ECG提示QTcF>450ms或存在未控制的心律失常；研究者判定存在任何可能增加研究风险或干扰评估的疾病或情况。","quote_sha256":"612ac8b303fdf95a7839565e515ed88a816fb59fea323613e5655f78164beefd","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_exclusion"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"洗脱要求：入组前正在使用莫达非尼/阿莫达非尼者须洗脱≥7天；入组前14天内使用羟丁酸钠或兴奋剂类药物者须洗脱；研究期间禁止合并使用其他促醒药物。；随机前48小时内饮用含咖啡因或酒精饮料并可能影响基线MSLT/MWT评估者，须推迟随机至符合条件。","quote_sha256":"48d3235e4f7310d7492fa0ae1139270d5ec0c46abd9e7e643d0a888d0325c089","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_washout"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"体重指数18-32 kg/m²","quote_sha256":"61d2713519eac898655bc2c56b279d56dc443b31e8ef81deac29eb6a7f3274bf","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_bmi"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"多中心、随机、双盲、安慰剂平行对照 II期概念验证与剂量探索研究","quote_sha256":"82728e93f3112dbf11d97c965fb6211765260ad85b630872505f5e4ec7bccba6","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_multicenter"}],"evidence_review_advisories":[],"evidence_span_ids":["es_inclusion","es_exclusion","es_washout","es_bmi","es_multicenter"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[],"heading":"研究人群","missing_source_classes":[],"proposal_text":"本研究目标人群为成人1型发作性睡病患者，年龄18至65岁（含两端），确诊1型发作性睡病不少于1年，诊断依据国际睡眠障碍分类第三版（ICSD-3）标准，且须具备夜间多导睡眠图（nPSG）和多次睡眠潜伏期试验（MSLT）记录。入选受试者须存在中重度日间过度嗜睡，具体为基线Epworth嗜睡量表（ESS）总分≥14分且MSLT平均睡眠潜伏期≤14分钟，伴或不伴猝倒。体重指数须在18至32 kg/m²范围内。受试者须本人签署知情同意书并能够遵守访视安排。排除标准包括：筛选前3个月内参与过其他干预性临床研究；存在未经治疗的重度阻塞性睡眠呼吸暂停或发作性睡病以外的显著睡眠病理；有临床意义的肝肾功能异常，即ALT或AST超过2倍正常值上限，或估算肾小球滤过率（eGFR）低于50 mL/min/1.73m²；妊娠或哺乳期女性；筛选期12导联心电图提示QTcF超过450 ms或存在未控制的心律失常；研究者判定存在任何可能增加研究风险或干扰疗效与安全性评估的疾病或情况。入组前正在使用莫达非尼或阿莫达非尼者须完成不少于7天的洗脱；入组前14天内使用羟丁酸钠或兴奋剂类药物者须完成相应洗脱；研究期间禁止合并使用其他促醒药物。随机前48小时内饮用含咖啡因或酒精饮料且可能影响基线MSLT或MWT评估者，须推迟随机至评估条件满足后方可入组。","rationale":"年龄范围、ICSD-3诊断标准、ESS≥14与MWT≤14分钟阈值、BMI 18-32、排除标准（含QTcF>450 ms、肝肾功能阈值）、洗脱要求（莫达非尼≥7天、羟丁酸钠14天、咖啡因/酒精48小时）及禁止合并促醒药物均来自当前项目已确认研究事实。","review_advisories":["本节复述高影响研究设计（研究人群）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_70723ba050fc952c","section_number":"5","source_ids":["protocol_full_draft_selection:d23abb86b5d8342f2bc3f639","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323"]}],"source_bindings":[{"content_sha256":"62caa4fefba304af137c61a9bc645e44cc65b88446f4be0bfe6805750a2383b0","locator":"document:mwdoc_greenfield_proj_user_da3dadfaef61_9398bdf768fa86cc:full-draft:d23abb86b5d8342f2bc3f639","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:d23abb86b5d8342f2bc3f639","source_type":"protocol_full_draft_selection","source_version":"full-draft:0a23c46d968d2956bfe3c207f38be7f5b3d7420a2c11ea1770996d13a41d1c19:d23abb86b5d8342f2bc3f639","text_sha256":"62caa4fefba304af137c61a9bc645e44cc65b88446f4be0bfe6805750a2383b0"},{"content_sha256":"f5c7fc7ba4b1f896c6e8499f9f41260b8de51be15690bade1e7b5cf41