vidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"参考项目操作手册或统计分析计划确认依从性评价方法（药片计数/电子监测/患者日记）及合格阈值后补入正文","category":"source_missing","gap_id":"gap_adh_method","missing_source_classes":["依从性评价方法学文件","依从性合格阈值定义"],"target":"6.5节依从性评价方法与阈值"}],"heading":"研究治疗依从性","missing_source_classes":["依从性评价方法学文件","依从性合格阈值定义"],"proposal_text":"KZ-NC401以口服薄膜衣片形式给药，每日一次，于晨起后30分钟内服用。低剂量组全程给予25 mg每日一次；高剂量组第1至2周给予25 mg每日一次，第3周起增至75 mg每日一次，连续给药至第12周。受试者若漏服当日剂量，不再补服，次日按原计划时间继续服药。双盲治疗期共12周，治疗期访视安排于第2周、第4周、第8周和第12周（V3至V6），各次访视包含维持觉醒试验（MWT）与多次睡眠潜伏期试验（MSLT）评估、Epworth嗜睡量表（ESS）评定及猝倒日记核查，访视窗口为±3天。依从性评价在上述治疗期访视中实施，具体评价方法、合格阈值及不依从处理流程需结合项目操作手册与统计分析计划确定。","rationale":"给药方案（每日一次晨服、30分钟窗口、漏服不补服、12周疗程、滴定方案）及治疗期访视安排（V3-V6含MWT/MSLT/ESS/猝倒日记核查、±3天窗口）均来源于当前项目已确认研究事实。依从性评价的具体方法和合格阈值在允许来源中未给出，已列入待确认项。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_5127f7a20bb80c28","section_number":"6.5","source_ids":["protocol_full_draft_selection:4b2f869e27b7c794f1afad76","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","company_corpus:cms_cn_protocol_corpus_20260715_v1:176c87031ef7e6","company_corpus:cms_cn_protocol_corpus_20260715_v1:69f36952e02ae0","company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","company_corpus:cms_cn_protocol_corpus_20260715_v1:06652cfb5d7add","company_corpus:cms_cn_protocol_corpus_20260715_v1:79890fa298bcdd"]},{"ai_run_id":"airun_20261009012020_05ae94b1","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:既往/合并治疗和洗脱期|block:498|chunk:1","quote":"参与者在研究期间，除方案禁止的合并用药外，","quote_sha256":"33fbc172e10d057b657a11a8a1411951d79db71a62e6f67b3724a6813a7b19d3","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:69f36952e02ae0","span_id":"es_003"},{"locator":"section:既往/合并治疗和洗脱期|block:636|chunk:1","quote":"在随机前，用于其他疾病的合并用药及治疗，如非 3.6.5.3 规定的禁止的合并用药 或治疗，且研究者认为剂量稳定，可以在研究期间继续使用。研究者可根据受试者疾 病情况决定是否停用或加用/换用治疗药物。如加用/换用治疗药物，需注意记录既往病 史变化情况，是否需要记录 AE。","quote_sha256":"59f7e091aaa0fc7fbe0776c27b50433be0c3a716c7cd2d1dab87d5c3ce126cf4","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","span_id":"es_004"},{"locator":"section:既往/合并治疗和洗脱期|block:412|chunk:1","quote":"在随机前，用于其他疾病的合并用药及治疗，如非方案规定的禁止的合并用药或治疗，且研究者认为剂量稳定，可以在研究期间继续使用。研究者可根据试验参与者疾病情况决定是否停用或加用/换用治疗药物。如加用/换用治疗药物，需注意记录既往病史变化情况，是否需要记录AE。","quote_sha256":"0a10b0bde2c08069df5ee6b83624735e817a8c399242debf70912e8e36f0d356","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:06652cfb5d7add","span_id":"es_005"}],"evidence_review_advisories":[],"evidence_span_ids":["es_003","es_004","es_005"],"evidence_summary":{"corpus_spans":3,"project_fact_spans":0},"gap_items":[{"action":"参考项目操作手册确认合并用药管理的具体操作细则（如合并用药记录时限、与AE判定交互规则）后补入","category":"source_missing","gap_id":"gap_concom_rules","missing_source_classes":["本项目完整合并用药管理细则","合并用药与AE判定交互规则"],"target":"6.6节合并用药管理总体规则"}],"heading":"合并用药/治疗","missing_source_classes":["本项目完整合并用药管理细则","合并用药与AE判定交互规则"],"proposal_text":"研究期间，除本方案明确禁止的合并用药或治疗外，受试者可接受其他合并用药或治疗。随机前已用于其他疾病的合并用药及治疗，若不属于本方案规定的禁止合并用药或治疗范畴，且研究者判断其剂量稳定，可在研究期间继续使用。研究者有权根据受试者疾病情况决定是否停用、加用或换用治疗药物；如发生加用或换用，应记录既往病史变化情况，并评估是否需要记录为不良事件。本章节涵盖允许与禁止合并用药/治疗的总体管理原则；具体允许与禁止清单分别见6.6.1和6.6.2节。","rationale":"合并用药管理的一般原则（非禁止用药可继续、研究者裁量权、加用/换用记录要求）参照公司语料中多份方案的章节结构，仅作为监管共性措辞与结构参照，不构成本项目已确认的实施规则。具体禁止清单（促醒药物、咖啡因/酒精限制）来源于当前项目已确认研究事实。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_bb31f924d2790712","section_number":"6.6","source_ids":["protocol_full_draft_selection:4b2f869e27b7c794f1afad76","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","company_corpus:cms_cn_protocol_corpus_20260715_v1:176c87031ef7e6","company_corpus:cms_cn_protocol_corpus_20260715_v1:69f36952e02ae0","company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","company_corpus:cms_cn_protocol_corpus_20260715_v1:06652cfb5d7add","company_corpus:cms_cn_protocol_corpus_20260715_v1:79890fa298bcdd"]},{"ai_run_id":"airun_20261009012020_05ae94b1","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:既往/合并治疗和洗脱期|block:636|chunk:1","quote":"在随机前，用于其他疾病的合并用药及治疗，如非 3.6.5.3 规定的禁止的合并用药 或治疗，且研究者认为剂量稳定，可以在研究期间继续使用。研究者可根据受试者疾 病情况决定是否停用或加用/换用治疗药物。如加用/换用治疗药物，需注意记录既往病 史变化情况，是否需要记录 AE。","quote_sha256":"59f7e091aaa0fc7fbe0776c27b50433be0c3a716c7cd2d1dab87d5c3ce126cf4","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","span_id":"es_004"},{"locator":"section:既往/合并治疗和洗脱期|block:412|chunk:1","quote":"在随机前，用于其他疾病的合并用药及治疗，如非方案规定的禁止的合并用药或治疗，且研究者认为剂量稳定，可以在研究期间继续使用。研究者可根据试验参与者疾病情况决定是否停用或加用/换用治疗药物。如加用/换用治疗药物，需注意记录既往病史变化情况，是否需要记录AE。","quote_sha256":"0a10b0bde2c08069df5ee6b83624735e817a8c399242debf70912e8e36f0d356","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:06652cfb5d7add","span_id":"es_005"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004","es_005"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":0},"gap_items":[{"action":"确认是否需要列出允许合并用药正面清单（如特定背景治疗），或维持排除法表述","category":"source_missing","gap_id":"gap_allowed_list","missing_source_classes":["本项目允许合并用药正面清单"],"target":"6.6.1节允许合并用药具体范围"}],"heading":"允许的合并用药/治疗","missing_source_classes":["本项目允许合并用药正面清单（如适用）"],"proposal_text":"随机前已用于其他疾病的合并用药及治疗，若不属于本方案6.6.2节规定的禁止合并用药或治疗，且研究者认为其剂量稳定，可在研究期间继续使用。研究者可根据受试者疾病情况决定是否停用或加用/换用治疗药物；如加用或换用治疗药物，需注意记录既往病史变化情况，并评估是否需要记录为不良事件。本章节所列允许范围以排除法界定，即凡未被6.6.2节明确禁止的合并用药或治疗，在研究者判断安全且剂量稳定的前提下均可使用。","rationale":"允许合并用药的界定原则（排除法、剂量稳定前提、研究者裁量权、AE记录评估）参照公司语料中多份方案的章节结构，仅作为监管共性措辞与结构参照。本项目未提供独立的允许合并用药正面清单，故采用排除法表述。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_92be44faf8c57cce","section_number":"6.6.1","source_ids":["protocol_full_draft_selection:4b2f869e27b7c794f1afad76","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","company_corpus:cms_cn_protocol_corpus_20260715_v1:176c87031ef7e6","company_corpus:cms_cn_protocol_corpus_20260715_v1:69f36952e02ae0","company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","company_corpus:cms_cn_protocol_corpus_20260715_v1:06652cfb5d7add","company_corpus:cms_cn_protocol_corpus_20260715_v1:79890fa298bcdd"]},{"ai_run_id":"airun_20261009012020_05ae94b1","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:禁止的合并用药/治疗|block:506|chunk:1","quote":"接受了禁止的合并用药/治疗的参与者可能中断试验用药品治疗或退出研究，此时，应鼓励参与者继续参与研究的随访，以尽可能获得更多的数据。","quote_sha256":"fb6f127ecebe3d5e94422651907ad9690ff2d8a73be5a2c52bd06a8f93f1697b","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:79890fa298bcdd","span_id":"es_006"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"研究期间禁止合并使用其他促醒药物","quote_sha256":"a6739370e46f9f6399ab93b856ad26a92c2e72b4faf2cd302f36bdd789b1e589","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_007"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"随机前48小时内饮用含咖啡因或酒精饮料并可能影响基线MSLT/MWT评估者，须推迟随机至符合条件","quote_sha256":"71b5dfac0114b0ab163cc84f004ca07a8c3e723e94658a47b9f73dd1ec7451d7","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_008"}],"evidence_review_advisories":[],"evidence_span_ids":["es_006","es_007","es_008"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":2},"gap_items":[{"action":"参考IB v2.3及药理学资料确认完整禁止合并用药清单后补入","category":"source_missing","gap_id":"gap_forbidden_list","missing_source_classes":["完整禁止合并用药清单","IB或药理学相互作用资料"],"target":"6.6.2节禁止合并用药完整清单"},{"action":"确认受试者接受禁止合并用药后的处理策略（中断/退出/继续随访）","category":"source_missing","gap_id":"gap_forbidden_handling","missing_source_classes":["禁止用药后处理策略"],"target":"6.6.2节禁止用药后处理策略"}],"heading":"禁止的合并用药/治疗","missing_source_classes":["完整禁止合并用药清单","IB或药理学相互作用资料","禁止用药后处理策略"],"proposal_text":"研究期间禁止合并使用其他促醒药物。随机前48小时内饮用含咖啡因或酒精饮料并可能影响基线MWT或MSLT评估者，须推迟随机至符合条件后方可入组。除上述明确禁止项外，可能影响觉醒-睡眠周期、与KZ-NC401存在药代动力学或药效学相互作用的药物是否纳入禁止清单，需参考IB v2.3及药理学资料进一步确认。接受了禁止的合并用药或治疗的受试者，应鼓励其继续参与研究的随访，以尽可能获得更多的安全性与有效性数据；是否中断试验用药品治疗或退出研究，需结合具体药物类别与受试者个体情况由研究者判断。","rationale":"禁止合并使用其他促醒药物及咖啡因/酒精48小时限制来源于当前项目已确认研究事实。公司语料中'接受了禁止的合并用药/治疗的参与者可能中断试验用药品治疗或退出研究，此时，应鼓励参与者继续参与研究的随访'仅作为章节结构参照，不构成本项目已确认的处理规则。完整禁止清单需参考IB或药理学资料确认。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_5f1bc6a39a473f3d","section_number":"6.6.2","source_ids":["protocol_full_draft_selection:4b2f869e27b7c794f1afad76","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","company_corpus:cms_cn_protocol_corpus_20260715_v1:176c87031ef7e6","company_corpus:cms_cn_protocol_corpus_20260715_v1:69f36952e02ae0","company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","company_corpus:cms_cn_protocol_corpus_20260715_v1:06652cfb5d7add","company_corpus:cms_cn_protocol_corpus_20260715_v1:79890fa298bcdd"]}],"source_bindings":[{"content_sha256":"b1e70e4735da0a319eb9bd37e12d3512711b781800e5ca9c7d4095af0d887c8b","locator":"document:mwdoc_greenfield_proj_user_da3dadfaef61_9398bdf768fa86cc:full-draft:4b2f869e27b7c794f1afad76","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:4b2f869e27b7c794f1afad76","source_type":"protocol_full_draft_selection","source_version":"full-draft:0a23c46d968d2956bfe3c207f38be7f5b3d7420a2c11ea1770996d13a41d1c19:4b2f869e27b7c794f1afad76","text_sha256":"b1e70e4735da0a319eb9bd37e12d3512711b781800e5ca9c7d4095af0d887c8b"},{"content_sha256":"f5c7fc7ba4b1f896c6e8499f9f41260b8de51be15690bade1e7b5cf4179c4b66","locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_3079f2