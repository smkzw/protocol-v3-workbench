ories":[],"evidence_span_ids":["es_dose_scheme","es_purpose"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"检索并引用IB v2.3 §5.1中受体占有率、动物药效学及安全窗数据","category":"source_not_retrieved","gap_id":"gap_dose_01","missing_source_classes":["研究者手册非临床章节"],"target":"4.2.1 剂量选择依据——非临床剂量推导段落"}],"heading":"剂量选择依据","missing_source_classes":["研究者手册（IB）非临床章节","受体占有率及动物药效学数据"],"proposal_text":"KZ-NC401为口服选择性食欲素2受体（OX2R）激动剂薄膜衣片，本研究为首次患者试验，兼具药理/药效探索、概念验证与剂量探索目的。剂量方案依据内部IB v2.3 §5.1（立项剂量方案）设定：低剂量组25 mg每日一次晨服，高剂量组第1至2周25 mg每日一次、第3周起增至75 mg每日一次，均于晨起后30分钟内服用，连续给药至第12周；漏服当日不再补服。双盲治疗期共12周，其中前2周为滴定期。剂量选择需结合OX2R受体占有率、动物药效学及安全窗数据论证，上述非临床依据详见IB v2.3，本章节正文仅引用其结论性剂量方案。","rationale":"剂量方案、滴定策略及IB引用来源均取自当前项目已确认研究事实（MW-II-4E250244-DRAFT r7）。非临床剂量推导依据（受体占有率、动物药效、安全窗）未在本次允许来源中展开，需医学经理核实IB v2.3 §5.1原文后补充或确认引用充分性。","review_advisories":["本节复述高影响研究设计（剂量选择依据）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（剂量选择）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_193a0d44cd86da4e","section_number":"4.2.1","source_ids":["protocol_full_draft_selection:5986c2e13f4875ea61efa803","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb71242d679bdb","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322"]},{"ai_run_id":"airun_20261009003957_aaaf2c3c","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"访视策略：筛选（V1）、基线随机（V2）、治疗期第2/4/8/12周（V3-V6，含MWT/MSLT与ESS评估、猝倒日记核查）、安全性随访（V7，停药后4周内）；MWT与MSLT在基线和第12周各进行一次，评估窗口±3天。","quote_sha256":"efc1979e6bb6290d332475e2a77d1c55921e3945e30c1a7aec691ff4f234b78a","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_visit"}],"evidence_review_advisories":[],"evidence_span_ids":["es_visit"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[{"action":"检索药代动力学方案或IB PK章节，获取具体采样时间点与PD标志物清单","category":"source_not_retrieved","gap_id":"gap_pkpd_01","missing_source_classes":["药代动力学方案","IB PK/PD章节"],"target":"4.2.2 PK/PD采集点设计依据——具体采血时点及PD标志物"}],"heading":"PK/PD采集点设计依据","missing_source_classes":["药代动力学方案","IB PK/PD章节"],"proposal_text":"本研究访视框架为：筛选（V1）、基线随机（V2）、治疗期第2/4/8/12周（V3至V6，含MWT/MSLT与ESS评估、猝倒日记核查）、安全性随访（V7，停药后4周内）。MWT与MSLT在基线和第12周各进行一次，评估窗口±3天。PK/PD采集点设计需与上述访视时间窗及主要终点（第12周MWT平均睡眠潜伏期较基线变化）的评估节点对齐，具体采血时点、PD标志物种类及采集频次由药代动力学方案确定后写入。","rationale":"访视策略及MWT/MSLT评估时点取自当前项目已确认研究事实。具体PK采样时间点及PD标志物采集方案未在允许来源中给出，无法形成完整正文，需药代动力学方案或IB PK章节支持。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_36a8006388bf8ebf","section_number":"4.2.2","source_ids":["protocol_full_draft_selection:5986c2e13f4875ea61efa803","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb71242d679bdb","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322"]},{"ai_run_id":"airun_20261009003957_aaaf2c3c","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"安慰剂平行对照，1:1:1随机分配至KZ-NC401低剂量组、高剂量组与安慰剂对照组；分层因素为基线猝倒有无（是/否）与地区；安慰剂外观、口味与活性药一致并由不参与评估的药师发放以维持盲态。","quote_sha256":"552326d326550f4be6cfeda920bde8d43de8c62f5205209331e7e07cf4a4d22e","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_rand"},{"locator":"section:随机和盲法|block:352|chunk:1","quote":"本研究为双盲随机设计，试验参与者、研究者、监查员以及数据分析人员等对试验参与者接受某剂量试验用药品类别属于试验药物/安慰剂均不知情。在研究开始之前由一名独立的随机化统计师撰写随机化方案，并根据随机化方案使用SAS 9.4（或更新版本）统计软件生成试验参与者随机表和药物随机表。","quote_sha256":"8daf6dc46d42155e29ca2768fe326bcf20208390c0e565062d237a9768f12e59","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","span_id":"es_corpus_rand"}],"evidence_review_advisories":[],"evidence_span_ids":["es_rand","es_corpus_rand"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":1},"gap_items":[],"heading":"随机化","missing_source_classes":[],"proposal_text":"本研究采用1:1:1随机分配，受试者随机至KZ-NC401低剂量组（25 mg）、高剂量组（75 mg）与安慰剂对照组。分层因素为基线猝倒有无（是/否）与地区。随机化方案由独立统计师在研究开始前撰写，随机表生成工具及具体分层算法由该统计师确定。","rationale":"1:1:1分配比例、三组构成、分层因素（猝倒有无与地区）均取自当前项目已确认研究事实。随机表生成工具（如SAS）及具体分层算法为公司语料结构参照，本项目是否采用相同工具需确认。","review_advisories":["本节复述高影响研究设计（随机化）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_c8c77365b91f37cc","section_number":"4.3","source_ids":["protocol_full_draft_selection:5986c2e13f4875ea61efa803","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb71242d679bdb","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322"]},{"ai_run_id":"airun_20261009003957_aaaf2c3c","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"安慰剂平行对照，1:1:1随机分配至KZ-NC401低剂量组、高剂量组与安慰剂对照组；分层因素为基线猝倒有无（是/否）与地区；安慰剂外观、口味与活性药一致并由不参与评估的药师发放以维持盲态。","quote_sha256":"552326d326550f4be6cfeda920bde8d43de8c62f5205209331e7e07cf4a4d22e","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_rand"},{"locator":"section:6.3.3 揭盲|block:490|chunk:1","quote":"紧急揭盲借助IWRS中","quote_sha256":"60f7f308cc31286e41cd0e263ec3058002ea024fab20328dd9ee9d91a101af72","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","span_id":"es_corpus_unblind"}],"evidence_review_advisories":[],"evidence_span_ids":["es_rand","es_corpus_unblind"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":1},"gap_items":[{"action":"确认本项目中哪些角色处于盲态、哪些为非盲，以及揭盲后数据处理规则","category":"source_not_retrieved","gap_id":"gap_blind_01","missing_source_classes":["本项目IWRS揭盲操作规范","盲态维持人员范围定义"],"target":"4.4 盲法与揭盲——盲态维持人员范围"}],"heading":"盲法与揭盲","missing_source_classes":["本项目IWRS揭盲操作规范","盲态维持人员范围定义"],"proposal_text":"本研究采用双盲设计，受试者按1:1:1比例随机分配至KZ-NC401低剂量组、高剂量组与安慰剂对照组。安慰剂外观、口味与活性药一致，由不参与评估的药师发放以维持盲态。紧急揭盲借助IWRS中揭盲参与者功能进行，研究者登录IWRS系统并使用该功能，输入揭盲原因后获知受试者使用的实际药物，IWRS系统将记录紧急揭盲人员、原因和时间。有紧急揭盲权限的研究者在研究启动前完成紧急揭盲的相关培训。受试者被揭盲后将终止试验用药品治疗。","rationale":"双盲设计、1:1:1分配、安慰剂外观口味一致及药师发放维持盲态取自当前项目已确认研究事实。紧急揭盲流程描述取自公司语料结构参照（CMD-D001-AD II期方案），本项目是否采用相同IWRS揭盲路径及培训要求需医学经理确认。","review_advisories":["本节复述高影响研究设计（盲法与揭盲）；请在合并设计摘要中统一核对。","本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_b098c78a17682044","section_number":"4.4","source_ids":["protocol_full_draft_selection:5986c2e13f4875ea61efa803","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb71242d679bdb","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322"]}],"source_bindings":[{"content_sha256":"d65fa96fc1be17152bfd298b8f2ab9bf6fe60501fb02e06d63d692d245253f04","locator":"document:mwdoc_greenfield_proj_user_da3dadfaef61_9398bdf768fa86cc:full-dr