sories":[],"evidence_span_ids":["es_005","es_006","es_007","es_008"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"确认'剂量探索部分安全导入了隐藏的安慰剂对照，确证部分两剂量组+安慰剂'的序贯推进逻辑是否在本方案中体现为两阶段设计，还是统一描述为三臂平行设计。","category":"decision_pending","gap_id":"gap_4_sequential_design","missing_source_classes":[],"target":"4 研究设计"},{"action":"补充DMC审查频率、触发标准及沟通机制。","category":"source_missing","gap_id":"gap_4_dmc_detail","missing_source_classes":["DMC章程或审查计划"],"target":"4 研究设计"}],"heading":"研究设计","missing_source_classes":["DMC章程或审查计划","序贯推进设计详细方案（若适用）"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂平行对照的II期概念验证与剂量探索研究，在中国开展。受试者按1:1:1比例随机分配至KZ-NC401低剂量组（25 mg晨服）、KZ-NC401高剂量组（75 mg晨服）和安慰剂对照组，共三组。随机化采用分层区组随机方法，分层因素为基线猝倒有无（是/否）与地区。研究设置独立数据监查委员会（DMC）对安全性数据进行定期审查。本研究不采用自适应设计，不计划期中分析，不设置安全审查委员会（SRC）。研究时期包括筛选期（不超过28天）、双盲治疗期（12周）和安全随访期（4周）。","rationale":"总体设计要素（多中心、随机、双盲、安慰剂平行对照、1:1:1、DMC、无自适应/期中/SRC）及研究时期（筛选≤28天、治疗12周、随访4周）均已在项目研究定义中确认。分层因素（猝倒有无、地区）来源于安慰剂与对照描述。医学经理需确认：（1）'剂量探索部分安全导入了隐藏的安慰剂对照'与'确证部分两剂量组+安慰剂'的序贯推进逻辑是否在本方案中作为两阶段设计描述，还是统一为三臂平行设计；（2）DMC审查频率及触发标准；（3）安全随访期是否所有受试者均进入。","review_advisories":["本节复述高影响研究设计（研究设计）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（期中分析）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_03fa5fe935e41761","section_number":"4","source_ids":["protocol_full_draft_selection:256a638a2669b81ab0087940","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7"]},{"ai_run_id":"airun_20261009003604_40cb56f4","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"多中心、随机、双盲、安慰剂平行对照 II期概念验证与剂量探索研究；受试者1:1:1随机至三个剂量组序贯推进（剂量探索部分安全导入了隐藏的安慰剂对照），确证部分两剂量组+安慰剂。","quote_sha256":"d52e03c6bbb7265a389ad0d63f4d719a2700bacb8d9721ab5d89e23e1a16142c","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_005"},{"locator":"document:mwdoc_greenfield_proj_user_da3dadfaef61_9398bdf768fa86cc:full-draft:256a638a2669b81ab0087940","quote":"随机化；双盲；安慰剂对照；平行组；多中心；设置独立数据监查委员会（DMC）","quote_sha256":"6450935204c952de9a1386cd7302806bc0614ad879abfc9cd9bee935286169c3","source_id":"protocol_full_draft_selection:256a638a2669b81ab0087940","span_id":"es_006"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"DMC是否计划：是","quote_sha256":"9967a9a75297ced2326ab733fa3b16934acdef641fa765dd50c1cd58219f4aa5","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_007"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"自适应设计是否计划：否","quote_sha256":"c71bda4d6101542f8a3c2bb0087631982c72176be9ca9a2526dc2c08ed0ee52a","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_008"}],"evidence_review_advisories":[],"evidence_span_ids":["es_005","es_006","es_007","es_008"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"确认双盲的具体实施范围：受试者、研究者、疗效评价者、药师、数据监查人员各自的盲态安排。","category":"source_missing","gap_id":"gap_41_blinding_scope","missing_source_classes":["盲法操作细则"],"target":"4.1 总体设计"},{"action":"补充DMC审查频率及安全性触发标准。","category":"source_missing","gap_id":"gap_41_dmc_frequency","missing_source_classes":["DMC章程或审查计划"],"target":"4.1 总体设计"}],"heading":"总体设计","missing_source_classes":["盲法操作细则（各角色盲态范围）","DMC审查计划"],"proposal_text":"本研究采用多中心、随机、双盲、安慰剂平行对照设计。受试者按1:1:1比例随机分配至三个治疗组：KZ-NC401低剂量组（25 mg每日一次晨服）、KZ-NC401高剂量组（75 mg每日一次晨服，第3周起由25 mg滴定至75 mg）和安慰剂对照组。随机化采用分层区组方法，分层因素为基线猝倒有无（是/否）与地区。双盲通过外观、口味与活性药一致的安慰剂实现，由不参与疗效评估的药师负责药物发放以维持盲态。研究设置独立数据监查委员会（DMC）对累积安全性数据进行定期审查。本研究不采用自适应设计，不计划期中分析，不设置安全审查委员会（SRC）。","rationale":"设计关键词（随机化、双盲、安慰剂对照、平行组、多中心、DMC）已在章节包中列出。1:1:1分配、剂量（25 mg/75 mg）、滴定方案（第1-2周25 mg，高剂量组第3周起75 mg）、分层因素（猝倒有无、地区）、安慰剂外观一致及药师发放维持盲态等细节来源于项目研究定义。DMC确认设置，自适应/期中/SRC确认不采用。医学经理需确认：（1）盲法具体范围（受试者、研究者、评价者、药师各自盲态）是否需在本节明确列出；（2）DMC审查频率；（3）滴定方案中'第1-2周25 mg'是否适用于高剂量组起始。","review_advisories":["本节复述高影响研究设计（总体设计）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（期中分析）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_73bce79f90d5aa44","section_number":"4.1","source_ids":["protocol_full_draft_selection:256a638a2669b81ab0087940","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7"]}],"source_bindings":[{"content_sha256":"1a5baf6c7344dc3cc29e16e9ec22a6b54855204d54bf40beaa0db89edcc898e7","locator":"document:mwdoc_greenfield_proj_user_da3dadfaef61_9398bdf768fa86cc:full-draft:256a638a2669b81ab0087940","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:256a638a2669b81ab0087940","source_type":"protocol_full_draft_selection","source_version":"full-draft:0a23c46d968d2956bfe3c207f38be7f5b3d7420a2c11ea1770996d13a41d1c19:256a638a2669b81ab0087940","text_sha256":"1a5baf6c7344dc3cc29e16e9ec22a6b54855204d54bf40beaa0db89edcc898e7"},{"content_sha256":"f5c7fc7ba4b1f896c6e8499f9f41260b8de51be15690bade1e7b5cf4179c4b66","locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","source_type":