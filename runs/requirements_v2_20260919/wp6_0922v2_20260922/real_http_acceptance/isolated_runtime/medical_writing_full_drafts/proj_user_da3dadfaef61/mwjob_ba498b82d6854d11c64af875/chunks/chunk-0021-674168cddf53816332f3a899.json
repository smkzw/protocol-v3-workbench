:"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_ssa"}],"evidence_review_advisories":[],"evidence_span_ids":["es_safety_endpoint_lab","es_hepatic_exclusion","es_ecg_exclusion","es_visit_strategy","es_ssa"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"确认本项目实验室检查项目清单（血常规、肝肾功能、电解质、血脂、尿常规、凝血功能等具体项目）及各访视采集频率","category":"source_missing","gap_id":"gap_lab_01","missing_source_classes":["项目实验室检查项目清单与采集频率"],"target":"14.2 实验室检查项目 具体检查项目清单与采集频率"},{"action":"确认实验室正常值范围表及异常结果分级处理与复查流程","category":"source_missing","gap_id":"gap_lab_02","missing_source_classes":["实验室正常值范围表","异常结果处理与复查流程"],"target":"14.2 实验室检查项目 正常值范围与异常处理"}],"heading":"实验室检查项目","missing_source_classes":["项目实验室检查项目清单与采集频率","实验室正常值范围表","异常结果处理与复查流程","中心实验室协议"],"proposal_text":"本研究的实验室检查项目涵盖安全性评估所需的临床实验室检测。依据已确认的安全性终点设计，临床实验室检查以较基线变化作为安全性评价维度，纳入治疗中出现的不良事件发生率与严重程度（CTCAE 5.0）评估框架，并在安全性分析集（SS）中进行描述性汇总。筛选期实验室检查用于排除有临床意义的肝肾功能异常，即丙氨酸氨基转移酶或天冬氨酸氨基转移酶超过2倍正常值上限，或估算肾小球滤过率低于50 mL/min/1.73m²者不得入组。筛选期12导联心电图检查中QTcF超过450ms或存在未控制的心律失常亦为排除条件。安全性随访期（V7，停药后4周内）安排安全性评估访视，该访视包含安全性相关实验室检查。","rationale":"已确认事实支持：安全性终点包含临床实验室检查较基线变化；排除标准明确ALT/AST>2×ULN及eGFR<50为排除阈值；筛选期ECG QTcF>450ms为排除条件；安全性分析采用SS集描述性汇总；V7为停药后4周内的安全性随访访视。但具体检查项目清单（如血常规、肝肾功能、电解质、血脂、尿常规等）、各访视是否均采集、正常值范围表及异常处理流程在允许来源中未列出，需项目实验室检查规程或中心实验室协议确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_91a72b62a506cc3c","section_number":"14.2","source_ids":["protocol_full_draft_selection:674168cddf53816332f3a899","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323"]}],"source_bindings":[{"content_sha256":"abc9512f8322873292694b19de218f0424a3bd688fdf072301cbeeeeea24aa86","locator":"document:mwdoc_greenfield_proj_user_da3dadfaef61_9398bdf768fa86cc:full-draft:674168cddf53816332f3a899","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:674168cddf53816332f3a899