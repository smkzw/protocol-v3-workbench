,"section_number":"5.5","source_ids":["protocol_full_draft_selection:9a74a3ea49885af21f969205","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]},{"ai_run_id":"airun_20261009004550_b136896b","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"多中心、随机、双盲、安慰剂平行对照 II期概念验证与剂量探索研究；受试者1:1:1随机至三个剂量组序贯推进（剂量探索部分安全导入了隐藏的安慰剂对照），确证部分两剂量组+安慰剂。","quote_sha256":"d52e03c6bbb7265a389ad0d63f4d719a2700bacb8d9721ab5d89e23e1a16142c","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_002"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"KZ-NC401 低剂量组（25 mg 晨服，口服）；KZ-NC401 高剂量组（75 mg 晨服，口服）；安慰剂对照组","quote_sha256":"3a37b3668299473634a393af0daf019103a521a14d2ac2566fe43a129876022f","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_003"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"分层因素为基线猝倒有无（是/否）与地区","quote_sha256":"e053f2f7455a1b18ddc8322877f8f7e28c15a6363a23dcff1607efb427277981","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_004"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"入组前正在使用莫达非尼/阿莫达非尼者须洗脱≥7天；入组前14天内使用羟丁酸钠或兴奋剂类药物者须洗脱；研究期间禁止合并使用其他促醒药物。","quote_sha256":"941d23fead4608f80f019252ac7240d9d914c84f21e2967c19f31c6ffec6e35b","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_009"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003","es_004","es_009"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"补充序贯推进设计的具体操作规范，明确隐藏安慰剂对照的导入时点、转换条件及与1:1:1随机分配的衔接方式","category":"source_missing","gap_id":"gap_6_001","missing_source_classes":["序贯推进与隐藏安慰剂对照实施流程"],"target":"剂量探索部分安全导入隐藏安慰剂对照后进入确证部分的具体实施流程"}],"heading":"研究治疗/干预","missing_source_classes":["序贯推进与隐藏安慰剂对照的具体实施流程"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂平行对照的II期概念验证与剂量探索研究。受试者按1:1:1比例随机分配至KZ-NC401低剂量组（25 mg每日一次晨服）、KZ-NC401高剂量组（75 mg每日一次晨服，经2周滴定后达到目标剂量）及安慰剂对照组。随机化采用分层区组方法，分层因素为基线猝倒有无（是/否）与地区。双盲治疗期共12周，治疗期访视窗口为±3天。入组前正在使用莫达非尼或阿莫达非尼的受试者须完成不少于7天的洗脱期；入组前14天内使用羟丁酸钠或兴奋剂类药物的受试者须完成相应洗脱；研究期间禁止合并使用其他促醒药物。随机前48小时内饮用含咖啡因或酒精饮料且可能影响基线多次睡眠潜伏期试验（MSLT）或维持觉醒试验（MWT）评估者，须推迟随机至符合条件后方可进行。","rationale":"总体设计（多中心、随机、双盲、安慰剂平行对照、1:1:1、分层因素）、剂量方案（25/75 mg、2周滴定、12周治疗期）、洗脱要求（莫达非尼≥7天、羟丁酸钠/兴奋剂14天、禁止合并促醒药）及咖啡因/酒精限制均来自项目研究定义修订版7。'序贯推进'与'隐藏安慰剂对照'的具体实施流程需医学经理确认。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_0ff776f419f2e81e","section_number":"6","source_ids":["protocol_full_draft_selection:9a74a3ea49885af21f969205","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]},{"ai_run_id":"airun_20261009004550_b136896b","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_da3dadfaef61_9398bdf768fa86cc:full-draft:9a74a3ea49885af21f969205","quote":"KZ-NC401（口服选择性食欲素2受体（OX2R）激动剂薄膜衣片）","quote_sha256":"8a432f0bbe048e278f104d85ad1ce8dbbdabfe36ecac879a4fe34c0acbda4c4c","source_id":"protocol_full_draft_selection:9a74a3ea49885af21f969205","span_id":"es_005"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"KZ-NC401（口服选择性食欲素2受体（OX2R）激动剂薄膜衣片）","quote_sha256":"8a432f0bbe048e278f104d85ad1ce8dbbdabfe36ecac879a4fe34c0acbda4c4c","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_006"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"KZ-NC401片口服：第1-2周 25 mg 每日一次（高剂量组第3周起增至75 mg 每日一次），晨起后30分钟内服用，连续给药至第12周；漏服当日不再补服；剂量出处：内部IB v2.3 §5.1（立项剂量方案）。","quote_sha256":"5ac56cf25a5f07e19f594fa7d93a24d91c5997359796316b8a2dce95bf7bbea4","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_007"},{"locator":"study_definition:mwdefinition_3079f2462aad3d3b0321:revision:7","quote":"安慰剂外观、口味与活性药一致并由不参与评估的药师发放以维持盲态。","quote_sha256":"dbd69e669e7bb6e1bc7e507a08ddbde13b1f09fdb7036853975572d3ae0c4bbd","source_id":"current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","span_id":"es_008"}],"evidence_review_advisories":[],"evidence_span_ids":["es_005","es_006","es_007","es_008"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"补充KZ-NC401及安慰剂的包装规格、储存温度与条件、各中心药物发放与回收操作规程及药物 accountability 记录方式","category":"source_missing","gap_id":"gap_6_1_001","missing_source_classes":["试验用药品包装储存与发放回收规范"],"target":"试验用药品包装规格、储存条件、发放与回收流程"}],"heading":"试验用药品","missing_source_classes":["试验用药品包装规格与储存条件","药物发放与回收流程","药物 accountability 记录规范"],"proposal_text":"本研究试验用药品为KZ-NC401（口服选择性食欲素2受体（OX2R）激动剂薄膜衣片），由申办方提供。活性药物以薄膜衣片形式口服给药，每日一次，晨起后30分钟内服用。低剂量组给予25 mg每日一次；高剂量组第1至2周给予25 mg每日一次，第3周起增至75 mg每日一次，连续给药至第12周。漏服当日不再补服，次日按原计划继续给药。安慰剂对照组接受与活性药外观、口味一致的安慰剂薄膜衣片，由不参与疗效评估的药师负责发放以维持盲态。","rationale":"药物名称、剂型（薄膜衣片）、给药途径（口服）、给药频率（每日一次晨服）、剂量（25/75 mg）、滴定方案（2周）、漏服规则（当日不补服）及安慰剂外观一致与药师发放规则均来自项目研究定义修订版7。试验用药品的包装规格、储存条件、发放与回收流程及药物 accountability 记录方式需补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_679eb83f7f2eec8f","section_number":"6.1","source_ids":["protocol_full_draft_selection:9a74a3ea49885af21f969205","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]},{"ai_run_id":"airun_20261009004550_b136896b","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"补充KZ-NC401完整IB v2.3（含§5.1剂量方案、非临床毒理学、首次人体试验数据）或等效的非临床与既往临床摘要文件","category":"source_missing","gap_id":"gap_6_1_1_001","missing_source_classes":["完整研究者手册","非临床药理学与毒理学数据","既往人体研究数据"],"target":"KZ-NC401药理作用机制、非临床数据与既往临床数据"},{"action":"补充睡眠瘫痪恶性加重、日间过度镇静相关事件及5-羟色胺综合征样事件的药理学机制依据、非临床信号及已知风险描述","category":"source_missing","gap_id":"gap_6_1_1_002","missing_source_classes":["药物已知风险与AESI药理学依据"],"target":"特别关注不良事件的药理学依据与已知风险"}],"heading":"研究药物信息","missing_source_classes":["KZ-NC401完整研究者手册（IB v2.3）","非临床药理学与毒理学研究摘要","既往人体研究安全性数据","药物作用机制与靶点药理学详述"],"proposal_text":"","rationale":"研究药物信息章节需包含KZ-NC401的药理作用机制、非临床药理学与毒理学数据、既往人体研究（含首次人体试验）的安全性数据、已知风险与特别关注不良事件的药理学依据、药物相互作用及已知禁忌等内容。项目研究定义中仅列出药物名称、靶点（OX2R激动剂）、剂型及特别关注不良事件类别（睡眠瘫痪恶性加重、日间过度镇静相关事件、5-羟色胺综合征样事件），但未提供完整研究者手册（IB v2.3）全文、非临床研究摘要或既往临床数据。剂量方案引用IB v2.3 §5.1但IB全文未纳入允许来源。在缺少上述核心来源的情况下，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_da3dadfaef61_cc037917bb0702df","section_number":"6.1.1","source_ids":["protocol_full_draft_selection:9a74a3ea49885af21f969205","current_project_study_definition:mwdefinition_3079f2462aad3d3b0321:r7:a61d6ff5087db323","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]}],"source_bindings":[{"content_sha256":"8205e762cb1557a51121a6b97f78925476d31b5ded5366809a9636394156de76","locator":"document:mwdoc_greenfield_proj_user_da3dadfaef61_9398bdf768fa86cc:full-draft:9a74a3ea49885af21f969205","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:9a74a3ea49885af21f969205","source_type":"protocol_full_draft_selection","source_version":"full-draft:0a23c46d968d2956bfe3c207f38be7f5b3d7420a2c11ea1770996d13a41d1c19:9a74a3ea49885af21f969205","text_sha256":"8205e762cb1557a51121a6b97f78925476d31b5ded5366809a9636394156de76"},{"content_sha256":"f5c7fc7ba4b1f896c6e8499f9f4