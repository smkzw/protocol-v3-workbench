te_sha256":"ed3fdeeb458362e8ec2062ccfdb54dabe86146616d3c09971d19582407bead01","source_id":"protocol_full_draft_selection:6f0f5efe9e550d8b28620e82","span_id":"es_005"},{"locator":"study_definition:mwdefinition_3d97108d3366061df3f5:revision:4","quote":"剂量与给药方案：SMOKE-r7-1Y口服sGC刺激剂（KZ-sGC701）：低剂量2.5 mg qd、中剂量5 mg qd、高剂量10 mg qd，每日晨起随餐口服","quote_sha256":"d05dca45edc8f8a950ab0a84a8f7afbf2e8a4c3a67bc4a75c652f4c386eb9aa1","source_id":"current_project_study_definition:mwdefinition_3d97108d3366061df3f5:r4:5a1a0a9e0a69e1f8","span_id":"es_008"},{"locator":"study_definition:mwdefinition_3d97108d3366061df3f5:revision:4","quote":"研究人群概述：18-75岁慢性稳定性HFrEF成人，LVEF≤40%，NYHA II-III级，筛选前已接受稳定GDMT至少4周仍有症状。","quote_sha256":"72a023c6cbe4c130d0a1b606bcb7a5f23951e6688551db211b4ba920374b47af","source_id":"current_project_study_definition:mwdefinition_3d97108d3366061df3f5:r4:5a1a0a9e0a69e1f8","span_id":"es_009"},{"locator":"study_definition:mwdefinition_3d97108d3366061df3f5:revision:4","quote":"样本量策略：II期探索性设计：每组约60例（共约240例），基于NT-proBNP组间差值文献效应量与80%把握度估算，用于概念验证与剂量选择。","quote_sha256":"5f598e1d608dd27ea2bd6080417002fe0f5e763c866e33ca8a5c13c697490e10","source_id":"current_project_study_definition:mwdefinition_3d97108d3366061df3f5:r4:5a1a0a9e0a69e1f8","span_id":"es_010"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003","es_004","es_005","es_008","es_009","es_010"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"获取KZ-sGC701非临床药效学研究报告及sGC-cGMP通路在HFrEF中的综述文献","category":"source_missing","gap_id":"gap_24_01","missing_source_classes":["非临床研究报告","病理生理学文献"],"target":"2.4节中sGC-cGMP通路在HFrEF病理生理中的具体作用机制描述"},{"action":"获取HFrEF中国流行病学数据、当前GDMT标准治疗方案及残余风险数据","category":"source_missing","gap_id":"gap_24_02","missing_source_classes":["流行病学数据","治疗指南","疾病负担数据"],"target":"2.4节中HFrEF疾病背景与治疗现状"},{"action":"检索NT-proBNP在HFrEF临床试验中作为替代终点的验证性文献","category":"source_missing","gap_id":"gap_24_03","missing_source_classes":["替代终点验证文献"],"target":"2.4节中NT-proBNP作为替代终点的文献依据"},{"action":"获取维利西呱等同类药物在心血管领域的已发表临床数据","category":"source_missing","gap_id":"gap_24_04","missing_source_classes":["同类药物临床文献"],"target":"2.4节中sGC刺激剂类药物的既往临床证据"}],"heading":"本研究的理论基础","missing_source_classes":["HFrEF流行病学、疾病负担及当前GDMT治疗现状数据","sGC-cGMP通路病理生理学文献及KZ-sGC701非临床数据","sGC刺激剂类药物既往临床证据","NT-proBNP作为替代终点的文献依据"],"proposal_text":"KZ-sGC701为口服可溶性鸟苷酸环化酶（sGC）刺激剂，属于小分子化合物，通过口服途径给药后产生全身性暴露。sGC刺激剂的作用机制为直接刺激可溶性鸟苷酸环化酶活性并增强内源性一氧化氮对sGC的敏感性，从而增加细胞内环磷酸鸟苷（cGMP）水平，促进血管平滑肌舒张、降低心脏前后负荷并改善心肌舒张功能。在射血分数降低的心力衰竭（HFrEF）中，NO-sGC-cGMP信号通路受损导致血管张力调节障碍和心肌重构，理论上sGC刺激剂可通过恢复该通路功能改善血流动力学和心室功能。本研究为II期概念验证与剂量探索研究，旨在初步评价KZ-sGC701在慢性稳定性HFrEF成人中的疗效信号和剂量-反应关系，为后续确证性研究提供剂量选择依据。研究采用随机、双盲、安慰剂对照、平行组、多中心设计，设置低剂量（2.5 mg每日一次）、中剂量（5 mg每日一次）和高剂量（10 mg每日一次）三个试验组及安慰剂对照组，按1:1:1:1比例随机分配，治疗期12周，所有受试者均联合标准指南指导的药物治疗（GDMT）背景。目标人群为18至75岁、LVEF≤40%、NYHA心功能II至III级、筛选前已接受稳定GDMT至少4周仍有心衰症状的慢性稳定性HFrEF成人。主要疗效评价以第12周NT-proBNP较基线的百分比变化为核心指标，辅以安全性与耐受性评估，以判断不同剂量水平的获益-风险特征。","rationale":"已确认事实支持：药物类别为口服sGC刺激剂（小分子、全身暴露）；研究定位为II期概念验证与剂量探索；三剂量水平（2.5/5/10 mg qd）与安慰剂1:1:1:1随机；12周治疗期；目标人群特征（18-75岁、LVEF≤40%、NYHA II-III、稳定GDMT≥4周）；主要终点为NT-proBNP百分比变化。sGC-cGMP通路机制描述为基于药物类别的合理推断，需医学经理确认是否准确反映KZ-sGC701的实际作用机制及非临床数据支持。本章节缺少HFrEF流行病学与疾病负担数据、当前GDMT残余风险数据、NT-proBNP作为替代终点的文献依据、sGC刺激剂类药物的既往临床证据及KZ-sGC701的非临床药效学/毒理学数据，上述内容需补充后方可完善。","review_advisories":["本节提及高影响设计信息（剂量选择）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_e2565be5bf67_a71503625eb1f94d","section_number":"2.4","source_ids":["protocol_full_draft_selection:6f0f5efe9e550d8b28620e82","current_project_study_definition:mwdefinition_3d97108d3366061df3f5:r4:5a1a0a9e0a69e1f8","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261006165911_8039ce2c","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_3d97108d3366061df3f5:revision:4","quote":"内在研究目的：概念验证（PoC）；剂量探索","quote_sha256":"2d096e242bbd65d0c9236718d79e77a388e84cb9640b99bd47662a6ce8faab31","source_id":"current_project_study_definition:mwdefinition_3d97108d3366061df3f5:r4:5a1a0a9e0a69e1f8","span_id":"es_004"},{"locator":"document:mwdoc_greenfield_proj_user_e2565be5bf67_49788393faefbb28:full-draft:6f0f5efe9e550d8b28620e82","quote":"主要终点：第12周NT-proBNP较基线的百分比变化（双盲期）。评价时间点：基线、第4/8/12周。","quote_sha256":"ed3fdeeb458362e8ec2062ccfdb54dabe86146616d3c09971d19582407bead01","source_id":"protocol_full_draft_selection:6f0f5efe9e550d8b28620e82","span_id":"es_005"},{"locator":"study_definition:mwdefinition_3d97108d3366061df3f5:revision:4","quote":"安全性终点：不良事件与严重不良事件发生率；症状性低血压与体位性低血压；生命体征（血压、心率）；肝肾功能、电解质实验室指标；12导联心电图","quote_sha256":"e77501ca084e2f1e9fa18684d494f2252570a19a158da14e097274f13b01fb6b","source_id":"current_project_study_definition:mwdefinition_3d97108d3366061df3f5:r4:5a1a0a9e0a69e1f8","span_id":"es_006"},{"locator":"study_definition:mwdefinition_3d97108d3366061df3f5:revision:4","quote":"剂量与给药方案：SMOKE-r7-1Y口服sGC刺激剂（KZ-sGC701）：低剂量2.5 mg qd、中剂量5 mg qd、高剂量10 mg qd，每日晨起随餐口服","quote_sha256":"d05dca45edc8f8a950ab0a84a8f7afbf2e8a4c3a67bc4a75c652f4c386eb9aa1","source_id":"current_project_study_definition:mwdefinition_3d97108d3366061df3f5:r4:5a1a0a9e0a69e1f8","span_id":"es_008"},{"locator":"study_definition:mwdefinition_3d97108d3366061df3f5:revision:4","quote":"研究时期：筛选期（第-28至-1天）；12周双盲治疗期（第0天随机给药至第12周）；治疗结束访视（第12周±3天）；安全随访期（末次给药后2周）","quote_sha256":"10c99dea1b0a818522b70098d13975242ac4a1084684b588ce76dbdbb8237f6c","source_id":"current_project_study_definition:mwdefinition_3d97108d3366061df3f5:r4:5a1a0a9e0a69e1f8","span_id":"es_011"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004","es_005","es_006","es_008","es_011"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"由医学经理确认是否设置次要疗效终点（如NYHA分级变化、6分钟步行距离、NT-proBNP绝对变化等）及其层级顺序","category":"source_missing","gap_id":"gap_3_01","missing_source_classes":["研究设计确认文件"],"target":"3节中次要目的和次要终点"},{"action":"由医学经理确认本研究是否设置探索性目的与终点；若不设置，应在方案中明确声明","category":"source_missing","gap_id":"gap_3_02","missing_source_classes":["研究设计确认文件"],"target":"3节中探索性目的与终点"},{"action":"由医学经理确认TEAE采集窗口（如首次给药至末次给药后2周）、AE/SAE分级标准及报告时限","category":"source_missing","gap_id":"gap_3_03","missing_source_classes":["安全性评估方案","AE/SAE定义文件"],"target":"3节中安全性终点的具体采集窗口与TEAE定义"}],"heading":"研究目的和终点","missing_source_classes":["次要终点具体内容与层级顺序","探索性目的与终点是否设置","NT-proBNP检测方法规格","安全性终点具体采集窗口与TEAE定义"],"proposal_text":"本研究为II期概念验证与剂量探索研究，旨在初步评价口服sGC刺激剂KZ-sGC701在慢性稳定性射血分数降低的心力衰竭（HFrEF）成人中的疗效信号、剂量-反应关系及安全性与耐受性特征，为后续确证性研究的剂量选择和方案设计提供依据。研究设置主要目的和主要终点、安全性目的和安全性终点。主要目的为评价KZ-sGC701三个剂量水平（2.5 mg、5 mg、10 mg每日一次）与安慰剂相比对HFrEF患者NT-proBNP水平的影响，主要终点为第12周NT-proBNP较基线的百分比变化（双盲期），评价时间点为基线、第4周、第8周和第12周。安全性目的为评价KZ-sGC701在12周治疗期及末次给药后2周安全随访期内的安全性与耐受性，安全性终点包括不良事件与严重不良事件发生率、症状性低血压与体位性低血压发生率、生命体征（血压、心率）变化、肝肾功能及电解质实验室指标变化、12导联心电图变化。次要目的和次要终点按预先设定的层级顺序进行分析，具体终点内容及其层级排列依据后续研究设计确认结果确定。","rationale":"已确认事实支持：研究目的为概念验证与剂量探索；主要终点为第12周NT-proBNP较基线百分比变化，评价时间点为基线、第4/8/12周；安全性终点涵盖AE/SAE、症状性低血压、生命体征、肝肾功能电解质、心电图；研究时期含12周双盲治疗期和末次给药后2周安全随访期；三剂量水平为2.5/5/10 mg qd；次要终点按预先层级顺序分析。次要终点具体内容、层级顺序及探索性目的/终点是否设置未在允许来源中明确，需医学经理确认。","review_advisories":["本节复述高影响研究设计（研究目的和终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、剂量选择）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_e2565be5bf67_4bd712f1563a5002","section_number":"3","source_ids":["protocol_full_draft_selection:6f0f5efe9e550d8b28620e82","current_project_study_definition:mwdefinition_3d97108d3366061df3f5:r4:5a1a0a9e0a69e1f8","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261006165911_8039ce2c","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_e2565be5bf67_49788393faefbb28:full-draft:6f0f5efe9e550d8b28620e82","quote":"主要终点：第12周NT-proBNP较基线的百分比变化（双盲期）。评价时间点：基线、第4/8/12周。","quote_sha256":"ed3fdeeb458362e8ec2062ccfdb54dabe86146616d3c09971d19582407bead01","source_id":"protocol_full_draft_selection:6f0f5efe9e550d8b28620e82","span_id":"es_005"},{"locator":"study_definition:mwdefinition_3d97108d3366061df3f5:revision:4","quote":"安全性终点：不良事件与严重不良事件发生率；症状性低血压与体位性低血压；生命体征（血压、心率）；肝肾功能、电解质实验室指标；12导联心电图","quote_sha256":"e77501ca084e2f1e9fa18684d494f2252570a19a158da14e097274f13b01fb6b","source_id":"current_project_study_definition:mwdefinition_3d97108d3366061df3f5:r4:5a1a0a9e0a69e1f8","span_id":"es_006"},{"locator":"study_definition:mwdefinition_3d97108d3366061df3f5:revision:4","quote":"统计分析策略：FAS为主要分析集；主要终点NT-proBNP百分比变化采用ANCOVA（基线校正）并检验剂量-反应趋势；安全性采用描述统计；次要终点按预先层级顺序分析。","quote_sha256":"9cf37f0df8f4d6bd00beb8c92cebe88f07431911c16227896760d446ca13e075","source_id":"current_project_study_definition:mwdefinition_3d97108d3366061df3f5:r4:5a1a0a9e0a69e1f8","span_id":"es_007"},{"locator":"study_definition:mwdefinition_3d97108d3366061df3f5:revision:4","quote":"剂量与给药方案：SMOKE-r7-1Y口服sGC刺激剂（KZ-sGC701）：低剂量2.5 mg qd、中剂量5 mg qd、高剂量10 mg qd，每日晨起随餐口服","quote_sha256":"d05dca45edc8f8a950ab0a84a8f7afbf2e8a4c3a67bc4a75c652f4c386eb9aa1","source_id":"current_project_study_definition:mwdefinition_3d97108d3366061df3f5:r4:5a1a0a9e0a69e1f8","span_id":"es_008"},{"locator":"study_definition:mwdefinition_3d97108d3366061df3f5:revision:4","quote":"研究时期：筛选期（第-28至-1天）；12周双盲治疗期（第0天随机给药至第12周）；治疗结束访视（第12周±3天）；安全随访期（末次给药后2周）","quote_sha256":"10c99dea1b0a818522b70098d13975242ac4a1084684b588ce76dbdbb8237f6c","source_id":"current_project_study_definition:mwdefinition_3d97108d3366061df3f5:r4:5a1a0a9e0a69e1f8","span_id":"es_011"},{"locator":"study_definition:mwdefinition_3d97108d3366061df3f5:revision:4","quote":"估计目标策略：治疗策略（treatment policy）：无论是否剂量调整或合并用药变化，均按随机分组分析；终点前事件按复合策略处理。","quote_sha256":"eb44177581223de72875983b0f1d70b25c2bbcf98304d5b17e2c2764beca8e56","source_id":"current_project_study_definition:mwdefinition_3d97108d3366061df3f5:r4:5a1a0a9e0a69e1f8","span_id":"es_012"},{"locator":"study_definition:mwdefinition_3d97108d3366061df3f5:revision:4","quote":"访视策略：V0筛选（-28~-1d）：病史、查体、ECHO、实验室、NT-proBNP、ECG\nV1随机入组（D0）\nV2（W4）：疗效与安全性评价\nV3（W8）：疗效与安全性评价\nV4治疗结束（W12±3d）：主要终点评价与全面安全性\nV5安全随访（W14）：AE转归确认","quote_sha256":"800eb16ea146eb75477b7e06d79039e3bd9771113065a3435efd6a8add9b994d","source_id":"current_project_study_definition:mwdefinition_3d97108d3366061df3f5:r4:5a1a0a9e0a69e1f8","span_id":"es_015"}],"evidence_review_advisories":[],"evidence_span_ids":["es_005","es_006","es_007","es_008","es_011","es_012","es_015"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"确认NT-proBNP检测所用试剂盒、检测方法及中心实验室安排","category":"source_missing","gap_id":"gap_31_01","missing_source_classes":["实验室操作手册","检测方法验证文件"],"target":"3.1节中NT-proBNP检测方法规格"},{"action":"由医学经理确认TEAE采集窗口（首次给药至末次给药后2周或其他）、AE/SAE分级标准（CTCAE版本或MedDRA编码规则）及报告时限","category":"source_missing","gap_id":"gap_31_02","missing_source_classes":["安全性评估方案","AE/SAE定义文件"],"target":"3.1节中安全性终点采集窗口与TEAE定义"},{"action":"由医学经理确认是否设置次要疗效终点（如NYHA分级、6MWD、NT-proBNP绝对变化等）及探索性目的/终点","category":"source_missing","gap_id":"gap_31_03","missing_source_classes":["研究设计确认文件"],"target":"3.1节中次要终点及探索性终点"}],"heading":"主要目的和主要终点","missing_source_classes":["NT-proBNP检测方法规格（试剂盒、实验室）","TEAE采集窗口与AE/SAE定义","安全性评估具体操作规范"],"proposal_text":"本研究的主要目的为评价口服sGC刺激剂KZ-sGC701三个剂量水平（低剂量2.5 mg每日一次、中剂量5 mg每日一次、高剂量10 mg每日一次）与安慰剂相比，在12周双盲治疗期内对慢性稳定性HFrEF成人NT-proBNP水平的影响，并初步判断剂量-反应关系。主要终点为第12周NT-proBNP较基线的百分比变化（双盲期）。NT-proBNP的评价时间点为基线（第0天随机入组前）、第4周、第8周和第12周（治疗结束访视，第12周±3天）。主要终点分析采用全分析集（FAS），以ANCOVA方法校正基线NT-proBNP水平，同时检验三个剂量组与安慰剂组之间的剂量-反应趋势。估计目标策略采用治疗策略（treatment policy），即无论是否发生剂量调整或合并用药变化，均按随机分组进行分析；终点前事件按复合策略处理。安全性评价方面，在12周双盲治疗期及末次给药后2周安全随访期内，收集并评价不良事件与严重不良事件发生率、症状性低血压与体位性低血压、生命体征（血压、心率）、肝肾功能及电解质实验室指标、12导联心电图。安全性数据采用描述性统计方法进行分析。","rationale":"已确认事实支持：主要终点为第12周NT-proBNP较基线百分比变化（双盲期），评价时间点为基线、第4/8/12周；三剂量水平2.5/5/10 mg qd；FAS为主要分析集；ANCOVA基线校正并检验剂量-反应趋势；治疗策略估计目标；安全性终点涵盖AE/SAE、症状性低血压、生命体征、肝肾功能电解质、心电图；安全性采用描述统计；研究时期含12周双盲治疗期和末次给药后2周安全随访期；访视安排V4为W12±3d治疗结束访视、V5为W14安全随访。NT-proBNP具体检测方法（试剂盒、实验室）及安全性终点的具体采集窗口、TEAE定义、AE/SAE报告时限需医学经理确认。","review_advisories":["本节复述高影响研究设计（主要目的和主要终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、估计目标）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_e2565be5bf67_5283c7c91b97efdb","section_number":"3.1","source_ids":["protocol_full_draft_selection:6f0f5efe9e550d8b28620e82","current_project_study_definition:mwdefinition_3d97108d3366061df3f5:r4:5a1a0a9e0a69e1f8","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]}],"source_bindings":[{"content_sha256":"d6a6b25afe66635c7dbc9d89f0edf3183d085e91e2e5ce0dc90e43847fd7bc62","locator":"document:mwdoc_greenfield_proj_user_e2565be5bf67_49788393faefbb28:full-draft:6f0f5efe9e550d8b28620e82","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:6f0f5efe9e550d8b28620e82","source_type":"protocol_full_draft_selection","source_version":"full-draft:d519f967563a17d858c8172ca444156281e46886329da10243dc596acb44ca2a:6f0f5efe9e550d8b28620e82","text_sha256":"d6a6b25afe66635c7dbc9d89f0edf3183d085e91e2e5ce0dc90e43847fd7bc62"},{"content_sha256":"6d872a5d330042a0fed2ab0409c25d8804e975f69e9e32b552baac05df33233d","locator":"study_definition:mwdefinition_3d97108d3366061df3f5:revision:4","role":"confir