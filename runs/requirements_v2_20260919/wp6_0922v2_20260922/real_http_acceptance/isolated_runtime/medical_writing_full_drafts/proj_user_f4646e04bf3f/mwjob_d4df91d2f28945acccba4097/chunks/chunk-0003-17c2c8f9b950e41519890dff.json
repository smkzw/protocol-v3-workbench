a2050095a31f08358c5e40311f","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es39"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"开发区域：中国","quote_sha256":"cff843d358ea50e7e53ede8d1eba9b9d23baa740d2cd2134679e6483c3e50b76","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es40"},{"locator":"document:mwdoc_greenfield_proj_user_f4646e04bf3f_32980b414dd10a90:full-draft:17c2c8f9b950e41519890dff","quote":"随机化；双盲；安慰剂对照；平行组；多中心","quote_sha256":"2390eec78cb63fbb744f4d0cd34ca9e3a52cae7420fe7f7e88f4c2d12a283514","source_id":"protocol_full_draft_selection:17c2c8f9b950e41519890dff","span_id":"es41"}],"evidence_review_advisories":[],"evidence_span_ids":["es1","es2","es3","es4","es5","es6","es7","es8","es9","es10","es11","es12","es13","es14","es15","es16","es17","es18","es19","es20","es21","es22","es23","es24","es25","es26","es27","es28","es29","es30","es31","es32","es33","es34","es35","es36","es37","es38","es39","es40","es41"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":40},"gap_items":[{"action":"需补充KZ-HS501非临床PK/PD数据及同类TYK2抑制剂II/III期剂量-效应数据，以论证5mg/15mg/30mg三剂量层选择的合理性","category":"source_missing","gap_id":"gap_4_1","missing_source_classes":["非临床PK/PD报告","同类药物临床文献"],"target":"4.2.1 剂量选择依据"},{"action":"需补充KZ-HS501人体PK参数及PD标志物定量数据，以确定具体采血时间点","category":"source_missing","gap_id":"gap_4_2","missing_source_classes":["人体PK/PD数据","IB中PK/PD章节"],"target":"4.2.2 PK/PD采集点设计依据"},{"action":"需确认本项目FAS、SS、PPS的具体成员判定规则及PPS中重大方案偏离排除条款","category":"source_not_retrieved","gap_id":"gap_4_3","missing_source_classes":["本项目统计分析计划（SAP）草案"],"target":"4.1 总体设计-分析集定义"}],"heading":"研究设计","missing_source_classes":["KZ-HS501研究者手册（IB）","非临床药代动力学与毒理学完整报告","同类TYK2抑制剂既往临床数据"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂平行对照的II期临床研究，在中国开展，旨在对KZ-HS501（口服选择性TYK2变构抑制剂缓释片）治疗中重度化脓性汗腺炎进行概念验证与剂量探索。研究采用平行组设计，设5mg、15mg、30mg三个KZ-HS501剂量层及一个匹配安慰剂组，组间按1:1:1:1比例随机分配，随机化按基线HAS-IHS疼痛评分与Hurley分期进行分层。研究人群为18至75岁成人中重度化脓性汗腺炎（Hurley II至III期）受试者，既往对规范口服抗生素治疗（≥3个月）应答不佳或不能耐受既往治疗，筛选时具有可按HAS-IHS评分量化的活动性炎性结节与脓肿。研究时期包括4周筛选期、52周双盲治疗期（其中第0至12周为剂量探索期，第12至52周为PoC确证期）及4周安全性随访期。主要疗效终点为第16周HiSCR75应答率（炎性结节与脓肿总数较基线减少≥75%且无脓肿、无瘘管增加），评价时间点为第16周，比较30mg和15mg剂量层与安慰剂。主要安全性终点为治疗期严重不良事件及导致研究药物停药的不良事件发生率（至第52周）。主要分析采用CMH检验（按Hurley分期与基线疼痛NRS分层校正），关键次要终点按固定序列层级控制整体I类错误。主要估计目标为治疗策略估计，所有随机化受试者按原随机分组分析，对过早停药或接受禁用治疗者第16周视为无应答。本研究不设置自适应设计、样本量再估计、期中分析、SRC或DMC。样本量基于安慰剂组HiSCR75约20%、30mg组预期45%的应答差（Δ=25%），α=0.05（双单侧0.025）、把握度90%，每组约45例，四组共约180例，考虑15%脱落放大至每组52例、共208例。","rationale":"本章正文依据当前项目已确认研究事实中的总体研究设计、研究时期、主要终点、估计目标策略、样本量策略、统计分析策略及排除自适应/期中分析/DMC等条目撰写。剂量选择依据与PK/PD采集点设计依据的具体论证内容分别归属4.2.1和4.2.2章节，本章不重复展开。医学经理需核实：第16周主要终点评价时点与12周剂量探索期结束的逻辑衔接是否准确；样本量计算中安慰剂组20%与30mg组45%的假设来源；固定序列中关键次要终点的具体排列顺序。","review_advisories":["本节复述高影响研究设计（研究设计）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（α、估计目标、期中分析、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f4646e04bf3f_1dd0c61be9932706","section_number":"4","source_ids":["protocol_full_draft_selection:17c2c8f9b950e41519890dff","current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","company_corpus:cms_cn_protocol_corpus_20260715_v1:7450f8d809500d","company_corpus:cms_cn_protocol_corpus_20260715_v1:1b6c27dfbf7041"]},{"ai_run_id":"airun_20261011025025_c3617e62","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"多中心、随机、双盲、安慰剂平行对照","quote_sha256":"2dfd4e064d04034366adac07622a48c5993658eb249b46118ddf0ce93eaf7ea5","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es1"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"KZ-HS501缓释片（5mg/15mg/30mg薄膜衣片）每日一次口服，每次一片，整片吞服不可掰开、压碎或咀嚼，空腹或餐后均可（固定各自给药条件）","quote_sha256":"4b675a2522f6681e2227262d30cac686858a29a102eff5959172c766df094806","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es11"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"安慰剂缓释片同法每日一次口服","quote_sha256":"fcc65b14cf13e67449f0ef507d4645023aa2f8b515fc628429d5b27e6ae04d90","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es12"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"组间1:1:1:1平行分组（5mg/15mg/30mg剂量层与安慰剂），分层随机（按基线HAS-IHS疼痛评分与Hurley分期分层）","quote_sha256":"a61e35fd3f74e586f75e15e4e8bddc2fc50dc9e2c20f368c99dcc59abe342cda","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es13"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"本研究设12周双盲剂量探索期（5mg/15mg/30mg三剂量层与安慰剂平行）与40周双盲PoC期，连续给药共52周","quote_sha256":"3177d9a95ba6034b56f0e7a9553ceac746980616998334cc5cdcb96769636f38","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es14"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"筛选期4周；双盲治疗期52周（含第0–12周剂量探索期与第12–52周PoC确证期）；安全性随访4周","quote_sha256":"5b2cae71bb9c1e20d78f66db02259528e7215d504ef6326703215ea9b718b73c","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es15"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"访视策略：筛选（V1，第−4至−1周）；基线（V2，第0周，随机给药）；剂量探索期每2周随访（第2/4/6/8/10/12周）；PoC期每4周随访（第16/20/24/28/32/36/40/44/48周）；第52周终访（HiSCR评估、病灶计数、DLQI）；第56周安全性随访（AE、实验室、生命体征）","quote_sha256":"0dff7b5c0839064d75565835a9bac8fd6c8f066028fb7c4404517a1fb3ba652d","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es21"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"漏服当日不补服，次日正常继续","quote_sha256":"f996171b7ba5280ad2dfd23e9d94ba869b0d76022af3e8180ed5bcbbe6862213","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es36"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"安慰剂缓释片对照（外观、气味、规格与KZ-HS501匹配），每日一次口服，用法与试验组一致","quote_sha256":"2e88dccfd7d3c5d34c99a3e98467a94d06c4669fcbcedfb27690d6a7a53e429e","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es37"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"分配模型：平行组","quote_sha256":"5e70b0bc5b3a55e709991ab54941ee36f3a7e04e4d8d776ac74298515efc5ab1","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es38"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"中心模式：多中心","quote_sha256":"2cfa68bc992967c797bbd3113b5e0d0844d660a2050095a31f08358c5e40311f","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es39"},{"locator":"document:mwdoc_greenfield_proj_user_f4646e04bf3f_32980b414dd10a90:full-draft:17c2c8f9b950e41519890dff","quote":"随机化；双盲；安慰剂对照；平行组；多中心","quote_sha256":"2390eec78cb63fbb744f4d0cd34ca9e3a52cae7420fe7f7e88f4c2d12a283514","source_id":"protocol_full_draft_selection:17c2c8f9b950e41519890dff","span_id":"es41"}],"evidence_review_advisories":[],"evidence_span_ids":["es1","es11","es12","es13","es14","es15","es21","es36","es37","es38","es39","es41"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":11},"gap_items":[],"heading":"总体设计","missing_source_classes":[],"proposal_text":"本研究采用多中心、随机、双盲、安慰剂平行对照设计。试验干预为KZ-HS501缓释片（5mg/15mg/30mg薄膜衣片）每日一次口服，每次一片，整片吞服不可掰开、压碎或咀嚼，空腹或餐后均可（固定各自给药条件）；对照为匹配安慰剂缓释片（外观、气味、规格与KZ-HS501匹配），每日一次口服，用法与试验组一致。漏服当日不补服，次日正常继续。组间按1:1:1:1比例平行分组（5mg/15mg/30mg剂量层与安慰剂），采用分层随机化，分层因素为基线HAS-IHS疼痛评分与Hurley分期。研究设12周双盲剂量探索期（5mg/15mg/30mg三剂量层与安慰剂平行）与40周双盲PoC期，连续给药共52周。访视安排为：筛选访视（V1，第−4至−1周）；基线访视（V2，第0周，随机给药）；剂量探索期每2周随访（第2、4、6、8、10、12周）；PoC期每4周随访（第16、20、24、28、32、36、40、44、48周）；第52周终访（含HiSCR评估、病灶计数、DLQI）；第56周安全性随访（含AE、实验室检查、生命体征）。","rationale":"本章正文依据当前项目已确认研究事实中的给药方案、安慰剂描述、分组比例、分层随机化因素、研究时期划分及访视策略撰写。盲法范围在允许来源中未明确列出具体盲态人员，故本章仅陈述双盲设计事实。医学经理需核实：各访视具体实施的检查项目是否在每个访视均执行；DLQI采集时点是否仅限第16周与第52周；第56周安全性随访中实验室检查与生命体征的具体项目清单。","review_advisories":["本节复述高影响研究设计（总体设计）；请在合并设计摘要中统一核对。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f4646e04bf3f_d33cd2c2c786ae89","section_number":"4.1","source_ids":["protocol_full_draft_selection:17c2c8f9b950e41519890dff","current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","company_corpus:cms_cn_protocol_corpus_20260715_v1:7450f8d809500d","company_corpus:cms_cn_protocol_corpus_20260715_v1:1b6c27dfbf7041"]},{"ai_run_id":"airun_20261011025025_c3617e62","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取KZ-HS501非临床PK/PD完整报告及IB中剂量选择章节，补充动物暴露量-效应关系及安全边际计算","category":"source_missing","gap_id":"gap_421_1","missing_source_classes":["非临床PK/PD报告","IB"],"target":"4.2.1 剂量选择依据"},{"action":"检索同类TYK2抑制剂II/III期剂量-效应文献，作为剂量层选择的辅助参考","category":"source_missing","gap_id":"gap_421_2","missing_source_classes":["同类药物临床文献"],"target":"4.2.1 剂量选择依据"}],"heading":"剂量选择依据","missing_source_classes":["KZ-HS501非临床药代动力学报告","KZ-HS501非临床药效学报告","食蟹猴4周毒理完整报告","同类TYK2抑制剂II/III期剂量-效应文献"],"proposal_text":"","rationale":"剂量选择依据章节需要KZ-HS501的非临床药代动力学数据、非临床药效学数据、食蟹猴4周毒理NOAEL 20mg/kg的暴露量-毒性关系外推至人体的安全边际计算，以及同类TYK2抑制剂在II/III期研究中的剂量-效应数据，方可论证5mg/15mg/30mg三剂量层选择的合理性。当前允许来源仅确认食蟹猴4周毒理NOAEL 20mg/kg及暂无人体安全性数据，不足以构建完整的剂量选择论证链。","review_advisories":["本节复述高影响研究设计（剂量选择依据）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f4646e04bf3f_e07df2bc462400e1","section_number":"4.2.1","source_ids":["protocol_full_draft_selection:17c2c8f9b950e41519890dff","current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","company_corpus:cms_cn_protocol_corpus_20260715_v1:7450f8d809500d","company_corpus:cms_cn_protocol_corpus_20260715_v1:1b6c27dfbf7041"]},{"ai_run_id":"airun_20261011025025_c3617e62","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取KZ-HS501人体PK数据或非临床PK时间曲线，确定半衰期、达峰时间及稳态时间","category":"source_missing","gap_id":"gap_422_1","missing_source_classes":["人体PK数据","非临床PK报告"],"target":"4.2.2 PK/PD采集点设计依据"},{"action":"获取PD标志物的体内时间-效应数据，确定PD采样时点与频率","category":"source_missing","gap_id":"gap_422_2","missing_source_classes":["PD标志物动力学数据"],"target":"4.2.2 PK/PD采集点设计依据"}],"heading":"PK/PD采集点设计依据","missing_source_classes":["KZ-HS501人体PK数据","KZ-HS501非临床PK时间曲线","KZ-HS501 PD标志物动力学数据","KZ-HS501研究者手册中PK/PD章节"],"proposal_text":"","rationale":"PK/PD采集点设计依据章节需要KZ-HS501的人体药代动力学参数及药效学标志物的定量数据，方可确定具体采血时间点及PD采样频率。当前允许来源明确记载暂无人体PK数据，且未提供非临床PK时间曲线或PD标志物动力学参数。公司语料中CMS-D017方案虽设有PK/PD采集点设计依据章节标题，但其为不同药物、不同适应症、不同设计，其具体采集点不可迁移至本项目。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f4646e04bf3f_34077fc11897accd","section_number":"4.2.2","source_ids":["protocol_full_draft_selection:17c2c8f9b950e41519890dff","current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","company_corpus:cms_cn_protocol_corpus_20260715_v1:7450f8d809500d","company_corpus:cms_cn_protocol_corpus_20260715_v1:1b6c27dfbf7041"]}],"source_bindings":[{"content_sha256":"79357e9701770e9ac8f8dfbc8ccbefe2d6f2da717fb97cea3e671a3c85fcc751","locator":"document:mwdoc_greenfield_proj_user_f4646e04bf3f_32980b414dd10a90:full-draft:17c2c8f9b950e41519890dff","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:17c2c8f9b950e41519890dff","source_type":"protocol_full_draft_selection","source_version":"full-draft:3f113b3078eeadf627add85b70f8595012efb68d7ada6f6ed893a92c895ebf13:17c2c8f9b950e41519890dff","text_sha256":"79357e9701770e9ac8f8dfbc8ccbefe2d6f2da717fb97cea3e671a3c85fcc751"},{"content_sha256":"bc4292fbd9da1f3f8068cfc21dddd39f03e0987afbe785dc729755092025cd55","locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","source_type":"current_project_study_definition","source_version":"mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","text_sha256":"bc4292fbd9da1f3f8068cfc21dddd39f03e0987afbe785dc729755092025cd55"},{"content_sha256":"33118fc6958419e645c6a0a19471c78f80e0c4c28be03b46f2b3e61d287e0305","locator":"section:文档开头|block:26|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","source_type":"company_protocol_reference_corpus","source_version":"63ce4061f946ca","text_sha256":"33118fc6958419e645c6a0a19471c78f