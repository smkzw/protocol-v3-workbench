b1","section_number":"2.3.2","source_ids":["protocol_full_draft_selection:9dd8d1f17348024d12d1f7f4","current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261011023930_a568c350","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"TYK2选择性抑制（与TYK2假激酶JH2结构域结合，抑制IL-23与IL-12下游JAK-STAT信号转导）","quote_sha256":"701bb2116f26f3ae166e3ab6389e616c739faad066edde5249df9666a490e43d","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es2"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"内在研究目的：概念验证（PoC）；剂量探索","quote_sha256":"2d096e242bbd65d0c9236718d79e77a388e84cb9640b99bd47662a6ce8faab31","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es3"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"主要终点：第16周达到HiSCR75（化脓性汗腺炎临床应答，炎性结节与脓肿总数较基线减少≥75%且无脓肿、无瘘管增加）的受试者比例；评价时间点为第16周（30mg/15mg剂量层与安慰剂比较）。","quote_sha256":"2e75656de40496fe41ccadc34362d2bb90fa4049ec804d9e4d6ddcc5c8b6dec0","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es4"}],"evidence_review_advisories":[],"evidence_span_ids":["es2","es3","es4"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"检索并补充HS全球及中国流行病学数据、疾病负担文献及现行诊疗指南（如中国HS诊疗指南、EADV/ADD指南），以完善疾病背景综述。","category":"source_not_retrieved","gap_id":"gap_2_4_01","missing_source_classes":["流行病学文献","诊疗指南"],"target":"2.4 本研究的理论基础 - 疾病背景与流行病学"},{"action":"补充HS皮损中IL-23/IL-12表达上调及JAK-STAT通路激活的文献证据（含PMID），以支撑从疾病机制到药物靶点的逻辑链。","category":"source_not_retrieved","gap_id":"gap_2_4_02","missing_source_classes":["发病机制文献","PubMed外部文献"],"target":"2.4 本研究的理论基础 - 发病机制证据链"},{"action":"若存在同适应症（HS）竞品方案背景段落，可作为结构参照；当前允许来源中无HS竞品方案样本，按学术结构撰写。","category":"source_missing","gap_id":"gap_2_4_03","missing_source_classes":["竞品方案背景段落"],"target":"2.4 本研究的理论基础 - 竞品方案背景参照"}],"heading":"本研究的理论基础","missing_source_classes":["HS流行病学与疾病负担文献","HS发病机制文献（IL-23/IL-12/JAK-STAT在HS中的证据）","现行HS诊疗指南","竞品方案背景/疾病背景段落"],"proposal_text":"化脓性汗腺炎（Hidradenitis Suppurativa，HS）是一种以毛囊闭塞和慢性炎症为特征的复发性、破坏性炎症性皮肤病，好发于腋窝、腹股沟、肛周及乳房下等顶泌汗腺分布区域，中重度患者常表现为反复脓肿、窦道形成和瘢痕挛缩，严重影响生活质量。现有证据提示，HS的慢性炎症微环境中IL-23和IL-12等促炎细胞因子持续高表达，其下游信号转导依赖JAK-STAT通路，其中TYK2作为JAK家族成员参与IL-23受体和IL-12受体的信号级联，驱动Th17/Th1细胞分化及中性粒细胞募集，从而维持毛囊周围慢性化脓性炎症。KZ-HS501为口服选择性TYK2变构抑制剂，通过与TYK2假激酶JH2结构域结合，稳定其自抑制构象，从而抑制IL-23与IL-12下游JAK-STAT信号转导，在理论上可阻断HS关键致病炎症轴。鉴于HS的炎症驱动机制与TYK2介导的细胞因子信号通路存在交集，且KZ-HS501在食蟹猴4周毒理试验中未观察到不良反应剂量（NOAEL）为20 mg/kg，对人JAK1/JAK2/JAK3选择性倍数较高，本研究拟通过多中心、随机、双盲、安慰剂平行对照的II期设计，在5 mg、15 mg和30 mg三个剂量层与安慰剂1:1:1:1随机分组，以第16周HiSCR75应答率为主要疗效指标，同时评估疼痛NRS变化、HiSCR50/90比例、脓肿与炎性结节计数变化、DLQI变化及应答维持时间等次要指标，以验证TYK2选择性抑制在化脓性汗腺炎中的概念有效性并完成剂量探索。","rationale":"本章节依据项目已确认的靶点/作用机制（TYK2选择性抑制、JH2结构域结合、IL-23/IL-12/JAK-STAT通路）、研究目的（PoC与剂量探索）、总体设计（多中心、随机、双盲、安慰剂平行对照）、剂量方案（5/15/30 mg每日一次）、主要终点（第16周HiSCR75）及次要终点撰写。HS疾病背景中IL-23/IL-12/JAK-STAT通路的描述来源于项目事实中的机制表述，但缺少HS流行病学数据、疾病负担文献、现行诊疗指南及竞品方案背景段落作为外部证据支撑；建议医学经理补充HS流行病学与发病机制文献以完善疾病背景综述，并核实IL-23/IL-12在HS皮损中的具体证据等级。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f4646e04bf3f_f5abce93e4b169bb","section_number":"2.4","source_ids":["protocol_full_draft_selection:9dd8d1f17348024d12d1f7f4","current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261011023930_a568c350","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"内在研究目的：概念验证（PoC）；剂量探索","quote_sha256":"2d096e242bbd65d0c9236718d79e77a388e84cb9640b99bd47662a6ce8faab31","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es3"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"主要终点：第16周达到HiSCR75（化脓性汗腺炎临床应答，炎性结节与脓肿总数较基线减少≥75%且无脓肿、无瘘管增加）的受试者比例；评价时间点为第16周（30mg/15mg剂量层与安慰剂比较）。","quote_sha256":"2e75656de40496fe41ccadc34362d2bb90fa4049ec804d9e4d6ddcc5c8b6dec0","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es4"}],"evidence_review_advisories":[],"evidence_span_ids":["es3","es4"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"确认DLQI是否仅在主要终点访视（第16周）和终访（第52周）采集，还是每个访视均采集；不得由较基线变化自行推断所有访视均实施。","category":"source_not_retrieved","gap_id":"gap_3_01","missing_source_classes":["量表采集时点定义"],"target":"3 研究目的和终点 - DLQI采集时点"},{"action":"确认TEAE采集窗口（首次给药至末次给药后多少天）、研究结束时点定义及安全性评估窗口；不得自行定义。","category":"source_not_retrieved","gap_id":"gap_3_02","missing_source_classes":["安全性评估窗口定义"],"target":"3 研究目的和终点 - 安全性评估窗口"},{"action":"确认HS相关严重感染事件的统计检验方法、在固定序列中的层级位置及与主要终点的I类错误控制关系。","category":"source_not_retrieved","gap_id":"gap_3_03","missing_source_classes":["统计分析计划","固定序列层级定义"],"target":"3 研究目的和终点 - 关键次要终点统计策略"}],"heading":"研究目的和终点","missing_source_classes":["DLQI量表版本与授权文件","HiSCR75/50/90量表操作手册","安全性评估窗口定义","AESI报告标准与分级"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂平行对照的II期临床研究，旨在评估口服选择性TYK2变构抑制剂KZ-HS501缓释片（5 mg、15 mg、30 mg，每日一次）治疗中重度化脓性汗腺炎（Hurley II–III期）成人受试者的疗效与安全性，完成概念验证与剂量探索。主要疗效终点为第16周达到HiSCR75（化脓性汗腺炎临床应答，炎性结节与脓肿总数较基线减少≥75%且无脓肿、无瘘管增加）的受试者比例，评价时间点为第16周，比较对象为30 mg和15 mg剂量层与安慰剂。次要疗效终点包括：第16周疼痛NRS较基线变化、HiSCR50与HiSCR90应答比例、脓肿与炎性结节计数较基线变化、皮肤病学生活质量指数（DLQI）较基线变化、达到HiSCR75的应答维持时间。关键次要终点为≥1例任何结局的HS相关严重感染事件。主要安全性终点为治疗期严重不良事件（SAE）与导致研究药物停药的不良事件发生率（至第52周）。次要安全性终点包括TEAE发生率与严重程度、特别关注不良事件（AESI）发生率（感染、肝酶升高、血脂异常、中性粒细胞减少）、生命体征与实验室检查较基线变化。特别关注的不良事件涵盖感染（机会性感染、结核再激活）、肝功能异常（ALT/AST>3×ULN伴胆红素升高）、血脂异常（LDL-C显著升高）、中性粒细胞减少（ANC<1.0×10⁹/L）、恶性肿瘤与严重心血管事件。","rationale":"本章节依据项目已确认的研究目的（PoC与剂量探索）、总体设计（多中心、随机、双盲、安慰剂平行对照）、剂量方案（5/15/30 mg每日一次）、主要终点（第16周HiSCR75）、次要疗效终点（疼痛NRS、HiSCR50/90、脓肿与炎性结节计数、DLQI、应答维持时间）、关键次要终点（HS相关严重感染事件）、安全性终点（SAE、TEAE、AESI）及AESI具体类别撰写。需医学经理确认：（1）第16周HiSCR75评价时间点与PoC期（第12–52周）设计逻辑的一致性；（2）DLQI采集时点是否仅限第16周及第52周终访，还是包含其他访视；（3）关键次要终点HS相关严重感染事件的统计检验策略与层级位置；（4）AESI中感染与机会性感染、结核再激活的层级关系及报告标准。","review_advisories":["本节复述高影响研究设计（研究目的和终点）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f4646e04bf3f_37882ca096f65bb5","section_number":"3","source_ids":["protocol_full_draft_selection:9dd8d1f17348024d12d1f7f4","current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261011023930_a568c350","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"恢复本章节正文与当前项目来源的证据绑定后重新核对。","category":"mapping_failed","gap_id":"gap:evidence-binding","missing_source_classes":[],"target":"mwsec_greenfield_proj_user_f4646e04bf3f_285dc1a1378dd4e9"}],"heading":"探索性