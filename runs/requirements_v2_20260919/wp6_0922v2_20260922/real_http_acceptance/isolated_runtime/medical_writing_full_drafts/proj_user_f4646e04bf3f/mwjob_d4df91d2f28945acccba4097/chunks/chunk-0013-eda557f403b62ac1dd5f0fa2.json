s":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取KZ-HS501 IB或等效完整非临床安全性资料，以支撑研究药物已知风险、潜在风险及AESI机制关联性的实质描述","category":"source_missing","gap_id":"gap_drug_risk_ib","missing_source_classes":["研究者手册（IB）或等效非临床安全性完整报告","KZ-HS501完整毒理学报告（含安全药理学、遗传毒性、生殖毒性）"],"target":"8.3节正文"},{"action":"获取既往人体安全性数据及人体PK/PD数据，以评估人体暴露量与NOAEL的安全边际","category":"source_missing","gap_id":"gap_drug_risk_human","missing_source_classes":["既往人体安全性数据（含I期或海外研究）","人体PK/PD数据"],"target":"8.3节正文"},{"action":"获取药物警戒风险评估与风险管理计划，以明确AESI监测与干预策略","category":"source_missing","gap_id":"gap_drug_risk_pvp","missing_source_classes":["药物警戒风险评估与风险管理计划"],"target":"8.3节正文"}],"heading":"研究药物相关风险","missing_source_classes":["研究者手册（IB）或等效非临床安全性完整报告","既往人体安全性数据（含I期或海外研究）","药物警戒风险评估与风险管理计划","KZ-HS501完整毒理学报告（含安全药理学、遗传毒性、生殖毒性）"],"proposal_text":"","rationale":"项目研究事实中列出了特别关注不良事件类别（感染含机会性感染与结核再激活、肝功能异常ALT/AST>3×ULN伴胆红素升高、血脂异常LDL-C显著升高、中性粒细胞减少ANC<1.0×10⁹/L、恶性肿瘤与严重心血管事件）及食蟹猴4周毒理NOAEL 20mg/kg、暂无人体安全性数据、暂无人体PK数据、对人JAK1/JAK2/JAK3选择性倍数高等信息。但研究药物相关风险章节需要IB或等效的完整非临床安全性报告、既往人体安全性数据、药物警戒风险评估及风险管理计划等核心来源，当前仅有AESI类别列表和单条毒理摘要，不足以构成完整的风险评估正文。","review_advisories":["本节复述高影响研究设计（研究药物相关风险）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f4646e04bf3f_39fdc451d50e831a","section_number":"8.3","source_ids":["protocol_full_draft_selection:eda557f403b62ac1dd5f0fa2","current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","company_corpus:cms_cn_protocol_corpus_20260715_v1:3f194f5112122b","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976"]},{"ai_run_id":"airun_20261011033025_4c2f2dd9","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取本项目TEAE定义、AE采集窗口（起始与终止时点）、安全性评估窗口及随访终点定义","category":"source_missing","gap_id":"gap_ae_collection_window","missing_source_classes":["项目级AE采集窗口与分类标准文件","TEAE定义与安全性评估窗口定义"],"target":"8.4节正文"},{"action":"获取AE/SAE报告对象（申办方、伦理、药监）、报告时限、报告表格式及eCRF记录规范","category":"source_missing","gap_id":"gap_ae_reporting","missing_source_classes":["AE/SAE报告对象与时限规定","eCRF记录规范与数据核查要求"],"target":"8.4节正文"},{"action":"获取本项目妊娠事件处理流程（是否纳入AE、报告路径、随访要求）；公司语料中妊娠条款为单份I期方案措辞惯例，不可直接作为本项目规则","category":"source_missing","gap_id":"gap_pregnancy_handling","missing_source_classes":["妊娠事件处理与报告流程文件"],"target":"8.4节正文"}],"heading":"不良事件的采集与记录","missing_source_classes":["项目级AE采集窗口与分类标准文件","AE/SAE报告对象与时限规定","eCRF记录规范与数据核查要求","妊娠事件处理与报告流程文件"],"proposal_text":"","rationale":"本项目已确认安全性随访期为4周（第52周终访至第56周安全性随访），安全性终点包含TEAE发生率与严重程度、AESI发生率及生命体征与实验室检查较基线变化。但允许来源中未提供本项目AE采集窗口定义（从何时起算、至何时结束）、AE分类标准（CTCAE版本）、因果关系判定方法、AE/SAE报告对象与时限、eCRF记录规范、妊娠事件处理流程等项目级文件。公司语料中有一条关于'将AE及随访信息记录在可溯源的参与者病历及严重不良事件报告表上'的措辞惯例和一条关于妊娠相关SAE 24小时内报告的条款，均为单份I期方案来源，仅可作为结构参考，不可直接作为本项目已确认规则。在缺少项目级AE采集与记录规范文件的情况下，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f4646e04bf3f_4a36fe264c42bff6","section_number":"8.4","source_ids":["protocol_full_draft_selection:eda557f403b62ac1dd5f0fa2","current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","company_corpus:cms_cn_protocol_corpus_20260715_v1:3f194f5112122b","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976"]}],"source_bindings":[{"content_sha256":"9119cc15e42210fceb139dd67b45278018496dd14c242bd2efdadda2f9aae5e9","locator":"document:mwdoc_greenfield_proj_user_f4646e04bf3f_32980b414dd10a90:full-draft:eda557f403b62ac1dd5f0fa2","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:eda557f403b62ac1dd5f0fa2","source_type":"protocol_full_draft_selection","source_version":"full-draft:3f113b3078eeadf627add85b70f8595012efb68d7ada6f6ed893a92c895ebf13:eda557f403b62ac1dd5f0fa2","text_sha256":"9119cc15e4