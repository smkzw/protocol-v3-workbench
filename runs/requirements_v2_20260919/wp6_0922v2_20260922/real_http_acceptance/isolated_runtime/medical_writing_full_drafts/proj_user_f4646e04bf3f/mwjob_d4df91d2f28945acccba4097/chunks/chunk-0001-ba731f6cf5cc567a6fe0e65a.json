口服选择性TYK2变构抑制剂缓释片）","quote_sha256":"e9d3aaf5ea7a203b379f2e6d5fa0520dd680759602685652ce1b415eb35e5b4b","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es3"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"适应症：化脓性汗腺炎（Hidradenitis Suppurativa，中重度）","quote_sha256":"99738ec2b9cee20bbd183ab9bed1cef7a1f0bdbaeeff73fbb4199259a79d1be4","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es4"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"研究分期：II期","quote_sha256":"0cd03d3b6552ef4d709f859513123058d34ed8e8f0e5ae9b9b7e718967255947","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es5"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"开发区域：中国","quote_sha256":"cff843d358ea50e7e53ede8d1eba9b9d23baa740d2cd2134679e6483c3e50b76","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es6"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"内在研究目的：概念验证（PoC）；剂量探索","quote_sha256":"2d096e242bbd65d0c9236718d79e77a388e84cb9640b99bd47662a6ce8faab31","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es7"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"靶点/作用机制：TYK2选择性抑制（与TYK2假激酶JH2结构域结合，抑制IL-23与IL-12下游JAK-STAT信号转导）","quote_sha256":"813e33b8813ea7edbd33e8ee5e703a1260314b695c400a2066721aade9e962f4","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es8"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"总体研究设计：多中心、随机、双盲、安慰剂平行对照","quote_sha256":"66366de8bec32d970dc336b327d8116b62330e446365c505f50110feaaba1462","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es9"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"目标研究人群：年龄段：成人；疾病状态：中重度；经治情况：经治疗效不佳；中重度化脓性汗腺炎（HS）成人受试者","quote_sha256":"d59ade6c067f24ad6992121969e5645faa3f38ed6aeadac2cde6f2e7e1b96e42","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es10"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"分配模型：平行组","quote_sha256":"5e70b0bc5b3a55e709991ab54941ee36f3a7e04e4d8d776ac74298515efc5ab1","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es11"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"中心模式：多中心","quote_sha256":"2cfa68bc992967c797bbd3113b5e0d0844d660a2050095a31f08358c5e40311f","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es12"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"自适应设计是否计划：否","quote_sha256":"c71bda4d6101542f8a3c2bb0087631982c72176be9ca9a2526dc2c08ed0ee52a","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es13"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"样本量再估计是否计划：否","quote_sha256":"913a62236e4f4332a7188562f2625d53aa7f770cea155664564c5fb821a98efd","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es14"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"期中分析是否计划：否","quote_sha256":"31ef70e7f5cd03d6c17b90802e7352c6e81b5fdc853989b74ea1499901f514a4","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es15"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"SRC是否计划：否","quote_sha256":"c313c8ef9ed6e2107818bc5d2c8caa143c85bf55ac51060b4e8cc53c959daf6e","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es16"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"DMC是否计划：否","quote_sha256":"7463c7eb67cd6a318d836f289e02648d5296c8dfe0b2f415f8f2bed6e14be4a2","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es17"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"药物技术类型：small_molecule","quote_sha256":"d8ca21a7e62cbca0e65228c7147e2ce5e59273b60f0d0cc55ed216f48e27710c","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es18"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"给药途径：口服","quote_sha256":"404b058b755608a73d13b54521a28c02b129df449774d0671b1c3f8b8a5ce42c","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es19"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"剂型：缓释片（口服固体制剂）；拟规格5mg/15mg/30mg薄膜衣片","quote_sha256":"5d7aeaaf3efbef5caa2df0ac658498c4db445f5a5b62efcdf21ecdb054d5b3ed","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es20"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"局部/系统暴露范围：systemic","quote_sha256":"83a8469236905f60f11fec86f93234f3ddf2027482e82bafa90802a6e138e6e2","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es21"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"产品安全性关注点：食蟹猴4周毒理NOAEL 20mg/kg；暂无人体安全性数据","quote_sha256":"3e0eb7188eaa64438ba639ee88a916763161e1ab4c72388b6e32932a76665c50","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es22"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"药理/PK/PD考虑：暂无人体PK数据；对人JAK1/JAK2/JAK3选择性倍数高","quote_sha256":"10381853034ef4a106b50a51931a7f4979f3f4fa72bee00d22cd0f6c2160d9e5","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es23"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"研究人群概述：18–75岁成人中重度化脓性汗腺炎（Hurley II–III期）受试者，既往治疗应答不佳（如规范口服抗生素治疗≥3个月仍有活动性病变）或不能耐受既往治疗；筛选时具有活动性炎性结节与脓肿、可按HAS-IHS评分量化评估；能够理解并签署知情同意。","quote_sha256":"c5552c15efc3a83ff6f23cbd672c8130a08c5b9322dc68f25112c9d10dfc4137","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es24"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"入选标准模块：既往对规范治疗（口服抗生素≥3个月）应答不佳，或对既往治疗不能耐受，或适合接受系统性治疗。","quote_sha256":"4c6a9862f24ea03f0fb9285c094c4b903ab713487489363d8b2e6133f76a60b8","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es25"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"排除标准模块：筛选时ALT或AST>3×ULN，或eGFR<60 mL/min/1.73m²；既往任何恶性肿瘤病史（已充分治疗的皮肤基底细胞癌除外）。","quote_sha256":"9ffe619f728508ff4906e3a4d3aae63e6cada8ecf525abdb1fb4b83994d2a7a6","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es26"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"试验干预：试验组接受KZ-HS501缓释片口服，每日一次；对照为匹配安慰剂缓释片。本研究设12周双盲剂量探索期（5mg/15mg/30mg三剂量层与安慰剂平行）与40周双盲PoC期，连续给药共52周。","quote_sha256":"48314759ad7e8fa4d7eed4f2855b3550e871e2e1f36ec4d68ad1c5951c23e15d","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es27"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"剂量与给药方案：KZ-HS501（口服选择性TYK2变构抑制剂缓释片）：KZ-HS501缓释片（5mg/15mg/30mg薄膜衣片）每日一次口服，每次一片，整片吞服不可掰开、压碎或咀嚼，空腹或餐后均可（固定各自给药条件）；安慰剂缓释片同法每日一次口服；漏服当日不补服，次日正常继续。","quote_sha256":"9080282b10b79da8400d2a07ec81446fcbb5c6f29790cfb634f23608768e9dbf","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es28"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"安慰剂：安慰剂缓释片对照（外观、气味、规格与KZ-HS501匹配），每日一次口服，用法与试验组一致；组间1:1:1:1平行分组（5mg/15mg/30mg剂量层与安慰剂），分层随机（按基线HAS-IHS疼痛评分与Hurley分期分层）。","quote_sha256":"0194335b3fbcc78201e22dff2e6076905865f743307a5ff9727e24f3992557e0","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es29"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"对照：安慰剂缓释片对照（外观、气味、规格与KZ-HS501匹配），每日一次口服，用法与试验组一致；组间1:1:1:1平行分组（5mg/15mg/30mg剂量层与安慰剂），分层随机（按基线HAS-IHS疼痛评分与Hurley分期分层）。","quote_sha256":"f70a6d5b2ed5f9adfc15b29715d148f1eba64f3a5ec0883be66cdd4bdba5fcde","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es30"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"主要终点：主要终点：第16周达到HiSCR75（化脓性汗腺炎临床应答，炎性结节与脓肿总数较基线减少≥75%且无脓肿、无瘘管增加）的受试者比例；评价时间点为第16周（30mg/15mg剂量层与安慰剂比较）。","quote_sha256":"3c52e7bdc19690247cff42969868dc84dfa7667229adb7f98ab6d6610bbdc115","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es31"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"关键次要终点：≥1例任何结局的HS相关严重感染事件","quote_sha256":"cdba4d59c602ba1ddf4c86fa917f4cc5259d9b9522a81dafe0c176182944dcea","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es32"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"其他次要终点：次要疗效终点：第16周疼痛NRS较基线变化、HiSCR50/90比例、脓肿与炎性结节计数变化、皮肤病学生活质量指数（DLQI）较基线变化、达到HiSCR75的应答维持时间。","quote_sha256":"4a0d8c0fe37d1c9a3104c6e152fe8853a4078d4de72bacba35d20aef31f94638","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es33"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"安全性终点：主要安全性终点：治疗期严重不良事件（SAE）与导致研究药物停药的不良事件发生率（至第52周）。次要安全性终点：TEAE发生率与严重程度、AESI发生率（感染、肝酶升高、血脂异常、中性粒细胞减少）、生命体征与实验室检查较基线变化。","quote_sha256":"b00551f7374559caa9f87948e046843c6f40c7429d2bee4de8daa1b650fd3eb2","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es34"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"特别关注的不良事件：感染（机会性感染、结核再激活）、肝功能异常（ALT/AST>3×ULN伴胆红素升高）、血脂异常（LDL-C显著升高）、中性粒细胞减少（ANC<1.0×10⁹/L）、恶性肿瘤与严重心血管事件。","quote_sha256":"745ea9eaac97e83f2bac5509897779e3a32dd86394485fc6c815f706dd906b22","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es35"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"研究时期：研究时期：筛选期4周；双盲治疗期52周（含第0–12周剂量探索期与第12–52周PoC确证期）；安全性随访4周。","quote_sha256":"e34916cd3803c92459e21a3d71811442cd003cfd5b68011f57f3336ac8b25508","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es36"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"访视策略：访视策略：筛选（V1，第−4至−1周）；基线（V2，第0周，随机给药）；剂量探索期每2周随访（第2/4/6/8/10/12周）；PoC期每4周随访（第16/20/24/28/32/36/40/44/48周）；第52周终访（HiSCR评估、病灶计数、DLQI）；第56周安全性随访（AE、实验室、生命体征）。","quote_sha256":"ce3446bca8ec6745a37837d0dbc4d629bba00bb15962c6facfabb2f77935bc5e","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es37"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"估计目标策略：估计目标策略：主要估计目标为治疗策略估计（treatment policy）：所有随机化受试者按原随机分组分析，不论依从性；主要终点变量为第16周HiSCR75二分类结局；对过早停药或接受禁用治疗者第16周视为无应答（非应答填补）；敏感性分析采用符合方案集估计。","quote_sha256":"c581c351b3dacdb38e20f2e622f7ae47e603593164c07089ecb2ad853d8408e7","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es38"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"样本量策略：样本量策略：基于安慰剂组HiSCR75约20%、30mg组预期45%的第16周应答差（Δ=25%），α=0.05（双单侧0.025）、把握度90%，每组约45例，四组共约180例（考虑15%脱落放大至每组52例、共208例）。","quote_sha256":"0440ec0251b4b1f02737bb9845169f054c2172c9bfd53f03a76358cb842cf0ea","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es39"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"统计分析策略：统计分析策略：主要分析采用CMH检验（按Hurley分期与基线疼痛NRS分层校正）比较各剂量组与安慰剂第16周HiSCR75比例，报告率差及95%CI；关键次要终点按固定序列（fixed-sequence）层级控制整体I类错误；敏感性分析（PP集、替代填补）与亚组分析支持性呈现；安全性分析采用安全性分析集描述性汇总。","quote_sha256":"45feb1a5df396f90cbb61ecc5234bf6154cc5cd5cd221bc851a781d7cdc43ab2","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es40"}],"evidence_review_advisories":[],"evidence_span_ids":["es1","es2","es3","es4","es5","es6","es7","es8","es9","es10","es11","es12","es13","es14","es15","es16","es17","es18","es19","es20","es21","es22","es23","es24","es25","es26","es27","es28","es29","es30","es31","es32","es33","es34","es35","es36","es37","es38","es39","es40"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":40},"gap_items":[],"heading":"方案概要","missing_source_classes":[],"proposal_text":"本研究为KZ-HS501（口服选择性TYK2变构抑制剂缓释片）用于治疗中重度化脓性汗腺炎（Hidradenitis Suppurativa，Hurley II–III期）的II期临床研究，方案编号MW-II-847F2D95-DRAFT，开发区域为中国。研究内在目的为概念验证（PoC）与剂量探索。研究采用多中心、随机、双盲、安慰剂平行对照设计，不设自适应设计、样本量再估计、期中分析、SRC或DMC。目标人群为18至75岁成人中重度化脓性汗腺炎（Hurley II–III期）受试者，既往对规范口服抗生素治疗（≥3个月）应答不佳、不能耐受既往治疗或适合接受系统性治疗；筛选时须具有活动性炎性结节与脓肿，可按HAS-IHS评分量化评估。排除标准包括筛选时ALT或AST>3×ULN、eGFR<60 mL/min/1.73m²，以及既往任何恶性肿瘤病史（已充分治疗的皮肤基底细胞癌除外）。试验干预为KZ-HS501缓释片（5mg/15mg/30mg薄膜衣片）每日一次口服，每次一片，整片吞服，空腹或餐后均可（固定各自给药条件）；对照为外观、气味、规格与KZ-HS501匹配的安慰剂缓释片，每日一次口服，用法与试验组一致。组间按1:1:1:1平行分组（5mg/15mg/30mg剂量层与安慰剂），分层随机因素为基线HAS-IHS疼痛评分与Hurley分期。漏服当日不补服，次日正常继续。研究时期包括筛选期4周、双盲治疗期52周（第0至12周为剂量探索期，第12至52周为PoC确证期）及安全性随访4周。主要疗效终点为第16周达到HiSCR75（炎性结节与脓肿总数较基线减少≥75%且无脓肿、无瘘管增加）的受试者比例，评价时间点为第16周，比较30mg和15mg剂量层与安慰剂。关键次要终点为≥1例任何结局的HS相关严重感染事件。其他次要疗效终点包括第16周疼痛NRS较基线变化、HiSCR50/90比例、脓肿与炎性结节计数变化、DLQI较基线变化及达到HiSCR75的应答维持时间。主要安全性终点为治疗期SAE与导致研究药物停药的不良事件发生率（至第52周）；次要安全性终点包括TEAE发生率与严重程度、AESI发生率（感染、肝酶升高、血脂异常、中性粒细胞减少）及生命体征与实验室检查较基线变化。特别关注的不良事件涵盖感染（机会性感染、结核再激活）、肝功能异常（ALT/AST>3×ULN伴胆红素升高）、血脂异常（LDL-C显著升高）、中性粒细胞减少（ANC<1.0×10⁹/L）、恶性肿瘤与严重心血管事件。样本量基于安慰剂组HiSCR75约20%、30mg组预期45%的第16周应答差（Δ=25%），α=0.05（双单侧0.025）、把握度90%，每组约45例，四组共约180例；考虑15%脱落放大至每组52例、共208例。主要分析采用CMH检验（按Hurley分期与基线疼痛NRS分层校正）比较各剂量组与安慰剂第16周HiSCR75比例，报告率差及95%CI；关键次要终点按固定序列层级控制整体I类错误；敏感性分析采用符合方案集估计与替代填补；安全性分析采用安全性分析集描述性汇总。主要估计目标为治疗策略估计，所有随机化受试者按原随机分组分析，不论依从性；对过早停药或接受禁用治疗者第16周视为无应答。","rationale":"本章正文依据当前项目研究定义草案中已确认的设计事实（研究题目、分期、设计类型、人群、干预、终点、样本量、统计策略、估计目标）撰写。样本量208例、剂量规格、12+40周分期、第16周HiSCR75主要终点、CMH检验及fixed-sequence等参数均为草案阶段设定，需医学经理与统计团队联合确认后方可定稿。访视策略中各访视具体检查项目（实验室、生命体征、心电图等）未在本章展开，由访视流程章节规定。","review_advisories":["本节复述高影响研究设计（方案概要）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（α、估计目标、期中分析、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f4646e04bf3f_a98316833578e1d4","section_number":"1","source_ids":["protocol_full_draft_selection:ba731f6cf5cc567a6fe0e65a","current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:76a6125fa7dca4","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc6f8c9ea6d34b"]},{"ai_run_id":"airun_20261011023146_940a142d","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"检索并纳入化脓性汗腺炎中国及全球流行病学数据（患病率、发病率、疾病负担、经济负担）","category":"source_missing","gap_id":"gap_2_1_epidemiology","missing_source_classes":["流行病学文献","疾病负担报告"],"target":"疾病背景及治疗现状章节——流行病学与疾病负担段落"},{"action":"纳入现行HS诊疗指南（如中国HS诊疗共识、欧洲S2k指南、美国AAD指南等）及当前系统治疗格局","category":"source_missing","gap_id":"gap_2_1_guidelines","missing_source_classes":["诊疗指南","治疗格局综述"],"target":"疾病背景及治疗现状章节——现有治疗与指南段落"},{"action":"基于流行病学、指南和治疗格局来源撰写未满足需求及本研究立题逻辑","category":"source_missing","gap_id":"gap_2_1_unmet_need","missing_source_classes":["未满足需求分析","立题依据"],"target":"疾病背景及治疗现状章节——未满足需求与本研究立题段落"}],"heading":"疾病背景及治疗现状","missing_source_classes":["化脓性汗腺炎流行病学与疾病负担数据","中国或国际HS诊疗指南","当前HS系统治疗格局与未满足需求综述","竞品方案疾病背景/治疗格局参考片段（同适应症）"],"proposal_text":"","rationale":"本章需要化脓性汗腺炎的流行病学数据（患病率、发病率、疾病负担）、现行诊疗指南（如中国或国际HS管理指南）及当前治疗格局（一线至三线系统治疗、生物制剂、手术等）来源方可撰写综述式正文。当前允许来源中无PubMed外部文献条目，无流行病学或指南类文件，无竞品方案背景/疾病背景/治疗格局片段可供结构参照。仅有当前项目研究定义中提及Hurley II–III期、HAS-IHS评分、炎性结节与脓肿、瘘管等疾病描述性术语，不足以构成有实质信息的疾病背景及治疗现状正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f4646e04bf3f_12fa3822a457a459","section_number":"2.1","source_ids":["protocol_full_draft_selection:ba731f6cf5cc567a6fe0e65a","current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:76a6125fa7dca4","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc6f8c9ea6d34b"]},{"ai_run_id":"airun_20261011023146_940a142d","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{