c4106385bd8903d6db8682b07159f5e32a24d1b0a95e378","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:fc2af7591dc952","span_id":"es_003"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"总体研究设计：多中心、随机、双盲、安慰剂平行对照","quote_sha256":"66366de8bec32d970dc336b327d8116b62330e446365c505f50110feaaba1462","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es_006"}],"evidence_review_advisories":[],"evidence_span_ids":["es_001","es_002","es_003","es_006"],"evidence_summary":{"corpus_spans":3,"project_fact_spans":1},"gap_items":[{"action":"由医学经理与合规团队确认各中心伦理委员会安排及主审制或独立审查模式","category":"source_missing","gap_id":"gap_ethics_001","missing_source_classes":["多中心伦理审查安排文件"],"target":"各中心伦理委员会名称、主审/备案伦理委员会指定及多中心伦理审查模式"},{"action":"由医学经理确认各中心伦理委员会跟踪审查要求","category":"source_missing","gap_id":"gap_ethics_002","missing_source_classes":["伦理跟踪审查SOP"],"target":"伦理跟踪审查频率、年度报告要求及方案偏离伦理报告路径"}],"heading":"伦理委员会","missing_source_classes":["各中心伦理委员会名称及审查模式文件","伦理跟踪审查频率及报告要求","SUSAR报告时限及路径的项目级操作规程"],"proposal_text":"本研究为在中国开展的多中心、随机、双盲、安慰剂平行对照II期临床研究，各参与研究中心均须获得所在机构伦理委员会的书面批准后方可启动受试者筛选与入组。伦理委员会审查范围涵盖研究方案及其修订、知情同意书、受试者招募材料、研究者手册及安全性信息更新等文件。研究执行期间，申办者须将可疑且非预期严重不良反应（SUSAR）快速报告给所有参加本临床试验的研究者、临床试验机构及伦理委员会，同时向药品监督管理部门和卫生健康主管部门报告。当药政当局、伦理委员会、研究者或申办者认为本研究存在重大安全性风险时，伦理委员会有权依据临床试验质量管理规范和当地法律法规，考虑参与者权益、安全和健康，决定暂停或终止本研究或停止特定受试者继续参与。各中心伦理委员会的跟踪审查频率、年度/定期报告要求及方案偏离的伦理报告路径，由申办者与主审伦理委员会在研究启动前协商确定。","rationale":"本段依据GCP框架下伦理委员会审查与监督的通用监管要求撰写，SUSAR报告路径和伦理委员会参与暂停/终止决策的表述来源于公司语料中两份独立方案（CMD-D001 AD II期方案与CMS-D017 I期方案）。多中心设计事实来源于本项目已确认研究定义。各中心伦理委员会名称、主审/备案模式、跟踪审查频率及具体报告时限等实施细节缺少项目文件，需医学经理与合规团队确认后补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f4646e04bf3f_9af20330d6ce7ba5","section_number":"11.3","source_ids":["protocol_full_draft_selection:ed524ffd9e0d51c48221ae12","current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:ccf28e717df151","company_corpus:cms_cn_protocol_corpus_20260715_v1:e5301a01d0658d","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc2af7591dc952"]},{"ai_run_id":"airun_20261011034705_23b4b412","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:研究方案|block:3|chunk:1","quote":"本文件中的信息保密，所有权归申办者。根据中国法律法规要求，本文件仅提供给研究者和伦理委员会、监督管理部门等相关的机构审阅。","quote_sha256":"4f5c07ce470a95a86d7f9d50dd5a3cc69daf4170f29b742146e2d67dea109370","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","span_id":"es_004"},{"locator":"section:文档开头|block:4|chunk:1","quote":"本方案中所包含的所有信息归申办方所有，因此，仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构进行审阅。在未得到申办方书面批准的情况下，除了在与可能参加本研究的受试者签署知情同意书时，向其做必要的解释外，严禁将任何信息告知与本研究无关的第三方。","quote_sha256":"dfc9fceb41db9d941df0e3715483adaa069da4f1953600a6a37a56d7f81373dd","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","span_id":"es_005"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004","es_005"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":0},"gap_items":[{"action":"由合规与法务团队确认数据保护技术措施","category":"source_missing","gap_id":"gap_privacy_001","missing_source_classes":["数据保护影响评估","IT安全规范"],"target":"受试者数据去标识化具体技术方案及数据存储加密标准"},{"action":"由合规团队确认是否存在跨境数据传输及相应合规路径","category":"source_missing","gap_id":"gap_privacy_002","missing_source_classes":["跨境数据传输合规文件"],"target":"跨境数据传输合规安排（如适用）"}],"heading":"保密与隐私","missing_source_classes":["项目数据保护影响评估文件","受试者去标识化具体技术方案","数据存储加密及跨境传输合规安排"],"proposal_text":"本方案中所包含的所有信息归申办方所有，根据中国法律法规要求，本文件仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构进行审阅。在未得到申办方书面批准的情况下，除了在与可能参加本研究的受试者签署知情同意书时向其做必要的解释外，严禁将任何信息告知与本研究无关的第三方。必须告知接收本文件信息的人员其接收的信息是保密的，不得进一步对外披露。受试者个人可识别信息在研究记录、病例报告表及数据传输过程中须进行去标识化处理，仅以受试者筛选号或随机号标识，不得在方案、报告或公开材料中出现受试者真实姓名、身份证号、住址或其他可直接识别身份的信息。研究数据的采集、存储、传输和销毁须符合中国个人信息保护相关法律法规及申办方数据保护政策的要求。","rationale":"保密声明的措辞结构参考公司语料中两份独立方案（CMS-D005减重II期方案与MY004567炎症性皮肤病方案）的文档保密条款，二者均明确信息所有权归申办方、限定审阅对象为研究者/伦理委员会/监管部门、禁止未经书面批准向第三方披露。受试者去标识化及数据保护要求依据中国个人信息保护法规的通用合规框架撰写，具体技术措施（加密标准、存储架构、跨境传输安排）缺少项目文件，需合规与法务团队确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f4646e04bf3f_2e3c3a342c4bfa07","section_number":"11.4","source_ids":["protocol_full_draft_selection:ed524ffd9e0d51c48221ae12","current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:ccf28e717df151","company_corpus:cms_cn_protocol_corpus_20260715_v1:e5301a01d0658d","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc2af7591dc952"]},{"ai_run_id":"airun_20261011034705_23b4b412","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"由申办方提供本项目临床试验责任保险保单及赔偿条款","category":"source_missing","gap_id":"gap_insurance_001","missing_source_classes":["保险保单文件","赔偿协议"],"target":"临床试验责任保险保单条款、赔偿触发条件及限额"},{"action":"由申办方与法务团队确认赔偿流程","category":"source_missing","gap_id":"gap_insurance_002","missing_source_classes":["赔偿操作规程"],"target":"受试者因研究相关伤害获得赔偿的申请流程与时限"}],"heading":"保险与赔偿","missing_source_classes":["临床试验责任保险保单","赔偿条款及申请流程","申办方与研究机构责任划分协议"],"proposal_text":"","rationale":"保险与赔偿章节需要本项目临床试验责任保险保单条款、赔偿触发条件、赔偿限额、申请流程及与申办方/研究机构/受试者之间的责任划分等具体项目文件。当前允许来源中无任何涉及保险或赔偿的内容，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f4646e04bf3f_88b7a9334d4619a0","section_number":"11.5","source_ids":["protocol_full_draft_selection:ed524ffd9e0d51c48221ae12","current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:ccf28e717df151","company_corpus:cms_cn_protocol_corpus_20260715_v1:e5301a01d0658d","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc2af7591dc952"]},{"ai_run_id":"airun_20261011034705_23b4b412","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:4.4.1 研究暂停/终止标准|block:366|chunk:1","quote":"根据临床试验质量管理规范（GCP）指导方针和当地的法律法规，国家药品监督管理局、伦理委员会、研究者或申办者，可以考虑到参与者权益、安全和健康，停止试验或停止参与者参与试验。","quote_sha256":"ccef5291dce6c8119da7a4e152ee07efd4ab988de4d471a60ea02c9fe6956622","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:e5301a01d0658d","span_id":"es_001"},{"locator":"section:研究终止|block:631|chunk:1","quote":"药政当局、伦理委员会、研究者和/或申办者认为该研究存在重大安全性风险；","quote_sha256":"1d3eec3a5c396558dc4106385bd8903d6db8682b07159f5e32a24d1b0a95e378","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:fc2af7591dc952","span_id":"es_003"},{"locator":"study_definition:mwdefinition_4abb718dd9c030aca783:revision:4","quote":"总体研究设计：多中心、随机、双盲、安慰剂平行对照","quote_sha256":"66366de8bec32d970dc336b327d8116b62330e446365c505f50110feaaba1462","source_id":"current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","span_id":"es_006"},{"locator":"section:4.4.1 研究暂停/终止标准|block:366|chunk:1","quote":"根据临床试验质量管理规范（GCP）指导方针和当地的法律法规，国家药品监督管理局、伦理委员会、研究者或申办者，可以考虑到参与者权益、安全和健康，停止试验或停止参与者参与试验。","quote_sha256":"ccef5291dce6c8119da7a4e152ee07efd4ab988de4d471a60ea02c9fe6956622","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:e5301a01d0658d","span_id":"es_008"}],"evidence_review_advisories":[],"evidence_span_ids":["es_001","es_003","es_006","es_008"],"evidence_summary":{"corpus_spans":3,"project_fact_spans":1},"gap_items":[{"action":"由医学经理与运营团队确认监查计划","category":"source_missing","gap_id":"gap_monitoring_001","missing_source_classes":["监查计划文件"],"target":"监查计划、监查频率及源数据核查范围"},{"action":"由医学经理与数据管理团队确认","category":"source_missing","gap_id":"gap_monitoring_002","missing_source_classes":["数据管理计划","稽查计划","文件管理SOP"],"target":"数据管理流程、稽查安排及文件保存年限"}],"heading":"研究文件、监查和管理","missing_source_classes":["项目监查计划及监查频率","源数据核查范围及方法","数据管理流程及稽查安排","文件保存年限及归档要求"],"proposal_text":"本研究依据临床试验质量管理规范（GCP）指导方针和中国相关法律法规执行。研究期间，申办者须按照GCP要求对研究中心进行监查，确保研究数据的真实性、完整性和可追溯性，并保障受试者权益与安全。当药政当局、伦理委员会、研究者或申办者认为本研究存在重大安全性风险时，国家药品监督管理局、伦理委员会、研究者或申办者可以考虑到参与者权益、安全和健康，停止试验或停止参与者参与试验。研究文件包括研究方案及修订、研究者手册、知情同意书、病例报告表、监查报告、安全性报告、培训记录及文件签署记录等，须按照GCP及申办方文件管理要求保存至研究结束后规定年限。各研究中心须接受申办方或其委托的第三方监查员的定期监查，监查内容包括方案依从性、数据质量、药物管理、安全性报告及时性及文件完整性。","rationale":"本段依据GCP框架下研究监查与文件管理的通用监管要求撰写。研究暂停/终止中伦理委员会和监管部门的角色表述来源于公司语料中两份独立方案（CMD-D001 AD II期方案与CMS-D017 I期方案）。多中心设计事实来源于本项目已确认研究定义。具体监查频率、源数据核查范围、数据管理流程、稽查安排及文件保存年限等项目实施细节缺少项目文件，需医学经理与运营团队确认后补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f4646e04bf3f_9c185156776c05d5","section_number":"12","source_ids":["protocol_full_draft_selection:ed524ffd9e0d51c48221ae12","current_project_study_definition:mwdefinition_4abb718dd9c030aca783:r4:c77aa7243964de78","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:ccf28e717df151","company_corpus:cms_cn_protocol_corpus_20260715_v1:e5301a01d0658d","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc2af7591dc952"]}],"source_bindings":[{"content_sha256":"fb07e5072c2994a57139e898c752ebe4f9f618b1b9697a280da442639d1309f1","locator":"document:mwdoc_greenfield_proj_user_f4646e04bf3f_32980b414dd10a90:full-draft:ed524ffd9e0d51c48221ae12","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:ed524ffd9e0d51c48221ae12","source_type":"protocol_full_draft_selection","source_version":"full-draft:3f113b3078eeadf627add85b70f8595012efb68d7ada6f6ed893a92c895ebf13:ed524ffd9e0d51c