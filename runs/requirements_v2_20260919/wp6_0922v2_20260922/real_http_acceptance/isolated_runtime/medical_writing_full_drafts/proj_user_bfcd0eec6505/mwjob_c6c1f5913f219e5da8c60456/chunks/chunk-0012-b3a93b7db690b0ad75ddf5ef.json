s":["es_01","es_02"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"确认育龄期女性须采用的避孕方法（如屏障法、激素避孕等）及起始/终止时间","category":"source_missing","gap_id":"gap_734_contracept_method","missing_source_classes":["项目避孕方法规定","IB中生殖毒性数据"],"target":"7.3.4 妊娠检查和避孕问询"},{"action":"确认妊娠检查方法（尿妊娠试验或血清β-hCG）及检查时点（仅筛选期或含治疗期/随访期）","category":"source_missing","gap_id":"gap_734_preg_test_schedule","missing_source_classes":["项目妊娠检查方案","访视操作手册"],"target":"7.3.4 妊娠检查和避孕问询"},{"action":"确认是否要求男性受试者伴侣妊娠报告及相应随访安排","category":"source_missing","gap_id":"gap_734_partner_preg","missing_source_classes":["项目伴侣妊娠报告流程"],"target":"7.3.4 妊娠检查和避孕问询"},{"action":"确认意外妊娠后试验药处理、随访终点及新生儿观察方案","category":"source_missing","gap_id":"gap_734_preg_handling","missing_source_classes":["项目妊娠处理SOP"],"target":"7.3.4 妊娠检查和避孕问询"}],"heading":"妊娠检查和避孕问询","missing_source_classes":["研究者手册（IB）中胚胎-胎儿毒性数据","项目妊娠管理SOP或方案附件中避孕方法规定","妊娠检查方法与时点方案","伴侣妊娠报告及新生儿随访流程"],"proposal_text":"本研究排除妊娠或哺乳期女性。研究人群为18至75岁成人，包含育龄期女性。KZ-sGC301为口服小分子药物，给药后产生全身暴露，其胚胎-胎儿毒性特征尚待研究者手册及非临床数据进一步阐明。鉴于上述因素，筛选期须对育龄期女性确认妊娠状态，以排除已妊娠或哺乳期受试者入组。育龄期女性受试者在整个研究期间（含12周双盲治疗期及末次给药后2周安全随访期）须采取有效避孕措施。若受试者在研究期间确认妊娠，研究者应立即暂停试验用药并启动妊娠随访程序。","rationale":"排除标准明确列出妊娠或哺乳；研究人群18-75岁含育龄期女性；药物为口服小分子、全身暴露。避孕方法、妊娠检查具体时点与方式、伴侣妊娠报告、新生儿随访等实施细节无项目来源支持，需医学经理依据研究者手册及监管要求确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bfcd0eec6505_db5bdee8e99e8302","section_number":"7.3.4","source_ids":["protocol_full_draft_selection:b3a93b7db690b0ad75ddf5ef","current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7"]},{"ai_run_id":"airun_20261005164352_8de67d39","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_5ce6022c419cf72077e2:revision:6","quote":"安全性终点：不良事件与严重不良事件发生率；症状性低血压与体位性低血压；生命体征（血压、心率）；肝肾功能、电解质实验室指标；12导联心电图","quote_sha256":"e77501ca084e2f1e9fa18684d494f2252570a19a158da14e097274f13b01fb6b","source_id":"current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","span_id":"es_03"},{"locator":"study_definition:mwdefinition_5ce6022c419cf72077e2:revision:6","quote":"V2（W4）：疗效与安全性评价\nV3（W8）：疗效与安全性评价\nV4治疗结束（W12±3d）：主要终点评价与全面安全性\nV5安全随访（W14）：AE转归确认","quote_sha256":"31a9678afd7986064c89e002b64230f8753532ef7221887711794f945d8d232d","source_id":"current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","span_id":"es_04"},{"locator":"study_definition:mwdefinition_5ce6022c419cf72077e2:revision:6","quote":"总体研究设计：随机、双盲、安慰剂对照、平行组、多中心；II期概念验证+剂量探索，KZ-sGC301三个剂量组与安慰剂对照，治疗12周","quote_sha256":"1440f95ad93cab02beca922f204ee53b603a3dafc663ce38cd26f451d00ce9ca","source_id":"current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","span_id":"es_05"}],"evidence_review_advisories":[],"evidence_span_ids":["es_03","es_04","es_05"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"确认TEAE采集窗口（自首次给药至末次给药后多少天）及安全性评估终止时点","category":"source_missing","gap_id":"gap_8_teae_window","missing_source_classes":["项目安全性评估方案","IB"],"target":"8 安全性评价"},{"action":"确认血压、心率、肝肾功能、电解质及心电图各指标的异常判定阈值与临床意义分级","category":"source_missing","gap_id":"gap_8_thresholds","missing_source_classes":["IB","项目安全性评估标准"],"target":"8 安全性评价"},{"action":"确认症状性低血压与体位性低血压的识别标准、剂量调整或停药规则","category":"source_missing","gap_id":"gap_8_hypotension_handling","missing_source_classes":["IB","项目剂量调整方案"],"target":"8 安全性评价"}],"heading":"安全性评价","missing_source_classes":["研究者手册中安全性风险描述","TEAE采集窗口定义","安全性评估终止时点","各指标异常判定阈值"],"proposal_text":"本研究安全性评价贯穿筛选期、12周双盲治疗期及末次给药后2周安全随访期。安全性评价内容包括：不良事件与严重不良事件发生率；症状性低血压与体位性低血压；生命体征（血压、心率）；肝肾功能、电解质实验室指标；12导联心电图。第4周、第8周访视进行疗效与安全性评价；第12周治疗结束访视（第12周±3天）进行主要终点评价与全面安全性评估；第14周安全随访访视确认不良事件转归。安全性数据在双盲条件下收集与评价。","rationale":"安全性终点清单、各访视安全性评价安排及双盲设计均为已确认项目事实。TEAE采集窗口、安全性评估终止时点、各指标异常阈值及处理流程无来源支持，需依据研究者手册确认。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bfcd0eec6505_1ca2ece277bf8e83","section_number":"8","source_ids":["protocol_full_draft_selection:b3a93b7db690b0ad75ddf5ef","current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7"]},{"ai_run_id":"airun_20261005164352_8de67d39","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_5ce6022c419cf72077e2:revision:6","quote":"安全性终点：不良事件与严重不良事件发生率；症状性低血压与体位性低血压；生命体征（血压、心率）；肝肾功能、电解质实验室指标；12导联心电图","quote_sha256":"e77501ca084e2f1e9fa18684d494f2252570a19a158da14e097274f13b01fb6b","source_id":"current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","span_id":"es_03"},{"locator":"study_definition:mwdefinition_5ce6022c419cf72077e2:revision:6","quote":"V2（W4）：疗效与安全性评价\nV3（W8）：疗效与安全性评价\nV4治疗结束（W12±3d）：主要终点评价与全面安全性\nV5安全随访（W14）：AE转归确认","quote_sha256":"31a9678afd7986064c89e002b64230f8753532ef7221887711794f945d8d232d","source_id":"current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","span_id":"es_04"},{"locator":"study_definition:mwdefinition_5ce6022c419cf72077e2:revision:6","quote":"总体研究设计：随机、双盲、安慰剂对照、平行组、多中心；II期概念验证+剂量探索，KZ-sGC301三个剂量组与安慰剂对照，治疗12周","quote_sha256":"1440f95ad93cab02beca922f204ee53b603a3dafc663ce38cd26f451d00ce9ca","source_id":"current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","span_id":"es_05"}],"evidence_review_advisories":[],"evidence_span_ids":["es_03","es_04","es_05"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"确认AE/SAE/SUSAR定义、采集窗口、报告对象与时限","category":"source_missing","gap_id":"gap_81_ae_def","missing_source_classes":["项目安全性管理方案","IB"],"target":"8.1 总则"},{"action":"确认安全性数据收集、记录、审核的职责分工及CRF记录方式","category":"source_missing","gap_id":"gap_81_data_duty","missing_source_classes":["项目数据管理方案","CRF设计文件"],"target":"8.1 总则"}],"heading":"总则","missing_source_classes":["AE/SAE/SUSAR定义与报告时限规定","安全性数据职责分工","CRF记录规范","研究者手册中安全性风险描述"],"proposal_text":"本研究安全性评价在双盲条件下进行，覆盖筛选期（第-28至-1天）、12周双盲治疗期（第0天随机给药至第12周）及末次给药后2周安全随访期。安全性评价目的为系统收集、记录和评估KZ-sGC301在HFrEF成人受试者中的安全性特征，重点关注症状性低血压与体位性低血压、生命体征变化、肝肾功能及电解质异常、心电图改变以及不良事件与严重不良事件的发生情况。第4周和第8周访视进行疗效与安全性评价，第12周治疗结束访视进行主要终点评价与全面安全性评估，第14周安全随访访视确认不良事件转归。","rationale":"研究时期划分、双盲设计、安全性评价内容及访视安排均为已确认项目事实。安全性总则中关于AE分类标准、报告对象与时限、数据职责分工及CRF记录方式等实施规则无来源支持，需医学经理确认。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bfcd0eec6505_a1adc94a089a4b79","section_number":"8.1","source_ids":["protocol_full_draft_selection:b3a93b7db690b0ad75ddf5ef","current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7"]},{"ai_run_id":"airun_20261005164352_8de67d39","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_bfcd0eec6505_f927261a33219afb:full-draft:b3a93b7db690b0ad75ddf5ef","quote":"不良事件与严重不良事件发生率；症状性低血压与体位性低血压；生命体征（血压、心率）；肝肾功能、电解质实验室指标；12导联心电图","quote_sha256":"8e48ce8e87cb30b8ae278577614d632cc0787eb8e77e871f552fe7ace64021fe","source_id":"protocol_full_draft_selection:b3a93b7db690b0ad75ddf5ef","span_id":"es_06"},{"locator":"study_definition:mwdefinition_5ce6022c419cf72077e2:revision:6","quote":"V2（W4）：疗效与安全性评价\nV3（W8）：疗效与安全性评价\nV4治疗结束（W12±3d）：主要终点评价与全面安全性\nV5安全随访（W14）：AE转归确认","quote_sha256":"31a9678afd7986064c89e002b64230f8753532ef7221887711794f945d8d232d","source_id":"current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","span_id":"es_04"}],"evidence_review_advisories":[],"evidence_span_ids":["es_06","es_04"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[{"action":"确认症状性低血压与体位性低血压的判定标准（如坐位SBP阈值、体位性血压下降幅度）","category":"source_missing","gap_id":"gap_82_hypotension_def","missing_source_classes":["IB","项目安全性评估标准"],"target":"8.2 定义"},{"action":"确认肝肾功能、电解质实验室指标的异常判定阈值与临床意义分级","category":"source_missing","gap_id":"gap_82_lab_def","missing_source_classes":["IB","项目实验室异常标准"],"target":"8.2 定义"},{"action":"确认12导联心电图异常判定标准（如QTc延长阈值、新发心律失常定义）","category":"source_missing","gap_id":"gap_82_ecg_def","missing_source_classes":["IB","项目心电图评估标准"],"target":"8.2 定义"},{"action":"确认TEAE采集窗口及安全性评估终止时点","category":"source_missing","gap_id":"gap_82_teae_window","missing_source_classes":["项目安全性评估方案"],"target":"8.2 定义"}],"heading":"定义","missing_source_classes":["各安全性指标具体定义与阈值","TEAE采集窗口","安全性评估终止时点","研究者手册"],"proposal_text":"本章定义本研究安全性评价所涉及的术语与指标。安全性评价涵盖以下方面：不良事件与严重不良事件发生率；症状性低血压与体位性低血压；生命体征（血压、心率）；肝肾功能、电解质实验室指标；12导联心电图。上述指标在第4周、第8周访视进行疗效与安全性评价时采集，第12周治疗结束访视进行全面安全性评估，第14周安全随访访视确认不良事件转归。","rationale":"安全性指标清单来源于项目已确认安全性终点及章节包定义；访视安排来源于已确认访视策略。各指标的具体定义阈值（如低血压判定标准、心电图异常标准）、TEAE采集窗口及安全性评估终止时点无来源支持，需依据研究者手册和监管指南确认后方可写入具体定义。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bfcd0eec6505_46171b1907ac8382","section_number":"8.2","source_ids":["protocol_full_draft_selection:b3a93b7db690b0ad75ddf5ef","current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7"]}],"source_bindings":[{"content_sha256":"9ff168738984e9b94e693a0a5e3a59ec8a1479b48ba482a620de3777456f1156","locator":"document:mwdoc_greenfield_proj_user_bfcd0eec6505_f927261a33219afb:full-draft:b3a93b7db690b0ad75ddf5ef","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:b3a93b7db690b0ad75ddf5ef","source_type":"protocol_full_draft_selection","source_version":"full-draft:3f87ceafde944e2ec713e26648aa7ef819e9e8ac670e06347a68e5bd41c4378f:b3a93b7db690b0ad75ddf5ef","text_sha256":"9ff168738984e9b94e693a0a5e3a59ec8a1479b48ba482a620de3777456f1156"},{"content_sha256":"a5c234c66ffa681ed8f307ed255fd155024c266785578e33b159ac1456f7ea85","locator":"study_definition:mwdefinition_5ce6022c419cf72077e2:revision:6","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_5ce6022c419cf7