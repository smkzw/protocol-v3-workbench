e_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_bfcd0eec6505_f927261a33219afb:full-draft:e5c566f8938bc597b8804113","quote":"SECTION_ID=mwsec_greenfield_proj_user_bfcd0eec6505_ed1ace73af23dab2\n章节编号=2.3\n章节标题=研究药物简介\n章节类型=section\n当前正文=SMOKE-r3-1S口服sGC刺激剂（KZ-sGC301）","quote_sha256":"066c8c6fdbe7d324a89d2e2dec5cd46665f73222b2a65fa5ea850b78c5e06f48","source_id":"protocol_full_draft_selection:e5c566f8938bc597b8804113","span_id":"es6"}],"evidence_review_advisories":[],"evidence_span_ids":["es6"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"上传研究者手册或等效非临床与既往临床资料后补写","category":"source_missing","gap_id":"gap_drug_01","missing_source_classes":["sGC刺激剂作用机制与非临床药理学数据","非临床毒理学与安全性研究数据","既往人体临床研究资料","研究者手册与药物已知安全性风险"],"target":"研究药物简介中作用机制、非临床数据、既往临床资料及安全性风险描述"}],"heading":"研究药物简介","missing_source_classes":["sGC刺激剂作用机制与非临床药理学数据","非临床毒理学与安全性研究数据","既往人体临床研究资料","研究者手册与药物已知安全性风险"],"proposal_text":"SMOKE-r3-1S口服sGC刺激剂（KZ-sGC301）为小分子化合物，以口服固体制剂形式给药，属全身性暴露药物。本研究采用低剂量2.5 mg、中剂量5 mg和高剂量10 mg三个剂量水平，每日晨起随餐口服一次，治疗期12周，联合标准指南推荐药物治疗背景。安慰剂为外观与气味与试验药一致的模拟片，每日一次，给药与访视安排同试验组。每4周随访评估耐受性，按方案规定进行剂量调整。","rationale":"药物名称、技术类型（小分子）、给药途径（口服）、剂型（口服固体制剂）、暴露范围（全身性）、三个剂量水平、给药频率、治疗周期、双盲双模拟设计及背景治疗均来源于当前项目已确认研究事实。sGC刺激剂作用机制详述、非临床药理学与毒理学数据、既往人体研究资料、研究者手册内容及药物已知安全性风险未在当前来源中提供，需补充后方可完善本章节。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bfcd0eec6505_ed1ace73af23dab2","section_number":"2.3","source_ids":["protocol_full_draft_selection:e5c566f8938bc597b8804113","current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:76a6125fa7dca4","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc6f8c9ea6d34b"]},{"ai_run_id":"airun_20