finition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","span_id":"es_endpoint_study_def"},{"locator":"study_definition:mwdefinition_5ce6022c419cf72077e2:revision:6","quote":"安全性终点：不良事件与严重不良事件发生率；症状性低血压与体位性低血压；生命体征（血压、心率）；肝肾功能、电解质实验室指标；12导联心电图","quote_sha256":"e77501ca084e2f1e9fa18684d494f2252570a19a158da14e097274f13b01fb6b","source_id":"current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","span_id":"es_safety_endpoint_study_def"},{"locator":"study_definition:mwdefinition_5ce6022c419cf72077e2:revision:6","quote":"估计目标策略：治疗策略（treatment policy）：无论是否剂量调整或合并用药变化，均按随机分组分析；终点前事件按复合策略处理。","quote_sha256":"eb44177581223de72875983b0f1d70b25c2bbcf98304d5b17e2c2764beca8e56","source_id":"current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","span_id":"es_est_target_study_def"},{"locator":"study_definition:mwdefinition_5ce6022c419cf72077e2:revision:6","quote":"统计分析策略：FAS为主要分析集；主要终点NT-proBNP百分比变化采用ANCOVA（基线校正）并检验剂量-反应趋势；安全性采用描述统计；次要终点按预先层级顺序分析。","quote_sha256":"9cf37f0df8f4d6bd00beb8c92cebe88f07431911c16227896760d446ca13e075","source_id":"current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","span_id":"es_stat_study_def"},{"locator":"study_definition:mwdefinition_5ce6022c419cf72077e2:revision:6","quote":"安慰剂平行对照：外观与气味与试验药一致的模拟片，每日一次，给药与访视安排同试验组，联合相同GDMT背景，按1:1:1:1随机分配。","quote_sha256":"be1f2f8d5224812fb65406cf191b819e4bb7668a1995791a1358f3ee011d1fcc","source_id":"current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","span_id":"es_placebo_study_def"},{"locator":"study_definition:mwdefinition_5ce6022c419cf72077e2:revision:6","quote":"剂量与给药方案：SMOKE-r3-1S口服sGC刺激剂（KZ-sGC301）：低剂量2.5 mg qd、中剂量5 mg qd、高剂量10 mg qd，每日晨起随餐口服；每4周随访评估耐受性，按方案规定剂量调整。","quote_sha256":"5c2ca1b16b742729ef64649e164b4b8cfd623f38d10044a3540e15fba0e701d2","source_id":"current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","span_id":"es_dose_study_def"}],"evidence_review_advisories":[],"evidence_span_ids":["es_treatment_study_def","es_design_study_def","es_period_study_def","es_visit_study_def","es_endpoint_study_def","es_safety_endpoint_study_def","es_est_target_study_def","es_stat_study_def","es_placebo_study_def","es_dose_study_def"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":10},"gap_items":[{"action":"由医学经理提供剂量调整、暂停、恢复及永久停药的具体触发条件、操作流程和记录要求","category":"source_missing","gap_id":"gap_dose_adjustment","missing_source_classes":["项目专属剂量调整与停药操作规范"],"target":"6节正文-剂量调整部分"},{"action":"确认安慰剂与活性药外观匹配验证方案及盲态维护措施","category":"source_missing","gap_id":"gap_blind_verification","missing_source_classes":["双盲双模拟验证文件"],"target":"6节正文-双盲双模拟部分"},{"action":"由医学经理确认合并用药与禁限用药清单及处理规则","category":"source_missing","gap_id":"gap_concomitant_meds","missing_source_classes":["项目专属合并用药与禁限用药清单"],"target":"6节正文-合并用药部分"}],"heading":"研究治疗/干预","missing_source_classes":["剂量调整/暂停/恢复/永久停药具体操作规则","双盲双模拟外观匹配验证方案","合并用药与禁限用药清单","救援治疗规则"],"proposal_text":"本研究为随机、双盲、安慰剂对照、平行组、多中心II期临床研究，旨在对SMOKE-r3-1S口服sGC刺激剂（KZ-sGC301）进行概念验证与剂量探索。受试者按1:1:1:1比例随机分配至KZ-sGC301低剂量组（2.5 mg每日一次）、中剂量组（5 mg每日一次）、高剂量组（10 mg每日一次）或安慰剂组，各组均联合标准GDMT背景治疗。所有活性药与安慰剂均采用双盲双模拟设计，外观与气味一致，每日晨起随餐口服。治疗期为12周，自第0天随机给药起至第12周治疗结束访视（第12周±3天）止；治疗结束后设2周安全随访期（至第14周）。研究时期依次为：筛选期（第-28天至第-1天）、12周双盲治疗期（第0天至第12周）、治疗结束访视（第12周±3天）及安全随访期（末次给药后2周）。访视安排如下：V0筛选访视（第-28至-1天）完成病史采集、体格检查、ECHO、实验室检查、NT-proBNP及12导联心电图；V1随机入组访视（第0天）完成随机化与首次给药；V2（第4周）、V3（第8周）进行疗效与安全性评价；V4治疗结束访视（第12周±3天）进行主要终点评价与全面安全性评估；V5安全随访访视（第14周）确认不良事件转归。主要疗效终点为第12周NT-proBNP较基线的百分比变化，评价时间点为基线、第4周、第8周和第12周。安全性评价内容包括不良事件与严重不良事件发生率、症状性低血压与体位性低血压、生命体征（血压、心率）、肝肾功能及电解质实验室指标、12导联心电图。估计目标采用治疗策略（treatment policy），无论是否发生剂量调整或合并用药变化，均按随机分组进行分析；终点前事件按复合策略处理。主要分析集为全分析集（FAS），主要终点采用ANCOVA（基线校正）并检验剂量-反应趋势，安全性采用描述统计，次要终点按预先设定的层级顺序分析。","rationale":"研究设计、三剂量方案、双盲双模拟、12周治疗期、GDMT背景、访视结构、主要终点、安全性终点、估计目标策略及统计分析策略均直接来源于项目研究定义中已确认的研究事实。剂量调整、暂停、恢复及永久停药的具体触发条件和操作流程在研究定义中仅提及'按方案规定剂量调整'，未给出具体规则，需项目团队补充。","review_advisories":["本节提及高影响设计信息（主要终点、估计目标）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bfcd0eec6505_d2fa7271b31167e7","section_number":"6","source_ids":["protocol_full_draft_selection:b08db92b9a5b188c78d32c8a","current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]},{"ai_run_id":"airun_20261005163054_95bbe23c","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_5ce6022c419cf72077e2:revision:6","quote":"试验药物：SMOKE-r3-1S口服sGC刺激剂（KZ-sGC301）","quote_sha256":"a304827a5c37f725ab110646c70a51828703f45ec6dec52ba41b99edd818076a","source_id":"current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","span_id":"es_drug_study_def"},{"locator":"document:mwdoc_greenfield_proj_user_bfcd0eec6505_f927261a33219afb:full-draft:b08db92b9a5b188c78d32c8a","quote":"SMOKE-r3-1S口服sGC刺激剂（KZ-sGC301）","quote_sha256":"baaa6219525aef70e57329a253af4c98a7c8ecf09511de04a0b8235f30a298e4","source_id":"protocol_full_draft_selection:b08db92b9a5b188c78d32c8a","span_id":"es_drug_section"},{"locator":"study_definition:mwdefinition_5ce6022c419cf72077e2:revision:6","quote":"药物技术类型：small_molecule\n给药途径：口服\n剂型：口服固体制剂\n局部/系统暴露范围：systemic","quote_sha256":"93d70823288385813f38b773b8c6e7bba227a7ed893796844d8834e9f3bae884","source_id":"current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","span_id":"es_tech_study_def"},{"locator":"study_definition:mwdefinition_5ce6022c419cf72077e2:revision:6","quote":"剂量与给药方案：SMOKE-r3-1S口服sGC刺激剂（KZ-sGC301）：低剂量2.5 mg qd、中剂量5 mg qd、高剂量10 mg qd，每日晨起随餐口服；每4周随访评估耐受性，按方案规定剂量调整。","quote_sha256":"5c2ca1b16b742729ef64649e164b4b8cfd623f38d10044a3540e15fba0e701d2","source_id":"current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","span_id":"es_dose_study_def"},{"locator":"study_definition:mwdefinition_5ce6022c419cf72077e2:revision:6","quote":"安慰剂平行对照：外观与气味与试验药一致的模拟片，每日一次，给药与访视安排同试验组，联合相同GDMT背景，按1:1:1:1随机分配。","quote_sha256":"be1f2f8d5224812fb65406cf191b819e4bb7668a1995791a1358f3ee011d1fcc","source_id":"current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","span_id":"es_placebo_study_def"}],"evidence_review_advisories":[],"evidence_span_ids":["es_drug_study_def","es_drug_section","es_tech_study_def","es_dose_study_def","es_placebo_study_def"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"由药学或项目团队提供KZ-sGC301各规格片剂的具体含药量、辅料、包装形式及标签要求","category":"source_missing","gap_id":"gap_drug_spec","missing_source_classes":["试验用药品规格与包装文件"],"target":"6.1节正文-药物规格与包装"},{"action":"由药学团队提供药物储存温度、湿度、光照条件及运输要求","category":"source_missing","gap_id":"gap_storage","missing_source_classes":["药物储存与运输条件文件"],"target":"6.1节正文-储存与运输"},{"action":"由项目团队提供药物发放、回收、计数及销毁的操作规程","category":"source_missing","gap_id":"gap_dispense","missing_source_classes":["药物发放与回收操作规程"],"target":"6.1节正文-发放与回收"}],"heading":"试验用药品","missing_source_classes":["试验用药品规格与包装文件","药物储存与运输条件文件","药物发放与回收操作规程","药物销毁程序文件"],"proposal_text":"本研究试验用药品为SMOKE-r3-1S口服sGC刺激剂（KZ-sGC301），属小分子化合物，剂型为口服固体制剂（片剂），给药途径为口服，系统暴露。试验药设低剂量2.5 mg、中剂量5 mg、高剂量10 mg三个规格，每日晨起随餐口服一次。安慰剂为外观与气味与试验药一致的模拟片，每日一次口服，给药与访视安排同试验组，联合相同GDMT背景治疗。试验药与安慰剂均按1:1:1:1比例随机分配至四个组别。","rationale":"药物名称、技术类型（small_molecule）、剂型（口服固体制剂）、给药途径（口服）、系统暴露范围、三个剂量规格及安慰剂描述均直接来源于项目研究定义中已确认的研究事实。药物具体规格（如每片含药量）、包装形式、储存条件、发放与回收流程、有效期管理、运输条件及药物销毁程序等实施细节缺少项目专属文件支持，需项目团队补充后方可完善本章节。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bfcd0eec6505_1bb20d24db04f0d9","section_number":"6.1","source_ids":["protocol_full_draft_selection:b08db92b9a5b188c78d32c8a","current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]}],"source_bindings":[{"content_sha256":"90440412