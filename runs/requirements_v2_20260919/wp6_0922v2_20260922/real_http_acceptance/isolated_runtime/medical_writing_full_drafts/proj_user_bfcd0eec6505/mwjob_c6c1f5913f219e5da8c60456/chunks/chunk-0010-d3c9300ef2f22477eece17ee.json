r":"study_definition:mwdefinition_5ce6022c419cf72077e2:revision:6","quote":"SMOKE-r3-1S口服sGC刺激剂（KZ-sGC301）：低剂量2.5 mg qd、中剂量5 mg qd、高剂量10 mg qd，每日晨起随餐口服；每4周随访评估耐受性，按方案规定剂量调整。","quote_sha256":"323276554a55b726c54510031878550719603c7363bc81625bf94a9176dc20e0","source_id":"current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","span_id":"es_dosing"},{"locator":"study_definition:mwdefinition_5ce6022c419cf72077e2:revision:6","quote":"治疗策略（treatment policy）：无论是否剂量调整或合并用药变化，均按随机分组分析；终点前事件按复合策略处理。","quote_sha256":"7e7b05f63a8eb9008c2ec9f40fabf5d8ba570e08ef95d1d11b82a437157fa07d","source_id":"current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","span_id":"es_treatment_policy"}],"evidence_review_advisories":[],"evidence_span_ids":["es_treatment_period","es_visit_strategy","es_dosing","es_treatment_policy"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"补充剂量调整触发阈值、调整幅度、恢复条件及对应访视安排的项目文件","category":"source_missing","gap_id":"gap_712_dose_adjustment","missing_source_classes":["剂量调整具体规则文件"],"target":"7.1.2节'按方案规定剂量调整'处"},{"action":"补充V1至V5各访视具体评估项目（实验室、ECG、NT-proBNP采集时点等）的访视操作手册","category":"source_missing","gap_id":"gap_712_visit_assessments","missing_source_classes":["访视操作手册"],"target":"7.1.2节各访视评估内容"}],"heading":"治疗期及随访","missing_source_classes":["剂量调整具体规则文件","各访视具体评估项目清单"],"proposal_text":"本研究治疗期为12周双盲给药期，自第0天随机入组并首次给药起至第12周治疗结束访视止。受试者按1:1:1:1比例随机分配至KZ-sGC301低剂量（2.5 mg每日一次）、中剂量（5 mg每日一次）、高剂量（10 mg每日一次）或安慰剂组，所有组别均联合标准GDMT背景治疗。试验药与安慰剂均采用双盲双模拟设计，每日晨起随餐口服一次。治疗期间设置以下计划访视：第0天（V1）为随机入组及首次给药访视；第4周（V2）进行疗效与安全性评价；第8周（V3）进行疗效与安全性评价；第12周±3天（V4）为治疗结束访视，完成主要终点评价与全面安全性评估。治疗结束后进入安全随访期，自末次给药后第2周（约第14周，V5）进行安全随访访视，确认不良事件转归。每4周随访时评估受试者耐受性，剂量调整依据方案规定的耐受性评估结果执行。治疗策略采用treatment policy原则，即无论治疗期间是否发生剂量调整或合并用药变化，均按随机分组进行分析。","rationale":"治疗期时长、访视节点（V1至V5）、给药方案（三剂量+安慰剂、qd、双盲双模拟）、安全随访期（末次给药后2周）及treatment policy策略均来源于当前项目已确认研究事实。'按方案规定剂量调整'的具体阈值与流程未在来源中展开，需医学经理结合IB及既往临床数据确认。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bfcd0eec6505_849b2237f68b15c0","section_number":"7.1.2","source_ids":["protocol_full_draft_selection:d3c9300ef2f22477eece17ee","current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7"]},{"ai_run_id":"airun_20261005163857_f9fe2a86","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取或制定计划外访视触发条件、评估项目、记录方式及与计划访视衔接规则的项目文件","category":"source_missing","gap_id":"gap_713_unplanned_visit","missing_source_classes":["计划外访视操作规范","访视操作手册"],"target":"7.1.3节全文"}],"heading":"计划外访视","missing_source_classes":["计划外访视操作规范","访视操作手册"],"proposal_text":"","rationale":"当前项目已确认研究事实中未包含计划外访视的触发条件、评估内容、记录要求及与计划访视的衔接规则。该章节需要项目层面的计划外访视操作规范作为来源支撑，不能以通用原则或条件句替代。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bfcd0eec6505_edfa3a4011fbc88d","section_number":"7.1.3","source_ids":["protocol_full_draft_selection:d3c9300ef2f22477eece17ee","current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7"]},{"ai_run_id":"airun_20261005163857_f9fe2a86","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取或制定研究治疗终止触发标准、退出研究程序、失访定义及处理流程的项目文件","category":"source_missing","gap_id":"gap_714_termination","missing_source_classes":["研究治疗终止与退出操作规范","失访处理流程文件"],"target":"7.1.4节全文"}],"heading":"研究治疗终止、退出研究及失访处理","missing_source_classes":["研究治疗终止与退出操作规范","失访处理流程文件"],"proposal_text":"","rationale":"当前项目已确认研究事实中仅涉及treatment policy分析策略和'按方案规定剂量调整'的概括性表述，未提供研究治疗终止的具体触发标准、退出研究程序、失访定义及处理流程。该章节需要项目层面的治疗终止与退出操作规范作为来源支撑。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bfcd0eec6505_893aec9bebb8cf01","section_number":"7.1.4","source_ids":["protocol_full_draft_selection:d3c9300ef2f22477eece17ee","current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7"]},{"ai_run_id":"airun_20261005163857_f9fe2a86","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_5ce6022c419cf72077e2:revision:6","quote":"主要终点：第12周NT-proBNP较基线的百分比变化（双盲期）。评价时间点：基线、第4/8/12周。","quote_sha256":"ed3fdeeb458362e8ec2062ccfdb54dabe86146616d3c09971d19582407bead01","source_id":"current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","span_id":"es_primary_endpoint"},{"locator":"study_definition:mwdefinition_5ce6022c419cf72077e2:revision:6","quote":"FAS为主要分析集；主要终点NT-proBNP百分比变化采用ANCOVA（基线校正）并检验剂量-反应趋势；安全性采用描述统计；次要终点按预先层级顺序分析。","quote_sha256":"067b3f77e20da2222b9c91da7106a0b612b21542c62f4e68cae8bb2ae7c09367","source_id":"current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","span_id":"es_stat_strategy"},{"locator":"study_definition:mwdefinition_5ce6022c419cf72077e2:revision:6","quote":"治疗策略（treatment policy）：无论是否剂量调整或合并用药变化，均按随机分组分析；终点前事件按复合策略处理。","quote_sha256":"7e7b05f63a8eb9008c2ec9f40fabf5d8ba570e08ef95d1d11b82a437157fa07d","source_id":"current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","span_id":"es_treatment_policy"}],"evidence_review_advisories":[],"evidence_span_ids":["es_primary_endpoint","es_stat_strategy","es_treatment_policy"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"确认是否设置次要有效性终点及其定义、评价时点和分析方法","category":"source_missing","gap_id":"gap_72_secondary_endpoints","missing_source_classes":["次要有效性终点定义文件"],"target":"7.2节有效性评估框架"},{"action":"补充NT-proBNP检测方法、实验室资质及样本处理要求","category":"source_missing","gap_id":"gap_72_ntprobnp_method","missing_source_classes":["NT-proBNP检测方法学文件"],"target":"7.2节NT-proBNP检测"}],"heading":"有效性评估","missing_source_classes":["次要有效性终点定义文件","NT-proBNP检测方法学文件"],"proposal_text":"本研究主要有效性终点为第12周NT-proBNP较基线的百分比变化，在双盲期内评价。NT-proBNP采集时间点为基线、第4周、第8周和第12周。主要分析采用ANCOVA方法，以基线NT-proBNP为协变量进行校正，并检验三个剂量组与安慰剂组之间的剂量-反应趋势。主要分析集为全分析集（FAS），遵循治疗策略（treatment policy）原则，即无论治疗期间是否发生剂量调整或合并用药变化，均按随机分组进行分析；终点前事件按复合策略处理。本研究为II期概念验证与剂量探索设计，每组约60例、共约240例的样本量基于NT-proBNP组间差值文献效应量与80%把握度估算，用于支持概念验证结论及后续剂量选择。","rationale":"主要终点（NT-proBNP百分比变化）、评价时间点（基线、W4、W8、W12）、ANCOVA分析方法、FAS分析集、treatment policy策略及样本量估算依据均来源于当前项目已确认研究事实。是否设置次要有效性终点（如6分钟步行距离、NYHA分级、KCCQ等）未在允许来源中明确，需医学经理确认。","review_advisories":["本节提及高影响设计信息（剂量选择、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bfcd0eec6505_5204952384797c77","section_number":"7.2","source_ids":["protocol_full_draft_selection:d3c9300ef2f22477eece17ee","current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7"]}],"source_bindings":[{"content_sha256":"a6e8b10b66d7b52ed8331a8978f888511f2497c570da7f9cb6069f4649621b5f","locator":"document:mwdoc_greenfield_proj_user_bfcd0eec6505_f927261a33219afb:full-draft:d3c9300ef2f22477eece17ee","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:d3c9300ef2f22477eece17ee","source_type":"protocol_full_draft_selection","source_version":"full-draft:3f87ceafde944e2ec713e26648aa7ef819e9e8ac670e06347a68e5bd41c4378f:d3c9300ef2f22477eece17ee","text_sha256":"a6e8b10b66d7b52ed8331a8978f888511f2497c570da7f9cb6069f4649621b5f"},{"content_sha256":"a5c234c66ffa681ed8f307ed255fd155024c266785578e33b159ac1456f7ea85","locator":"study_definition:mwdefinition_5ce6022c419cf72077e2:revision:6","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","source_type":"current_project_study_definition","source_version":"mwdefinition_5ce6022c419cf72077e2:r6:d11f75abadf3bca7","text_sha256":