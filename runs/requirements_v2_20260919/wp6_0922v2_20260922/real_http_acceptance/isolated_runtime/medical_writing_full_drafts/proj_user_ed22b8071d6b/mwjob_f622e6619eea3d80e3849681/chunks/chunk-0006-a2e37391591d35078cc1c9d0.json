"project_fact_spans":4},"gap_items":[{"action":"需获取安慰剂具体组成、外观匹配验证报告及与活性药物的匹配确认记录","category":"source_missing","gap_id":"gap_placebo_composition","missing_source_classes":["安慰剂组成与外观匹配验证"],"target":"6.1 试验用药品 - 安慰剂"},{"action":"需获取试验用药品包装规格、储存条件、有效期管理及运输要求","category":"source_missing","gap_id":"gap_packaging_storage","missing_source_classes":["试验用药品包装规格与储存条件"],"target":"6.1 试验用药品 - 包装与储存"},{"action":"需获取药物发放、回收、计数与销毁流程","category":"source_missing","gap_id":"gap_dispense_return","missing_source_classes":["药物发放与回收流程"],"target":"6.1 试验用药品 - 发放与回收"},{"action":"需获取药物过量与给药错误的定义、处理流程和报告要求","category":"source_missing","gap_id":"gap_overdose_error","missing_source_classes":["药物过量与给药错误处理规范"],"target":"6.1 试验用药品 - 药物过量与给药错误"}],"heading":"试验用药品","missing_source_classes":["试验用药品包装规格与储存条件","安慰剂组成与外观匹配验证","药物发放与回收流程","药物过量与给药错误处理规范"],"proposal_text":"试验用药品为SMOKE-r2-1Q口服sGC刺激剂（KZ-sGC201），属小分子化合物，剂型为口服固体制剂，给药途径为口服，系统暴露。活性成分为KZ-sGC201，设低剂量2.5 mg、中剂量5 mg、高剂量10 mg三个规格，每日一次晨起随餐口服。安慰剂为与活性药物外观匹配的口服固体制剂。排除标准中明确禁止合并使用硝酸酯类或PDE5抑制剂，该限制与sGC刺激剂的作用机制相关。","rationale":"药物名称、技术类型、剂型、给药途径、暴露范围和剂量规格均来自当前项目已确认研究事实。安慰剂的具体组成、外观匹配验证方式、包装规格、储存条件、发放与回收流程以及药物过量与给药错误处理规则缺少项目专属来源，未写入正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ed22b8071d6b_6eb4828f02d015be","section_number":"6.1","source_ids":["protocol_full_draft_selection:a2e37391591d35078cc1c9d0","current_project_study_definition:mwdefinition_7e58b72c4deda30d8a67:r4:628d02c25cbe7360","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]}],"source_bindings":[{"content_sha256":"d5380289de543c3fe7037cc417e0d6a77a5f5b06838417086197ae039a7a014f","locator":"document:mwdoc_greenfield_proj_user_ed22b8071d6b_7a1441bac4c8d3e2:full-draft:a2e37391591d35078cc1c9d0","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:a2e37391591d35078cc1c9d0","source_type":"protocol_full_draft_selection","source_version":"full-draft:f302bf98a770a40a36f64508709a10e445fe67be31cb6