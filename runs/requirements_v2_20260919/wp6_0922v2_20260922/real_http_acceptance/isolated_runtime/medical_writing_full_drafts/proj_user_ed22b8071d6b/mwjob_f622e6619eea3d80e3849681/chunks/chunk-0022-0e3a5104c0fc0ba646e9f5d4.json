"ee8cbc333c7e24e28cf3efd553196ea8833e37c010be1e6e27553c39e992a50f","source_id":"current_project_study_definition:mwdefinition_7e58b72c4deda30d8a67:r4:628d02c25cbe7360","span_id":"es_v4_visit"},{"locator":"study_definition:mwdefinition_7e58b72c4deda30d8a67:revision:4","quote":"排除标准模块：坐位SBP<90 mmHg或有症状性低血压；90天内急性心衰失代偿住院或30天内ACS/PCI/CABG；合并使用硝酸酯类或PDE5抑制剂；eGFR<30 mL/min/1.73m²；ALT/AST>3×ULN；妊娠或哺乳期","quote_sha256":"9e987e249a2b5552cf6c7e0b50c1d6f7df4c019d65e7d2646f880a6fa45319e4","source_id":"current_project_study_definition:mwdefinition_7e58b72c4deda30d8a67:r4:628d02c25cbe7360","span_id":"es_exclusion_criteria"},{"locator":"study_definition:mwdefinition_7e58b72c4deda30d8a67:revision:4","quote":"V2（W4）：疗效与安全性评价\nV3（W8）：疗效与安全性评价","quote_sha256":"c91f7424aa0d4d856766c58df763c51eb5b39e45a4c4bec45b4a3041dff9bee1","source_id":"current_project_study_definition:mwdefinition_7e58b72c4deda30d8a67:r4:628d02c25cbe7360","span_id":"es_v2_v3_safety"},{"locator":"study_definition:mwdefinition_7e58b72c4deda30d8a67:revision:4","quote":"V5安全随访（W14）：AE转归确认","quote_sha256":"a0d0d5f20813f69874e61d0ee747ce0cf211395a3ba1eb7461504efd7528fe58","source_id":"current_project_study_definition:mwdefinition_7e58b72c4deda30d8a67:r4:628d02c25cbe7360","span_id":"es_v5_followup"}],"evidence_review_advisories":[],"evidence_span_ids":["es_safety_endpoints","es_v0_visit","es_v4_visit","es_exclusion_criteria","es_v2_v3_safety","es_v5_followup"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"检索或编制完整访视操作清单，明确各访视是否重复采集肝肾功能、电解质、心电图及NT-proBNP","category":"source_not_retrieved","gap_id":"gap_lab_v2_v3_v5","missing_source_classes":["完整访视操作清单"],"target":"14.2节中V2、V3、V5访视的实验室检查项目"},{"action":"确认除肝肾功能、电解质外是否包含血常规、凝血功能、血脂、血糖、尿酸、尿常规等项目","category":"source_not_retrieved","gap_id":"gap_lab_panel_detail","missing_source_classes":["实验室检查项目清单"],"target":"14.2节中实验室检查具体项目列表"}],"heading":"实验室检查项目","missing_source_classes":["完整访视操作清单（含各访视实验室检查项目明细）","NT-proBNP采集时点清单"],"proposal_text":"本研究安全性终点涵盖肝肾功能、电解质实验室指标及12导联心电图。筛选访视（V0，-28至-1天）须完成实验室检查、NT-proBNP测定和12导联心电图，作为入组基线评估的组成部分。治疗结束访视（V4，W12±3天）须进行全面安全性评价，包括上述实验室指标和心电图的重复检测。排除标准中涉及eGFR低于30 mL/min/1.73m²及ALT或AST超过3倍正常值上限的阈值，提示肾功能和肝功能指标为筛选期必检项目。V2（W4）和V3（W8）访视标注为疗效与安全性评价，V5（W14）为安全随访及不良事件转归确认；上述访视中是否逐项重复采集肝肾功能、电解质及心电图，以及NT-proBNP是否在V0以外的访视中重复测定，尚需依据完整访视操作清单确认。","rationale":"安全性终点列表和访视策略来自当前项目已确认研究事实（研究定义修订版4）。排除标准中的eGFR和ALT/AST阈值支持筛选期必检肝肾功能。V2至V5的实验室检查具体项目未逐项列出，需医学经理核对完整访视操作清单后补全。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ed22b8071d6b_b02b54ea6b8b2cd3","section_number":"14.2","source_ids":["protocol_full_draft_selection:0e3a5104c0fc0ba646e9f5d4","current_project_study_definition:mwdefinition_7e58b72c4deda30d8a67:r4:628d02c25cbe7360","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1d8a6d3b64541","company_corpus:cms_cn_protocol_corpus_20260715_v1:76a6125fa7dca4","company_corpus:cms_cn_protocol_corpus_20260715_v1:eed6fd877d0a24","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb5ffffeb64ac7","company_corpus:cms_cn_protocol_corpus_20260715_v1:20ca67d1098144"]},{"ai_run_id":"airun_20261004163522_99e53bb5","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取本项目安全信息报告SOP或方案附件，明确SAE/SUSAR报告时限、报告对象（申办者、伦理委员会、药监部门）、报告格式（eCRF、电话、邮件）及升级流程","category":"source_missing","gap_id":"gap_safety_report_pathway","missing_source_classes":["安全信息报告SOP","本项目IB安全性章节","伦理委员会报告要求","药监部门报告要求"],"target":"14.3节安全信息报告途径全文"},{"action":"确认本项目是否采用ICH GCP标准定义，以及是否有项目特异的AE采集窗口、因果关系判定规则和报告时限","category":"source_missing","gap_id":"gap_ae_sae_definition","missing_source_classes":["本项目AE/SAE定义与报告规则文件"],"target":"14.3节中AE/SAE/SUSAR定义与采集报告规则"}],"heading":"安全信息报告途径","missing_source_classes":["本项目安全信息报告SOP或方案附件","SAE/SUSAR报告时限与路径规定","伦理委员会报告要求","药监部门报告要求"],"proposal_text":"","rationale":"当前项目来源仅列出安全性终点类别（不良事件与严重不良事件发生率