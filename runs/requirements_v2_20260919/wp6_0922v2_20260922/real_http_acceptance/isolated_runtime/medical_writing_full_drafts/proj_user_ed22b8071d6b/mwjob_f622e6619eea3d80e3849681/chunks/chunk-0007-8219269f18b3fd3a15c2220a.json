da30d8a67:revision:4","quote":"随机、双盲、安慰剂对照、平行组、多中心；II期概念验证+剂量探索，KZ-sGC201低/中/高三个剂量组与安慰剂对照，治疗12周","quote_sha256":"bab8b87ef9e53ef32938abcfccd4f85d4e3edf5c8e87aa27ca2435f43893f99f","source_id":"current_project_study_definition:mwdefinition_7e58b72c4deda30d8a67:r4:628d02c25cbe7360","span_id":"es_blind_placebo"},{"locator":"study_definition:mwdefinition_7e58b72c4deda30d8a67:revision:4","quote":"合并使用硝酸酯类或PDE5抑制剂","quote_sha256":"acfdda74d89b8760a6ccd01d7f7ee58b5a74ef46c54d3492dd67206868fb3cb9","source_id":"current_project_study_definition:mwdefinition_7e58b72c4deda30d8a67:r4:628d02c25cbe7360","span_id":"es_contraindication"},{"locator":"study_definition:mwdefinition_7e58b72c4deda30d8a67:revision:4","quote":"药物技术类型：small_molecule\n给药途径：口服\n剂型：口服固体制剂\n局部/系统暴露范围：systemic","quote_sha256":"93d70823288385813f38b773b8c6e7bba227a7ed893796844d8834e9f3bae884","source_id":"current_project_study_definition:mwdefinition_7e58b72c4deda30d8a67:r4:628d02c25cbe7360","span_id":"es_tech_type"}],"evidence_review_advisories":[],"evidence_span_ids":["es_drug_identity","es_dosing","es_blind_placebo","es_contraindication","es_tech_type"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"获取安慰剂处方组成、外观匹配工艺及与活性药对照的匹配验证报告","category":"source_missing","gap_id":"gap_611_placebo","missing_source_classes":["安慰剂处方与外观匹配规格说明"],"target":"6.1.1 研究药物信息——安慰剂描述"},{"action":"获取IB中sGC刺激剂作用机制、非临床毒理学及既往临床安全性摘要","category":"source_missing","gap_id":"gap_611_moa","missing_source_classes":["研究者手册（IB）","非临床安全性与药理学数据"],"target":"6.1.1 研究药物信息——作用机制与非临床数据"}],"heading":"研究药物信息","missing_source_classes":["研究者手册（IB）","非临床安全性与药理学数据","既往临床研究摘要","安慰剂处方与外观匹配规格说明"],"proposal_text":"本研究试验药物为SMOKE-r2-1Q口服sGC刺激剂（KZ-sGC201），属小分子化合物，以口服固体制剂形式给药，产生全身性系统暴露。研究设置低剂量2.5 mg每日一次、中剂量5 mg每日一次、高剂量10 mg每日一次三个活性剂量组，受试者每日晨起随餐口服给药，治疗持续12周。本研究采用双盲、安慰剂对照设计，KZ-sGC201三个剂量组均与外观匹配的安慰剂对照，以维持盲态。每4周随访时评估药物耐受性，并依据方案规定的剂量调整规则进行处理。鉴于KZ-sGC201作用于可溶性鸟苷酸环化酶（sGC）通路，方案排除标准明确禁止合并使用硝酸酯类或磷酸二酯酶5（PDE5）抑制剂，以避免该通路叠加效应导致严重低血压。安慰剂的具体组成、外观匹配工艺及对照药信息需由药学部门提供处方与匹配验证资料后补充完善。","rationale":"药物名称、技术类型、剂型、给药途径、三剂量方案、12周疗程、双盲安慰剂对照设计及硝酸酯/PDE5抑制剂排除标准均来自当前项目已确认研究事实。安慰剂组成标记为undefined，药物作用机制详述、非临床安全性数据及既往临床资料未提供，需补充研究者手册或药理学摘要后方可完善本章节。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ed22b8071d6b_86ffead46e391da9","section_number":"6.1.1","source_ids":["protocol_full_draft_selection:8219269f18b3fd3a15c2220a","current_project_study_definition:mwdefinition_7e58b72c4deda30d8a67:r4:628d02c25cbe7360"]},{"ai_run_id":"airun_20261004154218_68a79c32","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取KZ-sGC201及安慰剂的制备工艺、包装规格、标签模板、储存温度与湿度条件、运输包装要求及中心药物管理规程","category":"source_missing","gap_id":"gap_612_packaging","missing_source_classes":["药物制备与包装工艺文件","标签模板与内容规范","储存与运输条件说明","中心药物管理SOP"],"target":"6.1.2 制备、包装、标签、储存与管理——全部"}],"heading":"制备、包装、标签、储存与管理","missing_source_classes":["药物制备与包装工艺文件","标签模板与内容规范","储存与运输条件说明","中心药物管理SOP"],"proposal_text":"","rationale":"本章节涉及试验药物的制备工艺、包装规格、标签内容、储存温度与条件、运输要求及中心管理规程。当前项目来源未提供上述任何实施细节，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ed22b8071d6b_0f0afb4f5cbb06ca","section_number":"6.1.2","source_ids":["protocol_full_draft_selection:8219269f18b3fd3a15c2220a","current_project_study_definition:mwdefinition_7e58b72c4deda30d8a67:r4:628d02c25cbe7360"]},{"ai_run_id":"airun_20261004154218_68a79c32","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取研究药物发放流程（含随机号与药物对应关系）、回收程序、清点频率与记录方式、药物accountability表格模板及偏差处理规程","category":"source_missing","gap_id":"gap_613_distribution","missing_source_classes":["药物发放与回收SOP","药物清点与accountability记录规范","药物偏