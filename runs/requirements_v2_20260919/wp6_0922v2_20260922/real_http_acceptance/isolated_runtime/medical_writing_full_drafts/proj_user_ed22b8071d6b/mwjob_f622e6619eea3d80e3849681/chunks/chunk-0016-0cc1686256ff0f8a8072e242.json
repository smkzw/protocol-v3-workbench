nce_corpus","source_version":"20561fabeffbb0","text_sha256":"12bac064fee816df622f65bd2f3d65dab5b33e902aa7b25ae49db87726080ac4"},{"content_sha256":"11c21094429a4d9b6fd36d28e6d6b787c134a8c7397ecc704a35c832857515fe","locator":"section:文档开头|block:29|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","source_type":"company_protocol_reference_corpus","source_version":"04ac0381ef4b49","text_sha256":"11c21094429a4d9b6fd36d28e6d6b787c134a8c7397ecc704a35c832857515fe"},{"content_sha256":"a081fa03f5ce0ceb2ca2444ea6b2a850997611938884f75fa4f6b5e188b3af68","locator":"section:7.3.1 病例报告表的设计|block:1037|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","source_type":"company_protocol_reference_corpus","source_version":"a5f4a227d6404a","text_sha256":"a081fa03f5ce0ceb2ca2444ea6b2a850997611938884f75fa4f6b5e188b3af68"}]}