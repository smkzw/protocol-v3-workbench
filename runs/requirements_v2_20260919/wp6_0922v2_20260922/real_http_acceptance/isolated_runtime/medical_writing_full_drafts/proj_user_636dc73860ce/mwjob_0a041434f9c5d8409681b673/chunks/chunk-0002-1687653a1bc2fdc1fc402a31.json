":"mwsec_greenfield_proj_user_636dc73860ce_5804586a0e0b6e54","section_number":"2.3.2","source_ids":["protocol_full_draft_selection:1687653a1bc2fdc1fc402a31","current_project_study_definition:mwdefinition_29728c7097c3c43e460b:r4:ce444b99d8bb7f54","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:5425c4f8e6c0a6"]},{"ai_run_id":"airun_20261010022140_4ffba4c9","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_29728c7097c3c43e460b:revision:4","quote":"内在研究目的：概念验证（PoC）；剂量探索","quote_sha256":"2d096e242bbd65d0c9236718d79e77a388e84cb9640b99bd47662a6ce8faab31","source_id":"current_project_study_definition:mwdefinition_29728c7097c3c43e460b:r4:ce444b99d8bb7f54","span_id":"es_002"},{"locator":"study_definition:mwdefinition_29728c7097c3c43e460b:revision:4","quote":"KZ-sGC1601为口服可溶性鸟苷酸环化酶（sGC）刺激剂，与标准心衰基础治疗联用；探索2-3个剂量水平的有效性与安全性，疗程12周。","quote_sha256":"8d216d2d69656fc45317bf2e53aafabd0e16e083c497f58066139efc7924aa7d","source_id":"current_project_study_definition:mwdefinition_29728c7097c3c43e460b:r4:ce444b99d8bb7f54","span_id":"es_003"},{"locator":"study_definition:mwdefinition_29728c7097c3c43e460b:revision:4","quote":"中国成年慢性心力衰竭（LVEF≤40%，NYHA II-III级）患者，标准治疗基础上症状仍持续","quote_sha256":"cb614f9642c6b11fe626282bfa427aadfd09329dd9534215de6018c0b3a653f4","source_id":"current_project_study_definition:mwdefinition_29728c7097c3c43e460b:r4:ce444b99d8bb7f54","span_id":"es_006"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003","es_006"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"补充KZ-sGC1601非临床药效学摘要（至少包括动物心衰模型中cGMP水平变化、心功能改善数据及sGC选择性数据），以将机制描述从一般通路推断升级为药物特异性证据。","category":"source_missing","gap_id":"gap_24_01","missing_source_classes":["非临床药效学报告","体外药理学数据"],"target":"2.4节sGC/cGMP通路机制描述"},{"action":"补充I期药代动力学数据（Cmax、AUC、半衰期、剂量线性）及I期安全性数据，以支撑2.5/5/10mg三个剂量水平的选择理由。","category":"source_missing","gap_id":"gap_24_02","missing_source_classes":["I期药代动力学报告","I期安全性数据"],"target":"2.4节剂量选择依据"}],"heading":"本研究的理论基础","missing_source_classes":["sGC刺激剂非临床药效学资料（动物模型中cGMP通路对心肌重构和血管舒张的影响）","KZ-sGC1601体外受体结合与选择性数据","同类sGC刺激剂在HFrEF中的临床前或早期临床证据"],"proposal_text":"慢性心力衰竭伴射血分数降低（HFrEF）的核心病理生理特征为心肌收缩力下降、心室重构及神经内分泌系统持续激活，导致心输出量不足与外周血管阻力代偿性升高。可溶性鸟苷酸环化酶（sGC）是一氧化氮信号通路的关键效应酶，其催化三磷酸鸟苷生成环磷酸鸟苷（cGMP），后者通过激活蛋白激酶G（PKG）介导血管平滑肌舒张、抑制心肌纤维化及减轻心室重构。在HFrEF状态下，内皮功能障碍导致一氧化氮生物利用度下降，sGC氧化失活增加，cGMP生成不足，形成恶性循环。KZ-sGC1601为口服可溶性鸟苷酸环化酶刺激剂，通过直接激活残余sGC并增强其对内源性一氧化氮的敏感性，恢复cGMP信号传导，理论上可改善心肌舒张功能、降低前负荷与后负荷，从而在标准心衰基础治疗之上提供额外的血流动力学与抗重构获益。本研究为II期概念验证与剂量探索研究，采用随机、双盲、安慰剂对照、平行组、多中心设计，在标准心衰治疗基础上联用KZ-sGC1601，设置2.5mg、5mg、10mg每日一次三个剂量水平，疗程12周，旨在初步验证sGC刺激策略在HFrEF人群中的有效性信号并确定后续III期研究的推荐剂量。目标人群为中国成年慢性心力衰竭（LVEF≤40%，NYHA II-III级）患者，在标准治疗基础上症状仍持续，即经治疗效不佳的中重度HFrEF成人。","rationale":"已确认事实支持：KZ-sGC1601为口服sGC刺激剂、II期PoC与剂量探索设计、2.5/5/10mg三剂量、12周疗程、目标人群为LVEF≤40%且NYHA II-III级成人。sGC/cGMP通路在HFrEF中的病理生理角色为基于已确认机制定位的合理推断，具体非临床证据（动物模型数据、受体结合实验等）需IB或文献补充。医学经理需核实：sGC通路描述是否准确反映KZ-sGC1601的实际作用机制（是否兼具sGC刺激与NO增敏双重机制）、是否存在已知的脱靶效应或药物相互作用需在本节提及。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_636dc73860ce_3380716c263f131c","section_number":"2.4","source_ids":["protocol_full_draft_selection:1687653a1bc2fdc1fc402a31","current_project_study_definition:mwdefinition_29728c7097c3c43e460b:r4:ce444b99d8bb7f54","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:5425c4f8e6c0a6"]},{"ai_run_id":"airun_20261010022140_4ffba4c9","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_29728c7097c3c43e460b:revision:4","quote":"不良事件与严重不良事件发生率；生命体征与低血压事件；肝肾功能、血常规、心电图变化","quote_sha256":"0938053f114169eb68a9a8baa49774426c12dc3371bbb8935d96e2f8d6e2cad2","source_id":"current_project_study_definition:mwdefinition_29728c7097c3c43e460b:r4:ce444b99d8bb7f54","span_id":"es_004"},{"locator":"study_definition:mwdefinition_29728c7097c3c43e460b:revision:4","quote":"第12周NT-proBNP较基线的变化百分比（中心实验室检测）","quote_sha256":"73f1d58c9639434a82b995c30b49644f472237c93b58ef677c8edfc9173e63d6","source_id":"current_project_study_definition:mwdefinition_29728c7097c3c43e460b:r4:ce444b99d8bb7f54","span_id":"es_005"},{"locator":"study_definition:mwdefinition_29728c7097c3c43e460b:revision:4","quote":"中国成年慢性心力衰竭（LVEF≤40%，NYHA II-III级）患者，标准治疗基础上症状仍持续","quote_sha256":"cb614f9642c6b11fe626282bfa427aadfd09329dd9534215de6018c0b3a653f4","source_id":"current_project_study_definition:mwdefinition_29728c7097c3c43e460b:r4:ce444b99d8bb7f54","span_id":"es_006"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004","es_005","es_006"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"获取KZ-sGC1601非临床毒理学摘要及同类sGC刺激剂（如利奥西呱、维利西呱）在心血管适应证中的安全性数据，补充具体风险信号描述与监测依据。","category":"source_missing","gap_id":"gap_25_01","missing_source_classes":["非临床毒理学报告","同类药物安全性数据"],"target":"2.5节风险描述"},{"action":"补充HFrEF领域现有治疗（ARNI、SGLT2抑制剂、β受体阻滞剂、醛固酮拮抗剂）的残余风险数据，以论证sGC刺激策略的增量获益空间。","category":"source_missing","gap_id":"gap_25_02","missing_source_classes":["HFrEF治疗现状文献","现有标准治疗的残余风险数据"],"target":"2.5节获益论证"}],"heading":"获益/风险评估","missing_source_classes":["KZ-sGC1601非临床毒理学数据（重复给药毒性、安全药理学、遗传毒性）","同类sGC刺激剂在HFrEF或肺动脉高压中的安全性数据","sGC刺激剂类药物已知类别效应与药物相互作用信息"],"proposal_text":"本研究的潜在获益在于：KZ-sGC1601作为口服sGC刺激剂，在标准心衰基础治疗之上可能通过恢复cGMP信号传导改善HFrEF患者的血流动力学状态与心肌舒张功能，第12周NT-proBNP较基线的变化百分比作为主要终点可反映心室壁应力与容量负荷的改善程度。目标人群为LVEF≤40%、NYHA II-III级、在标准治疗基础上症状仍持续的中重度HFrEF成人，该人群现有治疗手段有限，若sGC刺激策略能产生可检测的NT-proBNP下降，则提示存在进一步开发价值。本研究的潜在风险与安全性关注点包括：sGC刺激剂类药物已知可能引起血管扩张相关不良事件，本研究将重点监测不良事件与严重不良事件发生率、生命体征与低血压事件、肝肾功能、血常规及心电图变化。鉴于目标人群为心功能不全患者，低血压事件的发生率与严重程度需特别关注；肝肾功能与血常规变化用于识别潜在的血液学或代谢毒性信号；心电图变化用于监测sGC刺激可能引起的心率与传导改变。本研究设置30天安全性随访期，以覆盖停药后迟发性不良事件的观察窗口。","rationale":"已确认事实支持：安全性终点明确包含AE/SAE发生率、生命体征与低血压事件、肝肾功能、血常规、心电图变化；目标人群为成人中重度HFrEF经治疗效不佳；主要终点为NT-proBNP变化；研究含30天安全性随访。低血压风险为基于sGC刺激剂血管扩张机制的合理推断，具体风险信号（如头痛、视觉障碍、体位性低血压发生率）需IB或同类药物安全性数据确认。医学经理需核实：是否需在获益/风险评估中纳入sGC刺激剂类药物的已知类别效应（如与PDE5抑制剂的相互作用风险）、HFrEF人群的特殊安全性关注点（如肾功能恶化、高钾血症）以及是否需要设置独立数据安全监查委员会。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_636dc73860ce_8a0dedab048e9402","section_number":"2.5","source_ids":["protocol_full_draft_selection:1687653a1bc2fdc1fc402a31","current_project_study_definition:mwdefinition_29728c7097c3c43e460b:r4:ce444b99d8bb7f54","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:5425c4f8e6c0a6"]},{"ai_run_id":"airun_20261010022140_4ffba4c9","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_29728c7097c3c43e460b:revision:4","quote":"内在研究目的：概念验证（PoC）；剂量探索","quote_sha256":"2d096e242bbd65d0c9236718d79e77a388e84cb9640b99bd47662a6ce8faab31","source_id":"current_project_study_definition:mwdefinition_29728c7097c3c43e460b:r4:ce444b99d8bb7f54","span_id":"es_002"},{"locator":"study_definition:mwdefinition_29728c7097c3c43e460b:revision:4","quote":"不良事件与严重不良事件发生率；生命体征与低血压事件；肝肾功能、血常规、心电图变化","quote_sha256":"0938053f114169eb68a9a8baa49774426c12dc3371bbb8935d96e2f8d6e2cad2","source_id":"current_project_study_definition:mwdefinition_29728c7097c3c43e460b:r4:ce444b99d8bb7f54","span_id":"es_004"},{"locator":"study_definition:mwdefinition_29728c7097c3c43e460b:revision:4","quote":"第12周NT-proBNP较基线的变化百分比（中心实验室检测）","quote_sha256":"73f1d58c9639434a82b995c30b49644f472237c93b58ef677c8edfc9173e63d6","source_id":"current_project_study_definition:mwdefinition_29728c7097c3c43e460b:r4:ce444b99d8bb7f54","span_id":"es_005"},{"locator":"study_definition:mwdefinition_29728c7097c3c43e460b:revision:4","quote":"中国成年慢性心力衰竭（LVEF≤40%，NYHA II-III级）患者，标准治疗基础上症状仍持续","quote_sha256":"cb614f9642c6b11fe626282bfa427aadfd09329dd9534215de6018c0b3a653f4","source_id":"current_project_study_definition:mwdefinition_29728c7097c3c43e460b:r4:ce444b99d8bb7f54","span_id":"es_006"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_004","es_005","es_006"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"确认是否设置次要疗效终点（如6分钟步行距离、NYHA分级变化、NT-proBNP绝对值变化、超声心动图参数）及探索性终点；若设置，需明确各终点的评估时点与检测方法。","category":"source_missing","gap_id":"gap_3_01","missing_source_classes":["次要终点定义","探索性终点定义"],"target":"3节次要终点"},{"action":"确认是否设置药代动力学采样时点以支持剂量-效应关系分析；若设置，需明确采样时间点与生物分析方法。","category":"source_missing","gap_id":"gap_3_02","missing_source_classes":["药代动力学采样方案"],"target":"3节药代动力学终点"}],"heading":"研究目的和终点","missing_source_classes":["次要疗效终点定义（如6分钟步行距离、NYHA分级、心超参数）","药代动力学采样方案","sGC刺激剂类特异性安全性监测要求"],"proposal_text":"本研究的主要目的为在标准心衰基础治疗之上，评估口服sGC刺激剂KZ-sGC1601（2.5mg、5mg、10mg每日一次）治疗12周对慢性心力衰竭伴射血分数降低（LVEF≤40%，NYHA II-III级）成人患者心室壁应力与容量负荷的影响，并初步探索剂量-效应关系。主要终点为第12周NT-proBNP较基线的变化百分比，由中心实验室检测。安全性终点包括：不良事件与严重不良事件发生率；生命体征与低血压事件；肝肾功能、血常规、心电图变化。本研究为II期概念验证与剂量探索研究，主要分析采用ANCOVA比较各组间第12周NT-proBNP较基线变化（对数转换），以基线值为协变量；安全性数据采用描述性统计。主要估计目标为第12周NT-proBNP较基线变化（疗法策略），伴发事件按抢救治疗策略处理。本研究不设置探索性目的或探索性终点。","rationale":"已确认事实支持：主要终点为第12周NT-proBNP较基线变化百分比（中心实验室检测）；安全性终点为AE/SAE发生率、生命体征与低血压事件、肝肾功能、血常规、心电图变化；研究目的为PoC与剂量探索；主要分析为ANCOVA（对数转换，基线为协变量）；安全性为描述性统计；主要估计目标为疗法策略，伴发事件按抢救治疗策略处理；剂量为2.5/5/10mg每日一次，疗程12周。医学经理需核实：是否需增加次要疗效终点（如6分钟步行距离、NYHA分级变化、NT-proBNP绝对值变化、心超参数）；是否需增加药代动力学采样时点以支持剂量-效应分析；安全性终点中是否需增加sGC刺激剂类特异性监测项目（如视力检查、体位性血压）。","review_advisories":["本节复述高影响研究设计（研究目的和终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、估计目标、伴发事件）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_636dc73860ce_ebdeecc17c26f625","section_number":"3","source_ids":["protocol_full_draft_selection:1687653a1bc2fdc1fc402a31","current_project_study_definition:mwdefinition_29728c7097c3c43e460b:r4:ce444b99d8bb7f54","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:5425c4f8e6c0a6"]}],"source_bindings":[{"content_sha256":"d78006c077d115583cade647b370c9b6dbc19c8eb8b77747076458f82782fadb","locator":"document:mwdoc_greenfield_proj_user_636dc73860ce_a3ac41b7c738ed6e:full-draft:1687653a1bc2fdc1fc402a31","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:1687653a1bc2fdc1fc402a31","source_type":"protocol_full_draft_selection","source_version":"full-draft:b03335af2adf362c569a95e50f5bce42edd7fe858a7a156dcf5d275f1a8e8ac8:1687653a1bc2fdc1fc402a31","text_sha256":"d78006c077d115583cade647b370c9b6dbc19c8eb8b77747076458f82782fadb"},{"content_sha256":"0e09c4ee71bb993452ae8c12ede83a94df75a1a869125d5ebc2254fddf553133","locator":"study_definition:mwdefinition_29728c7097c3c43e460b:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_29728c7097c3c43e460b:r4:ce444b99d8bb7f54","source_type":"current_project_study_definition","source_version":"mwdefinition_29728c7097c3c43e460b:r4:ce444b99d8bb7f54","text_sha256":"0e09c4ee71bb993452ae8c12ede83a94df75a1a869125d5ebc2254fddf553133"},{"content_sha256":"dfc9fceb41db9d941df0e3715483adaa069da4f1953600a6a37a56d7f81373dd","locator":"section:文档开头|block:4|chunk:1","role":"company_sop_or_protocol_reference","source_id":