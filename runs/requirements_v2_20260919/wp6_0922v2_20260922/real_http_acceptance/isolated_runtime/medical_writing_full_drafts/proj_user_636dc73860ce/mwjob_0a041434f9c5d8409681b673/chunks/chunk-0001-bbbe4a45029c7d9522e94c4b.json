n_ids":["es002"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[{"action":"补充KZ-sGC1601研究者手册或等效来源，包含完整作用机制、非临床药效学/药代动力学/毒理学数据及既往人体研究结果","category":"source_missing","gap_id":"gap_002","missing_source_classes":["研究者手册","非临床研究数据","既往临床研究资料"],"target":"研究药物简介章节中作用机制及既往研究部分"}],"heading":"研究药物简介","missing_source_classes":["研究者手册","作用机制详细描述","非临床研究数据","既往临床研究资料"],"proposal_text":"KZ-sGC1601为口服可溶性鸟苷酸环化酶（sGC）刺激剂，属小分子化合物，剂型为口服固体制剂（薄膜衣片），给药途径为口服，产生全身性暴露。本品与标准心衰基础治疗联用，在本研究中探索2.5mg、5mg、10mg每日一次三个剂量水平的有效性与安全性，疗程12周。","rationale":"本段正文依据当前项目已确认研究事实中关于试验药物技术类型（small_molecule）、给药途径（口服）、剂型（口服固体制剂）、暴露范围（systemic）及试验干预描述撰写。研究药物的完整作用机制、非临床研究数据及既往人体研究资料尚未提供，需补充研究者手册或相关文献后方可完善本章节。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_636dc73860ce_605a2b902586210c","section_number":"2.3","source_ids":["protocol_full_draft_selection:bbbe4a45029c7d9522e94c4b","current_project_study_definition:mwdefinition_29728c7097c3c43e460b:r4:ce444b99d8bb7f54","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:76a6125fa7dca4","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc6f8c9ea6d34b"]},{"ai_run_id":"airun_20261010022011_524e01bd","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"补充KZ-sGC1601非临床研究数据（药效学、药代动力学、毒理学）或研究者手册中相关章节","category":"source_missing","gap_id":"gap_003","missing_source_classes":["非临床研究数据","研究者手册","药理学/毒理学报告"],"target":"非临床研究结果章节正文"}],"heading":"非临床研究结果","missing_source_classes":["非临床研究数据","研究者手册","药理学/毒理学报告"],"proposal_text":"","rationale":"本章节需要KZ-sGC1601的非临床研究数据，包括体外及体内药效学、药代动力学、毒理学（急性毒性、重复给药毒性、安全药理学、遗传毒性、生殖毒性）等结果。当前允许来源中无任何非临床研究数据，章节当前正文