evision:6","quote":"按1:1:1:1随机分配","quote_sha256":"72c25373ccda39d122959ebb009159ca899766d2229de691c823ffd82e374382","source_id":"current_project_study_definition:mwdefinition_13987acca28e9d3b741e:r6:5d397aeff2202320","span_id":"es_03"},{"locator":"study_definition:mwdefinition_13987acca28e9d3b741e:revision:6","quote":"双盲双模拟，治疗期12周，联合标准GDMT背景治疗","quote_sha256":"0050af534b4e6f7a88a0a53a943d9d0b14495b549d1c00490ef7fa377dba8ca6","source_id":"current_project_study_definition:mwdefinition_13987acca28e9d3b741e:r6:5d397aeff2202320","span_id":"es_04"},{"locator":"study_definition:mwdefinition_13987acca28e9d3b741e:revision:6","quote":"主要终点NT-proBNP百分比变化采用ANCOVA（基线校正）并检验剂量-反应趋势","quote_sha256":"7155833a08f13fbf2f0748cd323132b347a3d3d07f71c57370f3abe6aad1f435","source_id":"current_project_study_definition:mwdefinition_13987acca28e9d3b741e:r6:5d397aeff2202320","span_id":"es_05"},{"locator":"study_definition:mwdefinition_13987acca28e9d3b741e:revision:6","quote":"主要终点：第12周NT-proBNP较基线的百分比变化（双盲期）。评价时间点：基线、第4/8/12周。","quote_sha256":"ed3fdeeb458362e8ec2062ccfdb54dabe86146616d3c09971d19582407bead01","source_id":"current_project_study_definition:mwdefinition_13987acca28e9d3b741e:r6:5d397aeff2202320","span_id":"es_12"}],"evidence_review_advisories":[],"evidence_span_ids":["es_01","es_02","es_03","es_04","es_05","es_12"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"获取现行HFrEF管理指南及本项目合并用药规定","category":"source_missing","gap_id":"gap_42_01","missing_source_classes":["HFrEF管理指南","合并用药规定"],"target":"设计依据中GDMT背景治疗的具体药物清单与允许/禁止合并用药规则"},{"action":"获取统计分析计划或统计方法学依据","category":"source_missing","gap_id":"gap_42_02","missing_source_classes":["统计分析计划"],"target":"设计依据中剂量-反应趋势检验的统计方法细节"}],"heading":"设计依据","missing_source_classes":["非临床药效学与毒理学研究报告","I期人体药代动力学与安全性数据","HFrEF流行病学与疾病负担文献","现行心衰管理指南（GDMT定义）"],"proposal_text":"本研究为II期概念验证与剂量探索研究，旨在评估KZ-sGC1201在射血分数降低的心力衰竭（HFrEF）成人患者中的初步疗效信号及剂量-反应关系。基于上述研究目的，采用随机、双盲、安慰剂对照、平行组、多中心设计，设置KZ-sGC1201低剂量（2.5 mg）、中剂量（5 mg）、高剂量（10 mg）三个试验组及安慰剂对照组，各组按1:1:1:1比例随机分配，治疗期12周，所有受试者联合标准指南导向的药物治疗（GDMT）背景。该设计允许在控制背景治疗的前提下，通过安慰剂对照排除安慰剂效应，通过三个剂量水平与安慰剂的组间比较检验剂量-反应趋势，从而为后续III期确证性研究的剂量选择提供依据。主要疗效终点为第12周NT-proBNP较基线的百分比变化，采用ANCOVA（基线校正）进行组间比较并检验剂量-反应趋势。估计目标采用治疗策略（treatment policy），即无论受试者是否发生剂量调整或合并用药变化，均按随机分组进行分析；终点前发生的事件按复合策略处理。该估计目标策略与II期概念验证目的相匹配，旨在评估KZ-sGC1201在真实临床管理条件下的整体治疗效应，而非仅在完全依从方案条件下的理想效应。","rationale":"设计事实来源于研究定义中已确定的方案框架：II期PoC+剂量探索目的、随机双盲安慰剂对照平行组多中心设计、三剂量组与安慰剂1:1:1:1分配、12周治疗期、联合GDMT背景、ANCOVA检验剂量-反应趋势、治疗策略估计目标与复合策略。需医学负责人确认：治疗策略中'终点前事件按复合策略处理'的具体适用情形与判定规则；GDMT背景治疗的具体允许/禁止药物清单；剂量-反应趋势检验的统计方法细节。","review_advisories":["本节提及高影响设计信息（估计目标、剂量选择）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_4e9f04592c63_0823578f051291ed","section_number":"4.2","source_ids":["protocol_full_draft_selection:e02750d7c3080a00c8193167","current_project_study_definition:mwdefinition_13987acca28e9d3b741e:r6:5d397aeff2202320","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:97a2bd7fcf7302"]},{"ai_run_id":"airun_20261007202611_e993d220","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_13987acca28e9d3b741e:revision:6","quote":"主要终点NT-proBNP百分比变化采用ANCOVA（基线校正）并检验剂量-反应趋势","quote_sha256":"7155833a08f13fbf2f0748cd323132b347a3d3d07f71c57370f3abe6aad1f435","source_id":"current_project_study_definition:mwdefinition_13987acca28e9d3b741e:r6:5d397aeff2202320","span_id":"es_05"},{"locator":"study_definition:mwdefinition_13987acca28e9d3b741e:revision:6","quote":"低剂量2.5 mg qd、中剂量5 mg qd、高剂量10 mg qd，每日晨起随餐口服；每4周随访评估耐受性，按方案规定剂量调整","quote_sha256":"f7f07d04153244904c44999d7630a79b9231cf16624297030ee95ca77a464f20","source_id":"current_project_study_definition:mwdefinition_13987acca28e9d3b741e:r6:5d397aeff2202320","span_id":"es_06"},{"locator":"study_definition:mwdefinition_13987acca28e9d3b741e:revision:6","quote":"每组约60例（共约240例），基于NT-proBNP组间差值文献效应量与80%把握度估算，用于概念验证与剂量选择","quote_sha256":"3a96066efbc288a65d4bc1e5efa7cf1a614acfc8d61b74bc14214cfb10aac24c","source_id":"current_project_study_definition:mwdefinition_13987acca28e9d3b741e:r6:5d397aeff2202320","span_id":"es_07"}],"evidence_review_advisories":[],"evidence_span_ids":["es_05","es_06","es_07"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"获取KZ-sGC1201非临床药效学/毒理学数据及I期PK/安全性数据，以论证2.5/5/10 mg三个剂量水平的选择依据","category":"source_missing","gap_id":"gap_421_01","missing_source_classes":["非临床药效学报告","非临床毒理学报告","I期PK数据","I期安全性数据","研究者手册"],"target":"4.2.1节剂量选择依据中非临床药效学/毒理学数据及I期PK/安全性数据"}],"heading":"剂量选择依据","missing_source_classes":["非临床药效学与毒理学研究报告","I期人体药代动力学数据","I期人体安全性数据","研究者手册"],"proposal_text":"本研究设置KZ-sGC1201三个剂量水平：低剂量2.5 mg、中剂量5 mg、高剂量10 mg，均为每日一次（qd），每日晨起随餐口服，治疗期12周。三剂量水平的设置旨在建立剂量-反应关系，为后续确证性研究的剂量选择提供依据。主要终点NT-proBNP百分比变化将采用ANCOVA（基线校正）并检验剂量-反应趋势，每组约60例（共约240例），基于NT-proBNP组间差值文献效应量与80%把握度估算。每4周随访评估耐受性，按方案规定进行剂量调整。上述剂量水平、给药频率、治疗周期及样本量参数依据研究定义中已确定的方案框架设定，具体剂量选择的非临床与早期临床依据详见研究者手册。","rationale":"三剂量水平（2.5/5/10 mg）、qd给药、晨起随餐口服、12周治疗期、每4周耐受性评估、ANCOVA剂量-反应趋势检验、每组约60例共约240例及80%把握度均来源于研究定义中已确定的方案框架。剂量选择的具体科学依据（非临床药效学/毒理学数据、I期PK/安全性数据、治疗窗分析）未在允许来源中提供，无法在本章完整阐述。","review_advisories":["本节复述高影响研究设计（剂量选择依据）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、剂量选择、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_4e9f04592c63_f2c2073e64711921","section_number":"4.2.1","source_ids":["protocol_full_draft_selection:e02750d7c3080a00c8193167","current_project_study_definition:mwdefinition_13987acca28e9d3b741e:r6:5d397aeff2202320","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:97a2bd7fcf7302"]},{"ai_run_id":"airun_20261007202611_e993d220","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_13987acca28e9d3b741e:revision:6","quote":"按1:1:1:1随机分配","quote_sha256":"72c25373ccda39d122959ebb009159ca899766d2229de691c823ffd82e374382","source_id":"current_project_study_definition:mwdefinition_13987acca28e9d3b741e:r6:5d397aeff2202320","span_id":"es_03"},{"locator":"section:随机|block:441|chunk:1","quote":"本研究采用交互式网络应答系统（IWRS）进行区组随机。Part-1 SAD研究、Part-2 MAD研究的每个剂量组参与者按随机分配接受CMS-D017或安慰剂给药。随机分配表由生物统计人员应用SAS统计软件（9.4及以上版本）产生。","quote_sha256":"7e25516aff883ef38cd01d1e5148f546cd19e8736af26ae42a50c4ca7588c324","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:97a2bd7fcf7302","span_id":"es_08"},{"locator":"section:随机和盲法|block:352|chunk:1","quote":"本研究为双盲随机设计，试验参与者、研究者、监查员以及数据分析人员等对试验参与者接受某剂量试验用药品类别属于试验药物/安慰剂均不知情。在研究开始之前由一名独立的随机化统计师撰写随机化方案，并根据随机化方案使用SAS 9.4（或更新版本）统计软件生成试验参与者随机表和药物随机表。","quote_sha256":"8daf6dc46d42155e29ca2768fe326bcf20208390c0e565062d237a9768f12e59","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","span_id":"es_09"}],"evidence_review_advisories":[],"evidence_span_ids":["es_03","es_08","es_09"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":1},"gap_items":[{"action":"获取本项目随机化方案或由统计人员确认分层策略","category":"source_missing","gap_id":"gap_43_01","missing_source_classes":["随机化方案"],"target":"随机化方法细节：区组大小、分层因素及分层水平"},{"action":"获取IWRS操作手册或系统验证文件","category":"source_missing","gap_id":"gap_43_02","missing_source_classes":["IWRS操作手册"],"target":"IWRS系统中随机化与药物分配的具体操作流程"}],"heading":"随机化","missing_source_classes":["随机化方案（区组大小、分层因素）","IWRS系统操作手册"],"proposal_text":"本研究采用随机化分配，KZ-sGC1201低剂量组（2.5 mg）、中剂量组（5 mg）、高剂量组（10 mg）与安慰剂对照组按1:1:1:1比例进行随机分配。随机化在受试者完成筛选并满足全部入选标准、排除标准后，于第0天（随机入组访视）通过交互式网络应答系统（IWRS）完成。随机分配表由独立统计人员使用统计软件生成，具体随机化方法（区组大小、分层因素及分层水平）在随机化方案中规定。随机化结果通过IWRS向研究中心反馈，研究中心据此向受试者发放相应编号的试验用药品或安慰剂。","rationale":"1:1:1:1随机比例来源于研究定义中已确定的方案框架。IWRS区组随机、独立统计人员生成随机表等表述参照公司语料中其他项目的章节结构，具体区组大小、分层因素（如是否按中心或NYHA分级分层）在本项目文件中未明确，需医学负责人与统计人员确认。","review_advisories":["本节复述高影响研究设计（随机化）；请在合并设计摘要中统一核对。","本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_4e9f04592c63_f75df6899b0d2c53","section_number":"4.3","source_ids":["protocol_full_draft_selection:e02750d7c3080a00c8193167","current_project_study_definition:mwdefinition_13987acca28e9d3b741e:r6:5d397aeff2202320","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:97a2bd7fcf7302"]},{"ai_run_id":"airun_20261007202611_e993d220","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_13987acca28e9d3b741e:revision:6","quote":"双盲双模拟，治疗期12周，联合标准GDMT背景治疗","quote_sha256":"0050af534b4e6f7a88a0a53a943d9d0b14495b549d1c00490ef7fa377dba8ca6","source_id":"current_project_study_definition:mwdefinition_13987acca28e9d3b741e:r6:5d397aeff2202320","span_id":"es_04"},{"locator":"section:随机和盲法|block:352|chunk:1","quote":"本研究为双盲随机设计，试验参与者、研究者、监查员以及数据分析人员等对试验参与者接受某剂量试验用药品类别属于试验药物/安慰剂均不知情。在研究开始之前由一名独立的随机化统计师撰写随机化方案，并根据随机化方案使用SAS 9.4（或更新版本）统计软件生成试验参与者随机表和药物随机表。","quote_sha256":"8daf6dc46d42155e29ca2768fe326bcf20208390c0e565062d237a9768f12e59","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","span_id":"es_09"},{"locator":"section:随机和盲法|block:356|chunk:1","quote":"在紧急情况时，研究者如果必须知道某一试验参与者是否在试验药物组以便开展对试验参与者治疗，需要对某一试验参与者进行紧急揭盲（在揭盲之前应告知申办者及临床监查员），研究者通过IWRS进行紧急揭盲，紧急揭盲之后该试验参与者将退出本研究。","quote_sha256":"ed20b992b38a3ba53c1bb731927abdf521ebfb1180ec248a7e95f0092a8fdade","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","span_id":"es_10"},{"locator":"section:研究揭盲|block:464|chunk:1","quote":"数据经盲态核查、清理，确定统计分析集人群，数据冻结或数据库锁定，此时，由授权的人员揭盲，即将各参与者的随机编号所对应的组别告知统计人员，以便对全部数据进行统计分析。","quote_sha256":"28fc3296e98e7793141221c4f6dd36a810f588fde79cc49c2b03a9aea2a5ec71","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","span_id":"es_11"}],"evidence_review_advisories":[],"evidence_span_ids":["es_04","es_09","es_10","es_11"],"evidence_summary":{"corpus_spans":3,"project_fact_spans":1},"gap_items":[{"action":"由医学负责人与统计团队确认盲态范围","category":"source_missing","gap_id":"gap_44_01","missing_source_classes":["盲法操作SOP"],"target":"盲态维持的具体人员范围（受试者、研究者、监查员、数据管理人员、统计人员等）"},{"action":"获取本项目紧急揭盲SOP或确认是否沿用通用流程","category":"source_missing","gap_id":"gap_44_02","missing_source_classes":["紧急揭盲流程文件"],"target":"紧急揭盲的具体触发条件、审批流程及揭盲后处理"},{"action":"由统计团队与数据管理部门确认揭盲时点和操作规范","category":"source_missing","gap_id":"gap_44_03","missing_source_classes":["数据管理SOP","统计分析计划"],"target":"研究结束揭盲的具体时点、操作责任方及数据锁定前盲态核查流程"}],"heading":"盲法与揭盲","missing_source_classes":["盲法操作SOP","紧急揭盲流程文件","IWRS系统验证文件","双模拟制备与质量检验文件"],"proposal_text":"本研究采用双盲设计。试验用药品（KZ-sGC1201片剂）与安慰剂采用双模拟方式制备，即安慰剂在外观、气味及包装上与试验药一致，使受试者和研究者无法从外观或给药方式上区分各组用药。随机化、药物分配及紧急揭盲通过IWRS系统管理。当研究者因受试者出现需要明确实际用药的紧急医学情况时，可通过IWRS进行紧急揭盲；紧急揭盲前研究者应告知申办者及临床监查员，揭盲后该受试者退出本研究，研究者须详细记录紧急揭盲的理由、日期、处理情况及结果。研究结束揭盲在全部受试者完成研究、数据经盲态核查与清理、确定统计分析集并完成数据库锁定后，由授权人员将各受试者的随机编号所对应组别告知统计人员，以便进行统计分析。","rationale":"双盲设计、双模拟来源于研究定义中已确定的方案框架。紧急揭盲通过IWRS操作、揭盲后退出研究、研究结束揭盲在数据库锁定后由授权人员执行等表述参照公司语料中其他项目的章节结构。本项目未明确：盲态维持的具体人员范围（是否包括监查员、数据管理人员、统计人员）；紧急揭盲的具体触发条件和审批流程；研究结束揭盲的具体时点和操作责任方。上述内容需医学负责人确认后方可定稿。","review_advisories":["本节复述高影响研究设计（盲法与揭盲）；请在合并设计摘要中统一核对。","本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_4e9f04592c63_b4e92961c9268f41","section_number":"4.4","source_ids":["protocol_full_draft_selection:e02750d7c3080a00c8193167","current_project_study_definition:mwdefinition_13987acca28e9d3b741e:r6:5d397aeff2202320","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:97a2bd7fcf7302"]}],"source_bindings":[{"content_sha256":"0723f9efeb36e428ee407fed83f47dd37c29294d9092d4ec27adf0282747932a","locator":"document:mwdoc_greenfield_proj_user_4e9f04592c63_2c493b849da84a70:full-draft:e02750d7c3080a00c8193167","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:e02750d7c3080a00c8193167","source_type":"protocol_full_draft_selection","source_version":"full-draft:c6db057129385f4569bbfa293ad2e538ea037252b306813884be18a9e30894a1:e02750d7c3080a00c8193167","text_sha256":"0723f9efeb36e428ee407fed83f47dd37c29294d9092d4ec27adf0282747932a"},{"content_sha256":"c325e9817d1cf579e7ab57b2e407e0c0773a11b3252a3cf3fee19ef3e195636f","locator":"study_definition:mwdefinition_13987acca28e9d3b741e:revision:6","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_13987acca28e9d3b741e:r6:5d397aeff2202320","source_type":"current_project_study_definition","source_version":"mwdefinition_13987acca28e9d3b741e:r6:5d397aeff2202320","text_sha256":"c325e9817d1cf579e7ab57b2e407e0c0773a11b3252a3cf3fee19ef3e195636f"},{"content_sha256":"561c757e6967fae66f0f9d1043dba3e313bd0ee60a03f2c3c8da5efe892b0128","locator":"section:6.3.3 揭盲|block:490|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","source_type":"company_protocol_reference_corpus","source_version":"dbed66cc1d7b3a","text_sha256":"561c757e6967fae66f0f9d1043dba3e313bd0ee60a03f2c3c8da5efe892b0128"},{"content_sha256":"1541424a072504b13dc999a7346751e32eebb848cc0771bb2ef3908b11c26ea0","locator":"section:研究揭盲|block:464|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","source_type":"company_protocol_reference_corpus","source_version":"4a27cdd782c3be","text_sha256":"1541424a072504b13dc999a7346751e32eebb848cc0771bb2ef3908b11c26ea0"},{"content_sha256":"8daf6dc46d42155e29ca2768fe326bcf20208390c0e565062d237a9768f12e59","locator":"section:随机和盲法|block:352|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","source_type":"company_protocol_reference_corpus","source_version":"046677b43d417b","text_sha256":"8daf6dc46d42155e29ca2768fe326bcf20208390c0e565062d237a9768f12e59"},{"content_sha256":"9dcf0050e6908f1bf1781d1b4e78bece680543f7bd3b6d430526c8fa0873ec33","locator":"section:随机和盲法|block:356|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","source_type":"company_protocol_reference_corpus","source_version":"8b49478f82c322","text_sha256":"9dcf0050e6908f1bf1781d1b4e78bece680543f7bd3b6d430526c8fa0873ec33"},{"content_sha256":"7e25516aff883ef38cd01d1e5148f546cd19e8736af26ae42a50c4ca7588c324","locator":"section:随机|block:441|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:97a2bd7fcf7302","source_type":"company_protocol_reference_corpus","source_version":"97a2bd7fcf7302","text_sha256":"7e25516aff883ef38cd01d1e5148f546cd19e8736af26ae42a50c4ca7588c324"}]}