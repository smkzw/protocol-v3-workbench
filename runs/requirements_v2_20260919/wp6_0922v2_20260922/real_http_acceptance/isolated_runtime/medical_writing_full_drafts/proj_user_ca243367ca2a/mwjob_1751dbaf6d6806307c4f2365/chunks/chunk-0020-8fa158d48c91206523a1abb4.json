tocol_full_draft_selection:8fa158d48c91206523a1abb4","current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:9c37052ed864d8","company_corpus:cms_cn_protocol_corpus_20260715_v1:3152bfe8bf762f"]},{"ai_run_id":"airun_20261001062327_589290c8","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:研究方案|block:3|chunk:1","quote":"保密声明：本文件中的信息保密，所有权归申办者。根据中国法律法规要求，本文件仅提供给研究者和伦理委员会、监督管理部门等相关的机构审阅。除了在与可能参加本研究的参与者签署知情同意书时，向其做必要的解释之外，没有本研究申办者的书面授权许可，任何个人不得分发、复制、发表或披露本文件的任何内容。","quote_sha256":"1c9bd60b0ed4201c6bec19547871ef92486dca414efca733184b442256b0eb91","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","span_id":"es_002"},{"locator":"section:评价CMS-D001在中度至重度特应性皮炎患者中的有效性和安全性的多中心、随机、双盲、安慰剂对照的Ⅱ期临床研究|block:30|chunk:1","quote":"作为合同研究组织，将根据《药物临床试验质量管理规范》的规定及《赫尔辛基宣言》，认真履行监查职责，保证遵循已批准的方案实施本项临床试验，保证临床试验中参与者权益得到保障，试验记录与报告准确、完整、无误。","quote_sha256":"d4fc7a9ff901934569cfc239769e38805879eeba4005423e1fb707bf6933bef2","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:9c37052ed864d8","span_id":"es_003"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"总体研究设计：随机、双盲、安慰剂对照、平行组、多中心II期剂量探索设计","quote_sha256":"6b541f609b7dbe55eeebdf04f2def91dbe2a8f33b58d692f3d04a9bb87b739cf","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_005"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003","es_005"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":1},"gap_items":[{"action":"获取本项目文件管理SOP或方案附件中的文件清单，明确各文件的责任方、审批流程及分发范围","category":"source_missing","gap_id":"gap_doc_001","missing_source_classes":["文件管理SOP","方案附件文件清单"],"target":"研究文件清单及版本控制流程"},{"action":"获取CRO服务合同或监查计划中关于监查频率、远程与现场监查比例、监查报告格式及升级机制的条款","category":"source_missing","gap_id":"gap_doc_002","missing_source_classes":["CRO服务合同","监查计划"],"target":"CRO具体职责与监查协调分工"},{"action":"确认各中心试验主文档应包含的文件类别、保存期限及查阅权限规定","category":"source_missing","gap_id":"gap_doc_003","missing_source_classes":["试验主文档目录模板","中心SOP"],"target":"试验主文档目录及查阅权限"}],"heading":"研究文件、监查和管理","missing_source_classes":["本项目监查计划","文件管理SOP","CRO职责分工合同条款","试验主文档目录模板"],"proposal_text":"本方案为多中心、随机、双盲、安慰剂对照、平行组II期剂量探索研究，在中国境内开展，研究文件的管理、监查与协调工作须遵循《药物临床试验质量管理规范》及《赫尔辛基宣言》的相关要求。研究方案、研究者手册、知情同意书、病例报告表、监查计划、数据管理计划及统计分析计划等核心文件由申办者统一编制、版本控制与分发，各研究中心仅可在获得申办者书面授权后向伦理委员会及监督管理部门提交审阅，未经书面许可不得向与本研究无关的第三方分发、复制、发表或披露上述文件内容。本研究的监查与协调工作由合同研究组织承担，其职责包括保证试验按照已批准的方案实施、保障受试者权益、确保试验记录与报告准确完整无误。各研究中心须建立并维护完整的试验主文档，包括伦理批件、方案及修正案签署页、研究者简历与资质证明、培训记录、监查报告、方案偏离记录及安全性报告等，供监查员、稽查员及药品监督管理部门查阅。","rationale":"多中心设计、中国开发区域及GCP合规要求来自当前项目已确认研究事实；保密与分发限制、CRO监查职责框架来自公司语料中两份不同适应症II期方案的监管共性结构参照，仅用于本章节措辞与框架搭建，不构成对本项目具体文件清单、监查频率或CRO职责细则的确认。医学经理需核实：本项目实际使用的文件清单、CRO合同中的具体职责条款、各中心文件管理SOP及主文档目录。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ca243367ca2a_eace22f9ec1a5943","section_number":"12","source_ids":["protocol_full_draft_selection:8fa158d48c91206523a1abb4","current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:9c37052ed864d8","company_corpus:cms_cn_protocol_corpus_20260715_v1:3152bfe8bf762f"]},{"ai_run_id":"airun_20261001062327_589290c8","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:12.2 方案偏离|block:950|chunk:1","quote":"研究方案中规定的所有要求，必须严格执行。任何有意或无意偏离或违背研究方案和GCP原则的行为，均视为偏离方案或违背方案。监查员在监查过程中，如果发现偏离或违背方案，应由研究者或监查员填写偏离方案记录，详细记录事件发生的时间及过程、原因及相应的处理措施，由研究者签字，并根据研究中心相关规定通报伦理委员会及申办者。","quote_sha256":"5835023d355adeb7381fab0ec44d0b5dae2b454a729a4902b3cd66da6650dacc","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8","span_id":"es_004"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":0},"gap_items":[{"action":"获取本项目方案偏离分级标准文件，明确轻微、重大、严重偏离的定义、报告时限及审批层级","category":"source_missing","gap_id":"gap_dev_001","missing_source_classes":["方案偏离分级标准","偏离报告SOP"],"target":"方案偏离分级标准与报告时限"},{"action":"确认各中心伦理委员会对方案偏离的通报要求及申办者内部从监查员到医学经理的升级路径","category":"source_missing","gap_id":"gap_dev_002","missing_source_classes":["伦理委员会通报SOP","申办者内部升级机制文件"],"target":"伦理委员会通报路径与申办者升级机制"}],"heading":"研究方案的依从","missing_source_classes":["方案偏离分级标准","偏离报告时限规定","伦理委员会通报流程SOP","申办者内部升级机制"],"proposal_text":"研究方案中规定的所有要求，各研究中心及研究者必须严格执行。任何有意或无意偏离或违背研究方案和GCP原则的行为，均视为方案偏离或方案违背。监查员在监查过程中发现方案偏离或违背时，应由研究者或监查员填写方案偏离记录，详细记录事件发生的时间、过程、原因及相应的处理措施，由研究者签字确认，并根据研究中心相关规定通报伦理委员会及申办者。所有可能严重违背方案的情况必须立即报告申办者。当发生重大方案违背时，由研究者和申办者共同评估其对受试者安全、数据完整性及研究科学性的影响；必要时，申办者有权提前终止本研究。各研究中心应建立方案偏离的内部登记与追踪机制，确保每例偏离均被记录、评估和关闭。","rationale":"方案偏离处理流程的结构框架来自公司语料中一份特应性皮炎II期方案的监管共性条款，仅作为章节结构与措辞参照，不构成本项目已确认的偏离分级标准、报告时限或伦理通报具体流程。当前项目已确认研究事实中未包含方案偏离分级、报告时限或伦理委员会通报细则。医学经理需核实：本项目方案偏离的分级标准（轻微、重大、严重）、报告时限、伦理委员会通报路径及申办者内部升级流程。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ca243367ca2a_2e269e47cceccd85","section_number":"12.1","source_ids":["protocol_full_draft_selection:8fa158d48c91206523a1abb4","current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:9c37052ed864d8","company_corpus:cms_cn_protocol_corpus_20260715_v1:3152bfe8bf762f"]},{"ai_run_id":"airun_20261001062327_589290c8","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:评价CMS-D001在中度至重度特应性皮炎患者中的有效性和安全性的多中心、随机、双盲、安慰剂对照的Ⅱ期临床研究|block:30|chunk:1","quote":"作为合同研究组织，将根据《药物临床试验质量管理规范》的规定及《赫尔辛基宣言》，认真履行监查职责，保证遵循已批准的方案实施本项临床试验，保证临床试验中参与者权益得到保障，试验记录与报告准确、完整、无误。","quote_sha256":"d4fc7a9ff901934569cfc239769e38805879eeba4005423e1fb707bf6933bef2","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:9c37052ed864d8","span_id":"es_003"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"总体研究设计：随机、双盲、安慰剂对照、平行组、多中心II期剂量探索设计","quote_sha256":"6b541f609b7dbe55eeebdf04f2def91dbe2a8f33b58d692f3d04a9bb87b739cf","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_005"}],"evidence_review_advisories":[],"evidence_span_ids":["es_003","es_005"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":1},"gap_items":[{"action":"获取本项目监查计划，明确各阶段监查频率、远程与现场监查比例及触发额外监查的条件","category":"source_missing","gap_id":"gap_mon_001","missing_source_classes":["监查计划","监查SOP"],"target":"监查频率与方式"},{"action":"确认监查报告模板、纠正与预防措施跟踪流程及监查报告归档要求","category":"source_missing","gap_id":"gap_mon_002","missing_source_classes":["监查报告模板","CAPA跟踪SOP"],"target":"监查报告格式与跟踪机制"},{"action":"确认监查员资质要求、GCP培训记录及本方案培训完成标准","category":"source_missing","gap_id":"gap_mon_003","missing_source_classes":["监查员资质要求文件","培训记录模板"],"target":"监查员资质与培训"}],"heading":"监查","missing_source_classes":["本项目监查计划","监查报告模板","远程监查与现场监查比例规定","监查员资质与培训要求"],"proposal_text":"本研究的监查工作由合同研究组织承担，监查员依据《药物临床试验质量管理规范》及《赫尔辛基宣言》履行监查职责，保证试验按照已批准的方案实施，保证受试者权益得到保障，试验记录与报告准确、完整、无误。鉴于本研究为多中心设计，监查覆盖范围应涵盖所有参与中心，监查频率与方式由申办者根据各中心入组进度、数据质量及风险等级确定。监查员在每次监查中应核查受试者知情同意签署情况、方案依从性、不良事件及严重不良事件的记录与报告完整性、试验用药品管理记录、病例报告表填写的及时性与准确性，以及试验主文档的完整性。监查员发现方案偏离或安全性问题时，应按本方案规定的流程记录并上报。监查报告应记录监查日期、核查内容、发现的问题、已采取或建议采取的纠正与预防措施，以及上次监查遗留事项的跟踪结果。","rationale":"监查职责框架及GCP合规要求来自公司语料中一份特应性皮炎II期方案的监管共性结构参照；多中心设计事实来自当前项目已确认研究事实。公司语料来源为不同适应症方案，仅用于章节结构与措辞参照，不迁移其具体监查频率、远程与现场比例或监查员资质要求。当前项目来源未提供本项目监查计划、监查频率、监查报告模板或远程监查安排。医学经理需核实：本项目监查计划中的具体频率、远程与现场监查比例、监查员资质要求及监查报告格式。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ca243367ca2a_dd6793cec550d290","section_number":"12.2","source_ids":["protocol_full_draft_selection:8fa158d48c91206523a1abb4","current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:9c37052ed864d8","company_corpus:cms_cn_protocol_corpus_20260715_v1:3152bfe8bf762f"]}],"source_bindings":[{"content_sha256":"bb05d0363b571ee951fe776822339421040a76ab215d15dff33223bb4e2da19e","locator":"document:mwdoc_greenfield_proj_user_ca243367ca2a_adbd670a8e0aeb81:full-draft:8fa158d48c91206523a1abb4","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:8fa158d48c91206523a1abb4","source_type":"protocol_full_draft_selection","source_version":"full-draft:1261a5ee23d866bffcd1d6c4604fa224c93c2d3b6c431f32ae9ac3991aff2f4c:8fa158d48c91206523a1abb4","text_sha256":"bb05d0363b571ee951fe776822339421040a76ab215d15dff33223bb4e2da19e"},{"content_sha256":"2683593eb7fcd2c0f43e4f78cfac287862e46f820d85674aed7d2e5ef8839932","locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","source_type":"current_project_study_definition","source_version":"mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","text_sha256":"2683593eb7fcd2c0f43e4f78cfac287862e46f820d85674aed7d2e5ef8839932"},{"content_sha256":"4ad13e82fb4d9748aa0fff1e399c95e53a8a8dd52e482eea1f8ff37b51605465","locator":"section:12.2 方案偏离|block:950|c