ection:7410b5b0735e91ff79890ca4","current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:5425c4f8e6c0a6"]},{"ai_run_id":"airun_20261001045737_dd033968","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"内在研究目的：概念验证（PoC）；剂量探索","quote_sha256":"2d096e242bbd65d0c9236718d79e77a388e84cb9640b99bd47662a6ce8faab31","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_002"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"试验药物：SMOKE-r2-3口服sGC激动剂（SGC-R23）\n适应症：慢性心力衰竭（射血分数降低，HFrEF）","quote_sha256":"73cb9ed5f99e9c77e15ddca8c66ef295c908c65628718b0a52ebf8d2ee516057","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_003"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"目标研究人群：年龄段：成人；疾病状态：中重度；在标准心衰治疗（GDMT）基础上仍残留症状的成人HFrEF患者","quote_sha256":"eee2450d9723c5490db6c5a3ab42a40e674f6084a2ff533c46eb680d7202c128","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_006"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"剂量与给药方案：SMOKE-r2-3口服sGC激动剂（SGC-R23）：SMOKE-r2-3片：低剂量组2.5mg、高剂量组5mg，口服每日一次，连续12周","quote_sha256":"3a556dfcc63487a2f695b007bee31b088bc2096a93876bf2108328b158357a77","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_007"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003","es_006","es_007"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"补充sGC-cGMP通路在HFrEF病理生理中的作用及SGC-R23的非临床药效学证据","category":"source_missing","gap_id":"gap_24_01","missing_source_classes":["sGC-cGMP信号通路在HFrEF中的机制文献","SGC-R23非临床药效学与毒理学数据"],"target":"2.4节机制论证段落"},{"action":"提供2.5mg与5mg剂量选择的非临床或早期临床依据","category":"source_missing","gap_id":"gap_24_02","missing_source_classes":["剂量选择的非临床依据","同类sGC激动剂既往临床研究证据"],"target":"2.4节剂量选择依据段落"}],"heading":"本研究的理论基础","missing_source_classes":["sGC-cGMP信号通路在HFrEF中的机制文献","SGC-R23非临床药效学与毒理学数据","同类sGC激动剂既往临床研究证据","剂量选择的非临床依据"],"proposal_text":"本研究为II期概念验证与剂量探索研究，旨在评估SMOKE-r2-3口服sGC激动剂（SGC-R23）在慢性心力衰竭（射血分数降低，HFrEF）成人受试者中的初步疗效信号与安全性特征。研究采用随机、双盲、安慰剂对照、平行组、多中心设计，设置SGC-R23低剂量（2.5mg每日一次）、高剂量（5mg每日一次）及安慰剂三个治疗组，治疗持续12周。目标人群为在标准心衰治疗（GDMT）基础上仍残留症状的成人HFrEF患者，即年龄18至75周岁、左室射血分数不超过40%、NYHA心功能II至III级、筛选前稳定剂量GDMT至少4周的受试者。本研究的内在研究目的为概念验证与剂量探索，通过比较两个活性剂量组与安慰剂组在第12周NT-proBNP较基线百分比变化上的差异，初步验证sGC激动剂在HFrEF人群中的生物学效应，并为后续确证性研究的剂量选择提供依据。","rationale":"已确认事实支持：药物类别（口服sGC激动剂）、适应症（HFrEF）、研究分期（II期）、设计类型（随机双盲安慰剂对照平行组多中心）、剂量方案（2.5mg/5mg QD，12周）、目标人群（GDMT基础上残留症状的成人HFrEF）、内在目的（PoC与剂量探索）。但sGC-cGMP通路在HFrEF中的病理生理机制、SGC-R23非临床药效学数据、剂量选择的非临床依据及同类药物既往临床证据均未在允许来源中提供，上述内容需医学经理依据IB或文献补充后方可纳入。","review_advisories":["本节提及高影响设计信息（剂量选择）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ca243367ca2a_3935e5b22649046c","section_number":"2.4","source_ids":["protocol_full_draft_selection:7410b5b0735e91ff79890ca4","current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:5425c4f8e6c0a6"]},{"ai_run_id":"airun_20261001045737_dd033968","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"主要终点：第12周NT-proBNP较基线百分比变化（中心实验室，访视窗±7天）","quote_sha256":"f859905b074bcc88cfa5a6e70c590cbbb6a0c04fcbae436697fc3b9da07f0b9f","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_004"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"安全性终点：第12周6分钟步行距离较基线变化","quote_sha256":"deb2625f8c922a57be11b498fa95e3cb111bfc22077ea36c08d1c7972f5e0353","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_005"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"目标研究人群：年龄段：成人；疾病状态：中重度；在标准心衰治疗（GDMT）基础上仍残留症状的成人HFrEF患者","quote_sha256":"eee2450d9723c5490db6c5a3ab42a40e674f6084a2ff533c46eb680d7202c128","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_006"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"特别关注的不良事件：TEAE发生率与严重程度（MedDRA 27.0）；第0、4、12周体位性低血压与收缩压变化","quote_sha256":"f308c4e2dc4f61c3f077cae43d91833eb183f9081fb2e6e4e527401832a77780","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_009"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004","es_005","es_006","es_009"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"提供SGC-R23及同类sGC激动剂的已知安全性风险（如低血压、血管扩张事件）及本方案拟采取的风险缓解措施","category":"source_missing","gap_id":"gap_25_01","missing_source_classes":["SGC-R23及sGC激动剂类已知安全性风险","风险缓解与监测措施"],"target":"2.5节风险特征与缓解措施段落"},{"action":"基于非临床与既往临床数据完成获益/风险定量或定性论证","category":"source_missing","gap_id":"gap_25_02","missing_source_classes":["获益/风险定量论证"],"target":"2.5节获益/风险综合判断段落"}],"heading":"获益/风险评估","missing_source_classes":["SGC-R23及sGC激动剂类已知安全性风险","获益/风险定量论证","风险缓解与监测措施"],"proposal_text":"本研究针对在标准心衰治疗（GDMT）基础上仍残留症状的成人HFrEF患者，评估SMOKE-r2-3口服sGC激动剂（SGC-R23）2.5mg与5mg每日一次、连续12周给药在改善心衰生物学标志物及运动耐量方面的潜在获益。主要疗效终点为第12周NT-proBNP较基线百分比变化（中心实验室检测，访视窗±7天），安全性终点为第12周6分钟步行距离较基线变化。安全性评估涵盖TEAE发生率与严重程度（采用MedDRA 27.0编码），特别关注第0、4、12周体位性低血压与收缩压变化。研究期间设置筛选期（最长14天）、双盲治疗期（12周）及安全性随访期（末次给药后14天），访视节点包括筛选（D-14至D-1）、随机（D0）、第4周、第8周、第12周访视及治疗结束与安全性随访。","rationale":"已确认事实支持：目标人群（GDMT基础上残留症状的成人HFrEF）、主要终点（第12周NT-proBNP较基线百分比变化，中心实验室，访视窗±7天）、安全性终点（第12周6分钟步行距离较基线变化）、特别关注不良事件（TEAE MedDRA 27.0；第0/4/12周体位性低血压与收缩压变化）、研究时期与访视策略。但SGC-R23及sGC激动剂类药物的已知安全性风险特征、获益与风险的具体权衡论证、风险缓解措施及停止规则等需依据IB或既往安全性数据由医学经理确认后方可补充。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ca243367ca2a_eb784d815d6db6f1","section_number":"2.5","source_ids":["protocol_full_draft_selection:7410b5b0735e91ff79890ca4","current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:5425c4f8e6c0a6"]},{"ai_run_id":"airun_20261001045737_dd033968","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"主要终点：第12周NT-proBNP较基线百分比变化（中心实验室，访视窗±7天）","quote_sha256":"f859905b074bcc88cfa5a6e70c590cbbb6a0c04fcbae436697fc3b9da07f0b9f","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_004"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"安全性终点：第12周6分钟步行距离较基线变化","quote_sha256":"deb2625f8c922a57be11b498fa95e3cb111bfc22077ea36c08d1c7972f5e0353","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_005"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"样本量策略：假设安慰剂组NT-proBNP平均降15%、试验组降30%、SD=25%，双侧α=0.05、把握度80%，每组约60例，三组180例，加10%脱落约200例\n统计分析策略：主要终点ANCOVA（基线协变量、组别固定效应）；安全性描述统计；FAS与SS分别定义","quote_sha256":"adb55ff455780a4214539540b36f021d5466e43d521e59d3f371f8c8def61045","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_008"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"特别关注的不良事件：TEAE发生率与严重程度（MedDRA 27.0）；第0、4、12周体位性低血压与收缩压变化","quote_sha256":"f308c4e2dc4f61c3f077cae43d91833eb183f9081fb2e6e4e527401832a77780","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_009"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004","es_005","es_008","es_009"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[],"heading":"研究目的和终点","missing_source_classes":[],"proposal_text":"本研究的主要目的为评估SMOKE-r2-3口服sGC激动剂（SGC-R23）2.5mg与5mg每日一次在慢性HFrEF成人受试者中较安慰剂的初步疗效信号，主要终点为第12周NT-proBNP较基线百分比变化（中心实验室检测，访视窗±7天）。安全性终点为第12周6分钟步行距离较基线变化。安全性评估包括TEAE发生率与严重程度（MedDRA 27.0编码），特别关注第0、4、12周体位性低血压与收缩压变化。主要估计目标为随机化人群第12周NT-proBNP较基线百分比变化，死亡或心衰住院退出按治疗策略处理。主要终点采用ANCOVA分析（基线协变量、组别固定效应），安全性采用描述统计，全分析集（FAS）与安全集（SS）分别定义。样本量基于以下假设确定：安慰剂组NT-proBNP平均下降15%、试验组下降30%、标准差25%，双侧α=0.05、把握度80%，每组约60例，三组共180例，考虑10%脱落率后计划入组约200例。本研究不设置探索性目的或探索性终点。","rationale":"已确认事实支持：主要终点（第12周NT-proBNP较基线百分比变化，中心实验室，访视窗±7天）、安全性终点（第12周6分钟步行距离较基线变化）、特别关注不良事件（TEAE MedDRA 27.0；第0/4/12周体位性低血压与收缩压变化）、估计目标策略（随机化人群，死亡或心衰住院退出按治疗策略处理）、统计方法（ANCOVA，基线协变量与组别固定效应；安全性描述统计；FAS与SS分别定义）、样本量假设与计算（安慰剂降15%、试验组降30%、SD=25%、α=0.05、把握度80%、每组60例、三组180例、加10%脱落约200例）。本批次无待确认研究字段，未设置探索性目的或终点。","review_advisories":["本节复述高影响研究设计（研究目的和终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（α、主要终点、估计目标、样本量、计划入组）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ca243367ca2a_eeff70df59c98a61","section_number":"3","source_ids":["protocol_full_draft_selection:7410b5b0735e91ff79890ca4","current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:5425c4f8e6c0a6"]}],"source_bindings":[{"content_sha256":"d0a07a96142fda2cedbf4559f8b7e9698d29562a7ec078f3e268ab926261159f","locator":"document:mwdoc_greenfield_proj_user_ca243367ca2a_adbd670a8e0aeb81:full-draft:7410b5b0735e91ff79890ca4","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:7410b5b0735e91ff79890ca4","source_type":"protocol_full_draft_selection","source_version":"full-draft:1261a5ee23d866bffcd1d6c4604fa224c93c2d3b6c431f32ae9ac3991aff2f4c:7410b5b0735e91ff79890ca4","text_sha256":"d0a07a96142fda2cedbf4559f8b7e9698d29562a7ec078f3e268ab926261159f"},{"content_sha256":"2683593eb7fcd2c0f43e4f78cfac287862e46f820d85674aed7d2e5ef8839932","locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","source_type":"current_project_study_definition","source_version":"mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","text_sha256":"2683593eb7fcd2c0f43e4f78cfac287862e46f820d85674aed7d2e5ef8839932"},{"content_sha256":"dfc9fceb41db9d941df0e3715483adaa069da4f1953600a6a37a56d7f81373dd","locator":"section:文档开头|block:4|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","source_type":"company_protocol_reference_corpus","source_version":"342cfc57d67b67","text