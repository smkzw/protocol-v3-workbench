ion_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_safety_assessment"}],"evidence_review_advisories":[],"evidence_span_ids":["es_blind_design","es_randomization","es_dose_regimen","es_study_periods","es_visit_strategy","es_primary_endpoint","es_safety_endpoint","es_safety_assessment"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":8},"gap_items":[{"action":"由医学经理和方案撰写团队依据主要终点（NT-proBNP）、安全性终点（6MWD）和安全性评估（体位性低血压、收缩压、TEAE）的采集需求，确定各访视需执行的评估项目并编制访视计划表","category":"source_missing","gap_id":"gap_7_visit_procedures","missing_source_classes":["各访视评估项目清单（项目级）","访视流程图或访视计划表"],"target":"第7章各访视（筛选、D0、W4、W8、W12、治疗结束、安全性随访）的具体评估项目清单"}],"heading":"研究程序和评估","missing_source_classes":["各访视评估项目清单（项目级）","访视流程图或访视计划表"],"proposal_text":"本研究为随机、双盲、安慰剂对照、平行组、多中心II期剂量探索设计，采用1:1:1平行随机分配，将受试者分配至SGC-R23低剂量组（2.5mg每日一次）、SGC-R23高剂量组（5mg每日一次）或安慰剂组（口服安慰剂每日一次，外观与给药频次与活性药物一致）。研究时期包括筛选期（最长14天）、双盲治疗期（12周）和安全性随访期（末次给药后14天）。访视安排为筛选访视（D-14至D-1）、随机访视（D0）、第4周（W4）访视、第8周（W8）访视、第12周（W12）访视、治疗结束访视及安全性随访访视。主要疗效终点为第12周NT-proBNP较基线百分比变化，由中心实验室检测，访视窗为±7天。安全性评估包括治疗期间不良事件（TEAE）发生率与严重程度（采用MedDRA 27.0编码），以及第0周、第4周和第12周的体位性低血压与收缩压变化。安全性终点为第12周6分钟步行距离较基线变化。","rationale":"研究设计、分组、剂量、治疗周期、访视策略、主要终点、安全性终点和安全性评估内容均来源于已确认研究事实，已按原值写入。但各访视具体评估项目清单（如哪些访视进行心电图、实验室检查、体格检查、6MWD、NT-proBNP采样等）未在来源中逐项列出，需依据访视策略和终点要求进一步细化。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ca243367ca2a_ca9200f908ec173d","section_number":"7","source_ids":["protocol_full_draft_selection:b83cce27747225a871f08cab","current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867"]},{"ai_run_id":"airun_20261001052408_8b1c098f","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"筛选期（最长14天）；双盲治疗期（12周）；安全性随访期（末次给药后14天）","quote_sha256":"3ab70b78bf465f7aed9cbd5b41012e6425131edbc8e6cf47f0a3865ee2d50d2c","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_study_periods"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"筛选（D-14至D-1）、随机（D0）、W4/W8/W12访视、治疗结束与安全性随访","quote_sha256":"871953d63580bee83ce15c20ed776918a18e2644360fe343e50066750959ca09","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_visit_strategy"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"第12周NT-proBNP较基线百分比变化（中心实验室，访视窗±7天）","quote_sha256":"079f5c0a1affa3e37d620b2c4c90a298de11dca6af4efaf979b3707ca71e4761","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_primary_endpoint"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"第12周6分钟步行距离较基线变化","quote_sha256":"6b9caa79a7d5a60c5b0bac4768cc56146210e8f71680747e63ee5f7fb3611883","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_safety_endpoint"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"TEAE发生率与严重程度（MedDRA 27.0）；第0、4、12周体位性低血压与收缩压变化","quote_sha256":"dd239b7d837135c6b1f141e455311f8dcfb0031595bd2c57e4713f49a5c8e8c9","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_safety_assessment"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"低剂量组2.5mg、高剂量组5mg，口服每日一次，连续12周","quote_sha256":"1a838d423e8f8e0a1c7351e758bc0305bb1d23176c069f260d0177593e7d39ab","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_dose_regimen"}],"evidence_review_advisories":[],"evidence_span_ids":["es_study_periods","es_visit_strategy","es_primary_endpoint","es_safety_endpoint","es_safety_assessment","es_dose_regimen"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"由医学经理依据终点采集需求和安全性评估要求，确定各访视需执行的评估项目，避免将同一项目默认分配至所有访视","category":"source_missing","gap_id":"gap_71_visit_items","missing_source_classes":["各访视评估项目清单（项目级）","访视流程图或访视计划表"],"target":"7.1节各访视具体评估项目（心电图、实验室检查、体格检查、6MWD、NT-proBNP采样等）的逐项分配"},{"action":"由医学经理确认安全性随访期（末次给药后14天）的随访形式和需采集的具体数据项","category":"source_missing","gap_id":"gap_71_followup_format","missing_source_classes":["安全性随访形式定义"],"target":"7.1节安全性随访访视的执行形式（现场访视、电话随访或远程评估）"}],"heading":"研究程序","missing_source_classes":["各访视评估项目清单（项目级）","访视流程图或访视计划表","安全性随访形式定义"],"proposal_text":"研究程序按以下时期和访视节点执行。筛选期最长14天（D-14至D-1），用于完成知情同意、入选与排除标准评估、基线NT-proBNP检测、基线6分钟步行距离测定、生命体征（含坐位和立位血压）测量、12导联心电图、实验室安全性检查、合并用药记录及随机化前资格确认。随机访视（D0）完成随机化、首次给药、生命体征和体位性低血压评估、不良事件采集及合并用药记录。双盲治疗期共12周，设W4、W8和W12访视，每次访视进行生命体征（含坐位和立位血压）测量、体位性低血压评估、不良事件采集、合并用药记录、依从性评估和试验药物发放。W12访视同时完成主要终点NT-proBNP检测（访视窗±7天）和安全性终点6分钟步行距离测定。治疗结束访视在末次给药后完成，包括生命体征、不良事件、合并用药和依从性评估。安全性随访访视在末次给药后14天进行，完成不良事件随访、合并用药记录和安全性评估。","rationale":"研究时期（筛选期最长14天、双盲治疗期12周、安全性随访期末次给药后14天）和访视节点（筛选D-14至D-1、D0、W4/W8/W12、治疗结束、安全性随访）来源于已确认研究事实。主要终点NT-proBNP（中心实验室、访视窗±7天）、安全性终点6MWD、体位性低血压与收缩压评估（D0/W4/W12）和TEAE采集均有来源支持。但各访视是否均执行心电图、实验室检查、体格检查、6MWD等具体项目，来源未逐项指定；安全性随访访视的形式（现场访视或电话随访）未明确；依从性评估方法未指定。上述内容需医学经理确认后方可定稿。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ca243367ca2a_e26bcf39d44ebfce","section_number":"7.1","source_ids":["protocol_full_draft_selection:b83cce27747225a871f08cab","current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867"]}],"source_bindings":[{"content_sha256":"ddd325909467c06bc308fce86469ae8a371066f5cdf8456441bb7a95912c4593","locator":"document:mwdoc_greenfield_proj_user_ca243367ca2a_adbd670a8e0aeb81:full-draft:b83cce27747225a871f08cab","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:b83cce27747225a871f08cab","source_type":"protocol_full_draft_selection","source_version":"full-draft:1261a5ee23d866bffcd1d6c4604fa224c93c2d3b6c431f32ae9ac3991aff2f4c:b83cce27747225a871f08cab","text_sha256":"ddd325909467c06bc308fce86469ae8a371066f5cdf8456441bb7a95912c4593"},{"content_sha256":"2683593eb7fcd2c0f43e4f78cfac287862e46f820d85674aed7d2e5ef8839932","locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","source_type":"current_project_study_definition","source_version":"mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","text_sha256":"2683593eb7fcd2c0f43e4f78cfac287862e46f820d85674aed7d2e5ef8839932"}]}