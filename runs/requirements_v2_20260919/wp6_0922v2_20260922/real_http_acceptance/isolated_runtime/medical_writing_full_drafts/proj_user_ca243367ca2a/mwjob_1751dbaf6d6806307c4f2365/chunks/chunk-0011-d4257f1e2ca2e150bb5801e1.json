e_sha256":"5089261f6fb3be2e1b473b440c3793a74de4b088e58130278b1d0d40645826ab","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es3"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"主要终点ANCOVA（基线协变量、组别固定效应）","quote_sha256":"0b5fdd019a23f194f71bfd4960f30b3a1aebdfd23ea5f7f6dd7b6ffe1d8f5000","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es4"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"研究时期：筛选期（最长14天）；双盲治疗期（12周）；安全性随访期（末次给药后14天）","quote_sha256":"07ee676da9169ff7bd8873a4eb194a9fea3f97590a5af13071efd2a7848b5a32","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es7"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"访视策略：筛选（D-14至D-1）、随机（D0）、W4/W8/W12访视、治疗结束与安全性随访","quote_sha256":"a53b5791ef0f5c3ccd63f1e987c1b5fca5ded6592d101be5ebe5ecd24ec86f6e","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es8"}],"evidence_review_advisories":[],"evidence_span_ids":["es1","es2","es3","es4","es7","es8"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"确认6分钟步行距离的标准化采集条件（步行路线、服药后时间窗、重复次数）","category":"source_missing","gap_id":"gap_72_1","missing_source_classes":["操作手册","中心实验室检测规程"],"target":"7.2 有效性评估 - 6分钟步行距离采集操作规范"},{"action":"确认NT-proBNP采血相对于给药的时间要求及样本处理流程","category":"source_missing","gap_id":"gap_72_2","missing_source_classes":["中心实验室检测规程","药代动力学方案"],"target":"7.2 有效性评估 - NT-proBNP采血时间窗"}],"heading":"有效性评估","missing_source_classes":["操作手册","中心实验室检测规程"],"proposal_text":"本研究的主要有效性终点为第12周N末端B型利钠肽前体（NT-proBNP）较基线的百分比变化，由中心实验室统一检测，访视窗为计划访视日±7天。主要估计目标为随机化人群中第12周NT-proBNP较基线百分比变化；对于因死亡或心力衰竭住院而提前退出的受试者，其数据按治疗策略处理。主要终点的统计分析采用协方差分析（ANCOVA），以基线NT-proBNP为协变量、治疗组别为固定效应。次要有效性终点为第12周6分钟步行距离较基线的变化。有效性数据的采集贯穿双盲治疗期（12周）及安全性随访期（末次给药后14天），访视安排包括随机化当日（D0）、第4周（W4）、第8周（W8）、第12周（W12）以及治疗结束与安全性随访访视。","rationale":"主要终点、估计目标策略、ANCOVA分析方法、6分钟步行距离终点及访视时间框架均来源于当前项目已确认研究事实。6分钟步行距离的采集操作条件（步行路线标准化、服药后时间窗）及NT-proBNP采血相对于给药的时间要求需医学经理进一步确认。","review_advisories":["本节提及高影响设计信息（主要终点、估计目标）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ca243367ca2a_3b1eb0d4a722d57d","section_number":"7.2","source_ids":["protocol_full_draft_selection:d4257f1e2ca2e150bb5801e1","current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867"]},{"ai_run_id":"airun_20261001052853_3520d874","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"特别关注的不良事件：TEAE发生率与严重程度（MedDRA 27.0）；第0、4、12周体位性低血压与收缩压变化","quote_sha256":"f308c4e2dc4f61c3f077cae43d91833eb183f9081fb2e6e4e527401832a77780","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es5"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"安全性描述统计","quote_sha256":"078fd842b83bff5026239172b6103d773f8bc02f52f7fd7a798649aef53b54b2","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es6"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"研究时期：筛选期（最长14天）；双盲治疗期（12周）；安全性随访期（末次给药后14天）","quote_sha256":"07ee676da9169ff7bd8873a4eb194a9fea3f97590a5af13071efd2a7848b5a32","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es7"}],"evidence_review_advisories":[],"evidence_span_ids":["es5","es6","es7"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"补充各访视安全性评估项目（实验室检查、心电图、体格检查等）的完整清单与实施频率","category":"source_missing","gap_id":"gap_73_1","missing_source_classes":["项目安全性评估规程","访视操作手册"],"target":"7.3 安全性评估 - 完整安全性评估项目清单"},{"action":"确认TEAE严重程度分级标准（CTCAE版本）、SAE定义、报告对象与时限","category":"source_missing","gap_id":"gap_73_2","missing_source_classes":["不良事件报告SOP","安全性管理计划"],"target":"7.3 安全性评估 - 不良事件严重程度分级与SAE报告"},{"action":"确认安全性分析集（SS）的纳入标准与排除规则","category":"source_missing","gap_id":"gap_73_3","missing_source_classes":["统计分析计划","安全性分析集定义细则"],"target":"7.3 安全性评估 - 安全性分析集定义"}],"heading":"安全性评估","missing_source_classes":["项目安全性评估规程","不良事件报告SOP","安全性分析集定义细则"],"proposal_text":"本研究的安全性评估覆盖双盲治疗期（12周）及安全性随访期（末次给药后14天）。安全性数据的收集与分析采用描述统计方法。特别关注的不良事件包括：治疗期间不良事件（TEAE）的发生率与严重程度，不良事件编码采用MedDRA 27.0版本；以及第0周、第4周和第12周体位性低血压与收缩压的变化。安全性随访期自末次给药后持续14天，期间继续收集不良事件及安全性相关数据。","rationale":"安全性评估的时间框架、TEAE定义（MedDRA 27.0）、体位性低血压与收缩压监测时点及描述统计方法来源于当前项目已确认研究事实。但安全性评估的完整项目清单（如实验室检查、心电图、体格检查的具体采集时点与频率）、不良事件严重程度分级标准（CTCAE版本）、SAE报告时限与流程、以及安全性分析集（SS）的具体定义细节在允许来源中未完整给出，需补充项目安全性评估规程。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ca243367ca2a_d14d661e5c4a62be","section_number":"7.3","source_ids":["protocol_full_draft_selection:d4257f1e2ca2e150bb5801e1","current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867"]},{"ai_run_id":"airun_20261001052853_3520d874","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"特别关注的不良事件：TEAE发生率与严重程度（MedDRA 27.0）；第0、4、12周体位性低血压与收缩压变化","quote_sha256":"f308c4e2dc4f61c3f077cae43d91833eb183f9081fb2e6e4e527401832a77780","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es5"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"第0、4、12周体位性低血压与收缩压变化","quote_sha256":"5312658480ef3b9e123bbd4f27138facf7cf174baed0ea46f85a980712f17a55","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es10"}],"evidence_review_advisories":[],"evidence_span_ids":["es5","es10"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"确认生命体征完整项目清单（体温、呼吸频率、心率、血压）及各访视实施频率；确认血压测量体位（坐位/立位）与测量次数","category":"source_missing","gap_id":"gap_731_1","missing_source_classes":["项目安全性评估规程","访视操作手册"],"target":"7.3.1 生命体征和体格检查 - 完整采集项目与频率"},{"action":"确认体格检查具体范围、实施时点、异常判定标准及临床意义评估流程","category":"source_missing","gap_id":"gap_731_2","missing_source_classes":["项目安全性评估规程","体格检查标准操作规程"],"target":"7.3.1 生命体征和体格检查 - 体格检查范围与异常判定"}],"heading":"生命体征和体格检查","missing_source_classes":["项目安全性评估规程","访视操作手册","体格检查标准操作规程"],"proposal_text":"本研究在安全性评估中纳入生命体征监测，重点关注体位性低血压与收缩压变化。根据已确认的研究设计，体位性低血压与收缩压的评估时点为第0周、第4周和第12周。血压测量应包含坐位与立位血压，以识别体位性低血压事件。体格检查作为安全性评估的组成部分，其具体采集项目、实施频率及异常判定标准需依据项目安全性评估规程确定。","rationale":"允许来源明确列出第0、4、12周体位性低血压与收缩压变化为特别关注不良事件，据此可确认这些时间点存在血压测量需求。但完整生命体征项目（体温、呼吸频率、心率、血压测量体位与次数）、体格检查范围（一般状况、心肺听诊、腹部触诊等）、各访视是否均实施完整体格检查、以及异常判定与处理流程在允许来源中未明确列出，不能由访视日推断所有项目在每个访视均实施。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ca243367ca2a_5fd6630783c07fc7","section_number":"7.3.1","source_ids":["protocol_full_draft_selection:d4257f1e2ca2e150bb5801e1","current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867"]},{"ai_run_id":"airun_20261001052853_3520d874","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"补充心电图采集时点、导联配置、判读标准、临床意义阈值及异常处理流程","category":"source_missing","gap_id":"gap_732_1","missing_source_classes":["项目安全性评估规程","访视操作手册"],"target":"7.3.2 心电图检查 - 完整采集方案"},{"action":"补充SGC-R23非临床及既往临床心血管安全性数据，以支持心电图监测的必要性论证","category":"source_missing","gap_id":"gap_732_2","missing_source_classes":["研究者手册（IB）","药物非临床安全性数据","既往临床安全性数据"],"target":"7.3.2 心电图检查 - 药物心血管安全性依据"}],"heading":"心电图检查","missing_source_classes":["项目安全性评估规程","研究者手册（IB）","药物非临床安全性数据","既往临床安全性数据"],"proposal_text":"","rationale":"允许来源中未包含任何关于心电图检查的描述，包括采集时点、导联配置（如12导联）、判读标准、临床意义阈值（如QTc延长标准）、是否需要中心判读或现场判读、以及异常处理流程。sGC激动剂类药物理论上存在血管扩张相关的心血管安全性关注，但具体心电图监测方案需依据项目安全性评估规程及药物非临床/临床安全性数据确定，当前无直接证据支持任何具体心电图实施规则。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ca243367ca2a_836c02bb9de69b41","section_number":"7.3.2","source_ids":["protocol_full_draft_selection:d4257f1e2ca2e150bb5801e1","current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867"]}],"source_bindings":[{"content_sha256":"23e1a2d9fa303fb55b304828285eafe141b60f5c013644be5a3fe5e18762baba","locator":"document:mwdoc_greenfield_proj_user_ca243367ca2a_adbd670a8e0aeb81:full-draft:d4257f1e2ca2e150bb5801e1","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:d4257f1e2ca2e150bb5801e1","source_type":"protocol_full_draft_selection","source_version":"full-draft:1261a5ee23d866bffcd1d6c4604fa224c93c2d3b6c431f32ae9ac3991aff2f4c:d4257f1e2ca2e150bb5801e1","text_sha256":"23e1a2d9fa303fb55b304828285eafe141b60f5c013644be5a3fe5e18762baba"},{"content_sha256":"2683593eb7fcd2c0f43e4f78cfac287862e46f820d85674aed7d2e5ef8839932","locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","source_type":"current_project_study_definition","source_version":"mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","text_sha256":"2683593eb7fcd2c0f43e4f78cfac287862e46f820d85674aed7d2e5ef8839932"}]}