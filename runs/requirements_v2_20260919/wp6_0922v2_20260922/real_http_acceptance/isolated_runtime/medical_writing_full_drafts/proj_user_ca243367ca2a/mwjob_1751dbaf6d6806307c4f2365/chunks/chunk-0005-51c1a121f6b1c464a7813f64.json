b5791ef0f5c3ccd63f1e987c1b5fca5ded6592d101be5ebe5ecd24ec86f6e","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_duration_visits"}],"evidence_review_advisories":[],"evidence_span_ids":["es_duration_periods","es_duration_visits"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"需项目访视计划或数据采集表明确各访视评估内容","category":"source_missing","gap_id":"gap_visit_assessments","missing_source_classes":["访视评估项目清单"],"target":"各访视具体评估项目"},{"action":"需项目安全性管理计划或方案正文明确提前终止后随访要求","category":"source_missing","gap_id":"gap_early_termination","missing_source_classes":["提前终止随访安排"],"target":"研究提前终止时的随访安排"}],"heading":"研究结束与研究持续时间","missing_source_classes":["各访视评估项目清单","研究提前终止随访安排","研究结束定义"],"proposal_text":"本研究由三个连续阶段组成。筛选期最长14天（D-14至D-1），用于完成入排标准评估及基线数据采集。双盲治疗期持续12周，包含随机访视（D0）及第4周（W4）、第8周（W8）、第12周（W12）计划访视。安全性随访期为末次给药后14天。研究总持续时间最长约112天。","rationale":"已确认事实支持：三阶段时长（筛选最长14天、治疗12周、随访14天）及访视策略（D-14至D-1、D0、W4/W8/W12、治疗结束与安全性随访）。待医学作者确认：各访视具体评估项目清单、研究提前终止时的随访安排、研究结束定义（最后受试者末次访视或数据库锁定）。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ca243367ca2a_bd625ce323d8ad6d","section_number":"4.5","source_ids":["protocol_full_draft_selection:51c1a121f6b1c464a7813f64","current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867"]},{"ai_run_id":"airun_20261001050930_fd9198fe","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"需项目安全性管理计划、独立数据监查委员会章程或方案安全性章节提供暂停与终止的具体触发条件、阈值及决策流程","category":"source_missing","gap_id":"gap_suspension_criteria","missing_source_classes":["研究暂停触发条件与阈值","研究终止标准与决策层级","暂停后恢复条件","提前终止后受试者随访管理"],"target":"研究暂停和终止标准全文"}],"heading":"研究暂停和终止标准","missing_source_classes":["研究暂停触发条件与阈值","研究终止标准与决策层级","暂停后恢复条件","提前终止后受试者随访管理"],"proposal_text":"","rationale":"本章节当前为空，允许来源中未提供研究暂停触发条件、终止阈值、决策层级、暂停后恢复条件或提前终止后受试者管理规则等项目文件。不得以通用原则或条件句替代项目特定标准。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ca243367ca2a_f8a7d2585a18dacf","section_number":"4.6","source_ids":["protocol_full_draft_selection:51c1a121f6b1c464a7813f64","current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867"]},{"ai_run_id":"airun_20261001050930_fd9198fe","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"入选标准模块：年龄18-75周岁；慢性心力衰竭伴LVEF≤40%、NYHA II-III级；筛选前稳定剂量GDMT至少4周","quote_sha256":"ed817a4709749259b60d2fb2c8fc840f323dd29db98f95c352f1d56826ac2c8d","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_pop_inclusion"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"排除标准模块：筛选前6个月内急性心肌梗死、不稳定型心衰或卒中；收缩压<90mmHg；eGFR<30mL/min/1.73m²；妊娠或哺乳期；30天内使用过其他sGC激动剂或PDE5抑制剂","quote_sha256":"00eedca3c214010b6188381ed829bba469eed145f0d64272cdc2c8a954db024e","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_pop_exclusion"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"研究人群概述：年龄18-75岁、LVEF≤40%、NYHA II-III级、在GDMT基础上仍有症状的慢性HFrEF成人受试者","quote_sha256":"df9c7936dd69ef4c5f0247f18fa0d36e82e905494d2d4afcadbcd1b51bac2bcb","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_pop_overview"}],"evidence_review_advisories":[],"evidence_span_ids":["es_pop_inclusion","es_pop_exclusion","es_pop_overview"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"需项目安全性管理计划或方案安全性章节明确避孕要求、妊娠检查时点及哺乳期处理","category":"source_missing","gap_id":"gap_contraception","missing_source_classes":["避孕方法与妊娠检查日程","哺乳期随访要求"],"target":"排除标准中妊娠或哺乳期对应的避孕方法、妊娠检查日程及哺乳期随访"},{"action":"需项目方案或合并用药管理文件明确GDMT允许药物及禁限合并用药","category":"source_missing","gap_id":"gap_gdmt_list","missing_source_classes":["GDMT允许药物清单","合并用药禁限清单"],"target":"GDMT允许药物清单及合并用药禁限"}],"heading":"研究人群","missing_source_classes":["避孕方法与妊娠检查日程","GDMT允许药物清单","合并用药禁限清单","哺乳期随访要求"],"proposal_text":"本研究目标人群为在标准心衰治疗（GDMT）基础上仍残留症状的成人慢性心力衰竭（射血分数降低，HFrEF）患者。入选标准：年龄18至75周岁；慢性心力衰竭伴左室射血分数（LVEF）≤40%、纽约心脏协会（NYHA）心功能II至III级；筛选前稳定剂量GDMT至少4周。排除标准：筛选前6个月内发生急性心肌梗死、不稳定型心衰或卒中；收缩压低于90mmHg；估算肾小球滤过率（eGFR）低于30mL/min/1.73m²；妊娠或哺乳期；30天内使用过其他sGC激动剂或PDE5抑制剂。","rationale":"已确认事实支持：研究人群概述、入选标准模块（年龄、LVEF、NYHA分级、GDMT稳定期）及排除标准模块（心血管事件、血压、肾功能、妊娠哺乳、合并用药）。待医学作者确认：排除标准中'妊娠或哺乳期'对应的避孕方法、妊娠检查日程及哺乳期随访要求；GDMT具体允许药物清单及剂量调整规则；合并用药禁限清单。","review_advisories":["本节复述高影响研究设计（研究人群）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ca243367ca2a_0011b7ff64c8b408","section_number":"5","source_ids":["protocol_full_draft_selection:51c1a121f6b1c464a7813f64","current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867"]}],"source_bindings":[{"content_sha256":"b9b278f1f205c7fd098ff2077204e38b820f5aeab475533f271381fbca2ed259","locator":"document:mwdoc_greenfield_proj_user_ca243367ca2a_adbd670a8e0aeb81:full-draft:51c1a121f6b1c464a7813f64","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:51c1a121f6b1c464a7813f64","source_type":"protocol_full_draft_selection","source_version":"full-draft:1261a5ee23d866bffcd1d6c4604fa224c93c2d3b6c431f32ae9ac3991aff2f4c:51c1a121f6b1c464a7813f64","text_sha256":"b9b278f1f205c7fd098ff2077204e38b820f5aeab475533f271381fbca2ed259"},{"content_sha256":"2683593eb7fcd2c0f43e4f78cfac287862e46f820d85674aed7d2e5ef8839932","locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","source_type":"current_project_study_definition"