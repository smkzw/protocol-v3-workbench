nition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_study_def_visit"}],"evidence_review_advisories":[],"evidence_span_ids":["es_study_def_dose","es_study_def_visit"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"确认依从性评估工具（药片计数、电子监测、日记卡等）及评估时点","category":"source_missing","gap_id":"gap_65_method","missing_source_classes":["项目依从性评估操作文件"],"target":"6.5节依从性评估方法与判定标准"},{"action":"确认依从性判定标准（如百分比阈值）及低于阈值时的处理流程","category":"source_missing","gap_id":"gap_65_threshold","missing_source_classes":["项目依从性判定规则"],"target":"6.5节依从性判定阈值"}],"heading":"研究治疗依从性","missing_source_classes":["依从性评估方法与工具","依从性判定阈值与低依从性处理规则","各访视依从性核查操作细则"],"proposal_text":"本研究试验药为SMOKE-r2-3口服sGC激动剂（SGC-R23）片剂，低剂量组2.5mg、高剂量组5mg，口服每日一次，连续12周；安慰剂为口服片每日一次，外观与频次一致。双盲治疗期共12周，访视安排为随机化（D0）后第4周、第8周、第12周访视，治疗结束后进入末次给药后14天的安全性随访期。受试者应在每日固定时间自行服用研究药物，并于每次访视时携带剩余药物及用药记录接受核查。依从性评估的具体方法、评估时点、依从性判定标准及低依从性处理规则需依据项目操作文件确定。","rationale":"已确认事实支持：口服每日一次、12周治疗期、双盲设计、W4/W8/W12访视及末次给药后14天安全性随访。但依从性评估方法（药片计数、电子监测、日记卡等）、具体评估时点、依从性判定阈值及低依从性后的处理措施均无项目来源支持，不得自行设定。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ca243367ca2a_55b7e9368e3862be","section_number":"6.5","source_ids":["protocol_full_draft_selection:1f61b9a402d8d675d6a5a1fc","current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867"]},{"ai_run_id":"airun_20261001052050_aedb60e9","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"在标准心衰治疗（GDMT）基础上仍残留症状的成人HFrEF患者","quote_sha256":"9ac0596907fc47fd09455eb3d7dd1d23af5f6875e82abcb25d6953964071ad79","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_study_def_conmed"},{"locator":"study_definition:mwdefinition_a9bfa9b852a491f5ff97:revision:4","quote":"30天内使用过其他sGC激动剂或PDE5抑制剂","quote_sha256":"86114cc9eaefe2f7c6b3fffeba34e99e0737d1555bbd215b1d05b1dcc2b4586d","source_id":"current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867","span_id":"es_study_def_excl"}],"evidence_review_advisories":[],"evidence_span_ids":["es_study_def_conmed","es_study_def_excl"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"确认GDMT具体药物类别与品种清单，以及研究期间背景治疗是否允许调整","category":"source_missing","gap_id":"gap_66_gdmt_list","missing_source_classes":["项目GDMT背景治疗方案"],"target":"6.6节GDMT背景治疗具体方案"},{"action":"确认合并用药记录方式、报告时限、禁限用药清单及合并用药对分析集的影响","category":"source_missing","gap_id":"gap_66_conmed_rules","missing_source_classes":["项目合并用药管理规则"],"target":"6.6节合并用药记录与报告规则"}],"heading":"合并用药/治疗","missing_source_classes":["GDMT具体药物清单与背景治疗维持规则","禁限用药完整清单","合并用药记录与报告操作规则","合并用药对疗效分析影响的统计处理规则"],"proposal_text":"本研究要求受试者在筛选前已接受稳定剂量标准心衰治疗（GDMT）至少4周，GDMT背景治疗在研究期间原则上维持不变。筛选前30天内使用过其他sGC激动剂或PDE5抑制剂的受试者不得入组。研究期间合并用药与合并治疗的具体记录、报告及与疗效分析的关系需依据项目操作文件确定。","rationale":"已确认事实支持：GDMT背景治疗要求（稳定剂量≥4周）、排除30天内使用其他sGC激动剂或PDE5抑制剂。但GDMT具体药物清单、研究期间GDMT是否允许调整、禁限用药完整清单、合并用药记录与报告规则、合并用药对主要终点分析的影响及处理策略均无项目来源支持，不得自行列举或设定。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ca243367ca2a_555e65f7f744cb00","section_number":"6.6","source_ids":["protocol_full_draft_selection:1f61b9a402d8d675d6a5a1fc","current_project_study_definition:mwdefinition_a9bfa9b852a491f5ff97:r4:8c8b649c2614d867"]}],"source_bindings":[{"content_sha256":"a38524178ad0bc65df2fab23372397f6e931106d5a38ead3966b694d6dc4b438","locator":"document:mwdoc_greenfield_proj_user_ca243367ca2a_adbd670a8e0aeb81:full-draft:1f61b9a402d8d675d6a5a1fc","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:1f61b9a402d8d675d6a5a1fc","source_type":"protocol_full_draft_selection","source_version":"full-draft:1261a5ee23d866bffcd1d6c4604fa224c93c2d3b6c431f32ae9ac3991aff2f4c:1f61b9a402d8d675d6a5a1fc","text_sha256":"a38524178ad0bc65df2fab