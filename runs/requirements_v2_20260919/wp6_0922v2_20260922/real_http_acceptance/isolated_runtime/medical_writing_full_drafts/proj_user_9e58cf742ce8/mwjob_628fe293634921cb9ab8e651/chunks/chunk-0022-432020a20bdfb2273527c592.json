256":"ee8cbc333c7e24e28cf3efd553196ea8833e37c010be1e6e27553c39e992a50f","source_id":"current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad","span_id":"es_visit_v4"},{"locator":"study_definition:mwdefinition_651c3c52586700892904:revision:6","quote":"安全随访期（末次给药后2周）","quote_sha256":"a237fbd5db01292d7023e8380dd693f6efe7f87c8530b840521a43ff8049f53a","source_id":"current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad","span_id":"es_study_period"},{"locator":"study_definition:mwdefinition_651c3c52586700892904:revision:6","quote":"主要终点：第12周NT-proBNP较基线的百分比变化（双盲期）。评价时间点：基线、第4/8/12周。","quote_sha256":"ed3fdeeb458362e8ec2062ccfdb54dabe86146616d3c09971d19582407bead01","source_id":"current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad","span_id":"es_ntprobnp_tp"}],"evidence_review_advisories":[],"evidence_span_ids":["es_safety_endpoint","es_visit_strategy","es_visit_v4","es_study_period","es_ntprobnp_tp"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"补充本项目实验室检查计划表，明确各访视具体检测项目（血常规、生化全套、凝血、尿常规、NT-proBNP、心电图等）及采集时点","category":"source_missing","gap_id":"gap_lab_panel","missing_source_classes":["实验室检查计划表","研究中心实验室标准操作规程"],"target":"14.2节实验室检查项目完整清单"},{"action":"确认各实验室检查项目的正常值范围及临床意义异常判定标准","category":"source_missing","gap_id":"gap_lab_normal_range","missing_source_classes":["实验室正常值参考标准"],"target":"14.2节正常值范围与临床意义判定"}],"heading":"实验室检查项目","missing_source_classes":["完整实验室检查项目清单及各访视采集时点表","研究中心实验室资质与正常值范围标准","sGC刺激剂类效应相关专项监测要求"],"proposal_text":"本研究安全性评估涵盖的实验室检查类别包括肝功能指标、肾功能指标及电解质水平，同时纳入12导联心电图作为安全性监测手段。筛选访视（第-28天至第-1天）安排实验室检查、NT-proBNP检测及心电图评估，用于确认受试者入组资格及建立基线数据。治疗结束访视（第12周±3天）执行全面安全性评价，包含上述实验室检查项目的重复检测以评估治疗期间安全性变化。安全随访期（末次给药后2周）用于确认不良事件转归，必要时可安排针对性实验室复查。NT-proBNP作为主要疗效终点生物标志物，在基线、第4周、第8周及第12周采集。各访视具体实验室检查项目清单、采集时点及正常值范围判定标准，需依据研究中心实验室资质及方案附录中的实验室检查计划表确定。","rationale":"已确认安全性终点明确列出肝肾功能、电解质实验室指标及12导联心电图；访视策略中V0包含实验室、NT-proBNP、ECG，V4包含全面安全性；主要终点NT-proBNP评价时间点为基线及第4/8/12周；安全随访期为末次给药后2周。但完整实验室检查项目清单（如血常规、凝血、尿常规等）及各访视逐项采集安排未在已确认事实中给出，需依据研究中心实验室条件和药物安全性特征补充完整。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9e58cf742ce8_be88a22689fd6757","section_number":"14.2","source_ids":["protocol_full_draft_selection:432020a20bdfb2273527c592","current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1d8a6d3b64541","company_corpus:cms_cn_protocol_corpus_20260715_v1:76a6125fa7dca4","company_corpus:cms_cn_protocol_corpus_20260715_v1:eed6fd877d0a24","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb5ffffeb64ac7","company_corpus:cms_cn_protocol_corpus_20260715_v1:20ca67d1098144"]},{"ai_run_id":"airun_20261006043842_0f2f1660","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取本项目安全信息报告途径的完整规定，包括AE/SAE/SUSAR定义、报告时限、报告对象、报告途径及职责分工","category":"source_missing","gap_id":"gap_safety_report_pathway","missing_source_classes":["项目安全报告SOP","ICH GCP及中国GCP安全报告条款的项目适配版本","申办者药物警戒体系文件"],"target":"14.3节安全信息报告途径"},{"action":"确认本项目SAE定义是否包含特定实验室异常阈值（如肝酶升高倍数）及对应报告时限","category":"source_missing","gap_id":"gap_sae_definition","missing_source_classes":["项目SAE定义文件","sGC刺激剂类效应安全监测要求"],"target":"14.3节SAE定义与报告标准"}],"heading":"安全信息报告途径","missing_source_classes":["本项目AE/SAE/SUSAR定义与分类标准","安全事件报告时限与途径规定","研究者与申办者安全报告职责分工","SUSAR快速报告流程"],"proposal_text":"","rationale":"本章节需要本项目专属的安全信息报告途径规定，包括AE/SAE/SUSAR定义、报告时限、报告对象与途径、研究者与申办者职责分工。允许来源中仅有跨适应症公司语料（CMD-D001-AD为AD适应症、CMS-D017为I期）提供结构参照，不得迁移其具体参数。已确认研究事实仅列出安全性终点类别，未涉及报告流程。","review_advisories":["本节复述高影响研究设计（安全信息报告途径）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9e58cf742ce8_c6271dae2cad55ce","section_number":"14.3","source_ids":["protocol_full_draft_s