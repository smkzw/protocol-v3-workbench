ote":"安慰剂平行对照：外观与气味与试验药一致的模拟片，每日一次，给药与访视安排同试验组，联合相同GDMT背景，按1:1:1:1随机分配。","quote_sha256":"be1f2f8d5224812fb65406cf191b819e4bb7668a1995791a1358f3ee011d1fcc","source_id":"current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad","span_id":"es_placebo_blinding"},{"locator":"study_definition:mwdefinition_651c3c52586700892904:revision:6","quote":"药物技术类型：small_molecule","quote_sha256":"d8ca21a7e62cbca0e65228c7147e2ce5e59273b60f0d0cc55ed216f48e27710c","source_id":"current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad","span_id":"es_tech_type"},{"locator":"study_definition:mwdefinition_651c3c52586700892904:revision:6","quote":"给药途径：口服","quote_sha256":"404b058b755608a73d13b54521a28c02b129df449774d0671b1c3f8b8a5ce42c","source_id":"current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad","span_id":"es_formulation"},{"locator":"study_definition:mwdefinition_651c3c52586700892904:revision:6","quote":"双盲双模拟","quote_sha256":"eb41022c717df4059a53b4e284c6e14617c38eebfe50cabbac163da3d4e2fa9e","source_id":"current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad","span_id":"es_blinding_method"}],"evidence_review_advisories":[],"evidence_span_ids":["es_drug_identity","es_dose_regimen","es_placebo_blinding","es_tech_type","es_formulation","es_blinding_method"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"补充KZ-sGC501研究者手册或药物档案，提取化学结构、作用机制、非临床毒理学及既往临床数据","category":"source_missing","gap_id":"gap_611_01","missing_source_classes":["研究者手册（IB）","非临床安全性研究报告"],"target":"研究药物信息章节中药物化学名、CAS号、作用机制及非临床安全性数据段落"},{"action":"由医学经理与制剂团队确认双模拟片数匹配方案后写入","category":"source_missing","gap_id":"gap_611_02","missing_source_classes":["制剂与给药方案确认文件"],"target":"双盲双模拟具体实施方式（各剂量组片数与安慰剂匹配方案）"}],"heading":"研究药物信息","missing_source_classes":["研究者手册（IB）","药物化学与药学资料","非临床安全性研究报告","既往人体研究数据"],"proposal_text":"本研究的试验药物为SMOKE-r5-1W口服sGC刺激剂（代号KZ-sGC501），属小分子化合物，以口服固体制剂形式给药，产生全身性系统暴露。试验药设低、中、高三个剂量水平，分别为2.5 mg、5 mg和10 mg，每日一次，晨起随餐口服。安慰剂为外观与气味与试验药一致的模拟片，每日一次给药，给药与访视安排同试验组，联合相同标准GDMT背景治疗。本研究采用双盲双模拟设计，试验药与安慰剂按1:1:1:1比例随机分配至低剂量组、中剂量组、高剂量组和安慰剂组。治疗期为12周，所有受试者在研究期间联合标准GDMT背景治疗。每4周随访时评估耐受性，剂量调整依据方案规定执行。","rationale":"试验药物名称、技术类型、剂型、给药途径、三个剂量水平、给药频率与时间、安慰剂描述、双盲双模拟及1:1:1:1分配比例均来自当前项目已确认研究事实。KZ-sGC501的化学名、CAS号、作用机制、非临床毒理学数据及既往人体研究信息未在允许来源中提供，需补充研究者手册或药物档案后方可完善。双盲双模拟的具体片数匹配方案需医学经理确认。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9e58cf742ce8_381729906f9f43ff","section_number":"6.1.1","source_ids":["protocol_full_draft_selection:6f919eafc519c2775891368d","current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad"]},{"ai_run_id":"airun_20261006035904_9221cd59","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取KZ-sGC501及安慰剂的制备工艺文件、包装规格、标签模板、储存条件（含温度与湿度范围）、有效期及运输条件说明","category":"source_missing","gap_id":"gap_612_01","missing_source_classes":["药物制备与包装工艺文件","药品标签与包装规范","储存与运输条件说明"],"target":"制备、包装、标签、储存与管理全章节"},{"action":"获取申办方药物管理SOP或等效文件","category":"source_missing","gap_id":"gap_612_02","missing_source_classes":["药物管理SOP"],"target":"药物管理规程（含接收、储存、分发、回收、销毁及药物accountability记录）"}],"heading":"制备、包装、标签、储存与管理","missing_source_classes":["药物制备与包装工艺文件","药品标签与包装规范","储存与运输条件说明","药物管理SOP"],"proposal_text":"","rationale":"允许来源中未包含KZ-sGC501及安慰剂的制备工艺、包装形式、标签内容、储存条件（温度、湿度、光照）、有效期、运输要求或药物管理规程的任何信息。当前项目已确认研究事实仅描述剂型为口服固体制剂及安慰剂外观与气味一致，不足以支撑本章节实质正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9e58cf742ce8_0025718642dfe075","section_number":"6.1.2","source_ids":["protocol_full_draft_selection:6f919eafc519c2775891368d","current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad"]},{"ai_run_id":"airun_20261006035904_9221cd59","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取申办方或中心药房的药物发放流程、回收程序、清点方法、未使用药物处置及accountability记录规范","category":"source_missing","gap_id":"gap_613_01","missing_source_classes":["药物发放与回收SOP","药物清点与accountability记录模板","中心药房管理规程"],"target":"发放、回收与清点全章节"}],"heading":"发放、回收与清点","missing_source_classes":["药物发放与回收SOP","药物清点与accountability记录模板","中心药房管理规程"],"proposal_text":"","rationale":"允许来源中未包含试验药与安慰剂的发放流程、回收程序、清点方法、未使用药物处置方式或药物accountability记录格式的任何信息。当前项目已确认研究事实中无药物发放与回收相关描述，无法形成有实质内容的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9e58cf742ce8_c27f1b4bd10434f3","section_number":"6.1.3","source_ids":["protocol_full_draft_selection:6f919eafc519c2775891368d","current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad"]},{"ai_run_id":"airun_20261006035904_9221cd59","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取预设的剂量调整触发阈值（如坐位SBP、eGFR、肝酶异常标准）及对应调整幅度（减量、暂停或停药）","category":"source_missing","gap_id":"gap_63_01","missing_source_classes":["剂量调整与停药规则文件","安全性管理计划"],"target":"剂量调整触发条件与调整幅度"},{"action":"获取暂停给药后恢复给药的评估标准与时间窗","category":"source_missing","gap_id":"gap_63_02","missing_source_classes":["剂量调整与停药规则文件"],"target":"剂量暂停与恢复条件"},{"action":"获取永久停药的预设触发事件及停药后随访安排","category":"source_missing","gap_id":"gap_63_03","missing_source_classes":["剂量调整与停药规则文件","安全性管理计划"],"target":"永久停药标准"},{"action":"确认剂量调整后是否需额外访视或实验室检查","category":"source_missing","gap_id":"gap_63_04","missing_source_classes":["访视与安全性监测方案"],"target":"剂量调整后随访与安全性监测安排"}],"heading":"剂量调整、暂停、恢复与永久停药","missing_source_classes":["剂量调整与停药规则文件","安全性管理计划","研究者手册中剂量相关安全性数据","预设剂量调整触发阈值与处置流程"],"proposal_text":"","rationale":"当前项目已确认研究事实中关于剂量调整的表述仅为每4周随访评估耐受性，按方案规定剂量调整，未给出任何具体触发条件（如血压阈值、肝肾功能异常标准、症状性低血压判定标准）、调整幅度（如减量至下一剂量水平或暂停给药）、恢复条件、永久停药标准或剂量调整后的随访安排。安全性终点中虽列出症状性低血压与体位性低血压，但未将其与剂量调整或停药规则建立明确关联。在缺少对应项目文件的情况下，不得以条件句或通用原则替代具体规则。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9e58cf742ce8_b87471bc1843763c","section_number":"6.3","source_ids":["protocol_full_draft_selection:6f919eafc519c2775891368d","current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad"]}],"source_bindings":[{"content_sha256":"4091b6be78c8c42a225561a073e8f69c8aa861f3c049a81c8b408f6af730a80d","locator":"document:mwdoc_greenfield_proj_user_9e58cf742ce8_83e9420f4f9f88b3:full-draft:6f919eafc519c2775891368d","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:6f919eafc519c2775891368d","source_type":"protocol_full_draft_selection","source_version":"full-draft:9f14082f8ca9ba3e77613e4c62ca77cff3c65d122f60d56d8ea6c8a1ffab8aa1:6f919eafc519c2775891368d","text_sha256":"4091b6be78c8c42a225561a073e8f69c8aa861f3c049a81c8b408f6af730a80d"},{"content_sha256":"d637529e44577d7b1429b2af86b4b1a8f52590a8b92f2e1d83a773ee335fc31d","locator":"study_definition:mwdefinition_651c3c52586700892904:revision:6","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad","source_type":"current_project_study_definition","source_version":"mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad","text_sha256":"d637529e44577d7b1429b2af86b4b1a8f52590a8b92f2e1d83a773ee335fc31d"}]}