.2","source_ids":["protocol_full_draft_selection:cab05cd9fefe597ae3e6461e","current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261006034312_3b4ffef5","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_651c3c52586700892904:revision:6","quote":"总体研究设计：随机、双盲、安慰剂对照、平行组、多中心；II期概念验证+剂量探索，KZ-sGC501三个剂量组与安慰剂对照，治疗12周","quote_sha256":"4268ccf092c0fc0128b80142bfe6658b2700494e8122d4e5d9bac2d766363b93","source_id":"current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad","span_id":"es_002"},{"locator":"study_definition:mwdefinition_651c3c52586700892904:revision:6","quote":"内在研究目的：概念验证（PoC）；剂量探索","quote_sha256":"2d096e242bbd65d0c9236718d79e77a388e84cb9640b99bd47662a6ce8faab31","source_id":"current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad","span_id":"es_003"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"补充sGC-cGMP通路在HFrEF中的病理生理作用及KZ-sGC501非临床药理学数据","category":"source_missing","gap_id":"gap_24_01","missing_source_classes":["非临床药理学摘要","机制文献"],"target":"2.4 本研究的理论基础——机制论证段落"},{"action":"检索sGC刺激剂类在HFrEF中的既往临床研究数据","category":"source_missing","gap_id":"gap_24_02","missing_source_classes":["同类药物临床文献","研究者手册"],"target":"2.4 本研究的理论基础——同类药物证据段落"}],"heading":"本研究的理论基础","missing_source_classes":["sGC-cGMP通路在HFrEF中的病理生理机制文献","KZ-sGC501非临床药理学与毒理学数据","同类sGC刺激剂在心力衰竭中的既往临床证据","HFrEF流行病学与当前治疗现状"],"proposal_text":"本研究为II期概念验证与剂量探索研究，旨在评估SMOKE-r5-1W口服sGC刺激剂（KZ-sGC501）在慢性稳定性射血分数降低的心力衰竭（HFrEF）成人患者中的初步疗效信号与剂量-反应关系。研究采用随机、双盲、安慰剂对照、平行组、多中心设计，设置KZ-sGC501低剂量（2.5 mg每日一次）、中剂量（5 mg每日一次）和高剂量（10 mg每日一次）三个试验组及安慰剂组，按1:1:1:1比例随机分配，治疗期12周，所有受试者均联合标准指南导向的药物治疗（GDMT）背景。该设计基于以下考量：第一，KZ-sGC501为口服小分子sGC刺激剂，通过激活可溶性鸟苷酸环化酶促进环磷酸鸟苷生成，理论上可改善HFrEF患者血管舒张与心肌重构，但其在HFrEF人群中的最佳剂量范围尚未确立，需通过多剂量水平平行对照获取初步疗效与耐受性数据；第二，以第12周NT-proBNP较基线百分比变化作为主要疗效终点，可在12周治疗期内捕捉血流动力学与神经内分泌改善信号，为后续确证性研究的剂量选择和终点设定提供依据；第三，每4周随访评估耐受性并允许按方案规定进行剂量调整，兼顾安全性监测与剂量探索的灵活性。本章节的理论基础尚需补充sGC-cGMP通路在HFrEF病理生理中的作用机制、KZ-sGC501非临床药理学与毒理学数据、以及同类sGC刺激剂在心力衰竭中的既往临床证据，以完整论证本研究的科学依据。","rationale":"已确认事实支持：研究分期为II期、内在目的为概念验证与剂量探索、三剂量水平（2.5/5/10 mg qd）与安慰剂1:1:1:1随机、12周治疗期、NT-proBNP主要终点、GDMT背景治疗、每4周耐受性评估与剂量调整。缺少sGC-cGMP通路机制文献、非临床数据及同类药物既往临床证据，上述内容以'尚需补充'形式标注，未作为已确认事实写入。","review_advisories":["本节提及高影响设计信息（剂量选择）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9e58cf742ce8_3a039dbf4e7bf030","section_number":"2.4","source_ids":["protocol_full_draft_selection:cab05cd9fefe597ae3e6461e","current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261006034312_3b4ffef5","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_651c3c52586700892904:revision:6","quote":"主要终点：主要终点：第12周NT-proBNP较基线的百分比变化（双盲期）。评价时间点：基线、第4/8/12周。","quote_sha256":"161db75499e2f57b4c26d1e22eabe8a3ca40273b7dc79a8bf7277c712e931de9","source_id":"current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad","span_id":"es_004"},{"locator":"study_definition:mwdefinition_651c3c52586700892904:revision:6","quote":"安全性终点：不良事件与严重不良事件发生率；症状性低血压与体位性低血压；生命体征（血压、心率）；肝肾功能、电解质实验室指标；12导联心电图","quote_sha256":"e77501ca084e2f1e9fa18684d494f2252570a19a158da14e097274f13b01fb6b","source_id":"current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad","span_id":"es_005"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004","es_005"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"由医学团队确定次要疗效终点（如NYHA分级变化、6分钟步行距离、NT-proBNP绝对变化等）及探索性终点","category":"source_missing","gap_id":"gap_3_01","missing_source_classes":["研究方案设计文件","医学团队确认记录"],"target":"3 研究目的和终点——次要终点"},{"action":"确认本研究是否设置探索性目的与终点；若不设置则明确声明","category":"source_missing","gap_id":"gap_3_02","missing_source_classes":["研究方案设计文件"],"target":"3 研究目的和终点——探索性目的与终点"}],"heading":"研究目的和终点","missing_source_classes":["次要终点定义","探索性目的与终点定义","次要终点分析层级顺序细则"],"proposal_text":"本研究的主要目的为评估KZ-sGC501在慢性稳定性HFrEF成人患者中较安慰剂的初步疗效信号，主要终点为第12周NT-proBNP较基线的百分比变化（双盲期），评价时间点为基线、第4周、第8周和第12周。安全性目的为评估KZ-sGC501三个剂量水平在12周治疗期及末次给药后2周安全随访期内的安全性与耐受性，安全性终点包括不良事件与严重不良事件发生率、症状性低血压与体位性低血压、生命体征（血压、心率）、肝肾功能与电解质实验室指标以及12导联心电图。本研究为II期概念验证与剂量探索设计，主要分析集为全分析集（FAS），主要终点采用以基线NT-proBNP为协变量的协方差分析并检验剂量-反应趋势，安全性数据采用描述性统计。次要终点、探索性目的与终点的具体内容尚未确定，需由医学团队根据概念验证与剂量探索的研究目的进一步界定。","rationale":"已确认事实支持：主要终点（第12周NT-proBNP百分比变化）、评价时间点（基线/4/8/12周）、安全性终点清单、FAS分析集、ANCOVA与剂量-反应趋势检验、12周治疗期加2周安全随访。次要终点和探索性目的/终点在允许来源中未给出具体定义，按规则不得臆造，已标注为待医学团队界定。","review_advisories":["本节复述高影响研究设计（研究目的和终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9e58cf742ce8_e980c952a481426b","section_number":"3","source_ids":["protocol_full_draft_selection:cab05cd9fefe597ae3e6461e","current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261006034312_3b4ffef5","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_651c3c52586700892904:revision:6","quote":"主要终点：主要终点：第12周NT-proBNP较基线的百分比变化（双盲期）。评价时间点：基线、第4/8/12周。","quote_sha256":"161db75499e2f57b4c26d1e22eabe8a3ca40273b7dc79a8bf7277c712e931de9","source_id":"current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad","span_id":"es_004"},{"locator":"document:mwdoc_greenfield_proj_user_9e58cf742ce8_83e9420f4f9f88b3:full-draft:cab05cd9fefe597ae3e6461e","quote":"主要终点：第12周NT-proBNP较基线的百分比变化（双盲期）。评价时间点：基线、第4/8/12周。","quote_sha256":"ed3fdeeb458362e8ec2062ccfdb54dabe86146616d3c09971d19582407bead01","source_id":"protocol_full_draft_selection:cab05cd9fefe597ae3e6461e","span_id":"es_006"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004","es_006"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[],"heading":"主要目的和主要终点","missing_source_classes":[],"proposal_text":"本研究的主要目的为评估KZ-sGC501在慢性稳定性HFrEF成人患者中较安慰剂的初步疗效信号。主要终点为第12周NT-proBNP较基线的百分比变化（双盲期）。NT-proBNP的评价时间点为基线、第4周、第8周和第12周。主要终点分析采用以基线NT-proBNP为协变量的协方差分析，并检验三个剂量组与安慰剂组之间的剂量-反应趋势。主要分析集为全分析集，遵循治疗策略原则，即无论是否发生剂量调整或合并用药变化，均按随机分组进行分析。","rationale":"已确认事实支持：主要终点定义（第12周NT-proBNP较基线百分比变化，双盲期）、评价时间点（基线/4/8/12周）、ANCOVA基线校正与剂量-反应趋势检验、FAS分析集、治疗策略估计目标。上述内容均直接来源于项目已确认研究事实，无需额外来源补充。","review_advisories":["本节复述高影响研究设计（主要目的和主要终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9e58cf742ce8_0540e8f7f9b6d9ee","section_number":"3.1","source_ids":["protocol_full_draft_selection:cab05cd9fefe597ae3e6461e","current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_c