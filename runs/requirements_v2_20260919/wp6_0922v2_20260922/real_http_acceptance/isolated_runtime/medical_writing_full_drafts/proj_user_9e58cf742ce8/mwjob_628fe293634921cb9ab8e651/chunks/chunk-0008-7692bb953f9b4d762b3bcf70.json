p_65_threshold","missing_source_classes":["依从性判定阈值与漏服处理规程"],"target":"依从性判定阈值、漏服处理规则及依从性不佳时的干预措施"}],"heading":"研究治疗依从性","missing_source_classes":["依从性监测方法文件","依从性判定阈值与漏服处理规程"],"proposal_text":"本研究采用双盲双模拟设计，试验药与安慰剂外观及气味一致，受试者每日晨起随餐口服一次，治疗期为12周。依从性评价依托每4周一次的随访访视进行，研究者应在每次访视时核查受试者自上次访视以来的用药情况，记录漏服、自行停药或给药时间偏差等事件。受试者应被告知每日固定时间随餐服药的要求，并在每次访视时如实报告用药依从情况。对于连续漏服超过一定次数或自行停药的情况，研究者应评估是否需要调整治疗方案或终止研究治疗。依从性数据应完整记录于病例报告表，作为安全性与疗效分析中治疗策略原则下数据完整性评估的依据。","rationale":"已确认事实支持：双盲双模拟设计、每日晨起随餐口服给药方式、12周治疗期、每4周随访评估耐受性。缺少具体依从性监测方法（药片计数、电子监测等）、依从性判定阈值、漏服处理具体规则及依从性不佳时的干预措施。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9e58cf742ce8_48ff39c5c38ea820","section_number":"6.5","source_ids":["protocol_full_draft_selection:7692bb953f9b4d762b3bcf70","current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad"]},{"ai_run_id":"airun_20261006040206_24c626dc","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_651c3c52586700892904:revision:6","quote":"联合标准GDMT背景治疗","quote_sha256":"de357b64ac05a6f762f0229c06cb0f13b5d1c97ea4be6802b434c8f87dc880b1","source_id":"current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad","span_id":"es_005"},{"locator":"study_definition:mwdefinition_651c3c52586700892904:revision:6","quote":"合并硝酸酯类或PDE5抑制剂","quote_sha256":"1578ce1729a9f9d003990f1b088c2d90a7e10dc03c46aabee8ad207ae537b30f","source_id":"current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad","span_id":"es_006"},{"locator":"study_definition:mwdefinition_651c3c52586700892904:revision:6","quote":"无论是否剂量调整或合并用药变化，均按随机分组分析","quote_sha256":"ad3bec81ba035490db27573116f10c6ded744b8972b056a85c5fb3a4e9cbee64","source_id":"current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad","span_id":"es_007"}],"evidence_review_advisories":[],"evidence_span_ids":["es_005","es_006","es_007"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"获取项目合并用药管理清单","category":"source_missing","gap_id":"gap_66_full_list","missing_source_classes":["合并用药允许与禁止清单"],"target":"完整的允许与禁止合并用药清单"},{"action":"获取项目GDMT背景治疗组成文件","category":"source_missing","gap_id":"gap_66_gdmt_composition","missing_source_classes":["GDMT具体组成文件"],"target":"GDMT具体药物组成及稳定剂量定义"},{"action":"获取项目洗脱与救援治疗规程","category":"source_missing","gap_id":"gap_66_washout_rescue","missing_source_classes":["洗脱期与救援治疗规程文件","合并用药变更审批流程"],"target":"洗脱期要求、救援治疗定义及合并用药变更审批流程"}],"heading":"合并用药/治疗","missing_source_classes":["合并用药允许与禁止清单","GDMT具体组成文件","洗脱期与救援治疗规程文件","合并用药变更审批流程"],"proposal_text":"本研究所有受试者在随机分组前已接受稳定剂量标准GDMT背景治疗至少4周，研究期间继续维持该背景治疗。试验药KZ-sGC501与安慰剂均联合标准GDMT背景治疗使用。合并硝酸酯类或PDE5抑制剂为排除标准，入组时正在使用上述药物的受试者不得参与本研究；研究期间新出现的合并用药应记录于病例报告表。统计分析采用治疗策略原则，无论是否发生剂量调整或合并用药变化，均按随机分组进行分析。","rationale":"已确认事实支持：联合标准GDMT背景治疗、排除标准中合并硝酸酯类或PDE5抑制剂、治疗策略分析原则。缺少完整允许与禁止合并用药清单、GDMT具体组成、洗脱期要求、救援治疗定义及合并用药变更审批流程。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_9e58cf742ce8_b7ad4521ca4790e9","section_number":"6.6","source_ids":["protocol_full_draft_selection:7692bb953f9b4d762b3bcf70","current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad"]},{"ai_run_id":"airun_20261006040206_24c626dc","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_651c3c52586700892904:revision:6","quote":"联合标准GDMT背景治疗","quote_sha256":"de357b64ac05a6f762f0229c06cb0f13b5d1c97ea4be6802b434c8f87dc880b1","source_id":"current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe1fcad","span_id":"es_005"},{"locator":"study_definition:mwdefinition_651c3c52586700892904:revision:6","quote":"合并硝酸酯类或PDE5抑制剂","quote_sha256":"1578ce1729a9f9d003990f1b088c2d90a7e10dc03c46aabee8ad207ae537b30f","source_id":"current_project_study_definition:mwdefinition_651c3c52586700892904:r6:8a374c3cdfe