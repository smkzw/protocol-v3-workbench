79b440","current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:9691f7c94f6c58","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976","company_corpus:cms_cn_protocol_corpus_20260715_v1:9895ed0bd2ffd4","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83"]},{"ai_run_id":"airun_20261002205138_d1a7e8ef","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"主要终点：第12周NT-proBNP较基线的百分比变化（中心实验室定量）。","quote_sha256":"cf93d08c04b1ed185004699e412fd4e8e81365a7a5b69ad855a2d977c17a8461","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es3"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"主要分析集为FAS；主要终点采用ANCOVA（基线log NT-proBNP为协变量）比较各剂量组与安慰剂组第12周变化，报告几何均值比与90%CI；安全性按SAS描述；无确证性假设检验。","quote_sha256":"6761a9b7aecbd75032ab32a3c52445a857daac1dd4639f1ea608fde1de442bff","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es4"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"探索性样本量：按NT-proBNP对数尺度组间SD约0.35估计，每组约40例（共160例）可在双侧α=0.10下提供约80%把握检测组间差异；含约10%脱落补偿。","quote_sha256":"4e57069650460e364624e7cac439e599febcd7fbc3b45f509feb6db8a6b15357","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es5"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"估计目标：12周NT-proBNP较基线百分比变化；人群为随机化全分析集；伴发事件按治疗方针策略处理；汇总统计量为各组均值差。","quote_sha256":"625ff33f440364fc20fc6f8a2053c62306031f65cc31d16a0678ae00fe8ee8f5","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es6"}],"evidence_review_advisories":[],"evidence_span_ids":["es3","es4","es5","es6"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"确认除基线log NT-proBNP外是否纳入NYHA分级、基线LVEF、背景GDMT方案等协变量","category":"source_missing","gap_id":"gap_9_01","missing_source_classes":["统计分析计划"],"target":"ANCOVA模型协变量选择"},{"action":"确认SAS是否包含至少接受一次给药的受试者，以及安全性描述性统计的完整指标清单","category":"source_missing","gap_id":"gap_9_02","missing_source_classes":["统计分析计划","安全性评估操作手册"],"target":"安全性分析集（SAS）定义及描述性统计指标"},{"action":"确认四个组间比较是否采用多重比较校正及具体方法","category":"source_missing","gap_id":"gap_9_03","missing_source_classes":["统计分析计划"],"target":"多重比较校正方法"},{"action":"确认主要终点缺失数据的处理方法及敏感性分析方案","category":"source_missing","gap_id":"gap_9_04","missing_source_classes":["统计分析计划"],"target":"缺失数据处理与敏感性分析"}],"heading":"统计分析","missing_source_classes":["统计分析计划（SAP）","安全性描述性统计指标清单","多重比较校正方法","SAS具体定义"],"proposal_text":"本研究为II期概念验证与剂量探索研究，无确证性假设检验。主要终点为第12周NT-proBNP较基线的百分比变化（中心实验室定量），主要分析集为全分析集（FAS），即所有随机化受试者。主要终点分析采用协方差分析（ANCOVA），以基线log NT-proBNP为协变量，比较SGC-R1L3低剂量组、中剂量组、高剂量组与安慰剂对照组第12周NT-proBNP较基线的变化，报告几何均值比及其90%置信区间。估计目标策略中，伴发事件按治疗方针策略处理，汇总统计量为各组均值差。安全性分析采用安全性分析集（SAS），对不良事件、严重不良事件、生命体征、12导联心电图、临床实验室检查异常及症状性低血压的发生率进行描述性统计。样本量策略为探索性设计：按NT-proBNP对数尺度组间标准差约0.35估计，每组约40例（共160例），可在双侧α=0.10下提供约80%把握度检测组间差异，含约10%脱落补偿。","rationale":"主要终点、分析集、ANCOVA方法、估计目标策略、安全性分析集及样本量参数均来源于项目研究定义中已确认的统计分析策略与样本量策略。ANCOVA模型中除基线log NT-proBNP外的协变量选择、SAS具体定义、安全性描述性统计的完整指标清单及多重比较校正方法需医学与统计确认。","review_advisories":["本节复述高影响研究设计（统计分析）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（α、主要终点、估计目标、伴发事件、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3ea77adeef20_0a64f17036cba072","section_number":"9","source_ids":["protocol_full_draft_selection:ff32b6f37a817e234b79b440","current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:9691f7c94f6c58","company_corpus:cms_cn_protoco