ew_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3ea77adeef20_e63b3907ee445549","section_number":"12.3","source_ids":["protocol_full_draft_selection:50c0e483d6dff568f0bb7e46","current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261002210349_f3315c56","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:12.2 方案偏离|block:952|chunk:1","quote":"申办者将审查所有方案偏离，并评估是否有严重违背GCP，以及是否要求向卫生主管部门报告。根据申办者的要求或SOP，偏离方案的前瞻性请求，包括放弃方案合格性标准的请求将不会被允许。","quote_sha256":"643056aa94c1285201b5f63d6801971893fb90935354b44c77e0839ffc32b390","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","span_id":"es_1"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"多中心、随机、双盲、安慰剂平行对照的II期概念验证与剂量探索研究","quote_sha256":"bca314ea800b7e1398db13f2a23194d1be4288995cd580eb27020945e94e709d","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_4"}],"evidence_review_advisories":[],"evidence_span_ids":["es_1","es_4"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":1},"gap_items":[{"action":"确认本项目是否采用重大偏离与一般偏离二级分类，以及各等级的报告时限和报告对象","category":"source_missing","gap_id":"gap_12_4_01","missing_source_classes":["方案偏离分类SOP","报告时限规定"],"target":"方案偏离分类标准及报告时限"},{"action":"确认何种程度的方案偏离需向伦理委员会报告、何种需向省级或国家药监部门报告","category":"source_missing","gap_id":"gap_12_4_02","missing_source_classes":["伦理委员会报告要求","药监部门报告要求"],"target":"向伦理委员会和药监部门报告的具体触发条件"}],"heading":"方案偏离","missing_source_classes":["本项目方案偏离分类标准与报告时限","伦理委员会及药监部门报告触发条件","前瞻性偏离请求例外条款"],"proposal_text":"本方案中，方案偏离是指任何有意或无意地未遵循本方案、良好临床实践或相关法规要求的事件。申办者将审查所有方案偏离，并评估是否构成严重违背良好临床实践，以及是否要求向卫生主管部门报告。根据申办者的要求或标准操作规程，偏离方案的前瞻性请求，包括放弃方案合格性标准的请求，将不被允许。研究中心应记录所有已识别的方案偏离，包括偏离发生的时间、涉及的研究对象、偏离内容、对受试者安全或数据完整性的影响评估，以及已采取或拟采取的纠正与预防措施。主要研究者应在获知方案偏离后及时通知申办者，申办者根据偏离的严重程度决定是否向伦理委员会和药品监督管理部门报告。本方案为多中心研究，各研究中心的方案偏离由申办者统一汇总审查，确保跨中心处理的一致性。","rationale":"方案偏离的审查与报告框架参照公司语料中II期方案偏离章节的监管共性结构，该结构适用于中国II期多中心研究。本项目的多中心设计已在已确认研究事实中明确。但本项目的方案偏离具体分类标准、报告时限、向伦理委员会和药监部门报告的具体触发条件、以及是否允许前瞻性偏离请求的例外情形，均缺少本项目专属来源，需医学经理与质量部门确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3ea77adeef20_5a782b223bc3e05d","section_number":"12.4","source_ids":["protocol_full_draft_selection:50c0e483d6dff568f0bb7e46","current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261002210349_f3315c56","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:12.4 管理结构|block:957|chunk:1","quote":"申办者或其代理人将执行项目管理、研究管理、监查、供应商管理和统计编程。可使用IWRS进行参与者筛查和随机分组，以及研究药物申请和运输的管理。研究中心将负责生物样品在运输至申办者或其指定分析单位之前的保存。数据将使用eCRFs通过EDC系统记录，或以电子方式转发给申办者（例如，药代动力学数据）。","quote_sha256":"6c7271f4ed3fd8fedd8e75159484480005fc72345847383d098e28d5130237d6","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","span_id":"es_2"},{"locator":"section:文档开头|block:4|chunk:1","quote":"本方案中所包含的所有信息归申办方所有，因此，仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构进行审阅。在未得到申办方书面批准的情况下，除了在与可能参加本研究的受试者签署知情同意书时，向其做必要的解释外，严禁将任何信息告知与本研究无关的第三方。","quote_sha256":"dfc9fceb41db9d941df0e3715483adaa069da4f1953600a6a37a56d7f81373dd","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","span_id":"es_3"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"多中心、随机、双盲、安慰剂平行对照的II期概念验证与剂量探索研究","quote_sha256":"bca314ea800b7e1398db13f2a23194d1be4288995cd580eb27020945e94e709d","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_4"}],"evidence_review_advisories":[],"evidence_span_ids":["es_2","es_3","es_4"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":1},"gap_items":[{"action":"确认本项目是否委托CRO执行项目管理、监查和统计编程，以及各职能的责任边界","category":"source_missing","gap_id":"gap_12_5_01","missing_source_classes":["项目管理计划","CRO委托协议"],"target":"本项目具体管理架构与职能分工"},{"action":"确认本项目是否使用IWRS或IWRS类系统进行随机分组和药物管理，以及系统选型","category":"source_missing","gap_id":"gap_12_5_02","missing_source_classes":["IWRS系统规格","随机化方案"],"target":"随机化与药物管理系统"},{"action":"确认本项目电子数据采集系统选型及数据传输方式","category":"source_missing","gap_id":"gap_12_5_03","missing_source_classes":["EDC系统规格","数据传输协议"],"target":"数据采集与传输方式"}],"heading":"关键角色和研究管理","missing_source_classes":["本项目管理架构与职能分工文件","IWRS或随机化系统选型确认","EDC系统选型确认","CRO委托范围与职责划分"],"proposal_text":"本方案为多中心、随机、双盲、安慰剂平行对照的II期概念验证与剂量探索研究，开发区域为中国。研究管理架构涵盖项目管理、研究管理、监查、供应商管理和统计编程等职能，由申办者或其委托的代理人执行。研究中心负责在生物样品运输至申办者或其指定分析单位之前完成样品的保存与初步处理。研究数据通过电子数据采集系统记录，或以电子方式转发给申办者。本方案中所包含的所有信息归申办方所有，仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构进行审阅；在未得到申办方书面批准的情况下，除在与可能参加本研究的受试者签署知情同意书时向其做必要的解释外，严禁将任何信息告知与本研究无关的第三方。","rationale":"研究管理架构描述参照公司语料中II期方案管理结构章节的监管共性结构，该结构适用于中国II期多中心研究。保密条款参照公司语料中方案摘要文档开头的保密声明。本项目的多中心、II期、中国开发区域等设计事实来自已确认研究事实。但本项目的具体管理架构细节（如是否使用IWRS进行随机分组、EDC系统选型、是否委托CRO执行监查、生物样品分析单位指定、各职能的具体责任划分）未在已确认研究事实中明确，公司语料中的IWRS和EDC描述来自不同适应症项目，仅作为结构参照，不得直接作为本项目既定事实。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3ea77adeef20_d75e0b4246d949df","section_number":"12.5","source_ids":["protocol_full_draft_selection:50c0e483d6dff568f0bb7e46","current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","company_c