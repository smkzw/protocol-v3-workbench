":"2.3.2","source_ids":["protocol_full_draft_selection:45cfbfb715e61007c8cca82e","current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261002201139_37e96ee0","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"内在研究目的：概念验证（PoC）；剂量探索","quote_sha256":"2d096e242bbd65d0c9236718d79e77a388e84cb9640b99bd47662a6ce8faab31","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_02"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"多中心、随机、双盲、安慰剂平行对照的II期概念验证与剂量探索研究：SGC-R1L3设低/中/高三个剂量组与安慰剂组平行对照，主要评价12周NT-proBNP较基线变化与安全性及耐受性。","quote_sha256":"2fe59c354b666a3565668a5f6963781f09e0c0fe0d693564b9ddcb6937afb2f7","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_03"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"多中心、随机、双盲、安慰剂平行对照的II期概念验证与剂量探索研究","quote_sha256":"bca314ea800b7e1398db13f2a23194d1be4288995cd580eb27020945e94e709d","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_04"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"SGC-R1L3设低/中/高三个剂量组与安慰剂组平行对照","quote_sha256":"3935a2434db78f51ec02da1a4f83fd41fbc2d062376f8df373531534041756e1","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_05"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"主要终点：第12周NT-proBNP较基线的百分比变化（中心实验室定量）。","quote_sha256":"cf93d08c04b1ed185004699e412fd4e8e81365a7a5b69ad855a2d977c17a8461","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_06"}],"evidence_review_advisories":[],"evidence_span_ids":["es_02","es_03","es_04","es_05","es_06"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"补充sGC-cGMP通路在HFrEF中的机制文献、SGC-R1L3非临床药效学数据及同机制药物临床证据，以充实机制阐述部分","category":"source_missing","gap_id":"gap_24_01","missing_source_classes":["非临床药效学资料","sGC激动剂机制文献","同类药物临床证据"],"target":"2.4 本研究的理论基础"},{"action":"医学经理确认sGC-cGMP通路调节心室重构和神经内分泌的表述是否纳入方案理论基础，以及NT-proBNP作为替代终点的论证深度","category":"decision_pending","gap_id":"gap_24_02","missing_source_classes":[],"target":"2.4 本研究的理论基础"}],"heading":"本研究的理论基础","missing_source_classes":["sGC激动剂作用机制与非临床药效学资料","HFrEF病理生理与NT-proBNP生物标志物文献","同机制药物（如维利西呱）既往临床证据"],"proposal_text":"本研究为II期概念验证与剂量探索研究，其理论基础包含以下层面。第一，在疾病层面，慢性心力衰竭伴射血分数降低（HFrEF）的核心病理生理特征为心肌收缩力下降、心室重构进展及神经内分泌系统持续激活，导致心室壁张力升高和利钠肽系统代偿性释放增加；NT-proBNP作为心室壁张力敏感的生物标志物，其水平变化可反映血流动力学负荷的改善程度。第二，在药物机制层面，SGC-R1L3为口服小分子可溶性鸟苷酸环化酶（sGC）激动剂，通过直接激活sGC催化亚基、增加细胞内环磷酸鸟苷（cGMP）生成，理论上可改善心肌舒张功能、减轻纤维化并降低前负荷与后负荷，从而降低NT-proBNP水平。第三，在研究设计层面，本研究采用多中心、随机、双盲、安慰剂平行对照设计，SGC-R1L3设低剂量（2.5mg）、中剂量（5mg）和高剂量（10mg）三个剂量组与安慰剂组按1:1:1:1比例随机分配，连续给药12周，旨在同时完成概念验证（确认sGC激动通路在HFrEF人群中的靶标效应）和剂量探索（确定后续III期研究的候选剂量范围）。第四，在人群选择层面，目标受试者为LVEF≤40%、NYHA心功能II至III级、已接受稳定指南导向药物治疗（GDMT）至少4周仍保留中重度症状的成人HFrEF患者，该人群在现有标准治疗下仍存在残余风险，为评估SGC-R1L3的增量获益提供了合理的临床背景。第五，在终点选择层面，以第12周NT-proBNP较基线的百分比变化作为主要终点，结合安全性与耐受性评价，符合II期概念验证研究以生物标志物替代终点初步验证药效学假设、同时积累安全性数据的定位。","rationale":"已确认事实支持：研究分期为II期、内在目的为概念验证与剂量探索、总体设计为多中心随机双盲安慰剂平行对照、SGC-R1L3为口服小分子sGC激动剂、三个剂量组2.5/5/10mg、1:1:1:1随机、12周给药、主要终点为第12周NT-proBNP百分比变化、目标人群为LVEF≤40%且NYHA II-III级且稳定GDMT≥4周。sGC-cGMP通路对心室重构和神经内分泌的调节作用为基于药物类别的机制推断，需医学经理确认表述是否准确及是否纳入。NT-proBNP与血流动力学改善的关联为合理推断，需确认是否作为方案理论基础写入。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3ea77adeef20_6c5b2f2bf4f86c0b","section_number":"2.4","source_ids":["protocol_full_draft_selection:45cfbfb715e61007c8cca82e","current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261002201139_37e96ee0","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"多中心、随机、双盲、安慰剂平行对照的II期概念验证与剂量探索研究：SGC-R1L3设低/中/高三个剂量组与安慰剂组平行对照，主要评价12周NT-proBNP较基线变化与安全性及耐受性。","quote_sha256":"2fe59c354b666a3565668a5f6963781f09e0c0fe0d693564b9ddcb6937afb2f7","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_03"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"多中心、随机、双盲、安慰剂平行对照的II期概念验证与剂量探索研究","quote_sha256":"bca314ea800b7e1398db13f2a23194d1be4288995cd580eb27020945e94e709d","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_04"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"SGC-R1L3设低/中/高三个剂量组与安慰剂组平行对照","quote_sha256":"3935a2434db78f51ec02da1a4f83fd41fbc2d062376f8df373531534041756e1","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_05"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"主要终点：第12周NT-proBNP较基线的百分比变化（中心实验室定量）。","quote_sha256":"cf93d08c04b1ed185004699e412fd4e8e81365a7a5b69ad855a2d977c17a8461","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_06"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"不良事件（AE）与严重不良事件（SAE）发生率（至末次给药后28天）；生命体征、12导联心电图、临床实验室检查异常发生率；症状性低血压发生率","quote_sha256":"eeb150d5b4105ba3f52e8fcb897d472c81b951c8a8aeebfbd7c19078cac79329","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_08"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"主要分析集为FAS；主要终点采用ANCOVA（基线log NT-proBNP为协变量）比较各剂量组与安慰剂组第12周变化，报告几何均值比与90%CI；安全性按SAS描述；无确证性假设检验。","quote_sha256":"6761a9b7aecbd75032ab32a3c52445a857daac1dd4639f1ea608fde1de442bff","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_09"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"无确证性假设检验。","quote_sha256":"b43987358d3da49f1356a2a01fd7c99edebc7c04d33ad2c602fcde44fe320645","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_12"}],"evidence_review_advisories":[],"evidence_span_ids":["es_03","es_04","es_05","es_06","es_08","es_09","es_12"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":7},"gap_items":[{"action":"确认是否设置次要疗效终点（如6分钟步行距离、NYHA分级变化、NT-proBNP绝对变化、心衰住院率等）及探索性终点；当前允许来源仅列出主要终点和安全性终点，未提供次要或探索性终点信息","category":"source_missing","gap_id":"gap_3_01","missing_source_classes":["次要终点定义","探索性终点定义"],"target":"3 研究目的和终点"},{"action":"医学经理确认本研究是否设置探索性目的与终点；若设置，需明确具体终点名称、评价时点及分析策略","category":"decision_pending","gap_id":"gap_3_02","missing_source_classes":[],"target":"3 研究目的和终点"}],"heading":"研究目的和终点","missing_source_classes":[],"proposal_text":"本研究为多中心、随机、双盲、安慰剂平行对照的II期概念验证与剂量探索研究，旨在评价口服sGC激动剂SGC-R1L3在慢性心力衰竭伴射血分数降低（HFrEF）成人受试者中的初步疗效信号、剂量-效应关系及安全性与耐受性。研究设置SGC-R1L3低剂量（2.5mg）、中剂量（5mg）和高剂量（10mg）三个活性剂量组及安慰剂对照组，各组按1:1:1:1比例随机分配，连续口服给药12周。研究时期包括筛选期（第-28天至第-1天）、治疗期（第1天至第12周）和安全性随访期（末次给药后28天）。访视安排为：筛选访视（V1，第-28至-1天）、基线随机访视（V2，第1天）、第2周（V3）、第4周（V4）、第8周（V5）、第12周（V6）门诊访视、治疗结束访视（V7，第12周）及末次给药后28天安全性随访访视（V8）。主要疗效终点为第12周NT-proBNP较基线的百分比变化，由中心实验室定量检测。安全性终点包括不良事件与严重不良事件发生率（观察至末次给药后28天）、生命体征、12导联心电图及临床实验室检查异常发生率、症状性低血压发生率。主要分析集为全分析集（FAS），主要终点采用协方差分析（ANCOVA），以基线log NT-proBNP为协变量，比较各剂量组与安慰剂组第12周变化，报告几何均值比及90%置信区间；安全性数据按安全性分析集（SAS）进行描述性分析。本研究无确证性假设检验。","rationale":"已确认事实支持：总体设计（多中心、随机、双盲、安慰剂平行对照、II期）、三个剂量组及安慰剂1:1:1:1随机、12周给药、研究时期（筛选-28至-1天、治疗D1至W12、安全性随访28天）、访视策略（V1至V8）、主要终点（第12周NT-proBNP百分比变化、中心实验室定量）、安全性终点（AE/SAE至末次给药后28天、生命体征、心电图、实验室检查、症状性低血压）、统计方法（FAS、ANCOVA、基线log NT-proBNP协变量、几何均值比与90%CI、SAS描述、无确证性假设检验）。本章节为研究目的和终点的总述，具体主要目的和主要终点在3.1节详述。","review_advisories":["本节复述高影响研究设计（研究目的和终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3ea77adeef20_765206663fadde1d","section_number":"3","source_ids":["protocol_full_draft_selection:45cfbfb715e61007c8cca82e","current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261002201139_37e96ee0","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"主要终点：第12周NT-proBNP较基线的百分比变化（中心实验室定量）。","quote_sha256":"cf93d08c04b1ed185004699e412fd4e8e81365a7a5b69ad855a2d977c17a8461","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_06"},{"locator":"document:mwdoc_greenfield_proj_user_3ea77adeef20_fe65ac8ebe5656d4:full-draft:45cfbfb715e61007c8cca82e","quote":"主要终点：第12周NT-proBNP较基线的百分比变化（中心实验室定量）。","quote_sha256":"cf93d08c04b1ed185004699e412fd4e8e81365a7a5b69ad855a2d977c17a8461","source_id":"protocol_full_draft_selection:45cfbfb715e61007c8cca82e","span_id":"es_07"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"主要分析集为FAS；主要终点采用ANCOVA（基线log NT-proBNP为协变量）比较各剂量组与安慰剂组第12周变化，报告几何均值比与90%CI；安全性按SAS描述；无确证性假设检验。","quote_sha256":"6761a9b7aecbd75032ab32a3c52445a857daac1dd4639f1ea608fde1de442bff","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_09"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"估计目标：12周NT-proBNP较基线百分比变化；人群为随机化全分析集；伴发事件按治疗方针策略处理；汇总统计量为各组均值差。","quote_sha256":"625ff33f440364fc20fc6f8a2053c62306031f65cc31d16a0678ae00fe8ee8f5","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_10"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"探索性样本量：按NT-proBNP对数尺度组间SD约0.35估计，每组约40例（共160例）可在双侧α=0.10下提供约80%把握检测组间差异；含约10%脱落补偿。","quote_sha256":"4e57069650460e364624e7cac439e599febcd7fbc3b45f509feb6db8a6b15357","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_11"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"无确证性假设检验。","quote_sha256":"b43987358d3da49f1356a2a01fd7c99edebc7c04d33ad2c602fcde44fe320645","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_12"}],"evidence_review_advisories":[],"evidence_span_ids":["es_06","es_07","es_09","es_10","es_11","es_12"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"医学经理确认主要目的中'降低NT-proBNP水平的初步疗效信号'及'剂量-效应关系'的表述是否准确反映研究意图，以及是否需要补充次要目的","category":"decision_pending","gap_id":"gap_31_01","missing_source_classes":[],"target":"3.1 主要目的和主要终点"},{"action":"确认NT-proBNP作为主要终点的选择依据文献（如与临床硬终点的关联证据、既往sGC激动剂研究中NT-proBNP的预测价值），以充实主要终点选择的论证","category":"source_missing","gap_id":"gap_31_02","missing_source_classes":["NT-proBNP生物标志物验证文献","sGC激动剂类既往临床终点数据"],"target":"3.1 主要目的和主要终点"}],"heading":"主要目的和主要终点","missing_source_classes":[],"proposal_text":"本研究的主要目的为评价口服sGC激动剂SGC-R1L3（2.5mg、5mg、10mg，每日一次，连续12周）在慢性心力衰竭伴射血分数降低（HFrEF）成人受试者中降低NT-proBNP水平的初步疗效信号，并探索SGC-R1L3的剂量-效应关系。主要终点为第12周NT-proBNP较基线的百分比变化，由中心实验室采用定量方法检测。主要分析集为全分析集（FAS），分析采用协方差分析（ANCOVA），以基线log NT-proBNP为协变量，比较各SGC-R1L3剂量组与安慰剂组在第12周NT-proBNP百分比变化上的差异，报告几何均值比及90%置信区间。估计目标策略中，伴发事件按治疗方针策略处理，汇总统计量为各组均值差。本研究无确证性假设检验，主要终点分析为描述性探索性质。样本量依据NT-proBNP对数尺度组间标准差约0.35估计，每组约40例（共160例），含约10%脱落补偿，可在双侧α=0.10下提供约80%把握度检测组间差异。","rationale":"已确认事实支持：主要终点为第12周NT-proBNP较基线百分比变化（中心实验室定量）；主要分析集为FAS；ANCOVA以基线log NT-proBNP为协变量；报告几何均值比与90%CI；无确证性假设检验；估计目标策略为治疗方针策略、汇总统计量为各组均值差；样本量每组约40例共160例、双侧α=0.10、约80%把握度、含约10%脱落补偿；剂量为2.5/5/10mg每日一次连续12周。主要目的中'降低NT-proBNP水平的初步疗效信号'和'剂量-效应关系'为基于研究目的（概念验证与剂量探索）和主要终点的合理表述，需医学经理确认措辞。","review_advisories":["本节复述高影响研究设计（主要目的和主要终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（α、主要终点、估计目标、伴发事件、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3ea77adeef20_750dc7a0c7c3eeeb","section_number":"3.1","source_ids":["protocol_full_draft_selection:45cfbfb715e61007c8cca82e","current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]}],"source_bindings":[{"content_sha256":"38f3693858162a0590768b61319598025d42210b3f0275b05c50f0f35abdb50f","locator":"document:mwdoc_greenfield_proj_user_3ea77adeef20_fe65ac8ebe5656d4:full-draft:45cfbfb715e61007c8cca82e","role":"current_working_draft_packet","source_id":"protocol_full_draft_sel