or":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"试验药物：SMOKE-r1-3口服sGC激动剂（SGC-R1L3）","quote_sha256":"45a3f004bc0f769e7a328df5e3f163ba8656e44b615cfa9472f3622c0ccdf11a","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_drug_mechanism"}],"evidence_review_advisories":[],"evidence_span_ids":["es_safety_endpoint_ecg","es_visit_strategy","es_drug_mechanism"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"依据药物非临床及既往临床心电图数据确定各访视是否实施心电图及具体时点","category":"source_missing","gap_id":"gap_ecg_timing","missing_source_classes":["非临床安全性报告","既往临床研究数据"],"target":"7.3.2节心电图实施访视时点"},{"action":"确定需记录的导联参数、QTc计算公式、临床显著异常阈值及是否中心判读","category":"source_missing","gap_id":"gap_ecg_params","missing_source_classes":["方案安全性监测计划","中心实验室协议"],"target":"7.3.2节心电图测量参数与判读标准"}],"heading":"心电图检查","missing_source_classes":["试验药物非临床安全性研究报告","试验药物既往人体研究心电图数据","方案安全性监测计划（含各访视检查项目矩阵）"],"proposal_text":"本研究将12导联心电图作为安全性评估的组成部分，用于监测受试者心脏电生理状态。试验药物SGC-R1L3为口服sGC激动剂，通过激活可溶性鸟苷酸环化酶促进血管舒张，其药理作用可能影响心率和心脏传导，因此心电图监测为安全性评价的必要环节。心电图检查在筛选期（V1）和基线随机访视（V2）实施，以建立每位受试者的心脏电生理基线并排除存在显著心电图异常者。治疗期及安全性随访期（V3至V8）是否实施心电图检查、具体实施访视时点、心电图测量参数（包括心率、PR间期、QRS时限、QT间期及QTc间期）、临床显著异常判定阈值（如QTc延长标准、新发心律失常定义）、是否采用中心实验室统一判读以及判读机构，均须依据该药物非临床安全性数据、既往人体研究心电图观察结果及本方案安全性监测计划最终确定。","rationale":"来源确认12导联心电图为安全性终点组成部分，访视策略列出V1至V8共8次访视但未逐次标注心电图实施。sGC激动剂血管舒张机制为来源明确记载。具体心电图实施时点、参数、阈值及判读方式无来源支持，需医学经理结合药物非临床及既往临床资料确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3ea77adeef20_7cbb9b6f16b72609","section_number":"7.3.2","source_ids":["protocol_full_draft_selection:8adb2ac1c255219137d06659","current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e"]},{"ai_run_id":"airun_20261002204248_31567178","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"安全性终点：不良事件（AE）与严重不良事件（SAE）发生率（至末次给药后28天）；生命体征、12导联心电图、临床实验室检查异常发生率；症状性低血压发生率","quote_sha256":"baf9dd2250e27943336dfa1e44f2f07081f03e6f2962e0d1e4e9e0edb166421a","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_safety_endpoint_lab"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"eGFR<30mL/min/1.73m²或ALT/AST>3×ULN","quote_sha256":"336537188b4b84f4732dda610e68911c564b64ada632e906c779ced8ab4eb46b","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_lab_exclusion"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"访视策略：筛选（V1，-28~-1天）、基线随机（V2，D1）、第2/4/8/12周门诊访视（V3–V6）、治疗结束访视（V7，W12）、末次给药后28天安全性随访（V8）。","quote_sha256":"f246ab1e6e3fdcf1be70f34b89965eeaf4ce6f58c8c3616c28603f43768511ad","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_visit_strategy"}],"evidence_review_advisories":[],"evidence_span_ids":["es_safety_endpoint_lab","es_lab_exclusion","es_visit_strategy"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"依据非临床毒理学靶器官及既往临床实验室异常确定需监测的实验室项目","category":"source_missing","gap_id":"gap_lab_panel","missing_source_classes":["非临床毒理学报告","既往临床研究数据"],"target":"7.3.3节实验室检查具体项目组合"},{"action":"确定各访视实验室检查项目及时点，明确NT-proBNP中心检测与安全性实验室的关系","category":"source_missing","gap_id":"gap_lab_timing","missing_source_classes":["方案安全性监测计划","中心实验室协议"],"target":"7.3.3节实验室检查采集时点"},{"action":"确定各实验室指标临床显著异常阈值及达到阈值后的处理流程","category":"source_missing","gap_id":"gap_lab_threshold","missing_source_classes":["方案安全性监测计划","剂量调整章节"],"target":"7.3.3节实验室异常判定与处理规则"}],"heading":"实验室检查","missing_source_classes":["试验药物非临床毒理学研究报告","试验药物既往人体研究实验室数据","方案安全性监测计划（含实验室检查项目矩阵）","中心实验室检测协议"],"proposal_text":"本研究将临床实验室检查异常发生率作为安全性终点之一，用于系统监测试验药物SGC-R1L3对受试者血液学、肝脏、肾脏及代谢等系统的影响。排除标准中已明确将eGFR低于30 mL/min/1.73m²或ALT/AST超过3倍正常值上限者排除于研究之外，提示肝脏和肾脏安全性为本研究重点关注领域。实验室检查在筛选期（V1）实施，用于确认受试者符合入组条件并建立基线值。治疗期及安全性随访期（V2至V8）的实验室检查具体项目组合、采集时点、是否包含NT-proBNP中心实验室定量检测（该检测同时服务于主要终点评价）、各项目的临床显著异常判定标准、是否需要重复检测确认以及达到何种异常水平需暂停或终止给药，均须依据该药物非临床毒理学数据、既往人体研究实验室异常观察结果及本方案安全性监测计划最终确定。","rationale":"来源确认临床实验室检查异常发生率为安全性终点，排除标准含eGFR<30及ALT/AST>3×ULN。访视策略列出V1至V8但未逐次标注实验室检查项目。具体实验室项目组合、采集时点、NT-proBNP检测与安全性实验室的关系及异常处理规则无来源支持。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3ea77adeef20_23fbb0b361626f53","section_number":"7.3.3","source_ids":["protocol_full_draft_selection:8adb2ac1c255219137d06659","current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e"]},{"ai_run_id":"airun_20261002204248_31567178","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"妊娠期、哺乳期女性或不愿采取有效避孕措施者","quote_sha256":"8fe8957ed953ac6f05616d5ff9bac7cceeddf896e49029753a860a089beceb1c","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_pregnancy_exclusion"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"试验药物：SMOKE-r1-3口服sGC激动剂（SGC-R1L3）","quote_sha256":"45a3f004bc0f769e7a328df5e3f163ba8656e44b615cfa9472f3622c0ccdf11a","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_drug_mechanism"}],"evidence_review_advisories":[],"evidence_span_ids":["es_pregnancy_exclusion","es_drug_mechanism"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"依据非临床生殖毒性数据确定妊娠检查方法、检查时点及阳性后处理流程","category":"source_missing","gap_id":"gap_preg_method","missing_source_classes":["非临床生殖毒性报告","方案避孕及妊娠管理章节"],"target":"7.3.4节妊娠检查方法及检查时点"},{"action":"确定有效避孕措施的具体类型、起始时间、持续要求及伴侣妊娠报告流程","category":"source_missing","gap_id":"gap_contraception","missing_source_classes":["方案避孕及妊娠管理章节","药物非临床生殖毒性报告"],"target":"7.3.4节避孕方法具体要求"}],"heading":"妊娠检查和避孕问询","missing_source_classes":["试验药物非临床生殖毒性研究报告","试验药物既往人体研究妊娠相关数据","方案避孕及妊娠管理章节"],"proposal_text":"本研究排除标准明确将妊娠期、哺乳期女性及不愿采取有效避孕措施的育龄期女性排除于研究之外。育龄期女性受试者在筛选期须接受妊娠状态确认，确认妊娠或哺乳期者不得入组。鉴于试验药物SGC-R1L3为口服小分子化合物、经全身系统暴露，其生殖毒性及胚胎-胎儿发育毒性数据须由非临床安全性研究提供，本章节的妊娠检查方法、检查时点、避孕措施具体要求及治疗期间妊娠监测安排，须依据该药物非临床生殖毒性研究结果及既往人体研究数据最终确定。","rationale":"来源确认排除标准含妊娠期、哺乳期及不愿采取有效避孕措施者。试验药物为口服小分子、系统暴露。但具体妊娠检查方法（尿妊娠试验或血清β-hCG）、检查时点（仅筛选还是含治疗期及随访期）、避孕方法具体类型、伴侣妊娠报告流程、妊娠后处理及新生儿随访均未在来源中明确，不得由排除标准推断具体实施规则。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3ea77adeef20_8e0d25ca6600d088","section_number":"7.3.4","source_ids":["protocol_full_draft_selection:8adb2ac1c255219137d06659","current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e"]},{"ai_run_id":"airun_20261002204248_31567178","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"安全性终点：不良事件（AE）与严重不良事件（SAE）发生率（至末次给药后28天）；生命体征、12导联心电图、临床实验室检查异常发生率；症状性低血压发生率","quote_sha256":"baf9dd2250e27943336dfa1e44f2f07081f03e6f2962e0d1e4e9e0edb166421a","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_safety_endpoint_full"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"安全性随访期（末次给药后28天）","quote_sha256":"19473caec3ae0b985725972d232be99949f70a341b7f0097060c00a9cb449380","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_safety_followup"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"筛选时收缩压<100mmHg或>160mmHg","quote_sha256":"60ebfb3f6bc0a37ee110e3e737d7e1531132fba168f3d04e65be5c6bde077fa9","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_sbp_range"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"症状性低血压发生率","quote_sha256":"e2b6814aca7d484502a269df8a8991a64540d775159d466a799b65f85491fc0b","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_hypotension_endpoint"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"试验药物：SMOKE-r1-3口服sGC激动剂（SGC-R1L3）","quote_sha256":"45a3f004bc0f769e7a328df5e3f163ba8656e44b615cfa9472f3622c0ccdf11a","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_drug_mechanism"}],"evidence_review_advisories":[],"evidence_span_ids":["es_safety_endpoint_full","es_safety_followup","es_sbp_range","es_hypotension_endpoint","es_drug_mechanism"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"依据研究者手册及既往临床数据确定AE/SAE定义、CTCAE分级版本、因果关系判定标准及报告时限","category":"source_missing","gap_id":"gap_ae_definition","missing_source_classes":["研究者手册","既往临床研究数据"],"target":"第8节AE/SAE/SUSAR定义与报告规则"},{"action":"确定安全性分析集定义、安全性终点汇总统计方法及安全性数据审查机制","category":"source_missing","gap_id":"gap_safety_analysis","missing_source_classes":["统计分析计划","方案安全性监测计划"],"target":"第8节安全性数据分析方法"},{"action":"确认本研究是否购买受试者伤害保险及赔偿条款","category":"source_missing","gap_id":"gap_insurance","missing_source_classes":["保险赔偿条款"],"target":"第8节保险赔偿条款"}],"heading":"安全性评价","missing_source_classes":["试验药物研究者手册","试验药物既往人体研究安全性数据","方案安全性监测计划","方案不良事件及严重不良事件管理章节"],"proposal_text":"本研究安全性评价涵盖以下方面：不良事件与严重不良事件发生率（观察至末次给药后28天）、生命体征、12导联心电图及临床实验室检查异常发生率、症状性低血压发生率。安全性随访期为末次给药后28天，对应访视V8。试验药物SGC-R1L3为口服sGC激动剂，其血管舒张药理作用与症状性低血压风险相关，排除标准中收缩压低于100 mmHg或高于160 mmHg者不得入组，进一步提示血压及血流动力学监测为安全性评价重点。不良事件与严重不良事件的定义、分级标准、因果关系判定方法、采集与报告时限、可疑且非预期严重不良反应的报告路径，以及安全性数据的汇总分析方法，须依据试验药物研究者手册、既往人体研究安全性数据及本方案安全性监测计划最终确定。","rationale":"来源确认安全性终点完整列表（AE/SAE至末次给药后28天、生命体征、12导联心电图、实验室检查异常、症状性低血压），安全性随访期28天，排除标准含SBP范围限制，试验药为sGC激动剂。但AE/SAE/SUSAR具体定义、CTCAE版本、报告时限、SUSAR路径、保险赔偿及安全性分析集定义均未在来源中明确。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3ea77adeef20_1a06d148f3750713","section_number":"8","source_ids":["protocol_full_draft_selection:8adb2ac1c255219137d06659","current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e"]}],"source_bindings":[{"content_sha256":"8a6c0d069123be4bcf22456061783f527cadf8c41f5f33ab539bc9087f2597a0","locator":"document:mwdoc_greenfield_proj_user_3ea77adeef20_fe65ac8ebe5656d4:full-draft:8adb2ac1c255219137d06659","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:8adb2ac1c255219137d06659","source_type":"protocol_full_draft_selection","source_version":"full-draft:f7cad6dd41a53dd961c595f921f126425c5cf6efe0ee27d189f890cb1954cb56:8adb2ac1c255219137d06659","text_sha256":"8a6c0d069123be4bcf22456061783f527cadf8c41f5f33ab539bc9087f2597a0"},{"content_sha256":"db9b92d12e178aa2ca2e7a7f27910eba0a468cd52f76daba8dc1e7f0b82160dc","locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","source_type":"current_project_study_definition","source_version":"mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","text_sha256":"db9b92d12e178aa2ca2e7a7f27910eba0a468cd52f76daba8dc1e7f0b82160dc"}]}