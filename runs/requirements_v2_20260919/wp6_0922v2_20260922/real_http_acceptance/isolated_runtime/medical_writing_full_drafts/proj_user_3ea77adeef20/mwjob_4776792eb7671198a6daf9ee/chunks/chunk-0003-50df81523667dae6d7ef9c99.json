spans":0,"project_fact_spans":2},"gap_items":[{"action":"由医学经理确认本研究是否设置次要疗效终点；若设置，需补充终点定义、评价时点及分析集","category":"source_missing","gap_id":"gap_sec32_secondary_efficacy","missing_source_classes":["研究定义中未列出的次要疗效终点清单"],"target":"次要疗效终点（如6MWD、KCCQ、NT-proBNP绝对变化、LVEF等）"},{"action":"由医学经理确认安全性终点是否作为次要终点写入本节，或移至独立安全性章节","category":"decision_pending","gap_id":"gap_sec32_endpoint_classification","missing_source_classes":[],"target":"安全性终点在方案中的章节归属（归入次要终点或独立安全性章节）"}],"heading":"次要目的和次要终点","missing_source_classes":[],"proposal_text":"本研究的次要目的为评价SGC-R1L3在慢性心力衰竭（射血分数降低）成人受试者中的安全性与耐受性特征。次要终点包括：（1）不良事件与严重不良事件发生率，观察窗口为首次给药至末次给药后28天；（2）生命体征、12导联心电图及临床实验室检查异常发生率；（3）症状性低血压发生率。上述安全性终点在全部治疗期访视及末次给药后28天安全性随访访视中采集，按安全性分析集进行描述性汇总。本研究未设置次要疗效终点。","rationale":"研究定义明确列出安全性终点为AE/SAE发生率（至末次给药后28天）、生命体征、12导联心电图、临床实验室检查异常发生率及症状性低血压发生率，且内在研究目的包含安全性及耐受性评价。研究定义中未列出次要疗效终点，因此本章节仅写入已确认的安全性终点。医学经理需确认：安全性终点是否归类为次要终点或应单列为安全性终点章节；是否存在未列入研究定义的次要疗效终点；各安全性终点的采集访视是否覆盖全部V3至V8。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3ea77adeef20_59081a82c1155398","section_number":"3.2","source_ids":["protocol_full_draft_selection:50df81523667dae6d7ef9c99","current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7"]},{"ai_run_id":"airun_20261002201546_0a7f544f","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"恢复本章节正文与当前项目来源的证据绑定后重新核对。","category":"mapping_failed","gap_id":"gap:evidence-binding","missing_source_classes":[],"target":"mwsec_greenfield_proj_user_3ea77adeef20_181a8184f4a4ab88"}],"heading":"探索性目的和探索性终点","missing_source_classes":["支持本章节正文的当前项目直接来源"],"proposal_text":"","rationale":"本次输出未能把正文绑定到有效证据；需补充或重新绑定支持本章节的当前项目直接来源。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3ea77adeef20_181a8184f4a4ab88","section_number":"3.3","source_ids":["protocol_full_draft_selection:50df81523667dae6d7ef9c99","current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7"]},{"ai_run_id":"airun_20261002201546_0a7f544f","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"多中心、随机、双盲、安慰剂平行对照的II期概念验证与剂量探索研究：SGC-R1L3设低/中/高三个剂量组与安慰剂组平行对照，主要评价12周NT-proBNP较基线变化与安全性及耐受性。","quote_sha256":"2fe59c354b666a3565668a5f6963781f09e0c0fe0d693564b9ddcb6937afb2f7","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_003"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"安慰剂平行对照：安慰剂片外观与SGC-R1L3一致，口服每日一次×12周；各组按1:1:1:1随机；背景GDMT按指南维持稳定。","quote_sha256":"18bd521518a771fcdaed24de887d692e5182772e194bee6a4dfc7be85b0c0bf0","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_006"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"访视策略：筛选（V1，-28~-1天）、基线随机（V2，D1）、第2/4/8/12周门诊访视（V3–V6）、治疗结束访视（V7，W12）、末次给药后28天安全性随访（V8）。","quote_sha256":"f246ab1e6e3fdcf1be70f34b89965eeaf4ce6f58c8c3616c28603f43768511ad","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_008"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"主要终点：第12周NT-proBNP较基线的百分比变化（中心实验室定量）。","quote_sha256":"cf93d08c04b1ed185004699e412fd4e8e81365a7a5b69ad855a2d977c17a8461","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_009"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"试验组与对照组：SGC-R1L3低剂量组；SGC-R1L3中剂量组；SGC-R1L3高剂量组；安慰剂对照组","quote_sha256":"ea4833f625f8baedb8a5c5bc32677cc27d6787edb6c5dc36877059e5d1655f8e","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_010"}],"evidence_review_advisories":[],"evidence_span_ids":["es_003","es_006","es_008","es_009","es_010"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"由医学经理与统计师确认随机化方法细节","category":"source_missing","gap_id":"gap_sec4_randomization_method","missing_source_classes":["随机化方法学文件"],"target":"随机化具体方法（区组大小、分层因素、随机化比例实现方式）"},{"action":"由医学经理确认剂量递增章节的具体规则（如队列大小、暂停触发条件、恢复条件）","category":"source_missing","gap_id":"gap_sec4_dose_escalation","missing_source_classes":["剂量递增与安全性暂停规则文件"],"target":"剂量递增与安全性暂停规则的具体操作流程"},{"action":"由医学经理确认盲态覆盖的具体人员范围及紧急揭盲程序","category":"source_missing","gap_id":"gap_sec4_blinding_scope","missing_source_classes":["盲法管理规程"],"target":"双盲的盲态覆盖范围（受试者、研究者、评价者、数据管理人员等）"}],"heading":"研究设计","missing_source_classes":[],"proposal_text":"本研究为多中心、随机、双盲、安慰剂平行对照的II期概念验证与剂量探索研究，在中国开展。研究采用平行组设计，设SGC-R1L3低剂量组（2.5mg）、中剂量组（5mg）、高剂量组（10mg）及安慰剂对照组，共四个治疗组，各组按1:1:1:1比例随机分配。SGC-R1L3为口服薄膜衣片，每日一次，连续给药12周；安慰剂片外观与SGC-R1L3一致，口服每日一次，疗程12周。所有受试者在研究期间维持背景指南导向药物治疗（GDMT）稳定。研究时期包括筛选期（-28至-1天）、治疗期（第1天至第12周）和安全性随访期（末次给药后28天）。访视安排为：筛选访视（V1，-28至-1天）、基线随机访视（V2，第1天）、第2/4/8/12周门诊访视（V3至V6）、治疗结束访视（V7，第12周）及末次给药后28天安全性随访访视（V8）。本研究不采用自适应设计，不进行样本量再估计，不设置期中分析，不设立独立数据监查委员会或安全审查委员会。主要分析集为全分析集，主要终点采用协方差分析（以基线log NT-proBNP为协变量）比较各剂量组与安慰剂组第12周变化，报告几何均值比及90%置信区间；安全性数据按安全性分析集进行描述性汇总；本研究不进行确证性假设检验。","rationale":"研究定义明确确认了以下设计事实：多中心、随机、双盲、安慰剂平行对照、II期、PoC与剂量探索；四组1:1:1:1随机；SGC-R1L3 2.5/5/10mg口服每日一次×12周；安慰剂外观匹配；背景GDMT维持；研究时期三段划分；V1至V8访视安排；无自适应/无样本量再估计/无期中分析/无SRC/无DMC；FAS分析集；ANCOVA方法；无确证性假设检验。本章节未写入盲态具体覆盖人员范围（来源未明确），未写入随机化具体方法（如区组大小、分层因素），未写入剂量递增与安全性暂停规则的具体操作细节。医学经理需确认：随机化方法（区组随机、分层因素）；剂量递增与安全性暂停规则的具体操作；盲态覆盖范围。","review_advisories":["本节复述高影响研究设计（研究设计）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、期中分析、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3ea77adeef20_503343cf8d9f8475","section_number":"4","source_ids":["protocol_full_draft_selection:50df81523667dae6d7ef9c99","current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7"]},{"ai_run_id":"airun_20261002201546_0a7f544f","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_3ea77adeef20_fe65ac8ebe5656d4:full-draft:50df81523667dae6d7ef9c99","quote":"随机化；双盲；安慰剂对照；平行组；多中心","quote_sha256":"2390eec78cb63fbb744f4d0cd34ca9e3a52cae7420fe7f7e88f4c2d12a283514","source_id":"protocol_full_draft_selection:50df81523667dae6d7ef9c99","span_id":"es_004"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"多中心、随机、双盲、安慰剂平行对照的II期概念验证与剂量探索研究：SGC-R1L3设低/中/高三个剂量组与安慰剂组平行对照，主要评价12周NT-proBNP较基线变化与安全性及耐受性。","quote_sha256":"2fe59c354b666a3565668a5f6963781f09e0c0fe0d693564b9ddcb6937afb2f7","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_003"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"安慰剂平行对照：安慰剂片外观与SGC-R1L3一致，口服每日一次×12周；各组按1:1:1:1随机；背景GDMT按指南维持稳定。","quote_sha256":"18bd521518a771fcdaed24de887d692e5182772e194bee6a4dfc7be85b0c0bf0","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_006"},{"locator":"study_definition:mwdefinition_37371f37a7aa3367e47a:revision:4","quote":"试验组与对照组：SGC-R1L3低剂量组；SGC-R1L3中剂量组；SGC-R1L3高剂量组；安慰剂对照组","quote_sha256":"ea4833f625f8baedb8a5c5bc32677cc27d6787edb6c5dc36877059e5d1655f8e","source_id":"current_project_study_definition:mwdefinition_37371f37a7aa3367e47a:r4:d791f4ccd862320e","span_id":"es_010"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004","es_003","es_006","es_010"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"由医学经理确认盲态覆盖的具体人员范围","category":"source_missing","gap_id":"gap_sec41_blinding_scope","missing_source_classes":["盲法管理规程"],"target":"双盲的盲态覆盖范围（哪些人员保持盲态）"},{"action":"由医学经理与运营团队确认参与中心数量及分布","category":"source_missing","gap_id":"gap_sec41_center_count","missing_source_classes":["研究中心清单"],"target":"多中心的具体中心数量与地理分布"}],"heading":"总体设计","missing_source_classes":[],"proposal_text":"本研究总体设计为随机化、双盲、安慰剂对照、平行组、多中心设计。研究在中国多中心开展，采用平行组分配模型，设SGC-R1L3低剂量组、中剂量组、高剂量组及安慰剂对照组共四个平行治疗组，各组按1:1:1:1比例随机分配。SGC-R1L3为口服薄膜衣片，每日一次给药，连续治疗12周；安慰剂片外观与SGC-R1L3一致，口服每日一次，疗程12周。研究为双盲设计，安慰剂与活性药物外观匹配。本研究不采用自适应设计，不进行样本量再估计，不设置期中分析，不设立独立数据监查委员会或安全审查委员会。","rationale":"章节包中已确认总体设计关键词为随机化、双盲、安慰剂对照、平行组、多中心。研究定义进一步确认了平行组分配模型、多中心模式、四组1:1:1:1随机、双盲安慰剂对照、无自适应/无期中分析/无DMC/SRC等设计要素。本章节仅写入已确认的设计结构事实，未指定盲态覆盖的具体人员范围（来源未明确），未重复主要终点、样本量、剂量数值等已在其他章节覆盖的信息。医学经理需确认：双盲的盲态覆盖范围；多中心的具体中心数量与分布；是否需要在总体设计中提及剂量递增策略。","review_advisories":["本节复述高影响研究设计（总体设计）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（期中分析、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3ea77adeef20_7d2bfc3d37e7214f","section_number":"4.1","source_ids":["protocol_full_draft_selection:50df81523667dae6d7ef9c99","current_project_study_definition:mwde