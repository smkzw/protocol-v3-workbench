4124155efa83d1","source_id":"current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","span_id":"es_07"},{"locator":"study_definition:mwdefinition_85e9e75916689ebcb0bc:revision:6","quote":"低剂量2.5 mg qd、中剂量5 mg qd、高剂量10 mg qd，每日晨起随餐口服","quote_sha256":"c49c792999033af8f77f3ec75c98e2dfa9cfd9061a5530db2af10d0a2bd0d970","source_id":"current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","span_id":"es_08"},{"locator":"study_definition:mwdefinition_85e9e75916689ebcb0bc:revision:6","quote":"每组约60例（共约240例），基于NT-proBNP组间差值文献效应量与80%把握度估算","quote_sha256":"33ed4b4d92083c9ac0a37e522f029b37f5337e3c35d2b79c6d4affe26b9a328f","source_id":"current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","span_id":"es_09"},{"locator":"study_definition:mwdefinition_85e9e75916689ebcb0bc:revision:6","quote":"按1:1:1:1随机分配","quote_sha256":"72c25373ccda39d122959ebb009159ca899766d2229de691c823ffd82e374382","source_id":"current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","span_id":"es_11"},{"locator":"study_definition:mwdefinition_85e9e75916689ebcb0bc:revision:6","quote":"双盲双模拟，治疗期12周，联合标准GDMT背景治疗","quote_sha256":"0050af534b4e6f7a88a0a53a943d9d0b14495b549d1c00490ef7fa377dba8ca6","source_id":"current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","span_id":"es_12"}],"evidence_review_advisories":[],"evidence_span_ids":["es_06","es_07","es_08","es_09","es_11","es_12"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[],"heading":"研究设计","missing_source_classes":[],"proposal_text":"本研究为随机、双盲、安慰剂对照、平行组、多中心II期临床研究，旨在对SMOKE-r8-1Z口服sGC刺激剂（KZ-sGC801）进行概念验证和剂量探索。研究纳入18至75岁慢性稳定性射血分数降低的心力衰竭成人患者，要求左室射血分数不超过40%、纽约心功能分级II至III级，且筛选前已接受稳定剂量指南导向药物治疗至少4周仍有症状。受试者按1:1:1:1比例随机分配至KZ-sGC801低剂量2.5 mg每日一次、中剂量5 mg每日一次、高剂量10 mg每日一次及安慰剂组，各组均联合标准指南导向药物治疗背景。试验药与安慰剂采用双盲双模拟设计，每日晨起随餐口服，治疗期共12周。研究采用治疗策略估计目标，无论是否发生剂量调整或合并用药变化，均按随机分组进行分析。样本量策略为每组约60例、共约240例，基于NT-proBNP组间差值文献效应量与80%把握度估算，用于概念验证与剂量选择。","rationale":"研究设计要素（随机、双盲、安慰剂对照、平行组、多中心）、目标人群（18-75岁、LVEF≤40%、NYHA II-III级、稳定GDMT≥4周）、剂量方案（2.5/5/10 mg qd）、随机比例（1:1:1:1）、双盲双模拟、治疗期12周、估计目标策略及样本量（每组约60例共约240例）均来源于当前项目已确认研究事实。剂量调整的具体触发条件和幅度需医学经理进一步确认。","review_advisories":["本节复述高影响研究设计（研究设计）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（估计目标、剂量选择、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d85288693b_866321b871a21d23","section_number":"4","source_ids":["protocol_full_draft_selection:3e66f23b3daac17ff76d513e","current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7"]},{"ai_run_id":"airun_20261006224629_18382cd8","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_d1d85288693b_a838e57fe61b2889:full-draft:3e66f23b3daac17ff76d513e","quote":"随机化；双盲；安慰剂对照；平行组；多中心","quote_sha256":"2390eec78cb63fbb744f4d0cd34ca9e3a52cae7420fe7f7e88f4c2d12a283514","source_id":"protocol_full_draft_selection:3e66f23b3daac17ff76d513e","span_id":"es_10"},{"locator":"study_definition:mwdefinition_85e9e75916689ebcb0bc:revision:6","quote":"按1:1:1:1随机分配","quote_sha256":"72c25373ccda39d122959ebb009159ca899766d2229de691c823ffd82e374382","source_id":"current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","span_id":"es_11"},{"locator":"study_definition:mwdefinition_85e9e75916689ebcb0bc:revision:6","quote":"双盲双模拟，治疗期12周，联合标准GDMT背景治疗","quote_sha256":"0050af534b4e6f7a88a0a53a943d9d0b14495b549d1c00490ef7fa377dba8ca6","source_id":"current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","span_id":"es_12"},{"locator":"study_definition:mwdefinition_85e9e75916689ebcb0bc:revision:6","quote":"筛选期（第-28至-1天）；12周双盲治疗期（第0天随机给药至第12周）；治疗结束访视（第12周±3天）；安全随访期（末次给药后2周）","quote_sha256":"5924fd45b8339b1c52b01639db5e51cbbbf002d523b6fdc64f2a94e12b50160e","source_id":"current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","span_id":"es_13"},{"locator":"study_definition:mwdefinition_85e9e75916689ebcb0bc:revision:6","quote":"V0筛选（-28~-1d）：病史、查体、ECHO、实验室、NT-proBNP、ECG","quote_sha256":"90111573aff2e6c1b9e0788dc8223f116513fc23252ef181c835c23c89de487a","source_id":"current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","span_id":"es_14"}],"evidence_review_advisories":[],"evidence_span_ids":["es_10","es_11","es_12","es_13","es_14"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[],"heading":"总体设计","missing_source_classes":[],"proposal_text":"本研究总体设计为随机化、双盲、安慰剂对照、平行组、多中心。研究时期包括：筛选期（第-28至-1天）、12周双盲治疗期（第0天随机给药至第12周）、治疗结束访视（第12周±3天）及安全随访期（末次给药后2周）。访视安排如下：V0筛选访视（第-28至-1天）完成病史采集、体格检查、超声心动图、实验室检查、NT-proBNP检测和心电图；V1随机入组访视（第0天）完成随机化与首次给药；V2（第4周）和V3（第8周）进行疗效与安全性评价；V4治疗结束访视（第12周±3天）进行主要终点评价与全面安全性评估；V5安全随访访视（第14周）确认不良事件转归。各组按1:1:1:1比例随机分配，采用双盲双模拟设计，治疗期12周，联合标准指南导向药物治疗背景。","rationale":"总体设计要素（随机化、双盲、安慰剂对照、平行组、多中心）来源于章节包已确认内容。研究时期划分、访视策略（V0至V5各访视内容与时间点）、1:1:1:1随机分配、双盲双模拟及12周治疗期均来源于当前项目已确认研究事实。各访视中具体检查项目的实施频率和范围需医学经理确认。","review_advisories":["本节复述高影响研究设计（总体设计）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d85288693b_b3afa3aa46a8ace9","section_number":"4.1","source_ids":["protocol_full_draft_selection:3e66f23b3daac17ff76d513e","current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus