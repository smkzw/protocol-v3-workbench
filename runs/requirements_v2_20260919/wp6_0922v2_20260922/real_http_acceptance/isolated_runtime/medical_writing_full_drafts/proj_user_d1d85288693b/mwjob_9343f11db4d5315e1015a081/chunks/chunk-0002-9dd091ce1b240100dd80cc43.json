user_d1d85288693b_a0bd2f3bd9b66715","section_number":"2.3.2","source_ids":["protocol_full_draft_selection:9dd091ce1b240100dd80cc43","current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261006224443_7975811c","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_85e9e75916689ebcb0bc:revision:6","quote":"总体研究设计：随机、双盲、安慰剂对照、平行组、多中心；II期概念验证+剂量探索，KZ-sGC801三个剂量组与安慰剂对照，治疗12周","quote_sha256":"f2a8e631e4a1175a229080400575878cbefbeff94b7875de0b1db53530513ee3","source_id":"current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","span_id":"es_002"},{"locator":"study_definition:mwdefinition_85e9e75916689ebcb0bc:revision:6","quote":"主要终点：第12周NT-proBNP较基线的百分比变化（双盲期）。评价时间点：基线、第4/8/12周。","quote_sha256":"ed3fdeeb458362e8ec2062ccfdb54dabe86146616d3c09971d19582407bead01","source_id":"current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","span_id":"es_003"},{"locator":"study_definition:mwdefinition_85e9e75916689ebcb0bc:revision:6","quote":"安全性终点：不良事件与严重不良事件发生率；症状性低血压与体位性低血压；生命体征（血压、心率）；肝肾功能、电解质实验室指标；12导联心电图","quote_sha256":"e77501ca084e2f1e9fa18684d494f2252570a19a158da14e097274f13b01fb6b","source_id":"current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","span_id":"es_004"},{"locator":"study_definition:mwdefinition_85e9e75916689ebcb0bc:revision:6","quote":"18-75岁慢性稳定性HFrEF，LVEF≤40%，NYHA II-III级，稳定GDMT≥4周仍症状未控制","quote_sha256":"3ac485ff080268cf4b0affa7c418f540443b3c1df84866d1c34124155efa83d1","source_id":"current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","span_id":"es_005"},{"locator":"study_definition:mwdefinition_85e9e75916689ebcb0bc:revision:6","quote":"SMOKE-r8-1Z口服sGC刺激剂（KZ-sGC801）：低剂量2.5 mg qd、中剂量5 mg qd、高剂量10 mg qd，每日晨起随餐口服；每4周随访评估耐受性，按方案规定剂量调整。","quote_sha256":"a0dec051541fa5b9eac3b31a83a66c2076a7d84d7af603ebe93ee7739564044d","source_id":"current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","span_id":"es_006"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003","es_004","es_005","es_006"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"由医学经理提供或确认KZ-sGC801作用机制的准确描述及支持文献，核实是否可泛化sGC刺激剂类效应。","category":"source_missing","gap_id":"gap_2_4_001","missing_source_classes":["药物作用机制文献","非临床药效学数据"],"target":"2.4节中sGC-cGMP通路在HFrEF中的具体作用机制描述"},{"action":"补充NT-proBNP在HFrEF II期试验中作为替代/生物标志物终点的监管接受度与文献支持。","category":"source_missing","gap_id":"gap_2_4_002","missing_source_classes":["替代终点文献","监管指南"],"target":"2.4节中NT-proBNP作为主要终点的文献依据"}],"heading":"本研究的理论基础","missing_source_classes":["sGC刺激剂在HFrEF中的病理生理机制文献","KZ-sGC801非临床药效学与毒理学数据","NT-proBNP作为HFrEF替代终点的文献依据"],"proposal_text":"本研究为II期概念验证与剂量探索研究，其理论基础建立在以下已确认的设计逻辑之上。第一，KZ-sGC801为口服可溶性鸟苷酸环化酶（sGC）刺激剂，以每日一次口服固体制剂给药，通过系统暴露发挥全身性药理作用，其治疗靶点为射血分数降低的心力衰竭（HFrEF）的病理生理通路。第二，本研究采用随机、双盲、安慰剂对照、平行组、多中心设计，设置KZ-sGC801低剂量（2.5 mg）、中剂量（5 mg）、高剂量（10 mg）三个活性剂量组及安慰剂组，按1:1:1:1比例随机分配，治疗期12周，旨在同时完成概念验证与剂量范围探索。第三，目标人群限定为18至75岁慢性稳定性HFrEF成人，左室射血分数不超过40%，心功能NYHA II至III级，且筛选前已接受稳定剂量指南导向药物治疗（GDMT）至少4周仍症状未控制，以排除急性失代偿期干扰并聚焦残余症状改善。第四，主要疗效评价采用第12周N末端B型利钠肽前体（NT-proBNP）较基线的百分比变化，评价时间点为基线、第4周、第8周和第12周，该生物标志物在双盲期内采集，用于反映心脏壁应力负荷的改善。第五，安全性评估涵盖不良事件与严重不良事件发生率、症状性低血压与体位性低血压、生命体征（血压、心率）、肝肾功能及电解质实验室指标、12导联心电图，每4周随访评估耐受性。第六，统计分析以全分析集（FAS）为主要分析集，主要终点采用协方差分析（ANCOVA，基线校正）并检验剂量-反应趋势，估计目标策略为治疗策略（treatment policy），即无论是否发生剂量调整或合并用药变化均按随机分组分析。上述设计要素共同构成本研究从概念验证向后续确证性研究过渡的方法学基础。","rationale":"本节正文基于当前项目已确认研究事实（研究设计、药物技术类型、给药途径、剂量方案、目标人群、主要终点、安全性终点、统计策略）撰写。sGC刺激剂在HFrEF中的具体作用机制描述、非临床药效学与毒理学数据、以及NT-proBNP作为替代终点的文献依据在允许来源中未提供，需医学经理核实机制表述准确性并补充文献支撑。","review_advisories":["本节提及高影响设计信息（主要终点、估计目标）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d85288693b_0451bb2737afe83d","section_number":"2.4","source_ids":["protocol_full_draft_selection:9dd091ce1b240100dd80cc43","current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261006224443_7975811c","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_85e9e75916689ebcb0bc:revision:6","quote":"总体研究设计：随机、双盲、安慰剂对照、平行组、多中心；II期概念验证+剂量探索，KZ-sGC801三个剂量组与安慰剂对照，治疗12周","quote_sha256":"f2a8e631e4a1175a229080400575878cbefbeff94b7875de0b1db53530513ee3","source_id":"current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","span_id":"es_002"},{"locator":"study_definition:mwdefinition_85e9e75916689ebcb0bc:revision:6","quote":"主要终点：第12周NT-proBNP较基线的百分比变化（双盲期）。评价时间点：基线、第4/8/12周。","quote_sha256":"ed3fdeeb458362e8ec2062ccfdb54dabe86146616d3c09971d19582407bead01","source_id":"current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","span_id":"es_003"},{"locator":"study_definition:mwdefinition_85e9e75916689ebcb0bc:revision:6","quote":"安全性终点：不良事件与严重不良事件发生率；症状性低血压与体位性低血压；生命体征（血压、心率）；肝肾功能、电解质实验室指标；12导联心电图","quote_sha256":"e77501ca084e2f1e9fa18684d494f2252570a19a158da14e097274f13b01fb6b","source_id":"current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","span_id":"es_004"},{"locator":"study_definition:mwdefinition_85e9e75916689ebcb0bc:revision:6","quote":"18-75岁慢性稳定性HFrEF，LVEF≤40%，NYHA II-III级，稳定GDMT≥4周仍症状未控制","quote_sha256":"3ac485ff080268cf4b0affa7c418f540443b3c1df84866d1c34124155efa83d1","source_id":"current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","span_id":"es_005"},{"locator":"study_definition:mwdefinition_85e9e75916689ebcb0bc:revision:6","quote":"SMOKE-r8-1Z口服sGC刺激剂（KZ-sGC801）：低剂量2.5 mg qd、中剂量5 mg qd、高剂量10 mg qd，每日晨起随餐口服；每4周随访评估耐受性，按方案规定剂量调整。","quote_sha256":"a0dec051541fa5b9eac3b31a83a66c2076a7d84d7af603ebe93ee7739564044d","source_id":"current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","span_id":"es_006"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003","es_004","es_005","es_006"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"由医学经理确认是否设置次要终点及具体定义，当前允许来源未提供。","category":"source_missing","gap_id":"gap_3_001","missing_source_classes":["次要终点定义","量表选择依据"],"target":"3节中次要终点（如6分钟步行距离、NT-proBNP绝对变化、心衰住院率、DLQI等）"},{"action":"确认是否设置PK采样及采样时间点，当前来源未涉及。","category":"source_missing","gap_id":"gap_3_002","missing_source_classes":["药代动力学研究计划"],"target":"3节中药代动力学采样时间点与PK/PD分析计划"}],"heading":"研究目的和终点","missing_source_classes":["次要终点定义","药代动力学采样计划","患者报告结局量表选择"],"proposal_text":"本研究的内在研究目的为概念验证（PoC）与剂量探索，旨在通过随机、双盲、安慰剂对照、平行组、多中心设计，在18至75岁慢性稳定性HFrEF成人（LVEF≤40%，NYHA II-III级，稳定GDMT≥4周仍症状未控制）中，评估KZ-sGC801三个剂量水平（2.5 mg、5 mg、10 mg每日一次口服）联合标准GDMT背景治疗12周的疗效信号与安全性特征，为后续确证性研究的剂量选择与方案设计提供依据。主要疗效终点为第12周NT-proBNP较基线的百分比变化（双盲期），评价时间点为基线、第4周、第8周和第12周。安全性终点包括不良事件与严重不良事件发生率、症状性低血压与体位性低血压、生命体征（血压、心率）、肝肾功能及电解质实验室指标、12导联心电图。本研究不设置探索性目的或探索性终点。","rationale":"本节正文依据当前项目已确认研究事实撰写：内在研究目的（PoC+剂量探索）、主要终点（第12周NT-proBNP百分比变化）、安全性终点（AE/SAE、低血压、生命体征、实验室、ECG）、评价时间点（基线/第4/8/12周）、目标人群与剂量方案。探索性目的与终点未在项目事实中设置，按指令明确声明不设置。次要终点、药代动力学终点、患者报告结局等若需设置，当前无来源支持，未写入正文。","review_advisories":["本节复述高影响研究设计（研究目的和终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（剂量选择）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d85288693b_4cf451ac49bc0290","section_number":"3","source_ids":["protocol_full_draft_selection:9dd091ce1b240100dd80cc43","current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261006224443_7975811c","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_85e9e75916689ebcb0bc:revision:6","quote":"主要终点：第12周NT-proBNP较基线的百分比变化（双盲期）。评价时间点：基线、第4/8/12周。","quote_sha256":"ed3fdeeb458362e8ec2062ccfdb54dabe86146616d3c09971d19582407bead01","source_id":"current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","span_id":"es_003"},{"locator":"study_definition:mwdefinition_85e9e75916689ebcb0bc:revision:6","quote":"总体研究设计：随机、双盲、安慰剂对照、平行组、多中心；II期概念验证+剂量探索，KZ-sGC801三个剂量组与安慰剂对照，治疗12周","quote_sha256":"f2a8e631e4a1175a229080400575878cbefbeff94b7875de0b1db53530513ee3","source_id":"current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","span_id":"es_002"}],"evidence_review_advisories":[],"evidence_span_ids":["es_003","es_002"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[],"heading":"主要目的和主要终点","missing_source_classes":[],"proposal_text":"本研究的主要目的为评估KZ-sGC801在慢性稳定性HFrEF成人中12周治疗期内对心脏壁应力负荷的改善作用，并探索剂量-反应关系。主要终点为第12周NT-proBNP较基线的百分比变化（双盲期）。NT-proBNP的采集与评价时间点为基线（随机入组前）、第4周、第8周和第12周。主要分析采用全分析集（FAS），以协方差分析（ANCOVA）模型校正基线NT-proBNP水平，比较各活性剂量组与安慰剂组在第12周NT-proBNP百分比变化上的组间差异，并检验剂量-反应趋势。估计目标策略为治疗策略（treatment policy），即无论是否发生剂量调整或合并用药变化，均按随机分组进行分析；终点前事件按复合策略处理。","rationale":"本节正文完全基于当前项目已确认研究事实：主要终点定义（第12周NT-proBNP较基线百分比变化，双盲期）、评价时间点（基线/第4/8/12周）、分析集（FAS）、统计方法（ANCOVA基线校正+剂量-反应趋势检验）、估计目标策略（treatment policy）。需医学经理确认NT-proBNP作为主要终点的监管接受度及12周观察期是否充分。","review_advisories":["本节复述高影响研究设计（主要目的和主要终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、估计目标）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d85288693b_c20798ba0dcbb897","section_number":"3.1","source_ids":["protocol_full_draft_selection:9dd091ce1b240100dd80cc43","current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]}],"source_bindings":[{"content_sha256":"3ea5fd1a59c3cf00039ff4eef6a79b7743c8264b087d0c04ae1e834fbc405b09","locator":"document:mwdoc_greenfield_proj_user_d1d85288693b_a838e57fe61b2889:full-draft:9dd091ce1b240100dd80cc43","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:9dd091ce1b240100dd80cc43","source_type":"protocol_full_draft_selection","source_version":"full-draft:fd463f1e1aabd0939611ea1f881293f2dd4287c62c723b23e502df51e482ae63:9dd091ce1b240100dd80cc43","text_sha256":"3ea5fd1a59c3cf00039ff4eef6a79b7743c8264b087d0c04ae1e834fbc405b09"},{"content_sha256":"b036bde80121c06c57dcfdf83f7ae3751ec2f4bfe3589a049a6d637f8b7736af","locator":"study_definition:mwdefinition_85e9e75916689ebcb0bc:revision:6","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","source_type":"current_project_study_definition","source_version":"mwdefinition_85e9e75916689ebcb0bc:r6:8c60321e314f81b1","text_sha256":"b036bde80121c06c57dcfdf83f7ae3751ec2f4bfe3589a049a6d637f8b7736af"},{"content_sha256":"dfc9fceb41db9d941df0e3715483adaa069da4f19536