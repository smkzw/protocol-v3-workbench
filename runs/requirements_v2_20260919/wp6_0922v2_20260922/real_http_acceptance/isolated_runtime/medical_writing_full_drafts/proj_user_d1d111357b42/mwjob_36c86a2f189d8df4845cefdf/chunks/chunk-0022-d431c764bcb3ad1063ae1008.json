vidence_review_advisories":[],"evidence_span_ids":["es_primary","es_exclusion","es_safety","es_tea","es_visit"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"获取本项目完整实验室检查项目清单及各访视采集时点安排","category":"source_missing","gap_id":"gap_lab_01","missing_source_classes":["完整实验室检查项目清单","各访视实验室采集时点"],"target":"14.2 实验室检查项目"},{"action":"确认中心实验室与本地实验室分工及正常值范围","category":"source_missing","gap_id":"gap_lab_02","missing_source_classes":["中心实验室与本地实验室分工","实验室正常值范围"],"target":"14.2 实验室检查项目"}],"heading":"实验室检查项目","missing_source_classes":["完整实验室检查项目清单","各访视实验室采集时点","中心实验室与本地实验室分工","实验室正常值范围"],"proposal_text":"本方案主要疗效终点为第12周NT-proBNP较基线百分比变化，该指标由中心实验室检测，访视窗为±7天。筛选期需评估eGFR，eGFR低于30 mL/min/1.73m²的受试者不得入组。安全性评估中，第0周、第4周和第12周需监测体位性低血压与收缩压变化。访视安排包括筛选期（D-14至D-1）、随机化访视（D0）、第4周、第8周、第12周访视以及治疗结束与安全性随访访视。上述实验室检测项目的具体采集时点、完整检查清单、中心实验室与本地实验室分工及正常值范围，需依据项目实验室操作手册和访视计划表进一步确认。","rationale":"研究定义已确认NT-proBNP由中心实验室检测（访视窗±7天）、eGFR<30为排除标准、体位性低血压与收缩压在第0/4/12周监测、访视策略包含筛选至安全性随访。但完整实验室检查项目清单（血常规、肝肾功能、电解质、凝血、尿常规等）、各访视具体采集时点、中心与本地实验室分工及正常值范围缺少项目来源，需医学经理核对后补全。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d111357b42_f5132fc07cd8c63a","section_number":"14.2","source_ids":["protocol_full_draft_selection:d431c764bcb3ad1063ae1008","current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b"]}],"source_bindings":[{"content_sha256":"f06607d7bfae2b1959ead80b2b901642b3c6bcb3982349f5c5fa5eff0c2463d5","locator":"document:mwdoc_greenfield_proj_user_d1d111357b42_cb40af386f90d99b:full-draft:d431c764bcb3ad1063ae1008","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:d431c764bcb3ad1063ae1008","source_type":"protocol_full_draft_selection","source_version":"full-draft:3b2e251e11bb8cba8063752ef5c824857036f2d4a6568821606758be43b3b1f2:d431c764bcb3ad1063ae1008","text_sha256":"f06607d7bfae2b1959ead80b2b901642b3c6bcb3982349f5c5fa5eff0c2463d5"},{"content_sha256":"e49aa119f