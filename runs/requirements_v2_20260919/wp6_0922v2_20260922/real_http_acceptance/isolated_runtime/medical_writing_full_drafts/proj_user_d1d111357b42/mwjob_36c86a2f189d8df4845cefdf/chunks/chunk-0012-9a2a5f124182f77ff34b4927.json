on_66d98f3917295e20f566:revision:4","quote":"特别关注的不良事件：TEAE发生率与严重程度（MedDRA 27.0）；第0、4、12周体位性低血压与收缩压变化","quote_sha256":"f308c4e2dc4f61c3f077cae43d91833eb183f9081fb2e6e4e527401832a77780","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_sbp_safety"},{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"访视策略：筛选（D-14至D-1）、随机（D0）、W4/W8/W12访视、治疗结束与安全性随访","quote_sha256":"a53b5791ef0f5c3ccd63f1e987c1b5fca5ded6592d101be5ebe5ecd24ec86f6e","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_visit_strategy"}],"evidence_review_advisories":[],"evidence_span_ids":["es_ntprobnp_endpoint","es_egfr_exclusion","es_sbp_safety","es_visit_strategy"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"补充完整实验室检查项目清单及各访视具体检测安排","category":"source_missing","gap_id":"gap_lab_panel","missing_source_classes":["实验室检查计划表","访视操作手册"],"target":"7.3.3 实验室检查"}],"heading":"实验室检查","missing_source_classes":["实验室检查计划表","访视操作手册"],"proposal_text":"本研究在筛选期进行肾功能评估，血清肌酐及估算肾小球滤过率（eGFR）用于判断受试者是否满足入组条件，eGFR低于30 mL/min/1.73m²者不得入组。主要疗效终点NT-proBNP由中心实验室统一检测，基线值在随机化前采集，第12周值在访视窗±7天内采集，用于计算较基线百分比变化。收缩压于随机化日（D0）、第4周（W4）和第12周（W12）访视时测量，用于评估体位性低血压及收缩压变化趋势。上述检测项目的具体采血时点、是否需空腹、中心实验室与本地实验室的分工、以及各访视是否还需进行血常规、肝功能、电解质、凝血功能等其他实验室检查，需依据完整访视操作手册和实验室检查计划表确定。","rationale":"NT-proBNP中心实验室检测及±7天访视窗、eGFR<30排除标准、D0/W4/W12收缩压评估均来源于当前项目已确认研究事实。完整实验室检查项目清单及各访视具体安排未在允许来源中列出，需医学经理结合访视操作手册和实验室检查计划表补充确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d111357b42_3cccdda60735f1db","section_number":"7.3.3","source_ids":["protocol_full_draft_selection:9a2a5f124182f77ff34b4927","current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b"]},{"ai_run_id":"airun_20261001011230_63afe700","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"排除标准模块：筛选前6个月内急性心肌梗死、不稳定型心衰或卒中；收缩压<90mmHg；eGFR<30mL/min/1.73m²；妊娠或哺乳期；30天内使用过其他sGC激动剂或PDE5抑制剂","quote_sha256":"00eedca3c214010b6188381ed829bba469eed145f0d64272cdc2c8a954db024e","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_preg_exclusion"}],"evidence_review_advisories":[],"evidence_span_ids":["es_preg_exclusion"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[{"action":"补充妊娠检查方法、检测时点、避孕问询流程及推荐避孕措施","category":"source_missing","gap_id":"gap_preg_method","missing_source_classes":["妊娠检查与避孕管理实施规程"],"target":"7.3.4 妊娠检查和避孕问询"}],"heading":"妊娠检查和避孕问询","missing_source_classes":["妊娠检查与避孕管理实施规程"],"proposal_text":"妊娠或哺乳期女性不得入组本研究。筛选期需确认育龄期女性受试者非妊娠且非哺乳期状态，具体妊娠检查方法、检测时点、避孕问询流程及推荐避孕措施将在方案实施文件中明确。","rationale":"妊娠或哺乳期女性为排除标准来源于当前项目已确认研究事实。妊娠检查方法、避孕问询具体流程及避孕方法未在允许来源中明确，不得由排除标准推断具体实施规则，需医学经理依据项目安全性管理计划确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d111357b42_b97f458be630f7ed","section_number":"7.3.4","source_ids":["protocol_full_draft_selection:9a2a5f124182f77ff34b4927","current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b"]},{"ai_run_id":"airun_20261001011230_63afe700","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"特别关注的不良事件：TEAE发生率与严重程度（MedDRA 27.0）；第0、4、12周体位性低血压与收缩压变化","quote_sha256":"f308c4e2dc4f61c3f077cae43d91833eb183f9081fb2e6e4e527401832a77780","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_teae_safety"},{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"安全性终点：第12周6分钟步行距离较基线变化","quote_sha256":"deb2625f8c922a57be11b498fa95e3cb111bfc22077ea36c08d1c7972f5e0353","source_id":"current_project_study_definition:mwdef