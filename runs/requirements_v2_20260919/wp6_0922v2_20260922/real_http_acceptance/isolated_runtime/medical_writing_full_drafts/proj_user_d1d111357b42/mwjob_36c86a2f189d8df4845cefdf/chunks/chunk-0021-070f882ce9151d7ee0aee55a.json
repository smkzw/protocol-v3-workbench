609b7dbe55eeebdf04f2def91dbe2a8f33b58d692f3d04a9bb87b739cf","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_project_def"},{"locator":"section:12.4 管理结构|block:957|chunk:1","quote":"申办者或其代理人将执行项目管理、研究管理、监查、供应商管理和统计编程。可使用IWRS进行参与者筛查和随机分组，以及研究药物申请和运输的管理。研究中心将负责生物样品在运输至申办者或其指定分析单位之前的保存。数据将使用eCRFs通过EDC系统记录，或以电子方式转发给申办者（例如，药代动力学数据）。","quote_sha256":"6c7271f4ed3fd8fedd8e75159484480005fc72345847383d098e28d5130237d6","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","span_id":"es_roles_corpus"},{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"中心模式：多中心","quote_sha256":"2cfa68bc992967c797bbd3113b5e0d0844d660a2050095a31f08358c5e40311f","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_multicenter"}],"evidence_review_advisories":[],"evidence_span_ids":["es_project_def","es_roles_corpus","es_multicenter"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":2},"gap_items":[{"action":"获取本项目组织架构图及角色职责分工文件，明确医学监查员、数据管理员、药物安全专员等具体角色","category":"source_missing","gap_id":"gap_roles_01","missing_source_classes":["项目组织架构图","角色职责分工文件"],"target":"12.5 关键角色和研究管理"},{"action":"确认本项目是否使用IWRS及EDC系统，获取供应商管理范围文件","category":"source_not_retrieved","gap_id":"gap_roles_02","missing_source_classes":["供应商管理清单","IWRS/EDC系统确认文件"],"target":"12.5 关键角色和研究管理"}],"heading":"关键角色和研究管理","missing_source_classes":["项目组织架构图","角色职责分工文件","供应商管理清单"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂对照、平行组II期剂量探索研究，在中国开展。申办者或其委托的临床试验机构负责项目管理、研究管理、监查、供应商管理和统计编程。受试者筛选与随机分组通过交互式网络应答系统完成，研究药物的申请与运输亦由该系统管理。研究中心负责生物样品在运输至申办者或其指定分析单位之前的保存。研究数据通过电子数据采集系统以电子病例报告表形式记录，或以电子方式转发给申办者。各研究中心的主要研究者负责本中心的研究实施、受试者安全及数据真实性。","rationale":"多中心设计由项目定义确认。IWRS用于筛选和随机分组、eCRF/EDC数据记录及生物样品保存职责参照公司语料中II期方案管理结构（CMD-D001-AD 12.4节），属监管共性结构参照而非本项目已确认实施事实。医学经理需确认：本项目是否实际使用IWRS及EDC系统，以及各角色的具体职责边界和供应商管理范围。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"revie