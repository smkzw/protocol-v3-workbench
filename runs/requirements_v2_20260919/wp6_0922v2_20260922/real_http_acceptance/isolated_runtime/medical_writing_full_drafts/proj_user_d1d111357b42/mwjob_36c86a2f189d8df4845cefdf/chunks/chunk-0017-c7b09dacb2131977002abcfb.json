c922a57be11b498fa95e3cb111bfc22077ea36c08d1c7972f5e0353","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_003"},{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"安全性随访期（末次给药后14天）","quote_sha256":"7f5b5fc8f8745b4f595a7ee16edbe77b147ea8925b916b7366c74eaf446d3eca","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_004"},{"locator":"section:8 统计学考虑|block:1056|chunk:1","quote":"有效性评价、安全性评价、PK 评价、PD 评价、免疫原性评价以及其他分析将在本研究的统计分析计划（SAP）中详细规定，数据库锁定前将最终确定 SAP。","quote_sha256":"a635fe9c51c78cbc66090c3553c488cd453e807e61608a97e0767740d5088a03","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","span_id":"es_005"}],"evidence_review_advisories":[],"evidence_span_ids":["es_001","es_002","es_003","es_004","es_005"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":4},"gap_items":[{"action":"补充本项目安全性事件定义与报告规程，或确认是否沿用ICH E2A加速报告标准","category":"source_missing","gap_id":"gap_safety_001","missing_source_classes":["AE/SAE/SUSAR定义与报告流程文件"],"target":"安全性数据分析章节中AE/SAE/SUSAR定义、报告对象与时限、报告流程"},{"action":"补充本项目剂量调整与停药决策规则","category":"source_missing","gap_id":"gap_safety_002","missing_source_classes":["剂量调整与停药规则"],"target":"安全性数据分析章节中剂量调整、暂停、恢复及永久停药规则"},{"action":"补充本项目药物过量与给药错误处理流程","category":"source_missing","gap_id":"gap_safety_003","missing_source_classes":["药物过量与给药错误处理规程"],"target":"安全性数据分析章节中药物过量与给药错误处理"},{"action":"补充本项目保险赔偿条款","category":"source_missing","gap_id":"gap_safety_004","missing_source_classes":["保险赔偿与受试者损害补偿条款"],"target":"安全性数据分析章节中保险赔偿与受试者损害补偿"}],"heading":"安全性数据分析","missing_source_classes":["AE/SAE/SUSAR定义与报告流程文件","剂量调整与停药规则","试验药包装储存与发放回收规程","保险赔偿与受试者损害补偿条款"],"proposal_text":"安全性数据在安全性分析集（SS）中进行描述性统计分析。SS定义为至少接受一次研究药物（SGC-R21或安慰剂）的随机化受试者。不良事件按MedDRA 27.0版本进行系统器官分类和首选术语编码，报告各治疗组不良事件的发生率、严重程度及与药物的因果关系判定。特别关注的不良事件包括体位性低血压和收缩压变化，在随机化当日（D0）、第4周（W4）和第12周（W12）访视时采集并分析。安全性终点为第12周6分钟步行距离较基线变化，在SS中以描述统计呈现各组均值、标准差及95%置信区间。安全性随访期为末次给药后14天，该期间内新发或持续的不良事件纳入安全性分析。主要分析集（FAS）与安全性分析集（SS）分别定义，具体分析集划分规则及亚组分析策略在统计分析计划中最终确定，统计分析计划于数据库锁定前完成定稿。","rationale":"安全性描述统计方法、FAS与SS分析集定义、MedDRA 27.0编码、体位性低血压与收缩压评估时点（D0/W4/W12）、6MWD安全性终点及14天安全性随访期均来源于当前项目已确认研究事实。SAP于数据库锁定前确定的表述参照公司语料中其他研究的结构惯例，本项目是否采用相同机制需确认。AE/SAE/SUSAR具体定义、报告时限与流程、剂量调整规则、保险赔偿等实施细节缺少本项目来源，未写入正文。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d111357b42_89ea5f8a970c1dd7","section_number":"9.5","source_ids":["protocol_full_draft_selection:c7b09dacb2131977002abcfb","current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","company_corpus:cms_cn_protocol_corpus_20260715_v1:20561fabeffbb0","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:256bd99fe3c436","company_corpus:cms_cn_protocol_corpus_20260715_v1:df51ff33eb77d6","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7"]},{"ai_run_id":"airun_20261001012403_f20c8378","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:14 附录 100|block:198|chunk:1","quote":"本研究将完全按照ICH E6和我国GCP指导原则、赫尔辛基宣言、相关法律法规及伦理委员会审核意见进行，以提供并加强对个人的保护。本研究将符合ICH E2A指导原则（临床安全性数据管理：加速报告的定义和标准）。","quote_sha256":"12bac064fee816df622f65bd2f3d65dab5b33e902aa7b25ae49db87726080ac4","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:20561fabeffbb0","span_id":"es_007"},{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"安全性随访期（末次给药后14天）","quote_sha256":"7f5b5fc8f8745b4f595a7ee16edbe77b147ea8925b916b7366c74eaf446d3eca","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_004"},{"locator":"section:7.3.7 严重不良事件一致性比对|block:1049|chunk:1","quote":"EDC 中 SAE 关键数据点应与安全性数据库进行一致性比对。","quote_sha256":"89137f59a7a4b6b574df06af2472181735de0125de055f6939636b33ffcf7e2c","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:df51ff33eb77d6","span_id":"es_006"},{"locator":"section:8 统计学考虑|block:1056|chunk:1","quote":"有效性评价、安全性评价、PK 评价、PD 评价、免疫原性评价以及其他分析将在本研究的统计分析计划（SAP）中详细规定，数据库锁定前将最终确定 SAP。","quote_sha256":"a635fe9c51c78cbc66090c3553c488cd453e807e61608a97e0767740d5088a03","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","span_id":"es_005"}],"evidence_review_advisories":[],"evidence_span_ids":["es_007","es_004","es_006","es_005"],"evidence_summary":{"corpus_spans":3,"project_fact_spans":1},"gap_items":[{"action":"补充本项目电子数据采集系统配置说明及数据管理计划","category":"source_missing","gap_id":"gap_data_001","missing_source_classes":["电子数据采集系统具体配置与验证文件","数据管理计划"],"target":"数据采集与管理章节中电子数据采集系统具体配置、验证状态及数据核查频率"},{"action":"补充本项目数据核查与质疑管理标准操作规程","category":"source_missing","gap_id":"gap_data_002","missing_source_classes":["数据核查与质疑管理SOP"],"target":"数据采集与管理章节中数据核查、质疑管理及时限规则"},{"action":"补充本项目数据库锁定流程文件","category":"source_missing","gap_id":"gap_data_003","missing_source_classes":["数据库锁定流程文件"],"target":"数据采集与管理章节中数据库锁定流程与条件"}],"heading":"数据采集与管理","missing_source_classes":["电子数据采集系统具体配置与验证文件","数据管理计划","数据核查与质疑管理SOP","数据库锁定流程文件"],"proposal_text":"本研究数据采集与管理遵循ICH E6(R2)药物临床试验质量管理规范、我国药物临床试验质量管理规范及赫尔辛基宣言的相关要求，以保障受试者权益并确保数据完整性与可追溯性。研究数据通过电子数据采集系统收集，由研究者或经授权的研究协调员在访视当日或访视后合理时间内完成录入。数据采集范围涵盖筛选期（最长14天）、双盲治疗期（12周）及安全性随访期（末次给药后14天）的全部研究相关记录。电子数据采集系统中严重不良事件关键数据点应与申办方安全性数据库进行一致性比对，以确保安全性信息的完整性和准确性。数据管理活动包括数据核查、质疑管理、编码一致性审核及数据库锁定前的数据清理。统计分析计划于数据库锁定前最终确定，其中将详细规定有效性、安全性及其他分析的具体方法。","rationale":"数据采集与管理章节的合规框架（ICH E6、GCP、赫尔辛基宣言）参照公司语料中其他研究的结构惯例，本项目是否完全采用相同合规表述需确认。研究时期（筛选期14天、双盲治疗期12周、安全性随访期14天）来源于当前项目已确认研究事实。EDC与安全性数据库一致性比对、SAP于数据库锁定前确定等表述参照公司语料结构惯例，本项目是否采用相同机制需医学经理确认。具体数据管理流程、电子数据采集系统名称、数据核查频率、质疑管理时限等实施细节缺少本项目来源。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d111357b42_82cca8faa310f50a","section_number":"10","source_ids":["protocol_full_draft_selection:c7b09dacb2131977002abcfb","current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","company_corpus:cms_cn_protocol_corpus_20260715_v1:20561fabeffbb0","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:256bd99fe3c436","company_corpus:cms_cn_protocol_corpus_20260715_v1:df51ff33eb77d6","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7"]},{"ai_run_id":"airun_20261001012403_f20c8378","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"安全性随访期（末次给药后14天）","quote_sha256":"7f5b5fc8f8745b4f595a7ee16edbe77b147ea8925b916b7366c74eaf446d3eca","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_004"},{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"安全性终点：第12周6分钟步行距离较基线变化","quote_sha256":"deb2625f8c922a57be11b498fa95e3cb111bfc22077ea36c08d1c7972f5e0353","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_003"},{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"TEAE发生率与严重程度（MedDRA 27.0）；第0、4、12周体位性低血压与收缩压变化","quote_sha256":"dd239b7d837135c6b1f141e455311f8dcfb0031595bd2c57e4713f49a5c8e8c9","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_002"},{"locator":"section:文档开头|block:29|chunk:1","quote":"记录不良医学事件：自试验参与者签署知情同意书至首次使用研究药物前，由试验参与者报告或研究者观察到的任何不良的医疗事件，无论与试验药物是否有因果关系，均判为安全性信息而非不良事件，需作为病史记录在原始病历中；首次使用研究药物后的所有不良医疗事件作为AE记录。整个研究期间均需记录。","quote_sha256":"11c21094429a4d9b6fd36d28e6d6b787c134a8c7397ecc704a35c832857515fe","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","span_id":"es_008"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004","es_003","es_002","es_008"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":3},"gap_items":[{"action":"补充本项目病例报告表设计文件及填写说明","category":"source_missing","gap_id":"gap_crf_001","missing_source_classes":["病例报告表设计文件","病例报告表填写说明与培训材料"],"target":"病例报告表章节中具体字段清单、格式规范及填写说明"},{"action":"补充本项目电子数据采集系统配置说明","category":"source_missing","gap_id":"gap_crf_002","missing_source_classes":["电子数据采集系统配置与验证文件"],"target":"病例报告表章节中电子数据采集系统具体配置与验证状态"},{"action":"确认本项目是否采用与参照语料相同的不良医学事件与不良事件区分规则","category":"source_not_retrieved","gap_id":"gap_crf_003","missing_source_classes":["本项目不良事件定义与记录规则"],"target":"病例报告表章节中不良事件记录窗口规则（首次用药前/后）是否适用于本项目"}],"heading":"病例报告表","missing_source_classes":["病例报告表设计文件","电子数据采集系统配置与验证文件","病例报告表填写说明与培训材料"],"proposal_text":"本研究采用电子病例报告表采集受试者数据。病例报告表的设计应覆盖研究各阶段需采集的全部信息，包括筛选期（最长14天）、双盲治疗期（12周）及安全性随访期（末次给药后14天）的访视记录。病例报告表应包含受试者基本信息、入选与排除标准核查、研究药物给药记录、不良事件记录、合并用药记录、生命体征与血压测量记录、6分钟步行距离测定记录、NT-proBNP检测结果记录及研究相关检查与评估记录。不良事件在首次使用研究药物后按不良事件记录；签署知情同意书至首次使用研究药物前发生的不良医疗事件作为病史记录于原始病历中，不纳入病例报告表不良事件模块。病例报告表的具体字段、格式及填写说明在病例报告表设计文件中规定，由申办方与数据管理部门在研究启动前完成定稿。","rationale":"研究时期（筛选期14天、双盲治疗期12周、安全性随访期14天）及主要终点（NT-proBNP）和安全性终点（6MWD）来源于当前项目已确认研究事实。不良事件记录窗口（首次用药前为病史、首次用药后为AE）参照公司语料中其他研究的结构惯例，本项目是否采用相同记录规则需医学经理确认。病例报告表具体字段设计、电子数据采集系统配置、填写说明及培训要求等实施细节缺少本项目来源，未写入正文。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d111357b42_dd10f795eaafb48a","section_number":"10.1","source_ids":["protocol_full_draft_selection:c7b09dacb2131977002abcfb","current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","company_corpus:cms_cn_protocol_corpus_20260715_v1:20561fabeffbb0","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:256bd99fe3c436","company_corpus:cms_cn_protocol_corpus_20260715_v1:df51ff33eb77d6","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7"]},{"ai_run_id":"airun_20261001012403_f20c8378","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"安全性终点：第12周6分钟步行距离较基线变化","quote_sha256":"deb2625f8c922a57be11b498fa95e3cb111bfc22077ea36c08d1c7972f5e0353","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_003"},{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"TEAE发生率与严重程度（MedDRA 27.0）；第0、4、12周体位性低血压与收缩压变化","quote_sha256":"dd239b7d837135c6b1f141e455311f8dcfb0031595bd2c57e4713f49a5c8e8c9","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_002"},{"locator":"section:7.3.7 严重不良事件一致性比对|block:1049|chunk:1","quote":"EDC 中 SAE 关键数据点应与安全性数据库进行一致性比对。","quote_sha256":"89137f59a7a4b6b574df06af2472181735de0125de055f6939636b33ffcf7e2c","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:df51ff33eb77d6","span_id":"es_006"}],"evidence_review_advisories":[],"evidence_span_ids":["es_003","es_002","es_006"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":2},"gap_items":[{"action":"补充本项目数据源映射与定义文件","category":"source_missing","gap_id":"gap_ds_001","missing_source_classes":["数据源映射与定义文件"],"target":"数据源的定义章节中各数据源具体映射关系及数据流向"},{"action":"确认本项目是否使用受试者自报告量表及其具体版本","category":"source_missing","gap_id":"gap_ds_002","missing_source_classes":["受试者自报告量表清单及版本信息"],"target":"数据源的定义章节中受试者自报告量表具体名称、版本及授权信息"},{"action":"补充本项目数据一致性核查标准操作规程","category":"source_missing","gap_id":"gap_ds_003","missing_source_classes":["数据一致性核查SOP"],"target":"数据源的定义章节中数据一致性核查具体流程与时限"},{"action":"补充本项目中心实验室检测协议","category":"source_missing","gap_id":"gap_ds_004","missing_source_classes":["中心实验室检测协议"],"target":"数据源的定义章节中中心实验室检测协议及NT-proBNP检测方法"}],"heading":"数据源的定义","missing_source_classes":["数据源映射与定义文件","受试者自报告量表清单及版本信息","数据一致性核查SOP","中心实验室检测协议"],"proposal_text":"本研究的数据源包括电子数据采集系统中的病例报告表数据、中心实验室检测数据、研究者原始病历记录及受试者自报告数据。NT-proBNP检测由中心实验室完成，访视窗为±7天，检测结果作为主要终点分析的数据源。6分钟步行距离在访视当日由研究者或经培训的研究协调员测定并记录。体位性低血压与收缩压数据在D0、W4和W12访视时采集。不良事件、合并用药及研究药物给药信息以研究者原始病历记录为数据源，经核实后录入电子数据采集系统。受试者自报告数据（如症状评估）以受试者填写的评估表为数据源。各数据源之间的数据一致性由数据管理部门在数据核查阶段进行比对，电子数据采集系统中严重不良事件关键数据点应与申办方安全性数据库进行一致性比对。","rationale":"NT-proBNP中心实验室检测及访视窗±7天、6MWD安全性终点、体位性低血压与收缩压评估时点（D0/W4/W12）均来源于当前项目已确认研究事实。EDC与安全性数据库一致性比对参照公司语料中其他研究的结构惯例，本项目是否采用相同机制需确认。数据源的具体定义、各数据源之间的映射关系、受试者自报告量表的具体名称与版本、数据一致性核查的具体流程及时限等实施细节缺少本项目来源。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。","本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d111357b42_f5159db20f651e8e","section_number":"10.2","source_ids":["protocol_full_draft_selection:c7b09dacb2131977002abcfb","current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","company_corpus:cms_cn_protocol_corpus_20260715_v1:20561fabeffbb0","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:256bd99fe3c436","company_corpus:cms_cn_protocol_corpus_20260715_v1:df51ff33eb77d6","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7"]}],"source_bindings":[{"content_sha256":"ed155e28901ee1091c29c64685ec391cd7e9e2f62b970eab3b9f451f8b94db63","locator":"document:mwdoc_greenfield_proj_user_d1d111357b42_cb40af386f90d99b:full-draft:c7b09dacb2131977002abcfb","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:c7b09dacb2131977002abcfb","source_type":"protocol_full_draft_selection","source_version":"full-draft:3b2e251e11bb8cba8063752ef5c824857036f2d4a6568821606758be43b3b1f2:c7b09dacb2131977002abcfb","text_sha256":"ed155e28901ee1091c29c64685ec391cd7e9e2f62b970eab3b9f451f8b94db63"},{"content_sha256":"e49aa119fa79fb97c9ada834451eb7ccce1aae054f2913549c0f6b2070265bec","locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","source_type":"