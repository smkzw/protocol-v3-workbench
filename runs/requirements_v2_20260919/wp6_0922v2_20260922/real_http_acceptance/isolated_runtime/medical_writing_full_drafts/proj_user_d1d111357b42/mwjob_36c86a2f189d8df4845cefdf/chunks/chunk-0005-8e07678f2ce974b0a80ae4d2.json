ns":0,"project_fact_spans":2},"gap_items":[{"action":"需项目团队提供各方盲态范围定义及紧急揭盲触发条件与程序","category":"source_missing","gap_id":"gap_blind_scope","missing_source_classes":["盲态范围定义文件","紧急揭盲程序文件"],"target":"盲态范围（受试者、研究者、评价者、统计人员、DSMB等）"}],"heading":"盲法与揭盲","missing_source_classes":["盲态范围定义文件","紧急揭盲程序文件","揭盲后数据处理规则"],"proposal_text":"本研究采用随机、双盲、安慰剂对照、平行组、多中心II期剂量探索设计。受试者按1:1:1比例随机分配至SGC-R21低剂量组（2.5mg每日一次）、SGC-R21高剂量组（5mg每日一次）或安慰剂组（口服安慰剂每日一次），治疗持续12周。安慰剂为口服片剂，外观与活性药物一致，给药频次与活性药物相同，以维持双盲条件。","rationale":"双盲设计、1:1:1随机分配及安慰剂外观与频次一致均来源于当前项目已确认研究事实。本章节未涉及受试者、研究者、评价者、数据监查委员会等各方盲态范围及紧急揭盲程序，因允许来源中无对应项目文件支持，需医学经理补充确认。","review_advisories":["本节复述高影响研究设计（盲法与揭盲）；请在合并设计摘要中统一核对。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d111357b42_16b2497d80e19343","section_number":"4.4","source_ids":["protocol_full_draft_selection:8e07678f2ce974b0a80ae4d2","current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b"]},{"ai_run_id":"airun_20261001003944_b8566c95","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"筛选期（最长14天）；双盲治疗期（12周）；安全性随访期（末次给药后14天）","quote_sha256":"3ab70b78bf465f7aed9cbd5b41012e6425131edbc8e6cf47f0a3865ee2d50d2c","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_duration_01"},{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"筛选（D-14至D-1）、随机（D0）、W4/W8/W12访视、治疗结束与安全性随访","quote_sha256":"871953d63580bee83ce15c20ed776918a18e2644360fe343e50066750959ca09","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_duration_02"}],"evidence_review_advisories":[],"evidence_span_ids":["es_duration_01","es_duration_02"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[],"heading":"研究结束与研究持续时间","missing_source_classes":[],"proposal_text":"本研究总持续时间由以下三个时期组成：筛选期最长14天（D-14至D-1）；双盲治疗期12周（D0至W12）；安全性随访期14天（末次给药后14天）。访视安排如下：筛选访视于D-14至D-1期间完成；随机访视于D0进行；治疗期间设W4、W8、W12访视；治疗结束后进入安全性随访访视。每位受试者从首次筛选访视至安全性随访结束的最长研究参与时间约为112天。","rationale":"研究时期划分（筛选期最长14天、双盲治疗期12周、安全性随访期末次给药后14天）及访视策略（筛选D-14至D-1、随机D0、W4/W8/W12、治疗结束与安全性随访）均来源于当前项目已确认研究事实。总时长112天由14+84+14计算得出。各访视具体评估项目未在来源中逐次列出，不得由访视日推断。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d111357b42_31c5f2b9cd107169","section_number":"4.5","source_ids":["protocol_full_draft_selection:8e07678f2ce974b0a80ae4d2","current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b"]},{"ai_run_id":"airun_20261001003944_b8566c95","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"需项目团队提供研究暂停与终止的触发条件、决策层级、恢复条件及终止后随访安排的项目文件","category":"source_missing","gap_id":"gap_termination_criteria","missing_source_classes":["研究暂停与终止标准项目文件","独立数据监查委员会章程","安全性监测计划"],"target":"研究暂停和终止标准全文"}],"heading":"研究暂停和终止标准","missing_source_classes":["研究暂停与终止标准项目文件","独立数据监查委员会章程","安全性监测计划","无效性/安全性终止阈值定义"],"proposal_text":"","rationale":"当前允许来源中无任何项目文件提供研究暂停或终止的具体触发条件（如安全性信号阈值、无效性判断标准）、决策层级（申办方、独立数据监查委员会、研究者）、暂停后恢复条件或终止后随访安排。研究药物为sGC激动剂，其潜在血管扩张相关风险（体位性低血压、收缩压下降）已在安全性终点中提及，但具体暂停或终止的量化阈值与程序无来源支持，不得以通用原则或条件句替代。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d111357b42_ad0504439436019f","section_number":"4.6","source_ids":["protocol_full_draft_selection:8e07678f2ce974b0a80ae4d2","current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b"]},{"ai_run_id":"airun_20261001003944_b8566c95","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"年龄18-75岁、LVEF≤40%、NYHA II-III级、在GDMT基础上仍有症状的慢性HFrEF成人受试者","quote_sha256":"2d85d0317150862571b2849f7be1d670104af16fa0f8d1d54be90b9a024d3f9f","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_pop_01"},{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"年龄18-75周岁；慢性心力衰竭伴LVEF≤40%、NYHA II-III级；筛选前稳定剂量GDMT至少4周","quote_sha256":"a933c65910098dce3a03e71f6675886dea1078ea8a53990159ed409967e987dd","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_pop_02"},{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"筛选前6个月内急性心肌梗死、不稳定型心衰或卒中；收缩压<90mmHg；eGFR<30mL/min/1.73m²；妊娠或哺乳期；30天内使用过其他sGC激动剂或PDE5抑制剂","quote_sha256":"39905c4379854dbbcb692d6b6359db956895ed1223d38fab63324b16fbf7ea11","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_pop_03"}],"evidence_review_advisories":[],"evidence_span_ids":["es_pop_01","es_pop_02","es_pop_03"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"需项目团队提供育龄期受试者避孕方法要求、妊娠检查时点及阳性妊娠处理流程","category":"source_missing","gap_id":"gap_contraception","missing_source_classes":["避孕方法要求","妊娠检查日程"],"target":"避孕方法要求及妊娠检查日程"},{"action":"需项目团队提供筛选失败后是否允许重新筛选及重新筛选条件","category":"source_missing","gap_id":"gap_screening_failure","missing_source_classes":["筛选失败与重新筛选规则"],"target":"筛选失败与重新筛选规则"},{"action":"需确认NYHA II-III级分级的评估者角色及评估时点","category":"source_missing","gap_id":"gap_nyha_assessment","missing_source_classes":["评估方法定义文件"],"target":"NYHA分级评估方法与评估者"}],"heading":"研究人群","missing_source_classes":["避孕方法要求","妊娠检查日程","哺乳期处理规则","筛选失败与重新筛选规则"],"proposal_text":"本研究拟纳入的受试者为年龄18至75周岁、在标准心衰治疗（GDMT）基础上仍残留症状的慢性心力衰竭（射血分数降低，HFrEF）成人患者。入选条件包括：年龄18至75周岁；慢性心力衰竭伴左室射血分数（LVEF）≤40%、纽约心脏协会（NYHA）心功能II至III级；筛选前稳定剂量GDMT至少4周。排除条件包括：筛选前6个月内发生急性心肌梗死、不稳定型心衰或卒中；收缩压低于90mmHg；估算肾小球滤过率（eGFR）低于30mL/min/1.73m²；妊娠或哺乳期；30天内使用过其他sGC激动剂或PDE5抑制剂。","rationale":"研究人群概述、入选标准模块及排除标准模块均来源于当前项目已确认研究事实。排除标准中妊娠或哺乳期仅作为排除条件列出，未提供避孕方法、妊娠检查日程或哺乳期处理的项目来源，不得自行补充。各排除条件的具体判定方法（如eGFR计算公式、NYHA分级评估者）未在来源中明确，需医学经理确认。","review_advisories":["本节复述高影响研究设计（研究人群）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d111357b42_1bc25165f61149d6","section_number":"5","source_ids":["protocol_full_draft_selection:8e07678f2ce974b0a80ae4d2","current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b"]}],"source_bindings":[{"content_sha256":"21e9e2e83d072d58257f7ea6c767c1301cc7590dca0667a8f886c28379404402","locator":"document:mwdoc_greenfield_proj_user_d1d111357b42_cb40af386f90d99b:full-draft:8e07678f2ce974b0a80ae4d2","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:8e07678f2ce974b0a80ae4d2","source_type":"protocol_full_draft_selection","source_version":"full-draft:3b2e251e11bb8cba8063752ef5c824857036f2d4a6568821606758be43b3b1f2:8e07678f2ce974b0a80ae4d2","text_sha256":"21e9e2e83d072d58257f7ea6c767c1301cc7590dca0667a8f886c28379404402"},{"content_sha256":"e49aa119fa79fb97c9ada834451eb7ccce1aae054f2913549c0f6b2070265bec","locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","source_type":"current_project_study_definition","source_version":"mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","text_sha256":"e49aa119fa79fb97c9ada834451eb7ccce1aae054f2913549c0f6b2070265bec"}]}