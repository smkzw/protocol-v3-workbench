40767c","section_number":"8.3","source_ids":["protocol_full_draft_selection:2fb6e33e75257d06d598045b","current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","company_corpus:cms_cn_protocol_corpus_20260715_v1:e35a8dbd3c7941","company_corpus:cms_cn_protocol_corpus_20260715_v1:d3d67274c5aaab","company_corpus:cms_cn_protocol_corpus_20260715_v1:da3d46a6971245","company_corpus:cms_cn_protocol_corpus_20260715_v1:be5d06fd3b46ad","company_corpus:cms_cn_protocol_corpus_20260715_v1:100e0300d2949b"]},{"ai_run_id":"airun_20261001011616_008982fd","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"研究时期：筛选期（最长14天）；双盲治疗期（12周）；安全性随访期（末次给药后14天）","quote_sha256":"07ee676da9169ff7bd8873a4eb194a9fea3f97590a5af13071efd2a7848b5a32","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_002"},{"locator":"section:不良事件的收集与记录|block:713|chunk:1","quote":"本研究过程中出现的任何不良事件，无论其严重性，或是否与试验用药品有关，研究者都必须记录在eCRF的不良事件页面中，包括其发生日期、结束日期、症状、严重程度（根据NCI-CTCAE 6.0版），对不良事件进行评估和分级、持续时间、处理措施和转归等，并且在综合考虑合并症、合并药物/非药物治疗基础上，评价其与试验药物的相关性，签名并注明日期。","quote_sha256":"62b23c1b9900cdfba6f0f8631ac476fe8b532541b400f2aae84d672a167caa23","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:100e0300d2949b","span_id":"es_003"},{"locator":"section:不良事件的采集与记录|block:678|chunk:1","quote":"研究者负责确保所有不良事件记录在参与者病历和eCRF的不良事件页中，并根据本节和第8.6节","quote_sha256":"de949166dd937bd8c8724d92628ec61969ec0e21255e0b1640719938de4e34b3","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:da3d46a6971245","span_id":"es_004"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003","es_004"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":1},"gap_items":[{"action":"由医学经理确认TEAE采集起止时点（如首次给药至末次给药后若干天）及是否包含筛选期事件","category":"source_missing","gap_id":"gap_8_4_01","missing_source_classes":["项目安全性评估计划","TEAE定义文件"],"target":"8.4节TEAE采集窗口定义"},{"action":"由医学经理确认本项目SAE和SUSAR定义是否沿用ICH E2A或需项目级补充","category":"source_missing","gap_id":"gap_8_4_02","missing_source_classes":["项目安全性评估计划","SAE/SUSAR定义文件"],"target":"8.4节SAE/SUSAR定义"},{"action":"由医学经理确认妊娠及哺乳期不良事件报告流程与随访要求","category":"source_missing","gap_id":"gap_8_4_03","missing_source_classes":["项目安全性评估计划","妊娠报告SOP"],"target":"8.4节妊娠报告"}],"heading":"不良事件的采集与记录","missing_source_classes":["TEAE采集窗口精确定义","SAE/SUSAR项目级定义","妊娠报告流程","剂量调整与AE关联规则"],"proposal_text":"本研究不良事件采集覆盖筛选期（最长14天）、双盲治疗期（12周）及安全性随访期（末次给药后14天）。研究者负责确保所有不良事件记录在受试者病历和电子病例报告表（eCRF）的不良事件页面中。对于每例次不良事件，研究者应记录其发生日期、结束日期、症状描述、严重程度、持续时间、处理措施和转归，并尽可能给出疾病诊断而非仅罗列症状与体征。药物过量或给药错误本身不作为不良事件记录，但与药物过量或给药错误相关的所有不良事件应记录在eCRF不良事件页面中。不良事件编码采用MedDRA 27.0版本。体位性低血压与收缩压变化作为特别关注的不良事件，在第0周、第4周和第12周访视时进行采集与记录。","rationale":"项目已确认研究时期划分、MedDRA 27.0编码版本、体位性低血压与收缩压变化为特别关注不良事件及第0/4/12周采集时点。不良事件记录字段和药物过量处理规则参照公司语料结构。TEAE采集窗口的精确定义（起始与终止时点）、SAE/SUSAR定义、妊娠报告流程、剂量调整与AE关联规则等项目级实施细节尚未在允许来源中明确，需医学经理补充确认。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d111357b42_dec6c5205e14a705","section_number":"8.4","source_ids":["protocol_full_draft_selection:2fb6e33e75257d06d598045b","current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","company_corpus:cms_cn_protocol_corpus_20260715_v1:e35a8dbd3c7941","company_corpus:cms_cn_protocol_corpus_20260715_v1:d3d67274c5aaab","company_corpus:cms_cn_protocol_corpus_20260715_v1:da3d46a6971245","company_corpus:cms_cn_protocol_corpus_20260715_v1:be5d06fd3b46ad","company_corpus:cms_cn_protocol_corpus_20260715_v1:100e0300d2949b"]},{"ai_run_id":"airun_20261001011616_008982fd","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"研究时期：筛选期（最长14天）；双盲治疗期（12周）；安全性随访期（末次给药后14天）","quote_sha256":"07ee676da9169ff7bd8873a4eb194a9fea3f97590a5af13071efd2a7848b5a32","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_002"},{"locator":"section:不良事件的采集与记录|block:678|chunk:1","quote":"对于eCRF不良事件页中记录的每例次不良事件，研究者将评估其严重性、严重程度和与试验药物CMS-D017的相关性。","quote_sha256":"d683dc53bdd5301808cd6984970fec7a3a149825353066b48215987523c2cfc7","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:da3d46a6971245","span_id":"es_006"},{"locator":"section:不良事件的收集与记录|block:713|chunk:1","quote":"研究者应用简洁的医学术语报告并记录所有不良事件，需尽可能给出疾病的诊断而非罗列症状及其体征。","quote_sha256":"45e98ff3b6b7b652f2e9e38f173f02b8b098471c7e3b59825d5bd7bb72467eeb","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:100e0300d2949b","span_id":"es_007"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_006","es_007"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":1},"gap_items":[{"action":"由医学经理确认本项目采用的严重程度分级标准及版本","category":"source_missing","gap_id":"gap_8_5_01","missing_source_classes":["项目安全性评估计划","分级标准文件"],"target":"8.5节严重程度分级标准"},{"action":"由医学经理确认体位性低血压的测量方法、判定阈值及评估频率","category":"source_missing","gap_id":"gap_8_5_02","missing_source_classes":["项目安全性评估计划","体位性低血压评估SOP"],"target":"8.5节体位性低血压评估方法"}],"heading":"不良事件的评估","missing_source_classes":["项目级严重程度分级标准","体位性低血压具体评估方法","相关性判定完整类别定义"],"proposal_text":"对于eCRF不良事件页面中记录的每例次不良事件，研究者应评估其严重性（是否达到严重不良事件标准）、严重程度（按项目规定的分级标准）以及与研究药物SGC-R21的相关性。相关性评估应在综合考虑受试者合并症、合并用药及非药物治疗的基础上进行，判定类别包括肯定相关、很可能相关、可能相关、可能无关、肯定无关及无法判定。研究者应用简洁的医学术语描述不良事件，需尽可能给出疾病诊断而非罗列症状与体征。体位性低血压与收缩压变化作为特别关注的不良事件，在第0周、第4周和第12周访视时由研究者进行评估并记录。","rationale":"项目已确认体位性低血压与收缩压变化为特别关注不良事件及第0/4/12周评估时点。评估维度（严重性、严重程度、相关性）和综合合并症/合并用药的评估原则参照公司语料结构。本项目具体采用的严重程度分级标准（如是否采用NCI-CTCAE 6.0或其他版本）、相关性判定类别的完整列表及体位性低血压的具体评估方法（卧立位血压测量方案）需医学经理确认。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d111357b42_d4129f0e5a8f5fce","section_number":"8.5","source_ids":["protocol_full_draft_selection:2fb6e33e75257d06d598045b","current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","company_corpus:cms_cn_protocol_corpus_20260715_v1:e35a8dbd3c7941","company_corpus:cms_cn_protocol_corpus_20260715_v1:d3d67274c5aaab","company_corpus:cms_cn_protocol_corpus_20260715_v1:da3d46a6971245","company_corpus:cms_cn_protocol_corpus_20260715_v1:be5d06fd3b46ad","company_corpus:cms_cn_protocol_corpus_20260715_v1:100e0300d2949b"]},{"ai_run_id":"airun_20261001011616_008982fd","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"研究时期：筛选期（最长14天）；双盲治疗期（12周）；安全性随访期（末次给药后14天）","quote_sha256":"07ee676da9169ff7bd8873a4eb194a9fea3f97590a5af13071efd2a7848b5a32","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_002"},{"locator":"section:8.2.2.8 死亡|block:758|chunk:1","quote":"在方案规定的不良事件收集期内发生的所有死亡事件，无论与研究药物的关系如何，必须记录在eCRF不良事件上，并立即报告给申办者。","quote_sha256":"0d5c3ccbe90f5b3d20fe17ea341db79f0eda467da1bd648a8d1b071c4c50e1ab","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:e35a8dbd3c7941","span_id":"es_008"},{"locator":"section:死亡|block:741|chunk:1","quote":"在方案规定的不良事件采集期内发生的所有死亡事件，无论与研究药物的关系如何，必须记录在eCRF不良事件上，并立即（获知后24小时内）报告给申办者。","quote_sha256":"3e205c16902be596ebe4a91124c2562b9362da4f4bc5b416b29c47d0437dfe8d","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:be5d06fd3b46ad","span_id":"es_009"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_008","es_009"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":1},"gap_items":[{"action":"由医学经理确认SAE报告时限（如获知后24小时或15天）及SUSAR报告时限","category":"source_missing","gap_id":"gap_8_6_01","missing_source_classes":["项目安全性评估计划","SAE/SUSAR报告SOP"],"target":"8.6节SAE报告时限"},{"action":"由医学经理确认报告对象（申办者、伦理委员会、药监部门）及报告途径","category":"source_missing","gap_id":"gap_8_6_02","missing_source_classes":["项目安全性评估计划","报告SOP"],"target":"8.6节报告对象与途径"},{"action":"由医学经理确认不良事件随访至何种状态可关闭（如恢复、稳定、无法进一步随访）","category":"source_missing","gap_id":"gap_8_6_03","missing_source_classes":["项目安全性评估计划"],"target":"8.6节随访终点"}],"heading":"不良事件的报告","missing_source_classes":["项目安全性评估计划","SAE/SUSAR报告时限与途径","伦理委员会报告要求","药品监督管理部门报告要求"],"proposal_text":"在方案规定的不良事件采集期内发生的所有死亡事件，无论与研究药物的关系如何，必须记录在eCRF不良事件页面中，并立即报告给申办者。研究者负责按照本章节及不良事件采集与记录章节的规定，向申办者报告不良事件。严重不良事件和可疑且非预期严重不良反应的报告时限、报告对象及报告途径，依据项目安全性评估计划及适用法规要求执行。","rationale":"死亡事件记录与立即报告要求参照公司语料结构。项目已确认安全性随访期为末次给药后14天，但SAE/SUSAR具体报告时限（如获知后24小时或15天）、报告对象（申办者、伦理委员会、药品监督管理部门）及报告途径（eSafety系统、传真、邮件）未在允许来源中明确给出，需医学经理依据项目安全性评估计划和适用法规确认。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d111357b42_31f9c0d1e540fe40","section_number":"8.6","source_ids":["protocol_full_draft_selection:2fb6e33e75257d06d598045b","current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","company_corpus:cms_cn_protocol_corpus_20260715_v1:e35a8dbd3c7941","company_corpus:cms_cn_protocol_corpus_20260715_v1:d3d67274c5aaab","company_corpus:cms_cn_protocol_corpus_20260715_v1:da3d46a6971245","company_corpus:cms_cn_protocol_corpus_20260715_v1:be5d06fd3b46ad","company_corpus:cms_cn_protocol_corpus_20260715_v1:100e0300d2949b"]}],"source_bindings":[{"content_sha256":"5b5b4b5d79ef3439598ac129a752dda1f2437d6cbe2fb85f4f9afc4045f018ff","locator":"document:mwdoc_greenfield_proj_user_d1d111357b42_cb40af386f90d99b:full-draft:2fb6e33e75257d06d598045b","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:2fb6e33e75257d06d598045b","source_type":"protocol_full_draft_selection","source_version":"full-draft:3b2e251e11bb8cba8063752ef5c824857036f2d4a6568821606758be43b3b1f2:2fb6e33e75257d06d598045b","text_sha256":"5b5b4b5d79ef3439598ac129a752dda1f2437d6cbe2fb85f4f9afc4045f018ff"},{"content_sha256":"e49aa119fa79fb97c9ada834451eb7ccce1aae054f2913549c0f6b2070265bec","locator":"study_definition:mwdefinition_66d98f3917295e20f566:re