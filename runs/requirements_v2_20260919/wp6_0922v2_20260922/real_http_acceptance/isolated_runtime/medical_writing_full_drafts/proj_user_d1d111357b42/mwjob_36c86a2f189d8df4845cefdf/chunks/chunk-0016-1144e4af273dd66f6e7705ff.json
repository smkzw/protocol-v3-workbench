b3be2e1b473b440c3793a74de4b088e58130278b1d0d40645826ab","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_004"},{"locator":"section:8 统计学考虑|block:1056|chunk:1","quote":"有效性评价、安全性评价、PK 评价、PD 评价、免疫原性评价以及其他分析将在本研究的统计分析计划（SAP）中详细规定，数据库锁定前将最终确定 SAP。","quote_sha256":"a635fe9c51c78cbc66090c3553c488cd453e807e61608a97e0767740d5088a03","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","span_id":"es_007"},{"locator":"section:6.3.3 揭盲|block:488|chunk:1","quote":"在所有参与者（包括脱落和提前终止治疗）完成最后一次研究访视，完成数据清理、数据库锁定后，将对项目进行统一揭盲并进行统计分析。","quote_sha256":"d201ce569054cbbf7236ebc38a81549ab6777a6cd5f2fedc31a501f7bd4655a7","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","span_id":"es_008"},{"locator":"section:参考文献：|block:48|chunk:1","quote":"国家药品监督管理局药品审评中心. 药物临床试验数据管理与统计分析计划指导原则. 2021年.","quote_sha256":"9a9f3dc0d904c2d48a939e7baaaaf39c4e89deb4067ed241f98001500d36bd56","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:3152bfe8bf762f","span_id":"es_015"}],"evidence_review_advisories":[],"evidence_span_ids":["es_010","es_011","es_006","es_012","es_004","es_007","es_008","es_015"],"evidence_summary":{"corpus_spans":3,"project_fact_spans":5},"gap_items":[{"action":"由医学团队与统计师确认TEAE采集是否覆盖安全性随访期（末次给药后14天）","category":"source_missing","gap_id":"gap_teae_window","missing_source_classes":["TEAE采集窗口定义"],"target":"9.3节TEAE采集窗口定义"},{"action":"由医学团队确认体位性低血压的收缩压/舒张压下降阈值","category":"source_missing","gap_id":"gap_orthostatic_threshold","missing_source_classes":["体位性低血压判定标准文件"],"target":"9.3节体位性低血压判定阈值"},{"action":"由统计师在SAP中明确死亡或心衰住院退出的统计处理方式","category":"source_missing","gap_id":"gap_estimand_implementation","missing_source_classes":["统计分析计划（SAP）草案"],"target":"9.3节治疗策略处理的具体实现"}],"heading":"统计分析一般原则","missing_source_classes":["统计分析计划（SAP）草案","体位性低血压判定标准文件","TEAE采集窗口定义"],"proposal_text":"本研究的统计分析遵循《药物临床试验数据管理与统计分析计划指导原则》（2021年）的要求。主要终点第12周NT-proBNP较基线百分比变化采用ANCOVA模型进行分析，模型中包含基线协变量与组别固定效应。安全性数据以描述统计为主，不良事件依据MedDRA 27.0进行编码分类，治疗期出现的不良事件（TEAE）为安全性分析的主要关注对象。特别关注的不良事件包括体位性低血压与收缩压变化，在第0、4、12周进行监测。主要估计目标为随机化人群第12周NT-proBNP较基线百分比变化，死亡或心衰住院退出按治疗策略处理。统计分析计划（SAP）将在数据库锁定前最终确定。在所有受试者（包括脱落和提前终止治疗者）完成最后一次研究访视、完成数据清理与数据库锁定后，进行统一揭盲并开展统计分析。","rationale":"ANCOVA模型、安全性描述统计、MedDRA 27.0编码、TEAE关注、体位性低血压与收缩压监测时点、主要估计目标及退出处理策略均来源于当前项目已确认研究事实。统计指导原则引用及SAP时点、统一揭盲流程参照公司语料中同类方案的监管共性结构。需医学经理与统计师确认：（1）ANCOVA中基线协变量的具体变量；（2）体位性低血压的判定阈值及是否纳入安全性随访期；（3）'治疗策略处理'的具体实现方式（如是否使用censoring、imputation或复合终点）；（4）TEAE采集窗口是否覆盖安全性随访期（末次给药后14天）。","review_advisories":["本节提及高影响设计信息（主要终点、估计目标）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d111357b42_3127c98160e18b62","section_number":"9.3","source_ids":["protocol_full_draft_selection:1144e4af273dd66f6e7705ff","current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","company_corpus:cms_cn_protocol_corpus_20260715_v1:3152bfe8bf762f","company_corpus:cms_cn_protocol_corpus_20260715_v1:2bfb4cb52d6d07","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e"]},{"ai_run_id":"airun_20261001012141_0e5ac0c5","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"第12周NT-proBNP较基线百分比变化（中心实验室，访视窗±7天）","quote_sha256":"079f5c0a1affa3e37d620b2c4c90a298de11dca6af4efaf979b3707ca71e4761","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_003"},{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"主要终点ANCOVA（基线协变量、组别固定效应）","quote_sha256":"0b5fdd019a23f194f71bfd4960f30b3a1aebdfd23ea5f7f6dd7b6ffe1d8f5000","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_010"},{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"第12周6分钟步行距离较基线变化","quote_sha256":"6b9caa79a7d5a60c5b0bac4768cc56146210e8f71680747e63ee5f7fb3611883","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_005"},{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"第0、4、12周体位性低血压与收缩压变化","quote_sha256":"5312658480ef3b9e123bbd4f27138facf7cf174baed0ea46f85a980712f17a55","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_012"},{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"TEAE发生率与严重程度（MedDRA 27.0）","quote_sha256":"1a9afdf45ec0f72319c492bbae817b4777fe060888e9dd331eb2242f8179a1a7","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_006"},{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"主要估计目标：随机化人群第12周NT-proBNP较基线百分比变化；死亡或心衰住院退出按治疗策略处理","quote_sha256":"5089261f6fb3be2e1b473b440c3793a74de4b088e58130278b1d0d40645826ab","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_004"},{"locator":"document:mwdoc_greenfield_proj_user_d1d111357b42_cb40af386f90d99b:full-draft:1144e4af273dd66f6e7705ff","quote":"第12周NT-proBNP较基线百分比变化（中心实验室，访视窗±7天）","quote_sha256":"079f5c0a1affa3e37d620b2c4c90a298de11dca6af4efaf979b3707ca71e4761","source_id":"protocol_full_draft_selection:1144e4af273dd66f6e7705ff","span_id":"es_013"}],"evidence_review_advisories":[],"evidence_span_ids":["es_003","es_010","es_005","es_012","es_006","es_004","es_013"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"由统计师确认6MWD是否纳入ANCOVA或仅描述统计","category":"source_missing","gap_id":"gap_6mwd_method","missing_source_classes":["统计分析计划（SAP）草案"],"target":"9.4节6分钟步行距离分析方法"},{"action":"由统计师确认是否设置剂量-反应趋势检验及多重性校正方法","category":"source_missing","gap_id":"gap_multiplicity","missing_source_classes":["多重性校正策略文件"],"target":"9.4节多重性校正策略"}],"heading":"有效性数据分析","missing_source_classes":["统计分析计划（SAP）草案","多重性校正策略文件"],"proposal_text":"主要有效性终点为第12周NT-proBNP较基线百分比变化，NT-proBNP检测由中心实验室完成，访视窗为±7天。主要终点分析采用ANCOVA模型，以基线NT-proBNP水平为协变量、治疗组别为固定效应，在FAS中进行。主要估计目标为随机化人群第12周NT-proBNP较基线百分比变化，死亡或心衰住院退出按治疗策略处理。安全性终点为第12周6分钟步行距离较基线变化，以描述统计呈现。特别关注的不良事件包括体位性低血压与收缩压变化，在第0、4、12周访视时评估。TEAE发生率与严重程度依据MedDRA 27.0编码进行描述性分析。","rationale":"主要终点（第12周NT-proBNP较基线百分比变化、中心实验室、访视窗±7天）、ANCOVA模型、安全性终点（第12周6分钟步行距离）、体位性低血压与收缩压监测时点（第0/4/12周）、TEAE MedDRA 27.0编码及主要估计目标均来源于当前项目已确认研究事实。需医学经理与统计师确认：（1）6分钟步行距离是否纳入ANCOVA或仅描述统计；（2）ANCOVA中除基线NT-proBNP外是否纳入其他协变量（如基线LVEF、NYHA分级、中心）；（3）是否设置剂量-反应趋势检验或亚组分析；（4）多重性校正策略。","review_advisories":["本节提及高影响设计信息（主要终点、估计目标）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d111357b42_afb6b5d41dfb412e","section_number":"9.4","source_ids":["protocol_full_draft_selection:1144e4af273dd66f6e7705ff","current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","company_corpus:cms_cn_protocol_corpus_20260715_v1:3152bfe8bf762f","company_corpus:cms_cn_protocol_corpus_20260715_v1:2bfb4cb52d6d07","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e"]}],"source_bindings":[{"content_sha256":"d1f8ec0740e1b0d7bd8da7e55f3ea17b13cd1f9562c09b3289b4592bf9a9448b","locator":"document:mwdoc_greenfield_proj_user_d1d111357b42_cb40af386f90d99b:full-draft:1144e4af273dd66f6e7705ff","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:1144e4af273dd66f6e7705ff","source_type":"protocol_full_draft_selection","source_version":"full-draft:3b2e251e11bb8cba8063752ef5c824857036f2d4a6568821606758be43b3b1f2:1144e4af273dd66f6e7705ff","text_sha256":"d1f8ec0740e1b0d7bd8da7e55f3ea17b13cd1f9562c09b3289b4592b