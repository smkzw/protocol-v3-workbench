":0,"project_fact_spans":2},"gap_items":[{"action":"由医学经理提供或确认GDMT具体组成成分及研究期间允许的其他合并用药类别","category":"source_missing","gap_id":"gap_concomitant_allowed_list","missing_source_classes":["合并用药管理清单","GDMT组成成分定义文件"],"target":"6.6.1节完整允许合并用药清单"}],"heading":"允许的合并用药/治疗","missing_source_classes":["合并用药管理清单","GDMT组成成分定义文件"],"proposal_text":"本研究允许受试者在研究期间继续接受标准心力衰竭药物治疗（GDMT）作为背景治疗。入组时受试者须已在筛选前接受至少4周稳定剂量GDMT，研究期间GDMT方案原则上保持不变。除GDMT外，其他合并用药的允许范围、是否需事先获得研究者批准及记录方式，由医学经理根据药物相互作用评估结果另行确定。","rationale":"当前项目研究事实确认研究人群为'在标准心衰治疗（GDMT）基础上仍残留症状的成人HFrEF患者'且'筛选前稳定剂量GDMT至少4周'，据此可写入GDMT作为允许背景治疗。但GDMT具体组成成分清单、其他允许合并用药类别及审批流程未在允许来源中提供，需医学经理补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d111357b42_af0b759fb2a3cea0","section_number":"6.6.1","source_ids":["protocol_full_draft_selection:707244edaf5a44ff42c70e63","current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b"]},{"ai_run_id":"airun_20261001005808_fc0c99c4","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"30天内使用过其他sGC激动剂或PDE5抑制剂","quote_sha256":"86114cc9eaefe2f7c6b3fffeba34e99e0737d1555bbd215b1d05b1dcc2b4586d","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_sgc_pde5_exclusion"}],"evidence_review_advisories":[],"evidence_span_ids":["es_sgc_pde5_exclusion"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[{"action":"由医学经理提供或确认除sGC激动剂和PDE5抑制剂外的其他禁止合并用药类别及具体规则","category":"source_missing","gap_id":"gap_concomitant_prohibited_list","missing_source_classes":["禁止合并用药完整清单","药物相互作用评估报告","研究者手册"],"target":"6.6.2节完整禁止合并用药清单"},{"action":"确认禁止用药是否从筛选期即生效及恢复用药条件","category":"source_missing","gap_id":"gap_prohibited_start_time","missing_source_classes":["合并用药管理清单"],"target":"6.6.2节禁止用药起始时点"}],"heading":"禁止的合并用药/治疗","missing_source_classes":["禁止合并用药完整清单","药物相互作用评估报告","研究者手册"],"proposal_text":"本研究禁止在筛选前30天内及研究期间使用其他sGC激动剂或PDE5抑制剂。该限制源于排除标准中'30天内使用过其他sGC激动剂或PDE5抑制剂'的规定，旨在避免与试验药物SGC-R21（口服sGC激动剂）产生药理学叠加效应。除上述两类药物外，其他禁止合并用药（如硝酸酯类、其他血管扩张剂、CYP酶强效抑制剂或诱导剂等）的完整清单及禁止起始时点、恢复用药条件等具体规则，由医学经理根据药物相互作用评估结果另行确定。","rationale":"排除标准明确列出'30天内使用过其他sGC激动剂或PDE5抑制剂'为排除条件，结合试验药物为sGC激动剂的机制，可合理推断研究期间禁止此类药物。但完整禁止清单、禁止起始时点（是否从筛选期即禁止）及恢复条件未在允许来源中明确，需医学经理确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d111357b42_b4c65c7d611a6699","section_number":"6.6.2","source_ids":["protocol_full_draft_selection:707244edaf5a44ff42c70e63","current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b"]},{"ai_run_id":"airun_20261001005808_fc0c99c4","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"筛选期（最长14天）；双盲治疗期（12周）；安全性随访期（末次给药后14天）","quote_sha256":"3ab70b78bf465f7aed9cbd5b41012e6425131edbc8e6cf47f0a3865ee2d50d2c","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_study_periods"},{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"筛选（D-14至D-1）、随机（D0）、W4/W8/W12访视、治疗结束与安全性随访","quote_sha256":"871953d63580bee83ce15c20ed776918a18e2644360fe343e50066750959ca09","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_visit_strategy"},{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"第12周NT-proBNP较基线百分比变化（中心实验室，访视窗±7天）","quote_sha256":"079f5c0a1affa3e37d620b2c4c90a298de11dca6af4efaf979b3707ca71e4761","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_primary_endpoint"},{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"TEAE发生率与严重程度（MedDRA 27.0）；第0、4、12周体位性低血压与收缩压变化","quote_sha256":"dd239b7d837135c6b1f141e455311f8dcfb0031595bd2c57e4713f49a5c8e8c9","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_safety_assessment"},{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"第12周6分钟步行距离较基线变化","quote_sha256":"6b9caa79a7d5a60c5b0bac4768cc56146210e8f71680747e63ee5f7fb3611883","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_safety_endpoint"}],"evidence_review_advisories":[],"evidence_span_ids":["es_study_periods","es_visit_strategy","es_primary_endpoint","es_safety_assessment","es_safety_endpoint"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"由医学经理提供各访视（筛选、D0、W4、W8、W12、EOT、安全性随访）的具体评估项目及时点","category":"source_missing","gap_id":"gap_visit_assessment_list","missing_source_classes":["各访视评估项目清单","实验室检查方案","影像学检查方案"],"target":"7节各访视评估项目清单"},{"action":"确认TEAE采集窗口、安全性随访期评估内容及研究结束时点定义","category":"source_missing","gap_id":"gap_safety_window","missing_source_classes":["安全性评估方案"],"target":"7节安全性评估窗口定义"}],"heading":"研究程序和评估","missing_source_classes":["各访视评估项目清单","实验室检查方案","影像学检查方案","依从性评价方案"],"proposal_text":"本研究的研究程序与评估覆盖筛选期（最长14天）、双盲治疗期（12周）和安全性随访期（末次给药后14天）三个阶段。访视安排包括筛选访视（D-14至D-1）、随机访视（D0）、第4周（W4）、第8周（W8）、第12周（W12）访视、治疗结束访视及安全性随访访视。主要疗效评估为第12周NT-proBNP较基线百分比变化（中心实验室检测，访视窗±7天）；安全性评估包括TEAE发生率与严重程度（MedDRA 27.0编码）以及第0、4、12周体位性低血压与收缩压变化；次要疗效评估包括第12周6分钟步行距离较基线变化。各访视具体评估项目清单（如实验室检查、心电图、超声心动图、体格检查、生命体征、依从性评价等）及各评估的实施时点与频率，由医学经理根据研究操作规范另行确定。","rationale":"研究时期、访视策略、主要终点、安全性终点及次要终点均已在当前项目研究事实中确认，据此可写入研究程序与评估的总体框架。但各访视具体评估项目清单、实验室检查频率、心电图及超声心动图实施时点、依从性评价方式等实施细节未在允许来源中提供，需医学经理补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d111357b42_3021fea40292fc78","section_number":"7","source_ids":["protocol_full_draft_selection:707244edaf5a44ff42c70e63","current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b"]},{"ai_run_id":"airun_20261001005808_fc0c99c4","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"筛选期（最长14天）；双盲治疗期（12周）；安全性随访期（末次给药后14天）","quote_sha256":"3ab70b78bf465f7aed9cbd5b41012e6425131edbc8e6cf47f0a3865ee2d50d2c","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_study_periods"},{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"筛选（D-14至D-1）、随机（D0）、W4/W8/W12访视、治疗结束与安全性随访","quote_sha256":"871953d63580bee83ce15c20ed776918a18e2644360fe343e50066750959ca09","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_visit_strategy"},{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"口服每日一次，连续12周","quote_sha256":"b2c828a888045406cbd05c4c81399e5e7c55efaad6ad7a55177e936c3868fd3d","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_treatment_duration"},{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"TEAE发生率与严重程度（MedDRA 27.0）；第0、4、12周体位性低血压与收缩压变化","quote_sha256":"dd239b7d837135c6b1f141e455311f8dcfb0031595bd2c57e4713f49a5c8e8c9","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es_safety_assessment"}],"evidence_review_advisories":[],"evidence_span_ids":["es_study_periods","es_visit_strategy","es_treatment_duration","es_safety_assessment"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"由医学经理提供各访视中具体评估操作项目、实施时点与频率","category":"source_missing","gap_id":"gap_procedure_detail","missing_source_classes":["各访视评估项目清单","实验室检查方案","影像学检查方案"],"target":"7.1节各访视具体评估操作清单"},{"action":"确认给药时间窗、漏服处理、依从性评价方法及药物回收流程","category":"source_missing","gap_id":"gap_dosing_procedure","missing_source_classes":["给药操作规范","依从性评价方案"],"target":"7.1节给药操作与依从性管理"}],"heading":"研究程序","missing_source_classes":["各访视评估项目清单","实验室检查方案","影像学检查方案","依从性评价方案"],"proposal_text":"本研究的研究程序按以下时间框架执行：筛选期最长14天（D-14至D-1），用于完成入排标准评估、基线数据采集及随机化前准备；随机访视（D0）完成随机分组、首次给药及基线安全性评估；双盲治疗期持续12周，期间安排W4、W8、W12访视用于疗效与安全性评估；治疗结束访视及安全性随访期（末次给药后14天）用于完成末次安全性评估。试验药物SGC-R21以口服片剂形式每日一次给药，低剂量组2.5mg、高剂量组5mg，安慰剂组给予外观与频次一致的口服安慰剂片，三组按1:1:1比例随机分配。各访视中具体实施的评估操作（如生命体征测量、心电图、实验室采血、超声心动图、6分钟步行试验、体格检查、合并用药记录、依从性检查等）及其实施时点与频率，由医学经理根据研究操作规范另行确定。","rationale":"研究时期划分、访视策略、给药方案（2.5mg/5mg/安慰剂，每日一次，12周）、随机比例（1:1:1）及治疗期时长均已在当前项目研究事实中确认，据此可写入研究程序的时间框架与给药安排。但各访视具体评估操作清单、实验室检查项目与频率、心电图及超声心动图实施时点、6分钟步行试验安排、依从性评价方式等实施细节未在允许来源中提供，需医学经理补充。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d111357b42_bab6a4ed4d93bfb7","section_number":"7.1","source_ids":["protocol_full_draft_selection:707244edaf5a44ff42c70e63","current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b"]}],"source_bindings":[{"content_sha256":"872588e6e92a7a6c658a88d82002f3e36ed728f648cba87fd08d7b0f9f3a7ee7","locator":"document:mwdoc_greenfield_proj_user_d1d111357b42_cb40af386f90d99b:full-draft:707244edaf5a44ff42c70e63","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:707244edaf5a44ff42c70e63","source_type":"protocol_full_draft_selection","source_version":"full-draft:3b2e251e11bb8cba8063752ef5c824857036f2d4a6568821606758be43b3b1f2:707244edaf5a44ff42c70e63","text_sha256":"872588e6e92a7a6c658a88d82002f3e36ed728f648cba87fd08d7b0f9f3a7ee7"},{"content_sha256":"e49aa119fa79fb97c9ada834451eb7ccce1aae054f2913549c0f6b2070265bec","locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","source_type":"current_project_study_definition","source_version":"mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","text_sha256":"e49aa119fa79fb97c9ada834451eb7ccce1aae054f2913549c0f6b2070265bec"}]}