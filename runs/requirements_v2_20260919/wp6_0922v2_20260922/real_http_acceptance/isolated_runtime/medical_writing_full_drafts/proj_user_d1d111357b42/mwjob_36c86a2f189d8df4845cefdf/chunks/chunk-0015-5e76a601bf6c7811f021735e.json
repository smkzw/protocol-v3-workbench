":"8.7","source_ids":["protocol_full_draft_selection:5e76a601bf6c7811f021735e","current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:9691f7c94f6c58","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976","company_corpus:cms_cn_protocol_corpus_20260715_v1:9895ed0bd2ffd4","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83"]},{"ai_run_id":"airun_20261001011809_e5b97a9b","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"TEAE发生率与严重程度（MedDRA 27.0）；第0、4、12周体位性低血压与收缩压变化","quote_sha256":"dd239b7d837135c6b1f141e455311f8dcfb0031595bd2c57e4713f49a5c8e8c9","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es2"},{"locator":"study_definition:mwdefinition_66d98f3917295e20f566:revision:4","quote":"访视策略：筛选（D-14至D-1）、随机（D0）、W4/W8/W12访视、治疗结束与安全性随访","quote_sha256":"a53b5791ef0f5c3ccd63f1e987c1b5fca5ded6592d101be5ebe5ecd24ec86f6e","source_id":"current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","span_id":"es9"}],"evidence_review_advisories":[],"evidence_span_ids":["es2","es9"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"需项目级安全性管理文件，明确体位性低血压判定阈值、严重程度分级标准及报告流程","category":"source_missing","gap_id":"gap_88_01","missing_source_classes":["体位性低血压判定阈值与分级标准","项目级安全性事件报告流程与时限"],"target":"8.8节正文"}],"heading":"特别关注的不良事件","missing_source_classes":["体位性低血压判定阈值与分级标准","项目级安全性事件报告流程与时限"],"proposal_text":"本研究将体位性低血压与收缩压变化列为特别关注的不良事件，在第0周（基线）、第4周和第12周访视时进行监测与评估。所有治疗期间出现的不良事件按MedDRA 27.0进行编码，并记录发生率与严重程度分级。体位性低血压的判定以收缩压变化为辅助参考指标，具体判定阈值、严重程度分级标准及报告流程由项目安全性管理文件规定。","rationale":"项目事实已确认特别关注不良事件为TEAE发生率与严重程度（MedDRA 27.0）及第0、4、12周体位性低血压与收缩压变化，访视策略包含W4/W8/W12。但体位性低血压的具体判定阈值、严重程度分级标准、报告时限及处理流程未在项目事实中给出，需由医学团队和安全性管理文件确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d111357b42_024e0735045b78db","section_number":"8.8","source_ids":["protocol_full_draft_selection:5e76a601bf6c7811f021735e","current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:9691f7c94f6c58","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976","company_corpus:cms_cn_protocol_corpus_20260715_v1:9895ed0bd2ffd4","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83"]},{"ai_run_id":"airun_20261001011809_e5b97a9b","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"需项目级妊娠事件报告与随访操作程序文件，明确报告对象与时限、随访终止条件、妊娠检查日程、避孕方法要求及新生儿随访方案","category":"source_missing","gap_id":"gap_89_01","missing_source_classes":["项目级妊娠事件报告与随访操作程序","避孕方法要求与妊娠检查日程","伴侣妊娠报告规则","新生儿随访方案"],"target":"8.9节正文"}],"heading":"妊娠事件的报告与随访","missing_source_classes":["项目级妊娠事件报告与随访操作程序","避孕方法要求与妊娠检查日程","伴侣妊娠报告规则","新生儿随访方案"],"proposal_text":"","rationale":"项目事实仅在排除标准中提及妊娠或哺乳期女性不可入组，但未定义妊娠事件的报告对象、报告时限、随访终止条件、妊娠检查日程、避孕方法要求、伴侣妊娠报告规则及新生儿随访方案。公司语料中相关条款分别来自CMS-D017 I期、CMD-D001-AD II期及另一研究，属于其他项目的实施规则，不可迁移为本项目既定要求。","review_advisories":["本节复述高影响研究设计（妊娠事件的报告与随访）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d1d111357b42_6fbe7bb6cd8d6f8f","section_number":"8.9","source_ids":["protocol_full_draft_selection:5e76a601bf6c7811f021735e","current_project_study_definition:mwdefinition_66d98f3917295e20f566:r4:9af9d9d06a6fe01b","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:9691f7c94f6c58","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f