_ids":["protocol_full_draft_selection:941cb4c0feb0d052f653df8a","current_project_study_definition:mwdefinition_fb549ea860136ec4fedf:r7:47d0cec7ceedc189"]},{"ai_run_id":"airun_20261003060117_52be2fef","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_fb549ea860136ec4fedf:revision:7","quote":"主要终点：第12周NT-proBNP较基线的百分比变化（中心实验室定量）。","quote_sha256":"cf93d08c04b1ed185004699e412fd4e8e81365a7a5b69ad855a2d977c17a8461","source_id":"current_project_study_definition:mwdefinition_fb549ea860136ec4fedf:r7:47d0cec7ceedc189","span_id":"es_primary_endpoint"},{"locator":"study_definition:mwdefinition_fb549ea860136ec4fedf:revision:7","quote":"主要分析集为FAS；主要终点采用ANCOVA（基线log NT-proBNP为协变量）比较各剂量组与安慰剂组第12周变化，报告几何均值比与90%CI；安全性按SAS描述；无确证性假设检验。","quote_sha256":"6761a9b7aecbd75032ab32a3c52445a857daac1dd4639f1ea608fde1de442bff","source_id":"current_project_study_definition:mwdefinition_fb549ea860136ec4fedf:r7:47d0cec7ceedc189","span_id":"es_stat_strategy"},{"locator":"study_definition:mwdefinition_fb549ea860136ec4fedf:revision:7","quote":"访视策略：筛选（V1，-28~-1天）、基线随机（V2，D1）、第2/4/8/12周门诊访视（V3–V6）、治疗结束访视（V7，W12）、末次给药后28天安全性随访（V8）。","quote_sha256":"f246ab1e6e3fdcf1be70f34b89965eeaf4ce6f58c8c3616c28603f43768511ad","source_id":"current_project_study_definition:mwdefinition_fb549ea860136ec4fedf:r7:47d0cec7ceedc189","span_id":"es_visit_schedule"},{"locator":"study_definition:mwdefinition_fb549ea860136ec4fedf:revision:7","quote":"估计目标：12周NT-proBNP较基线百分比变化；人群为随机化全分析集；伴发事件按治疗方针策略处理；汇总统计量为各组均值差。","quote_sha256":"625ff33f440364fc20fc6f8a2053c62306031f65cc31d16a0678ae00fe8ee8f5","source_id":"current_project_study_definition:mwdefinition_fb549ea860136ec4fedf:r7:47d0cec7ceedc189","span_id":"es_est_target"}],"evidence_review_advisories":[],"evidence_span_ids":["es_primary_endpoint","es_stat_strategy","es_visit_schedule","es_est_target"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[],"heading":"有效性评估","missing_source_classes":[],"proposal_text":"本研究的主要有效性终点为第12周N末端B型利钠肽前体（NT-proBNP）较基线的百分比变化，由中心实验室进行定量检测。有效性评价在以下访视时点进行：基线随机访视（V2，第1天）采集NT-proBNP基线值，第12周访视（V6/V7，治疗结束访视）采集第12周NT-proBNP值，以计算百分比变化。有效性分析采用全分析集（FAS），即所有随机化受试者均纳入分析。主要终点分析采用协方差分析（ANCOVA），以基线log NT-proBNP为协变量，比较SGC-R21低剂量组、中剂量组、高剂量组与安慰剂对照组在第12周NT-proBNP百分比变化上的组间差异，报告几何均值比及其90%置信区间。本研究为概念验证与剂量探索性质，不设确证性假设检验，上述分析结果为描述性推断依据。伴发事件按治疗方针策略处理，汇总统计量为各组均值差。","rationale":"主要终点、统计方法、分析集、估计目标策略及无确证性假设检验均来源于已确认研究事实。访视时点依据访视策略中V2和V6/V7确定。需医学经理确认：NT-proBNP中心实验室具体检测方法与质控标准、NT-proBNP采集是否仅限V2和V6/V7还是其他访视也需采集、伴发事件处理策略的具体操作定义。","review_advisories":["本节提及高影响设计信息（主要终点、伴发事件）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_415ce4db48b2_7d63e9f054a52171","section_number":"7.2","source_ids":["protocol_full_draft_selection:941cb4c0feb0d052f653df8a","current_project_study_definition:mwdefinition_fb549ea860136ec4fedf:r7:47d0cec7ceedc189"]},{"ai_run_id":"airun_20261003060117_52be2fef","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_fb549ea860136ec4fedf:revision:7","quote":"安全性终点：不良事件（AE）与严重不良事件（SAE）发生率（至末次给药后28天）；生命体征、12导联心电图、临床实验室检查异常发生率；症状性低血压发生率","quote_sha256":"baf9dd2250e27943336dfa1e44f2f07081f03e6f2962e0d1e4e9e0edb166421a","source_id":"current_project_study_definition:mwdefinition_fb549ea860136ec4fedf:r7:47d0cec7ceedc189","span_id":"es_safety_endpoints"},{"locator":"study_definition:mwdefinition_fb549ea860136ec4fedf:revision:7","quote":"主要分析集为FAS；主要终点采用ANCOVA（基线log NT-proBNP为协变量）比较各剂量组与安慰剂组第12周变化，报告几何均值比与90%CI；安全性按SAS描述；无确证性假设检验。","quote_sha256":"6761a9b7aecbd75032ab32a3c52445a857daac1dd4639f1ea608fde1de442bff","source_id":"current_project_study_definition:mwdefinition_fb549ea860136ec4fedf:r7:47d0cec7ceedc189","span_id":"es_stat_strategy"}],"evidence_review_advisories":[],"evidence_span_ids":["es_safety_endpoints","es_stat_strategy"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"需项目级文件明确AE/SAE的操作性定义、因果关系判定标准、报告对象与时限","category":"source_missing","gap_id":"gap_73_ae_definition","missing_source_classes":["AE/SAE定义与报告规则"],"target":"7.3节正文"},{"action":"需确认症状性低血压的操作性定义（收缩压阈值、是否需伴症状、处理流程）","category":"source_missing","gap_id":"gap_73_hypotension_def","missing_source_classes":["安全性事件操作定义"],"target":"7.3节正文"},{"action":"需确认生命体征、心电图、实验室检查在各访视的具体实施安排","category":"source_missing","gap_id":"gap_73_visit_schedule","missing_source_classes":["访视实施计划"],"target":"7.3节正文"}],"heading":"安全性评估","missing_source_classes":["AE/SAE操作性定义与报告时限","症状性低血压操作定义","安全性评估各项目的访视实施安排"],"proposal_text":"本研究的安全性评估覆盖治疗期（第1天至第12周）及安全性随访期（末次给药后28天），安全性数据采集与评价贯穿上述全部时期。安全性终点包括：不良事件（AE）与严重不良事件（SAE）发生率，观察窗口至末次给药后28天；生命体征、12导联心电图及临床实验室检查的异常发生率；症状性低血压发生率。安全性分析采用安全性分析集（SAS），以描述性统计方法汇总各安全性终点的发生率与严重程度分布。本研究为概念验证与剂量探索性质，安全性分析不设确证性假设检验，旨在为后续研究提供安全性与耐受性初步证据。","rationale":"安全性终点内容、安全性分析集、描述性统计方法、无确证性假设检验及安全性随访期均来源于已确认研究事实。需医学经理确认：AE/SAE的操作性定义与报告时限、症状性低血压的判定阈值与操作定义、安全性随访期28天是否等同于V8访视、各安全性评估项目在各访视的实施安排。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_415ce4db48b2_650d971f818e8953","section_number":"7.3","source_ids":["protocol_full_draft_selection:941cb4c0feb0d052f653df8a","current_project_study_definition:mwdefinition_fb549ea860136ec4fedf:r7:47d0cec7ceedc189"]},{"ai_run_id":"airun_20261003060117_52be2fef","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"需项目级文件明确生命体征具体测量参数、测量方法、正常值范围及异常判定标准","category":"source_missing","gap_id":"gap_731_vitals_params","missing_source_classes":["生命体征测量参数与方法"],"target":"7.3.1节正文"},{"action":"需项目级文件明确体格检查的具体项目、频率及异常处理流程","category":"source_missing","gap_id":"gap_731_physical_exam","missing_source_classes":["体格检查项目与频率"],"target":"7.3.1节正文"},{"action":"需确认生命体征和体格检查在V1至V8各访视是否均实施及具体安排","category":"source_missing","gap_id":"gap_731_visit_implementation","missing_source_classes":["访视实施计划"],"target":"7.3.1节正文"}],"heading":"生命体征和体格检查","missing_source_classes":["生命体征测量参数与方法","体格检查项目与频率","各访视安全性评估实施计划","异常判定阈值与处理流程"],"proposal_text":"","rationale":"安全性终点中提及生命体征异常发生率作为安全性观察指标，但未提供生命体征的具体测量参数（如血压、心率、体温、呼吸频率等）、测量方法、正常值范围、异常判定阈值、各访视是否均实施以及体格检查的具体项目与频率。访视策略列出V1至V8但未说明各访视是否包含生命体征或体格检查。缺少项目级来源支持，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_415ce4db48b2_ad2a5d8a1df125ae","section_number":"7.3.1","source_ids":["protocol_full_draft_selection:941cb4c0feb0d052f653df8a","current_project_study_definition:mwdefinition_fb549ea860136ec4fedf:r7:47d0cec7ceedc189"]}],"source_bindings":[{"content_sha256":"6589a2184e1a53b7ce5fa06dc686023e348a47b29a646eb0bd3c87cff3caad80","locator":"document:mwdoc_greenfield_proj_user_415ce4db48b2_8deea3cca149a555:full-draft:941cb4c0feb0d052f653df8a","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:941cb4c0feb0d052f653df8a","source_type":"protocol_full_draft_selection","source_version":"full-draft:74bc4d137995a3fbc08798d185a3087639dacc8b6f5d24c66b6f3176731163ab:941cb4c0feb0d052f653df8a","text_sha256":"6589a2184e1a53b7ce5fa06dc686023e348a47b29a646eb0bd3c87cff3caad80"},{"content_sha256":"777cdc93ca4a7fe17e838438578b2466fb5f96c6bb5a3654ef59b0b7d1fbded2","locator":"study_definition:mwdefinition_fb549ea860136ec4fedf:revision:7","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_fb549ea860136ec4fedf:r7:47d0cec7ceedc189","source_type":"current_project_study_definition","source_version":"mwdefinition_fb549ea860136ec4fedf:r7:47d0cec7ceedc189","text_sha256":"777cdc93ca4a7fe17e838438578b2466fb5f96c6bb5a3654ef59b0b7d1fbded2"}]}