,"section_number":"12.3","source_ids":["protocol_full_draft_selection:0b18fa40d4f7a6dd3d0856f8","current_project_study_definition:mwdefinition_fb549ea860136ec4fedf:r7:47d0cec7ceedc189","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261003064230_24c48b16","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:12.2 方案偏离|block:952|chunk:1","quote":"申办者将审查所有方案偏离，并评估是否有严重违背GCP，以及是否要求向卫生主管部门报告。","quote_sha256":"d25517b45959baef1238950be1f20302bb12ced5e0f13f47f237db01e4ef9d8a","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","span_id":"es_002"},{"locator":"section:12.2 方案偏离|block:952|chunk:1","quote":"根据申办者的要求或SOP，偏离方案的前瞻性请求，包括放弃方案合格性标准的请求将不会被允许。","quote_sha256":"8b5479c25517a02284beffcbf64c724fda48c3b021d1d86e622a7400e29e5fb6","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","span_id":"es_003"},{"locator":"study_definition:mwdefinition_fb549ea860136ec4fedf:revision:7","quote":"多中心、随机、双盲、安慰剂平行对照的II期概念验证与剂量探索研究","quote_sha256":"bca314ea800b7e1398db13f2a23194d1be4288995cd580eb27020945e94e709d","source_id":"current_project_study_definition:mwdefinition_fb549ea860136ec4fedf:r7:47d0cec7ceedc189","span_id":"es_004"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003","es_004"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":1},"gap_items":[{"action":"获取本项目方案偏离分类标准（重大/次要）、报告时限、向伦理委员会和卫生主管部门报告的触发条件及路径","category":"source_missing","gap_id":"gap_deviation_01","missing_source_classes":["项目方案偏离分类与报告SOP","伦理委员会偏离报告流程文件","卫生主管部门报告触发条件与路径文件"],"target":"12.4 方案偏离 偏离分类标准与报告时限"},{"action":"检索本项目多中心偏离汇总机制及纠正预防措施（CAPA）跟踪流程","category":"source_not_retrieved","gap_id":"gap_deviation_02","missing_source_classes":["多中心偏离汇总与CAPA跟踪流程文件"],"target":"12.4 方案偏离 各中心偏离汇总与纠正预防措施"}],"heading":"方案偏离","missing_source_classes":["项目方案偏离分类与报告SOP","伦理委员会偏离报告流程文件","卫生主管部门报告触发条件与路径文件"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂平行对照的II期概念验证与剂量探索研究，研究中心数量较多且各中心须严格遵循方案规定的筛选标准、随机化流程、给药方案及访视程序。申办者将审查所有方案偏离，并评估是否构成严重违背药物临床试验质量管理规范，以及是否要求向卫生主管部门报告。根据申办者的要求或标准操作规程，偏离方案的前瞻性请求，包括放弃方案合格性标准的请求，将不被允许。方案偏离的识别、记录、分类、报告及纠正预防措施的具体流程，以申办者标准操作规程及研究中心所在机构的管理要求为准。","rationale":"多中心设计事实来源于当前项目已确认研究事实（修订版7）。申办者审查偏离、评估GCP违背及报告要求、禁止前瞻性偏离请求的表述来源于共享语料中同疾病领域II期方案（CMD-D001-AD II期），作为监管共性结构参照使用。方案偏离的具体分类标准（重大偏离与次要偏离）、报告时限、向伦理委员会和卫生主管部门报告的触发条件、各中心偏离汇总机制等实施细节缺少本项目专属来源，需医学经理和法规事务确认后方可补全。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_415ce4db48b2_f190c84278bd3cbb","section_number":"12.4","source_ids":["protocol_full_draft_selection:0b18fa40d4f7a6dd3d0856f8","current_project_study_definition:mwdefinition_fb549ea860136ec4fedf:r7:47d0cec7ceedc189","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261003064230_24c48b16","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_fb549ea860136ec4fedf:revision:7","quote":"多中心、随机、双盲、安慰剂平行对照的II期概念验证与剂量探索研究","quote_sha256":"bca314ea800b7e1398db13f2a23194d1be4288995cd580eb27020945e94e709d","source_id":"current_project_study_definition:mwdefinition_fb549ea860136ec4fedf:r7:47d0cec7ceedc189","span_id":"es_004"},{"locator":"section:12.4 管理结构|block:957|chunk:1","quote":"申办者或其代理人将执行项目管理、研究管理、监查、供应商管理和统计编程。","quote_sha256":"5834095b23bbc6d48489fa3422974312fd017a35e751e85cb64acbf9efdf593c","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","span_id":"es_005"},{"locator":"section:12.4 管理结构|block:957|chunk:1","quote":"可使用IWRS进行参与者筛查和随机分组，以及研究药物申请和运输的管理。","quote_sha256":"e2f43bda680562b1fcbf856e98d2d35a63b6787b753b92ad2757f7d5b276c189","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","span_id":"es_006"},{"locator":"section:12.4 管理结构|block:957|chunk:1","quote":"研究中心将负责生物样品在运输至申办者或其指定分析单位之前的保存。","quote_sha256":"e9833bd1d90fcf0676024254fc3677e795a508ab32e2f3d1a548b2e81ac2343c","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","span_id":"es_007"},{"locator":"section:文档开头|block:4|chunk:1","quote":"本方案中所包含的所有信息归申办方所有，因此，仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构进行审阅。","quote_sha256":"a95f171292054da4c0e730a5808f9cf1db173b3e9368862f63a2a3c3172a88c6","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","span_id":"es_008"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004","es_005","es_006","es_007","es_008"],"evidence_summary":{"corpus_spans":4,"project_fact_spans":1},"gap_items":[{"action":"确认本项目是否实际使用IWRS、EDC及中心实验室，获取技术架构确认文件","category":"source_not_retrieved","gap_id":"gap_mgmt_01","missing_source_classes":["项目技术架构确认文件（IWRS/EDC/中心实验室部署方案）"],"target":"12.5 关键角色和研究管理 技术系统部署确认"},{"action":"获取本项目各角色（申办者、CRO、研究中心、独立统计师等）职责划分文件及监查计划","category":"source_missing","gap_id":"gap_mgmt_02","missing_source_classes":["各角色职责划分与合同安排文件","监查计划与监查频率文件"],"target":"12.5 关键角色和研究管理 各角色职责与监查安排"}],"heading":"关键角色和研究管理","missing_source_classes":["项目技术架构确认文件（IWRS/EDC/中心实验室部署方案）","各角色职责划分与合同安排文件","监查计划与监查频率文件"],"proposal_text":"本研究为多中心设计，申办者或其代理人将执行项目管理、研究管理、监查、供应商管理和统计编程。可使用交互式网络应答系统进行受试者筛查和随机分组，以及研究药物申请和运输的管理。研究中心将负责生物样品在运输至申办者或其指定分析单位之前的保存。数据将使用电子病例报告表通过电子数据采集系统记录，或以电子方式转发给申办者。本方案中所包含的所有信息归申办方所有，仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构进行审阅；在未得到申办方书面批准的情况下，除在与可能参加本研究的受试者签署知情同意书时向其做必要的解释外，严禁将任何信息告知与本研究无关的第三方。","rationale":"多中心设计事实来源于当前项目已确认研究事实（修订版7）。管理结构、IWRS、EDC、生物样品保存及保密声明的表述来源于共享语料（CMD-D001-AD II期方案管理结构章节及MY004567片/CMS-D005方案保密声明），作为监管共性结构参照使用。本项目是否实际部署IWRS、EDC及中心实验室，各角色的具体职责划分、监查频率、供应商管理范围及统计编程归属等实施细节需以项目实际技术架构和合同安排确认。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_415ce4db48b2_b9daad9d0f60c94d","section_number":"12.5","source_ids":["protocol_full_draft_selection:0b18fa40d4f7a6dd3d0856f8","current_project_study_definition:mwdefinition_fb549ea860136ec4fedf:r7:47d0cec7ceedc189","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261003064230_24c48b16","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取本项目研究中心关闭操作规范，明确关闭触发条件、数据锁定与清理流程、文件归档要求、药物回收与销毁程序、伦理委员会通知及关闭确认函要求","category":"source_missing","gap_id":"gap_close_01","missing_source_classes":["研究中心关闭操作规范或SOP","数据锁定与清理流程文件","研究药物回收与销毁程序文件","伦理委员会通知及关闭确认函模板","关闭后随访与文件归档要求文件"],"target":"12.6 研究和研究中心的关闭 全节"}],"heading":"研究和研究中心的关闭","missing_source_classes":["研究中心关闭操作规范或SOP","数据锁定与清理流程文件","研究药物回收与销毁程序文件","伦理委员会通知及关闭确认函模板"],"proposal_text":"","rationale":"本章节需要项目专属的研究中心关闭流程文件作为来源依据。当前允许来源中未包含任何关于研究关闭触发条件、关闭前数据锁定与清理流程、文件归档要求、研究药物回收与销毁程序、伦理委员会通知程序、研究中心关闭确认函或关闭后随访安排等项目事实或语料内容，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_415ce4db48b2_904ddba2601efa79","section_number":"12.6","source_ids":["protocol_full_draft_selection:0b18fa40d4f7a6dd3d0856f8","current_project_study_definition:mwdefinition_fb549ea860136ec4fedf:r7:47d0cec7ceedc189","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus