a256":"c313c8ef9ed6e2107818bc5d2c8caa143c85bf55ac51060b4e8cc53c959daf6e","source_id":"current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","span_id":"es_29"},{"locator":"study_definition:mwdefinition_2e4d15ec70150b2f54b8:revision:5","quote":"分配模型：平行组","quote_sha256":"5e70b0bc5b3a55e709991ab54941ee36f3a7e04e4d8d776ac74298515efc5ab1","source_id":"current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","span_id":"es_30"},{"locator":"study_definition:mwdefinition_2e4d15ec70150b2f54b8:revision:5","quote":"中心模式：多中心","quote_sha256":"2cfa68bc992967c797bbd3113b5e0d0844d660a2050095a31f08358c5e40311f","source_id":"current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","span_id":"es_31"},{"locator":"study_definition:mwdefinition_2e4d15ec70150b2f54b8:revision:5","quote":"筛选期（第-2周至第0天）：合格性确定；双盲治疗期（第0天至第12周）：随机分组治疗","quote_sha256":"19e4bca6c16312864a13a6f93e22bc5215998e64dc39a552271fe3cffc4c4752","source_id":"current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","span_id":"es_32"}],"evidence_review_advisories":[],"evidence_span_ids":["es_03","es_05","es_24","es_25","es_26","es_27","es_28","es_29","es_30","es_31","es_32"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":11},"gap_items":[{"action":"确认分层随机的具体分层变量（如NYHA II vs III、是否使用ARNI、基线NT-proBNP阈值等）","category":"source_missing","gap_id":"gap_stratification_factors","missing_source_classes":["随机化实施方案","统计分析计划"],"target":"4.3 随机化"},{"action":"确认随机化具体实现方式（区组大小、随机种子生成、随机化统计师角色、IWRS系统配置）","category":"source_missing","gap_id":"gap_randomization_implementation","missing_source_classes":["随机化实施方案","IWRS操作规范"],"target":"4.3 随机化"}],"heading":"随机化","missing_source_classes":["分层随机具体分层因素定义","随机化实施方案（区组大小、随机种子、随机化统计师职责）","IWRS/IRT系统操作规范"],"proposal_text":"本研究采用随机化分配，将合格受试者按1:1:1:1的比例随机分配至SGC-R11 5mg组、SGC-R11 10mg组、SGC-R11 20mg组或安慰剂组，共四个平行治疗组。随机化在随机访视（第0天）完成，采用分层随机方法。随机化分配通过交互式网络应答系统执行，受试者在完成筛选期评估并确认符合入排标准后，于第0天访视时由系统分配至相应治疗组并发放试验用药品。本研究为平行组设计，不设自适应随机或样本量再估计，不进行期中分析，不设置独立数据监查委员会或安全审查委员会。","rationale":"项目已确认四组按1:1:1:1随机分配、分层随机、平行组设计、多中心、无自适应设计、无样本量再估计、无期中分析、无DMC/SRC。随机化在第0天访视完成。但分层随机中具体分层因素（如NYHA分级、是否使用ARNI、基线NT-proBNP水平等）未在项目事实中明确列出，需医学经理确认。随机化方法的具体实现（如区组大小、随机种子生成方式、随机化统计师角色）亦需确认后方可写入。","review_advisories":["本节复述高影响研究设计（随机化）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（期中分析、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bb41368e3c4b_176469687a3e1b62","section_number":"4.3","source_ids":["protocol_full_draft_selection:8632ca18a626b0bcb55db250","current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb71242d679bdb","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322"]},{"ai_run_id":"airun_20261001081938_91a2c166","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_2e4d15ec70150b2f54b8:revision:5","quote":"安慰剂片（外观、包装与试验药一致）：口服，每日一次×12周，按剂量组匹配盲态分配","quote_sha256":"f1edb4c25e996baa8135fc1718affc576b45ec0149bf7cfc75b898145fdcfdbd","source_id":"current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","span_id":"es_04"},{"locator":"study_definition:mwdefinition_2e4d15ec70150b2f54b8:revision:5","quote":"总体研究设计：随机、双盲、安慰剂对照、平行组、多中心II期剂量探索试验","quote_sha256":"61f9ff3ce2d0aa21f4fa0e60669238ececc1087df70777b2d228130d77836202","source_id":"current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","span_id":"es_24"},{"locator":"study_definition:mwdefinition_2e4d15ec70150b2f54b8:revision:5","quote":"期中分析是否计划：否","quote_sha256":"31ef70e7f5cd03d6c17b90802e7352c6e81b5fdc853989b74ea1499901f514a4","source_id":"current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","span_id":"es_27"},{"locator":"study_definition:mwdefinition_2e4d15ec70150b2f54b8:revision:5","quote":"DMC是否计划：否","quote_sha256":"7463c7eb67cd6a318d836f289e02648d5296c8dfe0b2f415f8f2bed6e14be4a2","source_id":"current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","span_id":"es_28"},{"locator":"study_definition:mwdefinition_2e4d15ec70150b2f54b8:revision:5","quote":"SRC是否计划：否","quote_sha256":"c313c8ef9ed6e2107818bc5d2c8caa143c85bf55ac51060b4e8cc53c959daf6e","source_id":"current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","span_id":"es_29"},{"locator":"study_definition:mwdefinition_2e4d15ec70150b2f54b8:revision:5","quote":"筛选期（第-2周至第0天）：合格性确定；双盲治疗期（第0天至第12周）：随机分组治疗","quote_sha256":"19e4bca6c16312864a13a6f93e22bc5215998e64dc39a552271fe3cffc4c4752","source_id":"current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","span_id":"es_32"}],"evidence_review_advisories":[],"evidence_span_ids":["es_04","es_24","es_27","es_28","es_29","es_32"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"确认盲法覆盖的具体人员范围（受试者、研究者、监查员、统计人员、实验室分析人员等）","category":"source_missing","gap_id":"gap_blinding_scope","missing_source_classes":["盲法实施方案","IWRS操作规范"],"target":"4.4 盲法与揭盲"},{"action":"确认紧急揭盲触发条件、操作流程、揭盲后处理、权限人员及培训要求","category":"source_missing","gap_id":"gap_unblinding_procedure","missing_source_classes":["紧急揭盲操作规程","IWRS操作规范"],"target":"4.4 盲法与揭盲"},{"action":"确认PK/PD样本分析实验室的盲态管理方式及非盲人员设置","category":"source_missing","gap_id":"gap_pk_lab_blinding","missing_source_classes":["实验室盲态管理方案"],"target":"4.4 盲法与揭盲"}],"heading":"盲法与揭盲","missing_source_classes":["盲法覆盖范围定义（各角色盲态/非盲态）","紧急揭盲操作规程","揭盲后处理流程","PK/PD实验室盲态管理方案"],"proposal_text":"本研究采用双盲设计。安慰剂片在外观、包装与试验用药品一致，按剂量组匹配进行盲态分配，使受试者和研究者无法通过外观区分试验药与安慰剂。双盲治疗期自第0天随机分组起至第12周治疗结束，安全性随访期延续至末次给药后4周。本研究不进行期中分析，不设置独立数据监查委员会或安全审查委员会，因此研究期间无预设的期中揭盲触发条件。","rationale":"项目已确认双盲设计、安慰剂外观包装与试验药一致、按剂量组匹配盲态分配、无期中分析、无DMC/SRC。但盲法的具体覆盖范围（受试者、研究者、监查员、统计人员、PK/PD实验室分析人员等哪些角色处于盲态）未在项目事实中明确，不得自行指定。紧急揭盲的操作流程、揭盲后处理、揭盲权限人员及培训要求等实施细节亦未确认。上述内容需医学经理与运营团队确认后方可写入正文。","review_advisories":["本节复述高影响研究设计（盲法与揭盲）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（期中分析）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bb41368e3c4b_608f9e6df4074a84","section_number":"4.4","source_ids":["protocol_full_draft_selection:8632ca18a626b0bcb55db250","current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb71242d679bdb","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322"]}],"source_bindings":[{"content_sha256":"89c3157fe25f7ab119f759ce6a6101e35304c66142589370067273b69ed1005b","locator":"document:mwdoc_greenfield_proj_user_bb41368e3c4b_5922bd5fc9a7960d:full-draft:8632ca18a626b0bcb55db250","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:8632ca18a626b0bcb55db250","source_type":"protocol_full_draft_selection","source_version":"full-draft:7c91e7c1f7976522b36f466f3ccd4e65739d7618408eef192af66168a0786719:8632ca18a626b0bcb55db250","text_sha256":"89c3157fe25f7ab119f759ce6a6101e35304c66142589370067273b69ed1005b"},{"content_sha256":"b27186fa03b5e482bdf4807db173a2025f3ebf4adf1f98851cc1c0f8fdd214a1","locator":"study_definition:mwdefinition_2e4d15ec70150b2f54b8:revision:5","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","source_type":"current_project_study_definition","source_version":"mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","text_sha256":"b27186fa03b5e482bdf4807db173a2025f3ebf4adf1f98851cc1c0f8fdd214a1"},{"content_sha