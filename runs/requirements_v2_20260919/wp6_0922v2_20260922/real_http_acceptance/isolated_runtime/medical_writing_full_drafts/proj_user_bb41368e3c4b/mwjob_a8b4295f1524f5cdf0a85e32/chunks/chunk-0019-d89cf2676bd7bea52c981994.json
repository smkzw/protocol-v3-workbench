evidence_span_ids":["es_project_design","es_corpus_monitoring","es_project_region","es_project_multicenter"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":3},"gap_items":[{"action":"获取本项目研究文件清单、文件保存与销毁期限、电子数据采集与管理系统类型及文件传递流程","category":"source_missing","gap_id":"gap_sec12_001","missing_source_classes":["研究文件清单","文件管理SOP"],"target":"12 研究文件、监查和管理"},{"action":"获取本项目监查总体计划，包括监查频率、现场与远程监查比例、监查报告格式及升级机制","category":"source_missing","gap_id":"gap_sec12_002","missing_source_classes":["监查计划","监查SOP"],"target":"12 研究文件、监查和管理"}],"heading":"研究文件、监查和管理","missing_source_classes":["研究文件清单与保存期限规定","电子数据采集系统说明","文件传递与销毁流程","监查计划总体框架"],"proposal_text":"本项研究为在中国开展的随机、双盲、安慰剂对照、平行组、多中心II期剂量探索试验，研究文件的准备、保存、传递与销毁，以及监查与管理活动，均须遵循《药物临床试验质量管理规范》及《赫尔辛基宣言》的相关要求。研究方案、研究者手册、知情同意书、病例报告表、监查计划、安全性报告及伦理委员会批件等文件构成研究文件体系，由申办者统一编制、分发和归档，研究中心须按方案及GCP要求保存原始记录与文件副本。监查与管理活动覆盖方案依从性核查、数据完整性验证、受试者权益保障及安全性监测，具体实施安排详见本章各子节。","rationale":"项目已确认研究设计为多中心II期试验、开发区域为中国，可据此确定适用GCP及赫尔辛基宣言框架。公司语料中CRO监查职责描述（来源为特应性皮炎II期方案）仅作为监管共性结构参照，未迁移其项目事实。本章节为父级组织章节，提供文件体系与监查管理的总体框架描述；具体文件清单、电子系统类型、保存期限及监查频率等实施细节缺少项目来源，列入gap_items。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bb41368e3c4b_dd60988a56581c79","section_number":"12","source_ids":["protocol_full_draft_selection:d89cf2676bd7bea52c981994","current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:9c37052ed864d8","company_corpus:cms_cn_protocol_corpus_20260715_v1:3152bfe8bf762f"]},{"ai_run_id":"airun_20261001094536_19fd5f6c","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:12.2 方案偏离|block:950|chunk:1","quote":"研究方案中规定的所有要求，必须严格执行。任何有意或无意偏离或违背研究方案和GCP原则的行为，均视为偏离方案或违背方案。监查员在监查过程中，如果发现偏离或违背方案，应由研究者或监查员填写偏离方案记录，详细记录事件发生的时间及过程、原因及相应的处理措施，由研究者签字，并根据研究中心相关规定通报伦理委员会及申办者。","quote_sha256":"5835023d355adeb7381fab0ec44d0b5dae2b454a729a4902b3cd66da6650dacc","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8","span_id":"es_corpus_deviation"},{"locator":"study_definition:mwdefinition_2e4d15ec70150b2f54b8:revision:5","quote":"中心模式：多中心","quote_sha256":"2cfa68bc992967c797bbd3113b5e0d0844d660a2050095a31f08358c5e40311f","source_id":"current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","span_id":"es_project_multicenter"}],"evidence_review_advisories":[],"evidence_span_ids":["es_corpus_deviation","es_project_multicenter"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":1},"gap_items":[{"action":"获取本项目方案偏离分级标准（轻微/重大/严重）、偏离报告时限及伦理委员会通报路径","category":"source_missing","gap_id":"gap_sec121_001","missing_source_classes":["方案偏离分级标准","偏离报告SOP"],"target":"12.1 研究方案的依从"},{"action":"确认本项目重大方案违背的评估主体、处理流程及提前终止研究的触发条件","category":"source_missing","gap_id":"gap_sec121_002","missing_source_classes":["重大方案违背处理流程"],"target":"12.1 研究方案的依从"}],"heading":"研究方案的依从","missing_source_classes":["方案偏离分级标准","偏离报告时限规定","伦理委员会通报路径","重大方案违背处理流程"],"proposal_text":"研究方案中规定的所有要求，研究者及研究中心必须严格执行。任何有意或无意偏离或违背研究方案及GCP原则的行为，均视为方案偏离或方案违背。监查员在监查过程中发现方案偏离或违背时，应由研究者或监查员填写方案偏离记录，详细记录事件发生的时间、过程、原因及相应处理措施，由研究者签字确认，并根据研究中心相关规定通报伦理委员会及申办者。所有可能严重违背方案的情况须立即报告申办者；发生重大方案违背时，由研究者和申办者共同评估，必要时申办者可提前终止本研究。本项研究为多中心设计，各研究中心均须遵守上述方案依从要求，具体偏离分级标准、报告时限及伦理通报路径以各中心伦理委员会要求及申办者监查计划为准。","rationale":"公司语料中方案偏离处理框架（来源为CMD-D001-AD II期方案，特应性皮炎适应症）提供了偏离记录、通报及重大违背评估的监管共性结构，本章节仅借用其结构框架，未迁移其项目事实。项目已确认多中心设计，据此写入各中心均须遵守的表述。方案偏离具体分级标准、报告时限、伦理通报路径及重大偏离处理流程缺少本项目文件来源，列入gap_items。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bb41368e3c4b_96be780ddd2ad43f","section_number":"12.1","source_ids":["protocol_full_draft_selection:d89cf2676bd7bea52c981994","current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:9c37052ed864d8","company_corpus:cms_cn_protocol_corpus_20260715_v1:3152bfe8bf762f"]},{"ai_run_id":"airun_20261001094536_19fd5f6c","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:评价CMS-D001在中度至重度特应性皮炎患者中的有效性和安全性的多中心、随机、双盲、安慰剂对照的Ⅱ期临床研究|block:30|chunk:1","quote":"作为合同研究组织，将根据《药物临床试验质量管理规范》的规定及《赫尔辛基宣言》，认真履行监查职责，保证遵循已批准的方案实施本项临床试验，保证临床试验中参与者权益得到保障，试验记录与报告准确、完整、无误。","quote_sha256":"d4fc7a9ff901934569cfc239769e38805879eeba4005423e1fb707bf6933bef2","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:9c37052ed864d8","span_id":"es_corpus_monitoring"},{"locator":"study_definition:mwdefinition_2e4d15ec70150b2f54b8:revision:5","quote":"中心模式：多中心","quote_sha256":"2cfa68bc992967c797bbd3113b5e0d0844d660a2050095a31f08358c5e40311f","source_id":"current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","span_id":"es_project_multicenter"},{"locator":"study_definition:mwdefinition_2e4d15ec70150b2f54b8:revision:5","quote":"开发区域：中国","quote_sha256":"cff843d358ea50e7e53ede8d1eba9b9d23baa740d2cd2134679e6483c3e50b76","source_id":"current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","span_id":"es_project_region"}],"evidence_review_advisories":[],"evidence_span_ids":["es_corpus_monitoring","es_project_multicenter","es_project_region"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":2},"gap_items":[{"action":"获取本项目监查计划，明确各中心监查频率、现场与远程监查比例、监查员资质要求及监查报告格式","category":"source_missing","gap_id":"gap_sec122_001","missing_source_classes":["监查计划","监查SOP"],"target":"12.2 监查"},{"action":"确认本项目监查中发现问题的升级路径、纠正与预防措施要求及申办者响应时限","category":"source_missing","gap_id":"gap_sec122_002","missing_source_classes":["问题升级流程","CAPA要求"],"target":"12.2 监查"}],"heading":"监查","missing_source_classes":["监查计划","监查频率与方式规定","监查报告模板","问题升级与纠正措施流程"],"proposal_text":"本项研究的监查工作由申办者委托的合同研究组织承担，依据《药物临床试验质量管理规范》及《赫尔辛基宣言》履行监查职责，保证研究遵循已批准的方案实施，保证受试者权益得到保障，试验记录与报告准确、完整、无误。鉴于本项研究为多中心设计，监查活动覆盖各参与研究中心，监查内容包括但不限于：核查受试者入组是否符合入选与排除标准、研究药物发放与回收记录、不良事件及严重不良事件的识别与报告、方案依从性、知情同意过程及原始数据与病例报告表的一致性。监查员在每次访视后向申办者提交监查报告，发现影响受试者安全或数据完整性的问题时须及时升级处理。具体监查频率、现场与远程监查安排、监查报告模板及问题升级路径以申办者批准的监查计划为准。","rationale":"公司语料中CRO监查职责描述（来源为CMD-D001-AD II期方案，特应性皮炎适应症）提供了监查框架的监管共性结构参照，本章节仅借用其结构，未迁移其项目事实。项目已确认多中心设计及中国开发区域，据此确定GCP适用及多中心监查覆盖要求。具体监查频率、远程与现场比例、监查报告格式及问题升级路径缺少本项目监查计划来源，列入gap_items。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bb41368e3c4b_3e3e9016296a6e2d","section_number":"12.2","source_ids":["protocol_full_draft_selection:d89cf2676bd7bea52c981994","current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:9c37052ed864d8","company_corpus:cms_cn_protocol_corpus_20260715_v1:3152bfe8bf762f"]}],"source_bindings":[{"content_sha256":"efb04374147c9b67fecbb3427030276f9e52fce1c608eb25ae1b3ca60661debb","locator":"document:mwdoc_greenfield_proj_user_bb41368e3c4b_5922bd5fc9a7960d:full-draft:d89cf2676bd7bea52c981994","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:d89cf2676bd7bea52c981994","source_type":"protocol_full_draft_selection","source_version":"full-draft:7c91e7c1f7976522b36f466f3ccd4e65739d7618408eef192af66168a0786719:d89cf2676bd7bea52c981994","text_sha256":"efb04374147c9b67fecbb3427030276f9e52fce1c608eb25ae1b3ca60661debb"},{"content_sha256":"b27186fa03b5e482bdf4807db173a2025f3ebf4adf1f98851cc1c0f8fdd214a1","locator":"stu