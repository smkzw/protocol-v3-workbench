sha256":"751fee3de79b8ac29cf1b326f63107a4795eca966525605c700b888017d1dc7f","source_id":"current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","span_id":"es3"},{"locator":"study_definition:mwdefinition_2e4d15ec70150b2f54b8:revision:5","quote":"安慰剂片（外观、包装与试验药一致）：口服，每日一次×12周，按剂量组匹配盲态分配，联合相同的标准背景治疗；4组按1:1:1:1随机分配","quote_sha256":"c7981f191a9f2abb30d8fb77d99e2ea62f370077c4f2f1fa77dbb0d78610e145","source_id":"current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","span_id":"es4"},{"locator":"study_definition:mwdefinition_2e4d15ec70150b2f54b8:revision:5","quote":"双盲治疗期（第0天至第12周）：随机分组治疗；安全性随访期（末次给药后4周）：不良事件随访","quote_sha256":"fc07400cde107c5e2bdcb91adc3c9094bf08ea1dd68f1a4324c84766ae614e23","source_id":"current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","span_id":"es8"},{"locator":"study_definition:mwdefinition_2e4d15ec70150b2f54b8:revision:5","quote":"V2随机（D0）：分层随机、发药","quote_sha256":"b65d02d781f2e32811d246a2d9812fc85b927a163815f3f03d95a471f16efa4a","source_id":"current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","span_id":"es9"}],"evidence_review_advisories":[],"evidence_span_ids":["es1","es2","es3","es4","es8","es9"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"需项目医学团队确认背景治疗调整策略及禁限用药清单后补充","category":"source_missing","gap_id":"gap_6_01","missing_source_classes":["合并用药与禁限用药规定"],"target":"标准抗心衰背景治疗在治疗期间的调整规则及合并用药限制"},{"action":"需确认是否设置剂量调整窗口及停药标准","category":"source_missing","gap_id":"gap_6_02","missing_source_classes":["剂量调整暂停恢复永久停药操作细则"],"target":"剂量调整、暂停、恢复及永久停药的操作规则"}],"heading":"研究治疗/干预","missing_source_classes":["合并用药与禁限用药规定","救援治疗与背景治疗调整规则","剂量调整暂停恢复永久停药操作细则"],"proposal_text":"本研究为随机、双盲、安慰剂对照、平行组、多中心II期剂量探索试验，旨在评价口服sGC激动剂SGC-R11在慢性心力衰竭（射血分数降低）成人患者中的剂量-效应关系及初步疗效与安全性。研究设SGC-R11 5mg组、SGC-R11 10mg组、SGC-R11 20mg组和安慰剂组共四个平行治疗组，四组按1:1:1:1比例随机分配。所有受试者在随机分组后接受为期12周的双盲治疗，治疗期间联合指南导向的标准抗心衰背景药物治疗。治疗期内不进行剂量调整；受试者漏服当日不补服，次日按原计划继续给药。双盲治疗期自第0天起至第12周止，末次给药后进入为期4周的安全性随访期。随机分组于第0天访视完成，采用分层随机方法，发药与随机同步进行。","rationale":"四臂设计、1:1:1:1分配、12周疗程、联合标准背景治疗、无剂量调整、漏服不补服、双盲治疗期与安全性随访期时长、分层随机与发药同步等信息均来源于当前项目已确认研究事实。标准背景治疗的具体组成及治疗期间调整规则、合并用药限制、救援治疗策略等实施细节未在项目来源中明确，需医学经理补充确认。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bb41368e3c4b_1834107481ba6472","section_number":"6","source_ids":["protocol_full_draft_selection:491dc87669bce93f239d895f","current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc6f8c9ea6d34b","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:e35a8dbd3c7941"]},{"ai_run_id":"airun_20261001082630_b7e979b8","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_2e4d15ec70150b2f54b8:revision:5","quote":"SGC-R11片口服每日一次，连续12周，联合标准抗心衰背景治疗；设5mg、10mg、20mg三个剂量平行组以探索剂量-效应关系","quote_sha256":"794b0069e3154acb05eed52c8e4d5b0f64bfe63195f167d6a817d2779912b2bd","source_id":"current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","span_id":"es2"},{"locator":"study_definition:mwdefinition_2e4d15ec70150b2f54b8:revision:5","quote":"治疗期内不进行剂量调整；漏服当日不补服","quote_sha256":"751fee3de79b8ac29cf1b326f63107a4795eca966525605c700b888017d1dc7f","source_id":"current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","span_id":"es3"},{"locator":"study_definition:mwdefinition_2e4d15ec70150b2f54b8:revision:5","quote":"安慰剂片（外观、包装与试验药一致）：口服，每日一次×12周，按剂量组匹配盲态分配，联合相同的标准背景治疗；4组按1:1:1:1随机分配","quote_sha256":"c7981f191a9f2abb30d8fb77d99e2ea62f370077c4f2f1fa77dbb0d78610e145","source_id":"current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","span_id":"es4"},{"locator":"study_definition:mwdefinition_2e4d15ec70150b2f54b8:revision:5","quote":"SGC-R11（口服sGC激动剂）","quote_sha256":"7ce62f73b932cca71fd459229ba4dcdd77e67bcbebe3cad0c554d7810c0c39ea","source_id":"current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","span_id":"es6"},{"locator":"study_definition:mwdefinition_2e4d15ec70150b2f54b8:revision:5","quote":"SGC-R11片（5mg/10mg/20mg规格）：口服，每日一次，每晨服用，疗程12周","quote_sha256":"2dedbd4aa8c0bc764f518d49cd1363f463ddbfb2f4835179e618e88517d4c18b","source_id":"current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","span_id":"es7"}],"evidence_review_advisories":[],"evidence_span_ids":["es2","es3","es4","es6","es7"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"需药学部门提供安慰剂处方及片剂外观规格后补充","category":"source_missing","gap_id":"gap_61_01","missing_source_classes":["安慰剂辅料组成及外观描述"],"target":"安慰剂辅料组成及各规格片剂外观描述"},{"action":"需确认包装形式后补充","category":"source_missing","gap_id":"gap_61_02","missing_source_classes":["包装单元形式及每包装含片数"],"target":"包装单元形式及每包装含片数"}],"heading":"试验用药品","missing_source_classes":["安慰剂辅料组成及外观描述","各规格片剂外观描述","包装单元形式及每包装含片数"],"proposal_text":"试验用药品为SGC-R11（口服sGC激动剂），为口服固体制剂，提供5mg、10mg和20mg三种规格。SGC-R11片口服给药，每日一次，每晨服用，疗程12周。安慰剂为外观、包装与试验药一致的安慰剂片，口服给药，每日一次，疗程12周，按剂量组匹配进行盲态分配。SGC-R11各剂量组及安慰剂组均联合相同的标准抗心衰背景治疗。四个治疗组（SGC-R11 5mg、SGC-R11 10mg、SGC-R11 20mg、安慰剂）按1:1:1:1比例随机分配。治疗期内不进行剂量调整；漏服当日不补服。","rationale":"药物名称、三种规格、口服每日一次每晨服用、12周疗程、安慰剂外观包装一致及盲态分配、联合标准背景治疗、四组1:1:1:1随机、无剂量调整及漏服规则均来源于当前项目已确认研究事实。安慰剂具体辅料组成、各规格片剂外观描述（颜色、形状、刻痕）、包装单元形式及每包装含片数等细节未在项目来源中给出，需药学部门确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bb41368e3c4b_b9b93d7d54f4b42a","section_number":"6.1","source_ids":["protocol_full_draft_selection:491dc87669bce93f239d895f","current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c