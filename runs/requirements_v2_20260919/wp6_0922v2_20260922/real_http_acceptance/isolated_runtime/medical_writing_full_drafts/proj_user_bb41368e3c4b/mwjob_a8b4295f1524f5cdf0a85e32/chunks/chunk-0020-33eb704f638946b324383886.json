:"mwsec_greenfield_proj_user_bb41368e3c4b_6b546dde63482d92","section_number":"12.3","source_ids":["protocol_full_draft_selection:33eb704f638946b324383886","current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261001094806_c9a6d7b5","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:12.2 方案偏离|block:952|chunk:1","quote":"申办者将审查所有方案偏离，并评估是否有严重违背GCP，以及是否要求向卫生主管部门报告。根据申办者的要求或SOP，偏离方案的前瞻性请求，包括放弃方案合格性标准的请求将不会被允许。","quote_sha256":"643056aa94c1285201b5f63d6801971893fb90935354b44c77e0839ffc32b390","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","span_id":"es_deviation_review"},{"locator":"document:mwdoc_greenfield_proj_user_bb41368e3c4b_5922bd5fc9a7960d:full-draft:33eb704f638946b324383886","quote":"SECTION_ID=mwsec_greenfield_proj_user_bb41368e3c4b_5143afbc0890da83\n章节编号=12.4\n章节标题=方案偏离\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"5bd808b5d2be858ac1859694dcff997939a71981be07e317e9dd1a23a9c74fc4","source_id":"protocol_full_draft_selection:33eb704f638946b324383886","span_id":"es_deviation_section_empty"}],"evidence_review_advisories":[],"evidence_span_ids":["es_deviation_review","es_deviation_section_empty"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":0},"gap_items":[{"action":"确认本项目方案偏离分类标准（重大偏离与一般偏离的界定）、报告时限及伦理委员会通报要求","category":"source_missing","gap_id":"gap_deviation_01","missing_source_classes":["项目方案偏离分类标准及报告时限","伦理委员会通报要求"],"target":"12.4 方案偏离"},{"action":"确认前瞻性偏离请求（如放弃合格性标准）的处理程序及审批权限","category":"source_missing","gap_id":"gap_deviation_02","missing_source_classes":["前瞻性偏离请求处理程序"],"target":"12.4 方案偏离"}],"heading":"方案偏离","missing_source_classes":["项目方案偏离分类标准及报告时限","伦理委员会通报要求","前瞻性偏离请求处理程序"],"proposal_text":"方案偏离是指任何有意或无意地未遵循本研究方案、相关标准操作规程或适用法规要求的情形。申办者将审查所有方案偏离，并评估是否构成对药物临床试验质量管理规范的严重违背，以及是否需要向卫生主管部门报告。根据申办者标准操作规程，偏离方案的前瞻性请求，包括放弃方案合格性标准的请求，将不被允许。本研究的方案偏离由研究中心在发现后及时记录并报告申办者，申办者依据其质量管理程序对偏离进行分类、评估和处置。","rationale":"方案偏离审查与GCP违背评估原则参照公司语料中CMD-D001-AD II期方案第12.2节（不同适应症、不同申办方），仅作为监管共性结构参照。本项目缺少方案偏离分类标准（重大/一般）、报告时限、伦理委员会通报要求及前瞻性偏离请求处理的项目级规定，需医学经理补充确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bb41368e3c4b_5143afbc0890da83","section_number":"12.4","source_ids":["protocol_full_draft_selection:33eb704f638946b324383886","current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261001094806_c9a6d7b5","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:12.4 管理结构|block:957|chunk:1","quote":"申办者或其代理人将执行项目管理、研究管理、监查、供应商管理和统计编程。可使用IWRS进行参与者筛查和随机分组，以及研究药物申请和运输的管理。研究中心将负责生物样品在运输至申办者或其指定分析单位之前的保存。数据将使用eCRFs通过EDC系统记录，或以电子方式转发给申办者（例如，药代动力学数据）。","quote_sha256":"6c7271f4ed3fd8fedd8e75159484480005fc72345847383d098e28d5130237d6","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","span_id":"es_mgmt_structure"},{"locator":"document:mwdoc_greenfield_proj_user_bb41368e3c4b_5922bd5fc9a7960d:full-draft:33eb704f638946b324383886","quote":"SECTION_ID=mwsec_greenfield_proj_user_bb41368e3c4b_14905d8795e075f1\n章节编号=12.5\n章节标题=关键角色和研究管理\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"a1399107e9df12fda6518e0167dcbe5db508316b2cf8a8dc27fe0453b091492b","source_id":"protocol_full_draft_selection:33eb704f638946b324383886","span_id":"es_role_section_empty"},{"locator":"study_definition:mwdefinition_2e4d15ec70150b2f54b8:revision:5","quote":"总体研究设计：随机、双盲、安慰剂对照、平行组、多中心II期剂量探索试验","quote_sha256":"61f9ff3ce2d0aa21f4fa0e60669238ececc1087df70777b2d228130d77836202","source_id":"current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","span_id":"es_study_design"}],"evidence_review_advisories":[],"evidence_span_ids":["es_mgmt_structure","es_role_section_empty","es_study_design"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":1},"gap_items":[{"action":"确认本项目具体角色清单（医学监查员、数据管理员、统计师、药物安全专员、IWRS管理员、中心实验室等）及各自职责","category":"source_missing","gap_id":"gap_role_01","missing_source_classes":["项目角色分工及职责描述"],"target":"12.5 关键角色和研究管理"},{"action":"确认IWRS、EDC、中心实验室等供应商的管理职责归属及数据流转路径","category":"source_missing","gap_id":"gap_role_02","missing_source_classes":["IWRS及EDC系统管理职责","供应商管理范围及职责"],"target":"12.5 关键角色和研究管理"}],"heading":"关键角色和研究管理","missing_source_classes":["项目角色分工及职责描述","IWRS及EDC系统管理职责","供应商管理范围及职责"],"proposal_text":"本研究由申办者负责整体项目管理与研究管理。申办者或其代理人将执行项目管理、研究管理、监查、供应商管理和统计编程等职能。研究中心将负责生物样品在运输至申办者或其指定分析单位之前的保存。数据将使用电子病例报告表通过电子数据采集系统记录，或以电子方式转发给申办者。本研究为多中心设计，各研究中心由主要研究者负责本中心的研究实施与受试者安全管理。","rationale":"管理结构描述参照公司语料中CMD-D001-AD II期方案第12.4节（不同适应症、不同申办方），仅作为监管共性章节结构参照。本项目缺少具体角色分工（如医学监查员、数据管理员、统计师、药物安全专员、IWRS管理员等）及职责描述的项目级来源，需医学经理确认各角色职责边界。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_bb41368e3c4b_14905d8795e075f1","section_number":"12.5","source_ids":["protocol_full_draft_selection:33eb704f638946b324383886","current_project_study_definition:mwdefinition_2e4d15ec70150b2f54b8:r5:3b192f25f867c4a8","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","compa