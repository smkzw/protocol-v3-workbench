":"9bd5fd21a15316c3c80d6126372a72eccba8ebc6cda070fd09f4c7804cff1c7a","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_003"}],"evidence_review_advisories":[],"evidence_span_ids":["es_001","es_002","es_003"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"需项目安全性监测计划或访视操作手册明确各评估项目的实施时点与频率","category":"source_missing","gap_id":"gap_81_assessment_schedule","missing_source_classes":["项目安全性监测计划","访视操作手册"],"target":"8.1总则中各安全性评估项目的具体实施访视与频率"}],"heading":"总则","missing_source_classes":[],"proposal_text":"本研究为多中心、随机、双盲、安慰剂对照加活性对照的II期临床研究，安全性监测贯穿筛选期（2周）、双盲治疗期（8周）及安全随访期（2周）全过程。安全性评估内容包括不良事件（重点关注头晕、嗜睡和步态异常）、生命体征、心电图及实验室检查。访视安排涵盖筛选、基线、第2周、第4周、第8周及安全随访访视，受试者在治疗期间通过电子疼痛日记每日记录NRS评分。安全性数据的采集、记录、分类、报告及随访管理遵循本章节后续各节所规定的定义与程序。","rationale":"安全性终点范围（头晕、嗜睡、步态异常、生命体征、心电图、实验室）和研究时期（筛选2周、双盲治疗8周、安全随访2周）及访视策略均来自当前项目已确认研究事实。各安全性评估项目的具体实施访视、频率和判定阈值未在项目来源中逐项列出，需医学经理确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_a67458cd1359_765f258ee8f11669","section_number":"8.1","source_ids":["protocol_full_draft_selection:0ab1a3597d771d44f1d29a06","current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","company_corpus:cms_cn_protocol_corpus_20260715_v1:9d9f7af69b49a5","company_corpus:cms_cn_protocol_corpus_20260715_v1:575d8d3f051337","company_corpus:cms_cn_protocol_corpus_20260715_v1:3dd33acad4df73","company_corpus:cms_cn_protocol_corpus_20260715_v1:3f194f5112122b","company_corpus:cms_cn_protocol_corpus_20260715_v1:738400441c16d5"]},{"ai_run_id":"airun_20261006160237_765b06fd","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","quote":"安全性终点：不良事件（头晕、嗜睡、步态异常）、生命体征、心电图、实验室。","quote_sha256":"ebbfdafe46df31de2fff98d3ff2dc429809e9376fa85b71b9019b36902703004","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_001"},{"locator":"section:不良事件的严重程度评估|block:766|chunk:1","quote":"区分SAE和重度不良事件非常重要。严重程度是强度表现（如上文所定义），而SAE是根据第8.2.4节中的标准定义的。重度不良事件可能不被视为SAE。","quote_sha256":"3e32900c5b54b9a9019b7a9871d86d63d3619f84ecd2989917773afd8d8131d6","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:3dd33acad4df73","span_id":"es_005"}],"evidence_review_advisories":[],"evidence_span_ids":["es_001","es_005"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":1},"gap_items":[{"action":"需项目级AE定义文件或方案编写规范确认是否采用CTCAE v6.0或其他分级工具","category":"source_missing","gap_id":"gap_82_ae_definition_source","missing_source_classes":["项目AE定义文件","方案编写规范"],"target":"8.2定义章节中不良事件的完整定义、严重程度分级标准及因果关系判定规则"},{"action":"需项目级SAE定义文件确认是否采用ICH E2A框架及具体报告时限","category":"source_missing","gap_id":"gap_82_sae_definition_source","missing_source_classes":["项目SAE定义文件","ICH E2A适用性确认"],"target":"8.2定义章节中严重不良事件的完整定义及判定标准"}],"heading":"定义","missing_source_classes":[],"proposal_text":"本章节对研究方案中使用的安全性相关术语进行统一定义。不良事件指受试者在接受研究药物后出现的任何不良医学事件，不论是否与研究药物存在因果关系；本研究重点关注头晕、嗜睡和步态异常等与Nav1.7通道阻滞剂药理作用相关的不良事件。严重不良事件与不良事件的严重程度为不同维度：严重程度反映事件的强度表现，而严重不良事件依据其临床后果进行判定。重度不良事件不一定构成严重不良事件，反之亦然。","rationale":"不良事件重点关注类型（头晕、嗜睡、步态异常）来自当前项目已确认研究事实。SAE与重度AE为不同维度的区分原则来源于公司语料中其他项目的方案文本，作为监管共性结构参照使用，本项目是否采用相同定义框架及具体判定标准需医学经理确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_a67458cd1359_5eedaa5aecea9e30","section_number":"8.2","source_ids":["protocol_full_draft_selection:0ab1a3597d771d44f1d29a06","current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","company_corpus:cms_cn_protocol_corpus_20260715_v1:9d9f7af69b49a5","company_corpus:cms_cn_protocol_corpus_20260715_v1:575d8d3f051337","company_corpus:cms_cn_protocol_corpus_20260715_v1:3dd33acad4df73","company_corpus:cms_cn_protocol_corpus_20260715_v1:3f194f5112122b","company_corpus:cms_cn_protocol_corpus_20260715_v1:738400441c16d5"]},{"ai_run_id":"airun_20