n_number":"2.3.2","source_ids":["protocol_full_draft_selection:911abe05068631830af10ef9","current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:5425c4f8e6c0a6"]},{"ai_run_id":"airun_20261006150117_d2a7363c","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","quote":"内在研究目的：概念验证（PoC）；剂量探索","quote_sha256":"2d096e242bbd65d0c9236718d79e77a388e84cb9640b99bd47662a6ce8faab31","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_02"},{"locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","quote":"目标研究人群：带状疱疹后神经痛（皮疹愈合后≥3个月，NRS≥4分），既往普瑞巴林/加巴喷丁疗效不佳或不耐受。","quote_sha256":"c003b05ce55f9ce82bc58911ea299656bf743c8bb4c193fe745ce4307109c2f9","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_04"},{"locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","quote":"试验药物：KZ-PHN902（口服Nav1.7通道选择性阻滞剂片）","quote_sha256":"1f71950d3b663a18c39184b74c310785c5c93aa9bcf3ddd53f3932a6547d9984","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_09"},{"locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","quote":"剂量与给药方案：KZ-PHN902（口服Nav1.7通道选择性阻滞剂片）：KZ-PHN902片 每日两次；活性对照组普瑞巴林 150mg→300mg BID按耐受滴定。","quote_sha256":"54c82da411fa3a09508e74f706c360c10d6d36074c1540512ebe546804f3c0e1","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_10"},{"locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","quote":"研究人群概述：18-80岁带状疱疹后神经痛（皮疹愈合后≥3个月），平均24小时NRS≥4分，既往≥1种一线镇痛方案（普瑞巴林/加巴喷丁/度洛西汀）疗效不佳或不耐受。","quote_sha256":"5c22e701bdb68c5c535ebf3e1680f187fe33325812bd68de7eb0a776f2c46bee","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_14"},{"locator":"document:mwdoc_greenfield_proj_user_a67458cd1359_a18e0421704cd8b4:full-draft:911abe05068631830af10ef9","quote":"SECTION_ID=mwsec_greenfield_proj_user_a67458cd1359_9818240548991233\n章节编号=2.4\n章节标题=本研究的理论基础\n章节类型=section\n当前正文=概念验证（PoC）；剂量探索","quote_sha256":"bc976f767e7f77f4cc6544568c7e93551d60006b57db9f34e2ea8319d6617ec0","source_id":"protocol_full_draft_selection:911abe05068631830af10ef9","span_id":"es_16"}],"evidence_review_advisories":[],"evidence_span_ids":["es_02","es_04","es_09","es_10","es_14","es_16"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"请提供KZ-PHN902非临床药效学摘要（含Nav1.7选择性数据、动物模型疗效）及Nav1.7通道在神经病理性疼痛中的机制综述，以充实机制层面的理论论证。","category":"source_missing","gap_id":"gap_24_01","missing_source_classes":["非临床药效学数据","靶点机制文献"],"target":"2.4 本研究的理论基础"}],"heading":"本研究的理论基础","missing_source_classes":["KZ-PHN902非临床药效学及药代动力学数据","Nav1.7通道在PHN中的机制文献","KZ-PHN902受体选择性及脱靶效应数据"],"proposal_text":"KZ-PHN902为口服Nav1.7通道选择性阻滞剂片，本研究为II期概念验证与剂量探索研究。设计依据如下：第一，带状疱疹后神经痛的核心病理机制涉及受损感觉神经元异常放电，Nav1.7通道作为伤害性感觉传入的关键电压门控钠通道亚型，其选择性阻滞在理论上可抑制异位放电而不影响正常神经传导，为区别于现有钙通道调节剂（普瑞巴林、加巴喷丁）提供了新的作用靶点假设。第二，鉴于该靶点在人体中的有效性尚未经充分验证，本研究以概念验证为首要目标，同时通过100mg与200mg两个剂量组探索剂量-效应关系，为后续III期剂量选择提供依据。第三，设置普瑞巴林活性对照组旨在建立KZ-PHN902与现有标准治疗之间的初步比较框架，同时保留安慰剂对照以确认绝对疗效信号。第四，目标人群限定为皮疹愈合后持续至少3个月、平均24小时NRS评分不低于4分、且既往至少一种一线镇痛方案（普瑞巴林、加巴喷丁或度洛西汀）疗效不佳或不耐受的带状疱疹后神经痛患者，该人群代表当前临床中尚未满足的治疗需求，且有助于在概念验证阶段获得可解释的疗效信号。第五，双盲双模拟设计（KZ-PHN902片与安慰剂片、普瑞巴林胶囊与安慰剂胶囊）确保受试者与研究者对分组均处于盲态，减少主观评价偏倚。","rationale":"本章节基于已确认的项目研究事实撰写：药物靶点（Nav1.7通道选择性阻滞剂）、研究目的（概念验证与剂量探索）、三组设计（100mg/200mg/普瑞巴林）、双盲双模拟、目标人群定义及既往一线治疗不佳的入组逻辑。Nav1.7通道在伤害性感觉传入中的角色为药理学通识，但KZ-PHN902自身的非临床药效学数据、受体选择性谱及脱靶效应信息未在允许来源中提供，医学经理需核实机制描述是否与研究药物实际非临床数据一致，并补充或修正相关表述。","review_advisories":["本节提及高影响设计信息（剂量选择）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_a67458cd1359_9818240548991233","section_number":"2.4","source_ids":["protocol_full_draft_selection:911abe05068631830af10ef9","current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:5425c4f8e6c0a6"]},{"ai_run_id":"airun_20261006150117_d2a7363c","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","quote":"目标研究人群：带状疱疹后神经痛（皮疹愈合后≥3个月，NRS≥4分），既往普瑞巴林/加巴喷丁疗效不佳或不耐受。","quote_sha256":"c003b05ce55f9ce82bc58911ea299656bf743c8bb4c193fe745ce4307109c2f9","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_04"},{"locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","quote":"安全性终点：不良事件（头晕、嗜睡、步态异常）、生命体征、心电图、实验室。","quote_sha256":"ebbfdafe46df31de2fff98d3ff2dc429809e9376fa85b71b9019b36902703004","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_05"},{"locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","quote":"主要终点：第8周24小时平均疼痛NRS评分较基线的变化。","quote_sha256":"30c910291493d13362fd2531811021bf2ef27588db762f8f66a789c09dac2ec4","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_06"},{"locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","quote":"关键次要终点：第8周NRS较基线下降≥30%/≥50%应答率、睡眠干扰评分（NRS-SI）、PGIC。","quote_sha256":"f0c1218e627792e6e2623abf9fda337ade83863c32076e077e50e02a4ff5adc5","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_07"},{"locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","quote":"研究时期：筛选2周；双盲治疗8周；安全随访2周。","quote_sha256":"9bd5fd21a15316c3c80d6126372a72eccba8ebc6cda070fd09f4c7804cff1c7a","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_08"},{"locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","quote":"访视策略：筛选、基线、第2/4/8周、安全随访；电子疼痛日记每日NRS记录。","quote_sha256":"bebbc02600c20a056fa50c49f78b2590eff65c72150fac1c48f586cfaf64f4a4","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_15"},{"locator":"document:mwdoc_greenfield_proj_user_a67458cd1359_a18e0421704cd8b4:full-draft:911abe05068631830af10ef9","quote":"SECTION_ID=mwsec_greenfield_proj_user_a67458cd1359_05363cd87928e4dd\n章节编号=2.5\n章节标题=获益/风险评估\n章节类型=section\n当前正文=带状疱疹后神经痛（皮疹愈合后≥3个月，NRS≥4分），既往普瑞巴林/加巴喷丁疗效不佳或不耐受。\n不良事件（头晕、嗜睡、步态异常）、生命体征、心电图、实验室。","quote_sha256":"a64ab648a7e67b508ae6c9d6b9a00dbe44e38ac5ead7eeef14f5b2e8bf9d15d9","source_id":"protocol_full_draft_selection:911abe05068631830af10ef9","span_id":"es_17"}],"evidence_review_advisories":[],"evidence_span_ids":["es_04","es_05","es_06","es_07","es_08","es_15","es_17"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"请提供KZ-PHN902研究者手册中的已知风险、非临床安全性摘要及同类Nav1.7阻滞剂已报告的安全性信号，以便补充具体风险评估内容。","category":"source_missing","gap_id":"gap_25_01","missing_source_classes":["研究者手册（IB）","非临床安全性数据","同类药物安全性文献"],"target":"2.5 获益/风险评估"}],"heading":"获益/风险评估","missing_source_classes":["KZ-PHN902研究者手册（IB）","非临床安全性数据","Nav1.7通道阻滞剂类效应文献"],"proposal_text":"本研究的获益预期基于以下已确认事实：目标人群为皮疹愈合后持续至少3个月、平均24小时NRS评分不低于4分、且既往至少一种一线镇痛方案（普瑞巴林、加巴喷丁或度洛西汀）疗效不佳或不耐受的带状疱疹后神经痛患者，该人群当前缺乏有效替代治疗，存在明确的未满足医疗需求。KZ-PHN902作为Nav1.7通道选择性阻滞剂，其理论获益在于通过阻断伤害性感觉神经元异常放电减轻神经病理性疼痛，作用机制与现有钙通道调节剂不同，有望为一线治疗失败的患者提供新的治疗选择。主要疗效终点为第8周24小时平均疼痛NRS评分较基线的变化，辅以NRS下降不低于30%和不低于50%的应答率、睡眠干扰评分及患者总体印象变化评估，以多维度捕捉疼痛缓解及功能改善。安全性评估覆盖不良事件（重点关注头晕、嗜睡、步态异常等与钠通道阻滞相关的中枢及前庭效应）、生命体征、心电图及实验室检查，研究时期包括筛选2周、双盲治疗8周及安全随访2周，访视节点为筛选、基线、第2周、第4周、第8周及安全随访，期间通过电子疼痛日记每日记录NRS。","rationale":"本章节依据已确认的目标人群定义、主要及关键次要终点、安全性评估范围（头晕、嗜睡、步态异常、生命体征、心电图、实验室）、研究时期（筛选2周/治疗8周/随访2周）及访视策略撰写。KZ-PHN902的具体已知风险（如Nav1.7阻滞剂类效应、心脏离子通道影响、中枢神经系统效应）及非临床安全性数据未在允许来源中提供，需医学经理依据研究者手册补充后方可完善风险评估部分。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_a67458cd1359_05363cd87928e4dd","section_number":"2.5","source_ids":["protocol_full_draft_selection:911abe05068631830af10ef9","current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:5425c4f8e6c0a6"]},{"ai_run_id":"airun_20261006150117_d2a7363c","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","quote":"内在研究目的：概念验证（PoC）；剂量探索","quote_sha256":"2d096e242bbd65d0c9236718d79e77a388e84cb9640b99bd47662a6ce8faab31","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_02"},{"locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","quote":"安全性终点：不良事件（头晕、嗜睡、步态异常）、生命体征、心电图、实验室。","quote_sha256":"ebbfdafe46df31de2fff98d3ff2dc429809e9376fa85b71b9019b36902703004","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_05"},{"locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","quote":"主要终点：第8周24小时平均疼痛NRS评分较基线的变化。","quote_sha256":"30c910291493d13362fd2531811021bf2ef27588db762f8f66a789c09dac2ec4","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_06"},{"locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","quote":"关键次要终点：第8周NRS较基线下降≥30%/≥50%应答率、睡眠干扰评分（NRS-SI）、PGIC。","quote_sha256":"f0c1218e627792e6e2623abf9fda337ade83863c32076e077e50e02a4ff5adc5","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_07"},{"locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","quote":"估计目标策略：治疗政策策略：主要终点为第8周24h平均NRS自基线变化；急救对乙酰氨基酚不改变归属；脱落不替换按ITT入FAS。","quote_sha256":"15dba4019d37a2d2a8a6e8c632d4f61eeab077c8a0cfd9e0fb8493aab00cc03a","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_12"},{"locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","quote":"统计分析策略：主要终点MMRM（治疗组、访视、交互、基线NRS、中心）；FAS主分析；KZ-PHN902两剂量vs安慰剂Holm；活性对照描述性比较；SS安全描述。","quote_sha256":"f50356ea93fb1521c709c4fce7e52c45bdcbc6a659f47655c32c2fdde010e126","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_13"},{"locator":"document:mwdoc_greenfield_proj_user_a67458cd1359_a18e0421704cd8b4:full-draft:911abe05068631830af10ef9","quote":"SECTION_ID=mwsec_greenfield_proj_user_a67458cd1359_8e94acbf4ae59543\n章节编号=3\n章节标题=研究目的和终点\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"dcdaf31e40b2e1606bb1a5019ccbf988df3e7a490bd7fb11fd6c596cb5a5f25f","source_id":"protocol_full_draft_selection:911abe05068631830af10ef9","span_id":"es_18"}],"evidence_review_advisories":[],"evidence_span_ids":["es_02","es_05","es_06","es_07","es_12","es_13","es_18"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"请医学经理确认是否需要设置探索性目的或终点（如药代动力学采样、生物标志物、生活质量量表等）；当前正文按不设置处理。","category":"decision_pending","gap_id":"gap_3_01","missing_source_classes":[],"target":"3 研究目的和终点"}],"heading":"研究目的和终点","missing_source_classes":[],"proposal_text":"本研究为II期概念验证与剂量探索研究，旨在评估口服Nav1.7通道选择性阻滞剂KZ-PHN902在带状疱疹后神经痛患者中的初步疗效与安全性，并为后续开发阶段的剂量选择提供依据。主要疗效终点为第8周24小时平均疼痛NRS评分较基线的变化，采用治疗政策策略估计目标，急救对乙酰氨基酚的使用不改变受试者归属，脱落受试者不替换，按意向治疗原则纳入全分析集。关键次要终点包括第8周NRS较基线下降不低于30%的应答率、第8周NRS较基线下降不低于50%的应答率、睡眠干扰评分（NRS-SI）及患者总体印象变化（PGIC）。安全性终点包括不良事件（重点关注头晕、嗜睡、步态异常）、生命体征、心电图及实验室检查。主要终点统计分析采用混合效应模型重复测量（MMRM），固定效应包括治疗组、访视、治疗与访视交互项、基线NRS及中心；KZ-PHN902两个剂量组与安慰剂组的比较采用Holm法控制多重性，活性对照组的比较以描述性方式呈现；安全性分析基于安全分析集进行描述性汇总。本研究不设置探索性目的或探索性终点。","rationale":"本章节依据已确认的研究目的（概念验证与剂量探索）、主要终点（第8周24h平均NRS较基线变化）、关键次要终点（NRS≥30%/≥50%应答率、NRS-SI、PGIC）、安全性终点（头晕、嗜睡、步态异常、生命体征、心电图、实验室）、估计目标策略（治疗政策策略、急救对乙酰氨基酚不改变归属、脱落不替换、ITT入FAS）及统计分析策略（MMRM、Holm、描述性活性对照比较、SS安全描述）撰写。探索性目的与终点未在当前项目事实中设置，本章节明确声明不设置；若医学经理认为需增加探索性终点，需另行确认后方可修改。","review_advisories":["本节复述高影响研究设计（研究目的和终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、估计目标、剂量选择）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_a67458cd1359_8e94acbf4ae59543","section_number":"3","source_ids":["protocol_full_draft_selection:911abe05068631830af10ef9","current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:5425c4f8e6c0a6"]}],"source_bindings":[{"content_sha256":"952624ea3ba51b736140d8f3d21351c845c499c8fa16d111f8a6e11bd4cbc50f","locator":"document:mwdoc_greenfield_proj_user_a67458cd1359_a18e0421704cd8b4:full-draft:911abe05068631830af10ef9","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:911abe05068631830af10ef9","source_type":"protocol_full_draft_selection","source_version":"full-draft:a152920577fe3f6cd0dd4d514ed3426624fe83e1be3d143cacd