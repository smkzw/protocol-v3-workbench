:"6.4","source_ids":["protocol_full_draft_selection:b3fe02ab6588610fca3bc7c8","current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7"]},{"ai_run_id":"airun_20261006153119_2acaef93","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","quote":"访视策略：筛选、基线、第2/4/8周、安全随访；电子疼痛日记每日NRS记录。","quote_sha256":"bebbc02600c20a056fa50c49f78b2590eff65c72150fac1c48f586cfaf64f4a4","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_65_diary"},{"locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","quote":"估计目标策略：治疗政策策略：主要终点为第8周24h平均NRS自基线变化；急救对乙酰氨基酚不改变归属；脱落不替换按ITT入FAS。","quote_sha256":"15dba4019d37a2d2a8a6e8c632d4f61eeab077c8a0cfd9e0fb8493aab00cc03a","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_65_policy"}],"evidence_review_advisories":[],"evidence_span_ids":["es_65_diary","es_65_policy"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"确认依从性评估方法（药片计数、日记完成率、或其他）及合格阈值后补充正文。","category":"source_missing","gap_id":"gap_65_01","missing_source_classes":["依从性量化方法与阈值"],"target":"6.5 研究治疗依从性 依从性量化方法与阈值"},{"action":"确认依从性评估是否在每个访视实施及具体评估时点，不得由访视日推断。","category":"source_missing","gap_id":"gap_65_02","missing_source_classes":["依从性评估频率与访视绑定规则"],"target":"6.5 研究治疗依从性 依从性评估频率"}],"heading":"研究治疗依从性","missing_source_classes":["依从性量化方法与阈值","依从性评估频率与访视绑定规则","不依从处理与退出标准"],"proposal_text":"本研究采用治疗政策策略，主要终点为第8周24小时平均疼痛NRS评分较基线的变化；急救对乙酰氨基酚的使用不改变受试者的治疗组归属，脱落受试者不进行替换，所有随机化受试者按意向治疗原则纳入全分析集。受试者在双盲治疗期8周内须通过电子疼痛日记每日记录24小时平均NRS评分，该日记数据同时作为疼痛疗效评价和依从性辅助参考。研究访视安排为筛选、基线、第2周、第4周、第8周及安全随访，各访视的具体依从性评估方法与判定阈值将在方案正式定稿时由医学负责人依据项目安全性管理计划确定。","rationale":"已确认事实支持：治疗政策策略（急救对乙酰氨基酚不改变归属、脱落不替换、ITT入FAS）、电子疼痛日记每日NRS记录、访视策略（筛选、基线、第2/4/8周、安全随访）。缺少依从性量化方法（药片计数、日记完成率阈值）、依从性评估频率及不依从处理规则的项目级来源，需医学经理补充确认。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_a67458cd1359_48bad1596c9fb127","section_number":"6.5","source_ids":["protocol_full_draft_selection:b3fe02ab6588610fca3bc7c8","current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7"]}],"source_bindings":[{"content_sha256":"424ce2d882f187c651e521d6aee4d285b467b63bcccbdd655c540e4c62aa75f2","locator":"document:mwdoc_greenfield_proj_user_a67458cd1359_a18e0421704cd8b4:full-draft:b3fe02ab6588610fca3bc7c8","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:b3fe02ab6588610fca3bc7c8","source_type":"protocol_full_draft_selection","source_version":"full-draft:a152920577fe3f6cd0dd4d514ed3426624fe83e1be3d143cacd52d1c030f8204:b3fe02ab6588610fca3bc7c8","text_sha256":"424ce2d882f187c651e521d6aee4d285b467b63bcccbdd655c540e4c62aa75f2"},{"content_sha256":"8ac76f6f006a3f528aebf01a5d650a62e945d42e846872e07315a6ec091b0478","locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","source_type":"current_project_study_definition","source_version":"mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","text_sha256":"8ac76f6f006a3f528aebf01a5d650a62e945d42e846872e07315a6ec091b0478"}]}