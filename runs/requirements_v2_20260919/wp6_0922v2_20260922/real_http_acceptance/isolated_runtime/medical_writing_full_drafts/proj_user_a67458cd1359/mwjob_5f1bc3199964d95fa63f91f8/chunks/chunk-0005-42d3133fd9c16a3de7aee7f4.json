t_spans":1},"gap_items":[{"action":"补充项目级盲法管理计划或揭盲操作规程，明确各角色盲态范围、紧急揭盲触发条件、揭盲后数据处理及非盲人员职责","category":"source_missing","gap_id":"gap_blind_scope","missing_source_classes":["盲法管理计划","揭盲操作规程"],"target":"盲态维持人员范围及紧急揭盲流程"}],"heading":"盲法与揭盲","missing_source_classes":["盲法管理计划或揭盲操作规程","非盲人员职责与沟通流程文件"],"proposal_text":"本研究采用双盲设计。受试者按1:1:1的比例随机分配至KZ-PHN902 100mg组、KZ-PHN902 200mg组和普瑞巴林活性对照组，同时设置安慰剂对照。为维持盲态，采用双盲双模拟方法：KZ-PHN902组受试者接受KZ-PHN902活性片及与普瑞巴林外观匹配的安慰剂片，普瑞巴林组受试者接受普瑞巴林活性片及与KZ-PHN902外观匹配的安慰剂片，使各组受试者每日服用相同数量和外观的药片。随机分配由独立于研究中心的随机化系统生成，随机序列不向研究中心和受试者公开。","rationale":"双盲、1:1:1、双盲双模拟及三组构成（KZ-PHN902 100mg、200mg、普瑞巴林）为已确认研究设计事实。盲态维持的具体人员范围（研究者、评价者、数据监查人员等）、紧急揭盲触发条件与流程、揭盲后数据处理规则及非盲人员职责在本批次允许来源中未提供，需补充项目级盲法管理文件后完善。","review_advisories":["本节复述高影响研究设计（盲法与揭盲）；请在合并设计摘要中统一核对。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_a67458cd1359_528d88956bc36b35","section_number":"4.4","source_ids":["protocol_full_draft_selection:42d3133fd9c16a3de7aee7f4","current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7"]},{"ai_run_id":"airun_20261006152229_9f385a04","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_a67458cd1359_a18e0421704cd8b4:full-draft:42d3133fd9c16a3de7aee7f4","quote":"筛选2周；双盲治疗8周；安全随访2周。","quote_sha256":"73d0a6e68e6713d9221d46d2553c054e5aef58f096eb945bcd173ce881c59fd5","source_id":"protocol_full_draft_selection:42d3133fd9c16a3de7aee7f4","span_id":"es_duration_1"},{"locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","quote":"研究时期：筛选2周；双盲治疗8周；安全随访2周。","quote_sha256":"9bd5fd21a15316c3c80d6126372a72eccba8ebc6cda070fd09f4c7804cff1c7a","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_duration_2"}],"evidence_review_advisories":[],"evidence_span_ids":["es_duration_1","es_duration_2"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[{"action":"补充逐访视评估项目清单，明确哪些评估在哪些访视实施，避免从访视日推断所有评估均执行","category":"source_missing","gap_id":"gap_visit_assessments","missing_source_classes":["访视计划表","逐访视评估项目清单"],"target":"各访视具体评估项目（实验室、心电图、体格检查、依从性评价等）"}],"heading":"研究结束与研究持续时间","missing_source_classes":["逐访视评估项目清单（访视计划表）"],"proposal_text":"本研究总持续时间为12周，由以下三个连续时期组成：筛选期2周，用于完成知情同意、入选与排除标准评估及基线数据采集；双盲治疗期8周，受试者按随机分配接受KZ-PHN902 100mg、KZ-PHN902 200mg或普瑞巴林每日两次口服给药；安全随访期2周，用于观察末次给药后不良事件转归及安全性评估。访视安排包括筛选访视、基线访视、第2周访视、第4周访视、第8周访视（治疗结束）及安全随访访视。治疗期间受试者通过电子疼痛日记每日记录24小时平均疼痛NRS评分。","rationale":"筛选2周、双盲治疗8周、安全随访2周及访视节点（筛选、基线、第2/4/8周、安全随访）和电子疼痛日记每日NRS记录为已确认研究事实。各访视具体评估项目（如实验室检查、心电图、体格检查、依从性评价等）未由来源逐访视列出，不得从访视日推断所有评估在每个访视均实施，需依据访视计划表逐项确认。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_a67458cd1359_1c55472b5d4cf9dd","section_number":"4.6","source_ids":["protocol_full_draft_selection:42d3133fd9c16a3de7aee7f4","current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7"]},{"ai_run_id":"airun_20261006152229_9f385a04","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"补充项目级研究暂停和终止标准文件，明确暂停/终止触发条件、决策主体、暂停后恢复条件、终止后受试者安全随访安排及数据锁定流程","category":"source_missing","gap_id":"gap_termination_criteria","missing_source_classes":["研究暂停和终止标准项目文件","安全性监查计划"],"target":"研究暂停和终止标准全文"}],"heading":"研究暂停和终止标准","missing_source_classes":["研究暂停和终止标准项目文件","安全性监查计划或DSMB章程（如适用）","暂停后恢复与终止后随访规程"],"proposal_text":"","rationale":"本章节需要项目级研究暂停和终止标准文件，包括：申办方内部暂停/终止触发条件、独立数据安全监查安排（本研究未计划DMC/SRC，但需确认是否有其他安全性监查机制）、暂停后恢复条件、终止后受试者随访安排及数据锁定流程。当前允许来源中无对应项目文件，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_a67458cd1359_6e62f618e795f8b1","section_number":"4.7","source_ids":["protocol_full_draft_selection:42d3133fd9c16a3de7aee7f4","current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7"]},{"ai_run_id":"airun_20261006152229_9f385a04","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"补充完整排除标准清单，明确心肝肾功能不全的实验室判定阈值（如ALT/AST倍数、eGFR下限、心功能分级等）","category":"source_missing","gap_id":"gap_exclusion_thresholds","missing_source_classes":["完整排除标准清单","实验室阈值定义"],"target":"排除标准中'严重心肝肾功能不全'的实验室阈值及分级标准"},{"action":"补充合并用药与禁限用药清单，明确既往普瑞巴林/加巴喷丁/度洛西汀的洗脱期要求及研究期间禁用的合并用药","category":"source_missing","gap_id":"gap_concomitant_meds","missing_source_classes":["合并用药限制文件","洗脱期要求"],"target":"合并用药限制、禁限用药清单及既往镇痛药洗脱要求"}],"heading":"研究人群","missing_source_classes":["完整入选/排除标准清单（含实验室阈值）","合并用药限制与洗脱要求","其他排除标准（如合并疾病、既往治疗洗脱等）"],"proposal_text":"","rationale":"年龄范围18-80岁、PHN皮疹愈合后≥3个月、24小时平均NRS≥4分、既往≥1种一线镇痛方案（普瑞巴林/加巴喷丁/度洛西汀）疗效不佳或不耐受、排除非PHN神经病理性疼痛及严重心肝肾功能不全、多中心中国开发区域均为已确认研究事实。'严重心肝肾功能不全'的具体实验室阈值和分级标准、其他排除标准（如合并用药限制、既往抗癫痫药洗脱要求等）在本批次来源中未明确，需医学经理依据项目方案确认。","review_advisories":["本节复述高影响研究设计（研究人群）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_a67458cd1359_ee3aaddc1b5359db","section_number":"5","source_ids":["protocol_full_draft_selection:42d3133fd9c16a3de7aee7f4","current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7"]}],"source_bindings":[{"content_sha256":"d15d1ce8af12dc5a76d56e59a291270e364434c7e85217cefddc5d1a4a0797c5","locator":"document:mwdoc_greenfield_proj_user_a67458cd1359_a18e0421704cd8b4:full-draft:42d3133fd9c16a3de7aee7f4","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:42d3133fd9c16a3de7aee7f4","source_type":"protocol_full_draft_selection","source_version":"full-draft:a152920577fe3f6cd0dd4d514ed3426624fe83e1be3d143cacd52d1c030f8204:42d3133fd9c16a3de7aee7f4","text_sha256":"d15d1ce8