roj_user_a67458cd1359_597c04941dbbade6","section_number":"12.4","source_ids":["protocol_full_draft_selection:abf9cadea37394824af544bf","current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261006165536_dc937772","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:12.4 管理结构|block:957|chunk:1","quote":"申办者或其代理人将执行项目管理、研究管理、监查、供应商管理和统计编程。可使用IWRS进行参与者筛查和随机分组，以及研究药物申请和运输的管理。研究中心将负责生物样品在运输至申办者或其指定分析单位之前的保存。数据将使用eCRFs通过EDC系统记录，或以电子方式转发给申办者（例如，药代动力学数据）。","quote_sha256":"6c7271f4ed3fd8fedd8e75159484480005fc72345847383d098e28d5130237d6","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","span_id":"es_mgmt_structure"},{"locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","quote":"多中心、随机、双盲、安慰剂对照加活性对照的II期设计；KZ-PHN902每日两次口服，三组（100mg、200mg、普瑞巴林活性对照），治疗8周。","quote_sha256":"5ebd13070034ff83511bddb08013d85e08018c543059862255b76021107cc93e","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_project_design"}],"evidence_review_advisories":[],"evidence_span_ids":["es_mgmt_structure","es_project_design"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":1},"gap_items":[{"action":"确认本项目是否使用IWRS、EDC等具体技术平台及供应商","category":"source_missing","gap_id":"gap_mgmt_01","missing_source_classes":["技术平台选型文件"],"target":"12.5 关键角色和研究管理 技术平台与工具"},{"action":"获取本项目各参与方（申办者、CRO、研究中心、独立统计团队等）职责分工文件","category":"source_missing","gap_id":"gap_mgmt_02","missing_source_classes":["职责分工矩阵"],"target":"12.5 关键角色和研究管理 职责分工"}],"heading":"关键角色和研究管理","missing_source_classes":["本项目研究管理架构文件（含CRO/SMO职责划分）","IWRS/EDC等技术平台选型文件","各参与方职责分工矩阵"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂对照加活性对照的II期设计，涉及多个研究中心的协调管理。申办者或其委托的临床试验机构管理组织负责项目管理、研究管理、监查、供应商管理和统计编程等职能。研究中心负责研究期间生物样品在运输至申办者或其指定分析单位之前的保存。研究数据的采集与记录、随机化与药物分配的管理、以及各参与方的具体职责分工，由申办者依据其标准操作规程和项目管理文件确定并执行。","rationale":"研究管理结构参照公司语料中CMD-D001-AD II期方案第12.4节管理结构表述，该来源为同分期但不同适应症的方案，仅作为监管共性结构参照。本项目已确认研究事实包含多中心、三组随机、双盲双模拟等设计要素，但未明确IWRS、EDC等具体技术平台、供应商名称、各角色的具体职责边界。医学经理需确认：本项目是否使用IWRS及具体供应商；数据采集采用eCRF/EDC还是其他系统；各研究中心的层级管理关系。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_a67458cd1359_a45a5268d8339589","section_number":"12.5","source_ids":["protocol_full_draft_selection:abf9cadea37394824af544bf","current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261006165536_dc937772","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取申办方研究中心关闭SOP，明确关闭触发条件、文件归档时限、药物回收流程、数据库锁定后活动","category":"source_missing","gap_id":"gap_close_01","missing_source_classes":["研究中心关闭SOP","药物回收与销毁流程","文件归档要求"],"target":"12.6 研究和研究中心的关闭 全文"}],"heading":"研究和研究中心的关闭","missing_source_classes":["研究中心关闭SOP或关闭检查清单","研究药物回收与销毁流程文件","数据库锁定后残余活动与文件归档要求"],"proposal_text":"","rationale":"本章节需要项目级研究中心关闭条件（如完成最后受试者最后访视后的文件归档时限）、研究药物回收与销毁流程、数据库锁定后残余活动、研究中心关闭通知与文件移交要求等实施规则。当前允许来源中无对应项目文件；公司语料中无研究中心关闭条款可供迁移。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_a67458cd1359_6ec7562629965bd3","secti