b6de3a6","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_010"},{"locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","quote":"活性对照组普瑞巴林 150mg→300mg BID按耐受滴定。","quote_sha256":"b1724145581daed7602b21f7710b1227ce6ec70a533f67a5bdf4f4270a2ffe5b","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_011"},{"locator":"study_definition:mwdefinition_eba001f4710fc0467a56:revision:6","quote":"安慰剂与普瑞巴林活性对照双对照；三组1:1:1，双盲双模拟。","quote_sha256":"e301afe88ba70cf93405c6cb75cc921683b2b37536680346cfb03f619c864233","source_id":"current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d6337f3cdaaf17f7","span_id":"es_012"}],"evidence_review_advisories":[],"evidence_span_ids":["es_006","es_007","es_008","es_009","es_010","es_011","es_012"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":7},"gap_items":[{"action":"补充研究者手册或既往非临床/临床研究资料","category":"source_missing","gap_id":"gap_sec611_ib","missing_source_classes":["研究者手册","非临床安全性数据","既往临床研究资料"],"target":"KZ-PHN902非临床药理学、毒理学数据、已知风险信号、禁忌症及药物相互作用"}],"heading":"研究药物信息","missing_source_classes":[],"proposal_text":"KZ-PHN902为口服Nav1.7通道选择性阻滞剂片，属小分子化合物，通过口服途径给药，剂型为口服固体制剂，产生全身性系统暴露。本研究设置KZ-PHN902 100mg和200mg两个剂量水平，每日两次口服，双盲治疗期共8周。活性对照组给予普瑞巴林，起始剂量150mg每日两次，按耐受性滴定至300mg每日两次。安慰剂与普瑞巴林活性对照构成双对照体系，三组按1:1:1比例随机分配，采用双盲双模拟方法维持盲态。KZ-PHN902的作用机制为选择性阻滞Nav1.7电压门控钠通道，但本章节未包含该药物的非临床药理学、毒理学数据、已知风险信号、禁忌症及药物相互作用信息。","rationale":"本章正文依据当前项目已确认研究事实中的药物技术类型、给药途径、剂型、系统暴露范围、剂量与给药方案及对照方案撰写。KZ-PHN902的非临床安全性数据、已知风险信号、禁忌症及药物相互作用信息未在允许来源中提供，无法写入具体安全性警示内容，需补充研究者手册或既往研究资料。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_a67458cd1359_3e55c63f5ef360f6","section_number":"6.1.1","source_ids":["protocol_full_draft_selection:1d17fc3b1beda415288db82f","current_project_study_definition:mwdefinition_eba001f4710fc0467a56:r6:d633