corpus_spans":0,"project_fact_spans":8},"gap_items":[{"action":"补充DMC章程或研究治理文件，明确事件触发阈值、期中分析时点与DMC建议权限","category":"source_missing","gap_id":"gap_design_01","missing_source_classes":["DMC章程","研究治理文件"],"target":"事件驱动终止规则与DMC决策流程"},{"action":"补充SRC章程或安全性管理计划，明确SRC审查的触发事件类型、审查频率和报告对象","category":"source_missing","gap_id":"gap_design_02","missing_source_classes":["SRC章程","安全性管理计划"],"target":"SRC审查触发条件与报告路径"}],"heading":"研究设计","missing_source_classes":["DMC章程","SRC章程","研究治理文件"],"proposal_text":"本研究为多中心、随机、双盲、活性对照、平行组、事件驱动的III期确证性临床研究，旨在评价R2A-硬骨抑素单抗（抗sclerostin人源单克隆抗体，皮下注射）对比阿仑膦酸钠治疗绝经后骨质疏松症的有效性和安全性。研究采用1:1平行分组，试验组接受R2A-硬骨抑素单抗210 mg皮下注射每月一次联合阿仑膦酸钠安慰剂片口服每周一次，对照组接受阿仑膦酸钠70 mg口服每周一次联合R2A模拟剂皮下注射每月一次，双方联合双模拟以维持盲态。治疗期连续12个月，末次给药后设8周开放安全性随访期。研究设置安全性审查委员会（SRC）和独立数据监查委员会（DMC），计划进行一次期中分析。研究以累积新发椎体形态学骨折事件数驱动，主要分析集为全随机人群（接受至少一次研究药物），主要估计目标采用治疗策略。","rationale":"设计要素（多中心、随机、双盲、活性对照、平行组、事件驱动、1:1、双模拟、12个月治疗期、8周随访、SRC、DMC、期中分析、治疗策略估计目标、mITT）均来源于当前项目已确认研究事实。事件驱动的具体触发阈值（约170例）和期中分析执行细节（O'Brien-Fleming边界、约70%信息量）已在样本量与统计策略中确认，但实施层面的DMC决策流程、SRC审查触发条件等需医学经理进一步确认。","review_advisories":["本节复述高影响研究设计（研究设计）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（估计目标、期中分析）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5bf91e34f907_c10cafa7e122c4c1","section_number":"4","source_ids":["protocol_full_draft_selection:98bd93044f56995c211a7853","current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:97a2bd7fcf7302","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a"]},{"ai_run_id":"airun_20260930125032_7fd2a312","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_7c9e5396a0e275a3bc6b:revision:5","quote":"多中心、随机、双盲、活性对照（阿仑膦酸钠）、平行组、事件驱动的III期确证性研究，皮下注射给药，治疗期12个月","quote_sha256":"54666262b3b5cc7dffbe771e873d3bff5cd164475c59598b486a70e7fed2673e","source_id":"current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","span_id":"es1"},{"locator":"study_definition:mwdefinition_7c9e5396a0e275a3bc6b:revision:5","quote":"SRC是否计划：是","quote_sha256":"2e66c46e971c88034355f38814f8982bc2dfd39744bfeafc5b5361e802a055fb","source_id":"current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","span_id":"es2"},{"locator":"study_definition:mwdefinition_7c9e5396a0e275a3bc6b:revision:5","quote":"DMC是否计划：是","quote_sha256":"9967a9a75297ced2326ab733fa3b16934acdef641fa765dd50c1cd58219f4aa5","source_id":"current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","span_id":"es3"},{"locator":"study_definition:mwdefinition_7c9e5396a0e275a3bc6b:revision:5","quote":"1:1平行分组；双方联合双模拟以维持盲态","quote_sha256":"62caf9937a078405d930981076312142ac862507a90d3e8601c5f4cac2549bc1","source_id":"current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","span_id":"es7"},{"locator":"study_definition:mwdefinition_7c9e5396a0e275a3bc6b:revision:5","quote":"试验组接受R2A单抗皮下注射，双模拟设计；对照组接受阿仑膦酸钠活性对照+R2A模拟剂皮下注射","quote_sha256":"42c1e7d0ed6aa3ee7648caca9e2bcde11d0f374ad47bef536539322b219586e7","source_id":"current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","span_id":"es8"}],"evidence_review_advisories":[],"evidence_span_ids":["es1","es2","es3","es7","es8"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"补充SRC章程和DMC章程，明确各委员会的组成、审查触发条件、报告路径和决策权限","category":"source_missing","gap_id":"gap_overall_01","missing_source_classes":["SRC章程","DMC章程"],"target":"SRC与DMC的章程、审查频率、决策权限及相互关系"},{"action":"补充双模拟匹配性验证报告或药学文件，确认模拟剂与活性药物在外观、气味和注射装置上的一致性","category":"source_missing","gap_id":"gap_overall_02","missing_source_classes":["双模拟匹配性验证报告","药学文件"],"target":"双模拟设计的匹配性验证（外观、气味、给药装置一致性）"}],"heading":"总体设计","missing_source_classes":["SRC章程","DMC章程","双模拟匹配性验证报告"],"proposal_text":"本研究总体设计为多中心、随机、双盲、活性对照、平行组、事件驱动的III期确证性研究。试验组接受R2A-硬骨抑素单抗210 mg皮下注射每月一次（第0、1、2至第11月，共12剂）联合阿仑膦酸钠安慰剂片口服每周一次；对照组接受阿仑膦酸钠70 mg口服每周一次（固定周晨空腹）联合R2A模拟剂皮下注射每月一次。两组均连续治疗12个月。研究采用双模拟设计以维持盲态，即试验组口服阿仑膦酸钠安慰剂片、对照组注射R2A模拟剂，使两组受试者在给药外观和频次上保持一致。研究设置安全性审查委员会（SRC）负责安全性信号的定期审查，设置独立数据监查委员会（DMC）负责期中分析和研究继续或终止建议。研究时期包括：筛选期最长4周、双盲治疗期12个月、末次给药后8周开放安全性随访期。","rationale":"总体设计要素（多中心、随机、双盲、活性对照、平行组、事件驱动、双模拟、1:1、12个月治疗期、8周随访、SRC、DMC）及具体给药方案（R2A 210 mg SC每月一次共12剂、阿仑膦酸钠70 mg口服每周一次、双模拟设计）均来源于当前项目已确认研究事实。筛选期最长4周、治疗期12个月、随访期8周来源于研究时期定义。SRC和DMC的设置已确认，但其章程、审查频率和决策权限等实施细节未在本项目来源中展开。","review_advisories":["本节复述高影响研究设计（总体设计）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（期中分析）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5bf91e34f907_612e97dd9ad8455a","section_number":"4.1","source_ids":["protocol_full_draft_selection:98bd93044f56995c211a7853","current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:97a2bd7fcf7302","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a"]},{"ai_run_id":"airun_20260930125032_7fd2a312","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_7c9e5396a0e275a3bc6b:revision:5","quote":"主要终点：第12月新发椎体形态学骨折（胸腰椎侧位X线，Genant半定量判读T4-L4）发生率；由设盲独立影像终点委员会评价","quote_sha256":"5c17b07abd50c3f064c56d46f6a433c577bc3381804c832e9f2422b2c4a2ff83","source_id":"current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","span_id":"es4"},{"locator":"study_definition:mwdefinition_7c9e5396a0e275a3bc6b:revision:5","quote":"假设试验组第12月新发椎体骨折比例2.0% vs 对照4.0%，双侧α=0.05、把握度85%、脱落率15%，事件驱动：需约170个椎体骨折事件","quote_sha256":"83c07025f2fb3da4391c95628205e406d8907cdb55c5d5ed4f05399a98ccf9f3","source_id":"current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","span_id":"es5"},{"locator":"study_definition:mwdefinition_7c9e5396a0e275a3bc6b:revision:5","quote":"主要估计目标采用治疗策略（treatment policy）：全随机人群（接受至少一次研究药物）第12月新发椎体形态学骨折比例与阿仑膦酸钠比较；不因依从性、背景治疗或脱落改变分析归属","quote_sha256":"c7ea27275ea3d53e92d9eb197924cedfac8a29245dd556f926385dd1758695f6","source_id":"current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","span_id":"es6"}],"evidence_review_advisories":[],"evidence_span_ids":["es4","es5","es6"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"补充影像终点委员会章程或操作手册，明确委员会组成、判读标准、争议解决机制和与DMC的信息交互规则","category":"source_missing","gap_id":"gap_confirm_01","missing_source_classes":["影像终点委员会章程","影像判读操作手册"],"target":"设盲独立影像终点委员会的组成、判读流程、与DMC的交互机制"},{"action":"补充DMC章程或研究治理文件，明确事件计数方法、DMC建议权限和研究提前终止或继续的决策流程","category":"source_missing","gap_id":"gap_confirm_02","missing_source_classes":["DMC章程","研究治理文件"],"target":"事件驱动终止的具体操作规则（事件计数方法、DMC建议权限、研究提前终止条件）"}],"heading":"确证性设计与假设依据","missing_source_classes":["影像终点委员会章程","DMC章程","研究治理文件"],"proposal_text":"本研究为确证性III期临床研究，采用事件驱动设计，以累积新发椎体形态学骨折事件数作为研究终止的驱动条件。主要疗效终点为第12月新发椎体形态学骨折（胸腰椎侧位X线，Genant半定量判读T4-L4）发生率，由设盲独立影像终点委员会评价。主要分析采用Cox比例风险模型，协变量包括年龄、基线BMD、地区和既往骨折史，以Kaplan-Meier曲线和风险比（HR）及其95%置信区间展示结果。主要估计目标采用治疗策略（treatment policy），分析集为全随机人群（接受至少一次研究药物），不因依从性、背景治疗或脱落改变分析归属。样本量假设：试验组第12月新发椎体骨折比例2.0%，对照组4.0%，双侧α=0.05，把握度85%，脱落率15%，需累积约170个椎体骨折事件。计划入组约3400例（1:1）。计划进行一次期中分析，约在70%事件信息量时执行，采用O'Brien-Fleming边界，由独立DMC执行。","rationale":"确证性研究定位、事件驱动设计、主要终点定义（第12月新发椎体形态学骨折、Genant半定量判读T4-L4、设盲独立影像终点委员会评价）、估计目标策略（治疗策略、全随机人群）、主要分析方法（Cox模型、协变量、KM/HR）、样本量假设（2.0% vs 4.0%、α=0.05、85%把握度、15%脱落率、约170事件、约3400例）、期中分析（一次、约70%信息量、O'Brien-Fleming边界、DMC执行）均来源于当前项目已确认研究事实。设盲独立影像终点委员会的组成和判读流程、事件驱动终止的具体操作规则需医学经理确认。","review_advisories":["本节复述高影响研究设计（确证性设计与假设依据）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（α、估计目标、期中分析、样本量、计划入组）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5bf91e34f907_44fe8c73baa3fe86","section_number":"4.2.1","source_ids":["protocol_full_draft_selection:98bd93044f56995c211a7853","current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:97a2bd7fcf7302","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a"]},{"ai_run_id":"airun_20260930125032_7fd2a312","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_7c9e5396a0e275a3bc6b:revision:5","quote":"1:1平行分组；双方联合双模拟以维持盲态","quote_sha256":"62caf9937a078405d930981076312142ac862507a90d3e8601c5f4cac2549bc1","source_id":"current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","span_id":"es7"},{"locator":"document:mwdoc_greenfield_proj_user_5bf91e34f907_186539abf504d849:full-draft:98bd93044f56995c211a7853","quote":"采用随机化分配。","quote_sha256":"abb7a27e76e1676c12ab199e8d9abdac80371053749a69fb6f2ee1faa8f01db8","source_id":"protocol_full_draft_selection:98bd93044f56995c211a7853","span_id":"es9"}],"evidence_review_advisories":[],"evidence_span_ids":["es7","es9"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[{"action":"由生物统计师确认随机化方法、区组大小和分层因素，并写入方案正文","category":"source_missing","gap_id":"gap_rand_01","missing_source_classes":["随机化方法学文件","生物统计方案"],"target":"随机化方法（区组随机或简单随机）、区组大小、分层因素"},{"action":"确认随机化工具类型及随机化序列的生成、保管和保密措施","category":"source_missing","gap_id":"gap_rand_02","missing_source_classes":["随机化操作SOP","IWRS或中央随机系统功能说明"],"target":"随机化工具与保密措施（如IWRS、中央随机系统、随机化序列生成与保管）"}],"heading":"随机化","missing_source_classes":["随机化方法学文件","随机化操作SOP"],"proposal_text":"本研究采用随机化分配，试验组与对照组按1:1比例进行平行分组。随机化在受试者完成筛选并满足全部入选标准、排除标准后，于基线访视（第0周）进行。随机化分配决定受试者接受R2A-硬骨抑素单抗210 mg皮下注射每月一次联合阿仑膦酸钠安慰剂片，或接受阿仑膦酸钠70 mg口服每周一次联合R2A模拟剂皮下注射每月一次。","rationale":"1:1平行分组和随机化分配已确认。随机化的具体方法（区组随机或简单随机）、区组大小、分层因素（如中心、地区、基线骨折状态等）、随机化工具（如IWRS或中央随机系统）以及随机化序列的生成和保密措施在本项目已确认研究事实中未明确给出。公司语料中提及的IWRS和SAS来自不同分期和适应症的研究，不可直接迁移为本项目事实。","review_advisories":["本节复述高影响研究设计（随机化）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5bf91e34f907_a92cc237a3e37ebd","section_number":"4.3","source_ids":["protocol_full_draft_selection:98bd93044f56995c211a7853","current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:97a2bd7fcf7302","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a"]}],"source_bindings":[{"content_sha256":"fdd5faee15c5cc8065e4de7c8a489372db3b47638576dcb22ffda97e2562dd2d","locator":"document:mwdoc_greenfield_proj_user_5bf91e34f907_186539abf504d849:full-draft:98bd93044f56995c211a7853","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:98bd93044f56995c211a7853","source_type":"protocol_full_draft_selection","source_version":"full-draft:812a143d19050e7d60469debe3c4686f86e1e41c1a4352f3bdd97953f9e58eba:98bd93044f56995c211a7853","text_sha256":"fdd5faee15c5cc8065e4de7c8a489372db3b47638576dcb22ffda97e2562dd2d"},{"content_sha256":"b03577d7058486ece2f61249a944df9a435717a701f4b72adf9565baec170a5a","locator":"study_definition:mwdefinition_7c9e5396a0e275a3bc6b:revision:5","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","source_type":"current_project_study_definition","source_version":"mw