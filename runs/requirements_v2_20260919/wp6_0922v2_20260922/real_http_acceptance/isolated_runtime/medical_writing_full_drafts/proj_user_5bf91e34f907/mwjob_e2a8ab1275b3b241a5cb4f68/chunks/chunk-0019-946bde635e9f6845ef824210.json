e_sha256":"6f5da1a13a34fe73eca07aba0754022fb6ddfa4c5b929e2fb5379da62fc16833","source_id":"current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","span_id":"es_multicenter_event"},{"locator":"study_definition:mwdefinition_7c9e5396a0e275a3bc6b:revision:5","quote":"计划入组约3400例（1:1）","quote_sha256":"843548f97df891f8b7581398a6eeba4097c872301b84ed83f8b859472219c7bb","source_id":"current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","span_id":"es_multicenter_event_2"},{"locator":"study_definition:mwdefinition_7c9e5396a0e275a3bc6b:revision:5","quote":"期中分析一次（~70%事件信息量），O'Brien-Fleming边界，由独立DMC执行","quote_sha256":"b2881294427b78b3ab3517efd9bac8240f571cdfe7b7daf8c35e79780ec9665b","source_id":"current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","span_id":"es_interim_dmc"},{"locator":"study_definition:mwdefinition_7c9e5396a0e275a3bc6b:revision:5","quote":"筛选期：最长4周；双盲治疗期：12个月；开放随访期：末次给药后8周安全性随访","quote_sha256":"a7b649034822554853a55db9092238ce122c41efc0576a73e7d64b4a83905f4f","source_id":"current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","span_id":"es_study_periods"}],"evidence_review_advisories":[],"evidence_span_ids":["es_blinded_committees","es_blinded_committees_2","es_multicenter_event","es_multicenter_event_2","es_interim_dmc","es_study_periods"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"由申办者项目管理团队与医学负责人确认各职能单元职责矩阵，形成角色与职责附件","category":"source_missing","gap_id":"gap_12_5_roles_detail","missing_source_classes":["角色职责分工文件","DMC章程","SRC职责说明","独立委员会章程"],"target":"各关键角色的具体职责、汇报层级、决策权限和跨单元协作流程"},{"action":"由独立统计团队与申办者医学负责人联合起草DMC章程","category":"source_missing","gap_id":"gap_12_5_dmc_charter","missing_source_classes":["DMC章程"],"target":"DMC章程中关于会议频率、数据访问权限、沟通路径和终止建议流程"}],"heading":"关键角色和研究管理","missing_source_classes":["各角色职责分工文件","DMC章程","独立委员会章程","CRO服务协议"],"proposal_text":"本研究为多中心、事件驱动的III期确证性研究，计划入组约3400例受试者，研究管理架构需覆盖申办者、各研究中心主要研究者及研究团队、独立数据监查委员会、安全审查委员会、设盲独立影像终点委员会、设盲独立心血管事件裁定委员会、数据管理委员会、独立统计团队、合同研究组织及中心实验室等职能单元。独立数据监查委员会负责在约70%事件信息量时执行一次期中分析，采用O'Brien-Fleming边界判定是否提前终止或继续研究，其章程、成员组成、会议频率和沟通路径由申办者与独立统计团队另行制定。安全审查委员会负责持续审阅安全性信号，包括注射部位反应、心血管不良事件、颌骨坏死、非典型股骨骨折及抗药抗体数据。设盲独立影像终点委员会负责第12月胸腰椎侧位X线（T4至L4）的Genant半定量判读，设盲独立裁定委员会负责心血管不良事件的终点裁定。各研究中心主要研究者对本中心受试者的医疗决策、不良事件识别与报告、知情同意获取及研究药物管理承担最终责任。申办者负责整体研究设计、方案制定、多中心协调、数据管理与统计分析、安全性监测、稽查及监管申报。各职能单元的具体职责边界、汇报层级、决策权限和跨单元协作流程以申办者项目管理文件为准，本方案不在此处逐一列明。","rationale":"已确认事实支持：多中心事件驱动设计、约3400例入组、DMC和SRC设置、一次期中分析（70%事件信息量、O'Brien-Fleming边界、独立DMC执行）、设盲独立影像终点委员会（Genant半定量T4-L4）、设盲独立MACE裁定、各安全性终点类别。各角色具体职责分工、汇报层级和决策权限在允许来源中未给出，需医学经理与项目管理团队确认。","review_advisories":["本节提及高影响设计信息（期中分析、计划入组）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5bf91e34f907_dbb7033f7303ac5d","section_number":"12.5","source_ids":["protocol_full_draft_selection:946bde635e9f6845ef824210","current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]},{"ai_run_id":"airun_20260930144302_dfa2d572","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"检索申办者标准操作规程中关于研究中心关闭的章节，或由项目管理团队与质量部门共同起草","category":"source_missing","gap_id":"gap_12_6_closure_procedure","missing_source_classes":["研究中心关闭标准操作规程","中心关闭核查清单模板","研究药物回收与销毁流程"],"target":"研究中心关闭的完整程序，包括触发条件、提前通知时限、文件归档、药物回收、设备归还、最终核查和关闭确认"},{"action":"确认中国GCP及ICH E6(R2)对文件保存的具体要求，结合申办者内部政策确定保存期限和归档方式","category":"source_missing","gap_id":"gap_12_6_file_retention","missing_source_classes":["文件保存与归档政策","电子数据管理规程"],"target":"研究文件保存期限、电子数据归档格式、受试者记录保存要求及监管检查配合义务"}],"heading":"研究和研究中心的关闭","missing_source_classes":["研究中心关闭标准操作规程","中心关闭核查清单模板","研究药物回收与销毁流程","文件归档与保存要求"],"proposal_text":"","rationale":"本章节需要研究中心关闭的触发条件、通知程序、文件归档要求、研究药物回收与销毁流程、最终关闭核查清单及各方职责。允许来源中未包含任何关于研究中心关闭程序的项目文件、标准操作规程或监管指引。公司语料中仅涉及数据质量保证的抽查与稽查概念，不涉及中心关闭流程，且来源为不同适应症的I期方案，不可迁移为本项目具体实施规则。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5bf91e34f907_ff9584e4477db34a","section_number":"12.6","source_ids":["protocol_full_draft_selection:946bde635e9f6845ef824210","current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]},{"ai_run_id":"airun_20260930144302_dfa2d572","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:数据质量保证|block:932|chunk:1","quote":"研究中心质量保证人员对数据转移文件、统计报告数据进行抽查，保证数据准确无误。申办者根据需要，结合试验进展情况及质量控制人员/监查员的核查结果，可对上述临床研究过程产生的数据进行不同范畴的稽查。","quote_sha256":"84e30f7a8178b6ecebc4f6b8272c753029708f78a4aea8f02201d0abf4225b0b","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db","span_id":"es_qa_audit"},{"locator":"study_definition:mwdefinition_7c9e5396a0e275a3bc6b:revision:5","quote":"多中心、随机、双盲、活性对照（阿仑膦酸钠）、平行组、事件驱动的III期确证性研究","quote_sha256":"6f5da1a13a34fe73eca07aba0754022fb6ddfa4c5b929e2fb5379da62fc16833","source_id":"current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","span_id":"es_multicenter_event"},{"locator":"study_definition:mwdefinition_7c9e5396a0e275a3bc6b:revision:5","quote":"计划入组约3400例（1:1）","quote_sha256":"843548f97df891f8b7581398a6eeba4097c872301b84ed83f8b859472219c7bb","source_id":"current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","span_id":"es_multicenter_event_2"},{"locator":"study_definition:mwdefinition_7c9e5396a0e275a3bc6b:revision:5","quote":"由设盲独立影像终点委员会评价","quote_sha256":"49abb802ebe9f71654362b834cfe2cf9120d5b13688fda08846be761a467ee4a","source_id":"current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","span_id":"es_blinded_committees"},{"locator":"study_definition:mwdefinition_7c9e5396a0e275a3bc6b:revision:5","quote":"心血管不良事件（MACE，设盲独立裁定）","quote_sha256":"4ecdaba3dec5e6a08d2096b45069ded3443587ef46ee876e8152f02a197b4c88","source_id":"current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","span_id":"es_blinded_committees_2"},{"locator":"study_definition:mwdefinition_7c9e5396a0e275a3bc6b:revision:5","quote":"期中分析一次（~70%事件信息量），O'Brien-Fleming边界，由独立DMC执行","quote_sha256":"b2881294427b78b3ab3517efd9bac8240f571cdfe7b7daf8c35e79780ec9665b","source_id":"current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","span_id":"es_interim_dmc"},{"locator":"study_definition:mwdefinition_7c9e5396a0e275a3bc6b:revision:5","quote":"筛选(第-4~0周)、基线随机(第0周)、治疗第3/6/9月访视、第12月主终点访视、末次给药后8周安全性随访；每3个月行腰椎/全髋DXA，第12月行脊柱X线形态学评价","quote_sha256":"eeeb7ccf803bba630249709f51f8272687090221b78bf3df7e8b6268a039e2dc","source_id":"current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","span_id":"es_visit_strategy"}],"evidence_review_advisories":[],"evidence_span_ids":["es_qa_audit","es_multicenter_event","es_multicenter_event_2","es_blinded_committees","es_blinded_committees_2","es_interim_dmc","es_visit_strategy"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":6},"gap_items":[{"action":"由申办者质量部门制定适用于本项目的质量控制计划，明确各阶段核查内容和频率","category":"source_missing","gap_id":"gap_12_7_qc_methods","missing_source_classes":["质量控制标准操作规程","数据核查工具与流程"],"target":"各研究中心质量控制的具体方法、频率、核查清单和数据核查工具"},{"action":"由申办者质量部门制定稽查计划，明确稽查覆盖的研究阶段和职能单元","category":"source_missing","gap_id":"gap_12_7_audit_plan","missing_source_classes":["质量保证稽查计划","纠正预防措施流程"],"target":"申办者稽查的范围、频率、触发条件和纠正预防措施流程"},{"action":"由影像核心实验室与独立影像终点委员会确认影像质控方案","category":"source_missing","gap_id":"gap_12_7_imaging_qc","missing_source_classes":["影像数据传输与质控规程","独立影像委员会质控要求"],"target":"DXA和脊柱X线影像的采集标准、传输完整性核查、判读一致性评估和独立影像委员会质控流程"}],"heading":"质量控制与保证","missing_source_classes":["质量控制标准操作规程","质量保证稽查计划","数据核查工具与流程","影像数据传输与质控规程"],"proposal_text":"本研究的质量控制与质量保证体系覆盖数据完整性、研究药物管理、受试者安全监测和文件合规四个维度。在数据完整性方面，研究中心质量保证人员对数据转移文件和统计报告数据进行抽查，以保证数据准确无误；申办者根据研究进展情况及质量控制人员或监查员的核查结果，可对临床研究过程产生的数据进行不同范畴的稽查。本研究为多中心设计，计划入组约3400例受试者，主要终点为第12月新发椎体形态学骨折发生率，由设盲独立影像终点委员会进行Genant半定量判读，因此影像数据的采集质量、传输完整性和判读一致性是质量控制的重点环节。安全性监测方面，需对注射部位反应、心血管不良事件、颌骨坏死、非典型股骨骨折、校正血钙及抗药抗体等安全性终点进行持续监测和定期汇总。独立数据监查委员会在约70%事件信息量时执行期中分析，其数据访问和沟通路径需纳入质量保证范围。各研究中心的质量控制具体方法、稽查频率、稽查范围、纠正预防措施流程及数据核查工具以申办者质量部门制定的项目质量控制计划为准。","rationale":"已确认事实支持：多中心设计、约3400例入组、设盲独立影像终点委员会（Genant半定量T4-L4）、安全性终点类别（注射部位反应、MACE、颌骨坏死、非典型股骨骨折、血钙、ADA）、DMC期中分析（70%事件信息量）。公司语料中QA抽查和稽查描述为监管共性结构参照，用于说明质量控制章节应涵盖数据抽查和稽查的概念框架，不迁移为具体实施规则。稽查频率、范围、纠正预防措施流程、数据核查工具等具体实施细节在允许来源中未给出。","review_advisories":["本节提及高影响设计信息（主要终点、期中分析、计划入组）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5bf91e34f907_e0baaab16dff1c64","section_number":"12.7","source_ids":["protocol_full_draft_selection:946bde635e9f6845ef824210","current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]},{"ai_run_id":"airun_20260930144302_dfa2d572","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"由申办者项目管理团队确认附录文件清单，逐项核实各附件的编制完成状态和引用编号","category":"source_missing","gap_id":"gap_14_appendix_list","missing_source_classes":["附录文件清单","各附件编制状态记录"],"target":"本方案附录应包含的文件清单、编号及编制状态"},{"action":"由医学团队与法律合规部门起草知情同意书，经伦理委员会审批后纳入附录","category":"source_missing","gap_id":"gap_14_icf_template","missing_source_classes":["知情同意书模板"],"target":"知情同意书模板（含受试者版和法定代理人版）"},{"action":"由数据管理团队完成CRF设计后纳入附录","category":"source_missing","gap_id":"gap_14_crf_sample","missing_source_classes":["病例报告表样本","电子数据采集系统说明"],"target":"病例报告表样本及电子数据采集系统说明"},{"action":"由中心实验室提供本方案涉及的实验室检查项目清单和正常值范围","category":"source_missing","gap_id":"gap_14_lab_normal_range","missing_source_classes":["实验室正常值范围","中心实验室协议"],"target":"中心实验室检查项目清单及正常值参考范围"}],"heading":"附录","missing_source_classes":["附录文件清单","知情同意书模板","病例报告表样本","实验室正常值范围"],"proposal_text":"","rationale":"附录章节需要明确列出本方案应包含的附件清单及其编号，例如知情同意书模板、病例报告表样本、实验室检查正常值范围、随机化方案、DMC章程、独立影像委员会章程、独立裁定委员会章程、研究药物说明书、中心实验室协议、数据管理计划、统计分析计划等。允许来源中未提供本项目的附录文件清单、各附件的编制状态或引用编号。公司语料为不同适应症的I期方案，其附录结构不可迁移为本项目附录内容。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5bf91e34f907_514b7d54773366d2","section_number":"14","source_ids":["protocol_full_draft_selection:946bde635e9f6845ef824210","current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]}],"source_bindings":[{"content_sha256":"afd3b492f9e181505e08eed0bd9389835623892b0bdb3ee28d576f8b28db3519","locator":"document:mwdoc_greenfield_proj_user_5bf91e34f907_186539abf504d849:full-draft:946bde635e9f6845ef824210","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:946bde635e9f6845ef824210","source_type":"protocol_full_draft_selection","source_version":"full-draft:812a143d19050e7d60469debe3c4686f86e1e41c1a4352f3bdd97953f9e58eba:946bde635e9f6845ef824210","text_sha256":"afd3b492f9e181505e08eed0bd9389835623892b0bdb3ee28d576f8b28db3519"},{"content_sha256":"b03577d7058486ece2f61249a944df9a435717a701f4b72adf9565baec170a5a","locator":"study_definition:mwdefinition_7c9e5396a0e275a3bc6b:revision:5","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","source_type":"current_project_study_definition","source_version":"mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","text_sha256":"b03577d7058486ece2f61249a944df9a435717a701f4b72adf9565baec170a5a"},{"content_sha256":"84e30f7a8178b6ecebc4f6b8272c753029708f78a4aea8f02201d0abf4225b0b","locator":"section:数据质量保证|block:932|chunk:1","role":"company_sop_or_protoco