field_proj_user_5bf91e34f907_9a61689ac5c463a3","section_number":"8.8","source_ids":["protocol_full_draft_selection:0644fba8e5fea6baa2f08e34","current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83","company_corpus:cms_cn_protocol_corpus_20260715_v1:152c1e08c78e76","company_corpus:cms_cn_protocol_corpus_20260715_v1:30fd7cd8503aae","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:607449f013b59d"]},{"ai_run_id":"airun_20260930141830_d3208003","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_7c9e5396a0e275a3bc6b:revision:5","quote":"主要分析集mITT（随机且用药≥1次）；主终点用Cox比例风险模型（协变量：年龄、基线BMD、地区、既往骨折史），KM曲线与HR(95%CI)展示；BMD重复测量用MMRM；安全性采用描述性统计；期中分析一次（~70%事件信息量），O'Brien-Fleming边界，由独立DMC执行。","quote_sha256":"a7dea0555de55cf5661205f80f6fd8ef63412e538e22e463ac69d4515c6f790d","source_id":"current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","span_id":"es_002"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[{"action":"检索或编制项目级统计分析计划，确认MMRM协方差结构、敏感性分析集及亚组分析清单","category":"source_not_retrieved","gap_id":"gap_9_sap_detail","missing_source_classes":["统计分析计划（SAP）"],"target":"统计分析计划中MMRM协方差结构、敏感性分析、亚组分析及期中分析操作细则"},{"action":"确认期中分析事件信息量计算基准（以170个事件为分母）及DMC章程","category":"source_not_retrieved","gap_id":"gap_9_interim_detail","missing_source_classes":["DMC章程","期中分析操作细则"],"target":"期中分析触发条件中70%事件信息量的计算基准及DMC操作章程"}],"heading":"统计分析","missing_source_classes":["统计分析计划（SAP）","期中分析详细规则"],"proposal_text":"本研究为事件驱动的III期确证性研究，计划入组约3400例受试者，按1:1比例随机分配至R2A-硬骨抑素单抗组或阿仑膦酸钠活性对照组。主要分析集为修改意向治疗集（mITT），定义为随机化且至少接受一次研究药物治疗的全部受试者。主要终点为第12个月新发椎体形态学骨折发生率，采用Cox比例风险模型进行比较，模型协变量包括年龄、基线骨密度、地区及既往骨折史，以Kaplan-Meier曲线展示各组累积骨折发生率，报告风险比及其95%置信区间。关键次要终点中，第12个月腰椎及全髋骨密度较基线变化百分比采用混合效应模型重复测量（MMRM）进行分析。安全性数据采用描述性统计方法汇总。本研究计划进行一次期中分析，触发条件为累积椎体骨折事件达到约170个事件信息量的70%，采用O'Brien-Fleming消耗函数控制总体I类错误，期中分析由独立数据安全监查委员会（DMC）执行。主要估计目标采用治疗策略，不因依从性、背景治疗或脱落改变分析归属。","rationale":"本段正文依据项目研究定义中已确认的样本量策略（约3400例、1:1、事件驱动约170个椎体骨折事件）、统计分析策略（mITT、Cox模型及协变量、MMRM、描述性安全性统计、期中分析O'Brien-Fleming边界、DMC）及估计目标策略（治疗策略）撰写。需医学经理确认：（1）Cox模型协变量是否完整；（2）MMRM的时点与协方差结构；（3）期中分析触发条件中70%事件信息量的具体计算基准；（4）是否需补充敏感性分析或亚组分析策略。","review_advisories":["本节复述高影响研究设计（统计分析）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（主要终点、估计目标、期中分析、计划入组）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5bf91e34f907_b085f1be377c33f8","section_number":"9","source_ids":["protocol_full_draft_selection:0644fba8e5fea6baa2f08e34","current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83","company_corpus:cms_cn_protocol_corpus_20260715_v1:152c1e08c78e76","company_corpus:cms_cn_protocol_corpus_20260715_v1:30fd7cd8503aae","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:607449f013b59d"]},{"ai_run_id":"airun_20260930141830_d3208003","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_7c9e5396a0e275a3bc6b:revision:5","quote":"TEAE/SAE发生率及严重程度（CTCAE 5.0）；注射部位反应；心血管不良事件（MACE，设盲独立裁定）；颌骨坏死与非典型股骨骨折；校正血钙、尿钙；抗药抗体（ADA）及中和抗体。","quote_sha256":"17e30899e1e282c57e1d7c210204e585f76b80ad55e04988f1622bbc5f977717","source_id":"current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","span_id":"es_003"}],"evidence_review_advisories":[],"evidence_span_ids":["es_003"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[{"action":"确认安全性评估窗口（如末次给药后8周）及TEAE采集起止时点","category":"source_missing","gap_id":"gap_95_safety_window","missing_source_classes":["安全性评估窗口定义"],"target":"安全性评估窗口起止时点及TEAE采集窗口定义"},{"action":"补充MACE事件定义及独立裁定委员会操作章程","category":"source_missing","gap_id":"gap_95_mace_definition","missing_source_classes":["MACE事件定义","独立裁定委员会章程"],"target":"MACE事件定义、裁定委员会组成及裁定流程"},{"action":"确认ADA采样时间点、检测方法（如电化学发光法）及中和抗体确认试验流程","category":"source_missing","gap_id":"gap_95_ada_sampling","missing_source_classes":["ADA采样方案","免疫原性检测方法"],"target":"ADA及中和抗体采样时间点与检测方法"}],"heading":"安全性数据分析","missing_source_classes":["安全性评估窗口定义","MACE事件定义与裁定流程","ADA采样方案","安全性分析集精确定义"],"proposal_text":"安全性分析基于安全性分析集，即至少接受一次研究药物治疗的全部受试者。不良事件按CTCAE 5.0标准评定严重程度，按系统器官分类和首选术语汇总发生率及严重程度分布。重点关注的安全性事件包括：注射部位反应、主要心血管不良事件（MACE，由设盲独立裁定委员会判定）、颌骨坏死、非典型股骨骨折、校正血钙及尿钙异常、抗药抗体（ADA）及中和抗体。MACE的独立裁定在设盲条件下进行，裁定结果纳入安全性分析。ADA及中和抗体按时间点和组别汇总阳性率。安全性分析按治疗组分别描述，不预设组间比较的假设检验。","rationale":"本段正文依据项目研究定义中已确认的安全性终点清单（TEAE/SAE按CTCAE 5.0、注射部位反应、MACE设盲独立裁定、颌骨坏死、非典型股骨骨折、校正血钙/尿钙、ADA及中和抗体）及总体设计（双盲、活性对照）撰写。需医学经理确认：（1）安全性分析集的精确定义是否等同于mITT或需单独界定；（2）MACE独立裁定的具体事件定义与裁定流程；（3）ADA采样时间点与检测方法；（4）安全性评估窗口起止时点；（5）是否需对特定安全性事件预设组间比较。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5bf91e34f907_bd7d1fd281f0e337","section_number":"9.5","source_ids":["protocol_full_draft_selection:0644fba8e5fea6baa2f08e34","current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83","company_corpus:cms_cn_protocol_corpus_20260715_v1:152c1e08c78e76","company_corpus:cms_cn_protocol_corpus_20260715_v1:30fd7cd8503aae","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:607449f013b59d"]},{"ai_run_id":"airun_20260930141830_d3208003","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"补充项目级数据管理计划、监查计划及CRF设计文件","category":"source_missing","gap_id":"gap_10_data_mgmt","missing_source_classes":["数据管理计划","监查计划","CRF设计文件","源数据验证规程"],"target":"数据采集工具、核查流程、监查频率、源数据验证及数据管理职责分工"}],"heading":"数据采集与管理","missing_source_classes":["数据管理计划","监查计划","CRF设计文件","源数据验证规程"],"proposal_text":"","rationale":"项目研究定义未提供数据采集工具（eCRF或纸质）、数据核查流程、监查频率、源数据验证要求、数据管理职责分工或CRF设计原则等项目级实施规则。公司语料中关于eCRF记录不良事件结局的条款来自不同适应症研究，按语料泛化规则不得直接决定本项目数据采集与管理规则。需补充项目级数据管理计划或监查计划方可形成实质正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5bf91e34f907_86ebf189dc37b892","section_number":"10","source_ids":["protocol_full_draft_selection:0644fba8e5fea6baa2f08e34","current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83","company_corpus:cms_cn_protocol_corpus_20260715_v1:152c1e08c78e76","company_corpus:cms_cn_protocol_corpus_20260715_v1:30fd7cd8503aae","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:607449f013b59d"]}],"source_bindings":[{"content_sha256":"0995b5f5c9c0c4caf15e5bb700f8c6fc3e9a8de63189a88dbc145d8e3416ea5f","locator":"document:mwdoc_greenfield_proj_user_5bf91e34f907_186539abf504d849:full-draft:0644fba8e5fea6baa2f08e34","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:0644fba8e5fea6baa2f08e34","source_type":"protocol_full_draft_selection","source_version":"full-draft:812a143d19050e7d60469debe3c4686f86e1e41c1a4352f3bdd97953f9e58eba:0644fba8e5fea6baa2f08e34","text_sha256":"0995b5f5c9c0c4caf15e5bb700f8c6fc3e9a8de63189a88dbc145d8e3416ea5f"},{"content_sha256":"b03577d7058486ece2f61249a944df9a435717a701f4b72adf9565baec170a5a","locator":"study_definition:mwdefinition_7c9e5396a0e275a3bc6b:revision:5","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","source_type":"current_project_study_definition","source_version":"mwdefinition_7c9e5396a0e275a3bc6b:r5:e6f0209f421a9f4d","text_sha256":"b03577d7058486ece2f61249a944df9a4