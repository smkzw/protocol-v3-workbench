记录为伴发事件并汇总描述，不作为排除依据。","quote_sha256":"c692bb1fa2983329282d107b5fe125343e7cc5be170828b16b88e14057476f3d","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"es_011"}],"evidence_review_advisories":[],"evidence_span_ids":["es_001","es_002","es_011"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"由医学经理确认是否采用药物计数、电子给药监测或患者日记，并明确评估访视频率","category":"source_missing","gap_id":"gap_adh_001","missing_source_classes":["依从性监测方法学文件","药物发放与回收操作规程"],"target":"依从性具体监测方法与评估频率"},{"action":"由医学经理确认依从性合格阈值及低于阈值时的处理流程","category":"source_missing","gap_id":"gap_adh_002","missing_source_classes":["依从性判定阈值及低依从性处理流程"],"target":"依从性判定阈值及低依从性处理"}],"heading":"研究治疗依从性","missing_source_classes":["依从性监测方法学文件","药物发放与回收操作规程","依从性判定阈值及低依从性处理流程"],"proposal_text":"本研究采用随机、双盲、安慰剂对照、四臂平行剂量探索设计，试验药KZ-617片与匹配双模拟安慰剂均为口服固体制剂，给药方案为每日两次，连续治疗12周，其中第1至2周为安全导入滴定期，90mg组由45mg起始。受试者须能够使用电子咳嗽监测设备并完成电子日记方可入组。治疗访视安排在第2、4、8、12周，安全性随访访视安排在末次给药后2周。主要估计目标采用治疗策略，无论是否中止研究治疗或使用补救及合并治疗，均评价第12周24小时咳嗽频率较基线的变化；中止治疗者仍纳入主要分析集，补救用药记录为伴发事件并汇总描述，不作为排除依据。依从性管理应覆盖口服每日两次给药方案下受试者对试验药或安慰剂的实际服用情况，确保双盲条件下药物发放、回收与计数流程可追溯。","rationale":"方案中口服BID、12周、双模拟安慰剂、治疗访视时间点、电子日记入组条件及治疗策略估计目标为已确认设计要素。依从性具体监测手段（药物计数、电子监测、日记记录方式）、评估频率及阈值无直接来源，电子日记在方案中用于咳嗽监测而非药物依从性记录，不可直接等同。","review_advisories":["本节提及高影响设计信息（估计目标、伴发事件）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d828e848b004_e645559e74cf951c","section_number":"6.5","source_ids":["protocol_full_draft_selection:3bf1348abc30fd523a2f82ad","current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","company_corpus:cms_cn_protocol_corpus_20260715_v1:176c87031ef7e6","company_corpus:cms_cn_protocol_corpus_20260715_v1:69f36952e02ae0","company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","company_corpus:cms_cn_protocol_corpus_20260715_v1:06652cfb5d7add","company_corpus:cms_cn_protocol_corpus_20260715_v1:79890fa298bcdd"]},{"ai_run_id":"airun_20261004045730_d7c2ff28","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:既往/合并治疗和洗脱期|block:498|chunk:1","quote":"参与者在研究期间，除方案禁止的合并用药外，","quote_sha256":"33fbc172e10d057b657a11a8a1411951d79db71a62e6f67b3724a6813a7b19d3","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:69f36952e02ae0","span_id":"es_003"},{"locator":"section:既往/合并治疗和洗脱期|block:636|chunk:1","quote":"在随机前，用于其他疾病的合并用药及治疗，如非 3.6.5.3 规定的禁止的合并用药 或治疗，且研究者认为剂量稳定，可以在研究期间继续使用。","quote_sha256":"de16a160f25214c7f0251dd614be10e2e1b5ab8c87a383b8f5e49c43f77f6549","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","span_id":"es_004"},{"locator":"section:既往/合并治疗和洗脱期|block:412|chunk:1","quote":"在随机前，用于其他疾病的合并用药及治疗，如非方案规定的禁止的合并用药或治疗，且研究者认为剂量稳定，可以在研究期间继续使用。","quote_sha256":"3d04d9bdc17f294d2686d2a3b0a3154d40097680bb0815cd1576309fdb1bca3b","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:06652cfb5d7add","span_id":"es_005"},{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"合并可能干扰咳嗽评估的呼吸系统疾病（未控制哮喘、COPD伴急性加重史、支气管扩张、活动性肺结核、IPF等间质性肺病）；血管紧张素转换酶抑制剂相关咳嗽且可替代治疗","quote_sha256":"63a098d2a62a6669961dcb23ef06781670784cd429c74dd742be49c3420d3ce2","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"es_008"},{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"筛选前8周内咳嗽治疗方案稳定","quote_sha256":"9ffd2eec0d3613e780a8f0653cad1e704c5e2aa2e704b46249ee93de2b40d193","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"es_009"},{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"味觉障碍（味觉功能问卷+客观味觉测试）","quote_sha256":"14ca8d21ff96df95efc03ad83f98f0d8f4adce953fee5c715fe460da4d395fe3","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"es_010"}],"evidence_review_advisories":[],"evidence_span_ids":["es_003","es_004","es_005","es_008","es_009","es_010"],"evidence_summary":{"corpus_spans":3,"project_fact_spans":3},"gap_items":[{"action":"由医学经理依据KZ-617机制及慢性咳嗽领域实践确定允许继续使用的合并用药类别与条件","category":"source_missing","gap_id":"gap_conc_001","missing_source_classes":["本项目允许的合并用药清单","慢性咳嗽领域合并用药实践指南"],"target":"允许的合并用药清单及条件"},{"action":"由医学经理依据KZ-617作用机制、安全性关注点及药物相互作用数据确定禁止使用的合并用药或治疗","category":"source_missing","gap_id":"gap_conc_002","missing_source_classes":["本项目禁止的合并用药清单","KZ-617药物相互作用数据"],"target":"禁止的合并用药清单"},{"action":"由医学经理确认合并用药变动是否需记录为AE及记录操作细则","category":"source_missing","gap_id":"gap_conc_003","missing_source_classes":["合并用药与AE记录操作细则"],"target":"合并用药与AE记录关系"}],"heading":"合并用药/治疗","missing_source_classes":["本项目允许的合并用药清单","本项目禁止的合并用药清单","合并用药与AE记录操作细则","KZ-617药物相互作用数据"],"proposal_text":"本研究为口服P2X3受体拮抗剂KZ-617片治疗难治性/不明原因慢性咳嗽的II期剂量探索试验，双盲治疗期12周，安全性随访2周。合并用药/治疗章节覆盖研究期间受试者可能使用的其他药物与非药物治疗的管理原则，包括允许继续使用的合并用药条件、禁止使用的合并用药或治疗类别、合并用药与不良事件记录的关系，以及合并用药对疗效终点（24小时咳嗽频率、LCQ总分、咳嗽缓解应答）和安全性终点（味觉障碍、实验室检查、心电图、生命体征）评估的潜在影响。入选标准要求筛选前8周内咳嗽治疗方案稳定，提示研究期间合并用药变动需关注对咳嗽评估基线的干扰。排除标准涉及合并可能干扰咳嗽评估的呼吸系统疾病及血管紧张素转换酶抑制剂相关咳嗽且可替代治疗，提示上述疾病状态及药物类别在合并用药管理中需特别关注。安全性终点包含味觉障碍（味觉功能问卷加客观味觉测试），提示味觉通路相关药物在合并用药评估中需纳入考量。","rationale":"方案中研究设计框架（口服BID、12周、双盲、四臂）、安全性关注点（味觉障碍、实验室、心电图、生命体征）及入选标准中筛选前8周咳嗽治疗方案稳定为已确认设计要素；排除标准中ACEI相关咳嗽及合并呼吸系统疾病为项目事实。公司语料中剂量稳定可继续使用及禁止合并用药后中断治疗为跨项目通用结构措辞（来源为AD及I期方案），仅作章节结构参照，不构成本项目已确认规则。具体禁限用药清单无项目来源。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d828e848b004_0237514b1c2d0b75","section_number":"6.6","source_ids":["protocol_full_draft_selection:3bf1348abc30fd523a2f82ad","current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","company_corpus:cms_cn_protocol_corpus_20260715_v1:176c87031ef7e6","company_corpus:cms_cn_protocol_corpus_20260715_v1:69f36952e02ae0","company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","company_corpus:cms_cn_protocol_corpus_20260715_v1:06652cfb5d7add","company_corpus:cms_cn_protocol_corpus_20260715_v1:79890fa298bcdd"]},{"ai_run_id":"airun_20261004045730_d7c2ff28","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"由医学经理依据KZ-617作用机制、安全性关注点及慢性咳嗽领域实践确定允许继续使用的合并用药类别与条件","category":"source_missing","gap_id":"gap_allowed_001","missing_source_classes":["本项目允许的合并用药清单","慢性咳嗽领域合并用药实践指南"],"target":"允许的合并用药/治疗具体清单及条件"},{"action":"检索KZ-617研究者手册或非临床安全性报告中的药物相互作用章节","category":"source_missing","gap_id":"gap_allowed_002","missing_source_classes":["KZ-617药物相互作用数据","KZ-617非临床安全性数据"],"target":"KZ-617药物相互作用及非临床安全性数据"}],"heading":"允许的合并用药/治疗","missing_source_classes":["本项目允许的合并用药清单","慢性咳嗽领域合并用药实践指南","KZ-617药物相互作用数据","KZ-617非临床安全性数据（含药物相互作用）"],"proposal_text":"","rationale":"本章节需要本项目允许的合并用药/治疗具体清单及条件。方案中仅包含入选标准筛选前8周咳嗽治疗方案稳定及排除标准中涉及合并呼吸系统疾病和ACEI相关咳嗽的排除条件，未给出研究期间允许继续使用的合并用药类别、剂量稳定条件或研究者裁量规则。公司语料中剂量稳定可继续使用为跨项目通用结构措辞（来源为AD及I期方案），不构成本项目已确认实施规则。缺少本项目允许的合并用药清单、慢性咳嗽领域合并用药实践指南及KZ-617药物相互作用数据，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d828e848b004_4b9205055e203261","section_number":"6.6.1","source_ids":["protocol_full_draft_selection:3bf1348abc30fd523a2f82ad","current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","company_corpus:cms_cn_protocol_corpus_20260715_v1:176c87031ef7e6","company_corpus:cms_cn_protocol_corpus_20260715_v1:69f36952e02ae0","company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","company_corpus:cms_cn_protocol_corpus_20260715_v1:06652cfb5d7add","company_corpus:cms_cn_protocol_corpus_20260715_v1:79890fa298bcdd"]},{"ai_run_id":"airun_20261004045730_d7c2ff28","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"由医学经理依据KZ-617作用机制、安全性关注点（味觉障碍、P2X2/3通路交互）及药物相互作用数据确定禁止使用的合并用药或治疗","category":"source_missing","gap_id":"gap_forbidden_001","missing_source_classes":["本项目禁止的合并用药清单","KZ-617药物相互作用数据"],"target":"禁止的合并用药/治疗具体清单"},{"action":"由医学经理确认接受禁止合并用药后是否中断治疗、是否继续随访及数据记录要求","category":"source_missing","gap_id":"gap_forbidden_002","missing_source_classes":["合并用药违规处理流程"],"target":"接受禁止合并用药后的处理流程"},{"action":"检索KZ-617 IB或IND申报资料中的药物相互作用及非临床安全性数据","category":"source_not_retrieved","gap_id":"gap_forbidden_003","missing_source_classes":["KZ-617非临床安全性数据","KZ-617药物相互作用数据"],"target":"KZ-617研究者手册中药物相互作用章节"}],"heading":"禁止的合并用药/治疗","missing_source_classes":["本项目禁止的合并用药清单","KZ-617药物相互作用数据","KZ-617非临床安全性数据（含药物相互作用）","慢性咳嗽领域禁限用药实践"],"proposal_text":"","rationale":"本章节需要本项目禁止的合并用药/治疗具体清单。方案中排除标准涉及合并可能干扰咳嗽评估的呼吸系统疾病及血管紧张素转换酶抑制剂相关咳嗽且可替代治疗，但这些为入组排除条件而非研究期间禁止合并用药清单。安全性终点含味觉障碍（味觉功能问卷加客观味觉测试），提示味觉通路相关药物可能需关注，但无直接来源将味觉障碍转化为禁限用药条目。公司语料中禁止的合并用药/治疗表格标题及接受禁止合并用药后可能中断治疗为跨项目通用结构参照（来源为AD及I期方案），不构成本项目已确认规则。缺少本项目禁止的合并用药清单、KZ-617药物相互作用数据及慢性咳嗽领域禁限用药实践，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d828e848b004_46776f6ddb2d4481","section_number":"6.6.2","source_ids":["protocol_full_draft_selection:3bf1348abc30fd523a2f82ad","current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","company_corpus:cms_cn_protocol_corpus_20260715_v1:176c87031ef7e6","company_corpus:cms_cn_protocol_corpus_20260715_v1:69f36952e02ae0","company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","company_corpus:cms_cn_protocol_corpus_20260715_v1:06652cfb5d7add","company_corpus:cms_cn_protocol_corpus_20260715_v1:79890fa298bcdd"]}],"source_bindings":[{"content_sha256":"0d5e0f9f11e3520934009dfd4b1834f6f11f6d2cd5a9ffd786de5452a4f53697","locator":"document:mwdoc_greenfield_proj_user_d828e848b004_4599f7b526b2bbc8:full-dr