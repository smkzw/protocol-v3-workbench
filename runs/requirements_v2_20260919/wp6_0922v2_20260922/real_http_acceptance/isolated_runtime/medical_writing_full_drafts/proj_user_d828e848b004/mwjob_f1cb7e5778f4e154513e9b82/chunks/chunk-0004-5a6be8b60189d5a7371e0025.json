fdc853989b74ea1499901f514a4","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"es_no_interim"}],"evidence_review_advisories":[],"evidence_span_ids":["es_dmc_planned","es_dmc_section","es_no_interim"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"由安全医学负责人确认DMC成员构成、独立统计师配置及会议周期后写入","category":"source_missing","gap_id":"gap_dmc_composition","missing_source_classes":["DMC章程"],"target":"DMC组成与会议频率"}],"heading":"安全性审评/数据监查委员会","missing_source_classes":["DMC章程","安全性监测计划"],"proposal_text":"本研究设置独立数据监查委员会（DMC），对研究期间积累的安全性数据进行定期审阅。DMC的设立旨在保障受试者安全，确保研究在获益-风险比可接受的范围内继续实施。DMC依据其章程独立运作，不受申办方和研究者的干预。本研究不计划期中分析，DMC的审阅活动以安全性监测为主要职能，不执行疗效期中判断。DMC的具体组成、会议频率、审阅数据范围、向申办方提出建议的触发条件及报告路径，由申办方在DMC章程中另行规定。","rationale":"项目已确认事实明确DMC计划设置且期中分析不计划，据此可写入DMC存在性及其以安全性审阅为主的定位。DMC章程细节（成员构成、会议周期、数据审阅范围、建议触发阈值）在允许来源中未提供，需医学经理或安全医学负责人在DMC章程定稿后补充。","review_advisories":["本节提及高影响设计信息（期中分析）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d828e848b004_ee264812db822b88","section_number":"4.5","source_ids":["protocol_full_draft_selection:5a6be8b60189d5a7371e0025","current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e"]},{"ai_run_id":"airun_20261004044826_ab5e8a40","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"研究时期：筛选期（最长4周，含两次24h咳嗽监测）；双盲治疗期（12周）；安全性随访（末次给药后2周）","quote_sha256":"2b3a96a46a02639cc471e8d3555ca737b6ee9dac7dc5a1ea186d83f8ed542968","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"es_study_periods"},{"locator":"document:mwdoc_greenfield_proj_user_d828e848b004_4599f7b526b2bbc8:full-draft:5a6be8b60189d5a7371e0025","quote":"筛选期（最长4周，含两次24h咳嗽监测）；双盲治疗期（12周）；安全性随访（末次给药后2周）","quote_sha256":"8244cec012d24a074b5db2d81dd928330f26b7c2344e1edd6b620fabfd5667b3","source_id":"protocol_full_draft_selection:5a6be8b60189d5a7371e0025","span_id":"es_study_periods_section"}],"evidence_review_advisories":[],"evidence_span_ids":["es_study_periods","es_study_periods_section"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[],"heading":"研究结束与研究持续时间","missing_source_classes":[],"proposal_text":"本研究由三个连续时期组成。筛选期最长为4周，期间完成两次24小时客观咳嗽频率监测以确认入组资格。双盲治疗期为12周，受试者按随机分配接受KZ-617片或匹配安慰剂，每日两次口服给药。安全性随访期为末次给药后2周，用于观察治疗结束后不良事件的转归及安全性数据的最终采集。一名受试者从首次筛选访视至研究结束访视的最长总持续时间为18周。研究结束以受试者完成安全性随访访视为标志；若受试者在治疗期或随访期因任何原因提前退出，则以其最后一次研究相关访视为研究结束节点。","rationale":"研究时期结构（筛选期最长4周含两次24h咳嗽监测、双盲治疗期12周、安全性随访末次给药后2周）由项目已确认研究事实直接给出，总时长18周为三段算术加和。研究结束定义中'以最后一次研究相关访视为结束节点'为常规结构表述，需医学经理确认是否需区分'研究结束'与'随访结束'的措辞。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d828e848b004_cb270dcee16b2746","section_number":"4.6","source_ids":["protocol_full_draft_selection:5a6be8b60189d5a7371e0025","current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e"]},{"ai_run_id":"airun_20261004044826_ab5e8a40","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"需由医学负责人和安全医学负责人共同制定项目特异的暂停与终止标准，包括个体终止条件、队列暂停触发、研究整体终止决策权限及DMC建议流程","category":"source_missing","gap_id":"gap_stopping_criteria","missing_source_classes":["研究暂停和终止标准","DMC章程"],"target":"研究暂停和终止标准全节"}],"heading":"研究暂停和终止标准","missing_source_classes":["研究暂停和终止标准（项目特异）","DMC章程中的安全性终止条款","剂量限制性毒性定义"],"proposal_text":"","rationale":"允许来源中未提供研究暂停和终止的任何具体标准，包括个体受试者终止条件、队列或中心暂停触发条件、研究整体终止的决策权限与流程。项目已确认事实仅说明DMC计划设置且期中分析不计划，但未涉及安全性或有效性终止规则。在缺少对应项目文件的情况下，不得以通用原则或条件句替代项目特异标准。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d828e848b004_13ec3711aab3e394","section_number":"4.7","source_ids":["protocol_full_draft_selection:5a6be8b60189d5a7371e0025","current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e"]},{"ai_run_id":"airun_20261004044826_ab5e8a40","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"18~75岁难治性/不明原因慢性咳嗽患者，咳嗽病程≥8周且规范评估后无明确可纠正病因，基线24h客观咳嗽频率≥10次/小时","quote_sha256":"35bd3d69df22b2b0acb57356fe6948ea08790bd9b23511e14e9fe4e08973fbfd","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"es_population"},{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"年龄18~75岁，男女不限；慢性咳嗽病程≥8周，规范评估后符合RCC/UCC定义；筛选期两次24h客观咳嗽监测平均≥10次/小时且基线VAS≥40mm；筛选前8周内咳嗽治疗方案稳定；育龄女性妊娠试验阴性并同意有效避孕；能够使用电子咳嗽监测设备并完成电子日记；签署知情同意书","quote_sha256":"337e2749baac6cb2c84f8711130d63661effedb645b152586c85c075d2bbe2c6","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"es_inclusion"},{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"目前吸烟或筛选前6个月内戒烟；合并可能干扰咳嗽评估的呼吸系统疾病（未控制哮喘、COPD伴急性加重史、支气管扩张、活动性肺结核、IPF等间质性肺病）；血管紧张素转换酶抑制剂相关咳嗽且可替代治疗；筛选期体格检查、12导联心电图、实验室检查存在有临床意义异常；妊娠或哺乳期女性；既往使用P2X3拮抗剂类药物且缺乏疗效记录；严重心血管、肝（ALT/AST>2×ULN）、肾（eGFR<50）功能损害；近3个月内参加其他干预性临床试验","quote_sha256":"62c20f6ea1950d5d9bd8043a8db6212678c900b760dddbad1a17b2dcdd5be5d5","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"es_exclusion"},{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"计划入组240例（安慰剂、15mg、45mg、90mg每组各60例）","quote_sha256":"777a1401355955384e694e4d11e678ceb18fa758b0764f98c8be00ac38cb3440","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"es_sample_size"}],"evidence_review_advisories":[],"evidence_span_ids":["es_population","es_inclusion","es_exclusion","es_sample_size"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"由医学负责人确认心电图、实验室检查异常的具体判定阈值或引用通用标准","category":"source_missing","gap_id":"gap_clinical_significance_threshold","missing_source_classes":["安全性评估标准"],"target":"排除标准中'有临床意义异常'的量化判定标准"},{"action":"由医学负责人确认是否指定具体避孕方式或保留概括性表述","category":"source_missing","gap_id":"gap_contraception_method","missing_source_classes":["避孕方法规定"],"target":"育龄女性避孕方法的具体种类"}],"heading":"研究人群","missing_source_classes":["安全性评估标准","避孕方法规定"],"proposal_text":"本研究的目标人群为18至75岁（含）的难治性或不明原因慢性咳嗽成人患者，疾病状态为中重度，且既往经治疗疗效不佳。入选标准如下：签署知情同意时年龄18至75岁，性别不限；慢性咳嗽病程不少于8周，经规范评估后符合难治性或不明原因慢性咳嗽定义；筛选期两次24小时客观咳嗽监测平均咳嗽频率不低于每小时10次，且基线咳嗽视觉模拟评分不低于40毫米；筛选前8周内咳嗽治疗方案保持稳定；育龄女性妊娠试验阴性并同意在研究期间采取有效避孕措施；能够使用电子咳嗽监测设备并完成电子日记记录；自愿签署知情同意书。排除标准如下：目前吸烟或筛选前6个月内戒烟者；合并可能干扰咳嗽评估的呼吸系统疾病，包括未控制哮喘、慢性阻塞性肺疾病伴急性加重史、支气管扩张、活动性肺结核、特发性肺纤维化等间质性肺病；血管紧张素转换酶抑制剂相关咳嗽且存在可替代治疗方案者；筛选期体格检查、12导联心电图或实验室检查存在有临床意义异常者；妊娠或哺乳期女性；既往使用P2X3受体拮抗剂类药物且缺乏疗效记录者；严重心血管、肝功能损害（丙氨酸氨基转移酶或天冬氨酸氨基转移酶超过正常值上限2倍）或肾功能损害（估算肾小球滤过率低于50毫升每分钟）者；近3个月内参加过其他干预性临床试验者。本研究计划入组240例受试者，按安慰剂组、KZ-617 15毫克组、45毫克组和90毫克组各60例进行分配。","rationale":"目标人群描述、入选与排除标准及样本量均直接来源于项目已确认研究事实。排除标准中'有临床意义异常'未给出量化阈值，需医学经理确认是否引用通用判定标准或设定项目特异数值。避孕方法的具体种类未在来源中指定，正文仅保留'有效避孕措施'的概括表述。","review_advisories":["本节复述高影响研究设计（研究人群）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（计划入组）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d828e848b004_9289786d77bdffef","section_number":"5","source_ids":["protocol_full_draft_selection:5a6be8b60189d5a7371e0025","current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e"]}],"source_bindings":[{"content_sha256":"82b8ed586d71d453861c81380f0ef09c2dc7dbc403b5772679482cd45e93e7a7","locator":"document:mwdoc_greenfield_proj_user_d828e848b004_4599f7b526b2bbc8:full-draft:5a6be8b60189d5a7371e0025","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:5a6be8b60189d5a7371e0025","source_type":"protocol_full_draft_selection","source_version":"full-draft:09cd7d7ba