_selection:27b5eee881e18e736196ac7e","current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e"]},{"ai_run_id":"airun_20261004051608_24748885","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"主要估计目标采用治疗策略（treatment policy）：无论是否中止研究治疗或使用补救/合并治疗，评价第12周24小时咳嗽频率（log-rate）较基线的变化。伴发事件：中止治疗者仍纳入主要分析（mITT）；补救用药记录为伴发事件并汇总描述，不作为排除依据。","quote_sha256":"a4096c70d3672d82d8cf5f8fec7d6e33e8c8783429f8a4dc1e0ecc3d7faba907","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"es_treatment_strategy"},{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"研究时期：筛选期（最长4周，含两次24h咳嗽监测）；双盲治疗期（12周）；安全性随访（末次给药后2周）","quote_sha256":"2b3a96a46a02639cc471e8d3555ca737b6ee9dac7dc5a1ea186d83f8ed542968","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"es_safety_followup"}],"evidence_review_advisories":[],"evidence_span_ids":["es_treatment_strategy","es_safety_followup"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"获取项目操作手册中关于治疗终止后随访安排、退出研究判定标准、失访定义及退出后数据采集截止点的条款","category":"source_missing","gap_id":"gap_withdrawal_procedure","missing_source_classes":["项目操作手册","数据管理计划"],"target":"7.1.4 研究治疗终止、退出研究及失访处理"},{"action":"确认失访后是否安排电话或远程安全性随访及相应记录要求","category":"source_missing","gap_id":"gap_loss_to_followup","missing_source_classes":["项目操作手册"],"target":"7.1.4 研究治疗终止、退出研究及失访处理"}],"heading":"研究治疗终止、退出研究及失访处理","missing_source_classes":["项目操作手册（退出/失访流程）","数据管理计划（数据采集截止规则）"],"proposal_text":"本研究采用治疗策略（treatment policy）作为主要估计目标：无论受试者是否中止研究治疗或使用补救/合并治疗，均评价第12周24小时咳嗽频率（log-rate）较基线的变化。中止研究治疗者仍纳入主要分析集（mITT），补救用药记录为伴发事件并汇总描述，不作为排除依据。研究治疗终止后，受试者应完成末次给药后2周的安全性随访访视，以评估不良事件转归及安全性终点。退出研究及失访的具体判定标准、退出后数据采集截止时点、失访后是否继续电话或远程随访以及相应记录要求，需依据项目操作手册进一步确定。","rationale":"治疗策略、mITT纳入规则及补救用药处理方式来源于已确认研究事实中的估计目标策略描述；安全性随访窗口（末次给药后2周）来源于研究时期定义。退出与失访的操作流程在允许来源中未给出，需项目操作手册或数据管理计划补充。","review_advisories":["本节提及高影响设计信息（估计目标、伴发事件）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d828e848b004_b06ce15ddf7c574f","section_number":"7.1.4","source_ids":["protocol_full_draft_selection:27b5eee881e18e736196ac7e","current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e"]},{"ai_run_id":"airun_20261004051608_24748885","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"主要终点：治疗第12周24小时咳嗽频率（咳嗽监测设备，Leq计权每小时咳嗽次数的对数变换）较基线的变化（log-rate差）","quote_sha256":"0918a4decd17182bf6cc4a44d983d961b784745137b9c06fb4aab45aefdc25b5","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"es_primary_endpoint"},{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"关键次要终点：第12周LCQ总分较基线变化；咳嗽缓解应答（≥50%频率下降）率","quote_sha256":"d3ee95cbe9e6d4e013a035e4ee541ec85e415f14c137d8f894dead7633f1a4e2","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"es_secondary_endpoint"},{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"第0周与第12周访视前各完成48h（两个24h均值）咳嗽监测，第2/4/8周家庭设备单次24h","quote_sha256":"bb40fc8409fa373805ac7bb27ca478731281f2ef37b5d9317edd9e3680211043","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"es_cough_monitoring"},{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"主要终点采用MMRM（协变量：中心、基线咳嗽频率、访视及访视×治疗组别交互）；剂量-反应采用MCP-Mod（线性/Emax/指数等多剂量形状联合检验），多重性经关门程序与MCP-Mod联合控制；敏感性分析含ANCOVA与多重填补；关键次要终点LCQ变化与咳嗽缓解应答率按层级检验；安全性基于安全性分析集按组描述，味觉障碍发生率做趋势检验。","quote_sha256":"1aafb6e7d573f8d0dd01665cc8fb0f67ae12469cb99d402771e365bb456ebe06","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"es_stat_strategy"},{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"探索性研究目的：探索基线咳嗽频率、 demographic 特征与疗效的关系；采集血样进行群体药代/暴露-效应分析。","quote_sha256":"b0dfbba9aac94cd5d965b5ff09a0ff5b4c1b2ed98e3586a34893b3739ae652a5","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"es_exploratory"},{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"次要研究目的：评价对咳嗽相关生活质量（LCQ总分）、咳嗽严重度VAS、咳嗽缓解应答率的影响；评估日间与夜间咳嗽频率的差别效应；评价安全性与耐受性，重点描述味觉障碍、口干、头痛等不良事件。","quote_sha256":"f2505fb1db9208c7be05781ebf58c352248cc88eaafb53aa14864e2ae3155557","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"es_secondary_purpose"}],"evidence_review_advisories":[],"evidence_span_ids":["es_primary_endpoint","es_secondary_endpoint","es_cough_monitoring","es_stat_strategy","es_exploratory","es_secondary_purpose"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"确认第2/4/8/12周各访视是否同步完成LCQ总分与咳嗽严重度VAS采集，以及咳嗽监测设备校准与数据下载流程","category":"source_missing","gap_id":"gap_assessment_matrix","missing_source_classes":["访视评估项目矩阵","设备操作手册"],"target":"7.2 有效性评估"},{"action":"确认LCQ量表版本、中文授权及研究者培训要求","category":"source_not_retrieved","gap_id":"gap_lcq_version","missing_source_classes":["量表授权文件","培训记录"],"target":"7.2 有效性评估"}],"heading":"有效性评估","missing_source_classes":["咳嗽监测设备技术规格与校准SOP","LCQ量表版本授权文件","各访视评估项目矩阵（确认LCQ/VAS采集时点）"],"proposal_text":"本研究主要有效性终点为治疗第12周24小时咳嗽频率（采用咳嗽监测设备，以Leq计权每小时咳嗽次数的对数变换表示）较基线的变化（log-rate差）。关键次要终点包括第12周LCQ总分较基线变化及咳嗽缓解应答率（定义为咳嗽频率较基线下降≥50%）。次要研究目的还涵盖咳嗽严重度VAS、日间与夜间咳嗽频率的差别效应。咳嗽频率采集安排如下：第0周与第12周访视前各完成48小时（两个24小时均值）咳嗽监测，第2、4、8周采用家庭设备完成单次24小时咳嗽监测。主要终点统计分析采用MMRM模型，协变量包括中心、基线咳嗽频率、访视及访视×治疗组别交互；剂量-反应分析采用MCP-Mod方法（线性、Emax、指数等多剂量形状联合检验），多重性经关门程序与MCP-Mod联合控制；敏感性分析含ANCOVA与多重填补。关键次要终点LCQ变化与咳嗽缓解应答率按层级检验。探索性目的包括探索基线咳嗽频率及人口学特征与疗效的关系，并采集血样进行群体药代动力学与暴露-效应分析。","rationale":"主要终点定义、咳嗽监测设备与采集时点、关键次要终点、统计模型及探索性目的均来源于已确认研究事实中的终点定义、访视策略和统计分析策略。各访视是否同步完成LCQ和VAS采集、咳嗽监测设备型号与校准要求、LCQ版本及授权、VAS量表具体格式等实施细节需医学经理与数据管理团队确认。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d828e848b004_85565663a38d29d9","section_number":"7.2","source_ids":["protocol_full_draft_selection:27b5eee881e18e736196ac7e","current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e"]},{"ai_run_id":"airun_20261004051608_24748885","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"安全性终点：TEAE/SAE；味觉障碍（味觉功能问卷+客观味觉测试）；实验室；12导联心电图；生命体征","quote_sha256":"79ddd0da77ab22b5d158169fe772364ec12ae598344a956e9264a517d872d1b1","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"es_safety_endpoints"},{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"研究时期：筛选期（最长4周，含两次24h咳嗽监测）；双盲治疗期（12周）；安全性随访（末次给药后2周）","quote_sha256":"2b3a96a46a02639cc471e8d3555ca737b6ee9dac7dc5a1ea186d83f8ed542968","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"es_safety_followup"},{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"KZ-617 15mg、45mg、90mg口服每日两次，连续治疗12周（第1~2周为安全导入滴定：90mg组由45mg起始），匹配双模拟安慰剂。","quote_sha256":"5b4d8b6a28fa945f528f43cd568e831625710e53fe17c44a193de418eaf2a164","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"es_dose_regimen"},{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"主要终点采用MMRM（协变量：中心、基线咳嗽频率、访视及访视×治疗组别交互）；剂量-反应采用MCP-Mod（线性/Emax/指数等多剂量形状联合检验），多重性经关门程序与MCP-Mod联合控制；敏感性分析含ANCOVA与多重填补；关键次要终点LCQ变化与咳嗽缓解应答率按层级检验；安全性基于安全性分析集按组描述，味觉障碍发生率做趋势检验。","quote_sha256":"1aafb6e7d573f8d0dd01665cc8fb0f67ae12469cb99d402771e365bb456ebe06","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"es_stat_strategy"},{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"次要研究目的：评价对咳嗽相关生活质量（LCQ总分）、咳嗽严重度VAS、咳嗽缓解应答率的影响；评估日间与夜间咳嗽频率的差别效应；评价安全性与耐受性，重点描述味觉障碍、口干、头痛等不良事件。","quote_sha256":"f2505fb1db9208c7be05781ebf58c352248cc88eaafb53aa14864e2ae3155557","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"es_secondary_purpose"}],"evidence_review_advisories":[],"evidence_span_ids":["es_safety_endpoints","es_safety_followup","es_dose_regimen","es_stat_strategy","es_secondary_purpose"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"获取项目安全性管理计划中TEAE采集窗口定义、SAE报告时限与报告对象、SUSAR处理流程","category":"source_missing","gap_id":"gap_teae_definition","missing_source_classes":["项目安全性管理计划","安全性报告SOP"],"target":"7.3 安全性评估"},{"action":"确认实验室检查具体项目、采集频率及各访视心电图与生命体征采集安排","category":"source_missing","gap_id":"gap_lab_ecg_schedule","missing_source_classes":["访视评估项目矩阵","实验室操作手册"],"target":"7.3 安全性评估"},{"action":"确认末次给药后2周安全性随访访视的具体评估项目与不良事件转归记录要求","category":"source_missing","gap_id":"gap_safety_followup_content","missing_source_classes":["项目操作手册"],"target":"7.3 安全性评估"},{"action":"确认客观味觉测试的具体方法、工具及操作规范","category":"source_not_retrieved","gap_id":"gap_taste_test_method","missing_source_classes":["味觉评估操作手册"],"target":"7.3 安全性评估"}],"heading":"安全性评估","missing_source_classes":["项目安全性管理计划","TEAE/SAE定义与报告SOP","实验室检查项目清单与频率","安全性随访访视评估项目清单"],"proposal_text":"本研究安全性评估涵盖以下终点：治疗期间不良事件（TEAE）及严重不良事件（SAE）的发生率与特征；味觉障碍（通过味觉功能问卷结合客观味觉测试评估）；实验室检查；12导联心电图；生命体征。次要研究目的中明确重点描述味觉障碍、口干、头痛等不良事件。安全性分析基于安全性分析集按组描述，味觉障碍发生率进行趋势检验。安全性随访期为末次给药后2周，该访视用于评估不良事件转归及安全性终点。90mg剂量组在第1至2周采用45mg起始的安全导入滴定方案，旨在降低初始暴露相关不良事件风险。","rationale":"安全性终点清单（TEAE/SAE、味觉障碍、实验室、心电图、生命体征）、味觉障碍评估方式、安全性分析策略及安全性随访窗口均来源于已确认研究事实。TEAE采集窗口的精确定义（如是否包含首次给药前24小时内的不良事件）、SAE报告时限与报告对象、实验室检查具体项目与采集频率、心电图采集时点、安全性随访访视的具体评估内容以及90mg组滴定方案的安全性监测要求等实施细节在允许来源中未逐项给出，需项目安全性管理计划或操作手册确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d828e848b004_d48a7444eed72aa3","section_number":"7.3","source_ids":["protocol_full_draft_selection:27b5eee881e18e736196ac7e","current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e"]}],"source_bindings":[{"content_sha256":"e757f6de54d210c55349f9a6646a403a2cf240356660a78842e9834c2a324b59","locator":"document:mwdoc_greenfield_proj_user_d828e848b004_4599f7b526b2bbc8:full-draft:27b5eee881e18e736196ac7e","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:27b5eee881e18e736196ac7e","source_type":"protocol_full_draft_selection","source_version":"full-draft:09cd7d7ba68f642e5a3799055ef3721896a55a46dc138ed6e990460233b2997e:27b5eee881e18e736196ac7e","text_sha256":"e757f6de54d210c55349f9a6646a403a2cf240356660a78842e9834c2a324b59"},{"content_sha256":"766189fa02dc7f84e587aa9cf712b9c03ef3f504177110092d01762943dd5d6b","locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","source_type":"current_project_study_definition","source_version":"mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","text_sha256":"766189fa02dc7f84e587aa9cf712b9c03ef3f504177110092d01762943dd5d6b"}]}