765fb011b2d06a8a90eaf84bdf5488","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:1e80f33ff07300","span_id":"es_amendment"},{"locator":"section:研究方案|block:3|chunk:1","quote":"本文件中的信息保密，所有权归申办者。根据中国法律法规要求，本文件仅提供给研究者和伦理委员会、监督管理部门等相关的机构审阅。","quote_sha256":"4f5c07ce470a95a86d7f9d50dd5a3cc69daf4170f29b742146e2d67dea109370","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","span_id":"es_confidentiality"}],"evidence_review_advisories":[],"evidence_span_ids":["es_icf_inclusion","es_amendment","es_confidentiality"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":1},"gap_items":[{"action":"待知情同意书定稿后补充版本号、语言版本及是否采用电子知情同意","category":"source_not_retrieved","gap_id":"gap_11_2_icf_version","missing_source_classes":["知情同意书模板及版本"],"target":"知情同意章节中知情同意书的具体版本、语言及电子知情同意适用性"},{"action":"待各中心启动前确认知情同意签署流程、见证人要求及特殊人群同意方式","category":"source_not_retrieved","gap_id":"gap_11_2_consent_process","missing_source_classes":["各中心知情同意操作规程"],"target":"知情同意章节中各中心知情同意签署流程及见证要求"}],"heading":"知情同意","missing_source_classes":["知情同意书模板及版本","电子知情同意适用性说明"],"proposal_text":"本项研究要求所有受试者在接受任何研究相关操作之前，由研究者或其授权人员向其充分说明研究目的、设计、预期获益与潜在风险，并在受试者充分理解后自愿签署书面知情同意书。签署知情同意书为本研究入选的必要条件，未签署知情同意书的个体不得进入筛选或接受任何研究干预。知情同意书须经伦理委员会审查批准后方可使用。在研究进行期间，如果知情同意书内容发生修订，须再次获得伦理委员会书面核准后方可使用更新版本。本方案中所包含的信息归申办方所有，除在与可能参加本研究的受试者签署知情同意书时向其做必要的解释之外，未经申办方书面授权许可，任何个人不得分发、复制或披露本文件的任何内容。","rationale":"知情同意为入选必要条件来源于当前项目已确认的入选标准；知情同意书须经伦理批准及修订再审批的流程参照公司语料中监管共性结构；保密及分发限制条款来源于公司语料，仅作措辞参照。知情同意书具体版本、语言、电子知情同意适用性及各中心知情同意流程细节尚未在允许来源中明确。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d828e848b004_b191a92452ecc0cc","section_number":"11.2","source_ids":["protocol_full_draft_selection:05ecc10cc6321dde9ee0672c","current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:9939b9aa574982","company_corpus:cms_cn_protocol_corpus_20260715_v1:1e80f33ff07300","company_corpus:cms_cn_protocol_corpus_20260715_v1:eb9da1374976e3"]},{"ai_run_id":"airun_20261004062850_8e809fc8","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:伦理委员会|block:897|chunk:1","quote":"伦理委员会将审查研究方案及其修订、知情同意书、用于招募参与者的招募材料、以及提供给参与者的任何书面材料。","quote_sha256":"88c8c4dce07b71b55d0be4236a551acdce6aa01747b0ec7fa98a4d2fa5ec8100","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:eb9da1374976e3","span_id":"es_ec_scope"},{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"中心模式：多中心","quote_sha256":"2cfa68bc992967c797bbd3113b5e0d0844d660a2050095a31f08358c5e40311f","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"es_multicenter"},{"locator":"section:11.1 遵守法律法规|block:922|chunk:1","quote":"在研究进行期间，如果研究方案、知情同意书等有任何新增修订，都应根据法规再次获得相关管理单位的书面核准意见。","quote_sha256":"62e09657872ac96c9dc7be6e309f71e339765fb011b2d06a8a90eaf84bdf5488","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:1e80f33ff07300","span_id":"es_amendment"}],"evidence_review_advisories":[],"evidence_span_ids":["es_ec_scope","es_multicenter","es_amendment"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":1},"gap_items":[{"action":"待各中心确定后明确伦理审查模式及主审或独立审查安排","category":"source_not_retrieved","gap_id":"gap_11_3_ec_mode","missing_source_classes":["多中心伦理审查协调机制文件"],"target":"伦理委员会章节中多中心伦理审查模式（主审或独立审查）及协调机制"},{"action":"待各中心启动后补充伦理委员会名称、批件编号及审查日期","category":"source_not_retrieved","gap_id":"gap_11_3_ec_names","missing_source_classes":["各中心伦理委员会批件"],"target":"伦理委员会章节中各参与中心伦理委员会名称及批件信息"}],"heading":"伦理委员会","missing_source_classes":["各中心伦理委员会批件","多中心伦理审查协调机制文件"],"proposal_text":"本项研究在实施前须经各参与中心伦理委员会审查批准。伦理委员会将审查研究方案及其修订、知情同意书、用于招募参与者的招募材料、以及提供给参与者的任何书面材料。本研究为多中心设计，各中心均须独立获得本机构伦理委员会的书面批准后方可启动受试者入组。在研究进行期间，如果研究方案、知情同意书等有任何新增修订，都应根据法规再次获得相关管理单位的书面核准意见。研究者有责任向伦理委员会报告有关研究的进展情况，并及时将与伦理委员会之间的所有通讯副本交于申办者。伦理委员会在审阅及批准研究方案时，须确认方案标题、方案编号，并注明已评审的方案文件及评审日期。","rationale":"伦理委员会审查范围来源于公司语料中伦理委员会章节的监管共性结构；多中心独立审批来源于当前项目已确认的多中心设计事实；修订再审批及报告义务来源于公司语料中11.1节。各中心伦理委员会名称、审查模式（主审或独立审查）及协调机制尚未确定，需医学经理确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d828e848b004_d1d5d6bbcd520376","section_number":"11.3","source_ids":["protocol_full_draft_selection:05ecc10cc6321dde9ee0672c","current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:9939b9aa574982","company_corpus:cms_cn_protocol_corpus_20260715_v1:1e80f33ff07300","company_corpus:cms_cn_protocol_corpus_20260715_v1:eb9da1374976e3"]}],"source_bindings":[{"content_sha256":"bc742ef5783c3a5c2e687d006abbaddba02b3655a7b2fb9504ce74cb7ff6ee09","locator":"document:mwdoc_greenfield_proj_user_d828e848b004_4599f7b526b2bbc8:full-draft:05ecc10cc6321dde9ee0672c","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:05ecc10cc6321dde9ee0672c","source_type":"protocol_full_draft_selection","source_version":"full-draft:09cd7d7ba68f642e5a3799055ef3721896a55a46dc138ed6e990460233b2997e:05ecc10cc6321dde9ee0672c","text_sha256":"bc742ef5783c3a5c2e687d006abbaddba02b3655a7b2fb9504ce74cb7ff6ee09"},{"content_sha256":"766189fa02dc7f84e587aa9cf712b9c03ef3f504177110092d01762943dd5d6b","locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","source_type":"current_project_study_definition","source_version":"mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","text_sha256":"766189fa02dc7f84e587aa9cf712b9c03ef3f504177110092d01762943dd5d6b"},{"content_sha256":"