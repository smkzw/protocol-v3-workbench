"20974e6853309a3c94cba0a971e380834d002e69aeaf1b2ffdcf0c5e55e9e1c6","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"sp_sd_mechanism"},{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"KZ-617片：KZ-617 15mg、45mg、90mg口服每日两次，连续治疗12周（第1~2周为安全导入滴定：90mg组由45mg起始）","quote_sha256":"58cd2cbc005fa8ecbfee4efda9d3604215c990eb4f62618573feb96e705082e6","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"sp_sd_dose"},{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"试验干预：KZ-617 15mg、45mg、90mg口服每日两次，连续治疗12周（第1~2周为安全导入滴定：90mg组由45mg起始），匹配双模拟安慰剂","quote_sha256":"44a0912c6ae978083727a38698817c975fdb8930757eaadad768569d29e0f705","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"sp_sd_intervention"}],"evidence_review_advisories":[],"evidence_span_ids":["sp_packet_421","sp_sd_title","sp_sd_drug","sp_sd_mechanism","sp_sd_dose","sp_sd_intervention"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"检索并纳入KZ-617研究者手册及非临床药理与毒理资料，补充各剂量水平的暴露与安全性依据","category":"source_not_retrieved","gap_id":"gap_421_dose_nonclinical","missing_source_classes":["研究者手册（IB）","非临床药理与毒理资料"],"target":"4.2.1 剂量选择依据"},{"action":"检索并纳入既往临床研究资料与剂量-暴露-效应分析结果，补充15 mg、45 mg、90 mg剂量选择及90 mg组安全导入滴定的依据","category":"source_not_retrieved","gap_id":"gap_421_dose_clinical","missing_source_classes":["既往临床研究资料","剂量-暴露-效应分析资料"],"target":"4.2.1 剂量选择依据"}],"heading":"剂量选择依据","missing_source_classes":["研究者手册（IB）","非临床药理与毒理资料","既往临床研究资料","剂量-暴露-效应分析资料"],"proposal_text":"KZ-617为口服高选择性P2X3受体拮抗剂。P2X3受体为ATP门控阳离子通道，高表达于气道C纤维与Aδ感觉神经末梢；气道炎症与损伤释放的ATP经P2X3/P2X2/3通道激活感觉神经，是咳嗽反射敏感化的关键机制，且P2X3敲除小鼠咳嗽反射显著减弱，支持该靶点镇咳的生物学合理性。本研究在难治性/不明原因慢性咳嗽患者中设置KZ-617 15 mg、45 mg、90 mg三个口服剂量组，每日两次给药，连续治疗12周，并设置匹配的双模拟安慰剂对照。其中，90 mg组在第1~2周为安全导入滴定阶段，由45 mg起始给药。","rationale":"本章节内容基于已确认事实：KZ-617为口服高选择性P2X3受体拮抗剂，P2X3受体机制支持镇咳治疗的生物学合理性；研究设置15 mg、45 mg、90 mg三个口服剂量组，每日两次，连续治疗12周，90 mg组第1~2周由45 mg起始安全导入滴定，并设匹配双模拟安慰剂对照。医学审核需结合研究者手册、非临床药理与毒理资料及既往临床剂量-暴露-效应资料核对各剂量水平的剂量选择论证。","review_advisories":["本节复述高影响研究设计（剂量选择依据）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d828e848b004_5f0cc4e9a10e27b1","section_number":"4.2.1","source_ids":["protocol_full_draft_selection:bdb7dcfc21a55571e62db1a7","current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:97a2bd7fcf7302"]},{"ai_run_id":"airun_20261004044407_8017a41d","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_d828e848b004_4599f7b526b2bbc8:full-draft:bdb7dcfc21a55571e62db1a7","quote":"章节编号=4.3\n章节标题=随机化\n章节类型=section\n当前正文=采用随机化分配。","quote_sha256":"abd83d64e0bfdfb16ad81aba49b0e40b94a606e3750c69b36e81d81b7bc970d2","source_id":"protocol_full_draft_selection:bdb7dcfc21a55571e62db1a7","span_id":"sp_packet_43"},{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"按1:1:1:1随机，分层因素为中心与基线咳嗽频率（<20 vs ≥20次/小时）","quote_sha256":"3784c6d7a7c7f4a9f8f130c7ecd67f0919619313b394f62bea3b87fed09ebf35","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"sp_sd_random"},{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"样本量策略：计划入组240例（安慰剂、15mg、45mg、90mg每组各60例）","quote_sha256":"4ae80b7efd75408be045a4257c7b6c317c5a7df117ae8f9a193c0f8e87d69501","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"sp_sd_sample"},{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"KZ-617片：KZ-617 15mg、45mg、90mg口服每日两次，连续治疗12周（第1~2周为安全导入滴定：90mg组由45mg起始）","quote_sha256":"58cd2cbc005fa8ecbfee4efda9d3604215c990eb4f62618573feb96e705082e6","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"sp_sd_dose"}],"evidence_review_advisories":[],"evidence_span_ids":["sp_packet_43","sp_sd_random","sp_sd_sample","sp_sd_dose"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"检索并纳入项目随机化方案或随机化实施文件，补充随机化系统、区组设置、随机种子生成与保存、分配隐藏等操作要求","category":"source_not_retrieved","gap_id":"gap_43_random_impl","missing_source_classes":["随机化方案/随机化实施文件","统计分析与随机化系统说明"],"target":"4.3 随机化"}],"heading":"随机化","missing_source_classes":["随机化方案/随机化实施文件","统计分析与随机化系统说明"],"proposal_text":"本研究采用随机化分配，分配模型为平行组。计划入组240例受试者，按1:1:1:1比例随机分配至安慰剂组及KZ-617 15 mg、45 mg、90 mg三个剂量组，每组60例。随机化按中心与基线咳嗽频率（<20次/小时 vs ≥20次/小时）分层。随机分配结果用于确定每例受试者进入的治疗组。","rationale":"本章节内容基于已确认事实：采用随机化分配，分配模型为平行组；计划入组240例，按1:1:1:1比例随机分配至四个治疗组，每组60例；随机化按中心与基线咳嗽频率（<20次/小时 vs ≥20次/小时）分层。医学审核需核对随机化系统、区组设置、随机种子生成与保存、分配隐藏等实施要求，相关项目级来源未包含在本次允许来源中。","review_advisories":["本节复述高影响研究设计（随机化）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（计划入组）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d828e848b004_cad5354a202dd834","section_number":"4.3","source_ids":["protocol_full_draft_selection:bdb7dcfc21a55571e62db1a7","current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:97a2bd7fcf7302"]},{"ai_run_id":"airun_20261004044407_8017a41d","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_d828e848b004_4599f7b526b2bbc8:full-draft:bdb7dcfc21a55571e62db1a7","quote":"章节编号=4.4\n章节标题=盲法与揭盲\n章节类型=section\n当前正文=本研究采用双盲设计。","quote_sha256":"7662b497258064bbd4245f644e4ed5814057c21b795c4ccc2af9444ff504d348","source_id":"protocol_full_draft_selection:bdb7dcfc21a55571e62db1a7","span_id":"sp_packet_44"},{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"试验干预：KZ-617 15mg、45mg、90mg口服每日两次，连续治疗12周（第1~2周为安全导入滴定：90mg组由45mg起始），匹配双模拟安慰剂","quote_sha256":"44a0912c6ae978083727a38698817c975fdb8930757eaadad768569d29e0f705","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"sp_sd_intervention"},{"locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","quote":"安慰剂：KZ-617 15mg、45mg、90mg口服每日两次组对照安慰剂组（模拟片每日两次）","quote_sha256":"0a499944ebd15d7bf2d7c9ac3569b8ec50434d25c2ec0b7154e040b3584d1b27","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","span_id":"sp_sd_placebo"}],"evidence_review_advisories":[],"evidence_span_ids":["sp_packet_44","sp_sd_intervention","sp_sd_placebo"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"检索并纳入项目揭盲程序文件，补充揭盲触发条件、紧急揭盲操作方式、记录要求及相关职责","category":"source_not_retrieved","gap_id":"gap_44_unblinding","missing_source_classes":["揭盲程序文件/紧急揭盲操作文件"],"target":"4.4 盲法与揭盲"},{"action":"检索并纳入盲法设计说明或揭盲程序文件，明确双盲设计下的盲态范围与盲态维持要求","category":"source_not_retrieved","gap_id":"gap_44_blind_scope","missing_source_classes":["盲法设计说明"],"target":"4.4 盲法与揭盲"}],"heading":"盲法与揭盲","missing_source_classes":["揭盲程序文件/紧急揭盲操作文件","盲法设计说明"],"proposal_text":"本研究采用双盲设计。受试者按1:1:1:1比例随机分配至安慰剂组及KZ-617 15 mg、45 mg、90 mg三个剂量组；安慰剂组接受与各剂量组匹配的双模拟安慰剂（模拟片），每日两次口服给药，与相应剂量KZ-617片的给药方案一致，以在治疗期间维持双盲状态。","rationale":"本章节内容基于已确认事实：研究采用双盲设计，受试者按1:1:1:1随机分配，安慰剂组接受与各剂量组匹配的双模拟安慰剂（模拟片），每日两次口服给药。医学审核需核对揭盲条件、紧急揭盲流程、操作人员与记录要求以及双盲设计下的盲态范围，相关项目级来源未包含在本次允许来源中。","review_advisories":["本节复述高影响研究设计（盲法与揭盲）；请在合并设计摘要中统一核对。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_d828e848b004_e9725f939a8237a0","section_number":"4.4","source_ids":["protocol_full_draft_selection:bdb7dcfc21a55571e62db1a7","current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:97a2bd7fcf7302"]}],"source_bindings":[{"content_sha256":"ca7a26c1388a121c934c1c5f91f5defd30e6f2ae1ee6d2988ca8e32abcf4f8e7","locator":"document:mwdoc_greenfield_proj_user_d828e848b004_4599f7b526b2bbc8:full-draft:bdb7dcfc21a55571e62db1a7","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:bdb7dcfc21a55571e62db1a7","source_type":"protocol_full_draft_selection","source_version":"full-draft:09cd7d7ba68f642e5a3799055ef3721896a55a46dc138ed6e990460233b2997e:bdb7dcfc21a55571e62db1a7","text_sha256":"ca7a26c1388a121c934c1c5f91f5defd30e6f2ae1ee6d2988ca8e32abcf4f8e7"},{"content_sha256":"766189fa02dc7f84e587aa9cf712b9c03ef3f504177110092d01762943dd5d6b","locator":"study_definition:mwdefinition_888686c1310a849fa905:revision:7","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","source_type":"current_project_study_definition","source_version":"mwdefinition_888686c1310a849fa905:r7:5f50b13d370ad80e","text_sha256":"766189fa02dc7f84e587aa9cf712b9c03ef3f504177110092d01762943dd5d6b"},{"content_sha256":"561c757e6967fae66f0f9d1043dba3e313bd0ee60a03f2c3c8da5efe892b0128","locator":"section:6.3.3 揭盲|block:490|chunk:1","role":"company_sop_or_protoco