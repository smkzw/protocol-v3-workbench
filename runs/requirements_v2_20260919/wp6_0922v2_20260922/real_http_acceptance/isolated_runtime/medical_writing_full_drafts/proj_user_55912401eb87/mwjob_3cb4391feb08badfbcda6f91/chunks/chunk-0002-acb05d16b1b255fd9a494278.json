":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_bd15506daefbfc1ca532:revision:9","quote":"靶点/作用机制：双重食欲素受体（OX1R/OX2R）拮抗","quote_sha256":"e1b1730f52c1c8a241093693a9bd78c0a48197c8031ea9a7f65a230df182ea2f","source_id":"current_project_study_definition:mwdefinition_bd15506daefbfc1ca532:r9:6616f4d8e17b5f6a","span_id":"es_001"},{"locator":"study_definition:mwdefinition_bd15506daefbfc1ca532:revision:9","quote":"内在研究目的：机制验证（PoM）；概念验证（PoC）；剂量探索","quote_sha256":"c5ce0a4ae855b3917b72509b65cdb30f2bf5cb701d39049871b6a567e7dd2650","source_id":"current_project_study_definition:mwdefinition_bd15506daefbfc1ca532:r9:6616f4d8e17b5f6a","span_id":"es_003"},{"locator":"document:mwdoc_greenfield_proj_user_55912401eb87_3fef6d6f1a1af3bc:full-draft:acb05d16b1b255fd9a494278","quote":"双重食欲素受体（OX1R/OX2R）拮抗\n机制验证（PoM）；概念验证（PoC）；剂量探索","quote_sha256":"2c7ad1c576e1ed61ed3ccb5fb5832559f8dcbf80fbee431b4202a8e5d09936ad","source_id":"protocol_full_draft_selection:acb05d16b1b255fd9a494278","span_id":"es_004"},{"locator":"study_definition:mwdefinition_bd15506daefbfc1ca532:revision:9","quote":"总体研究设计：随机、双盲、安慰剂对照、平行组剂量探索设计（5mg/15mg/30mg，每晚一次睡前口服）","quote_sha256":"ea8dd30dffd888b6eb5d4eeaefb313d880259d68c0262f92fbdd0620f479d4c4","source_id":"current_project_study_definition:mwdefinition_bd15506daefbfc1ca532:r9:6616f4d8e17b5f6a","span_id":"es_005"},{"locator":"study_definition:mwdefinition_bd15506daefbfc1ca532:revision:9","quote":"主要终点：第4周多导睡眠图（PSG）测量的持续入睡潜伏期（sLPS）自基线的变化。","quote_sha256":"12a5ef0e4644e9af1e11cfeda6a040259cfc0f70b14c45a1dae6651a115d9395","source_id":"current_project_study_definition:mwdefinition_bd15506daefbfc1ca532:r9:6616f4d8e17b5f6a","span_id":"es_006"},{"locator":"study_definition:mwdefinition_bd15506daefbfc1ca532:revision:9","quote":"关键次要终点：第4周失眠严重程度指数（ISI）总分自基线的变化；第4周PSG总睡眠时间（TST）及入睡觉醒次数（WASO）自基线的变化；第1、2、4周患者报告入睡潜伏期（sSOL）；第4周CGI-I应答率","quote_sha256":"7667fc995f404f7282729ec28057eb8447d117ef5a91c72ce83f02ed596e61cc","source_id":"current_project_study_definition:mwdefinition_bd15506daefbfc1ca532:r9:6616f4d8e17b5f6a","span_id":"es_007"},{"locator":"study_definition:mwdefinition_bd15506daefbfc1ca532:revision:9","quote":"安全性终点：治疗期间不良事件（TEAE）及严重不良事件（SAE）发生率（安全事件集）；嗜睡、猝倒样事件、睡眠瘫痪、入睡前幻觉等神经系统特殊事件发生率；肝功能异常（ALT/AST>3×ULN）发生率；夜间血氧饱和度下降/呼吸相关不良事件发生率；跌倒及意外伤害发生率；自杀意念/行为（C-SSRS）阳性率","quote_sha256":"d9b8f6cc3556d70512377179744ca49ac81e9eb724f90fb072e86175e18c8dd9","source_id":"current_project_study_definition:mwdefinition_bd15506daefbfc1ca532:r9:6616f4d8e17b5f6a","span_id":"es_008"},{"locator":"study_definition:mwdefinition_bd15506daefbfc1ca532:revision:9","quote":"试验干预：T5-DORA-03片，口服，每晚一次睡前30分钟服用；设5mg、15mg、30mg三个剂量组。","quote_sha256":"1b36f9cb04709488b92e0eca50a01fa374922aeaf055e7cffbcc023eb0692884","source_id":"current_project_study_definition:mwdefinition_bd15506daefbfc1ca532:r9:6616f4d8e17b5f6a","span_id":"es_011"},{"locator":"study_definition:mwdefinition_bd15506daefbfc1ca532:revision:9","quote":"研究时期：筛选期（≤28天）→ 基线 → 双盲治疗期（4周）→ 安全性随访（停药后1周）","quote_sha256":"dc215d531ecde20ee9b9283928cfd8aa4fee786481a9f4663eeed6439815f877","source_id":"current_project_study_definition:mwdefinition_bd15506daefbfc1ca532:r9:6616f4d8e17b5f6a","span_id":"es_012"},{"locator":"study_definition:mwdefinition_bd15506daefbfc1ca532:revision:9","quote":"目标研究人群：年龄段：成人；疾病状态：轻中度；18-65岁成人失眠障碍患者（DSM-5-TR），ISI≥8分","quote_sha256":"ca923fef79ddb244fe9b2041f2ef91a9c9c03163600ac608c23d9b9ab1f1c431","source_id":"current_project_study_definition:mwdefinition_bd15506daefbfc1ca532:r9:6616f4d8e17b5f6a","span_id":"es_014"}],"evidence_review_advisories":[],"evidence_span_ids":["es_001","es_003","es_004","es_005","es_006","es_007","es_008","es_011","es_012","es_014"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":9},"gap_items":[{"action":"补充T5-DORA-03剂量选择依据（如受体占有率数据、PK/PD建模、I期安全性数据），以支撑5mg/15mg/30mg三剂量设计的合理性","category":"source_missing","gap_id":"gap_24_dose_rationale","missing_source_classes":["非临床受体药理学数据","PK/PD建模报告","I期临床安全性数据"],"target":"2.4节中剂量选择依据段落"},{"action":"检索并引用食欲素系统在睡眠-觉醒调节中的关键文献，为OX1R/OX2R拮抗策略提供文献支持","category":"source_not_retrieved","gap_id":"gap_24_orexin_background","missing_source_classes":["食欲素系统药理学文献","失眠障碍病理机制综述"],"target":"2.4节中食欲素系统生理角色描述"}],"heading":"本研究的理论基础","missing_source_classes":["非临床研究摘要（受体药理学、安全药理学）","剂量选择的PK/PD或受体占有率依据","食欲素系统睡眠调节的文献综述"],"proposal_text":"T5-DORA-03是一种以双重食欲素受体（OX1R/OX2R）拮抗为作用机制的小分子口服固体制剂，用于失眠障碍的治疗。食欲素（又称下丘脑分泌素）系统参与觉醒维持，OX1R和OX2R的过度激活与觉醒维持异常及入睡困难相关；通过同时拮抗OX1R和OX2R，T5-DORA-03旨在降低觉醒驱动、促进睡眠起始并改善睡眠维持。本研究为II期剂量探索研究，内在研究目的包括机制验证（PoM）、概念验证（PoC）和剂量探索。研究采用随机、双盲、安慰剂对照、平行组设计，设5mg、15mg、30mg三个活性剂量组及安慰剂对照组，以每晚一次睡前口服给药，双盲治疗期持续4周。该设计旨在通过多剂量水平比较，在确认OX1R/OX2R拮抗机制对失眠障碍具有临床效应（PoM/PoC）的同时，初步探索剂量-反应关系，为后续III期确证性研究的剂量选择提供依据。主要疗效评价采用多导睡眠图（PSG）客观指标与患者报告结局相结合的策略，以第4周PSG持续入睡潜伏期（sLPS）自基线的变化作为主要终点，辅以失眠严重程度指数（ISI）、总睡眠时间（TST）、入睡觉醒次数（WASO）等指标，从客观睡眠结构和主观睡眠感受两个维度评估干预效果。安全性方面，鉴于食欲素通路在觉醒调节中的核心作用，本研究特别关注嗜睡、猝倒样事件、睡眠瘫痪及入睡前幻觉等与觉醒-睡眠转换相关的神经系统事件，同时监测肝功能、夜间血氧饱和度及日间嗜睡程度。研究人群限定为18至65岁、按DSM-5-TR诊断失眠障碍且病程不少于3个月、筛选期ISI评分不低于8分的成人患者，排除中重度阻塞性睡眠呼吸暂停及其他可能干扰睡眠评估的睡眠障碍，以确保疗效信号的特异性。","rationale":"本章节依据已确认的项目研究事实撰写：靶点/作用机制（OX1R/OX2R拮抗）、内在研究目的（PoM/PoC/剂量探索）、总体研究设计（随机双盲安慰剂对照平行组、三剂量）、主要及关键次要终点选择、安全性关注领域及目标人群。关于食欲素系统在觉醒维持中的生理角色描述属于一般药理学背景，允许来源仅确认了靶点名称，未提供具体非临床或文献证据；剂量选择（5/15/30mg）的理论依据（受体占有率、PK/PD建模或前期安全性数据）未在允许来源中给出，需医学经理确认是否补充非临床支持材料。","review_advisories":["本节提及高影响设计信息（主要终点、剂量选择）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_55912401eb87_a373c101af5aad85","section_number":"2.4","source_ids":["protocol_full_draft_selection:acb05d16b1b255fd9a494278","current_project_study_definition:mwdefinition_bd15506daefbfc1ca532:r9:6616f4d8e17b5f6a","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:5425c4f8e6c0a6"]},{"ai_run_id":"airun_20260928042208_0bf3bdad","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_bd15506daefbfc1ca532:revision:9","quote":"内在研究目的：机制验证（PoM）；概念验证（PoC）；剂量探索","quote_sha256":"c5ce0a4ae855b3917b72509b65cdb30f2bf5cb701d39049871b6a567e7dd2650","source_id":"current_project_study_definition:mwdefinition_bd15506daefbfc1ca532:r9:6616f4d8e17b5f6a","span_id":"es_003"},{"locator":"study_definition:mwdefinition_bd15506daefbfc1ca532:revision:9","quote":"主要终点：第4周多导睡眠图（PSG）测量的持续入睡潜伏期（sLPS）自基线的变化。","quote_sha256":"12a5ef0e4644e9af1e11cfeda6a040259cfc0f70b14c45a1dae6651a115d9395","source_id":"current_project_study_definition:mwdefinition_bd15506daefbfc1ca532:r9:6616f4d8e17b5f6a","span_id":"es_006"},{"locator":"study_definition:mwdefinition_bd15506daefbfc1ca532:revision:9","quote":"关键次要终点：第4周失眠严重程度指数（ISI）总分自基线的变化；第4周PSG总睡眠时间（TST）及入睡觉醒次数（WASO）自基线的变化；第1、2、4周患者报告入睡潜伏期（sSOL）；第4周CGI-I应答率","quote_sha256":"7667fc995f404f7282729ec28057eb8447d117ef5a91c72ce83f02ed596e61cc","source_id":"current_project_study_definition:mwdefinition_bd15506daefbfc1ca532:r9:6616f4d8e17b5f6a","span_id":"es_007"},{"locator":"study_definition:mwdefinition_bd15506daefbfc1ca532:revision:9","quote":"安全性终点：治疗期间不良事件（TEAE）及严重不良事件（SAE）发生率（安全事件集）；嗜睡、猝倒样事件、睡眠瘫痪、入睡前幻觉等神经系统特殊事件发生率；肝功能异常（ALT/AST>3×ULN）发生率；夜间血氧饱和度下降/呼吸相关不良事件发生率；跌倒及意外伤害发生率；自杀意念/行为（C-SSRS）阳性率","quote_sha256":"d9b8f6cc3556d70512377179744ca49ac81e9eb724f90fb072e86175e18c8dd9","source_id":"current_project_study_definition:mwdefinition_bd15506daefbfc1ca532:r9:6616f4d8e17b5f6a","span_id":"es_008"},{"locator":"study_definition:mwdefinition_bd15506daefbfc1ca532:revision:9","quote":"探索性终点：停药后睡眠 反弹评估（第1周随访PSG/ISI）","quote_sha256":"870ddc65e4df6010af9390e435eec960898e316ae1377a277746e028523987a8","source_id":"current_project_study_definition:mwdefinition_bd15506daefbfc1ca532:r9:6616f4d8e17b5f6a","span_id":"es_009"},{"locator":"study_definition:mwdefinition_bd15506daefbfc1ca532:revision:9","quote":"其他次要终点：第4周睡眠效率（SE）变化；每周失眠日记（TSW）变化；受试者日间嗜睡程度（ESS/KSS）","quote_sha256":"1c9a6360fb03a23e4a4f8a218ec391ab7bcd688f1266351f8888c66637fc4e57","source_id":"current_project_study_definition:mwdefinition_bd15506daefbfc1ca532:r9:6616f4d8e17b5f6a","span_id":"es_010"},{"locator":"study_definition:mwdefinition_bd15506daefbfc1ca532:revision:9","quote":"研究时期：筛选期（≤28天）→ 基线 → 双盲治疗期（4周）→ 安全性随访（停药后1周）","quote_sha256":"dc215d531ecde20ee9b9283928cfd8aa4fee786481a9f4663eeed6439815f877","source_id":"current_project_study_definition:mwdefinition_bd15506daefbfc1ca532:r9:6616f4d8e17b5f6a","span_id":"es_012"},{"locator":"study_definition:mwdefinition_bd15506daefbfc1ca532:revision:9","quote":"样本量策略：II期剂量探索：每组约30例，共120例（含安慰剂组），基于sLPS组间差异与剂量-反应信号（MCP-Mod）确定","quote_sha256":"c29d9bbf451e18729a56e1a85ee5f49043ae76480103ac1c9284ce45ad8d615a","source_id":"current_project_study_definition:mwdefinition_bd15506daefbfc1ca532:r9:6616f4d8e17b5f6a","span_id":"es_013"},{"locator":"study_definition:mwdefinition_bd15506daefbfc1ca532:revision:9","quote":"估计目标策略：主要估计目标采用治疗策略策略（treatment policy）；ISI等患者报告终点同时给出 while-on-treatment 补充估计。","quote_sha256":"14b0598a4345391523c6156aafe8e3752674bf3cbf353d3006330c73afaec25b","source_id":"current_project_study_definition:mwdefinition_bd15506daefbfc1ca532:r9:6616f4d8e17b5f6a","span_id":"es_015"}],"evidence_review_advisories":[],"evidence_span_ids":["es_003","es_006","es_007","es_008","es_009","es_010","es_012","es_013","es_015"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":9},"gap_items":[{"action":"确认CGI-I应答率的具体阈值（如评分≤2分或≤3分视为应答）及评价时点","category":"source_missing","gap_id":"gap_3_cgi_threshold","missing_source_classes":["终点定义文件","CGI-I量表使用规范"],"target":"3节关键次要终点中CGI-I应答率定义"},{"action":"明确停药后睡眠反弹的评估方法（PSG参数选择、ISI变化阈值）及判定标准","category":"source_missing","gap_id":"gap_3_rebound_criteria","missing_source_classes":["探索性终点操作定义","PSG反弹判定标准"],"target":"3节探索性终点中睡眠反弹评估方法"},{"action":"将各终点（sSOL第1/2/4周、ESS/KSS晨间评价等）与具体访视日及时间窗进行映射确认","category":"mapping_failed","gap_id":"gap_3_visit_mapping","missing_source_classes":["访视计划表","终点-访视映射矩阵"],"target":"3节各终点评价时点与访视计划的对应关系"}],"heading":"研究目的和终点","missing_source_classes":["CGI-I应答率阈值定义","探索性终点判定标准","各终点具体访视时点映射"],"proposal_text":"本研究为T5-DORA-03治疗失眠障碍的II期临床研究，总体研究目的为机制验证（PoM）、概念验证（PoC）和剂量探索，旨在确认双重食欲素受体（OX1R/OX2R）拮抗对失眠障碍的疗效信号并初步建立剂量-反应关系。主要疗效终点为第4周多导睡眠图（PSG）测量的持续入睡潜伏期（sLPS）自基线的变化，评价时间点为基线和第4周（双盲治疗结束）。关键次要终点包括：第4周失眠严重程度指数（ISI）总分自基线的变化；第4周PSG总睡眠时间（TST）及入睡觉醒次数（WASO）自基线的变化；第1、2、4周患者报告入睡潜伏期（sSOL）；第4周临床总体印象-改善量表（CGI-I）应答率。其他次要终点包括：第4周睡眠效率（SE）变化；每周失眠日记（TSW）变化；受试者日间嗜睡程度（ESS/KSS）。探索性终点为停药后睡眠反弹评估，于第1周随访期通过PSG和ISI进行评价。安全性终点包括：治疗期间不良事件（TEAE）及严重不良事件（SAE）发生率（基于安全事件集）；嗜睡、猝倒样事件、睡眠瘫痪、入睡前幻觉等神经系统特殊事件发生率；肝功能异常（ALT/AST>3×ULN）发生率；夜间血氧饱和度下降及呼吸相关不良事件发生率；跌倒及意外伤害发生率；自杀意念/行为（C-SSRS）阳性率。特别关注的不良事件包括：嗜睡及猝倒样事件；睡眠瘫痪；入睡前幻觉；ALT或AST>3×ULN（伴或不伴症状）；夜间严重低氧（SpO2降幅≥4%且持续≥10秒的频次显著增加）；与药物相关的自杀意念/行为（C-SSRS）。主要估计目标采用治疗策略策略（treatment policy），ISI等患者报告终点同时给出while-on-treatment补充估计。主要分析集为全分析集（FAS，遵循ITT原则），安全性评价采用安全集（SS）。","rationale":"本章节依据已确认的项目研究事实撰写：研究目的（PoM/PoC/剂量探索）、主要终点（第4周PSG-sLPS变化）、关键次要终点（ISI、TST、WASO、sSOL、CGI-I）、其他次要终点（SE、TSW、ESS/KSS）、探索性终点（停药后睡眠反弹）、安全性终点及特别关注不良事件、估计目标策略和分析集定义。CGI-I应答率的具体阈值（如≤2分或≤3分）未在允许来源中明确；探索性终点'睡眠反弹'的具体判定标准未详述；各终点的具体评价时点安排（如sSOL在第1、2、4周的具体访视日）需与访视计划核对。","review_advisories":["本节复述高影响研究设计（研究目的和终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（估计目标）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_55912401eb87_39601ae8f0297617","section_number":"3","source_ids":["protocol_full_draft_selection:acb05d16b1b255fd9a494278","current_project_study_definition:mwdefinition_bd15506daefbfc1ca532:r9:6616f4d8e17b5f6a","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","company_corpus:cms_cn_protocol_corpus_20260715_v1:5425c4f8e6c0a6"]}],"source_bindings":[{"content_sha256