","quote_sha256":"2bb8e91186761e7551aa4e2e18f1aee98b7802de3ed30be648d225fa25c81099","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es9"}],"evidence_review_advisories":[],"evidence_span_ids":["es1","es2","es9"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"由医学经理确认依从性评价采用药片计数、电子监测或受试者日记中的何种方式，以及依从性合格阈值","category":"source_missing","gap_id":"gap_6_5_01","missing_source_classes":["依从性评价方法学文件","依从性合格阈值定义"],"target":"依从性评价具体方法与合格阈值"},{"action":"核对访视操作手册或访视计划表，确认延长期各访视是否纳入依从性评价","category":"source_not_retrieved","gap_id":"gap_6_5_02","missing_source_classes":["访视操作手册","访视计划表"],"target":"开放延长期访视（第30、38、44、52周）是否包含依从性评价"}],"heading":"研究治疗依从性","missing_source_classes":["依从性评价方法学文件","依从性合格阈值定义","开放延长期访视操作细则"],"proposal_text":"本研究采用每日一次口服给药方案，受试者于每日晨起空腹或餐后2小时整片吞服R3A-BD301缓释片或匹配安慰剂片，双盲治疗期共26周（182±3天），开放延长期再26周。双盲期访视窗口为±3天。依从性评价纳入第4、8、12、18、26周治疗访视内容，与IPSS评估、生命体征测量及不良事件采集同步进行。第12周和第26周治疗访视另增加尿流率与残余尿量测定。开放延长期访视安排于第30、38、44、52周。研究期间受试者应严格按照方案规定的给药时间和方式服药，不得自行增减剂量或中断给药。","rationale":"给药方案、服药时间窗、访视窗口及依从性评价纳入治疗访视内容均来源于本项目已确认研究事实。依从性具体评价方法（药片计数、电子监测或日记）及合格阈值未在任何允许来源中给出，需医学经理确认后方可写入。开放延长期访视是否包含依从性评价来源未明确，暂不写入。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_7aafcba68d3a_e1c073915f848b4a","section_number":"6.5","source_ids":["protocol_full_draft_selection:b74b08958664706f6a268e0e","current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","company_corpus:cms_cn_protocol_corpus_20260715_v1:06652cfb5d7add","company_corpus:cms_cn_protocol_corpus_20260715_v1:a58b77f78a8621","company_corpus:cms_cn_protocol_corpus_20260715_v1:176c87031ef7e6","company_corpus:cms_cn_protocol_corpus_20260715_v1:79890fa298bcdd"]},{"ai_run_id":"airun_20261005182755_b825df6f","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"两组均按需允许基础伴随治疗稳定（不含其他LUTS药物）。","quote_sha256":"4d939db7977ec4135c2f291c6ae6404b316b57a67051758b6428ccbee3389b3e","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es3"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"同意研究期间不使用其他治疗BPH/LUTS的药物（含植物制剂）","quote_sha256":"3ad38005cd37ceb46b3f8cda644b462279b567a6846b20873384f87296e51891","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es4"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"补救治疗（开始其他LUTS药物）记录为伴发事件并保留在主要分析（mITT）；停药者按治疗策略保留。","quote_sha256":"eefa93cf19864c580a49be61ccfb15f8cf9686c382489e3a9c2269e9855a9d3a","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es5"},{"locator":"section:既往/合并治疗和洗脱期|block:636|chunk:1","quote":"在随机前，用于其他疾病的合并用药及治疗，如非 3.6.5.3 规定的禁止的合并用药 或治疗，且研究者认为剂量稳定，可以在研究期间继续使用。研究者可根据受试者疾 病情况决定是否停用或加用/换用治疗药物。如加用/换用治疗药物，需注意记录既往病 史变化情况，是否需要记录 AE。","quote_sha256":"59f7e091aaa0fc7fbe0776c27b50433be0c3a716c7cd2d1dab87d5c3ce126cf4","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","span_id":"es7"}],"evidence_review_advisories":[],"evidence_span_ids":["es3","es4","es5","es7"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":3},"gap_items":[{"action":"由医学经理依据R3A-BD301药理特性及β3受体激动剂类药物已知相互作用，确定禁止合并用药清单","category":"source_missing","gap_id":"gap_6_6_01","missing_source_classes":["研究者手册","药物相互作用数据","既往同类药物安全性数据"],"target":"禁止合并用药具体药物清单"},{"action":"核对CRF设计文档或数据管理计划中合并用药与AE关联记录规则","category":"source_not_retrieved","gap_id":"gap_6_6_02","missing_source_classes":["CRF设计文档","数据管理计划"],"target":"合并用药记录格式及是否需要记录AE的判定规则"}],"heading":"合并用药/治疗","missing_source_classes":["禁止合并用药具体清单","合并用药记录与AE判定操作细则","开放延长期合并用药管理规则"],"proposal_text":"本研究允许受试者在研究期间继续使用剂量稳定的基础伴随治疗，但不得同时使用其他治疗良性前列腺增生或下尿路症状的药物（含植物制剂）。随机化前，用于其他疾病的合并用药及治疗，若研究者判断剂量稳定且不属于本方案规定的禁止合并用药或治疗，可在研究期间继续使用。研究者可根据受试者疾病情况决定是否停用或加用、换用治疗药物；如加用或换用治疗药物，应记录既往病史变化情况并评估是否需要记录不良事件。若受试者因病情需要开始使用其他LUTS治疗药物作为补救治疗，该事件记录为伴发事件，受试者仍保留在主要分析集（mITT）中。","rationale":"合并用药总体原则（允许稳定基础伴随治疗、禁止其他LUTS药物）、补救治疗处理规则来源于本项目已确认研究事实。公司语料中'剂量稳定可继续使用'及'加用换用需记录'为通用章节结构措辞，仅用于组织本段表述，不构成本项目独立事实。禁止合并用药具体清单、合并用药记录格式及AE判定规则需另行确认。","review_advisories":["本节提及高影响设计信息（伴发事件）；系统未把重复提及升级为强制确认。","本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_7aafcba68d3a_a2b2628207e6f87e","section_number":"6.6","source_ids":["protocol_full_draft_selection:b74b08958664706f6a268e0e","current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","company_corpus:cms_cn_protocol_corpus_20260715_v1:06652cfb5d7add","company_corpus:cms_cn_protocol_corpus_20260715_v1:a58b77f78a8621","company_corpus:cms_cn_protocol_corpus_20260715_v1:176c87031ef7e6","company_corpus:cms_cn_protocol_corpus_20260715_v1:79890fa298bcdd"]},{"ai_run_id":"airun_20261005182755_b825df6f","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"两组均按需允许基础伴随治疗稳定（不含其他LUTS药物）。","quote_sha256":"4d939db7977ec4135c2f291c6ae6404b316b57a67051758b6428ccbee3389b3e","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es3"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"同意研究期间不使用其他治疗BPH/LUTS的药物（含植物制剂）","quote_sha256":"3ad38005cd37ceb46b3f8cda644b462279b567a6846b20873384f87296e51891","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es4"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"α1阻滞剂/5α还原酶抑制剂/PDE5抑制剂/抗胆碱能药（治疗LUTS用途）：随机前洗脱≥2周（5α还原酶抑制剂≥6个月）；抗高血压药物保持稳定≥4周不做硬性洗脱","quote_sha256":"5ad73dcb23291b7fc168f1d8f704e0366284c48ad54314dfb7b962797266f962","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es6"}],"evidence_review_advisories":[],"evidence_span_ids":["es3","es4","es6"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"由医学经理确认除抗高血压药物外，其他允许继续使用的合并用药类别（如降糖药、调脂药等）及是否需要限定具体药物","category":"source_missing","gap_id":"gap_6_6_1_01","missing_source_classes":["研究者手册","药物相互作用数据"],"target":"允许合并用药的完整药物类别清单"}],"heading":"允许的合并用药/治疗","missing_source_classes":["允许合并用药完整清单","非泌尿系统疾病合并用药具体类别界定"],"proposal_text":"随机化前已使用且剂量稳定的抗高血压药物，在研究期间可继续使用，无需洗脱，但须保持稳定剂量至少4周。用于其他非泌尿系统疾病的合并用药及治疗，若研究者判断剂量稳定且不属于本方案规定的禁止合并用药或治疗，可在研究期间继续使用。受试者入组时须同意研究期间不使用其他治疗BPH或LUTS的药物（含植物制剂）。","rationale":"抗高血压药物稳定≥4周不做硬性洗脱、允许稳定基础伴随治疗、入组时同意不使用其他LUTS药物均来源于本项目已确认研究事实。抗高血压药物类别列举为基于排除标准中血压控制条件的合理展开，具体允许药物类别清单需医学经理确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_7aafcba68d3a_601391f673d609c2","section_number":"6.6.1","source_ids":["protocol_full_draft_selection:b74b08958664706f6a268e0e","current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","company_corpus:cms_cn_protocol_corpus_20260715_v1:06652cfb5d7add","company_corpus:cms_cn_protocol_corpus_20260715_v1:a58b77f78a8621","company_corpus:cms_cn_protocol_corpus_20260715_v1:176c87031ef7e6","company_corpus:cms_cn_protocol_corpus_20260715_v1:79890fa298bcdd"]},{"ai_run_id":"airun_20261005182755_b825df6f","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"由医学经理依据R3A-BD301药理特性、β3受体激动剂类药物已知相互作用及研究者手册，确定禁止合并用药清单","category":"source_missing","gap_id":"gap_6_6_2_01","missing_source_classes":["研究者手册","药物相互作用数据","β3受体激动剂类药物安全性文献"],"target":"禁止合并用药完整清单（含非LUTS用途药物）"},{"action":"由医学经理确认受试者误用禁止合并用药后的处理流程","category":"source_missing","gap_id":"gap_6_6_2_02","missing_source_classes":["安全性管理操作细则","方案安全性章节"],"target":"使用禁止合并用药后的处理规则（是否中断治疗、是否退出研究、是否继续随访）"}],"heading":"禁止的合并用药/治疗","missing_source_classes":["禁止合并用药具体清单","R3A-BD301药物相互作用数据","β3受体激动剂类药物已知禁忌合并用药","研究者手册中合并用药章节"],"proposal_text":"","rationale":"本项目已确认事实中明确禁止研究期间使用其他治疗BPH/LUTS的药物（含植物制剂），并规定了α1阻滞剂、5α还原酶抑制剂、PDE5抑制剂及抗胆碱能药（治疗LUTS用途）的洗脱要求（≥2周，5α还原酶抑制剂≥6个月）。但禁止合并用药的完整清单（包括非LUTS用途但可能与β3受体激动剂产生药理学相互作用的药物）未在任何允许来源中给出。公司语料中提及的禁止用药清单来自其他适应症方案，不可迁移为本项目事实。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_7aafcba68d3a_49564874e4c4efde","section_number":"6.6.2","source_ids":["protocol_full_draft_selection:b74b08958664706f6a268e0e","current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","company_corpus:cms_cn_protocol_corpus_20260715_v1:06652cfb5d7add","company_corpus:cms_cn_protocol_corpus_20260715_v1:a58b77f78a8621","company_corpus:cms_cn_protocol_corpus_20260715_v1:176c87031ef7e6","company_corpus:cms_cn_protocol_corpus_20260715_v1:79890fa298bcdd"]}],"source_bindings":[{"content_sha256":"4ef95465d9c658885c4d1d360ac225669907d7de43be27e87b086e21d1de45ef","locator":"document:mwdoc_greenfield_proj_user_7aafcba68d3a_0edb7a13b36bcc44:full-draft:b74b08958664706f6a268e0e","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:b74b08958664706f6a268e0e","source_type":"protocol_full_draft_selection","source_version":"full-draft:d819bd480dc54a243e91766c1293abc4093589095d35f7bcabdd628318b48e29:b74b08958664706f6a268e0e","text_sha256":"4ef95465d9c658885c4d1d360ac225669907d7de43be27e87b086e21d1de45ef"},{"content_sha256":"b6c04f6db6fde35e37a038ac3c3d1a8463187ca2ae1f46005bfb397145bcfef8","locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revisio