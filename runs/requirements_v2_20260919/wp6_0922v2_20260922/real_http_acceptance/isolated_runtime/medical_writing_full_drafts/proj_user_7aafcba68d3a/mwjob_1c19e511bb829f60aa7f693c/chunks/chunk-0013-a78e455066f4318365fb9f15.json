,"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_7aafcba68d3a_d0232e05d822e302","section_number":"8.6","source_ids":["protocol_full_draft_selection:a78e455066f4318365fb9f15","current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:152c1e08c78e76","company_corpus:cms_cn_protocol_corpus_20260715_v1:30fd7cd8503aae","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976"]},{"ai_run_id":"airun_20261005185126_0aa96ca2","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取或起草本项目AE随访程序，包括随访触发条件、随访频率、终止标准、记录方式及责任主体","category":"source_missing","gap_id":"gap_87_ae_followup","missing_source_classes":["项目级AE随访程序文件","AE随访终止条件与随访频率定义"],"target":"8.7 不良事件的随访"}],"heading":"不良事件的随访","missing_source_classes":["项目级AE随访程序文件","AE随访终止条件与随访频率定义","随访记录载体及责任主体定义"],"proposal_text":"","rationale":"本章节需要项目级文件明确AE随访的触发条件、随访频率、随访终止标准、随访记录载体及责任主体。当前允许来源中，项目研究定义仅提及安全性随访期（末次给药后2周含AE采集）和访视中AE记录，未定义AE随访程序；公司语料中'应在参与者病历和eCRF不良事件上记录不良事件的结局（包括日期）'为通用记录要求，不构成本项目随访程序的项目级依据。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_7aafcba68d3a_95628db066581cb3","section_number":"8.7","source_ids":["protocol_full_draft_selection:a78e455066f4318365fb9f15","current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:152c1e08c78e76","company_corpus:cms_cn_protocol_corpus_20260715_v1:30fd7cd8503aae","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976"]},{"ai_run_id":"airun_20261005185126_0aa96ca2","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"特别关注的不良事件：血压升高与高血压相关严重事件；心率增快及心律失常事件；尿潴留（需导尿处理）；严重心血管事件（MACE，CEC裁定）","quote_sha256":"21fd6de994da28afc4c53de1e1031ef44ad76664647cac5a7a17b8450ec0e12a","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_01"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"MACE由独立CEC裁定","quote_sha256":"d37f529f9dc3da7c0401182f45140d651470b782065c9f57a9df82bf1799e42e","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_02"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"安全性随访（末次给药后2周：生命体征、AE、实验室）","quote_sha256":"7fc33c7a9c3e0239383b8e78f7846f196b3d651e9e5548e9bdb97976d7e91e45","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_03"}],"evidence_review_advisories":[],"evidence_span_ids":["es_01","es_02","es_03"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"确认各特别关注事件的监测频率、报告触发阈值及DSMB审阅中的报告路径","category":"source_missing","gap_id":"gap_88_esae_monitoring","missing_source_classes":["特别关注不良事件监测频率与触发阈值定义","DSMB审阅中特别关注事件报告路径"],"target":"8.8 特别关注的不良事件"},{"action":"获取CEC裁定操作细则，包括MACE裁定启动标准、裁定流程及结果反馈机制","category":"source_missing","gap_id":"gap_88_cec_procedure","missing_source_classes":["CEC裁定操作细则与启动标准"],"target":"8.8 特别关注的不良事件"}],"heading":"特别关注的不良事件","missing_source_classes":["特别关注不良事件的监测频率与触发阈值定义","CEC裁定操作细则与启动标准","DSMB盲态安全审阅中特别关注事件报告路径","尿潴留需导尿处理的判定标准"],"proposal_text":"本研究将以下事件列为特别关注的不良事件：血压升高与高血压相关严重事件；心率增快及心律失常事件；尿潴留（需导尿处理）；严重心血管事件（MACE）。上述事件与R3A-BD301作为β3肾上腺素受体高选择性激动剂的药理特性相关：该药对β1/β2受体亲和力低以减少心血管影响，但血压升高、心率增快及心律失常仍为需重点监测的潜在类别效应；尿潴留与逼尿肌舒张后残余尿量变化相关；MACE为β3受体激动剂类药物的已知类别关注事件。MACE的因果关系判定由独立心血管事件裁定委员会（CEC）完成。安全性随访期为末次给药后2周，该期间内继续采集生命体征、不良事件及实验室检查数据。DSMB每4个月进行一次盲态安全审阅。","rationale":"特别关注不良事件清单（血压升高与高血压相关严重事件、心率增快及心律失常事件、尿潴留需导尿处理、MACE由CEC裁定）来源于本项目已确认研究定义；β3-AR对β1/β2亲和力低以减少心血管影响的机制描述来源于同一来源；安全性随访期（末次给药后2周含AE）及DSMB每4个月盲态安全审阅来源于同一来源。待医学经理确认：各特别关注事件的监测频率与触发阈值、CEC裁定的具体启动标准与流程、DSMB审阅中特别关注事件的报告路径、尿潴留需导尿处理的判定标准、MACE的CEC裁定操作细则。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_7aafcba68d3a_881d7c216d179668","section_number":"8.8","source_ids":["protocol_full_draft_selection:a78e455066f4318365fb9f15","current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:152c1e08c78e76","company_corpus:cms_cn_protocol_corpus_20260715_v1:30fd7cd8503aae","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976"]},{"ai_run_id":"airun_20261005185126_0aa96ca2","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:6.3.4 妊娠|block:1004|chunk:1","quote":"妊娠本身并不被视为一个 AE","quote_sha256":"25fab72f3c06aa5e293905f403eeacd1c9a8ba9d02051db568c15cd399e9c674","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:152c1e08c78e76","span_id":"es_05"},{"locator":"section:6.3.4 妊娠|block:1004|chunk:1","quote":"研究者应在获知妊娠事件的 24 小时内，填写《妊娠事件报告表》，并签字签署日期，以妊娠报告的形式向申办者和其指定联系人、EC（如适用）报告。","quote_sha256":"abeb265e70e856268dfae2c620df562facef1c8dad8742a0a39f89c9d2e5bcb7","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:152c1e08c78e76","span_id":"es_06"},{"locator":"section:妊娠、哺乳与避孕|block:1005|chunk:1","quote":"继续对受试者进行监测，直到妊娠结束/新生儿出生后三个月。","quote_sha256":"b969faceab6e1c97fe0d852d9412058d2abec15cd1242f2794807530467c5356","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:30fd7cd8503aae","span_id":"es_07"},{"locator":"section:妊娠、哺乳与避孕|block:1005|chunk:1","quote":"所有的先天畸形/出生缺陷为 SAE。自然流产也应视为 SAE，并根据 SAE 报告流 程予以报告。","quote_sha256":"b19170e566c03201408094e2109982b2dbe03e61355e6fa5c2f771dbc336c584","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:30fd7cd8503aae","span_id":"es_08"},{"locator":"section:妊娠、哺乳与避孕|block:779|chunk:1","quote":"确定妊娠后（妊娠试验呈阳性），女性试验参与者应该退出研究。","quote_sha256":"70b8ccad02d308bc8669d4f2c2003dc3f187d52914d5748c309cd676ad5c4f14","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83","span_id":"es_09"},{"locator":"section:妊娠事件的报告要求|block:839|chunk:1","quote":"妊娠既不是AE也不是SAE，不应记录在eCRF的不良事件上，除非怀疑研究药物可能干扰了避孕药物或避孕方法的有效性，以及除非发生妊娠相关并发症","quote_sha256":"bb9bbf66f3591978bef14815e89e871d0dc17e5bb103a81671e22b7b50c50fc1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976","span_id":"es_10"}],"evidence_review_advisories":[],"evidence_span_ids":["es_05","es_06","es_07","es_08","es_09","es_10"],"evidence_summary":{"corpus_spans":6,"project_fact_spans":0},"gap_items":[{"action":"确认本项目男性受试者伴侣妊娠的报告路径、报告时限、是否需通知伦理委员会及数据收集授权方式","category":"source_missing","gap_id":"gap_89_preg_report_path","missing_source_classes":["本项目妊娠事件报告与随访的项目级文件","男性受试者伴侣妊娠报告路径与时限"],"target":"8.9 妊娠事件的报告与随访"},{"action":"确认伴侣妊娠随访终止时点及新生儿结局收集方式","category":"source_missing","gap_id":"gap_89_preg_followup","missing_source_classes":["伴侣妊娠随访终止时点","新生儿结局收集方式"],"target":"8.9 妊娠事件的报告与随访"},{"action":"确认本项目是否要求男性受试者使用避孕措施及伴侣妊娠报告义务","category":"source_missing","gap_id":"gap_89_contraception","missing_source_classes":["男性受试者避孕要求及伴侣妊娠报告义务"],"target":"8.9 妊娠事件的报告与随访"}],"heading":"妊娠事件的报告与随访","missing_source_classes":["本项目妊娠事件报告与随访的项目级文件","男性受试者伴侣妊娠报告路径与时限","伴侣妊娠随访终止时点","男性受试者避孕要求及伴侣妊娠报告义务"],"proposal_text":"本研究为50岁及以上男性良性前列腺增生患者的III期临床研究，妊娠事件仅可能通过男性受试者异性伴侣妊娠途径发生。妊娠本身不视为不良事件，不应记录在不良事件记录中，除非怀疑研究药物可能干扰了避孕药物或避孕方法的有效性，或发生妊娠相关并发症（如自然流产、因医学及健康原因导致的人工流产、死胎、新生儿严重不良事件）。妊娠相关并发症中，先天畸形或出生缺陷、自然流产应视为严重不良事件并按严重不良事件报告流程予以报告；无任何并发症的选择性人工流产不视为不良事件。研究者获知伴侣妊娠事件后，应填写妊娠事件报告表，以妊娠报告形式向申办者及其指定联系人报告，并记录报告日期。妊娠结局（妊娠结束或终止，包括自发流产、人工流产、正常分娩或先天畸形）应进行随访，随访信息记录于妊娠报告表中并报告给申办者及其指定联系人。","rationale":"妊娠不视为AE、妊娠相关并发症（先天畸形/出生缺陷、自然流产）视为SAE、无并发症人工流产不视为AE、妊娠报告表填写及向申办者报告、妊娠结局随访等原则来源于公司语料中其他项目方案（MG-K10青少年AD-3期方案、CMS-D017 I期方案），作为监管共性结构参照。本项目为纯男性BPH研究，妊娠事件仅涉及伴侣妊娠途径。待医学经理确认：伴侣妊娠的报告时限（公司语料中24小时时限来自其他项目，是否适用于本项目）、伴侣妊娠随访终止时点（公司语料中'分娩后三个月'来自其他项目）、伴侣妊娠是否需通知伦理委员会、男性受试者伴侣妊娠的知情同意与数据收集授权方式、本项目是否要求男性受试者使用避孕措施及伴侣妊娠报告义务。","review_advisories":["本节复述高影响研究设计（妊娠事件的报告与随访）；请在合并设计摘要中统一核对。","本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_7aafcba68d3a_c34dc57df6559391","section_number":"8.9","source_ids":["protocol_full_draft_selection:a78e455066f4318365fb9f15","current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:152c1e08c78e76","company_corpus:cms_cn_protocol_corpus_20260715_v1:30fd7cd8503aae","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976"]}],"source_bindings":[{"content_sha256":"e36ac8c5ec74ef762ce83b3df0ad545c6245406f80a547021f78bda4aba18293","locator":"document:mwdoc_greenfield_proj_user_7aafcba68d3a_0edb7a13b36bcc44:full-draft:a78e455066f4318365fb9f15","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:a78e455066f4318365fb9f15","source_type":"protocol_full_draft_selection","source_version":"full-draft:d819bd480dc54a243e91766c1293abc4093589095d35f7bcabdd628318b48e29:a78e455066f4318365fb9f15","text_sha256":"e36ac8c5ec74ef762ce83b3df0ad545c6245406f80a547021f78bda4aba18293"},{"content_sha256":"b6c04f6db6fde35e37a038ac3c3d1a8463187ca2ae1f46005bfb397145bcfef8","locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","source_