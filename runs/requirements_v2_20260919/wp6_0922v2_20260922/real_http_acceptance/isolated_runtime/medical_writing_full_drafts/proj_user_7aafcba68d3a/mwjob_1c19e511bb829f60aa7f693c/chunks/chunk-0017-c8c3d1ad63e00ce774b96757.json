ect_fact_spans":1},"gap_items":[{"action":"由医学经理与数据管理部门确认本项目数据保护实施规范后补入","category":"source_missing","gap_id":"gap_11_4_01","missing_source_classes":["项目数据保护与隐私合规操作规范"],"target":"受试者个人可识别信息保护的具体操作规范（数据分级、访问权限、脱敏规则）"},{"action":"由医学经理与信息技术/合规部门确认EDC安全方案后补入","category":"source_missing","gap_id":"gap_11_4_02","missing_source_classes":["电子数据采集系统安全与访问控制方案"],"target":"电子数据采集系统（EDC）安全要求与数据跨境传输限制"},{"action":"由医学经理与DMC筹备组确认DMC章程后补入","category":"source_missing","gap_id":"gap_11_4_03","missing_source_classes":["DMC章程及保密协议模板"],"target":"DMC章程中保密条款、独立统计师数据访问范围及紧急揭盲保密程序"}],"heading":"保密与隐私","missing_source_classes":["项目数据保护与隐私合规操作规范","电子数据采集系统安全与访问控制方案","DMC章程及保密协议模板"],"proposal_text":"本方案及其附件中包含的所有信息归申办方所有，仅供研究者、合作研究者、伦理委员会和药品监督管理部门等相关机构为实施和监管本研究之目的进行审阅。在未获得申办方书面批准的情况下，除在与可能参加本研究的受试者签署知情同意书时向其做必要解释外，严禁将任何方案信息告知与本研究无关的第三方。研究过程中产生的受试者个人可识别信息、原始医疗记录及电子数据采集系统中的数据，应依据中国现行个人信息保护法律法规及药物临床试验质量管理规范的要求予以保护，限制在研究必要范围内访问。数据监查委员会在盲态安全审阅中接触的数据应遵循最小必要原则，其成员及独立统计师须签署保密协议。研究者应确保研究中心内研究文件的物理与电子存储安全，防止未经授权的查阅、复制或泄露。","rationale":"保密声明结构参照公司语料中通用方案保密条款（342cfc57d67b67），属监管共性措辞；DMC盲态审阅为项目已确认设计事实（DMC计划：是，每4个月盲态安全审阅）。本项目数据保护具体操作规范（如电子系统安全等级、数据跨境传输限制、隐私影响评估）尚无项目来源支持，需医学经理补充确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_7aafcba68d3a_f41d88c46e6e3b35","section_number":"11.4","source_ids":["protocol_full_draft_selection:c8c3d1ad63e00ce774b96757","current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","company_corpus:cms_cn_protocol_corpus_20260715_v1:d84680fc442c0c","company_corpus:cms_cn_protocol_corpus_20260715_v1:ea3e32851b5d74","company_corpus:cms_cn_protocol_corpus_20260715_v1:69be796f1e42c8","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67"]},{"ai_run_id":"airun_20261005190540_7f995c84","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"由医学经理向申办方法务/保险部门获取本项目保险方案及赔偿条款后补入","category":"source_missing","gap_id":"gap_11_5_01","missing_source_classes":["项目保险方案及保单摘要","受试者损害赔偿条款与理赔程序","申办方与研究中心保险责任划分协议"],"target":"保险与赔偿章节全部实质内容（险种、保额、承保范围、理赔程序、赔偿标准、保险联系人）"}],"heading":"保险与赔偿","missing_source_classes":["项目保险方案及保单摘要","受试者损害赔偿条款与理赔程序","申办方与研究中心保险责任划分协议"],"proposal_text":"","rationale":"保险与赔偿章节需要本项目保险方案（险种、保额、承保范围、理赔程序、保险联系人）及受试者损害赔偿条款等项目文件。当前允许来源中无任何项目保险或赔偿信息，公司语料亦未提供可迁移的保险条款。按规则，缺少对应项目文件时必须标记source_gap，不得以通用原则或条件句替代。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_7aafcba68d3a_5a68ad825e899305","section_number":"11.5","source_ids":["protocol_full_draft_selection:c8c3d1ad63e00ce774b96757","current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","company_corpus:cms_cn_protocol_corpus_20260715_v1:d84680fc442c0c","company_corpus:cms_cn_protocol_corpus_20260715_v1:ea3e32851b5d74","company_corpus:cms_cn_protocol_corpus_20260715_v1:69be796f1e42c8","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67"]},{"ai_run_id":"airun_20261005190540_7f995c84","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:9.1 研究监查|block:1175|chunk:1","quote":"申办者有道德上、法律上和科学上的义务，确保研究按照已确立的研究准则、GCP 指导原则、适用的管理要求和法规进行。作为履行这些义务的协调措施，在研究中，申办者的监查员或其代表需经常电话和书面与研究中心沟通，并定期拜访研究中心进行现场监查，评价其是否遵守监管要求，确保受试者的安全、福利以及隐私受到 保护、方案依从性、CRF 录入的完整性和准确性、CRF 数据和原始文件的验证及 AE 的发生等。研究者必须向监查员提供访问所有原始资料和研究文件的权限。","quote_sha256":"308a36177f06e789510202b2b938b2a9e5084c7e222d80919f28732387e33a3e","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","span_id":"es_002"},{"locator":"section:11.4 研究数据记录|block:1218|chunk:1","quote":"记录必须按照当前的 GCP 指导原则保留。所有必要的研究文件包括受试者的记 录、原始文件、CRF 和研究药物库存清单必须记录在案。","quote_sha256":"f7aafa4178dd21690460dacca369e7f10ae2fcf13e0a791098b68b6758b2984d","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:d84680fc442c0c","span_id":"es_003"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"DMC是否计划：是","quote_sha256":"9967a9a75297ced2326ab733fa3b16934acdef641fa765dd50c1cd58219f4aa5","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_006"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003","es_006"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":1},"gap_items":[{"action":"由医学经理与临床运营部门确认项目监查计划后补入","category":"source_missing","gap_id":"gap_12_01","missing_source_classes":["项目监查计划（频率、范围、报告格式）"],"target":"监查频率、监查报告格式、监查员资质要求及监查计划"},{"action":"由医学经理与质量保证部门确认稽查计划后补入","category":"source_missing","gap_id":"gap_12_02","missing_source_classes":["稽查计划与独立稽查安排"],"target":"独立稽查安排、稽查频率及稽查报告处理流程"},{"action":"由医学经理与档案管理部门确认文件保存政策后补入","category":"source_missing","gap_id":"gap_12_03","missing_source_classes":["研究文件保存期限与销毁程序"],"target":"研究文件保存具体年限、电子数据备份策略及到期销毁程序"},{"action":"由医学经理与DMC筹备组确认DMC章程后补入","category":"source_missing","gap_id":"gap_12_04","missing_source_classes":["DMC章程及审阅操作细则"],"target":"DMC章程、审阅操作细则、紧急揭盲程序及与监查体系的衔接"}],"heading":"研究文件、监查和管理","missing_source_classes":["项目监查计划（频率、范围、报告格式）","稽查计划与独立稽查安排","研究文件保存期限与销毁程序","DMC章程及审阅操作细则"],"proposal_text":"申办方有道德上、法律上和科学上的义务，确保本研究按照药物临床试验质量管理规范、已确立的研究准则及适用的管理要求和法规进行。为履行上述义务，申办方指派监查员或其代表定期与研究中心沟通并开展现场监查，评价研究中心对监管要求的遵守情况、受试者安全与隐私保护、方案依从性、病例报告表录入的完整性与准确性、病例报告表数据与原始文件的核对以及不良事件的发生与报告。研究者须向监查员提供访问所有原始资料和研究文件的权限。所有研究记录须按照现行药物临床试验质量管理规范的要求予以保留，包括受试者医疗记录、原始文件、病例报告表和研究药物库存清单。本研究设置数据监查委员会，每4个月进行一次盲态安全性审阅，审阅内容涵盖不良事件、严重不良事件、特别关注的不良事件（血压升高与高血压相关严重事件、心率增快及心律失常事件、尿潴留、主要心血管不良事件）及整体安全性趋势。","rationale":"监查与数据记录保留结构参照公司语料中通用监查条款（d4bef81ce83416）和数据记录条款（d84680fc442c0c），属监管共性结构。DMC每4个月盲态安全审阅及特别关注不良事件类别为项目已确认设计事实。本项目监查频率、监查报告格式、稽查安排、文件保存具体年限及销毁程序等实施细节尚无来源支持。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_7aafcba68d3a_ea9c7763cca82552","section_number":"12","source_ids":["protocol_full_draft_selection:c8c3d1ad63e00ce774b96757","current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","company_corpus:cms_cn_protocol_corpus_20260715_v1:d84680fc442c0c","company_corpus:cms_cn_protocol_corpus_20260715_v1:ea3e32851b5d74","company_corpus:cms_cn_protocol_corpus_20260715_v1:69be796f1e42c8","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67"]},{"ai_run_id":"airun_20261005190540_7f995c84","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:质量控制|block:896|chunk:1","quote":"临床研究开始前，必须通过启动会或研究者会议对所有参加研究的人员进行研究方案的培训，使每个参研人员都对临床研究方案及其各指标具体内涵有充分理解和认识、掌握GCP原则、统一记录方式与判断标准、严格按照方案执行。培训必须在该临床试验机构入选试验参与者之前进行。","quote_sha256":"d390ad9e56aa00a48a8506e0ab4636d8fdf7c2214b0b331f9094e23dec03bb55","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:69be796f1e42c8","span_id":"es_004"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":0},"gap_items":[{"action":"由医学经理与质量保证部门确认方案偏离管理流程后补入","category":"source_missing","gap_id":"gap_12_1_01","missing_source_classes":["项目方案偏离处理流程与报告模板"],"target":"方案偏离分类标准、报告时限、审查流程及处理措施"},{"action":"由医学经理与法规事务部门确认方案修正管理流程后补入","category":"source_missing","gap_id":"gap_12_1_02","missing_source_classes":["方案修正审批路径与实施时间要求"],"target":"方案修正的审批层级、伦理递交要求、实施生效条件及重新培训要求"},{"action":"由医学经理与临床运营部门确认依从性管理方案后补入","category":"source_missing","gap_id":"gap_12_1_03","missing_source_classes":["依从性监测指标与违规后果条款"],"target":"依从性监测具体指标（如药物计数、日记卡回收率）及严重违规后果"}],"heading":"研究方案的依从","missing_source_classes":["项目方案偏离处理流程与报告模板","方案修正审批路径与实施时间要求","依从性监测指标与违规后果条款"],"proposal_text":"临床研究开始前，必须通过启动会或研究者会议对所有参加研究的人员进行研究方案的培训，使每位参研人员对研究方案及其各指标具体内涵有充分理解和认识，掌握药物临床试验质量管理规范原则，统一记录方式与判断标准，严格按照方案执行。培训必须在该临床试验机构入选受试者之前完成。研究者及研究中心工作人员应遵循本方案规定的研究程序、访视安排、评估方法和数据采集要求开展研究。研究过程中如出现方案偏离，研究者应及时记录、报告申办方，并按申办方规定的流程进行审查和处理。方案修正须经申办方医学负责人审核、伦理委员会批准后方可实施，修正后的方案应重新培训相关研究人员。","rationale":"培训与依从性结构参照公司语料中质量控制条款（69be796f1e42c8），属监管共性结构。本项目为多中心III期确证性研究，方案依从性为监管基本要求。本项目方案偏离处理具体流程、方案修正审批路径、依从性监测指标及违规后果等实施规则尚无项目来源支持。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_7aafcba68d3a_c87ae54eb8cab86a","section_number":"12.1","source_ids":["protocol_full_draft_selection:c8c3d1ad63e00ce774b96757","current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","company_corpus:cms_cn_protocol_corpus_20260715_v1:d84680fc442c0c","company_corpus:cms_cn_protocol_corpus_20260715_v1:ea3e32851b5d74","company_corpus:cms_cn_protocol_corpus_20260715_v1:69be796f1e42c8","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67"]}],"source_bindings":[{"content_sha256":"9677fbc6a4b0f31dfe57e57c08fa68b62a78214d046143a05fd93fdce9161d22","locator":"document:mwdoc_greenfield_proj_user_7aafcba68d3a_0edb7a13b36bcc44:full-draft:c8c3d1ad63e00ce774b96757","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:c8c3d1ad63e00ce774b96757","source_type":"protocol_full_draft_selection","source_version":"full-draft:d819bd480dc54a243e91766c1293abc4093589095d35f7bcabdd628318b48e29:c8c3d1ad63e00ce774b96757","text_sha256":"9677fbc6a4b0f31dfe57e57c08fa68b62a78214d046143a05fd93fdce9161d22"},{"content_sha256":"b6c04f6db6fde35e37a038ac3c3d1a8463187ca2ae1f46005bfb397145bcfef8","locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","source_type":"current_project_study_definition","source_version":"mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","text_sha256":"b6c04f6db6fde35e37a038ac3c3d1a8463187ca2ae1f46005bfb397145bcfef8"},{"con