:["protocol_full_draft_selection:8467d26477eaeee44b028d50","current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]},{"ai_run_id":"airun_20261005182038_fc4f0ec7","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"随机、双盲、安慰剂对照、三臂平行组、多中心III期确证性研究：R3A-BD301 25mg组与50mg组及匹配安慰剂组，每日一次口服26周；随后进入26周开放延长期（全部接受R3A-BD301 50mg）。两组均按需允许基础伴随治疗稳定（不含其他LUTS药物）。","quote_sha256":"a7dcd34a8f8c6130440fda7aaa9679926f5eb5ae0be995b32ebf2275b0c029f1","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_004"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"α1阻滞剂/5α还原酶抑制剂/PDE5抑制剂/抗胆碱能药（治疗LUTS用途）：随机前洗脱≥2周（5α还原酶抑制剂≥6个月）；抗高血压药物保持稳定≥4周不做硬性洗脱","quote_sha256":"5ad73dcb23291b7fc168f1d8f704e0366284c48ad54314dfb7b962797266f962","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_006"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"随机化按IPSS严重度分层（13~19 vs ≥20）与既往α1阻滞剂暴露（有/无）分层，1:1:1分配。","quote_sha256":"68ea26f5fc55026533790bbd591e0aabfdabc134b3f4a9158b06c0b343544db3","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_007"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"安慰剂平行对照（外观一致dummy片每日一次）；不设阳性药主动对照 arm，但在样本量与统计中以坦索罗辛历史数据作外部参照进行敏感性描述。","quote_sha256":"abc71d5873c1ccce1bfbe2ad2af35fbe2a8ee0cc31eddcd4a1c130df137e8fa7","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_008"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"之后全部受试者进入26周开放延长期接受R3A-BD301 50mg每日一次。","quote_sha256":"26c58daf413c138a049d490c33e23ec9527050f13aedeea0bfd0e1f105417a03","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_009"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"研究时期：筛选期（最长28天）；双盲治疗期（第1~26周，每日给药）；开放延长期（第27~52周，全部R3A-BD301 50mg）；治疗结束后安全随访（末次给药后2周）","quote_sha256":"4088525ffbf7ce0f3a416b5b2b2fb4eb874edeb9a81882454fa7b26a9c5d034b","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_012"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"双盲期每日晨起服药，访视窗口±3天。","quote_sha256":"2bb8e91186761e7551aa4e2e18f1aee98b7802de3ed30be648d225fa25c81099","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_013"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"DMC是否计划：是","quote_sha256":"9967a9a75297ced2326ab733fa3b16934acdef641fa765dd50c1cd58219f4aa5","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_015"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"无疗效期中分析；DSMB每4个月盲态安全审阅。","quote_sha256":"3fe8d1ce4e5c295b73bc50838ed0154028d5c6386c3d44f3b3fd531d02c2110b","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_016"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"主要估计目标（治疗策略）：在BPH伴中重度LUTS男性中，无论是否中止研究治疗或使用补救治疗，评价R3A-BD301 50mg每日一次26周相较安慰剂对IPSS总分较基线变化的作用。补救治疗（开始其他LUTS药物）记录为伴发事件并保留在主要分析（mITT）；停药者按治疗策略保留。","quote_sha256":"6545f382f872dd65fd332a3c38b301b4a69059e2ea3b14a4e6878357c245c173","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_017"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"在样本量与统计中以坦索罗辛历史数据作外部参照进行敏感性描述。","quote_sha256":"9d6c39ff6a54e26aa7c808d006ce7c00f3900403078c8debeb6051380ea21989","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_020"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"不设阳性药主动对照 arm","quote_sha256":"8705d200eaf9c6ff31bf02737de3d0615eb3e6b7f3a93b5ad83fd1b8282e3335","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_021"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"R3A-BD301（口服β3肾上腺素受体激动剂缓释片）：R3A-BD301缓释片，规格25mg/片与50mg/片（与外观一致的安慰剂片双模拟）；每日一次、每次一片，晨起空腹或餐后2小时整片吞服；双盲期共26周（182±3天），延长期再26周。","quote_sha256":"c7597b5e77a936325263e2309ca3d8cee141908b84780c12d38d39c5ff925592","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_022"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"试验组与对照组：R3A-BD301 25mg组（每日一次口服）；R3A-BD301 50mg组（每日一次口服）；安慰剂组（匹配 dummy 片，每日一次口服）","quote_sha256":"c37d79e5192659c2d22391507709a05bdd46716df9fd9d5b337814ffb1abe2b2","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_034"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"目标研究人群：年龄段：成人；疾病状态：中重度；经治情况：经治疗效不佳；50岁及以上男性，确诊良性前列腺增生伴中重度下尿路症状（IPSS总分≥13分），IPSS生活质量指数≥3分；筛选期Qmax 4~15 mL/s且排尿量≥125 mL，前列腺体积30~80 mL（经腹超声），PSA≤10 ng/mL；血压控制稳定（坐位SBP<140且DBP<90 mmHg或经治稳定）。","quote_sha256":"d4d896be0e0ffb1a96049f06fb1c11bab606e78e15bf54483bc5c7e7ece224ff","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_036"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"既往α1阻滞剂治疗无效或不耐受者可入组（经治亚组）。","quote_sha256":"f2f774f4ec19f6dc46d661f64e4be811e86fbce5565f6322b864885c1816ed10","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_037"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"同意研究期间不使用其他治疗BPH/LUTS的药物（含植物制剂）","quote_sha256":"3ad38005cd37ceb46b3f8cda644b462279b567a6846b20873384f87296e51891","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_038"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004","es_006","es_007","es_008","es_009","es_012","es_013","es_015","es_016","es_017","es_020","es_021","es_022","es_034","es_036","es_037","es_038"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":17},"gap_items":[{"action":"提供本项目剂量调整与停药实施规则或确认沿用公司标准模板","category":"source_missing","gap_id":"gap_6_001","missing_source_classes":["剂量调整/暂停/恢复/永久停药实施规则"],"target":"剂量调整、暂停、恢复与永久停药的具体实施规则"},{"action":"提供本项目药物过量与给药错误处理规程","category":"source_missing","gap_id":"gap_6_002","missing_source_classes":["药物过量与给药错误处理流程"],"target":"药物过量与给药错误的定义、处理流程与报告要求"},{"action":"提供本项目试验药管理操作规程","category":"source_missing","gap_id":"gap_6_003","missing_source_classes":["试验药包装储存与发放回收操作规程"],"target":"试验用药品包装、储存条件、发放与回收操作规程"}],"heading":"研究治疗/干预","missing_source_classes":["剂量调整/暂停/恢复/永久停药实施规则","药物过量与给药错误处理流程","试验药包装储存与发放回收操作规程"],"proposal_text":"本研究为随机、双盲、安慰剂对照、三臂平行组、多中心III期确证性研究，在50岁及以上确诊良性前列腺增生伴中重度下尿路症状（IPSS总分≥13分、IPSS生活质量指数≥3分）的男性中开展。受试者按1:1:1比例随机分配至R3A-BD301 25mg组、R3A-BD301 50mg组或匹配安慰剂组，随机化按IPSS严重度（13~19分与≥20分）及既往α1阻滞剂暴露（有或无）进行分层。双盲治疗期共26周（182±3天），每日晨起口服一次，访视窗口为计划访视日±3天。双盲期结束后，全部受试者进入26周开放延长期，接受R3A-BD301 50mg每日一次口服。治疗结束后设2周安全随访期。双盲期允许基础伴随治疗保持稳定，但不允许使用其他治疗BPH或下尿路症状的药物（含植物制剂）。随机前须完成以下洗脱：α1阻滞剂、5α还原酶抑制剂、PDE5抑制剂及抗胆碱能药（用于LUTS治疗）洗脱≥2周，其中5α还原酶抑制剂洗脱≥6个月；抗高血压药物保持稳定≥4周，不做硬性洗脱。本研究不设阳性药主动对照臂，但在样本量估算与统计分析中以坦索罗辛历史数据作为外部参照进行敏感性描述。主要估计目标采用治疗策略，无论受试者是否中止研究治疗或使用补救治疗（开始其他LUTS药物），均保留在主要分析集中；补救治疗记录为伴发事件。本研究计划设立独立数据安全监查委员会，每4个月进行盲态安全审阅；不设置疗效期中分析、样本量再估计、自适应设计或SRC。","rationale":"研究设计、三臂分配、分层因素、双盲期与延长期时长、洗脱规则、访视窗口、估计目标策略、DMC安排及不设阳性对照等事实均来源于当前项目已确认研究事实（修订4）。剂量调整、暂停、恢复、永久停药的具体实施规则及药物过量与给药错误处理流程在允许来源中未提供，需补充项目专属文件后完善。","review_advisories":["本节提及高影响设计信息（α、估计目标、伴发事件、期中分析、样本量）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_7aafcba68d3a_39731097d7a25f8d","section_number":"6","source_ids":["protocol_full_draft_selection:8467d26477eaeee44b028d50","current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]},{"ai_run_id":"airun_20261005182038_fc4f0ec7","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"试验药物：R3A-BD301（口服β3肾上腺素受体激动剂缓释片）","quote_sha256":"a64366b001b480374b31c33c50d4f7398e6404c5e482f967ae496585adbed542","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_002"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"R3A-BD301缓释片25mg或50mg每日一次口服，连续26周双盲治疗；之后全部受试者进入26周开放延长期接受R3A-BD301 50mg每日一次。双盲期每日晨起服药，访视窗口±3天。","quote_sha256":"d9e5c71c8743def5d0f6f2fa2dd405d924eff4d7b402a18bc59062c630136028","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_003"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"安慰剂平行对照（外观一致dummy片每日一次）；不设阳性药主动对照 arm，但在样本量与统计中以坦索罗辛历史数据作外部参照进行敏感性描述。","quote_sha256":"abc71d5873c1ccce1bfbe2ad2af35fbe2a8ee0cc31eddcd4a1c130df137e8fa7","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_008"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"之后全部受试者进入26周开放延长期接受R3A-BD301 50mg每日一次。","quote_sha256":"26c58daf413c138a049d490c33e23ec9527050f13aedeea0bfd0e1f105417a03","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_009"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"不设阳性药主动对照 arm","quote_sha256":"8705d200eaf9c6ff31bf02737de3d0615eb3e6b7f3a93b5ad83fd1b8282e3335","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_021"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"R3A-BD301（口服β3肾上腺素受体激动剂缓释片）：R3A-BD301缓释片，规格25mg/片与50mg/片（与外观一致的安慰剂片双模拟）；每日一次、每次一片，晨起空腹或餐后2小时整片吞服；双盲期共26周（182±3天），延长期再26周。","quote_sha256":"c7597b5e77a936325263e2309ca3d8cee141908b84780c12d38d39c5ff925592","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_022"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"试验组与对照组：R3A-BD301 25mg组（每日一次口服）；R3A-BD301 50mg组（每日一次口服）；安慰剂组（匹配 dummy 片，每日一次口服）","quote_sha256":"c37d79e5192659c2d22391507709a05bdd46716df9fd9d5b337814ffb1abe2b2","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_034"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003","es_008","es_009","es_021","es_022","es_034"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":7},"gap_items":[{"action":"提供R3A-BD301药学研究资料或研究者手册中相关章节","category":"source_missing","gap_id":"gap_6_1_001","missing_source_classes":["R3A-BD301药学信息（辅料组成、质量标准、稳定性数据）"],"target":"R3A-BD301辅料组成、质量标准与稳定性数据"},{"action":"提供安慰剂处方与制备说明","category":"source_missing","gap_id":"gap_6_1_002","missing_source_classes":["安慰剂辅料与制备信息"],"target":"安慰剂辅料组成与制备信息"},{"action":"提供试验药包装与储存条件说明","category":"source_missing","gap_id":"gap_6_1_003","missing_source_classes":["试验药包装规格与储存条件"],"target":"试验药包装规格、储存条件与有效期"}],"heading":"试验用药品","missing_source_classes":["R3A-BD301药学信息（辅料组成、质量标准、稳定性数据）","安慰剂辅料与制备信息","试验药包装规格与储存条件"],"proposal_text":"本研究试验用药品为R3A-BD301（口服β3肾上腺素受体激动剂缓释片），属小分子药物，给药途径为口服，剂型为口服固体制剂，系统暴露。试验用药品包括R3A-BD301缓释片25mg规格与50mg规格，以及外观一致的安慰剂片（双模拟）。双盲期受试者每日晨起空腹或餐后2小时整片吞服一片，不得掰开、咀嚼或研磨。双盲治疗期共26周（182±3天），之后进入26周开放延长期，全部受试者接受R3A-BD301 50mg每日一次。安慰剂为外观一致的dummy片，每日一次口服，与试验药双模拟。本研究不设阳性药主动对照臂。","rationale":"试验用药品名称、规格（25mg/50mg）、剂型（口服固体制剂）、给药途径（口服）、药物技术类型（small_molecule）、系统暴露、双模拟安慰剂、服药方式（晨起空腹或餐后2小时整片吞服）及双盲期与延长期时长均来源于当前项目已确认研究事实（修订4）。R3A-BD301的辅料组成、质量标准、稳定性数据、包装规格细节及安慰剂的具体辅料与制备信息在允许来源中未提供。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_7aafcba68d3a_6b524e90d9cc21cc","section_number":"6.1","source_ids":["protocol_full_draft_selection:8467d26477eaeee44b028d50","current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]},{"ai_run_id":"airun_20261005182038_fc4f0ec7","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"试验药物：R3A-BD301（口服β3肾上腺素受体激动剂缓释片）","quote_sha256":"a64366b001b480374b31c33c50d4f7398e6404c5e482f967ae496585adbed542","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_002"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"β3肾上腺素受体（β3-AR）高选择性激动剂：激动膀胱逼尿肌β3受体使逼尿肌舒张，增加储尿期膀胱容量、减少尿急与尿频，不影响排尿期逼尿肌收缩力；对β1/β2受体亲和力低以减少心血管影响。","quote_sha256":"62bf8d9b91439d16aa90574f1a8f4d81f5688e3f6fd824275d7587f9ac1d3281","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_005"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"安全性终点：TEAE/SAE发生率与严重程度；生命体征（坐位血压、心率）较基线变化与体位性低血压事件；12导联心电图（QTcF）变化；实验室检查（肝肾功能、血糖、HbA1c、PSA）；尿潴留、泌尿系感染、生殖系统不良事件专项汇总","quote_sha256":"226244cc6015d1fe4a1e793c7cb29d34bfd10dfb2a031c464eacbbb6daeee587","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_010"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"特别关注的不良事件：血压升高与高血压相关严重事件；心率增快及心律失常事件；尿潴留（需导尿处理）；严重心血管事件（MACE，CEC裁定）","quote_sha256":"21fd6de994da28afc4c53de1e1031ef44ad76664647cac5a7a17b8450ec0e12a","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_011"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"MACE由独立CEC裁定。","quote_sha256":"d33c092e19a15ee1a2fa4276475651a79b1d8154f13dc56d053634ff0b985121","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_019"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"研究题目：R3A-BD301（口服β3肾上腺素受体激动剂缓释片）用于治疗良性前列腺增生伴中重度下尿路症状的III期临床研究","quote_sha256":"0d7abad5721e34693a8d2882cf4ec8abcd1c211e0c9348db632cef40e31b0ca3","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_024"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"内在研究目的：确证性研究；确证R3A-BD301 50mg每日一次口服26周治疗良性前列腺增生伴中重度LUTS的疗效（IPSS总分较基线变化）与安全性；评估对生活质量指数（QoL）、最大尿流率（Qmax）与残余尿量（PVR）的改善；评估26周治疗结束后进入26周延长期的长期安全性与疗效维持","quote_sha256":"6f25cd21fac899d05b8a0056bc328cf78e00969c9783210d4d95295a14bd837e","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_025"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"主要终点：治疗第26周IPSS总分较基线的变化（R3A-BD301 50mg组 vs 安慰剂组；25mg组为次要剂量支持）","quote_sha256":"79008c3a802d6edd14a3d64b1653200b7133fe2f501c55e2fd614d8c77cdff94","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_026"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"关键次要终点：第26周IPSS生活质量指数（QoL）较基线变化；第26周最大尿流率（Qmax）较基线变化；第26周BPH影响指数（BII）较基线变化","quote_sha256":"e7c78d0896d47aed51caa1ed4a24813188f8c5be30fde89c683fab576c5d2e8e","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_027"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"其他次要终点：第4、12周IPSS总分较基线变化（起效时间）；第26周夜尿次数与每次尿量日记指标变化；第52周（延长期末）IPSS总分与Qmax维持情况；受试者整体印象改善评分（PGI-I）应答率","quote_sha256":"2d3abe263d043e14164a10ed089585a39387554966a0f1f1403bdf306fab0e0c","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_028"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"探索性终点：前列腺体积与血清PSA在52周的变化（描述性）；按基线IPSS严重度与代谢综合征状态的亚组疗效探索","quote_sha256":"0199b9b943fd527ae3e551a49aeb79da0306bf78e2077aadf6e6d3bb4488feab","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_029"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"开发区域：中国","quote_sha256":"cff843d358ea50e7e53ede8d1eba9b9d23baa740d2cd2134679e6483c3e50b76","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_030"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"研究分期：III期","quote_sha256":"5ac919b18530a35e6df200dbf04b4bc9fbd8d00da2c279aa58a1ff849584b451","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_031"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"适应症：良性前列腺增生伴中重度下尿路症状","quote_sha256":"0c6d13b0375e9f89e501f43322e772d150a5d51f73e6ffbd3815442dcdde47ad","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_032"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_005","es_010","es_011","es_019","es_024","es_025","es_026","es_027","es_028","es_029","es_030","es_031","es_032"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":14},"gap_items":[{"action":"提供R3A-BD301非临床研究摘要或IB相关章节","category":"source_missing","gap_id":"gap_6_1_1_001","missing_source_classes":["R3A-BD301研究者手册（IB）","既往非临床研究数据"],"target":"R3A-BD301既往非临床研究数据（药理毒理、药代动力学）"},{"action":"提供既往临床研究摘要或IB中临床数据章节","category":"source_missing","gap_id":"gap_6_1_1_002","missing_source_classes":["既往临床研究数据","β3受体激动剂类药物已知风险特征"],"target":"R3A-BD301或同类β3受体激动剂既往临床研究数据"},{"action":"提供IB中已知风险章节或同类药物安全性数据","category":"source_missing","gap_id":"gap_6_1_1_003","missing_source_classes":["R3A-BD301研究者手册（IB）","β3受体激动剂类药物已知风险特征"],"target":"研究药物具体风险描述（血压升高、心率增快的发生率与严重程度数据）"}],"heading":"研究药物信息","missing_source_classes":["R3A-BD301研究者手册（IB）","既往非临床研究数据","既往临床研究数据","β3受体激动剂类药物已知风险特征"],"proposal_text":"R3A-BD301为β3肾上腺素受体（β3-AR）高选择性激动剂，其作用机制为激动膀胱逼尿肌β3受体使逼尿肌舒张，增加储尿期膀胱容量、减少尿急与尿频，不影响排尿期逼尿肌收缩力；对β1/β2受体亲和力低以减少心血管影响。本品为小分子药物，口服给药，系统暴露。本研究适应症为良性前列腺增生伴中重度下尿路症状，研究分期为III期，开发区域为中国，方案编号R3A-BD301-301，方案版本V1.0。研究目的为确证R3A-BD301 50mg每日一次口服26周治疗良性前列腺增生伴中重度下尿路症状的疗效（IPSS总分较基线变化）与安全性，评估对生活质量指数（QoL）、最大尿流率（Qmax）与残余尿量（PVR）的改善，并评估26周治疗结束后进入26周延长期的长期安全性与疗效维持。主要终点为治疗第26周IPSS总分较基线的变化（R3A-BD301 50mg组与安慰剂组比较，25mg组为次要剂量支持）。关键次要终点为第26周IPSS生活质量指数（QoL）较基线变化、第26周最大尿流率（Qmax）较基线变化及第26周BPH影响指数（BII）较基线变化。其他次要终点包括第4周与第12周IPSS总分较基线变化（起效时间）、第26周夜尿次数与每次尿量日记指标变化、第52周（延长期末）IPSS总分与Qmax维持情况及受试者整体印象改善评分（PGI-I）应答率。探索性终点为前列腺体积与血清PSA在52周的变化（描述性）及按基线IPSS严重度与代谢综合征状态的亚组疗效探索。安全性终点包括TEAE/SAE发生率与严重程度、生命体征（坐位血压、心率）较基线变化与体位性低血压事件、12导联心电图（QTcF）变化、实验室检查（肝肾功能、血糖、HbA1c、PSA）及尿潴留、泌尿系感染、生殖系统不良事件专项汇总。特别关注的不良事件包括血压升高与高血压相关严重事件、心率增快及心律失常事件、尿潴留（需导尿处理）及严重心血管事件（MACE，由独立CEC裁定）。","rationale":"β3-AR高选择性激动剂机制、β1/β2低亲和力、小分子/口服/系统暴露、适应症、研究分期、开发区域、方案编号与版本、研究目的、主要终点、关键次要终点、其他次要终点、探索性终点、安全性终点及特别关注不良事件均来源于当前项目已确认研究事实（修订4）。R3A-BD301的既往非临床研究数据、既往临床研究数据、已知风险特征（如血压升高与心率增快的发生率）及完整研究者手册内容在允许来源中未提供，需补充后方可完善药物风险描述。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_7aafcba68d3a_41a549c4d1b762a3","section_number":"6.1.1","source_ids":["protocol_full_draft_selection:8467d