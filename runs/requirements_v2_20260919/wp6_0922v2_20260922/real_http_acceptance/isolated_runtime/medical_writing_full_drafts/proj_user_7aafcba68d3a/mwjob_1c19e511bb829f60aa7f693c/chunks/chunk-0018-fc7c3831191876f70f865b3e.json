现场监查，评价其是否遵守监管要求，确保受试者的安全、福利以及隐私受到 保护、方案依从性、CRF 录入的完整性和准确性、CRF 数据和原始文件的验证及 AE 的发生等。研究者必须向监查员提供访问所有原始资料和研究文件的权限。","quote_sha256":"308a36177f06e789510202b2b938b2a9e5084c7e222d80919f28732387e33a3e","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","span_id":"es_003"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"DMC是否计划：是","quote_sha256":"9967a9a75297ced2326ab733fa3b16934acdef641fa765dd50c1cd58219f4aa5","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_008"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"MACE由独立CEC裁定","quote_sha256":"d37f529f9dc3da7c0401182f45140d651470b782065c9f57a9df82bf1799e42e","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_009"}],"evidence_review_advisories":[],"evidence_span_ids":["es_001","es_002","es_003","es_008","es_009"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":4},"gap_items":[{"action":"补充项目级监查计划文件，明确各阶段监查频率、现场与远程监查比例、关键数据核查范围","category":"source_missing","gap_id":"gap_monitoring_01","missing_source_classes":["项目级监查计划"],"target":"12.2节监查频率与监查计划"},{"action":"补充DMC章程或章程引用，明确紧急会议触发条件、安全信号升级路径、与申办者及独立统计中心的沟通机制","category":"source_missing","gap_id":"gap_monitoring_02","missing_source_classes":["DMC章程"],"target":"12.2节DMC运作细则"}],"heading":"监查","missing_source_classes":["项目级监查计划（监查频率、监查员资质、远程与现场监查比例、关键数据核查范围）","DMC章程（紧急会议触发条件、与申办者沟通路径、安全信号升级机制）"],"proposal_text":"本研究为多中心III期确证性研究，申办者依据中国GCP及ICH E6(R2)要求建立研究监查体系，确保各研究中心在方案依从性、受试者权益保护、数据完整性及安全性报告方面符合监管要求。监查活动由申办者或其委托的第三方执行，涵盖对研究中心的定期现场监查和远程数据核查，评价内容包括但不限于：受试者知情同意签署的规范性、入选与排除标准的执行情况、研究药物发放与回收记录、不良事件及严重不良事件的识别与报告、病例报告表数据与原始病历的一致性、实验室检查及心电图等安全性评估的完整性。研究者须向监查员提供访问所有原始资料和研究文件的权限，以保障监查活动的有效开展。本研究设立数据监查委员会，每4个月进行一次盲态安全审阅，审阅内容包括安全性信号汇总、特别关注不良事件（血压升高、心率增快及心律失常、尿潴留、主要心血管不良事件）的发生情况以及各治疗组间安全性趋势。主要心血管不良事件由独立心血管终点裁定委员会进行裁定。监查员在每次现场监查后向申办者提交监查报告，记录发现的问题、纠正措施及后续跟踪要求。","rationale":"多中心设计、DMC每4个月盲态安全审阅、MACE由独立CEC裁定、DSMB设置均来源于当前项目已确认研究事实。监查活动的一般框架参照GCP通用结构。具体监查频率、监查员资质要求、远程与现场监查比例、监查报告模板等项目级实施细节缺少来源支持，需医学经理补充确认。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_7aafcba68d3a_9f65a60349ca82bd","section_number":"12.2","source_ids":["protocol_full_draft_selection:fc7c3831191876f70f865b3e","current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","company_corpus:cms_cn_protocol_corpus_20260715_v1:3d78c7bb1bd24f","company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67"]},{"ai_run_id":"airun_20261005190901_c20e0972","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:研究者签字页|block:32|chunk:1","quote":"我同意接受申办者派遣临床监查员或稽查员对本次临床研究的监查或稽查及药品管理部门的视查，确保临床研究质量。","quote_sha256":"7b5107e534b1945df0f53889ceb8ec820728aa37140ba980bc462ccfc9d5507a","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","span_id":"es_004"},{"locator":"section:统计分析单位签字页|block:56|chunk:1","quote":"努力并严格按照方案、现行的ICH GCP和NMPA GCP指导原则以及适用的法规和指导方针进行本试验的临床监查、数据管理和统计分析工作，认真履行第三方职责，负责协调和监查本项临床研究，保证临床研究中参与者权益受到保障，确保研究记录与报告的数据真实准确、完整无误，保证研究遵循已批准的方案，确保临床研究质量。","quote_sha256":"ce0d2dfe125632cc5d7e00e964022f9cd73382987f5a821bb4cc70694b086ad9","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","span_id":"es_006"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004","es_006"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":0},"gap_items":[{"action":"补充项目级稽查计划，明确稽查频率、稽查范围、稽查员独立性要求及与监查活动的区分","category":"source_missing","gap_id":"gap_audit_01","missing_source_classes":["项目级稽查计划"],"target":"12.3节稽查频率与范围"},{"action":"补充国家药品监督管理部门核查的应对预案、研究中心配合流程及文件准备要求","category":"source_missing","gap_id":"gap_audit_02","missing_source_classes":["核查应对预案"],"target":"12.3节核查配合流程"}],"heading":"稽查和核查","missing_source_classes":["项目级稽查计划（稽查频率、稽查范围、稽查员独立性要求）","国家药监局核查应对预案及配合流程"],"proposal_text":"申办者依据中国GCP及ICH E6(R2)要求，在研究期间保留对研究中心进行独立质量稽查的权利。稽查由独立于研究执行团队的质量保证人员或委托的第三方稽查机构实施，稽查范围涵盖研究方案依从性、数据完整性、受试者权益保护、研究药物管理、安全性报告及时性及文件归档的规范性。研究者同意接受申办者派遣的临床监查员或稽查员对本次临床研究进行稽查，以及接受国家药品监督管理部门的监督检查。研究中心须为稽查员和核查人员提供访问所有原始资料和研究文件的权限，确保稽查和核查活动的顺利开展。稽查发现的问题以书面报告形式反馈至研究中心和申办者，研究中心应在规定时限内提交纠正与预防措施。稽查报告及核查记录作为研究质量管理的组成部分予以归档保存。","rationale":"稽查和核查的通用框架来源于公司语料中研究者签字页及统计分析单位签字页的GCP结构表述，属于监管共性条款。本项目为多中心研究、开发区域为中国，稽查和核查的必要性由研究设计决定。具体稽查频率、稽查范围、稽查员独立性要求、核查配合流程及国家药监局核查应对预案等项目级实施细节缺少来源支持。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_7aafcba68d3a_2e5b28f6c520f92d","section_number":"12.3","source_ids":["protocol_full_draft_selection:fc7c3831191876f70f865b3e","current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","company_corpus:cms_cn_protocol_corpus_20260715_v1:3d78c7bb1bd24f","company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67"]},{"ai_run_id":"airun_20261005190901_c20e0972","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"补充项目级方案偏离管理文件，明确重大偏离与一般偏离定义、报告时限、EC及申办者通知流程、偏离对mITT及PP集的影响处理","category":"source_missing","gap_id":"gap_deviation_01","missing_source_classes":["项目级方案偏离管理文件"],"target":"12.4节方案偏离分类与报告"}],"heading":"方案偏离","missing_source_classes":["项目级方案偏离分类标准与报告流程","偏离对数据分析集影响的处理规则","EC及申办者通知时限与路径"],"proposal_text":"","rationale":"方案偏离章节需要项目级偏离分类标准、报告时限、EC及申办者通知流程、偏离对数据分析集影响等具体实施规则。公司语料中仅有一条关于方案修订的GCP通用条款（未经申办者和EC同意不得修改或偏离方案），该条款属于监管共性结构参照，不足以构成本项目方案偏离章节的实质正文。缺少项目级方案偏离管理文件，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_7aafcba68d3a_5f965002986f8af2","section_number":"12.4","source_ids":["protocol_full_draft_selection:fc7c3831191876f70f865b3e","current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","company_corpus:cms_cn_protocol_corpus_20260715_v1:3d78c7bb1bd24f","company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67"]},{"ai_run_id":"airun_20261005190901_c20e0972","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"DSMB每4个月盲态安全审阅","quote_sha256":"fbdbd4aafe490d2bf67e3c339c74e059618da73323fd61420352a9a449c97139","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_002"},{"locator":"section:研究者签字页|block:32|chunk:1","quote":"我同意接受申办者派遣临床监查员或稽查员对本次临床研究的监查或稽查及药品管理部门的视查，确保临床研究质量。","quote_sha256":"7b5107e534b1945df0f53889ceb8ec820728aa37140ba980bc462ccfc9d5507a","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","span_id":"es_004"},{"locator":"section:统计分析单位签字页|block:56|chunk:1","quote":"努力并严格按照方案、现行的ICH GCP和NMPA GCP指导原则以及适用的法规和指导方针进行本试验的临床监查、数据管理和统计分析工作，认真履行第三方职责，负责协调和监查本项临床研究，保证临床研究中参与者权益受到保障，确保研究记录与报告的数据真实准确、完整无误，保证研究遵循已批准的方案，确保临床研究质量。","quote_sha256":"ce0d2dfe125632cc5d7e00e964022f9cd73382987f5a821bb4cc70694b086ad9","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","span_id":"es_006"},{"locator":"section:文档开头|block:4|chunk:1","quote":"本方案中所包含的所有信息归申办方所有，因此，仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构进行审阅。在未得到申办方书面批准的情况下，除了在与可能参加本研究的受试者签署知情同意书时，向其做必要的解释外，严禁将任何信息告知与本研究无关的第三方。","quote_sha256":"dfc9fceb41db9d941df0e3715483adaa069da4f1953600a6a37a56d7f81373dd","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","span_id":"es_007"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"DMC是否计划：是","quote_sha256":"9967a9a75297ced2326ab733fa3b16934acdef641fa765dd50c1cd58219f4aa5","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_008"},{"locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","quote":"MACE由独立CEC裁定","quote_sha256":"d37f529f9dc3da7c0401182f45140d651470b782065c9f57a9df82bf1799e42e","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","span_id":"es_009"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_004","es_006","es_007","es_008","es_009"],"evidence_summary":{"corpus_spans":3,"project_fact_spans":3},"gap_items":[{"action":"补充项目级角色职责矩阵，明确申办者、CRO、研究中心、DMC、CEC、统计单位各自职责边界与汇报关系","category":"source_missing","gap_id":"gap_role_01","missing_source_classes":["角色职责矩阵"],"target":"12.5节角色职责矩阵"},{"action":"补充各角色签署要求、文件签署流程及角色间沟通与升级机制","category":"source_missing","gap_id":"gap_role_02","missing_source_classes":["签署要求与沟通机制"],"target":"12.5节签署与沟通机制"}],"heading":"关键角色和研究管理","missing_source_classes":["项目级角色职责矩阵（各角色具体职责边界与汇报关系）","各角色签署要求与文件签署流程","角色间沟通机制与升级路径"],"proposal_text":"本研究涉及的关键角色包括申办者、研究中心研究者、数据监查委员会、独立心血管终点裁定委员会、统计分析单位及第三方协调监查机构。申办者承担研究的整体管理责任，确保研究按照已批准的方案、GCP指导原则及适用法规进行，对研究质量、受试者权益保护和数据完整性承担最终责任。研究中心研究者负责在各自中心按照方案要求实施研究，保证研究资料真实、准确、及时、合法地载入病例报告表，并同意接受申办者派遣的临床监查员或稽查员对本次临床研究的监查或稽查及药品管理部门的视查。数据监查委员会每4个月进行一次盲态安全审阅，对研究安全性进行独立监督。主要心血管不良事件由独立心血管终点裁定委员会进行裁定，确保终点判定的客观性和一致性。统计分析单位严格按照方案、现行ICH GCP和NMPA GCP指导原则以及适用的法规和指导方针进行数据管理和统计分析工作，确保研究记录与报告的数据真实准确、完整无误。第三方协调监查机构负责协调和监查本项临床研究，保证临床研究中参与者权益受到保障，确保研究遵循已批准的方案。本方案中所包含的所有信息归申办方所有，仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构进行审阅，在未得到申办方书面批准的情况下，严禁将任何信息告知与本研究无关的第三方。","rationale":"DMC设置、CEC裁定MACE、多中心设计来源于当前项目已确认研究事实。各角色职责描述参照公司语料中研究者签字页、统计分析单位签字页及文档保密条款的GCP通用结构，属于监管共性条款。具体角色职责矩阵、汇报关系、签署要求、各角色间沟通机制等项目级实施细节缺少来源支持。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_7aafcba68d3a_ce3f417ba30c389b","section_number":"12.5","source_ids":["protocol_full_draft_selection:fc7c3831191876f70f865b3e","current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","company_corpus:cms_cn_protocol_corpus_20260715_v1:3d78c7bb1bd24f","company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67"]}],"source_bindings":[{"content_sha256":"3b45180855e5348e5d412f30dbb63b5bb7b26f437c748b361b042db818775ae4","locator":"document:mwdoc_greenfield_proj_user_7aafcba68d3a_0edb7a13b36bcc44:full-draft:fc7c3831191876f70f865b3e","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:fc7c3831191876f70f865b3e","source_type":"protocol_full_draft_selection","source_version":"full-draft:d819bd480dc54a243e91766c1293abc4093589095d35f7bcabdd628318b48e29:fc7c3831191876f70f865b3e","text_sha256":"3b45180855e5348e5d412f30dbb63b5bb7b26f437c748b361b042db818775ae4"},{"content_sha256":"b6c04f6db6fde35e37a038ac3c3d1a8463187ca2ae1f46005bfb397145bcfef8","locator":"study_definition:mwdefinition_c29c971a255e3e8daba1:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","source_type":"current_project_study_definition","source_version":"mwdefinition_c29c971a255e3e8daba1:r4:4a7fd852182b4175","text_sha256":"b6c04f6db6fde35e37a038ac3c3d1a8463187ca2ae1f46005bfb397145bcfef8"},{"content_sha256":"76042946d5684aaa9636ba63055710074755cd90e1cbcdea361b478c726f510b","locator":"section:11.7 方案修订|block:1231|chunk:1","r