s_spans":0,"project_fact_spans":2},"gap_items":[{"action":"依据IB药效学章节与Ib期PD数据确定PD评估终点及对应检测方法","category":"source_missing","gap_id":"gap_pd_01","missing_source_classes":["IB药效学章节","Ib期PD数据"],"target":"7.4节PD终点定义与完整生物标志物面板"},{"action":"确定除W6/W12粪钙卫蛋白与CRP外是否需额外PD采样点及具体检测方法","category":"source_missing","gap_id":"gap_pd_02","missing_source_classes":["PD采样方案","实验室检测SOP"],"target":"7.4节PD采样时点与检测方法"},{"action":"确认粪钙卫蛋白与CRP在本方案中归为PD评估还是疗效辅助指标","category":"decision_pending","gap_id":"gap_pd_03","missing_source_classes":[],"target":"7.4节粪钙卫蛋白与CRP的归类"}],"heading":"药效动力学评估","missing_source_classes":["研究者手册（IB）中VNN1抑制剂的药效学章节","Ib期研究药效动力学数据","PD生物标志物检测方法与验证资料"],"proposal_text":"MY009212A片为VNN1抑制剂，本研究在IIa概念验证阶段探索其药效动力学特征。第6周和第12周访视时采集粪便钙卫蛋白与血清C反应蛋白，用于辅助评估肠道炎症活动度的变化趋势，检测时间窗允许±4天。上述生物标志物在W6和W12各采集一次，与中心读片内镜评估（W12）共同构成炎症活动度变化的辅助观察指标。药效动力学评估的具体终点定义、完整生物标志物面板、各访视采样时点与检测方法、以及PD数据的分析策略，需依据MY009212A的非临床药效学数据与Ib期研究结果进一步确定。","rationale":"来源确认W6/W12行粪钙卫蛋白与CRP检测及VNN1 PD平台特征；但完整PD评估方案（PD终点、采样时点、检测方法）未在已确认研究事实中定义，需医学经理结合IB与Ib期数据补充。粪钙卫蛋白与CRP的归类（PD或疗效辅助）待确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f601cf2900ea_7e1d3d144a10c47d","section_number":"7.4","source_ids":["protocol_full_draft_selection:2add3863203266874c50880f","current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380"]},{"ai_run_id":"airun_20261008213813_3c4e742a","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"确定各访视需采集的生物样本类型（血液、粪便、组织等）及对应时点","category":"source_missing","gap_id":"gap_bio_01","missing_source_classes":["生物样本采集SOP","PK/PD采样方案"],"target":"7.5节生物样本采集时点与类型"},{"action":"确定离心条件、保存温度、运输温度与时间窗","category":"source_missing","gap_id":"gap_bio_02","missing_source_classes":["实验室操作SOP","中心实验室要求"],"target":"7.5节样本处理与保存条件"},{"action":"确定研究结束后剩余样本的销毁或返还规则","category":"source_missing","gap_id":"gap_bio_03","missing_source_classes":["样本管理政策","伦理审批要求"],"target":"7.5节样本销毁与返还"}],"heading":"生物样本采集、处置与保存","missing_source_classes":["生物样本采集与处理SOP","中心实验室指定与检测目录","样本运输与保存规范","样本销毁与返还政策"],"proposal_text":"","rationale":"来源仅确认W6/W12行粪钙卫蛋白与CRP检测，未提供生物样本采集时点、采血管类型、离心条件、保存温度、运输规范、样本销毁与返还规则、中心实验室指定等任何实施细节。该章节需要完整的生物样本管理方案方可撰写实质正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f601cf2900ea_06f0e02eb3fba3c4","section_number":"7.5","source_ids":["protocol_full_draft_selection:2add3863203266874c50880f","current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380"]},{"ai_run_id":"airun_20261008213813_3c4e742a","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"安全性随访期：D85至D98（2周，末次给药后安全性随访）","quote_sha256":"a408385a71ec794102e63bc109913ede974169b102af96d84de1436678eefd68","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_safety_period"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"安全性比较在各平行组间进行。不设阳性对照（IIa以概念验证与剂量探索为目的）。","quote_sha256":"d61d754195486e3fa7d8939db88fa852e0fc5e38bf4b6185ec2192014a1c2d1d","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_safety_comparison"}],"evidence_review_advisories":[],"evidence_span_ids":["es_safety_period","es_safety_comparison"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"依据IB与项目安全性管理计划确定AE/SAE/SUSAR定义、报告对象与时限","category":"source_missing","gap_id":"gap_safety_01","missing_source_classes":["IB安全性章节","安全性管理计划"],"target":"8节AE/SAE/SUSAR定义与报告时限"},{"action":"依据VNN1抑制剂类效应与Ib期安全性数据确定AESI清单","category":"source_missing","gap_id":"gap_safety_02","missing_source_classes":["IB安全性章节","Ib期安全性数据"],"target":"8节特别关注不良事件清单"},{"action":"确定安全性评估窗口起止、剂量调整/暂停/永久停药标准","category":"source_missing","gap_id":"gap_safety_03","missing_source_classes":["安全性管理计划","剂量调整方案"],"target":"8节安全性评估窗口与剂量调整规则"}],"heading":"安全性评价","missing_source_classes":["研究者手册（IB）安全性章节","项目安全性管理计划","AE/SAE/SUSAR定义与报告SOP","特别关注不良事件清单"],"proposal_text":"本研究安全性评价覆盖双盲治疗期（D1至D84）及安全性随访期（D85至D98，即末次给药后2周）。安全性比较在160 mg BID组、80 mg BID组与安慰剂组之间进行，不设阳性对照。安全性评估内容包括不良事件与严重不良事件的监测、实验室检查异常、生命体征变化及特别关注的不良事件。安全性随访期访视安排为W14安全随访。各平行组间的安全性数据以描述性统计汇总，重点关注治疗期间新发或加重的不良事件。","rationale":"来源确认安全性随访期D85至D98（2周）、安全性比较在各平行组间进行、不设阳性对照、W14安全随访访视。但AE/SAE/SUSAR定义、报告时限、特别关注不良事件具体清单、安全性评估窗口起止规则、剂量调整与永久停药标准等实施细节未在来源中给出，需依据IB与项目安全性管理计划补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f601cf2900ea_f86a4b8b01204153","section_number":"8","source_ids":["protocol_full_draft_selection:2add3863203266874c50880f","current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380"]},{"ai_run_id":"airun_20261008213813_3c4e742a","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"安全性随访期：D85至D98（2周，末次给药后安全性随访）","quote_sha256":"a408385a71ec794102e63bc109913ede974169b102af96d84de1436678eefd68","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_safety_period"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"安全性比较在各平行组间进行。不设阳性对照（IIa以概念验证与剂量探索为目的）。","quote_sha256":"d61d754195486e3fa7d8939db88fa852e0fc5e38bf4b6185ec2192014a1c2d1d","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_safety_comparison"}],"evidence_review_advisories":[],"evidence_span_ids":["es_safety_period","es_safety_comparison"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"依据IB与安全性管理计划确定定义、报告对象与时限","category":"source_missing","gap_id":"gap_safety_04",