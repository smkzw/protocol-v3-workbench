ns":0,"project_fact_spans":2},"gap_items":[{"action":"由统计团队依据样本量计算确定三组分配比例后写入","category":"source_missing","gap_id":"gap_rand_ratio","missing_source_classes":["样本量计算报告","统计分析报告"],"target":"4.3节各治疗组分配比例"}],"heading":"随机化","missing_source_classes":["样本量计算报告或统计分析报告（SAP）中各治疗组分配比例"],"proposal_text":"本研究采用固定剂量平行组设计，设MY009212A片160 mg每日两次组（候选推荐II期剂量）、MY009212A片80 mg每日两次组（低剂量探索组）及安慰剂组，共三个治疗组，不采用受试者内剂量递增。受试者随机分配至上述三组之一，随机化通过中央交互式网络应答系统（IWRS）完成，由申办方在研究启动前生成随机分配序列并载入IWRS。各中心受试者经筛选合格并完成基线评估后，由研究者通过IWRS获取随机编号及对应治疗组别，随即按组别发放相应试验用药品或模拟制剂。随机化采用双盲双模拟方式，受试者、研究者及研究中心工作人员在研究期间均不知晓各组受试者所接受的具体药物类别。","rationale":"随机化方式（中央IWRS）、平行组三臂设计（160 mg BID、80 mg BID、安慰剂）及双盲双模拟为当前项目已确认研究事实。各治疗组间分配比例未在已确认事实中给出，正文未写入具体比例，需医学经理与统计团队确认后补充。","review_advisories":["本节复述高影响研究设计（随机化）；请在合并设计摘要中统一核对。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f601cf2900ea_533fd8d5b84e8806","section_number":"4.3","source_ids":["protocol_full_draft_selection:e1b804761f33837da8b3be27","current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:c3e1f164c2e657"]},{"ai_run_id":"airun_20261008211449_8326efac","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"安慰剂对照（双盲双模拟）：安慰剂组为与MY009212A片外观一致的安慰剂片，BID口服共12周","quote_sha256":"d393f67a21061bb208ac06af65caa6f14ef8c8afa7b1fc3f91a4d00154b44e4f","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_04"}],"evidence_review_advisories":[],"evidence_span_ids":["es_04"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[{"action":"与药学团队确认160 mg BID组及80 mg BID组每次实际服用片数及安慰剂补充片数","category":"source_not_retrieved","gap_id":"gap_blind_dose_calc","missing_source_classes":["药学规格说明","给药方案确认函"],"target":"4.4节双盲双模拟片数描述"},{"action":"由申办方提供IWRS揭盲功能说明及SOP后写入具体操作程序","category":"source_missing","gap_id":"gap_unblind_procedure","missing_source_classes":["IWRS系统功能说明","申办方SOP"],"target":"4.4节紧急揭盲及研究结束揭盲"}],"heading":"盲法与揭盲","missing_source_classes":["IWRS系统功能说明或揭盲操作规程","申办方标准操作规程（SOP）中紧急揭盲及研究结束揭盲条款"],"proposal_text":"本研究采用双盲设计。试验用药品MY009212A片为40 mg薄膜衣片，安慰剂组给予与MY009212A片外观一致的安慰剂片，每日两次口服，疗程共12周。双盲双模拟的实施方式为：160 mg BID组每次服用4片MY009212A片加2片安慰剂，80 mg BID组每次服用2片MY009212A片加4片安慰剂，安慰剂组每次服用6片安慰剂，使各组受试者每次口服片数一致，以维持盲态。在研究期间，受试者、研究者及研究中心工作人员均不知晓各组受试者所接受的具体药物类别。","rationale":"双盲设计、双盲双模拟、安慰剂与MY009212A片外观一致及BID口服12周为当前项目已确认事实。160 mg BID组每次4片（160÷40=4）加2片安慰剂、80 mg BID组每次2片（80÷40=2）加4片安慰剂、安慰剂组6片的片数推算基于40 mg/片规格及双盲双模拟要求，需药学与临床运营团队确认实际给药方案。紧急揭盲程序和研究结束揭盲安排缺少项目级来源，不得将公司语料中其他项目的IWRS揭盲流程直接迁移为本项目规则。","review_advisories":["本节复述高影响研究设计（盲法与揭盲）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f601cf2900ea_a549ae5361b21ed2","section_number":"4.4","source_ids":["protocol_full_draft_selection:e1b804761f33837da8b3be27","current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:c3e1f164c2e657"]},{"ai_run_id":"airun_20261008211449_8326efac","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"由申办方医学团队提供研究暂停和终止标准草案，明确触发条件、决策主体、恢复条件及终止后随访安排","category":"source_missing","gap_id":"gap_pause_criteria","missing_source_classes":["项目级研究暂停和终止标准文件","安全性监测计划"],"target":"4.7节全文"}],"heading":"研究暂停和终止标准","missing_source_classes":["项目级研究暂停和终止标准文件","申办方安全性监测计划","独立数据安全监查委员会（DSMB）章程（如适用）"],"proposal_text":"","rationale":"本章节需要项目级研究暂停和终止标准，包括暂停或终止的触发条件（如安全性信号、疗效无效性、入组不足等）、决策主体与权限、暂停后恢复条件、终止后受试者随访安排及数据处置。当前允许来源中无对应项目文件，公司语料中亦无该章节内容可参照。不得以通用原则或条件句凑写正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f601cf2900ea_0f0e4f7b58c46000","section_number":"4.7","source_ids":["protocol_full_draft_selection:e1b804761f33837da8b3be27","current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:c3e1f164c2e657"]},{"ai_run_id":"airun_20261008211449_8326efac","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"18-75岁中重度活动性溃疡性结肠炎成人患者（改良Mayo评分5-9分且内镜子评分2-3分）","quote_sha256":"301bc2c4b29f41794c86e04b39cb21ef9c4fc5521e533d013e7db7b9bd70e772","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_05"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"基线前90天及以上确诊溃疡性结肠炎，筛选期结肠镜检查证实活动性病变，改良Mayo评分5-9分且内镜子评分2-3分（中心读片确认）。","quote_sha256":"65c3b2a2d982caedba49bb9b155f16d886bff2f12687a579f066f952d9f7dbbc","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_06"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"对5-ASA、糖皮质激素和/或免疫抑制剂等常规非生物制剂治疗应答不佳、失应答或不耐受；未既往使用过生物制剂或小分子靶向药（探索性亚组除外）。","quote_sha256":"a0da83bd8340b087aa08383e1fbc445fcfb146e4b606373d264e8fa03c0f7a0d","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_07"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"当前诊断为克罗恩病、未定型结肠炎、暴发性结肠炎或中毒性巨结肠。；病变局限于直肠（溃疡性直肠炎），或既往结肠切除术史/计划行肠道手术。；筛选前14天内接受过静脉皮质类固醇治疗，或基线前30天内接受过环孢菌素、他克莫司、吗替麦考酚酯或沙利度胺。；基线前30天内接受过粪便菌群移植或细胞单采治疗；基线前30天内接受过传统中药治疗。","quote_sha256":"16830ded672b74b88e3ca91a939e5f6ce6adf8e1f71e44ae19f467ce31cbb9fc","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_08"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"随机化前糖皮质激素（泼尼松≤20mg/天或等效物）稳定≥2周，和/或5-ASA≥2g/天稳定≥4周，和/或硫唑嘌呤/6-巯基嘌呤稳定≥6周。","quote_sha256":"7ce93db3cda1261cf5069f7123ab34c79d35447a61e1021448b8521f75c21ec2","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_09"}],"evidence_review_advisories":[],"evidence_span_ids":["es_05","es_06","es_07","es_08","es_09"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"由医学团队明确探索性亚组的具体纳入条件（既往生物制剂种类、末次给药距筛选时间窗、是否需额外排除标准）","category":"source_missing","gap_id":"gap_bio_subgroup","missing_source_classes":["探索性亚组纳入标准定义"],"target":"5节探索性纳入既往生物制剂经治亚组"}],"heading":"研究人群","missing_source_classes":["探索性亚组（既往生物制剂经治）具体纳入条件及时间窗定义"],"proposal_text":"本研究的目标人群为18至75岁（含边界）的男性或女性中重度活动性溃疡性结肠炎成人患者。入选受试者须在基线前90天及以上确诊溃疡性结肠炎，筛选期结肠镜检查证实活动性病变，改良Mayo评分5至9分且内镜子评分2至3分，并经中心读片确认。受试者须对5-氨基水杨酸（5-ASA）、糖皮质激素和/或免疫抑制剂等常规非生物制剂治疗应答不佳、失应答或不耐受。本研究以既往未使用过生物制剂或小分子靶向药的初治人群为主，探索性纳入既往生物制剂经治亚组。随机化前，受试者如正在使用糖皮质激素，须泼尼松剂量不超过20 mg/天或等效物且稳定至少2周；如正在使用5-ASA，须剂量不低于2 g/天且稳定至少4周；如正在使用硫唑嘌呤或6-巯基嘌呤，须稳定至少6周。排除标准包括：当前诊断为克罗恩病、未定型结肠炎、暴发性结肠炎或中毒性巨结肠；病变局限于直肠（溃疡性直肠炎）或既往有结肠切除术史或计划行肠道手术；筛选前14天内接受过静脉皮质类固醇治疗，或基线前30天内接受过环孢菌素、他克莫司、吗替麦考酚酯或沙利度胺；基线前30天内接受过粪便菌群移植或细胞单采治疗；基线前30天内接受过传统中药治疗。","rationale":"年龄范围（18-75岁）、疾病诊断标准（中重度活动性UC、改良Mayo评分5-9分、内镜子评分2-3分、中心读片）、既往治疗应答不佳要求、生物制剂初治为主及探索性纳入经治亚组、背景治疗稳定时间（糖皮质激素≥2周、5-ASA≥4周、硫唑嘌呤/6-MP≥6周）及全部排除标准均为当前项目已确认研究事实。探索性纳入既往生物制剂经治亚组的具体纳入条件（如既往生物制剂种类、末次给药距筛选时间窗）未在已确认事实中明确，需医学经理补充确认。","review_advisories":["本节复述高影响研究设计（研究人群）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f601cf2900ea_6a2631295a1b3097","section_number":"5","source_ids":["protocol_full_draft_selection:e1b804761f33837da8b3be27","current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322","company_corpus:cms_cn_protocol_corpus_20260715_v1:c3e1f164c2e657"]}],"source_bindings":[{"content_sha256":"3325087a82064527926f2bd75c67dea3474e6fb9f9fb32775f3a47c015a62baa","locator":"document:mwdoc_greenfield_proj_user_f601cf2900ea_6cd4642ec7a75918:full-draft:e1b804761f33837da8b3be27","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:e1b804761f33837da8b3be27","source_type":"protocol_full_draft_selection","source_version":"full-draft:8e6ddb569ec4349184cb806912f8169639b026a8a873d264792c06e81f0d7fbc:e1b804761f33837da8b3be27","text_sha256":"3325087a82064527926f2bd75c67dea3474e6fb9f9fb32775f3a47c015a62baa"},{"content_sha256":"a539d26ee856caba0acdc48862b75b0b83a7ef4a4f36788e28860269f36639ee","locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","source_type":"current_project_study_definition","source_version":"mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","text_sha256":"a539d26ee856caba0acdc48862b75b0b83a7ef4a4f36788e28860269f36639ee"},{"content_sha256":"561c757e6967fae66f0f9d1043dba3e313bd0ee6