mwdefinition_93770498fcb5c10bff47:revision:6","quote":"筛选访视、基线/D1随机给药（首剂留观2小时）、W2电话随访、W6、W10、W12终点访视（含内镜）、W14安全随访","quote_sha256":"61bf015b33d465d259182edc2145c4d5b162cd124e4b769527d9de6fb68b386b","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es02"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"筛选期：D-28至D-1（4周，含知情同意、入选排除评估、基线检查）；双盲治疗期：D1至D84（12周，随机分组后按组给药并评估疗效与安全性）；安全性随访期：D85至D98（2周，末次给药后安全性随访）","quote_sha256":"5527ade5dc04cb1de25f034fb707bdc4831db28fcf4dccc358802c1733faf360","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es04"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"主要终点：第12周临床缓解率（改良Mayo评分较基线下降≥2分且绝对值≤2分，伴直肠出血子评分0-1分、内镜子评分0-1分）。评价时间：W12中心读片内镜。","quote_sha256":"3a05cd1df6a38738ae3778338a631df8a508fcdc90eab0c9ad773e298922855b","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es05"}],"evidence_review_advisories":[],"evidence_span_ids":["es01","es02","es04","es05"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"需获取项目实验室检查清单，明确各访视（筛选、D1、W2、W6、W10、W12、W14）需实施的检查项目、采集时间窗及异常值处理流程","category":"source_missing","gap_id":"gap_14_2_01","missing_source_classes":["项目级实验室检查项目清单","项目级访视操作手册"],"target":"筛选期及治疗期各访视的完整实验室检查项目清单"},{"action":"需确认安全性随访期是否安排实验室检查及具体项目","category":"source_missing","gap_id":"gap_14_2_02","missing_source_classes":["项目级实验室检查项目清单"],"target":"安全性随访期（D85至D98）的实验室检查安排"}],"heading":"实验室检查项目","missing_source_classes":["项目级实验室检查项目清单（含各访视实施项目、采集时间窗、正常值范围及异常处理流程）","项目级访视操作手册"],"proposal_text":"本章节列明本研究各访视阶段需实施的实验室检查项目及其采集时间窗。根据已确认的访视策略，第6周（W6）和第12周（W12）访视需采集粪便钙卫蛋白与C反应蛋白（CRP）样本，第12周（W12）访视需进行中心读片内镜评估。上述检查的采集时间窗允许±4天偏差。筛选期（D-28至D-1）的基线实验室检查项目、各访视是否常规实施血常规、肝肾功能、凝血功能、尿常规、妊娠试验及心电图等检查，以及安全性随访期（D85至D98）的实验室检查安排，需依据项目实验室检查清单及访视操作手册确定。","rationale":"项目研究事实明确W6/W12行粪钙卫蛋白与CRP检测、W12行中心读片内镜、允许±4天窗口，以及研究时期划分（筛选期D-28至D-1、双盲治疗期D1至D84、安全性随访期D85至D98）。但完整的实验室检查项目清单（如血常规、肝肾功能、凝血、尿常规、妊娠试验、心电图等）及各访视的具体实施安排未在项目来源中给出，不得由访视日推断所有检查在每个访视均实施。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f601cf2900ea_28e61a2422f30cb3","section_number":"14.2","source_ids":["protocol_full_draft_selection:9cad40ef4d3ba4b91b6b2650","current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","company_corpus:cms_cn_protocol_corpus_20260715_v1:semantic_window:6520ebbe09a51d:c0f9d8189ccfc6:85ee0ac32bdcdc:ed8c7e23cb9a85:f4b0433bf35190:c9b1b1d4f3b846","company_corpus:cms_cn_protocol_corpus_20260715_v1:semantic_window:c0f9d8189ccfc6:85ee0ac32bdcdc:ed8c7e23cb9a85:f4b0433bf35190:c9b1b1d4f3b846:e7a96b3314e879"]},{"ai_run_id":"airun_20261008220011_e13bde03","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"需获取本项目安全信息报告途径的完整规程，包括：AE/SAE/SUSAR定义与分级标准、采集时间窗、报告时限（如SAE 24小时内报告）、报告对象（伦理委员会、药监部门、申办方）、报告渠道与格式、SUSAR快速报告流程、研究者与申办方各自职责","category":"source_missing","gap_id":"gap_14_3_01","missing_source_classes":["项目级安全信息报告途径规程","项目级安全性评估操作手册"],"target":"安全信息报告途径章节全文"}],"heading":"安全信息报告途径","missing_source_classes":["项目级安全信息报告途径规程（含AE/SAE/SUSAR定义、采集标准、报告时限、报告对象与渠道、SUSAR快速报告流程、研究者与申办方职责分工）","项目级安全性评估操作手册"],"proposal_text":"","rationale":"本项目研究事实中未包含安全信息报告途径的具体内容。项目来源未定义AE/SAE/SUSAR的采集标准、报告时限、报告对象、报告渠道及快速报告流程。公司语料（CMS-D017 I期方案）的语义窗口仅涉及避孕方法章节，不包含安全信息报告途径内容。项目研究事实中提及安全性随访期（D85至D98）和安全性比较在各平行组间进行，但未涉及安全信息报告的操作规程。","review_advisories":["本节复述高影响研究设计（安全信息报告途径）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f601cf2900ea_8dff11fea3e68a73","section_number":"14.3","source_ids":["protocol_full_draft_selection:9cad40ef4d3ba4b91b6b2650","current_project_study_definition:mwdefinition_93770498fcb5c