5e70b0bc5b3a55e709991ab54941ee36f3a7e04e4d8d776ac74298515efc5ab1","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es03"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"中心模式：多中心","quote_sha256":"2cfa68bc992967c797bbd3113b5e0d0844d660a2050095a31f08358c5e40311f","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es04"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"不设阳性对照（IIa以概念验证与剂量探索为目的）。","quote_sha256":"98519be9cbcdc391904210e0e0a043fcc897769c87373ffb5868b28ed8d73b3b","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es05"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"MY009212A片（VNN1抑制剂，40mg/片薄膜衣片）口服给药；两个活性剂量组：160mg BID（候选RP2D组）与80mg BID（低剂量探索组），连续给药12周；安慰剂组口服相应模拟制剂BID。","quote_sha256":"e8c427811cbdc4968fff531f527edd29c01358e89fa99bd342a4cbde9b4be5c2","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es06"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"研究时期：筛选期：D-28至D-1（4周，含知情同意、入选排除评估、基线检查）；双盲治疗期：D1至D84（12周，随机分组后按组给药并评估疗效与安全性）；安全性随访期：D85至D98（2周，末次给药后安全性随访）","quote_sha256":"51d5a8241e07f61e8fd7d17aa26591df02c4ece7da225184008701c0f6f5f0f8","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es07"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"主要终点：第12周临床缓解率（改良Mayo评分较基线下降≥2分且绝对值≤2分，伴直肠出血子评分0-1分、内镜子评分0-1分）。评价时间：W12中心读片内镜。","quote_sha256":"3a05cd1df6a38738ae3778338a631df8a508fcdc90eab0c9ad773e298922855b","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es08"}],"evidence_review_advisories":[],"evidence_span_ids":["es01","es02","es03","es04","es05","es06","es07","es08"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":8},"gap_items":[],"heading":"研究设计","missing_source_classes":[],"proposal_text":"本研究为一项评估MY009212A片（VNN1抑制剂）治疗中重度活动性溃疡性结肠炎成人患者的II期临床研究，采用固定剂量平行组设计，不采用受试者内剂量递增。研究设两个活性剂量组（160 mg BID候选RP2D组、80 mg BID低剂量探索组）及一个安慰剂对照组，共三个平行组。随机化采用中央随机化系统（IWRS），实施双盲双模拟，安慰剂组口服与MY009212A片外观一致的安慰剂片，每日两次，共12周。研究为多中心设计，不设阳性对照，以概念验证与剂量探索为目的。本研究不计划自适应设计、样本量再估计、期中分析、SRC或DMC。研究时期包括筛选期（D-28至D-1，4周）、双盲治疗期（D1至D84，12周）和安全性随访期（D85至D98，2周）。主要疗效终点为第12周临床缓解率，以改良Mayo评分较基线下降≥2分且绝对值≤2分、伴直肠出血子评分0至1分及内镜子评分0至1分为判定标准，于W12通过中心读片内镜评估。","rationale":"设计事实来源于当前项目已确认研究定义（修订6），包括固定剂量平行组、双盲双模拟、IWRS中央随机化、多中心、无自适应/期中/DMC等。主要终点定义及研究时期划分均有直接来源支持。盲态具体范围（哪些人员设盲）未在已确认事实中逐项列出，需医学经理确认。","review_advisories":["本节复述高影响研究设计（研究设计）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（期中分析、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f601cf2900ea_a59f41d356cf19ad","section_number":"4","source_ids":["protocol_full_draft_selection:bfb09126726cc621c1eeeba8","current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","company_corpus:cms_cn_protocol_corpus_20260715_v1:7450f8d809500d","company_corpus:cms_cn_protocol_corpus_20260715_v1:1b6c27dfbf7041"]},{"ai_run_id":"airun_20261008203028_342555cf","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"固定剂量平行组设计，不采用受试者内剂量递增；IIa期拟设两个活性剂量组（160 mg BID候选RP2D、80 mg BID低剂量组）","quote_sha256":"72d1f58ca9e2e256adf41335454f77dd40e192334b4e852b16b873177d1f2beb","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es01"},{"locator":"study_definition:mwdefinition_93770498fcb5c10