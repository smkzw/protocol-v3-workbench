{"ai_route":{"actual_response_model":"mtplx-flash-next-optimized-speed","ai_run_id":"airun_20261008214643_4d1c8c19","expected_response_model":"mtplx-flash-next-optimized-speed","fallback_chain_id":"aifb_743eb0fc5d5e8947bd8a0ae5","fallback_depth":0,"fallback_reason":"","model":"mtplx-flash-next-optimized-speed","provider":"mtplx","reasoning_effort":"xhigh","route_base_url":"http://127.0.0.1:8002/v1","route_identity_hash":"c9480819205db8521fec70763515cf905334434da194fa8ae2172b40ab545075","route_profile_id":"independent_ai__mtplx_qwen38_local","thinking":"enabled"},"ai_run_id":"airun_20261008214643_4d1c8c19","chunk_index":15,"job_id":"mwjob_7c2e9c5acca95dfb5380703a","precondition_digest":"8e6ddb569ec4349184cb806912f8169639b026a8a873d264792c06e81f0d7fbc","project_id":"proj_user_f601cf2900ea","schema_version":"protocol_full_draft_chunk_v10","section_ids":["mwsec_greenfield_proj_user_f601cf2900ea_5e9e8a65501d10fa","mwsec_greenfield_proj_user_f601cf2900ea_3dadbcade22ffb02","mwsec_greenfield_proj_user_f601cf2900ea_68339b69215a300b","mwsec_greenfield_proj_user_f601cf2900ea_2e966a3e9b444f51"],"sections":[{"ai_run_id":"airun_20261008214643_4d1c8c19","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"筛选访视、基线/D1随机给药（首剂留观2小时）、W2电话随访、W6、W10、W12终点访视（含内镜）、W14安全随访；W6/W12行粪钙卫蛋白与CRP检测；W12行中心读片内镜。允许±4天窗口。","quote_sha256":"9e33723c2fcc3a4332ccd86a6e07c9d74636e71e9bf7a36e5579e6c4e71977d9","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es1"}],"evidence_review_advisories":[],"evidence_span_ids":["es1"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[{"action":"获取本项目EDC系统名称、版本、验证报告及数据录入与核查流程文件","category":"source_missing","gap_id":"gap_10_edc","missing_source_classes":["EDC系统规格与验证文件","数据管理SOP"],"target":"数据采集与管理章节中EDC系统描述"},{"action":"获取各访视（筛选、D1、W2、W6、W10、W12、W14）的完整评估项目列表，明确哪些检查在哪些访视实施","category":"source_missing","gap_id":"gap_10_visit_assessments","missing_source_classes":["访视评估项目清单","实验室检查项目目录"],"target":"数据采集与管理章节中各访视评估项目清单"}],"heading":"数据采集与管理","missing_source_classes":["电子数据采集系统（EDC）规格与验证文件","各访视完整评估项目清单（含实验室检查、生命体征、心电图等逐项列表）","数据管理与数据核查标准操作规程"],"proposal_text":"本研究数据采集覆盖筛选期（D-28至D-1）、双盲治疗期（D1至D84）及安全性随访期（D85至D98）三个阶段。访视安排包括筛选访视、基线/D1随机给药访视（首剂留观2小时）、W2电话随访、W6访视、W10访视、W12终点访视（含内镜）及W14安全随访访视，各访视允许±4天窗口。疗效数据采集以改良Mayo评分（含直肠出血子评分与内镜子评分）为核心，W6与W12采集粪钙卫蛋白及C反应蛋白，W12行中心读片内镜评估。安全性数据采集贯穿全部访视，涵盖不良事件记录、实验室检查及依从性评价（实际服药量/计划服药量×100%，目标80%-120%）。随机化通过中央随机化系统（IWRS）完成，试验药物由申办方统一提供，研究药房按受试者编号发放。数据采集遵循双盲双模拟原则，受试者与研究者均不知晓分组信息。","rationale":"正文依据当前项目已确认研究事实中的访视策略、评估时间点、依从性计算方式及随机化方式撰写。未写入具体EDC系统名称、数据录入与核查流程、各实验室检查项目清单及每个访视的完整评估项目，因允许来源未提供上述实施细节。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f601cf2900ea_5e9e8a65501d10fa","section_number":"10","source_ids":["protocol_full_draft_selection:31cd86283cf28a67f09fd664","current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]},{"ai_run_id":"airun_20261008214643_4d1c8c19","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取本项目CRF设计文件、EDC配置说明及数据录入规范","category":"source_missing","gap_id":"gap_10_1_crf_design","missing_source_classes":["CRF设计文件","EDC配置说明","数据录入SOP"],"target":"病例报告表章节全文"}],"heading":"病例报告表","missing_source_classes":["病例报告表设计文件（含字段清单与逻辑核查规则）","电子数据采集系统（EDC）配置说明","CRF与源文件对应关系表","数据录入与核查标准操作规程"],"proposal_text":"","rationale":"允许来源中未包含本项目病例报告表的设计文件、字段清单、电子或纸质形式选择、CRF与源文件对应关系或数据录入规范。当前项目已确认研究事实仅列出评估终点与访视安排，未涉及CRF结构。公司语料中亦无CRF设计相关条款。无法在不臆造的前提下形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f601cf2900ea_3dadbcade22ffb02","section_number":"10.1","source_ids":["protocol_full_draft_selection:31cd86283cf28a67f09fd664","current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]},{"ai_run_id":"airun_20261008214643_4d1c8c19","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取本项目数据源定义文件、数据流图及SDV计划","category":"source_missing","gap_id":"gap_10_2_data_source_def","missing_source_classes":["数据源定义文件","数据流图","SDV计划"],"target":"数据源的定义章节全文"}],"heading":"数据源的定义","missing_source_classes":["数据源定义文件（含中心实验室、中心读片、IWRS、受试者日记等数据归属与传输路径）","源数据核查（SDV）计划","数据流图或数据架构说明"],"proposal_text":"","rationale":"允许来源中未定义本项目各数据源的归属层级（如中心实验室与中心读片内镜的数据传输路径）、源数据核查方式、IWRS数据与临床数据的关联规则，以及各评估工具（改良Mayo评分、粪钙卫蛋白、CRP）的数据采集层级与责任主体。当前项目已确认研究事实仅列出评估项目与时间点，未涉及数据源定义与传输架构。无法在不臆造的前提下形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f601cf2900ea_68339b69215a300b","section_number":"10.2","source_ids":["protocol_full_draft_selection:31cd86283cf28a67f09fd664","current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]},{"ai_run_id":"airun_20261008214643_4d1c8c19","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:数据质量保证|block:932|chunk:1","quote":"研究中心质量保证人员对数据转移文件、统计报告数据进行抽查，保证数据准确无误。申办者根据需要，结合试验进展情况及质量控制人员/监查员的核查结果，可对上述临床研究过程产生的数据进行不同范畴的稽查。","quote_sha256":"84e30f7a8178b6ecebc4f6b8272c753029708f78a4aea8f02201d0abf4225b0b","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db","span_id":"es4"}],"evidence_review_advisories":[],"evidence_span_ids":["es4"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":0},"gap_items":[{"action":"获取本项目数据质量保证计划，明确稽查频率、监查员核查深度及数据清理时间窗","category":"source_missing","gap_id":"gap_10_3_qa_plan","missing_source_classes":["数据质量保证计划","监查计划"],"target":"数据质量保证章节中稽查频率与核查深度"},{"action":"获取本项目电子数据审计追踪与数据完整性管理文件","category":"source_missing","gap_id":"gap_10_3_audit_trail","missing_source_classes":["数据完整性管理文件","审计追踪规范"],"target":"数据质量保证章节中电子数据审计追踪要求"}],"heading":"数据质量保证","missing_source_classes":["本项目数据质量保证计划（含稽查频率、监查核查深度、数据清理时间窗）","电子数据审计追踪与数据完整性管理文件","数据归档与保存期限规定"],"proposal_text":"本研究数据质量保证体系涵盖研究中心层面与申办者层面两个层级。研究中心质量保证人员对数据转移文件及统计报告数据进行抽查，以保证数据准确无误。申办者根据试验进展情况及质量控制人员与监查员的核查结果，可对临床研究过程产生的数据进行不同范畴的稽查。数据质量保证活动贯穿筛选期、双盲治疗期及安全性随访期全过程，覆盖疗效数据（改良Mayo评分、粪钙卫蛋白、C反应蛋白、中心读片内镜）与安全性数据（不良事件、实验室检查、依从性记录）的采集、录入、核查与归档环节。","rationale":"正文中研究中心层面抽查与申办者层面稽查的表述参照公司语料中数据质量保证条款的措辞结构，该语料为单来源、单申办方参照，仅用于章节结构与监管共性措辞，不构成本项目已确认的质量保证实施规则。具体稽查频率、监查员核查深度、数据清理时间窗及电子数据审计追踪要求等实施细节需医学经理与数据管理部门联合确认。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f601cf2900ea_2e966a3e9b444f51","section_number":"10.3","source_ids":["protocol_full_draft_selection:31cd86283cf28a67f09fd664","current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]}],"source_bindings":[{"content_sha256":"d68e8c8696e47d67d0474348d91c5145c588475329ffc468f8e6c6f5f6884856","locator":"document:mwdoc_greenfield_proj_user_f601cf2900ea_6cd4642ec7a75918:full-draft:31cd86283cf28a67f09fd664","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:31cd86283cf28a67f09fd664","source_type":"protocol_full_draft_selection","source_version":"full-draft:8e6ddb569ec4349184cb806912f8169639b026a8a873d264792c06e81f0d7fbc:31cd86283cf28a67f09fd664","text_sha256":"d68e8c8696e47d67d0474348d91c5145c588475329ffc468f8e6c6f5f6884856"},{"content_sha256":"a539d26ee856caba0acdc48862b75b0b83a7ef4a4f36788e28860269f36639ee","locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","r