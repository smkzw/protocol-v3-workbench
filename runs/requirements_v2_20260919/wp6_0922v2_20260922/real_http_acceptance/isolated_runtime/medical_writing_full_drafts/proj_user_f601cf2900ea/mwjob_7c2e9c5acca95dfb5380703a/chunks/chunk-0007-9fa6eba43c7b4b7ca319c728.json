{"ai_route":{"actual_response_model":"mtplx-flash-next-optimized-speed","ai_run_id":"airun_20261008212344_4e31a7dc","expected_response_model":"mtplx-flash-next-optimized-speed","fallback_chain_id":"aifb_9e6042eaa4e58df379283fb1","fallback_depth":0,"fallback_reason":"","model":"mtplx-flash-next-optimized-speed","provider":"mtplx","reasoning_effort":"xhigh","route_base_url":"http://127.0.0.1:8002/v1","route_identity_hash":"c9480819205db8521fec70763515cf905334434da194fa8ae2172b40ab545075","route_profile_id":"independent_ai__mtplx_qwen38_local","thinking":"enabled"},"ai_run_id":"airun_20261008212344_4e31a7dc","chunk_index":7,"job_id":"mwjob_7c2e9c5acca95dfb5380703a","precondition_digest":"8e6ddb569ec4349184cb806912f8169639b026a8a873d264792c06e81f0d7fbc","project_id":"proj_user_f601cf2900ea","schema_version":"protocol_full_draft_chunk_v10","section_ids":["mwsec_greenfield_proj_user_f601cf2900ea_9faa2fe86ef6cecf","mwsec_greenfield_proj_user_f601cf2900ea_88f5184fb2de98ee","mwsec_greenfield_proj_user_f601cf2900ea_63f978c264a6f865","mwsec_greenfield_proj_user_f601cf2900ea_7bfdce875daa55dc"],"sections":[{"ai_run_id":"airun_20261008212344_4e31a7dc","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"依从性=实际服药量/计划服药量×100%（目标80%-120%）","quote_sha256":"eea0a2d487fd13024527d0541815bb7e18695e5fb1ec8ae89042f88ab909ab01","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_adherence_formula"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"每日两次（BID）、每次一片、约间隔12小时、空腹或餐后均可（与Ib期一致）；试验药物由申办方统一提供，研究药房按受试者编号发放","quote_sha256":"680a1c6917af385a401c584518592f82244327dd7ca8c3a13c0dd68c2213da89","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_dosing_schedule"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"筛选访视、基线/D1随机给药（首剂留观2小时）、W2电话随访、W6、W10、W12终点访视（含内镜）、W14安全随访；W6/W12行粪钙卫蛋白与CRP检测；W12行中心读片内镜。允许±4天窗口。","quote_sha256":"9e33723c2fcc3a4332ccd86a6e07c9d74636e71e9bf7a36e5579e6c4e71977d9","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_visit_strategy"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"试验药物由申办方统一提供，研究药房按受试者编号发放","quote_sha256":"e4352a760a0452bc9df397357599af14a16c86f0d0b4c2f19c53b22c30b78575","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_drug_dispensing"}],"evidence_review_advisories":[],"evidence_span_ids":["es_adherence_formula","es_dosing_schedule","es_visit_strategy","es_drug_dispensing"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"由医学经理确认依从性核查方法（药片计数/电子监测/日记卡）及是否每次访视均执行","category":"source_missing","gap_id":"gap_adh_method","missing_source_classes":["研究中心操作流程文件","依从性评价方法学文件"],"target":"依从性评价具体操作方式及各访视实施频率"}],"heading":"研究治疗依从性","missing_source_classes":["研究中心操作流程文件","依从性评价方法学文件"],"proposal_text":"本研究采用双盲双模拟设计，MY009212A片（40 mg/片薄膜衣片）与外观一致的安慰剂片均按每日两次（BID）、约间隔12小时口服给药，空腹或餐后均可，连续给药12周。试验药物由申办方统一提供，研究药房按受试者编号发放。依从性以实际服药量与计划服药量之比计算，即依从性＝实际服药量/计划服药量×100%，目标范围为80%至120%。双盲治疗期访视安排为：基线/D1随机给药（首剂留观2小时）、W2电话随访、W6访视、W10访视、W12终点访视（含内镜）及W14安全随访访视，各访视允许±4天窗口。依从性核查的具体操作方式及各访视中是否均实施依从性评价，将在研究中心操作手册中规定。","rationale":"依从性公式与目标范围、BID给药方案、双盲双模拟、药物发放方式及访视序列均来源于当前项目已确认研究事实。各访视中依从性评价的具体实施方法（药片计数、电子监测、日记卡等）及是否每次访视均执行，项目来源未明确，需医学经理确认。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f601cf2900ea_9faa2fe86ef6cecf","section_number":"6.5","source_ids":["protocol_full_draft_selection:9fa6eba43c7b4b7ca319c728","current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","company_corpus:cms_cn_protocol_corpus_20260715_v1:176c87031ef7e6","company_corpus:cms_cn_protocol_corpus_20260715_v1:69f36952e02ae0","company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","company_corpus:cms_cn_protocol_corpus_20260715_v1:06652cfb5d7add","company_corpus:cms_cn_protocol_corpus_20260715_v1:79890fa298bcdd"]},{"ai_run_id":"airun_20261008212344_4e31a7dc","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"随机化前糖皮质激素（泼尼松≤20mg/天或等效物）稳定≥2周，和/或5-ASA≥2g/天稳定≥4周，和/或硫唑嘌呤/6-巯基嘌呤稳定≥6周","quote_sha256":"87681fa8b38f58c5d9a28fd8a826f8b35a141094ac3050a4af30c7146b962fcc","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_bg_therapy_stability"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"筛选前14天内接受过静脉皮质类固醇治疗，或基线前30天内接受过环孢菌素、他克莫司、吗替麦考酚酯或沙利度胺。；基线前30天内接受过粪便菌群移植或细胞单采治疗；基线前30天内接受过传统中药治疗","quote_sha256":"17476e9cae993bef89996e4cb01ebbb4109d43ac9a92028544c2ca029a95496d","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_excluded_meds"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"不设阳性对照（IIa以概念验证与剂量探索为目的）","quote_sha256":"29dc5f10bc86840f1fe5fb88017457933171fbe53294038e2a51752bb9336b70","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_no_positive_control"}],"evidence_review_advisories":[],"evidence_span_ids":["es_bg_therapy_stability","es_excluded_meds","es_no_positive_control"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"由医学经理依据IB及Ib期数据确认完整禁限用药清单","category":"source_missing","gap_id":"gap_concomitant_list","missing_source_classes":["MY009212A片研究者手册","Ib期安全性数据"],"target":"研究期间完整的允许与禁止合并用药清单"},{"action":"由医学经理确认合并用药变更审批流程及违规处理措施","category":"source_missing","gap_id":"gap_concomitant_process","missing_source_classes":["项目合并用药管理文件"],"target":"合并用药变更审批流程及禁止用药后处理措施"}],"heading":"合并用药/治疗","missing_source_classes":["MY009212A片研究者手册","Ib期安全性数据","项目合并用药管理文件"],"proposal_text":"本研究为IIa期概念验证与剂量探索研究，不设阳性对照。受试者在随机化前允许继续使用的背景治疗包括：糖皮质激素（泼尼松≤20 mg/天或等效物）稳定≥2周、5-ASA≥2 g/天稳定≥4周、硫唑嘌呤或6-巯基嘌呤稳定≥6周。排除标准中涉及的禁限用药与治疗包括：筛选前14天内接受过静脉皮质类固醇治疗；基线前30天内接受过环孢菌素、他克莫司、吗替麦考酚酯或沙利度胺；基线前30天内接受过粪便菌群移植或细胞单采治疗；基线前30天内接受过传统中药治疗。研究期间合并用药的完整允许与禁止清单、合并用药变更的审批流程、以及使用禁止合并用药后的处理措施，将在MY009212A片研究者手册定稿后依据其安全性数据确定。","rationale":"背景治疗稳定期要求、排除标准中的禁限药物及洗脱期、不设阳性对照均来源于当前项目已确认研究事实。研究期间完整的合并用药允许/禁止清单及变更管理流程尚未由项目文件确认，公司语料中相关表述来自不同适应症和分期方案，仅作为章节结构参照，不可直接作为本项目设计事实。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f601cf2900ea_88f5184fb2de98ee","section_number":"6.6","source_ids":["protocol_full_draft_selection:9fa6eba43c7b4b7ca319c728","current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","company_corpus:cms_cn_protocol_corpus_20260715_v1:176c87031ef7e6","company_corpus:cms_cn_protocol_corpus_20260715_v1:69f36952e02ae0","company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","company_corpus:cms_cn_protocol_corpus_20260715_v1:06652cfb5d7add","company_corpus:cms_cn_protocol_corpus_20260715_v1:79890fa298bcdd"]},{"ai_run_id":"airun_20261008212344_4e31a7dc","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"随机化前糖皮质激素（泼尼松≤20mg/天或等效物）稳定≥2周，和/或5-ASA≥2g/天稳定≥4周，和/或硫唑嘌呤/6-巯基嘌呤稳定≥6周","quote_sha256":"87681fa8b38f58c5d9a28fd8a826f8b35a141094ac3050a4af30c7146b962fcc","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_bg_therapy_stability"},{"locator":"section:既往/合并治疗和洗脱期|block:636|chunk:1","quote":"在随机前，用于其他疾病的合并用药及治疗，如非 3.6.5.3 规定的禁止的合并用药 或治疗，且研究者认为剂量稳定，可以在研究期间继续使用。研究者可根据受试者疾 病情况决定是否停用或加用/换用治疗药物。如加用/换用治疗药物，需注意记录既往病 史变化情况，是否需要记录 AE。","quote_sha256":"59f7e091aaa0fc7fbe0776c27b50433be0c3a716c7cd2d1dab87d5c3ce126cf4","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","span_id":"es_concomitant_stable"},{"locator":"section:既往/合并治疗和洗脱期|block:412|chunk:1","quote":"在随机前，用于其他疾病的合并用药及治疗，如非方案规定的禁止的合并用药或治疗，且研究者认为剂量稳定，可以在研究期间继续使用。研究者可根据试验参与者疾病情况决定是否停用或加用/换用治疗药物。如加用/换用治疗药物，需注意记录既往病史变化情况，是否需要记录AE。","quote_sha256":"0a10b0bde2c08069df5ee6b83624735e817a8c399242debf70912e8e36f0d356","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:06652cfb5d7add","span_id":"es_concomitant_stable2"}],"evidence_review_advisories":[],"evidence_span_ids":["es_bg_therapy_stability","es_concomitant_stable","es_concomitant_stable2"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":1},"gap_items":[{"action":"由医学经理依据IB及非临床数据确认允许合并用药清单","category":"source_missing","gap_id":"gap_allowed_list","missing_source_classes":["MY009212A片研究者手册","非临床安全性数据"],"target":"研究期间允许使用的完整合并用药类别及具体药物名称"}],"heading":"允许的合并用药/治疗","missing_source_classes":["MY009212A片研究者手册","非临床安全性数据","项目合并用药管理文件"],"proposal_text":"本研究允许在随机化前已稳定使用的以下背景治疗在研究期间继续按原剂量使用：糖皮质激素（泼尼松≤20 mg/天或等效物）稳定≥2周、5-ASA≥2 g/天稳定≥4周、硫唑嘌呤或6-巯基嘌呤稳定≥6周。上述背景治疗在研究期间如需调整剂量或停用，应由研究者根据受试者临床状况判断并记录。除上述背景治疗外，用于其他合并疾病的非禁止类合并用药，在研究者判断剂量稳定的前提下可继续使用；如需加用或换用治疗药物，研究者应记录既往病史变化情况并评估是否需记录为不良事件。研究期间允许使用的完整合并用药类别清单及具体药物名称，将在MY009212A片研究者手册定稿后依据其作用机制（VNN1抑制）及非临床安全性数据确定。","rationale":"背景治疗稳定期要求来源于当前项目已确认研究事实。'剂量稳定可继续使用'及'加用/换用需记录'的一般性管理原则参考了公司语料中不同适应症方案的章节结构，但具体到本项目的允许用药清单需由医学经理依据IB确认。公司语料来源为AD II期及I期方案，不可直接迁移其项目事实。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f601cf2900ea_63f978c264a6f865","section_number":"6.6.1","source_ids":["protocol_full_draft_selection:9fa6eba43c7b4b7ca319c728","current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","company_corpus:cms_cn_protocol_corpus_20260715_v1:176c87031ef7e6","company_corpus:cms_cn_protocol_corpus_20260715_v1:69f36952e02ae0","company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","company_corpus:cms_cn_protocol_corpus_20260715_v1:06652cfb5d7add","company_corpus:cms_cn_protocol_corpus_20260715_v1:79890fa298bcdd"]},{"ai_run_id":"airun_20261008212344_4e31a7dc","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"由医学经理依据IB及Ib期数据确认禁止合并用药清单","category":"source_missing","gap_id":"gap_prohibited_list","missing_source_classes":["MY009212A片研究者手册","Ib期安全性数据"],"target":"研究期间禁止使用的完整合并用药/治疗清单"},{"action":"由医学经理确认禁止合并用药后的处理流程","category":"source_missing","gap_id":"gap_prohibited_handling","missing_source_classes":["项目合并用药管理文件"],"target":"使用禁止合并用药后的处理措施（中断/退出/继续随访）"}],"heading":"禁止的合并用药/治疗","missing_source_classes":["MY009212A片研究者手册","项目合并用药管理文件","Ib期安全性数据"],"proposal_text":"","rationale":"排除标准中涉及的禁限药物（静脉皮质类固醇、环孢菌素、他克莫司、吗替麦考酚酯、沙利度胺、粪便菌群移植、细胞单采、传统中药）为筛选期排除条件，不等同于研究期间禁止合并用药清单。研究期间禁止使用的具体药物类别（如生物制剂、JAK抑制剂、其他小分子靶向药等）及禁止合并用药后的处理流程，在当前项目来源中未明确列出。公司语料中'禁止的合并用药/治疗'表结构及'接受禁止合并用药后可能中断治疗或退出研究'的表述分别来自AD II期和I期方案，属于跨适应症、跨分期的结构参照，不可作为本项目临床设计事实。需MY009212A片研究者手册及项目合并用药管理文件方可形成实质正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f601cf2900ea_7bfdce875daa55dc","section_number":"6.6.2","source_ids":["protocol_full_draft_selection:9fa6eba43c7b4b7ca319c728","current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","company_corpus:cms_cn_protocol_corpus_20260715_v1:176c87031ef7e6","company_corpus:cms_cn_protocol_corpus_20260715_v1:69f36952e02ae0","company_corpus:cms_cn_protocol_corpus_20260715_v1:1111caf38b4339","company_corpus:cms_cn_protocol_corpus_20260715_v1:06652cfb5d7add","company_corpus:cms_cn_protocol_corpus_20260715_v1:79890fa298bcdd"]}],"source_bindings":[{"content_sha256":"5a29544446c09f3fdfdda6f7e2d711dd6a0f71a159dd5012c5dcacf4d8f68caa","locator":"document:mwdoc_greenfield_proj_user_f601cf2900ea_6cd