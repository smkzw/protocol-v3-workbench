v1:28e671543798db"]},{"ai_run_id":"airun_20261008215843_46e25af5","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"确认正常完成关闭、提前关闭和暂停的触发条件及各自处理流程","category":"source_missing","gap_id":"gap_closure_trigger","missing_source_classes":["中心关闭SOP"],"target":"研究中心关闭触发条件与流程"},{"action":"确认研究中心文件归档清单、保存期限、电子与纸质文件管理要求","category":"source_missing","gap_id":"gap_file_archival","missing_source_classes":["文件管理SOP"],"target":"文件归档与保存"},{"action":"确认研究中心关闭时剩余试验药物与安慰剂的回收、清点、退回或销毁程序","category":"source_missing","gap_id":"gap_drug_recovery","missing_source_classes":["药物管理SOP"],"target":"剩余药物回收与销毁"}],"heading":"研究和研究中心的关闭","missing_source_classes":["研究中心关闭SOP或关闭条件与流程文件","文件归档与保存要求","试验药物回收与销毁程序","数据库锁定与统计报告交付时限"],"proposal_text":"","rationale":"本章节需要明确研究中心关闭的触发条件（正常完成、提前关闭、暂停）、关闭前程序（末例受试者访视完成、数据清理、数据库锁定）、文件归档要求、剩余试验药物回收与销毁程序、统计报告交付时限及关闭后随访安排。当前允许来源确认研究包含筛选期（D-28至D-1）、双盲治疗期（D1至D84）和安全性随访期（D85至D98），但未提供中心关闭条件、文件归档流程或药物回收程序。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f601cf2900ea_2666db20478725a4","section_number":"12.6","source_ids":["protocol_full_draft_selection:1ee904a9a32742da8d5534d4","current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]},{"ai_run_id":"airun_20261008215843_46e25af5","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:数据质量保证|block:932|chunk:1","quote":"研究中心质量保证人员对数据转移文件、统计报告数据进行抽查，保证数据准确无误。申办者根据需要，结合试验进展情况及质量控制人员/监查员的核查结果，可对上述临床研究过程产生的数据进行不同范畴的稽查。","quote_sha256":"84e30f7a8178b6ecebc4f6b8272c753029708f78a4aea8f02201d0abf4225b0b","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db","span_id":"es4_qa_audit"}],"evidence_review_advisories":[],"evidence_span_ids":["es4_qa_audit"],"evi