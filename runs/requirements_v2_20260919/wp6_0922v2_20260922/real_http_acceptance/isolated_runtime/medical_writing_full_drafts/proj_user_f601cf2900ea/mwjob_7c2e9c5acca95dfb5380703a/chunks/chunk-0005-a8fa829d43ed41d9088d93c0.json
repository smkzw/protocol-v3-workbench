ol_full_draft_selection:a8fa829d43ed41d9088d93c0","current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]},{"ai_run_id":"airun_20261008211841_c27059c0","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"试验干预：MY009212A片（VNN1抑制剂，40mg/片薄膜衣片）口服给药；两个活性剂量组：160mg BID（候选RP2D组）与80mg BID（低剂量探索组），连续给药12周；安慰剂组口服相应模拟制剂BID。","quote_sha256":"a6927b6b0b82262b733c8b2277cda647edc5a2838292550f2d51857d01de9b06","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_study_treatment"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"随机化方式：中央随机化（IWRS）；双盲双模拟。","quote_sha256":"d671c5bda2053d537e35e703279ebea1841ff0a5fc3cf820ee1a1e645ead4a12","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_study_blind"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"总体研究设计：固定剂量平行组设计，不采用受试者内剂量递增；IIa期拟设两个活性剂量组（160 mg BID候选RP2D、80 mg BID低剂量组）","quote_sha256":"df672ea3a79c7fef68aec6a7f12cd00c5ffba1321d4f391569fb37bf58042c34","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_study_design"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"对照：安慰剂对照（双盲双模拟）：安慰剂组为与MY009212A片外观一致的安慰剂片，BID口服共12周；组间比较：主要疗效终点按160mg BID vs 安慰剂、80mg BID vs 安慰剂进行剂量组间比较；安全性比较在各平行组间进行。不设阳性对照（IIa以概念验证与剂量探索为目的）。","quote_sha256":"245b76be135248cc2e6158920832756d9b54eeb2f1a6ef4dc5297f71645bd0bc","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_study_control"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"研究时期：筛选期：D-28至D-1（4周，含知情同意、入选排除评估、基线检查）；双盲治疗期：D1至D84（12周，随机分组后按组给药并评估疗效与安全性）；安全性随访期：D85至D98（2周，末次给药后安全性随访）","quote_sha256":"51d5a8241e07f61e8fd7d17aa26591df02c4ece7da225184008701c0f6f5f0f8","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_study_period"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"内在研究目的：探索剂量-反应关系；较Ib期4周延长疗程至12周；以观察疗效趋势与持久性","quote_sha256":"456a5815befd141be05a3408a4092e97bc1c3c7ac2a8e1a88baa070b64df2b8a","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_study_purpose"}],"evidence_review_advisories":[],"evidence_span_ids":["es_study_treatment","es_study_blind","es_study_design","es_study_control","es_study_period","es_study_purpose"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"确认双盲双模拟中'双'的盲态覆盖范围（受试者、研究者、内镜中心读片者、统计分析人员等），并明确各角色在给药与评估环节的盲态维持方式。","category":"decision_pending","gap_id":"gap_6_blind_scope","missing_source_classes":[],"target":"6 研究治疗/干预"}],"heading":"研究治疗/干预","missing_source_classes":["双盲双模拟中各角色盲态范围的具体界定"],"proposal_text":"本研究采用固定剂量平行组设计，不采用受试者内剂量递增。共设三个治疗组：MY009212A片160 mg每日两次（BID）组（候选RP2D组）、MY009212A片80 mg BID组（低剂量探索组）及安慰剂组。安慰剂组口服与MY009212A片外观一致的安慰剂片，BID给药，疗程同为12周。各组均通过中央随机化系统（IWRS）进行随机分配，采用双盲双模拟方式实施。本研究不设阳性对照，以概念验证与剂量探索为目的。双盲治疗期为D1至D84（12周），随机分组后按组给药并评估疗效与安全性；末次给药后进入D85至D98的安全性随访期（2周）。主要疗效终点按160 mg BID vs 安慰剂、80 mg BID vs 安慰剂进行剂量组间比较，安全性比较在各平行组间进行。","rationale":"干预策略、组别设置、给药方案、盲法方式、治疗期时长及组间比较方式均来源于当前项目已确认研究事实。双盲双模拟中'双'的盲态人员范围（是否涵盖受试者、研究者、内镜评价者、数据监查等）在已确认事实中未逐项列明，需医学经理确认。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f601cf2900ea_8b9fa239bf8455b9","section_number":"6","source_ids":["protocol_full_draft_selection:a8fa829d43ed41d9088d93c0","current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8"]},{"ai_run_id":"airun_20261008211841_c27059c0","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"试验药物：MY009212A片","quote_sha256":"be4bcc113741bde56c67049929cf90a4e84f7e7f7a880f5c03090bd98d4f84c8","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_study_drug"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"剂量与给药方案：MY009212A片：每日两次（BID）、每次一片、约间隔12小时、空腹或餐后均可（与Ib期一致）；试验药物由申办方统一提供，研究药房按受试者编号发放；依从性=实际服药量/计划服药量×100%（目标80%-120%）。","quote_sha256":"2b84b45dca6e1c25f4567616afed7b32252313e823da9cef85a8f939a4afa4f8","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_study_dose"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"对照：安慰剂对照（双盲双模拟）：安慰剂组为与MY009212A片外观一致的安慰剂片，BID口服共12周；组间比较：主要疗效终点按160mg BID vs 安慰剂、80mg BID vs 安慰剂进行剂量组间比较；安全性比较在各平行组间进行。不设阳性对照（IIa以概念验证与剂量探索为目的）。","quote_sha256":"245b76be135248cc2e6158920832756d9b54eeb2f1a6ef4dc5297f71645bd0bc","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_study_control"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"药物技术类型：small_molecule","quote_sha256":"d8ca21a7e62cbca0e65228c7147e2ce5e59273b60f0d0cc55ed216f48e27710c","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_study_tech"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"给药途径：口服","quote_sha256":"404b058b755608a73d13b54521a28c02b129df449774d0671b1c3f8b8a5ce42c","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_study_route"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"剂型：口服固体制剂","quote_sha256":"2c22ee80756bfd178af43cee3c8a0a1b4058aaecb83d264b4107972a334b5bf4","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_study_form"},{"locator":"study_definition:mwdefinition_93770498fcb5c10bff47:revision:6","quote":"局部/系统暴露范围：systemic","quote_sha256":"83a8469236905f60f11fec86f93234f3ddf2027482e82bafa90802a6e138e6e2","source_id":"current_project_study_definition:mwdefinition_93770498fcb5c10bff47:r6:88631defcb8d2380","span_id":"es_study_exposure"}],"evidence_review_advisories":[],"evidence_span_ids":["es_study_drug","es_study_dose","es_study_control","es_study_tech","es_study_route","es_study_form","es_study_exposure"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":7},"gap_items":[{"action":"由药学或供应链团队提供MY009212A片及安慰剂的包装规格、标签模板、储存温度与湿度条件、有效期、运输条件、回收与销毁流程及药物accountability记录方式。","category":"source_missing","gap_id":"gap_6_1_packaging","missing_source_classes":["试验用药品包装储存与发放回收规程"],"target":"6.1 试验用药品"},{"action":"确认安慰剂辅料组成、外观匹配验证报告及双模拟中模拟制剂的具体描述。","category":"source_missing","gap_id":"gap_6_1_placebo","missing_source_classes":["安慰剂辅料组成与外观匹配验证"],"target":"6.1 试验用药品"}],"heading":"试验用药品","missing_source_classes":["试验用药品包装储存与发放回收规程","安慰剂辅料组成与外观匹配验证","药物accountability记录规范"],"proposal_text":"本研究试验用药品为MY009212A片，系VNN1抑制剂，规格为40 mg/片薄膜衣片，属口服固体制剂，给药途径为口服，系统暴露范围为全身性。活性药物组按每日两次（BID）、每次一片、约间隔12小时给药，空腹或餐后均可服用，给药方式与Ib期一致。安慰剂组口服与MY009212A片外观一致的安慰剂片，BID给药共12周。试验药物由申办方统一提供，研究药房按受试者编号发放。依从性评价以实际服药量与计划服药量之比计算，目标范围为80%至120%。","rationale":"药物名称、活性成分类别（VNN1抑制剂）、规格、剂型、给药途径、暴露范围、给药频率与间隔、饮食条件、安慰剂描述、供应与发放方式及依从性计算公式均来源于当前项目已确认研究事实。试验用药品章节尚需补充的内容包括：安慰剂辅料组成与外观匹配验证方法、药物包装规格与标签要求、储存条件与有效期、运输与回收流程、药物accountability记录方式等，这些实施细节在当前允许来源中未提供。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_f601cf2900ea_e500c342e7d195e9","section_number":"6.1","source_ids":["protocol_full_draft_selection:a8fa829d43ed41d9088d93c0","current_project_study_definition:mwdefin