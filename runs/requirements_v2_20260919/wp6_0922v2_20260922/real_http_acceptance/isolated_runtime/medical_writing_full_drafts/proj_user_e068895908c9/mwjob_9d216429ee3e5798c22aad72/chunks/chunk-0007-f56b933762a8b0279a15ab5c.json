review_reasons":[],"section_id":"mwsec_greenfield_proj_user_e068895908c9_2cac07026cf643c6","section_number":"6.4","source_ids":["protocol_full_draft_selection:f56b933762a8b0279a15ab5c","current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a"]},{"ai_run_id":"airun_20260929203515_1eb46c87","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"剂量与给药方案：R2RT-OAB-201（口服β3肾上腺素能受体激动剂缓释片）：40 mg或80 mg口服每日两次（早/晚各一次），整片吞服，不受进餐影响；8周双盲治疗期连续给药；依从性以片剂计数与排尿日记双核对，80%-120%为可评估。","quote_sha256":"b8ce8af039586ae3aa3f619c2d6db6f23f62e5850d990fd5a5784eaf4ef01d56","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"span_dosing_adherence"},{"locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"安慰剂：安慰剂缓释片，外观、气味、包装与试验药一致，口服每日两次，与试验药组同步给药8周。","quote_sha256":"9418e2c920449ed47aaed9c4de6585a0980e06adf5963ebb69605a22c5edc9d0","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"span_placebo_adherence"},{"locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"试验干预：R2RT-OAB-201缓释片口服，每日两次，40mg与80mg两个剂量组，连续8周双盲治疗；以标准背景治疗为基础。","quote_sha256":"b35b1b40f0a82b4ac201602217536079255d77f454eda9d2cdc349cf69eb5bf8","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"span_intervention_adherence"}],"evidence_review_advisories":[],"evidence_span_ids":["span_dosing_adherence","span_placebo_adherence","span_intervention_adherence"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"补充项目药物管理文件中对依从性低于80%或高于120%情形的处理要求，并由医学作者复核后写入本节。","category":"source_missing","gap_id":"gap_6_5_out_of_range","missing_source_classes":["项目药物管理文件中的依从性处理规则","片剂计数与排尿日记双核对记录表单"],"target":"6.5 研究治疗依从性"},{"action":"补充片剂计数与排尿日记双核对的记录表单、核查职责和评价时点要求，并由医学作者复核后写入本节。","category":"source_missing","gap_id":"gap_6_5_recording_review","missing_source_classes":["片剂计数与排尿日记双核对记录表单","监查计划中的依从性核查职责"],"target":"6.5 研究治疗依从性"}],"heading":"研究治疗依从性","missing_source_classes":["项目药物管理文件中的依从性处理规则","片剂计数与排尿日记双核对记录表单","监查计划中的依从性核查职责"],"proposal_text":"R2RT-OAB-201缓释片按40 mg或80 mg口服每日两次（早/晚各一次）给药，整片吞服，不受进餐影响，在8周双盲治疗期内连续给药；安慰剂组接受外观、气味、包装与试验药一致的安慰剂缓释片，口服每日两次，与试验药组同步给药8周。研究治疗依从性以片剂计数与排尿日记双核对，80%-120%为可评估。","rationale":"当前项目研究事实已确认R2RT-OAB-201缓释片40 mg或80 mg口服每日两次、8周双盲连续给药，安慰剂同步给药8周，以及依从性以片剂计数与排尿日记双核对、80%-120%为可评估。医学作者需核对项目药物管理文件，确认超出范围处理、记录表单与核查职责。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_e068895908c9_1fe8c818110d484b","section_number":"6.5","source_ids":["protocol_full_draft_selection:f56b933762a8b0279a15ab5c","current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a"]}],"source_bindings":[{"content_sha256":"14dc98e66e141a75f24cc890fe96f386ead14beb87d52b281b91fe04fa1dbb36","locator":"document:mwdoc_greenfield_proj_user_e068895908c9_4a05ffc7d3f96141:full-draft:f56b933762a8b0279a15ab5c","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:f56b933762a8b0279a15ab5c","source_type":"protocol_full_draft_selection","source_version":"full-draft:d3b18d3c5bc2f2e1d9d8c0eb4f67a10dedd24555da25190a36aa87465b6205da:f56b933762a8b0279a15ab5c","text_sha256":"14dc98e66e141a75f24cc890fe96f386ead14beb87d52b281b91fe04fa1dbb36"},{"content_sha256":"0635eea7669b672f07d424c62f5ada3e697f6bccfa75757cfda10bc04faa81b2","locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","source_type":"current_project_study_definition","source_version":"mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","text_sha256":"0635eea7669b672f07d424c62f5ada3e697f6bccfa75757cfda10bc04faa81b2"}]}