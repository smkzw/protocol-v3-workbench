udy_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"无论是否启用急救抗毒蕈碱药物均纳入分析","quote_sha256":"12a017fc9d62017558ea9dc5044f720dfecf7e05d40b9cc13dc4f3245c1d1038","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"ev_rescue"},{"locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"主要估计目标采用治疗政策策略：以第8周平均每日排尿次数自基线变化为终点，无论是否启用急救抗毒蕈碱药物均纳入分析；人群为FAS（ITT原则）；以基线排尿次数与研究中心为协变量。","quote_sha256":"6b7f4fa914cedd5ae73197b3a1a1d7363a8857df712f93ec2efe41d8c8151ef9","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"ev_estimand"},{"locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"能够停用影响排尿功能的药物并进入2周导入期稳定背景治疗","quote_sha256":"519c03344d056dbf5eb201a41a20bd5505910af2d2cd281865d5474f86b4bb2f","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"ev_drug_stop_runin"}],"evidence_review_advisories":[],"evidence_span_ids":["ev_packet_66","ev_background_therapy","ev_rescue","ev_estimand","ev_drug_stop_runin"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"补充项目级合并用药管理文件，明确允许与禁止药物清单、急救抗毒蕈碱药物使用规定以及合并用药/治疗的记录与审核方式。","category":"source_missing","gap_id":"gap_66_001","missing_source_classes":["项目合并用药管理文件","急救抗毒蕈碱药物使用规定"],"target":"6.6 合并用药/治疗"},{"action":"补充标准背景治疗的具体药物类别、剂量、稳定期要求及研究期间的维持规则。","category":"source_missing","gap_id":"gap_66_002","missing_source_classes":["背景治疗规定","合并用药记录要求"],"target":"6.6 合并用药/治疗"}],"heading":"合并用药/治疗","missing_source_classes":["项目合并用药管理文件","急救抗毒蕈碱药物使用规定","背景治疗规定"],"proposal_text":"本研究在合并用药/治疗方面以维持受试者已稳定的标准背景治疗为原则。筛选期受试者需停用影响排尿功能的药物，并进入2周导入期以稳定背景治疗，导入期结束后方可进入随机化。双盲治疗期内允许使用标准背景治疗和急救抗毒蕈碱药物；主要估计目标采用治疗政策策略，无论受试者是否启用急救抗毒蕈碱药物，均纳入FAS主要分析。","rationale":"正文依据已确认的标准背景治疗、急救抗毒蕈碱药物以及筛选期停用影响排尿功能药物并进入2周导入期的要求撰写；具体允许和禁止药物清单、急救用药使用规定及记录方式需医学经理依据项目文件核实。","review_advisories":["本节提及高影响设计信息（估计目标）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_e068895908c9_aaadf5863679d4cc","section_number":"6.6","source_ids":["protocol_full_draft_selection:83264bdcbf014510db6adc58","current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a"]},{"ai_run_id":"airun_20260929210158_aa54be11","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_e068895908c9_4a05ffc7d3f96141:full-draft:83264bdcbf014510db6adc58","quote":"SECTION_ID=mwsec_greenfield_proj_user_e068895908c9_09a3ec04cf29baa5\n章节编号=6.6.1\n章节标题=允许的合并用药/治疗","quote_sha256":"eefe982913fedb18a6ed1c0bbdc6b5577e7d6474fc0059964369333e419fa677","source_id":"protocol_full_draft_selection:83264bdcbf014510db6adc58","span_id":"ev_packet_661"},{"locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"R2RT-OAB-201缓释片口服，每日两次，40mg与80mg两个剂量组，连续8周双盲治疗；以标准背景治疗为基础。","quote_sha256":"067cfe1c19e6c11f084a3168ad9a8ca0524024c46f784796ffa79d0273e1465d","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"ev_background_therapy"},{"locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"无论是否启用急救抗毒蕈碱药物均纳入分析","quote_sha256":"12a017fc9d62017558ea9dc5044f720dfecf7e05d40b9cc13dc4f3245c1d1038","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"ev_rescue"},{"locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"主要估计目标采用治疗政策策略：以第8周平均每日排尿次数自基线变化为终点，无论是否启用急救抗毒蕈碱药物均纳入分析；人群为FAS（ITT原则）；以基线排尿次数与研究中心为协变量。","quote_sha256":"6b7f4fa914cedd5ae73197b3a1a1d7363a8857df712f93ec2efe41d8c8151ef9","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"ev_estimand"},{"locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"能够停用影响排尿功能的药物并进入2周导入期稳定背景治疗","quote_sha256":"519c03344d056dbf5eb201a41a20bd5505910af2d2cd281865d5474f86b4bb2f","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"ev_drug_stop_runin"}],"evidence_review_advisories":[],"evidence_span_ids":["ev_packet_661","ev_background_therapy","ev_rescue","ev_estimand","ev_drug_stop_runin"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"补充允许使用的背景治疗药物清单，以及急救抗毒蕈碱药物的品种、剂量、给药频次和使用时机。","category":"source_missing","gap_id":"gap_661_001","missing_source_classes":["允许合并用药清单","急救用药使用规定"],"target":"6.6.1 允许的合并用药/治疗"},{"action":"明确允许合并用药/治疗的记录方式与依从性核对要求。","category":"source_missing","gap_id":"gap_661_002","missing_source_classes":["合并用药记录要求"],"target":"6.6.1 允许的合并用药/治疗"}],"heading":"允许的合并用药/治疗","missing_source_classes":["允许合并用药清单","急救用药使用规定","合并用药记录要求"],"proposal_text":"本研究以标准背景治疗为基础，允许受试者在双盲治疗期内维持稳定的背景治疗。研究设计中包含急救抗毒蕈碱药物，主要估计目标规定无论受试者是否启用急救抗毒蕈碱药物，均纳入FAS主要分析，表明急救抗毒蕈碱药物可在研究期间使用。筛选期受试者需停用影响排尿功能的药物，并进入2周导入期以稳定背景治疗，背景治疗稳定后进入随机化。","rationale":"正文写入已确认的背景治疗和急救抗毒蕈碱药物可使用性，以及筛选期停药进入2周导入期的要求；背景治疗药物类别和急救抗毒蕈碱药物的品种、剂量、频次及使用时机需补充项目文件后确定。","review_advisories":["本节提及高影响设计信息（估计目标）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_e068895908c9_09a3ec04cf29baa5","section_number":"6.6.1","source_ids":["protocol_full_draft_selection:83264bdcbf014510db6adc58","current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a"]},{"ai_run_id":"airun_20260929210158_aa54be11","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_e068895908c9_4a05ffc7d3f96141:full-draft:83264bdcbf014510db6adc58","quote":"SECTION_ID=mwsec_greenfield_proj_user_e068895908c9_659fc6cbd9d858d5\n章节编号=6.6.2\n章节标题=禁止的合并用药/治疗","quote_sha256":"a1bebf8719c558e2ead7adab3f355373a02c9f3323432db4406b17f850aacefa","source_id":"protocol_full_draft_selection:83264bdcbf014510db6adc58","span_id":"ev_packet_662"},{"locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"能够停用影响排尿功能的药物并进入2周导入期稳定背景治疗","quote_sha256":"519c03344d056dbf5eb201a41a20bd5505910af2d2cd281865d5474f86b4bb2f","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"ev_drug_stop_runin"},{"locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"近3个月内膀胱肉毒毒素注射或膀胱灌注治疗","quote_sha256":"e78a685c70982531d1ca5a625d7034bbc5b25281637407b2607e8e12c0313c95","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"ev_botulinum"}],"evidence_review_advisories":[],"evidence_span_ids":["ev_packet_662","ev_drug_stop_runin","ev_botulinum"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"补充禁止使用的药物类别、洗脱期以及研究期间停用或替代处理规定。","category":"source_missing","gap_id":"gap_662_001","missing_source_classes":["禁止合并用药清单","洗脱与停药处理规定"],"target":"6.6.2 禁止的合并用药/治疗"},{"action":"明确膀胱肉毒毒素注射和膀胱灌注治疗的时间界定，以及研究期间同类治疗的禁止要求。","category":"source_missing","gap_id":"gap_662_002","missing_source_classes":["排除标准实施细则"],"target":"6.6.2 禁止的合并用药/治疗"}],"heading":"禁止的合并用药/治疗","missing_source_classes":["禁止合并用药清单","洗脱与停药处理规定","排除标准实施细则"],"proposal_text":"本研究的排除标准明确规定，近3个月内接受过膀胱肉毒毒素注射或膀胱灌注治疗的受试者不得入选；入选标准同时要求受试者能够停用影响排尿功能的药物并进入2周导入期以稳定背景治疗。据此，在筛选期及导入期内，影响排尿功能的药物应处于停用状态，受试者以稳定的背景治疗进入随机化。上述禁限要求适用于研究入选和导入阶段，以保障背景治疗稳定和主要终点评价的可靠性。","rationale":"正文依据排除标准中近3个月膀胱肉毒毒素注射或膀胱灌注治疗，以及入选标准中停用影响排尿功能药物并进入2周导入期的要求撰写；具体禁止药物类别、洗脱期和研究期间处理方式需依据项目合并用药管理文件确认。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_e068895908c9_659fc6cbd9d858d5","section_number":"6.6.2","source_ids":["protocol_full_draft_selection:83264bdcbf014510db6adc58","current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a"]},{"ai_run_id":"airun_20260929210158_aa54be11","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_e068895908c9_4a05ffc7d3f96141:full-draft:83264bdcbf014510db6adc58","quote":"SECTION_ID=mwsec_greenfield_proj_user_e068895908c9_aaa39f86167331ed\n章节编号=7\n章节标题=研究程序和评估","quote_sha256":"b487b68f91917c6d1c3dab810b92a3706487a3bd306055ceb4ba0c55533a1185","source_id":"protocol_full_draft_selection:83264bdcbf014510db6adc58","span_id":"ev_packet_7"},{"locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"筛选期≤2周；8周双盲治疗期；2周治疗结束后安全性随访期","quote_sha256":"1390ad707b2ecc1495ffe409a74ff1aeb75c3a2fab22524adad2c133a288cdc3","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"ev_periods"},{"locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"筛选（-14至-1天）\n基线/V1（第1天，随机化与基线排尿日记核对）\nV2（第4周，疗效与安全性评估）\nV3/EOT（第8周，主要终点评估）\n随访（第10周，安全性随访）","quote_sha256":"284149d3dc42112a6b97884a50f25eb2e99d74c6ebdffe9e65f858fb14cc05de","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"ev_visits"},{"locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"能够停用影响排尿功能的药物并进入2周导入期稳定背景治疗","quote_sha256":"519c03344d056dbf5eb201a41a20bd5505910af2d2cd281865d5474f86b4bb2f","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"ev_drug_stop_runin"},{"locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"40 mg或80 mg口服每日两次（早/晚各一次），整片吞服，不受进餐影响；8周双盲治疗期连续给药；依从性以片剂计数与排尿日记双核对，80%-120%为可评估。","quote_sha256":"9e256adca7c6eea4a40b42022fb22dcedf4a4ab80de2ad8e710c066c886a99ff","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"ev_dosing"},{"locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"安慰剂缓释片，外观、气味、包装与试验药一致，口服每日两次，与试验药组同步给药8周。","quote_sha256":"c7cedeed33f71dda8191f1cb08da0d2a18997f2923d104f19c6e166bcc8a94e3","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"ev_placebo"},{"locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"第8周运动前后排尿日记记录的平均每日排尿次数自基线的变化（评价时间：第8周治疗期末，以第6-8周日均值计算）","quote_sha256":"fac93e9aa565036e15338fbe0129be540ded16cf880ce0fae12cd941a966608c","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"ev_primary"},{"locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"每周急迫性尿失禁次数自基线的变化（第4、8周）；3天排尿日记平均单次排尿量变化；患者膀胱过动症状评分（OAB-q）简表变化；治疗应答率（TGTF应答定义）","quote_sha256":"405b0e22694746e3bc558016654edbdab88d423862a000a531322aeb74564238","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"ev_secondary"},{"locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"TEAE发生率与严重程度（全治疗期随访）；生命体征与体重（每次访视）；12导联心电图与QTc（基线、第4周、第8周）；临床实验室检查（血常规、血生化、尿常规，基线与第8周）；残余尿量（B超，基线与第8周）","quote_sha256":"db47e0a82a37a6d16a5cf1825c69635e4e7d85f6f5de857b34ce9fd8b53789f4","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"ev_safety"},{"locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"符合OAB诊断（尿急伴平均每日排尿≥8次和/或急迫性尿失禁≥3次/72h，3天排尿日记确认）","quote_sha256":"a7fb3d9774872a21f54a6f59caf10e178823207214da64e7239c32e3c1043cb9","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"ev_diary"},{"locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"主要估计目标采用治疗政策策略：以第8周平均每日排尿次数自基线变化为终点，无论是否启用急救抗毒蕈碱药物均纳入分析；人群为FAS（ITT原则）；以基线排尿次数与研究中心为协变量。","quote_sha256":"6b7f4fa914cedd5ae73197b3a1a1d7363a8857df712f93ec2efe41d8c8151ef9","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"ev_estimand"}],"evidence_review_advisories":[],"evidence_span_ids":["ev_packet_7","ev_periods","ev_visits","ev_drug_stop_runin","ev_dosing","ev_placebo","ev_primary","ev_secondary","ev_safety","ev_diary","ev_estimand"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":10},"gap_items":[{"action":"补充研究药物包装、储存、发放、回收与清点程序。","category":"source_missing","gap_id":"gap_7_001","missing_source_classes":["试验药供应与管理文件"],"target":"7 研究程序和评估"},{"action":"补充剂量调整、暂停、恢复和永久停药标准与处理流程。","category":"source_missing","gap_id":"gap_7_002","missing_source_classes":["剂量调整与停药管理文件"],"target":"7 研究程序和评估"},{"action":"补充计划外访视、访视窗口及缺失访视的处理规则。","category":"source_missing","gap_id":"gap_7_003","missing_source_classes":["访视管理文件"],"target":"7 研究程序和评估"},{"action":"确认关键次要终点中第12周维持期复评与现有第8周治疗期末、第10周安全性随访的关系，并统一访视安排。","category":"decision_pending","gap_id":"gap_7_004","missing_source_classes":[],"target":"7 研究程序和评估 / 关键次要终点评价时点"},{"action":"补充AE/SAE/SUSAR定义、采集与报告要求，以及研究药物具体风险信息。","category":"source_missing","gap_id":"gap_7_005","missing_source_classes":["安全性报告文件","研究者手册或研究药物风险资料"],"target":"7 研究程序和评估 / 安全性报告"},{"action":"补充尿动力学或症状问卷诊断确认流程，以及3天排尿日记的培训、发放与回收要求。","category":"source_missing","gap_id":"gap_7_006","missing_source_classes":["诊断确认与日记培训文件"],"target":"7 研究程序和评估 / 筛选与日记"},{"action":"明确研究结束时点、受试者完成或退出标准及相应处理程序。","category":"source_missing","gap_id":"gap_7_007","missing_source_classes":["研究结束与退出管理文件"],"target":"7 研究程序和评估 / 研究结束"}],"heading":"研究程序和评估","missing_source_classes":["试验药供应与管理文件","剂量调整与停药管理文件","访视管理文件","安全性报告文件"],"proposal_text":"本研究包括筛选期（≤2周）、8周双盲治疗期和2周治疗结束后安全性随访期。筛选期于-14至-1天进行，受试者在此期间停用影响排尿功能的药物并进入2周导入期稳定背景治疗，完成3天排尿日记以确认尿急伴平均每日排尿≥8次和/或急迫性尿失禁≥3次/72h，并通过尿动力学或症状问卷确认膀胱过度活动症诊断。基线/V1为第1天，完成随机化与基线排尿日记核对。随机化后，R2RT-OAB-201缓释片按40 mg或80 mg口服，每日两次（早/晚各一次），整片吞服，不受进餐影响，连续给药8周；安慰剂组接受外观、气味、包装与试验药一致、口服每日两次的安慰剂缓释片，与试验药组同步给药8周。V2为第4周，进行疗效与安全性评估；V3/EOT为第8周，进行主要终点评估，主要终点为第8周治疗期末以第6-8周日均值计算的平均每日排尿次数自基线变化。关键次要终点包括每周急迫性尿失禁次数自基线变化（第4、8周）、3天排尿日记平均单次排尿量变化、患者膀胱过动症状评分（OAB-q）简表变化及治疗应答率（TGTF应答定义）。安全性评估包括TEAE发生率与严重程度（全治疗期随访）、生命体征与体重（每次访视）、12导联心电图与QTc（基线、第4周、第8周）、临床实验室检查（血常规、血生化、尿常规，基线与第8周）以及残余尿量（B超，基线与第8周）。随访为第10周，进行安全性随访。依从性以片剂计数与排尿日记双核对，80%-120%为可评估。主要估计目标采用治疗政策策略，无论是否启用急救抗毒蕈碱药物均纳入FAS主要分析，以基线排尿次数与研究中心为协变量。","rationale":"正文写入已确认的研究时期、访视节点、给药方案、主要与关键次要终点评价时点及安全性评估安排；第12周复评与访视策略不一致处未写入正文，研究药物供应、剂量调整、计划外访视、安全性报告定义和研究结束程序等待确认。","review_advisories":["本节提及高影响设计信息（主要终点、估计目标）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_e068895908c9_aaa39f86167331ed","section_number":"7","source_ids":["protocol_full_draft_selection:83264bdcbf014510db6adc58","current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a"]}],"source_bindings":[{"content_sha256":"eacfebb2cfd12e7f35f40ef1ce82fc51695197c39437a81ea5ea9ef3bf197162","locator":"document:mwdoc_greenfield_proj_user_e068895908c9_4a05ffc7d3f96141:full-draft:83264bdcbf014510db6adc58","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:83264bdcbf014510db6adc58","source_type":"protocol_full_draft_selection","source_version":"full-draft:d3b18d3c5bc2f2e1d9d8c0eb4f67a10dedd24555da25190a36aa87465b6205da:83264bdcbf014510db6adc58","text_sha256":"eacfebb2cfd12e7f35f40ef1ce82fc51695197c39437a81ea5ea9ef3bf197162"},{"content_sha256":"0635eea7669b672f07d424c62f5ada3e697f6bccfa75757cfda10bc04faa81b2","locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","source_type":"current_project_study_definition","source_version":"mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","text_sha256":"0635eea7669b672f07d424c62f5ada3e697f6bccfa75757cfda10bc04faa81b2"}]}