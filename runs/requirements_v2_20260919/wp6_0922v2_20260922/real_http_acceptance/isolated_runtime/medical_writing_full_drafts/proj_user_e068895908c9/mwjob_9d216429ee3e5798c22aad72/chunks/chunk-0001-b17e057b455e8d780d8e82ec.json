01缓释片口服，每日两次，40mg与80mg两个剂量组，连续8周双盲治疗；以标准背景治疗为基础。","quote_sha256":"b35b1b40f0a82b4ac201602217536079255d77f454eda9d2cdc349cf69eb5bf8","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"ES-014"},{"locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"剂量与给药方案：R2RT-OAB-201（口服β3肾上腺素能受体激动剂缓释片）：40 mg或80 mg口服每日两次（早/晚各一次），整片吞服，不受进餐影响；8周双盲治疗期连续给药；依从性以片剂计数与排尿日记双核对，80%-120%为可评估。","quote_sha256":"b8ce8af039586ae3aa3f619c2d6db6f23f62e5850d990fd5a5784eaf4ef01d56","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"ES-015"},{"locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"安慰剂：安慰剂缓释片，外观、气味、包装与试验药一致，口服每日两次，与试验药组同步给药8周。","quote_sha256":"9418e2c920449ed47aaed9c4de6585a0980e06adf5963ebb69605a22c5edc9d0","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"ES-016"}],"evidence_review_advisories":[],"evidence_span_ids":["ES-003","ES-005","ES-009","ES-010","ES-014","ES-015","ES-016"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"取得研究者手册或非临床药理学资料后补充作用机制与药效学描述","category":"source_missing","gap_id":"gap_s3_001","missing_source_classes":["研究者手册（IB）","非临床药理学与毒理学资料"],"target":"研究药物简介——作用机制与药效学"},{"action":"取得药学研究与制剂特性资料后补充","category":"source_missing","gap_id":"gap_s3_002","missing_source_classes":["药学研究（CMC）资料"],"target":"研究药物简介——药学研究与制剂特性"},{"action":"取得既往临床研究资料后补充人体安全性、有效性及药代动力学信息","category":"source_missing","gap_id":"gap_s3_003","missing_source_classes":["既往临床研究资料及研究药物风险信息项目文件"],"target":"研究药物简介——既往人体研究经验"},{"action":"取得研究药物风险信息项目文件后补充","category":"source_missing","gap_id":"gap_s3_004","missing_source_classes":["既往临床研究资料及研究药物风险信息项目文件"],"target":"研究药物简介——研究药物风险与风险管理"}],"heading":"研究药物简介","missing_source_classes":["研究者手册（IB）","非临床药理学与毒理学资料","药学研究（CMC）资料","既往临床研究资料及研究药物风险信息项目文件"],"proposal_text":"R2RT-OAB-201为小分子口服β3肾上腺素能受体激动剂缓释片，给药途径为口服，剂型为口服固体制剂，暴露范围为全身性。在膀胱过度活动症（OAB）II期临床研究中，该药设置40mg与80mg两个剂量组，给药方案为40 mg或80 mg口服每日两次（早/晚各一次），整片吞服，不受进餐影响，于8周双盲治疗期连续给药，并以标准背景治疗为基础；依从性以片剂计数与排尿日记双核对，80%-120%为可评估。安慰剂为外观、气味、包装与试验药一致的缓释片，口服每日两次，与试验药组同步给药8周。","rationale":"已确认信息包括药物名称、β3肾上腺素能受体激动剂类别、口服缓释片剂型、口服给药途径、全身暴露、40mg与80mg每日两次给药方案、8周连续给药、整片吞服及不受进餐影响、依从性核对标准以及匹配安慰剂特征；作用机制细节、药学研究、非临床与既往人体研究信息缺失，需医学作者补充来源后完善。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_e068895908c9_df2f964c453d410f","section_number":"2.3","source_ids":["protocol_full_draft_selection:b17e057b455e8d780d8e82ec","current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:76a6125fa7dca4","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc6f8c9ea6d34b"]},{"ai_run_id":"airun_20260929183859_a61d082e","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"取得非临床药理学与药效学研究资料后撰写","category":"source_missing","gap_id":"gap_s4_001","missing_source_classes":["非临床药理学与药效学资料"],"target":"非临床研究结果章节正文"},{"action":"取得非临床毒理学研究资料后撰写","category":"source_missing","gap_id":"gap_s4_002","missing_source_classes":["非临床毒理学资料"],"target":"非临床研究结果章节正文"},{"action":"取得非临床药代动力学研究资料或研究者手册非临床章节后撰写","category":"source_missing","gap_id":"gap_s4_003","missing_source_classes":["非临床药代动力学资料","研究者手册（IB）非临床章节"],"target":"非临床研究结果章节正文"}],"heading":"非临床研究结果","missing_source_classes":["非临床药理学与药效学资料","非临床毒理学资料","非临床药代动力学资料","研究者手册（IB）非临床章节"],"proposal_text":"","rationale":"现有资料仅可确认药物名称、β3肾上腺素能受体激动剂类别、口服缓释片剂型及小分子、全身暴露等技术特征，未提供任何非临床药理、毒理或药代研究结果，尚不能形成实质正文，需取得非临床资料后撰写。","review_advisories":[],