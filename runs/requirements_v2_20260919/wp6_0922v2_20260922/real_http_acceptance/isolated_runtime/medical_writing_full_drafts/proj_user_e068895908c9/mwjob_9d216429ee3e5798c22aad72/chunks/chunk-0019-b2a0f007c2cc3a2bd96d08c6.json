dc336b327d8116b62330e446365c505f50110feaaba1462","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"ev_project_design"}],"evidence_review_advisories":[],"evidence_span_ids":["ev_sec_audit","ev_confid_corpus","ev_project_design"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":1},"gap_items":[{"action":"获取本项目稽查计划和监查计划后补充项目级稽查和监查安排","category":"source_missing","gap_id":"gap_audit_plan","missing_source_classes":["稽查计划","监查计划"],"target":"12.3 稽查和核查"},{"action":"获取监管核查应对程序或相关质量管理文件后补充核查配合要求","category":"source_missing","gap_id":"gap_inspection_procedure","missing_source_classes":["质量管理体系文件","监管核查程序"],"target":"12.3 稽查和核查"}],"heading":"稽查和核查","missing_source_classes":["稽查计划","监查计划","质量管理体系文件","监管核查程序"],"proposal_text":"本研究的实施、记录和报告应接受稽查和核查。稽查和核查旨在确认研究是否按照经伦理委员会批准的方案、药物临床试验质量管理规范及适用法律法规实施，确认受试者的安全和权益得到保护，并确认研究数据真实、完整、可溯源。研究者和研究中心应在符合受试者隐私保护及机构保密要求的前提下，为稽查员、核查人员及伦理委员会提供源文件、病例报告表、试验用药品记录、知情同意文件及其他相关研究文件，并配合必要的现场访问、询问和记录核对。研究方案及相关信息仅向研究者、合作研究者、伦理委员会和监督管理部门等相关机构提供审阅。对稽查或核查中发现的问题，应按照适用法规、药物临床试验质量管理规范和研究机构的管理程序进行记录、评估、沟通和整改，相关记录应保存至适用法规要求的期限。","rationale":"本节依据研究为多中心设计以及研究信息向伦理委员会和监管管理部门审阅的保密范围等已确认信息撰写；稽查计划、监查计划和监管核查应对程序尚未提供，医学作者需核对并补充项目级质量管理安排。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_e068895908c9_11693f2ada300922","section_number":"12.3","source_ids":["protocol_full_draft_selection:b2a0f007c2cc3a2bd96d08c6","current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20260930002752_741eab91","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_e068895908c9_4a05ffc7d3f96141:full-draft:b2a0f007c2cc3a2bd96d08c6","quote":"章节编号=12.4\n章节标题=方案偏离","quote_sha256":"8f72e98b8bad2324c18230e4d95d96a9c9d8849b8017540e5eb1f12189a1e3b6","source_id":"protocol_full_draft_selection:b2a0f007c2cc3a2bd96d08c6","span_id":"ev_sec_dev"},{"locator":"section:12.2 方案偏离|block:952|chunk:1","quote":"申办者将审查所有方案偏离，并评估是否有严重违背GCP，以及是否要求向卫生主管部门报告。根据申办者的要求或SOP，偏离方案的前瞻性请求，包括放弃方案合格性标准的请求将不会被允许。","quote_sha256":"643056aa94c1285201b5f63d6801971893fb90935354b44c77e0839ffc32b390","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","span_id":"ev_dev_corpus"}],"evidence_review_advisories":[],"evidence_span_ids":["ev_sec_dev","ev_dev_corpus"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":0},"gap_items":[{"action":"获取本项目方案偏离管理计划和报告表后补充报告流程","category":"source_missing","gap_id":"gap_deviation_reporting","missing_source_classes":["方案偏离管理计划","方案偏离报告表"],"target":"12.4 方案偏离"},{"action":"获取方案偏离报告时限和职责分工文件后补充相关要求","category":"source_missing","gap_id":"gap_deviation_timeline","missing_source_classes":["报告时限要求","职责分工文件"],"target":"12.4 方案偏离"}],"heading":"方案偏离","missing_source_classes":["方案偏离管理计划","方案偏离报告表","报告时限要求","职责分工文件"],"proposal_text":"方案偏离是指任何未按照经伦理委员会批准的方案、药物临床试验质量管理规范或适用法律法规执行的情况。研究者及其授权人员应及时识别、记录和报告方案偏离，说明偏离发生的时间、原因、涉及受试者以及所采取的措施。申办者应审查所有方案偏离，并评估偏离对受试者安全和权益、研究数据完整性以及研究总体科学性的影响，判断是否构成严重违背GCP以及是否需要向卫生主管部门报告。根据申办者的要求或标准操作程序，偏离方案的前瞻性请求，包括放弃方案合格性标准的请求，将不会被允许。对于已发生的方案偏离，应根据其性质和严重程度采取相应的纠正和预防措施，并按照研究机构和伦理委员会的要求进行记录和报告。","rationale":"本节依据方案偏离审查、GCP违背评估和监管报告评估的结构性要求撰写；本项目方案偏离的报告时限、表格和职责分工尚未提供，医学作者需核对项目级偏离管理程序。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_e068895908c9_cc35471e363aa4dd","section_number":"12.4","source_ids":["protocol_full_draft_selection:b2a0f007c2cc3a2bd96d08c6","current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20260930002752_741eab91","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_e068895908c9_4a05ffc7d3f96141:full-draft:b2a0f007c2cc3a2bd96d08c6","quote":"章节编号=12.5\n章节标题=关键角色和研究管理","quote_sha256":"1ef630ff0f7b947d76f8e1d0c4235021137b3e8f82ee82590660f46f06502bed","source_id":"protocol_full_draft_selection:b2a0f007c2cc3a2bd96d08c6","span_id":"ev_sec_roles"},{"locator":"section:12.4 管理结构|block:957|chunk:1","quote":"申办者或其代理人将执行项目管理、研究管理、监查、供应商管理和统计编程。","quote_sha256":"5834095b23bbc6d48489fa3422974312fd017a35e751e85cb64acbf9efdf593c","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","span_id":"ev_mgmt_corpus"},{"locator":"study_definition:mwdefinition_819d27514610a49ffa96:revision:5","quote":"总体研究设计：多中心、随机、双盲、安慰剂平行对照","quote_sha256":"66366de8bec32d970dc336b327d8116b62330e446365c505f50110feaaba1462","source_id":"current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","span_id":"ev_project_design"}],"evidence_review_advisories":[],"evidence_span_ids":["ev_sec_roles","ev_mgmt_corpus","ev_project_design"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":1},"gap_items":[{"action":"获取本项目授权分工表后补充关键角色与授权范围","category":"source_missing","gap_id":"gap_roles_authorization","missing_source_classes":["授权分工表"],"target":"12.5 关键角色和研究管理"},{"action":"获取监查计划、数据管理计划和培训记录后补充研究管理安排","category":"source_missing","gap_id":"gap_monitoring_data","missing_source_classes":["监查计划","数据管理计划","培训记录"],"target":"12.5 关键角色和研究管理"}],"heading":"关键角色和研究管理","missing_source_classes":["授权分工表","监查计划","数据管理计划","培训记录"],"proposal_text":"本研究为多中心临床研究，研究管理涉及项目管理、研究管理、监查、供应商管理和统计编程等职能。上述职能应按照方案、药物临床试验质量管理规范及适用法规运行，并在项目研究管理文件中明确承担方、职责边界和授权关系。各研究中心应按照方案和授权分工开展研究活动，研究者和研究机构应明确关键角色的职责与授权范围，并保证参与研究的人员接受方案、GCP和职责相关培训。研究过程中形成的源文件、病例报告表和其他研究记录应真实、准确、完整、可溯源；研究中心应妥善保存本机构产生的源文件，并按照数据管理要求及时、完整地提交研究数据。对方案偏离、安全性信息、数据疑问和其他研究管理问题，应建立清晰的沟通和问题升级路径，以保证其得到及时处理。","rationale":"本节依据研究管理职能的通用结构及研究为多中心设计的事实撰写；授权分工表、监查计划、数据管理计划和培训记录尚未提供，医学作者需核对项目级研究管理文件。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_e068895908c9_ce125a0f6f3192ea","section_number":"12.5","source_ids":["protocol_full_draft_selection:b2a0f007c2cc3a2bd96d08c6","current_project_study_definition:mwdefinition_819d27514610a49ffa96:r5:e7d77be2f0e0393a","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20260930002752_741eab91","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取本项目研究关闭和研究中心关闭程序后补写","category":"source_missing","gap_id":"gap_closeout_procedure","missing_source_classes":["研究中心关闭程序","研究终止和暂停管理程序"],"target":"12.6 研究和研究中心的关闭"},{"action":"获取文件归档、数据锁定和试验用药品回收程序后补写","category":"source_missing","gap_id":"gap_archiving_drug","missing_source_classes":["文件归档与数据锁定计划","试验用药品回收程序"],"target":"12.6 研究和研究中心的关闭"}],"heading":"研究和研究中心的关闭","missing_source_classes":["研究中心关闭程序","研究终止和暂停管理程序","文件归档与数据锁定计划","试验用药品回收程序"],"proposal_text":"","rationale":"本节所需的研究关闭和研究中心关闭项目文件尚未提供，无法形成有实质依据的正文；医学作者需获取相关管理文件后补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_e068895908c9_431652ba418ae93f","section_number":"12.6","source_ids":["protocol_full_dra