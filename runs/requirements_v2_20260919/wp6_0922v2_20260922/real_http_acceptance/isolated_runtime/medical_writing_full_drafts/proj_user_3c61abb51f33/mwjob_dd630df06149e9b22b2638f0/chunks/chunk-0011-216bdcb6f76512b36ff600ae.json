²或ALT/AST超过3倍正常值上限者为排除标准。治疗期（第1天至第12周）及安全性随访期（末次给药后28天）的实验室检查具体项目清单、采集时点、正常值范围及异常管理规则需依据试验药物SGC-R1-4的非临床毒理学安全性数据确定。","rationale":"项目已确认研究事实将临床实验室检查异常发生率列入安全性终点，排除标准明确涉及eGFR和ALT/AST阈值，但未列出完整实验室检查项目清单、各访视采集安排及异常处置规则。不得由安全性终点泛称推断具体检查项目，故仅写入已确认的排除阈值和检查目的。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3c61abb51f33_d177691e3bc7aa19","section_number":"7.3.3","source_ids":["protocol_full_draft_selection:216bdcb6f76512b36ff600ae","current_project_study_definition:mwdefinition_80f4c86643e5d253eba9:r4:4306105ca993f8d1"]},{"ai_run_id":"airun_20261003012106_692bf042","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_80f4c86643e5d253eba9:revision:4","quote":"妊娠期、哺乳期女性或不愿采取有效避孕措施者","quote_sha256":"8fe8957ed953ac6f05616d5ff9bac7cceeddf896e49029753a860a089beceb1c","source_id":"current_project_study_definition:mwdefinition_80f4c86643e5d253eba9:r4:4306105ca993f8d1","span_id":"es_preg_exclusion"},{"locator":"study_definition:mwdefinition_80f4c86643e5d253eba9:revision:4","quote":"妊娠期、哺乳期女性或不愿采取有效避孕措施者；正在使用或筛选前30天内使用过其他sGC激动剂、PDE5抑制剂或长效硝酸酯类","quote_sha256":"ed3a5c56b60b74c4c5b7525dae5f7939e89dae99350f3a27d3bdfb8362fc077c","source_id":"current_project_study_definition:mwdefinition_80f4c86643e5d253eba9:r4:4306105ca993f8d1","span_id":"es_exclusion_contraception"},{"locator":"document:mwdoc_greenfield_proj_user_3c61abb51f33_dd77459de84ed38c:full-draft:216bdcb6f76512b36ff600ae","quote":"当前正文=（当前为空，需生成实质正文）","quote_sha256":"d4f6c00478fea4ab2473939d37eb0a133f508d43a8b0a1e5356af486741ffce2","source_id":"protocol_full_draft_selection:216bdcb6f76512b36ff600ae","span_id":"es_section_empty"}],"evidence_review_advisories":[],"evidence_span_ids":["es_preg_exclusion","es_exclusion_contraception","es_section_empty"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"需依据IB生殖毒性数据及监管要求确认妊娠检查方法（尿或血清β-hCG）及是否在治疗期每次访视重复","category":"source_missing","gap_id":"gap_preg_test_method","missing_source_classes":["IB非临床生殖毒性","监管指南"],"target":"7.3.4节妊娠检查方法与实施时点"},{"action":"排除标准仅提及有效避孕措施，需确认具体可接受的避孕方法清单及伴侣避孕要求","category":"source_missing","gap_id":"gap_contraception_method","missing_source_classes":["方案避孕章节","IB生殖安全性建议"],"target":"7.3.4节避孕方法具体种类"},{"action":"需确认是否要求男性受试者报告伴侣妊娠及相应随访安排","category":"source_missing","gap_id":"gap_partner_pregnancy","missing_source_classes":["方案安全性报告章节","监管对sGC激动剂伴侣妊娠报告要求"],"target":"7.3.4节伴侣妊娠报告"}],"heading":"妊娠检查和避孕问询","missing_source_classes":["试验药物研究者手册（IB）中非临床生殖毒性章节","监管对sGC激动剂类药物的妊娠监测要求","方案中避孕方法具体规定"],"proposal_text":"本研究排除标准规定妊娠期、哺乳期女性或不愿采取有效避孕措施者不得入组。筛选期需确认育龄期女性受试者非妊娠及非哺乳状态。妊娠检查的具体方法（尿液或血清妊娠试验）、实施时点（是否仅限筛选期或治疗期每次访视均需重复）、避孕方法的具体种类与要求、伴侣妊娠报告流程以及治疗期间意外妊娠的处置与随访安排，需依据试验药物SGC-R1-4的非临床生殖毒性数据及适用监管要求确定。","rationale":"项目已确认研究事实的排除标准明确包含妊娠期、哺乳期女性或不愿采取有效避孕措施者，但仅说明排除条件，未规定妊娠检查方法、避孕具体方案、伴侣妊娠报告或新生儿随访等实施细节。依据指令，妊娠或哺乳期排除不能推出避孕方法、妊娠检查日程或伴侣妊娠报告，故仅写入已确认的排除条件，其余列为待确认项。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3c61abb51f33_8c171a510b3ffd95","section_number":"7.3.4","source_ids":["protocol_full_draft_selection:216bdcb6f76512b36ff600ae","current_project_study_definition:mwdefinition_80f4c86643e5d253eba9:r4:4306105ca993f8d1"]},{"ai_run_id":"airun_20261003012106_692bf042","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_80f4c86643e5d253eba9:revision:4","quote":"不良事件（AE）与严重不良事件（SAE）发生率（至末次给药后28天）；生命体征、12导联心电图、临床实验室检查异常发生率；症状性低血压发生率","quote_sha256":"eeb150d5b4105ba3f52e8fcb897d472c81b951c8a8aeebfbd7c19078cac79329","source_id":"current_project_study_definition:mwdefinition_80f4c86643e5d253eba9:r4:4306105ca993f8d1","span_id":"es_safety_endpoint_full"},{"locator":"study_definition:mwdefinition_80f4c86643e5d253eba9:revision:4","quote":"安全性随访期（末次给药后28天）","quote_sha256":"19473caec3ae0b985725972d232be99949f70a341b7f0097060c00a9cb449380","source_id":"current_project_study_definition:mwdefinition_80f4c86643e5d253eba9:r4:4306105ca993f8d1","span_id":"es_safety_window"},{"locator":"study_definition:mwdefinition_80f4c86643e5d253eba9:revision:4","quote":"安全性按SAS描述","quote_sha256":"2eb1a3b178e09efcd402621327a29b5689648ea7f3b7890145b9b1e0a7b34873","source_id":"current_project_study_definition:mwdefinition_80f4c86643e5d253eba9:r4:4306105ca993f8d1","span_id":"es_sas"},{"locator":"study_definition:mwdefinition_80f4c86643e5d253eba9:revision:4","quote":"DMC是否计划：否","quote_sha256":"7463c7eb67cd6a318d836f289e02648d5296c8dfe0b2f415f8f2bed6e14be4a2","source_id":"current_project_study_definition:mwdefinition_80f4c86643e5d253eba9:r4:4306105ca993f8d1","span_id":"es_no_dmc"},{"locator":"study_definition:mwdefinition_80f4c86643e5d253eba9:revision:4","quote":"筛选期（-28至-1天）；治疗期（第1天至第12周）；安全性随访期（末次给药后28天）","quote_sha256":"bd2c66fb1c011d6239bd55033e0b4ecc4371d8c2932778947261a7f5dff6072a","source_id":"current_project_study_definition:mwdefinition_80f4c86643e5d253eba9:r4:4306105ca993f8d1","span_id":"es_study_periods"}],"evidence_review_advisories":[],"evidence_span_ids":["es_safety_endpoint_full","es_safety_window","es_sas","es_no_dmc","es_study_periods"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"需确认AE/SAE/SUSAR的具体定义、采集窗口、报告对象（申办方、伦理委员会、监管机构）及报告时限","category":"source_missing","gap_id":"gap_ae_sae_definition","missing_source_classes":["方案安全性报告章节","适用监管法规"],"target":"第8节AE/SAE/SUSAR定义与报告"},{"action":"需确认哪些安全性事件触发剂量暂停、减量或永久停药及相应流程","category":"source_missing","gap_id":"gap_dose_adjustment","missing_source_classes":["方案剂量调整章节","IB安全性管理建议"],"target":"第8节剂量调整与停药触发条件"},{"action":"需确认症状性低血压的血压阈值、伴随症状判定标准及处理流程","category":"source_missing","gap_id":"gap_hypotension_threshold","missing_source_classes":["IB安全性管理建议","方案安全性章节"],"target":"第8节症状性低血压判定与处理"},{"action":"需确认在不设置DMC的情况下安全性信号的监测频率、升级路径及紧急揭盲程序","category":"decision_pending","gap_id":"gap_safety_monitoring_no_dmc","missing_source_classes":[],"target":"第8节无DMC条件下安全性信号监测"}],"heading":"安全性评价","missing_source_classes":["试验药物研究者手册（IB）中安全性管理章节","适用监管对AE/SAE/SUSAR报告时限要求","方案中剂量调整与永久停药规则","症状性低血压判定与处理流程"],"proposal_text":"本研究的安全性评价涵盖以下方面：不良事件（AE）与严重不良事件（SAE）发生率，观察窗口为至末次给药后28天；生命体征、12导联心电图及临床实验室检查异常发生率；症状性低血压发生率。安全性数据按安全性分析集（SAS）进行描述性统计。本研究不设置独立数据安全监查委员会（DMC）。AE与SAE的具体定义、采集窗口、报告对象与时限、因果关系判定标准、剂量调整与永久停药的触发条件、症状性低血压的判定阈值及处理流程、SUSAR的识别与报告程序，需依据试验药物SGC-R1-4的安全性特征及适用监管要求确定。","rationale":"项目已确认研究事实明确列出安全性终点范围（AE/SAE发生率、生命体征、12导联心电图、临床实验室检查异常发生率、症状性低血压发生率）、安全性观察窗口（至末次给药后28天）、安全性分析集（SAS）及不设置DMC的决定。但AE/SAE/SUSAR定义、报告时限、因果关系判定、剂量调整触发条件及症状性低血压具体阈值均未在允许来源中给出，不得以通用原则或条件句替代项目具体规则。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3c61abb51f33_2a371a807353481d","section_number":"8","source_ids":["protocol_full_draft_selection:216bdcb6f76512b36ff600ae","current_project_study_definition:mwdefinition_80f4c86643e5d253eba9:r4:4306105ca993f8d1"]}],"source_bindings":[{"content_sha256":"0fffe52f65fff52da2a9b52aa887923d372e1f7e06f83c1356b6f8ea08a55ddc","locator":"document:mwdoc_greenfield_proj_user_3c61abb51f33_dd77459de84ed38c:full-draft:216bdcb6f76512b36ff600ae","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:216bdcb6f76512b36ff600ae","source_type":"protocol_full_draft_selection","source_version":"full-draft:d5e23efdac27c70a1bcca9a30e7e0192a874737e8feb577fd249e6ee87a29261:216bdcb6f76512b36ff600ae","text_sha256":"0fffe52f65fff52da2a9b52aa887923d372e1f7e06f83c1356b6f8ea08a55ddc"},{"content_sha256":"215acad3f0d7365c422864af133207f95c4bfea65a128db26b08c65c73ab2308","locator":"study_definition:mwdefinition_80f4c86643e5d253eba9:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_80f4c86643e5d253eba9:r4:4306105ca993f8d1","source_type":"current_project_study_definition","source_version":"mwdefinition_80f4c86643e5d253eba9:r4:4306105ca993f8d1","text_sha256":"215acad3f0d7365c422864af133207f95c4bfea65a128db26b08c65c73ab2308"}]}