t_selection:1db2c7b5ae11169533bd648a","current_project_study_definition:mwdefinition_80f4c86643e5d253eba9:r4:4306105ca993f8d1","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261003021449_e2817b51","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:12.2 方案偏离|block:952|chunk:1","quote":"申办者将审查所有方案偏离，并评估是否有严重违背GCP，以及是否要求向卫生主管部门报告。","quote_sha256":"d25517b45959baef1238950be1f20302bb12ced5e0f13f47f237db01e4ef9d8a","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","span_id":"es_deviation_sponsor"},{"locator":"section:12.2 方案偏离|block:952|chunk:1","quote":"根据申办者的要求或SOP，偏离方案的前瞻性请求，包括放弃方案合格性标准的请求将不会被允许。","quote_sha256":"8b5479c25517a02284beffcbf64c724fda48c3b021d1d86e622a7400e29e5fb6","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","span_id":"es_deviation_prospective"},{"locator":"section:文档开头|block:26|chunk:1","quote":"既往/合并用药和治疗：在筛选期内（获得知情同意后且研究药物首次给药前）使用的药物将记录为既往用药。研究药物首次给药后使用的药物将被记录为合并用药。","quote_sha256":"33118fc6958419e645c6a0a19471c78f80e0c4c28be03b46f2b3e61d287e0305","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","span_id":"es_cm_recording"}],"evidence_review_advisories":[],"evidence_span_ids":["es_deviation_sponsor","es_deviation_prospective","es_cm_recording"],"evidence_summary":{"corpus_spans":3,"project_fact_spans":0},"gap_items":[{"action":"获取本项目方案偏离管理SOP或方案偏离分类标准文件，明确重大/一般偏离定义、报告时限、报告对象","category":"source_missing","gap_id":"gap_deviation_01","missing_source_classes":["本项目方案偏离分类标准","方案偏离报告时限与报告对象"],"target":"12.4 方案偏离 分类标准与报告时限"},{"action":"确认方案偏离对受试者数据纳入分析集的影响规则及偏离记录追踪方式","category":"source_missing","gap_id":"gap_deviation_02","missing_source_classes":["方案偏离对受试者数据处理的影响规则","方案偏离记录与追踪系统要求"],"target":"12.4 方案偏离 数据处理影响"}],"heading":"方案偏离","missing_source_classes":["本项目方案偏离分类标准（重大/一般）","方案偏离报告时限与报告对象","方案偏离对受试者数据处理的影响规则","方案偏离记录与追踪系统要求"],"proposal_text":"方案偏离是指任何有意或无意地偏离本研究方案、相关标准操作规程或适用法规要求的情形。所有方案偏离均须由申办者进行审查，评估是否构成对药物临床试验质量管理规范的严重违背，以及是否需要向卫生主管部门报告。根据申办者要求或标准操作规程，偏离方案的前瞻性请求，包括放弃方案合格性标准的请求，将不被允许。在筛选期内（获得知情同意后且研究药物首次给药前）使用的药物记录为既往用药；研究药物首次给药后使用的药物记录为合并用药。本研究的方案偏离分类标准、偏离报告时限、偏离对受试者数据处理的影响规则以及偏离记录与追踪方式，须依据本项目方案偏离管理文件确定后写入。","rationale":"方案偏离由申办者审查并评估GCP违背及报告义务、前瞻性偏离请求不被允许、合并用药按给药前后区分记录，均来自公司语料（CMD-D001-AD II期方案及MY004567方案），属监管共性结构参照。本章节缺少本项目方案偏离分类标准、报告时限、数据处理影响规则等项目级来源，故标记为partial。公司语料来源为不同适应症方案，仅用于结构参照，不迁移具体实施规则。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3c61abb51f33_eb0d66bdbc98ca63","section_number":"12.4","source_ids":["protocol_full_draft_selection:1db2c7b5ae11169533bd648a","current_project_study_definition:mwdefinition_80f4c86643e5d253eba9:r4:4306105ca993f8d1","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261003021449_e2817b51","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_80f4c86643e5d253eba9:revision:4","quote":"多中心、随机、双盲、安慰剂平行对照的II期概念验证与剂量探索研究","quote_sha256":"bca314ea800b7e1398db13f2a23194d1be4288995cd580eb27020945e94e709d","source_id":"current_project_study_definition:mwdefinition_80f4c86643e5d253eba9:r4:4306105ca993f8d1","span_id":"es_project_multicenter"},{"locator":"study_definition:mwdefinition_80f4c86643e5d253eba9:revision:4","quote":"DMC是否计划：否","quote_sha256":"7463c7eb67cd6a318d836f289e02648d5296c8dfe0b2f415