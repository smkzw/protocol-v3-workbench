ary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"补充研究者手册或研究药物药学/非临床/既往临床资料，明确作用机制、风险与注意事项。","category":"source_missing","gap_id":"gap-6.1.1-ib","missing_source_classes":["研究者手册","非临床研究资料","既往临床研究资料"],"target":"研究药物的非临床与既往临床资料、具体风险信息"},{"action":"补充药学研究资料，明确组成、辅料、生产者与批号信息。","category":"source_missing","gap_id":"gap-6.1.1-composition","missing_source_classes":["药学研究资料","药品生产者与批号信息"],"target":"研究药物组成、辅料、生产者与批号信息"}],"heading":"研究药物信息","missing_source_classes":["研究者手册","非临床与既往临床研究资料","药学研究资料","药品生产者与批号信息"],"proposal_text":"本研究的研究药物为SMOKE-r1-4口服sGC激动剂（SGC-R1L4），属于小分子口服固体制剂，剂型为薄膜衣片，规格为2.5 mg、5 mg和10 mg。SGC-R1L4通过口服途径给药，每日一次，连续给药12周；受试者按随机分配接受低、中、高三个剂量组之一的治疗。安慰剂为外观与SGC-R1L4一致的安慰剂片，口服每日一次，连续给药12周。研究期间背景指南导向药物治疗（GDMT）按指南维持稳定。","rationale":"已确认研究事实支持研究药物为SGC-R1L4，小分子口服sGC激动剂，薄膜衣片，规格2.5 mg、5 mg、10 mg，口服每日一次连续12周，并设低、中、高剂量组；安慰剂外观一致。医学经理需核对研究者手册、药学研究资料及既往临床资料中关于作用机制、组成、辅料、生产者、批号与具体风险的表述。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3c61abb51f33_d2134baa505699f4","section_number":"6.1.1","source_ids":["protocol_full_draft_selection:39555c2ab9a2843fcbee43ac","current_project_study_definition:mwdefinition_80f4c86643e5d253eba9:r4:4306105ca993f8d1","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc6f8c9ea6d34b","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:e35a8dbd3c7941"]},{"ai_run_id":"airun_20261003005512_1f8dbe6a","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"补充试验用药品制备、包装、标签、储存与管理项目文件，以及发放、回收与温控管理文件后形成正文。","category":"source_missing","gap_id":"gap-6.1.2-packaging","missing_source_classes":["试验用药品制备、包装、标签、储存与管理项目文件","试验用药品发放、回收与温控管理文件","标签样稿与包装规格文件"],"target":"制备、包装、标签、储存与管理章节正文"},{"action":"补充标签样稿与包装规格文件，明确标签信息与包装规格。","category":"source_missing","gap_id":"gap-6.1.2-labeling","missing_source_classes":["标签样稿","包装规格文件"],"target":"标签内容与包装规格描述"}],"heading":"制备、包装、标签、储存与管理","missing_source_classes":["试验用药品制备、包装、标签、储存与管理项目文件","试验用药品发放、回收与温控管理文件","标签样稿与包装规格文件"],"proposal_text":"","rationale":"已确认研究事实仅支持SGC-R1L4为薄膜衣片、口服每日一次连续12周等药品基本信息，未提供制备、包装、标签、储存、发放与回收管理的项目文件。医学经理需确认相应试验用药品管理文件后，方可形成本章节正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3c61abb51f33_1b0ef5c1b44db40d","section_number":"6.1.2","source_ids":["protocol_full_draft_selection:39555c2ab9a2843fcbee43ac","current_project_study_definition:mwdefinition_80f4c86643e5d253eba9:r4:4306105ca993f8d1","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc6f8c9ea6d34b","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:e35a8dbd3c7941"]}],"source_bindings":[{"content_sha256":"2498c4a84fad6a33dd437b61806603efd0a40a3cf5ad1eb97b9b6937ee51f1d0","locator":"document:mwdoc_greenfield_proj_user_3c61abb51f33_dd77459de84ed38c:full-draft:39555c2ab9a2843fcbee43ac","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:39555c2ab9a2843fcbee43ac","source_type":"protocol_full_draft_selection","source_version":"full-draft:d5e23efdac27c70a1bcca9a30e7e0192a874737e8feb577fd249e6ee87a29261:39555c2ab9a2843fcbee43ac","text_sha256":"2498c4a84fad6a33dd437b61806603efd0a40a3cf5ad1eb97b9b6937ee51f1d0"},{"content_sha256":"215acad3f0d7365c422864af133207f95c4bfea65a128db26b08c65c73ab2308","locator":"study_definition:mwdefinition_80f4c86643e5d253eba9:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_80f4c86643e5d253eba9:r4:4306105ca993f8d1",