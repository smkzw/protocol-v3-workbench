_v1:fb714bc3c01de1","source_type":"company_protocol_reference_corpus","source_version":"fb714bc3c01de1","text_sha256":"7a420e4850cce755cc434762b140d45b44b660dc6f7422f0a5336ae891763c04"},{"content_sha256":"fc70c6739c40d8cd0f5ace2c27bb8679f2ed3de81a272f72ab76aa30b8b65a75","locator":"section:11.2 知情同意|block:926|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:a1616fe22868fa","source_type":"company_protocol_reference_corpus","source_version":"a1616fe22868fa","text_sha256":"fc70c6739c40d8cd0f5ace2c27bb8679f2ed3de81a272f72ab76aa30b8b65a75"},{"content_sha256":"8057617d1964e3423a8b531b36e60104d5287e4d9023114f9c3ff9663a282c5f","locator":"section:研究方案|block:3|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","source_type":"company_protocol_reference_corpus","source_version":"665025df83658b","text_sha256":"8057617d1964e3423a8b531b36e60104d5287e4d9023114f9c3ff9663a282c5f"}]}