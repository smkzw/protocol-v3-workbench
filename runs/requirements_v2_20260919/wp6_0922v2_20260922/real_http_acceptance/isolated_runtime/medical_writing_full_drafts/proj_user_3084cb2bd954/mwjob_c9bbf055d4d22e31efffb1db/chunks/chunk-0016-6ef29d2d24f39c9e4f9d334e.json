15_v1:fc98aacc7e06ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:3d4fa32554415b"]},{"ai_run_id":"airun_20261006201356_95e327c6","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取项目适用法规与监管要求清单，确认是否涉及人类遗传资源管理条例及跨境数据合规要求","category":"source_missing","gap_id":"gap_legal_001","missing_source_classes":["项目适用法规清单","人类遗传资源适用性评估文件"],"target":"遵守法律法规章节正文"}],"heading":"遵守法律法规","missing_source_classes":["项目适用法规清单","人类遗传资源适用性评估文件","跨境数据传输合规评估"],"proposal_text":"","rationale":"本章节需列明本研究适用的具体法律法规与监管要求。当前允许来源确认开发区域为中国、研究分期为III期、为多中心设计，但未提供项目适用的具体法规清单确认文件，亦未确认是否涉及人类遗传资源管理条例适用性判断或跨境数据传输合规要求。缺少项目法规适用性确认文件，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3084cb2bd954_efe401089bf146d5","section_number":"11.1","source_ids":["protocol_full_draft_selection:6ef29d2d24f39c9e4f9d334e","current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","company_corpus:cms_cn_protocol_corpus_20260715_v1:42d49ba7a285ce","company_corpus:cms_cn_protocol_corpus_20260715_v1:582cc728dae6fe","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc98aacc7e06ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:3d4fa32554415b"]},{"ai_run_id":"airun_20261006201356_95e327c6","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_b42f0e126b007fed71bb:revision:4","quote":"签署知情同意时年龄50~85岁男性","quote_sha256":"a79be0b8629d744dd05822ee5104c405ba41f7f1171aa247345899a5a2e16148","source_id":"current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","span_id":"es_002"},{"locator":"section:试验参与者知情同意书|block:906|chunk:1","quote":"知情同意书分为成年人、未成年人及监护人版本，经过伦理委员会的审批之后方可使用。","quote_sha256":"2acebffe2bcacc2b4c22948a73b66ff040ee70fcbe02b33a6a441bde4fe38204","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:42d49ba7a285ce","span_id":"es_003"},{"locator":"section:试验参与者知情同意书|block:908|chunk:1","quote":"知情同意书的任何修改需经所在临床研究医院伦理委员会批准后执行，未出组患者必须重新签署新版知情同意书。","quote_sha256":"bb9c04474a3b8ea11eb6af9fde69b3f838645f116f0588d9a5fe4887129d2a78","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:582cc728dae6fe","span_id":"es_004"},{"locator":"section:文档开头|block:4|chunk:1","quote":"本方案中所包含的所有信息归申办方所有，因此，仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构进行审阅。","quote_sha256":"a95f171292054da4c0e730a5808f9cf1db173b3e9368862f63a2a3c3172a88c6","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","span_id":"es_005"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003","es_004","es_005"],"evidence_summary":{"corpus_spans":3,"project_fact_spans":1},"gap_items":[{"action":"获取项目知情同意书模板，确认版本号、语言及是否采用电子知情同意","category":"source_missing","gap_id":"gap_icf_001","missing_source_classes":["项目知情同意书模板及版本信息"],"target":"知情同意章节中知情同意书版本、语言及电子知情同意方式"},{"action":"获取项目知情同意操作规范，明确撤回同意的记录方式、后续数据处理及随访安排","category":"source_missing","gap_id":"gap_icf_002","missing_source_classes":["知情同意过程操作规范","受试者撤回同意处理流程"],"target":"知情同意章节中受试者撤回同意的操作流程"}],"heading":"知情同意","missing_source_classes":["项目知情同意书模板及版本信息","知情同意过程操作规范","受试者撤回同意处理流程"],"proposal_text":"本研究入组人群为签署知情同意时年龄50至85岁的成年男性，不涉及未成年人或无民事行为能力人，因此知情同意书仅采用成年人版本。知情同意书须经所在临床研究医院伦理委员会审批后方可使用。知情同意书的任何修改需经所在临床研究医院伦理委员会批准后执行，未出组受试者必须重新签署新版知情同意书。受试者在签署知情同意书后方可进入筛选期，知情同意签署日期为研究时间的起算点。本方案中所包含的所有信息归申办方所有，仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构进行审阅；在未得到申办方书面批准的情况下，除在与可能参加本研究的受试者签署知情同意书时向其做必要的解释外，严禁将任何信息告知与本研究无关的第三方。","rationale":"已确认事实：研究人群为50至85岁成年男性（入选标准明确排除未成年人）；知情同意书须经伦理委员会审批后方可使用；修改后未出组受试者须重新签署；知情同意签署日期为研究时间起算点；方案信息保密要求。待医学经理确认：知情同意书具体版本号与语言、是否采用电子知情同意、知情同意过程记录方式、受试者撤回同意的具体操作流程与后续数据处理规则、各中心知情同意书递交伦理审批的时间节点。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3084cb2bd954_0ec26abfc8