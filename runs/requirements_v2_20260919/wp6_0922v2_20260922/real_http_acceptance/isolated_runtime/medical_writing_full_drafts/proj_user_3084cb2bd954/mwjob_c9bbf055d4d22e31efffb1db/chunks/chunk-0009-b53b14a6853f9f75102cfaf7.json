{"ai_route":{"actual_response_model":"mtplx-flash-next-optimized-speed","ai_run_id":"airun_20261006194807_659e0369","expected_response_model":"mtplx-flash-next-optimized-speed","fallback_chain_id":"aifb_ec09d63afa8027a21add7167","fallback_depth":0,"fallback_reason":"","model":"mtplx-flash-next-optimized-speed","provider":"mtplx","reasoning_effort":"xhigh","route_base_url":"http://127.0.0.1:8002/v1","route_identity_hash":"c9480819205db8521fec70763515cf905334434da194fa8ae2172b40ab545075","route_profile_id":"independent_ai__mtplx_qwen38_local","thinking":"enabled"},"ai_run_id":"airun_20261006194807_659e0369","chunk_index":9,"job_id":"mwjob_c9bbf055d4d22e31efffb1db","precondition_digest":"ae9cedc141106e5e430beb62d18a37b02195351499d3c84827d77781412af1cc","project_id":"proj_user_3084cb2bd954","schema_version":"protocol_full_draft_chunk_v10","section_ids":["mwsec_greenfield_proj_user_3084cb2bd954_5619c88700811140","mwsec_greenfield_proj_user_3084cb2bd954_296fc01c05592cd2","mwsec_greenfield_proj_user_3084cb2bd954_641b2b00653a4348","mwsec_greenfield_proj_user_3084cb2bd954_2feeae3314bda8ee"],"sections":[{"ai_run_id":"airun_20261006194807_659e0369","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取项目访视操作规范或研究中心手册中关于计划外访视的触发标准、必做评估项目及记录要求","category":"source_missing","gap_id":"gap_unsched_01","missing_source_classes":["项目访视操作规范","研究中心手册"],"target":"计划外访视触发条件与评估内容"}],"heading":"计划外访视","missing_source_classes":["项目访视操作规范","研究中心手册","计划外访视触发与评估标准"],"proposal_text":"","rationale":"允许来源仅列出计划访视日程（筛选、基线、第4/8/12/24/36/52周及安全性随访），未涉及计划外访视的触发条件、评估项目、记录要求或与计划访视的衔接规则。该章节需要项目层面的访视操作规范或研究中心手册作为来源支撑。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3084cb2bd954_5619c88700811140","section_number":"7.1.3","source_ids":["protocol_full_draft_selection:b53b14a6853f9f75102cfaf7","current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481"]},{"ai_run_id":"airun_20261006194807_659e0369","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_b42f0e126b007fed71bb:revision:4","quote":"共同主要估计目标（治疗策略）：在BPH伴中重度LUTS男性中，无论是否中止研究治疗或使用补救LUTS治疗，评价R7A-BD502 75mg每日一次12周相较安慰剂对IPSS总分与Qmax较基线变化的作用","quote_sha256":"6a14810381e1f034935bc72e20250620a1b50aef7d54e524e5f2431ffc9738b3","source_id":"current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","span_id":"es2"},{"locator":"study_definition:mwdefinition_b42f0e126b007fed71bb:revision:4","quote":"补救治疗记录为伴发事件并保留于主要分析（mITT）","quote_sha256":"5371fc21a627765cd807d1513d0613df43144ac8913309da0738ba63cf73567d","source_id":"current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","span_id":"es3"}],"evidence_review_advisories":[],"evidence_span_ids":["es2","es3"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"获取项目操作规范中关于治疗终止触发条件、终止后评估及随访安排的规定","category":"source_missing","gap_id":"gap_disc_01","missing_source_classes":["项目操作规范"],"target":"研究治疗终止的医学判断标准与操作程序"},{"action":"获取项目操作规范中关于失访定义、追踪时限及退出后数据处理的规定","category":"source_missing","gap_id":"gap_disc_02","missing_source_classes":["项目操作规范","研究中心手册"],"target":"退出研究及失访定义与追踪程序"}],"heading":"研究治疗终止、退出研究及失访处理","missing_source_classes":["项目操作规范","研究中心手册","失访处理程序"],"proposal_text":"本研究采用治疗策略估计目标，在主要疗效分析中，无论受试者是否中止研究治疗或使用补救性LUTS治疗，均按随机化分组纳入修改意向治疗集进行分析。补救性LUTS治疗记录为伴发事件，不导致受试者从主要分析集中剔除。研究治疗终止、退出研究及失访的具体操作程序，包括终止治疗的医学判断标准、退出后安全性随访安排、失访定义及追踪程序，需依据项目操作规范与研究中心手册确定后方可写入方案正文。","rationale":"估计目标策略已确认采用治疗策略框架，补救治疗保留于mITT分析；但终止标准、退出后随访、失访处理等具体操作程序在允许来源中未给出，需项目操作规范或研究中心手册补充。","review_advisories":["本节提及高影响设计信息（估计目标、伴发事件）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3084cb2bd954_296fc01c05592cd2","section_number":"7.1.4","source_ids":["protocol_full_draft_selection:b53b14a6853f9f75102cfaf7","current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481"]},{"ai_run_id":"airun_20261006194807_659e0369","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_b42f0e126b007fed71bb:revision:4","quote":"共同主要终点（12周）：①IPSS总分较基线变化；②最大尿流率Qmax较基线变化（R7A-BD502 75mg vs 安慰剂；α分配：IPSS 0.04、Qmax 0.01）","quote_sha256":"f8081de3512ec5fc9ae09d48b426d1a0e5382d18f0a06da76b3ee0dbdc8c60b1","source_id":"current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","span_id":"es4"},{"locator":"study_definition:mwdefinition_b42f0e126b007fed71bb:revision:4","quote":"关键次要终点：第12周IPSS生活质量指数（QoL）较基线变化；第12周BPH影响指数（BII）较基线变化；第52周IPSS总分与Qmax较基线变化（长期维持）","quote_sha256":"a0eaf70e927dca0968856a3e566413829958eaaadb682328c65ed124d9ad2fd1","source_id":"current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","span_id":"es5"},{"locator":"study_definition:mwdefinition_b42f0e126b007fed71bb:revision:4","quote":"其他次要终点：第4、8周IPSS总分变化（起效时间）；夜尿次数与24小时排尿日记指标变化；第12周与52周排尿后残余尿量（PVR）变化；受试者整体印象改善（PGI-I）应答率","quote_sha256":"20a42aaccbb06814d94d564bb5be9155106319d9f11484919c7877aaedcf7b85","source_id":"current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","span_id":"es6"},{"locator":"study_definition:mwdefinition_b42f0e126b007fed71bb:revision:4","quote":"共同主要终点分别用ANCOVA/MMRM（协变量：基线值、分层因素、访视及访视×治疗交互），按α分配控制总体I类错误并报告95%CI；关键次要按层级顺序检验；敏感性分析含多重填补（补救治疗回归填补）与安慰剂组截断；血压/心率变化按时间点报告均值差95%CI；MACE经CEC裁定后按组描述。分析集mITT/安全性/PP依ICH E9","quote_sha256":"64b2e9e38c08a10348ac1a7655d79f97ef85d52e3a334d6926b8c415b4601f67","source_id":"current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","span_id":"es7"}],"evidence_review_advisories":[],"evidence_span_ids":["es4","es5","es6","es7"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"确认IPSS中文版版本号、BII量表版本及授权状态，确认PGI-I版本","category":"source_not_retrieved","gap_id":"gap_eff_01","missing_source_classes":["量表授权文件","量表版本说明"],"target":"IPSS与BII量表版本、授权及培训要求"},{"action":"确认24小时排尿日记在哪些访视采集（是否仅第12周和第52周，或包含其他时点）","category":"source_not_retrieved","gap_id":"gap_eff_02","missing_source_classes":["访视操作规范"],"target":"24小时排尿日记采集时点"}],"heading":"有效性评估","missing_source_classes":[],"proposal_text":"本研究有效性评估涵盖共同主要终点、关键次要终点、其他次要终点及探索性终点。共同主要终点为第12周IPSS总分较基线变化与第12周最大尿流率Qmax较基线变化，两组比较采用ANCOVA或MMRM模型，协变量包括基线值、分层因素、访视及访视与治疗的交互项，按α分配（IPSS 0.04、Qmax 0.01）控制总体I类错误并报告95%置信区间。关键次要终点包括第12周IPSS生活质量指数较基线变化、第12周BPH影响指数较基线变化及第52周IPSS总分与Qmax较基线变化，按层级顺序检验。其他次要终点包括第4周和第8周IPSS总分变化、夜尿次数与24小时排尿日记指标变化、第12周与第52周排尿后残余尿量变化及受试者整体印象改善应答率。探索性分析按基线IPSS严重度、前列腺体积（≥40 mL与<40 mL）及代谢综合征状态进行亚组疗效探索，并探索血压与心率变化同疗效的关联。主要分析集为修改意向治疗集，按ICH E9原则确定。敏感性分析包含多重填补（对补救治疗进行回归填补）与安慰剂组截断。","rationale":"共同主要终点、关键次要终点、其他次要终点、探索性终点、统计模型、α分配、分析集及敏感性分析方法均由当前项目已确认研究事实直接支持。需医学经理确认：IPSS量表版本与授权、BII量表版本与授权、PGI-I版本、24小时排尿日记的具体采集时点（是否仅在第12周和第52周）、探索性亚组分析的统计方法细节。","review_advisories":["本节提及高影响设计信息（α、主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3084cb2bd954_641b2b00653a4348","section_number":"7.2","source_ids":["protocol_full_draft_selection:b53b14a6853f9f75102cfaf7","current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481"]},{"ai_run_id":"airun_20261006194807_659e0369","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_b42f0e126b007fed71bb:revision:4","quote":"安全性终点：TEAE/SAE发生率与严重程度；坐位血压与心率较基线变化及体位性低血压事件；12导联心电图（QTcF）变化；实验室（肝肾功能、血糖、HbA1c、PSA）；尿潴留与泌尿系感染、生殖系统不良事件专项汇总","quote_sha256":"c559068fb0d4382ee0fbc2079717f714417b6ddf819c1a597c392713886359ed","source_id":"current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","span_id":"es8"},{"locator":"study_definition:mwdefinition_b42f0e126b007fed71bb:revision:4","quote":"特别关注的不良事件：血压升高相关严重事件；心率增快及新发心律失常；尿潴留（需导尿）；重大心血管不良事件（MACE，独立CEC裁定）","quote_sha256":"54b7993c6954135057976c2c78a660bb7e76889e501655fa68f15c0ce9061c1b","source_id":"current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","span_id":"es9"},{"locator":"study_definition:mwdefinition_b42f0e126b007fed71bb:revision:4","quote":"DMC是否计划：是","quote_sha256":"9967a9a75297ced2326ab733fa3b16934acdef641fa765dd50c1cd58219f4aa5","source_id":"current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","span_id":"es10"},{"locator":"study_definition:mwdefinition_b42f0e126b007fed71bb:revision:4","quote":"无疗效期中分析，DSMB每4个月盲态安全审阅","quote_sha256":"036fd728f3a4b0aa1b66f33283fa309139a6abfb4dae963e9314e9b6c91e5b4f","source_id":"current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","span_id":"es11"}],"evidence_review_advisories":[],"evidence_span_ids":["es8","es9","es10","es11"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"确认TEAE采集窗口（从首次给药至末次给药后多少天）及安全性评估窗口","category":"source_missing","gap_id":"gap_saf_01","missing_source_classes":["项目安全性操作规范"],"target":"TEAE采集窗口定义"},{"action":"获取项目安全性操作规范中关于不良事件定义、CTCAE或MedDRA分级、报告对象与时限的规定","category":"source_missing","gap_id":"gap_saf_02","missing_source_classes":["项目安全性操作规范","研究中心手册"],"target":"AE/SAE/SUSAR定义、分级与报告时限"},{"action":"确认ECG、实验室检查、血压心率测量在哪些访视实施（是否每个访视均做）","category":"source_not_retrieved","gap_id":"gap_saf_03","missing_source_classes":["访视操作规范"],"target":"各安全性评估项目的具体实施访视"},{"action":"获取独立心血管事件委员会章程、成员组成及MACE裁定标准","category":"source_not_retrieved","gap_id":"gap_saf_04","missing_source_classes":["CEC章程","安全性评估标准"],"target":"CEC组成与MACE裁定标准"},{"action":"获取DSMB章程、审阅内容、沟通路径及紧急揭盲程序","category":"source_not_retrieved","gap_id":"gap_saf_05","missing_source_classes":["DSMB章程"],"target":"DSMB章程与沟通机制"}],"heading":"安全性评估","missing_source_classes":[],"proposal_text":"本研究安全性评估包括以下监测内容：治疗期间不良事件与严重不良事件的发生率及严重程度；坐位血压与心率较基线变化及体位性低血压事件；12导联心电图QTcF间期变化；实验室检查涵盖肝功能、肾功能、血糖、糖化血红蛋白及前列腺特异性抗原；尿潴留与泌尿系感染及生殖系统不良事件进行专项汇总。特别关注的不良事件包括：血压升高相关严重事件、心率增快及新发心律失常、需导尿处理的尿潴留、重大心血管不良事件。重大心血管不良事件由独立心血管事件委员会进行裁定，裁定结果按组描述。本研究设置数据安全监查委员会，每4个月进行一次盲态安全审阅，不设置疗效期中分析。","rationale":"安全性终点监测项目、特别关注不良事件类别、CEC裁定安排、DSMB设置及审阅频率均由当前项目已确认研究事实直接支持。需医学经理确认：TEAE采集窗口起止时点、各安全性评估项目（ECG、实验室、血压心率）的具体实施访视、AE/SAE/SUSAR定义与报告时限、CEC组成与裁定标准、DSMB章程及沟通机制。","review_advisories":["本节提及高影响设计信息（期中分析）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3084cb2bd954_2feeae3314bda8ee","section_number":"7.3","source_ids":["protocol_full_draft_selection:b53b14a6853f9f75102cfaf7","current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481"]}],"source_bindings":[{"content_sha256":"d619106c00a5aa8f96be53eae04e76cfe2f1be451a7562c67a1e2aaeb846b0ef","locator":"document:mwdoc_greenfield_proj_user_3084cb2bd954_1e9851ab3c5d5a9d:full-draft:b53b14a6853f9f75102cfaf7","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:b53b14a6853f9f75102cfaf7","source_type":"protocol_full_draft_selection","source_version":"full-draft:ae9cedc141106e5e430beb62d18a37b02195351499d3c84827d77781412af1cc:b53b14a6853f9f75102cfaf7","text_sha256":"d619106c00a5aa8f96be53eae04e76cfe2f1be451a7562c67a1e2aaeb846b0ef"},{"content_sha256":"e8eb420597583eecf861b0865f05cd3125176647cb283075199484e144f000a4","locator":"study_definition:mwdefinition_b42f0e126b007fed71bb:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","source_type":"current_project_study_definition","source_version":"mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","text_sha256":"e8eb420597583eecf861b0865f05cd3125176647cb283075199484e144f000a4"}]}