ator":"study_definition:mwdefinition_b42f0e126b007fed71bb:revision:4","quote":"研究时期：筛选期（最长28天）；双盲核心期（第1~12周）；双盲延长期（第13~52周）；治疗结束后安全随访（末次给药后2周）","quote_sha256":"fe1b091aa76b11c67faf0ebbda19e563d1354ad166bcc6e0791c9ab83012e1d5","source_id":"current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","span_id":"es_study_periods"},{"locator":"study_definition:mwdefinition_b42f0e126b007fed71bb:revision:4","quote":"DMC是否计划：是","quote_sha256":"9967a9a75297ced2326ab733fa3b16934acdef641fa765dd50c1cd58219f4aa5","source_id":"current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","span_id":"es_dmc"},{"locator":"study_definition:mwdefinition_b42f0e126b007fed71bb:revision:4","quote":"重大心血管不良事件（MACE，独立CEC裁定）","quote_sha256":"bfb633478a11bbf50ce6f1cd768b20346c325f97bacc028a86b5139315df7dad","source_id":"current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","span_id":"es_mace_cec"}],"evidence_review_advisories":[],"evidence_span_ids":["es_safety_endpoints","es_sae_defined","es_study_periods","es_dmc","es_mace_cec"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"需项目安全性监测计划或方案安全性章节明确TEAE采集从首次给药至末次给药后具体天数","category":"source_missing","gap_id":"gap_s8_teae_window","missing_source_classes":["安全性监测计划","方案安全性章节"],"target":"安全性评价章节中TEAE采集窗口的起止定义"},{"action":"需DMC章程明确盲态审阅频率、审阅指标、暂停/终止触发条件","category":"source_missing","gap_id":"gap_s8_dmc_detail","missing_source_classes":["DMC章程"],"target":"安全性评价章节中DMC审阅内容与触发标准"},{"action":"需CEC章程明确MACE定义、裁定流程、盲态/开放裁定方式","category":"source_missing","gap_id":"gap_s8_cec_detail","missing_source_classes":["CEC章程"],"target":"安全性评价章节中CEC裁定操作细则"}],"heading":"安全性评价","missing_source_classes":["研究者手册（IB）中R7A-BD502既往安全性数据","安全性监测计划（含DMC章程、CEC章程）","AE/SAE/SUSAR定义与报告操作规范"],"proposal_text":"本研究的安全性评价覆盖双盲核心期（第1至12周）、双盲延长期（第13至52周）及治疗结束后安全随访期（末次给药后2周）。安全性评估内容包括：治疗期间不良事件（TEAE）与严重不良事件（SAE）的发生率及严重程度；坐位血压与心率较基线变化及体位性低血压事件；12导联心电图QTcF间期变化；实验室安全性指标（肝功能、肾功能、血糖、糖化血红蛋白、前列腺特异性抗原）；尿潴留与泌尿系感染、生殖系统不良事件的专项汇总。特别关注的不良事件包括血压升高相关严重事件、心率增快及新发心律失常、需导尿处理的尿潴留以及重大心血管不良事件（MACE），其中MACE由独立心血管事件委员会（CEC）进行裁定。研究期间设立数据安全监查委员会（DMC），按每4个月一次的频率开展盲态安全性审阅。","rationale":"安全性终点、特别关注不良事件、研究时期（含安全随访）和DMC计划均来源于当前项目已确认研究定义。TEAE采集窗口的起止时点、各安全性评估的具体实施频率（是否每次访视均做ECG或实验室检查）、DMC审阅的具体内容和触发标准、CEC裁定的操作细则均未在本批次来源中给出，需医学经理结合IB和安全性监测计划补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3084cb2bd954_1eb11b885f6bdbd4","section_number":"8","source_ids":["protocol_full_draft_selection:2aef944f102a0379fcf454f2","current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5b47256314408","company_corpus:cms_cn_protocol_corpus_20260715_v1:ba131fb3d2c27f","company_corpus:cms_cn_protocol_corpus_20260715_v1:9abb104d760a32","company_corpus:cms_cn_protocol_corpus_20260715_v1:b8932a810ddf25","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb"]},{"ai_run_id":"airun_20261006195805_f5f8f5cd","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"需项目方案安全性章节或安全性监测计划提供AE/SAE定义文本","category":"source_missing","gap_id":"gap_s81_ae_sae_def","missing_source_classes":["AE/SAE/SUSAR定义与报告操作规范"],"target":"总则章节中AE与SAE的正式定义"},{"action":"需项目方案明确因果关系判定类别、判定主体和争议处理流程","category":"source_missing","gap_id":"gap_s81_causality","missing_source_classes":["AE/SAE/SUSAR定义与报告操作规范"],"target":"总则章节中因果关系判定方法"},{"action":"需项目方案或安全性监测计划明确报告时限、报告路径和监管报告要求","category":"source_missing","gap_id":"gap_s81_reporting","missing_source_classes":["AE/SAE/SUSAR定义与报告操作规范","安全性监测计划"],"target":"总则章节中SAE/SUSAR报告时限与报告对象"}],"heading":"总则","missing_source_classes":["AE/SAE/SUSAR定义与报告操作规范","研究者手册（IB）中安全性评估方法学","项目安全性监测计划"],"proposal_text":"","rationale":"总则章节需明确本研究中不良事件与严重不良事件的定义、因果关系判定方法、报告时限与报告对象、安全性评估的起始与终止时点等