on_id":"mwsec_greenfield_proj_user_3084cb2bd954_80356f7524a041bd","section_number":"2.3.2","source_ids":["protocol_full_draft_selection:7a00266acb19d217b63519ad","current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:9278a21ab7462f","company_corpus:cms_cn_protocol_corpus_20260715_v1:367cbc36976ba5","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca"]},{"ai_run_id":"airun_20261006191357_107ee87a","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"补充或重新绑定能够直接支持本章节主张的当前项目来源","category":"source_missing","gap_id":"gap_3_01","missing_source_classes":["支持本章节研究实施规则的项目权威资料或职能确认"],"target":"3 研究目的和终点"}],"heading":"研究目的和终点","missing_source_classes":["支持本章节研究实施规则的项目权威资料或职能确认"],"proposal_text":"","rationale":"研究目的、共同主要终点（IPSS与Qmax）、α分配（0.04/0.01）、关键次要终点（QoL、BII、52周IPSS/Qmax）、其他次要终点（第4/8周IPSS、夜尿、PVR、PGI-I）、安全性终点（TEAE/SAE、血压心率、ECG、实验室、尿潴留、泌尿系感染、生殖系统AE）及特别关注不良事件（血压升高、心律失常、尿潴留、MACE/CEC）均直接来源于当前项目已确认研究事实。ANCOVA/MMRM模型与层级检验顺序亦为已确认统计策略。医学经理需确认：（1）各终点评价时点与访视计划的一致性；（2）PGI-I量表版本与授权；（3）CEC章程中MACE裁定标准；（4）安全性终点中实验室指标的具体采集时点是否覆盖全部访视。","review_advisories":["本节复述高影响研究设计（研究目的和终点）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3084cb2bd954_65ec4d0a5638f85d","section_number":"3","source_ids":["protocol_full_draft_selection:7a00266acb19d217b63519ad","current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:9278a21ab7462f","company_corpus:cms_cn_protocol_corpus_20260715_v1:367cbc36976ba5","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca"]},{"ai_run_id":"airun_20261006191357_107ee87a","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_b42f0e126b007fed71bb:revision:4","quote":"探索性终点：按基线IPSS严重度、前列腺体积（≥/<40mL）与代谢综合征状态的亚组疗效探索；血压/心率变化与疗效的关联探索","quote_sha256":"781b16693b61df8edb93281d3105e1f9659d816626619af0f4845c7d8112d4d9","source_id":"current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","span_id":"es4"},{"locator":"study_definition:mwdefinition_b42f0e126b007fed71bb:revision:4","quote":"随机化按基线IPSS严重度（13~19 vs ≥20）与α1阻滞剂经治状态（是/否）分层，1:1分配。","quote_sha256":"bad2fb19fddc44f34931f1b2892ad2597638ffb189a2284eb17f8b22df217940","source_id":"current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","span_id":"es6"}],"evidence_review_advisories":[],"evidence_span_ids":["es4","es6"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"确认代谢综合征操作性定义及血压/心率与疗效关联的统计方法","category":"decision_pending","gap_id":"gap_3_3_01","missing_source_classes":[],"target":"3.3 探索性目的和探索性终点"},{"action":"检索前列腺体积40 mL分界值及代谢综合征亚组在BPH/LUTS研究中的文献依据","category":"source_not_retrieved","gap_id":"gap_3_3_02","missing_source_classes":["BPH亚组分析文献","代谢综合征与LUTS关联文献"],"target":"3.3 探索性目的和探索性终点"}],"heading":"探索性目的和探索性终点","missing_source_classes":[],"proposal_text":"本研究的探索性目的为在确证性主要与次要终点之外，进一步描述R7A-BD502 75mg每日一次在不同基线特征亚组中的疗效表现，以及心血管参数变化与疗效之间的关联模式，为后续研究或标签讨论提供描述性参考，不作为注册确证依据。探索性终点包括：（1）按基线IPSS严重度（13~19分与≥20分）、前列腺体积（≥40 mL与<40 mL）及代谢综合征状态（有/无）进行亚组疗效探索，主要观察指标为第12周IPSS总分与Qmax较基线变化；（2）坐位血压与心率较基线变化与疗效指标（IPSS、Qmax）之间的关联探索。上述探索性分析为描述性，不纳入I类错误控制，不预设确证性假设检验。","rationale":"探索性终点内容（亚组分层维度：IPSS严重度、前列腺体积≥/<40 mL、代谢综合征状态；血压/心率与疗效关联）直接来源于当前项目已确认研究事实中的探索性终点条目。亚组分层维度与随机化分层因素（IPSS严重度、α1阻滞剂经治状态）存在部分重叠但不完全一致，前列腺体积与代谢综合征为额外探索维度。医学经理需确认：（1）代谢综合征的操作性定义（是否采用NCEP-ATP III或中国标准）；（2）血压/心率与疗效关联的具体统计方法（Pearson/Spearman相关、线性回归或亚组交互检验）；（3）探索性分析是否限定于mITT集或扩展至安全性集；（4）前列腺体积≥40 mL分界值的文献依据。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3084cb2bd954_f67f4534e8b081a0","section_number":"3.3","source_ids":["protocol_full_draft_selection:7a00266acb19d217b63519ad","current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:9278a21ab7462f","company_corpus:cms_cn_protocol_corpus_20260715_v1:367cbc36976ba5","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca"]},{"ai_run_id":"airun_20261006191357_107ee87a","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_b42f0e126b007fed71bb:revision:4","quote":"总体研究设计：随机、双盲、安慰剂对照、两臂平行组、多中心III期确证性研究：R7A-BD502 75mg每日一次口服 vs 匹配安慰剂，双盲12周核心期后进入40周双盲延长期（共52周）；共同主要终点为12周IPSS总分与Qmax较基线变化；两组均按需稳定背景抗高血压治疗。","quote_sha256":"9b314ef4d050258e30dacf159c776d28acebdb4d80d5baa28e0af988812a5fa6","source_id":"current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","span_id":"es5"},{"locator":"study_definition:mwdefinition_b42f0e126b007fed71bb:revision:4","quote":"随机化按基线IPSS严重度（13~19 vs ≥20）与α1阻滞剂经治状态（是/否）分层，1:1分配。","quote_sha256":"bad2fb19fddc44f34931f1b2892ad2597638ffb189a2284eb17f8b22df217940","source_id":"current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","span_id":"es6"},{"locator":"study_definition:mwdefinition_b42f0e126b007fed71bb:revision:4","quote":"假设安慰剂组12周IPSS下降6.0分、R7A-BD502组多降2.2分（共同SD 7.5，α=0.04）；Qmax安慰剂组升高1.0 mL/s、试验组多升1.2 mL/s（共同SD 2.8，α=0.01）；各把握度≥90%，1:1分配共需约1,680例（每组840例）；考虑10%脱落扩至1,860例。","quote_sha256":"25e54a3d100f62135402e345aa4aa2c732856ae8a21833bf62a8f97ab2f7a650","source_id":"current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","span_id":"es7"},{"locator":"study_definition:mwdefinition_b42f0e126b007fed71bb:revision:4","quote":"无疗效期中分析，DSMB每4个月盲态安全审阅。","quote_sha256":"4b8fd9b3f966e6fba0d50b2c880f57e263197d16526a455188b6769e9e5a1513","source_id":"current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","span_id":"es8"},{"locator":"study_definition:mwdefinition_b42f0e126b007fed71bb:revision:4","quote":"研究时期：筛选期（最长28天）；双盲核心期（第1~12周）；双盲延长期（第13~52周）；治疗结束后安全随访（末次给药后2周）","quote_sha256":"fe1b091aa76b11c67faf0ebbda19e563d1354ad166bcc6e0791c9ab83012e1d5","source_id":"current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","span_id":"es9"},{"locator":"study_definition:mwdefinition_b42f0e126b007fed71bb:revision:4","quote":"共同主要估计目标（治疗策略）：在BPH伴中重度LUTS男性中，无论是否中止研究治疗或使用补救LUTS治疗，评价R7A-BD502 75mg每日一次12周相较安慰剂对IPSS总分与Qmax较基线变化的作用（α按0.04/0.01分配）。补救治疗记录为伴发事件并保留于主要分析（mITT）。","quote_sha256":"b7148356e19a4f2c8e95c8e3080a2ce638566f60599a42757e7fb49d6a0328bd","source_id":"current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","span_id":"es10"}],"evidence_review_advisories":[],"evidence_span_ids":["es5","es6","es7","es8","es9","es10"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[],"heading":"研究设计","missing_source_classes":[],"proposal_text":"本研究为随机、双盲、安慰剂对照、两臂平行组、多中心III期确证性研究，在中国开展。试验组接受R7A-BD502缓释片75mg每日一次口服，对照组接受外观一致的匹配安慰剂缓释片每日一次，两组均允许按需稳定背景抗高血压治疗。研究全程共52周，其中双盲核心期为第1至12周（84±3天），双盲延长期为第13至52周（40周），治疗结束后设2周安全随访期。筛选期最长28天。随机化采用1:1分配，按基线IPSS严重度（13~19分与≥20分）及α1阻滞剂经治状态（是/否）进行分层。研究不设自适应设计、样本量再估计、疗效期中分析或独立安全审查委员会（SRC）；设立独立数据监查委员会（DMC），每4个月进行一次盲态安全性审阅。样本量基于以下假设确定：安慰剂组第12周IPSS下降6.0分、R7A-BD502组多降2.2分（共同标准差7.5，α=0.04），Qmax安慰剂组升高1.0 mL/s、试验组多升1.2 mL/s（共同标准差2.8，α=0.01），各终点把握度不低于90%，1:1分配共需约1,680例（每组840例），考虑10%脱落率后计划入组1,860例。主要分析集为修改意向治疗集（mITT），补救LUTS治疗记录为伴发事件并保留于mITT分析中。统计分析采用ANCOVA或MMRM模型，协变量包括基线值、分层因素、访视及访视×治疗交互项，按α分配控制总体I类错误并报告95%置信区间；关键次要终点按层级顺序检验；敏感性分析包含多重填补（补救治疗回归填补）与安慰剂组截断。","rationale":"研究设计类型（随机、双盲、安慰剂对照、两臂平行、多中心、III期）、药物与对照（R7A-BD502 75mg vs 匹配安慰剂）、双盲期与延长期时长（12+40=52周）、安全随访（2周）、筛选期（最长28天）、随机化方式（1:1，按IPSS严重度与α1阻滞剂经治状态分层）、DMC设置（每4个月盲态安全审阅）、无自适应/无期中分析/无SRC、样本量假设与计算（1,680→1,860例）、估计目标策略（治疗策略，补救治疗保留于mITT）、统计方法（ANCOVA/MMRM、α分配、层级检验、多重填补敏感性分析）均直接来源于当前项目已确认研究事实。医学经理需确认：（1）DMC章程中盲态审阅的具体触发条件与沟通路径；（2）紧急揭盲程序与操作时限；（3）多中心数量与中心筛选标准；（4）背景抗高血压治疗的允许药物清单与稳定定义；（5）10%脱落率假设的文献或历史数据支撑。","review_advisories":["本节复述高影响研究设计（研究设计）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（α、伴发事件、期中分析、样本量、计划入组）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3084cb2bd954_49dc1bdbb06517e4","section_number":"4","source_ids":["protocol_full_draft_selection:7a00266acb19d217b63519ad","current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a39ca85bd6481","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:9278a21ab7462f","company_corpus:cms_cn_protocol_corpus_20260715_v1:367cbc36976ba5","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca"]}],"source_bindings":[{"content_sha256":"0205660df4116c8ede95cdf1b565c8dd79997a9eed2fdc6267091dad8a2364d0","locator":"document:mwdoc_greenfield_proj_user_3084cb2bd954_1e9851ab3c5d5a9d:full-draft:7a00266acb19d217b63519ad","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:7a00266acb19d217b63519ad","source_type":"protocol_full_draft_selection","source_version":"full-draft:ae9cedc141106e5e430beb62d18a37b02195351499d3c84827d77781412af1cc:7a00266acb19d217b63519ad","text_sha256":"0205660df4116c8ede95cdf1b565c8dd79997a9eed2fdc6267091dad8a2364d0"},{"content_sha256":"e8eb420597583eecf861b0865f05cd3125176647cb283075199484e144f000a4","locator":"study_definition:mwdefinition_b42f0e126b007fed71bb:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_b42f0e126b007fed71bb:r4:5f9a3