ction:文档开头|block:26|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","source_type":"company_protocol_reference_corpus","source_version":"63ce4061f946ca","text_sha256":"33118fc6958419e645c6a0a19471c78f80e0c4c28be03b46f2b3e61d287e0305"}]}