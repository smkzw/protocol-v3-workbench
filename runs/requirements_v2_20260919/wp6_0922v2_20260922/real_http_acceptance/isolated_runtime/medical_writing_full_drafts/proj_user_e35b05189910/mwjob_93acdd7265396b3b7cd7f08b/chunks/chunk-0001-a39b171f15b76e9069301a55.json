采用Banff标准复合终点，由盲态中央病理评估确认","quote_sha256":"c8cd9d75d35c3bec5e55c7c98e049433a54a02301dd0a1242ae27848c47e8cac","source_id":"current_project_study_definition:mwdefinition_8b61c5d9e7c3ec68ecf3:r8:167dc4e656d9e4ca","span_id":"es3"},{"locator":"study_definition:mwdefinition_8b61c5d9e7c3ec68ecf3:revision:8","quote":"研究时期：双盲主治疗期12个月；安全随访12个月","quote_sha256":"abde817822f8ff518ff59c0488831533ffdcdf5956a4b389cbc557cdb39d2b80","source_id":"current_project_study_definition:mwdefinition_8b61c5d9e7c3ec68ecf3:r8:167dc4e656d9e4ca","span_id":"es4"},{"locator":"study_definition:mwdefinition_8b61c5d9e7c3ec68ecf3:revision:8","quote":"研究人群概述：18–70岁肾移植受者，移植后3–12个月，eGFR≥30 mL/min/1.73m²，背景免疫抑制稳定，存在供体特异性抗体（DSA）或高免疫学风险，能够接受协议活检并签署知情同意","quote_sha256":"9e95179472949b0092937d62706fb6eac512aa3e9b7795d734d65a88ff648f47","source_id":"current_project_study_definition:mwdefinition_8b61c5d9e7c3ec68ecf3:r8:167dc4e656d9e4ca","span_id":"es5"}],"evidence_review_advisories":[],"evidence_span_ids":["es1","es2","es3","es4","es5"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"补充两组预期事件率、把握度、脱落率及由此推导的样本量数值","category":"source_missing","gap_id":"gap_summary_sample_size","missing_source_classes":["正式样本量计算文件","统计设计说明书"],"target":"方案概要样本量段落"},{"action":"确认治疗期每4周访视是否包含心电图、体格检查、依从性评价等具体检查项目","category":"source_missing","gap_id":"gap_summary_visit_detail","missing_source_classes":["访视计划表","安全性评估方案"],"target":"方案概要访视策略段落"}],"heading":"方案概要","missing_source_classes":["正式样本量计算文件","访视计划表"],"proposal_text":"本研究为随机、双盲、安慰剂对照、平行分组、多中心III期确证性研究，旨在评价R6E-KZ-6210在肾移植受者中预防慢性活动性排斥反应的疗效与安全性。研究人群为18至70岁肾移植受者，移植后3至12个月，eGFR≥30 mL/min/1.73m²，背景免疫抑制稳定，存在供体特异性抗体（DSA）或高免疫学风险，能够接受协议活检并签署知情同意。试验组在他克莫司、霉酚酸类和泼尼松标准背景免疫抑制之上加用KZ-6210 162 mg皮下注射每4周一次；对照组使用外观匹配安慰剂皮下注射每4周一次，背景治疗相同。主要终点为第12个月协议活检证实的慢性活动性排斥发生率，采用Banff标准复合终点，由盲态中央病理评估确认。研究时期包括双盲主治疗期12个月及安全随访12个月。主要分析集为mITT，安全集为至少接受一次研究治疗的受试者；主要终点比较两组12个月事件发生率并报告效应量及置信区间。样本量采用双侧α=0.05，按预计事件率计算，具体数值待正式设计文件确认。","rationale":"本段正文依据当前项目已确认研究事实中的总体设计、干预方案、研究人群、主要及次要终点、研究时期、访视策略和统计分析策略撰写。样本量具体数值因缺少两组预期事件率、把握度和脱落率而未填入，需医学负责人在正式设计文件中补充。访视中是否每次均包含心电图、体格检查或依从性评价未明确，不得自行推断。","review_advisories":["本节复述高影响研究设计（方案概要）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（α、主要终点、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_e35b05189910_7dfdb07f6d6da299","section_number":"1","source_ids":["protocol_full_draft_selection:a39b171f15b76e9069301a55","current_project_study_definition:mwdefinition_8b61c5d9e7c3ec68ecf3:r8:167dc4e656d9e4ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:8906e921bf8a9f","company_corpus:cms_cn_protocol_corpus_20260715_v1:367cbc36976ba5"]},{"ai_run_id":"airun_20261006122128_9e018b9a","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"检索并纳入慢性移植肾排斥反应发病率、患病率及移植后发生率数据","category":"source_missing","gap_id":"gap_disease_epidemiology","missing_source_classes":["流行病学文献","疾病负担报告"],"target":"疾病背景及治疗现状-流行病学段落"},{"action":"纳入现行肾移植后免疫抑制治疗指南及标准方案局限性描述","category":"source_missing","gap_id":"gap_disease_treatment_landscape","missing_source_classes":["诊疗指南","治疗现状综述","未满足需求文献"],"target":"疾病背景及治疗现状-治疗现状段落"}],"heading":"疾病背景及治疗现状","missing_source_classes":["慢性移植肾排斥反应流行病学文献","肾移植后慢性活动性排斥疾病负担数据","KDIGO或中国肾移植诊疗指南","当前标准免疫抑制治疗现状综述"],"proposal_text":"","rationale":"本章节需要慢性移植肾排斥反应的流行病学数据（发病率、患病率、移植后发生率）、疾病负担描述（移植物丢失率、患者生存影响、经济负担）、现行诊疗指南（如KDIGO、中国肾移植指南）及当前标准治疗现状（他克莫司、霉酚酸类、泼尼松方案的局限性和未满足需求）等来源方可撰写实质正文。当前允许来源中无上述任何类别资料，公司语料为青少年特应性皮炎和炎症性皮肤病方案，属不同适应症，不得迁移疾病特异内容。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_e35b05189910_ce86613bef24bef5","section_number":"2.1","source_ids":["protocol_full_draft_selection:a39b171f15b76e9069301a55","current_project_study_definition:mwdefinition_8b61c5d9e7c3ec68ecf3:r8:167dc4e656d9e4ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:8906e921bf8a9f","company_corpus:cms_cn_protocol_corpus_20260715_v1:367cbc36976ba5"]},{"ai_run_id":"airun_20261006122128_9e018b9a","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_8b61c5d9e7c3ec68ecf3:revision:8","quote":"靶点/作用机制：阻断IL-6通路、抑制B细胞活化，减少供体特异性抗体介导的慢性移植物损伤","quote_sha256":"eb037706f5689e1808424bc6b09ef0baad9cc63cd5c349ff4efc82169967052e","source_id":"current_project_study_definition:mwdefinition_8b61c5d9e7c3ec68ecf3:r8:167dc4e656d9e4ca","span_id":"es7"},{"locator":"study_definition:mwdefinition_8b61c5d9e7c3ec68ecf3:revision:8","quote":"药物技术类型：monoclonal_antibody\n给药途径：皮下注射\n剂型：注射剂\n局部/系统暴露范围：systemic","quote_sha256":"be2cd9a7f2adf0ea47a62c87489510f7288669fc5d43c9b33d115517fac05951","source_id":"current_project_study_definition:mwdefinition_8b61c5d9e7c3ec68ecf3:r8:167dc4e656d9e4ca","span_id":"es8"}],"evidence_review_advisories":[],"evidence_span_ids":["es7","es8"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"纳入IB或独立非临床研究报告中的药理学、毒理学及药代动力学数据","category":"source_missing","gap_id":"gap_drug_nonclinical","missing_source_classes":["研究者手册","非临床研究报告"],"target":"研究药物简介-非临床数据段落"},{"action":"纳入既往临床研究（如I/II期）的安全性、有效性及PK/PD数据","category":"source_missing","gap_id":"gap_drug_prior_clinical","missing_source_classes":["既往临床研究报告","同类药物安全性文献"],"target":"研究药物简介-既往临床数据段落"}],"heading":"研究药物简介","missing_source_classes":["研究者手册（IB）","非临床药理学研究报告","非临床毒理学研究报告","既往临床研究数据"],"proposal_text":"R6E-KZ-6210是一种抗IL-6受体（IL-6R）单克隆抗体，通过阻断IL-6信号通路、抑制B细胞活化，减少供体特异性抗体介导的慢性移植物损伤，从而预防肾移植受者慢性活动性排斥反应。本品为注射剂，采用皮下注射给药，属全身性暴露。在本研究中，试验组在标准背景免疫抑制（他克莫司、霉酚酸类和泼尼松）之上加用KZ-6210 162 mg皮下注射每4周一次；对照组使用外观匹配安慰剂皮下注射每4周一次，背景治疗与试验组相同。","rationale":"本段正文依据当前项目已确认研究事实中的靶点/作用机制、药物技术类型、给药途径、剂型、暴露范围及干预方案撰写。研究药物的非临床药理学数据、毒理学特征、既往临床研究结果、药代动力学参数及已知安全性风险信号等尚未提供，需待研究者手册或相关非临床/既往临床资料补充后方可完善本章节。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_e35b05189910_92885d8662c6b43f","section_number":"2.3","source_ids":["protocol_full_draft_selection:a39b171f15b76e9069301a55","current_project_study_definition:mwdefinition_8b61c5d9e7c3ec68ecf3:r8:167dc4e656d9e4ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:8906e921bf8a9f","company_corpus:cms_cn_protocol_corpus_20260715_v1:367cbc36976ba5"]},{"ai_run_id":"airun_20261006122128_9e018b9a","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"纳入体外IL-6R结合及信号通路抑制数据、动物移植物排斥模型疗效数据","category":"source_missing","gap_id":"gap_nonclinical_pharm","missing_source_classes":["非临床药理学研究报告","IB"],"target":"非临床研究结果-药理学段落"},{"action":"纳入重复给药毒性、免疫毒性、生殖毒性及局部耐受性数据","category":"source_missing","gap_id":"gap_nonclinical_tox","missing_source_classes":["非临床毒理学研究报告","IB"],"target":"非临床研究结果-毒理学段落"},{"action":"纳入非临床PK/PD及毒代动力学数据","category":"source_missing","gap_id":"gap_nonclinical_pk","missing_source_classes":["药代动力学研究报告","IB"],"target":"非临床研究结果-药代动力学段落"}],"heading":"非临床研究结果","missing_source_classes":["研究者手册（IB）","非临床药理学研究报告","非临床毒理学研究报告","药代动力学/毒代动力学研究报告"],"proposal_text":"","rationale":"本章节需要R6E-KZ-6210的非临床药理学研究结果（体外IL-6R结合亲和力、信号通路抑制数据、动物模型中移植物排斥抑制效果）、非临床毒理学研究结果（重复给药毒性、生殖毒性、免疫毒性、局部耐受性）、药代动力学/毒代动力学数据及安全性药理学数据方可撰写实质正文。当前允许来源中无研究者手册、非临床研究报告或任何非临床数据资料，无法形成有实质信息的正文。","review_advisories":[