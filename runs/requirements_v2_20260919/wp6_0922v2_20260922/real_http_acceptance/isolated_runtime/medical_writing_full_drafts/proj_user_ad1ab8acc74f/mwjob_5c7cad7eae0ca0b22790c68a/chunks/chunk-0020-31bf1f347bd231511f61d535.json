:28e671543798db"]},{"ai_run_id":"airun_20261010044139_73b22746","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"需确认正常关闭与提前关闭的触发条件、通知时限及关闭前必完成事项","category":"source_missing","gap_id":"gap_12_6_01","missing_source_classes":["研究中心关闭SOP","申办方项目管理计划"],"target":"研究中心关闭触发条件与程序"},{"action":"需确认数据保存期限、文件归档责任方及归档地点","category":"source_missing","gap_id":"gap_12_6_02","missing_source_classes":["数据管理计划","文件管理SOP"],"target":"数据保存与文件归档"},{"action":"需确认关闭时剩余药物回收流程、销毁方式及记录要求","category":"source_missing","gap_id":"gap_12_6_03","missing_source_classes":["药物管理SOP","药物回收与销毁程序"],"target":"试验用药品回收与销毁"}],"heading":"研究和研究中心的关闭","missing_source_classes":["研究中心关闭SOP或关闭检查清单","提前终止/关闭触发条件及通知程序","数据保存期限及归档要求","试验用药品回收与销毁程序"],"proposal_text":"","rationale":"当前项目来源确认研究总周期为筛选期（D-14至D-1）加双盲治疗期（D1至D56）加安全性随访期（D57至D70），但未提供研究中心关闭的触发条件（如入组完成、提前终止、安全性事件触发）、关闭前程序（末例受试者访视后数据清理、药物回收、文件归档）、数据保存期限、提前关闭通知程序及关闭后随访安排等项目级来源。研究时期信息仅描述时间框架，不构成关闭程序来源。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ad1ab8acc74f_f8ab4008d24884f0","section_number":"12.6","source_ids":["protocol_full_draft_selection:31bf1f347bd231511f61d535","current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]},{"ai_run_id":"airun_20261010044139_73b22746","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:数据质量保证|block:932|chunk:1","quote":"研究中心质量保证人员对数据转移文件、统计报告数据进行抽查，保证数据准确无误。申办者根据需要，结合试验进展情况及质量控制人员/监查员的核查结果，可对上述临床研究过程产生的数据进行不同范畴的稽查。","quote_sha256":"84e30f7a8178b6ecebc4f6b8272c753029708f78a4aea8f02201d0abf4225b0b","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db","span_id":"es4"},{"locator":"study_definition:mwdefinition_dd1f824d61cf7b35fc07:revision:9","quote":"总体研究设计：多中心、随机、双盲、安慰剂平行对照、三剂量组（0.25mg BID/0.5mg BID/安慰剂1:1:1）设计；血液透析人群口服给药8周+2周安全随访。","quote_sha256":"ff89aadf0a5e3a7b1e9988d83dcad40a78e8f74fba4ca5f2d6693b318d6c2c8c","source_id":"current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492","span_id":"es2"}],"evidence_review_advisories":[],"evidence_span_ids":["es4","es2"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":1},"gap_items":[{"action":"需确认数据核查频率、核查工具及质量控制指标","category":"source_missing","gap_id":"gap_12_7_01","missing_source_classes":["项目质量控制计划","数据管理计划"],"target":"质量控制频率与核查工具"},{"action":"需确认稽查触发条件、是否安排独立稽查及稽查报告路径","category":"source_missing","gap_id":"gap_12_7_02","missing_source_classes":["项目稽查计划","申办方质量管理系统文件"],"target":"稽查触发条件与独立稽查安排"},{"action":"需确认质量控制发现偏差后的报告、纠正及预防措施流程","category":"source_missing","gap_id":"gap_12_7_03","missing_source_classes":["项目质量控制SOP"],"target":"质量控制偏差处理流程"}],"heading":"质量控制与保证","missing_source_classes":["项目质量控制计划或稽查计划","数据核查工具及核查频率","独立质量保证部门职责及稽查触发条件","质量控制指标及偏差处理流程"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂平行对照设计，质量控制与保证工作覆盖从筛选期至安全性随访期结束的全部研究阶段。研究中心质量保证人员对数据转移文件及统计报告数据进行抽查，以保证数据准确无误。申办者根据研究进展情况及质量控制人员与监查员的核查结果，可对临床研究过程产生的数据进行不同范畴的稽查。稽查范围、频率及具体实施安排由申办方质量管理部门根据项目需要确定。","rationale":"公司语料提供数据质量保证人员抽查及申办者稽查的一般性结构参照，已作为措辞和结构参考纳入正文。当前项目来源确认多中心设计及研究时期框架，但未提供本项目质量控制的具体频率、稽查触发条件、独立稽查安排、数据核查工具或质量控制指标等项目级实施细节。正文中稽查范围与频率表述为'由申办方质量管理部门根据项目需要确定'，未虚构具体数值或固定方法清单。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ad1ab8acc74f_e2f1d684f5861e1e","section_number":"12.7","source_ids":["protocol_full_draft_selection:31bf1f347bd231511f61d535","current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492","company_corpus:cms_cn_protocol_corpus_20260715_v1:28e671543798db"]}],"source_bindings":[{"content_sha256":"f5a1376233580394931d3cb12dbe707b7c325a561269ead91f7304673a37348b","locator":"document:mwdoc_greenfield_proj_user_ad1ab8acc74f_6d9208d7233030ca:full-draft:31bf1f347bd2315