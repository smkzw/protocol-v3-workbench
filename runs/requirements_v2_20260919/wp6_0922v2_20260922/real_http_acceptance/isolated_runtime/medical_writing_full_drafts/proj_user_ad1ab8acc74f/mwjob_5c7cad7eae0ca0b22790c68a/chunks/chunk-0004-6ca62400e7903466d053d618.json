:"5ae099854f1c81e3d5a4d36c7ff972274c6a59a76bbf03c69ee4a7c43af1ab13","source_id":"current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492","span_id":"es_003"}],"evidence_review_advisories":[],"evidence_span_ids":["es_001","es_002","es_003"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"获取KRX-203非临床及既往临床PK数据后，确定具体采样时间点","category":"source_missing","gap_id":"gap_pk_times","missing_source_classes":["KRX-203非临床药代动力学报告","KRX-203既往临床PK数据"],"target":"4.2.2 PK/PD采集点设计依据"}],"heading":"PK/PD采集点设计依据","missing_source_classes":["KRX-203非临床药代动力学报告","KRX-203既往临床PK数据","血液透析对药物清除影响的文献"],"proposal_text":"本研究将药代动力学与药效动力学特征作为探索性研究组成部分，旨在探索KRX-203的血药浓度与瘙痒改善之间的暴露-效应关系，为后续III期剂量选择提供依据。PK/PD数据采集依托研究访视框架实施，访视安排为筛选、基线/D1、W2、W4、W6、W8终点及W10安全随访，均于透析日进行，窗口±3天，每2周一次透析日院内访视。具体PK采样时间点（包括给药前谷浓度及给药后各峰浓度采样时刻）需依据KRX-203非临床药代动力学数据、口服生物利用度特征及血液透析对药物清除的影响另行制定，本章节暂不预设具体采样时刻。PD相关数据采集与主要终点WI-NRS周平均值评估及睡眠质量、生活质量量表评估同步进行。","rationale":"探索性目的与终点（剂量-反应关系及PK特征、血药浓度与瘙痒改善的暴露-效应关系）为已确认研究事实；访视框架（每2周透析日、±3天窗口）为已确认事实。具体PK采样时刻需结合药物半衰期及透析清除特性由医学团队确认。","review_advisories":["本节提及高影响设计信息（主要终点、剂量选择）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ad1ab8acc74f_be408ccdc94040c0","section_number":"4.2.2","source_ids":["protocol_full_draft_selection:6ca62400e7903466d053d618","current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb71242d679bdb","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322"]},{"ai_run_id":"airun_20261010040223_c299d936","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_dd1f824d61cf7b35fc07:revision:9","quote":"多中心、随机、双盲、安慰剂平行对照、三剂量组（0.25mg BID/0.5mg BID/安慰剂1:1:1）设计","quote_sha256":"c645026d1b15d72eb6447e080a34fc6bab844e53f48fbf3aac0da58e7b1153f5","source_id":"current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492","span_id":"es_004"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[{"action":"由独立统计师确定区组大小、分层因素及随机数生成工具","category":"source_missing","gap_id":"gap_random_method","missing_source_classes":["随机化方案"],"target":"4.3 随机化"}],"heading":"随机化","missing_source_classes":["随机化方案","IWRS/IRT系统配置说明"],"proposal_text":"本研究采用随机化分配，受试者按1:1:1比例随机分配至0.25mg BID组、0.5mg BID组及安慰剂组，三组平行对照。随机化在基线/D1访视时完成，随机后即刻开始给药。本研究为多中心设计，随机化方案的具体实施细节（包括区组大小、是否按中心或基线瘙痒强度分层、随机数生成方法及随机化系统）需由独立统计师制定随机化方案后确定。","rationale":"1:1:1三组平行分配及双盲设计为已确认研究事实。随机化具体方法（区组、分层、工具）未在允许来源中明确，需由统计师确认。","review_advisories":["本节复述高影响研究设计（随机化）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ad1ab8acc74f_8ba1176ae0843970","section_number":"4.3","source_ids":["protocol_full_draft_selection:6ca62400e7903466d053d618","current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb71242d679bdb","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322"]},{"ai_run_id":"airun_20261010040223_c299d936","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_ad1ab8acc74f_6d9208d7233030ca:full-draft:6ca62400e7903466d053d618","quote":"本研究采用双盲设计。","quote_sha256":"fe6efce93e02fe3c382cf514c2c89d4778531866fbff09bb8ca822e03e54e66a","source_id":"protocol_full_draft_selection:6ca62400e7903466d053d618","span_id":"es_005"},{"locator":"section:6.3.3 揭盲|block:490|chunk:1","quote":"紧急揭盲借助IWRS中","quote_sha256":"60f7f308cc31286e41cd0e263ec3058002ea024fab20328dd9ee9d91a101af72","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","span_id":"es_006"}],"evidence_review_advisories":[],"evidence_span_ids":["es_005","es_006"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":0},"gap_items":[{"action":"确认本项目盲态维持人员范围、紧急揭盲具体操作流程及正式揭盲时点","category":"source_missing","gap_id":"gap_blinding_details","missing_source_classes":["本项目IWRS/IRT系统配置说明","紧急揭盲SOP"],"target":"4.4 盲法与揭盲"}],"heading":"盲法与揭盲","missing_source_classes":["本项目IWRS/IRT系统配置说明","盲法维持人员清单","紧急揭盲SOP"],"proposal_text":"本研究采用双盲设计，试验药物KRX-203片与安慰剂在外观、气味及包装上保持一致，受试者、研究者及研究相关人员对受试者所接受的治疗类别（试验药物或安慰剂）均不知情。紧急揭盲通过IWRS系统执行，研究者登录IWRS系统并使用揭盲功能，输入揭盲原因后获知受试者使用的实际药物，系统将记录揭盲人员、原因和时间。受试者被揭盲后将终止试验用药品治疗。研究结束后的正式揭盲在数据经盲态核查、清理并确定统计分析集后，由授权人员执行，将各受试者的随机编号所对应的组别告知统计人员，以便对全部数据进行统计分析。","rationale":"双盲设计为已确认研究事实。紧急揭盲通过IWRS执行及揭盲后终止治疗、正式揭盲在数据锁定后由授权人员执行，来源于公司语料结构参照，需确认本项目是否采用相同流程及具体操作细节。","review_advisories":["本节复述高影响研究设计（盲法与揭盲）；请在合并设计摘要中统一核对。","本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ad1ab8acc74f_96996a7c6780a4b4","section_number":"4.4","source_ids":["protocol_full_draft_selection:6ca62400e7903466d053d618","current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492","company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","company_corpus:cms_cn_protocol_corpus_20260715_v1:4a27cdd782c3be","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb71242d679bdb","company_corpus:cms_cn_protocol_corpus_20260715_v1:046677b43d417b","company_corpus:cms_cn_protocol_corpus_20260715_v1:8b49478f82c322"]},{"ai_run_id":"airun_20261010040223_c299d936","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"由医学团