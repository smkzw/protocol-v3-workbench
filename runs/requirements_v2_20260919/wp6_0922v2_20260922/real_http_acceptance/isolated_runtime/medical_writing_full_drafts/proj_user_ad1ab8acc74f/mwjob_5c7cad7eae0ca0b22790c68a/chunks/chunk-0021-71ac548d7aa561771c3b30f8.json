e_id":"current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492","span_id":"es001"}],"evidence_review_advisories":[],"evidence_span_ids":["es004","es001"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":1},"gap_items":[{"action":"由医学经理确认附录是否仅包含避孕、量表、实验室检查三个子节，或需补充其他附录内容","category":"source_missing","gap_id":"gap_14_001","missing_source_classes":["项目级附录目录清单"],"target":"附录子节完整清单"}],"heading":"附录","missing_source_classes":["项目级附录目录清单","CRF/知情同意书模板清单"],"proposal_text":"本附录汇集研究方案正文中引用的辅助性技术文件与操作规范，供研究者、监查员及伦理委员会在方案执行与核查时查阅。附录涵盖以下三个子节：避孕的规定与方法，明确育龄期受试者在研究期间及末次给药后一定时期内应遵循的避孕要求与妊娠监测安排；研究量表和评价工具，列明本研究所采用的瘙痒强度评估、睡眠质量评估、生活质量评估及安全性评价工具的名称、版本、评分规则与采集时点；实验室检查项目，规定安全性评估中涉及的血液学、生化、尿液及心电图等检查的具体项目、采集时点与异常判定标准。各子节的具体参数以对应子节正文为准，本附录不重复正文中已规定的访视日程、给药方案或统计分析方法。","rationale":"本章节为容器型附录，其引导性正文依据章节结构信息（附录类型、三个子节标题）及已确认研究事实中涉及的量表名称（WI-NRS、JSQ-BM、Skindex-17/DLQI）和安全性评估类别（实验室检查、12导联ECG）撰写。医学经理需确认：（1）附录是否还需纳入其他子节（如知情同意书模板、CRF示例、方案偏离报告表等）；（2）各子节的具体参数是否需在本引导段中预告。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ad1ab8acc74f_128b4dae7334d87e","section_number":"14","source_ids":["protocol_full_draft_selection:71ac548d7aa561771c3b30f8","current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492","company_corpus:cms_cn_protocol_corpus_20260715_v1:semantic_window:6520ebbe09a51d:c0f9d8189ccfc6:85ee0ac32bdcdc:ed8c7e23cb9a85:f4b0433bf35190:c9b1b1d4f3b846","company_corpus:cms_cn_protocol_corpus_20260715_v1:semantic_window:c0f9d8189ccfc6:85ee0ac32bdcdc:ed8c7e23cb9a85:f4b0433bf35190:c9b1b1d4f3b846:e7a96b3314e879"]},{"ai_run_id":"airun_20261010044403_b8d09d0c","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取KRX-203 IB中生殖毒性章节及申办方医学团队确认的避孕方法清单、妊娠检查日程、男性避孕要求","category":"source_missing","gap_id":"gap_14_002","missing_source_classes":["KRX-203 IB生殖毒性章节","项目避孕实施规范"],"target":"避孕方法具体规定"},{"action":"检索本项目是否已有妊娠报告SOP或方案附件，确认报告对象、时限及新生儿随访安排","category":"source_not_retrieved","gap_id":"gap_14_003","missing_source_classes":["项目妊娠报告SOP","新生儿随访方案"],"target":"妊娠报告与随访流程"}],"heading":"避孕的规定与方法","missing_source_classes":["KRX-203研究者手册（IB）中生殖毒性与避孕建议","本项目避孕方法具体规定（可接受/不可接受方法清单）","妊娠检查时点与频率安排","男性参与者避孕要求及伴侣妊娠报告流程"],"proposal_text":"","rationale":"本项目已确认研究事实中仅包含入选标准'育龄期女性妊娠试验阴性并同意避孕'及排除标准'妊娠或哺乳期'，未给出具体避孕方法清单、妊娠检查时点与频率、男性参与者避孕要求、伴侣妊娠报告流程或新生儿随访安排。公司语料CMS-D017为不同药物（非κ阿片受体激动剂）、不同分期（I期）、不同适应症的方案，其避孕条款（含杀精剂避孕套、末次给药后每隔一个月经周期妊娠检查、男性末次给药后3个月避孕等）属于该项目特定实施规则，不可迁移至KRX-203 II期项目。本章节需由医学经理依据KRX-203的非临床生殖毒性数据、给药途径（口服）、治疗周期（8周）及随访期（2周）确定具体避孕规定后撰写。","review_advisories":["本节复述高影响研究设计（避孕的规定与方法）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ad1ab8acc74f_782064d9a474b669","section_number":"14.1","source_ids":["protocol_full_draft_selection:71ac548d7aa561771c3b30f8","current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492","company_corpus:cms_cn_protocol_corpus_20260715_v1:semantic_window:6520ebbe09a51d:c0f9d8189ccfc6:85ee0ac32bdcdc:ed8c7e23cb9a85:f4b0433bf35190:c9b1b1d4f3b846","company_corpus:cms_cn_protocol_corpus_20260715_v1:semantic_window:c0f9d8189ccfc6:85ee0ac32bdcdc:ed8c7e23cb9a85:f4b0433bf35190:c9b1b1d4f3b846:e7a96b3314e879"]},{"ai_run_id":"airun_20261010044403_b8d09d0c","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_dd1f824d61cf7b35fc07:revision:9","quote":"主要终点：第8周瘙痒WI-NRS周平均值较基线下降≥4分的受试者比例。次要终点：W2/W4/W6/W8 WI-NRS周平均值较基线变化；EASI无关；睡眠质量（JSQ-BM）与生活质量（Skindex-17或DLQI）较基线变化；应答维持时间；安全性终点（TEAE/SAE发生率、生命体征、实验室检查、12导联ECG）。探索性终点：血药浓度与瘙痒改善的暴露-效应关系。","quote_sha256":"03bf8338246eecc5ceb6b7c2c17a01d1f0a58bbd1dd19c3fc373d3ac15f351df","source_id":"current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492","span_id":"es001"},{"locator":"study_definition:mwdefinition_dd1f824d61cf7b35fc07:revision:9","quote":"安全性终点：TEAE/SAE发生率；生命体征；实验室检查；12导联ECG","quote_sha256":"95651d830fe46eff275efe136f929c337dc36f391eb797da359f6219281a6112","source_id":"current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492","span_id":"es002"}],"evidence_review_advisories":[],"evidence_span_ids":["es001","es002"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"由医学经理根据CKD-aP领域文献及监管沟通结果确定最终量表，并确认版本与授权","category":"decision_pending","gap_id":"gap_14_004","missing_source_classes":[],"target":"生活质量量表最终选择（Skindex-17 vs DLQI）"},{"action":"确认WI-NRS是否要求受试者每日记录（ePRO/纸质日记卡）还是仅访视时回顾7天，以及周平均值的计算规则","category":"source_missing","gap_id":"gap_14_005","missing_source_classes":["ePRO操作手册","量表使用培训材料"],"target":"WI-NRS每日记录操作规范"},{"action":"确认ECG是否仅在筛选、基线、W4、W8、W10采集，还是W2/W6也需采集；确认QTcF异常时的复测与处理流程","category":"source_missing","gap_id":"gap_14_006","missing_source_classes":["项目安全性评估操作规范"],"target":"ECG完整采集时点"}],"heading":"研究量表和评价工具","missing_source_classes":["Skindex-17与DLQI最终选择确认","各量表版本、授权与培训文件","WI-NRS每日记录与周平均计算的具体操作规范","ECG采集完整时点清单"],"proposal_text":"本研究所采用的瘙痒强度评估工具为瘙痒数字评分量表（WI-NRS），以7天回顾期每日最严重瘙痒强度的周平均值作为主要疗效评价指标，采集时点为筛选期（D-14至D-1）、基线/D1、W2、W4、W6、W8及W10安全随访，每次访视于透析日完成。睡眠质量评估采用Brief Maternal Quality of Sleep Questionnaire（JSQ-BM），评价受试者睡眠质量较基线的变化。生活质量评估采用Skindex-17或DLQI，评价受试者皮肤相关生活质量较基线的变化。安全性评价中，12导联心电图（ECG）用于监测QTcF间期变化；生命体征（血压、心率、体温、呼吸频率）于院内访视采集。上述量表与工具的版本、授权许可、研究者培训及电子采集平台配置等实施细节，由申办方在方案定稿前与相关供应商及伦理委员会确认。","rationale":"本章节正文依据已确认研究事实中明确列出的量表名称（WI-NRS、JSQ-BM、Skindex-17或DLQI）、安全性评估工具（12导联ECG、生命体征）及访视策略（筛选、基线/D1、W2、W4、W6、W8、W10，每2周一次透析日院内访视，窗口±3天）撰写。Skindex-17与DLQI为二选一，尚未最终确定；各量表的具体版本（如DLQI中文验证版版本号）、JSQ-BM的完整名称与授权、ECG采集的具体时点是否覆盖W2/W6、以及量表是否仅在透析日采集还是居家每日记录（WI-NRS的7天回顾期是否要求每日记录）均需医学经理确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ad1ab8acc74f_dad15d285d060625","section_number":"14.2","source_ids":["protocol_full_draft_selection:71