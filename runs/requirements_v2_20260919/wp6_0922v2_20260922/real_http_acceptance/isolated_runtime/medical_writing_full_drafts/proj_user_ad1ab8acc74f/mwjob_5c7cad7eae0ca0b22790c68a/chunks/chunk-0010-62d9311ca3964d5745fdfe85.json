evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"依据KRX-203非临床安全性数据及透析人群特殊监测需求确定实验室检查面板及各访视采集安排","category":"source_missing","gap_id":"gap_lab_panel","missing_source_classes":["Investigator's Brochure","非临床安全性研究报告"],"target":"7.3.3 实验室检查——具体检查项目与采集时点"}],"heading":"实验室检查","missing_source_classes":["Investigator's Brochure","非临床安全性研究报告","透析人群实验室监测指南"],"proposal_text":"本研究将实验室检查作为安全性评估的组成部分，用于监测KRX-203在维持性血液透析慢性肾病相关瘙痒患者中的安全性。研究访视安排为筛选期（D-14至D-1）、基线/D1、W2、W4、W6、W8终点及W10安全随访，均于透析日进行，窗口为±3天。鉴于受试人群为维持性血液透析患者，实验室检查结果的解读应充分考虑透析对血液学及生化指标的干扰，确保安全性判定的准确性。实验室检查的具体项目、各访视是否均实施采集、异常判定阈值及临床意义评估标准，需依据KRX-203非临床安全性数据及透析人群特殊监测需求确定。","rationale":"安全性终点明确包含实验室检查，访视策略给出筛选至W10共7个访视点且每2周一次透析日院内访视。但允许来源未列出具体检查项目、各访视是否均采集及异常判定阈值，需结合IB及非临床数据由医学负责人确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ad1ab8acc74f_75ac99a434e18b99","section_number":"7.3.3","source_ids":["protocol_full_draft_selection:62d9311ca3964d5745fdfe85","current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492"]},{"ai_run_id":"airun_20261010041808_1fe7d7df","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_dd1f824d61cf7b35fc07:revision:9","quote":"育龄期女性妊娠试验阴性并同意避孕","quote_sha256":"bfd78605caabbb40d167411c3e175f4e2adaf7339ef3e76062ab0a6c4aab651e","source_id":"current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492","span_id":"es_preg_inclusion"},{"locator":"study_definition:mwdefinition_dd1f824d61cf7b35fc07:revision:9","quote":"妊娠或哺乳期","quote_sha256":"b703a3d2d679f4c61fc5f87ed3017dfadd1bff9cc1d021a4c041f47c6c73ff9f","source_id":"current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492","span_id":"es_preg_exclusion"}],"evidence_review_advisories":[],"evidence_span_ids":["es_preg_inclusion","es_preg_exclusion"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"依据KRX-203生殖毒性数据确定可接受的避孕方法清单","category":"source_missing","gap_id":"gap_contraception_method","missing_source_classes":["KRX-203生殖毒性研究报告"],"target":"7.3.4 妊娠检查和避孕问询——具体避孕方法"},{"action":"确定各访视妊娠检查安排及意外妊娠报告流程","category":"source_missing","gap_id":"gap_pregnancy_schedule","missing_source_classes":["中国临床试验妊娠管理相关监管指南"],"target":"7.3.4 妊娠检查和避孕问询——妊娠检查频率与日程"}],"heading":"妊娠检查和避孕问询","missing_source_classes":["KRX-203生殖毒性研究报告","中国临床试验妊娠管理相关监管指南"],"proposal_text":"本研究在筛选期对育龄期女性受试者进行妊娠试验，结果为阴性方可入组；妊娠或哺乳期女性为排除标准。育龄期女性受试者须在签署知情同意书时同意在研究期间采取有效避孕措施。本章节涵盖妊娠检查的实施范围、避孕问询的内容与记录方式，以及研究期间意外妊娠的报告与处理流程。具体避孕方法、妊娠检查频率与日程、伴侣妊娠报告要求及新生儿随访安排，需依据KRX-203生殖毒性数据及中国相关监管要求确定。","rationale":"入选标准明确育龄期女性妊娠试验阴性并同意避孕，排除标准包含妊娠或哺乳期。但允许来源未指定具体避孕方法、妊娠检查日程、伴侣妊娠报告及新生儿随访要求，需依据生殖毒性数据及监管要求由医学负责人确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ad1ab8acc74f_4d3a8aaf6e18ceb2","section_number":"7.3.4","source_ids":["protocol_full_draft_selection:62d9311ca3964d5745fdfe85","current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492"]},{"ai_run_id":"airun_20261010041808_1fe7d7df","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_dd1f824d61cf7b35fc07:revision:9","quote":"探索性目的：探索剂量-反应关系及PK特征","quote_sha256":"5c0e21e442845619befa123d1e1a76129f9548bea4fba3ddb8abe1aa30819344","source_id":"current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492","span_id":"es_pk_exploratory"},{"locator":"study_definition:mwdefinition_dd1f824d61cf7b35fc07:revision:9","quote":"靶点/作用机制：κ阿片受体激动剂（外周限制性）","quote_sha256":"ebf9f90addb607c6cd308e6c98cd2cc98fbd4cfa1428eba91d930984af07b1be","source_id":"current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492","span_id":"es_drug_mech"},{"locator":"study_definition:mwdefinition_dd1f824d61cf7b35fc07:revision:9","quote":"KRX-203片：0.25mg BID（每日两次，每次1片，0.25mg规格）；0.5mg BID（每日两次，每次1片，0.5mg规格）；疗程8周；无负荷剂量","quote_sha256":"73d67a4c50134620fecd7293ba72ba7cba4e6257dcc7ce7b35988f31e4510f91","source_id":"current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492","span_id":"es_dosing"}],"evidence_review_advisories":[],"evidence_span_ids":["es_pk_exploratory","es_drug_mech","es_dosing"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"依据KRX-203非临床PK数据及透析清除特征确定采血时间点与采样方案","category":"source_missing","gap_id":"gap_pk_sampling","missing_source_classes":["KRX-203非临床药代动力学研究报告"],"target":"7.4 药代动力学评估——PK采血时间点与采样方案"}],"heading":"药代动力学评估","missing_source_classes":["KRX-203非临床药代动力学研究报告","透析对药物清除影响的文献或数据"],"proposal_text":"本研究将药代动力学特征评估列为探索性研究目的，旨在探索KRX-203在维持性血液透析慢性肾病相关瘙痒患者中的药代动力学特征，并分析血药浓度与瘙痒改善之间的暴露-效应关系。KRX-203为小分子口服固体制剂，给药途径为口服，系统暴露，剂量方案为0.25mg BID与0.5mg BID，疗程8周，无负荷剂量。药代动力学评估将结合上述剂量方案及透析日访视安排进行。PK采血时间点、采样方案（密集采样或稀疏采样）、生物分析方法及拟计算的PK参数，需依据KRX-203非临床药代动力学数据及透析对药物清除的影响确定。","rationale":"探索性目的明确包含PK特征，探索性终点为血药浓度与瘙痒改善的暴露-效应关系；药物为小分子口服制剂、系统暴露、0.25mg/0.5mg BID、8周疗程。但允许来源未给出PK采血时间点、采样方案或生物分析方法，需结合非临床PK数据及透析人群药动学特征由医学负责人确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ad1ab8acc74f_6b53d8ce55a8bfc0","section_number":"7.4","source_ids":["protocol_full_draft_selection:62d9311ca3964d5745fdfe85","current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492"]},{"ai_run_id":"airun_20261010041808_1fe7d7df","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_dd1f824d61cf7b35fc07:revision:9","quote":"探索性终点：血药浓度与瘙痒改善的暴露-效应关系","quote_sha256":"6a3d4db1653e1642659158210b63d390a185fa01e10602427c3ae7a87c802896","source_id":"current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492","span_id":"es_pd_exploratory"},{"locator":"study_definition:mwdefinition_dd1f824d61cf7b35fc07:revision:9","quote":"靶点/作用机制：κ阿片受体激动剂（外周限制性）","quote_sha256":"ebf9f90addb607c6cd308e6c98cd2cc98fbd4cfa1428eba91d930984af07b1be","source_id":"current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492","span_id":"es_drug_mech"},{"locator":"study_definition:mwdefinition_dd1f824d61cf7b35fc07:revision:9","quote":"KRX-203片：0.25mg BID（每日两次，每次1片，0.25mg规格）；0.5mg BID（每日两次，每次1片，0.5mg规格）；疗程8周；无负荷剂量","quote_sha256":"73d67a4c50134620fecd7293ba72ba7cba4e6257dcc7ce7b35988f31e4510f91","source_id":"current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492","span_id":"es_dosing"}],"evidence_review_advisories":[],"evidence_span_ids":["es_pd_exploratory","es_drug_mech","es_dosing"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"依据KRX-203非临床药效学数据及κ阿片受体激动剂类已知PD标志物确定评估方案","category":"source_missing","gap_id":"gap_pd_biomarker","missing_source_classes":["KRX-203非临床药效学研究报告"],"target":"7.5 药效动力学评估——PD生物标志物与评估方法"}],"heading":"药效动力学评估","missing_source_classes":["KRX-203非临床药效学研究报告","κ阿片受体激动剂类药效学生物标志物文献"],"proposal_text":"本研究将药效动力学评估列为探索性研究目的，旨在探索KRX-203的剂量-反应关系。KRX-203为外周限制性κ阿片受体激动剂，通过激动外周κ阿片受体发挥止痒作用，本研究设置0.25mg BID与0.5mg BID两个活性剂量组及安慰剂组，按1:1:1随机分配，疗程8周。药效动力学评估将围绕剂量-反应关系展开，探索不同剂量水平下药效学指标的变化特征。药效动力学生物标志物、采样时点、评估方法及剂量-反应关系的分析策略，需依据KRX-203非临床药效学数据及κ阿片受体激动剂类药物的已知药效学特征确定。","rationale":"探索性目的明确包含剂量-反应关系，药物机制为外周限制性κ阿片受体激动剂，设0.25mg BID与0.5mg BID两个活性剂量组。但允许来源未指定PD生物标志物、采样时点或具体评估方法，需结合非临床药效学数据由医学负责人确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ad1ab8acc74f_790d6cbfe1bdddb8","section_number":"7.5","source_ids":["protocol_full_draft_selection:62d9311ca3964d5745fdfe85","current_project_study_definition:mwdefinition_dd1f824d61cf7b35fc07:r9:e734f05c4d419492"]}],"source_bindings":[{"content_sha256":"a05c2a1fae0d246e5dd21c9d6377ec5033a5447735effd48c8dd8a30dcf70879","locator":"document:mwdoc_greenfield_proj_user_ad1ab8acc74f_6d9208d7233030ca:full-draft:62d9311ca3964d5745fdfe85","role":"current_working_draft_packet","source_id":