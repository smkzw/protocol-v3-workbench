cator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"筛选期25(OH)D≥20ng/mL（不足者预补充维生素D后复筛）","quote_sha256":"4ed3c70872a88a9ea298fded5a88af95fd79d305e4ce1164a0bdefc5db2ec82c","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es10"}],"evidence_review_advisories":[],"evidence_span_ids":["es3","es5","es6","es7","es8","es10"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"依据完整访视计划表确认每次访视需采集的实验室项目、采集频率及是否所有访视均包含全部项目","category":"source_not_retrieved","gap_id":"gap_14_3_01","missing_source_classes":["完整访视计划表","中心实验室操作手册"],"target":"各访视实验室检查完整清单与频率"},{"action":"确认ADA/NAb采集的具体访视时点（如基线、第3/6/12/18/24月等）及异常结果处理流程","category":"source_not_retrieved","gap_id":"gap_14_3_02","missing_source_classes":["免疫原性采样计划","中心实验室操作手册"],"target":"免疫原性采样时点与频率"}],"heading":"实验室检查项目","missing_source_classes":["完整访视计划表","中心实验室操作手册","各检查项目正常值范围与异常处理流程"],"proposal_text":"本研究实验室检查项目包括：筛选期实验室检查涵盖血清25(OH)D（要求≥20ng/mL，不足者预补充维生素D后复筛）、骨转换标志物（血清P1NP、sCTX、OSTEOCALCIN）、血常规、肝肾功能（含eGFR，要求≥35mL/min/1.73m²）、电解质、凝血功能、尿常规、空腹血糖及HbA1c（排除HbA1c>8.5%的糖尿病）、甲状腺功能（排除未控制的甲状腺功能亢进）、甲状旁腺激素（排除原发性甲状旁腺功能亢进）；治疗期及随访期实验室检查涵盖血常规、肝肾功能、电解质、骨转换标志物（P1NP、sCTX、OSTEOCALCIN）；免疫原性检测涵盖抗药抗体（ADA）及中和抗体（NAb），采集时点与频率按方案访视计划执行；心电图方面，筛选期及指定访视进行12导联心电图检查。上述实验室检查的具体采集时点、频率、正常值范围判定标准及异常处理流程，以方案访视计划表及中心实验室操作手册为准。","rationale":"筛选期实验室项目（25(OH)D、骨转换标志物、心电图）及排除标准中涉及的实验室指标（eGFR<35、HbA1c>8.5%、甲状腺功能、甲状旁腺功能）为项目已确认事实。免疫原性（ADA与中和抗体）为已确认安全性终点。但各实验室检查在全部访视中的具体项目清单、采集频率、正常值范围及异常处理流程未在允许来源中逐项列出，需依据完整访视计划表和中心实验室手册确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5770a077009c_80cdb290185c04a3","section_number":"14.3","source_ids":["protocol_full_draft_selection:35f2b000b03f18fb0eb3e58d","current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","company_corpus:cms_cn_protocol_corpus_20260715_v1:semantic_window:6520ebbe09a51d:c0f9d8189ccfc6:85ee0ac32bdcdc:e