4e14","quote":"当前正文=legacy-derived-background-1","quote_sha256":"d0f4e218d0ed6e1bb94f51c92c4b2f0da662dc22576ea6f2154e0b1c2a83c073","source_id":"protocol_full_draft_selection:5ba98fe77eb1d6e36a9f4e14","span_id":"es_bg_placeholder"}],"evidence_review_advisories":[],"evidence_span_ids":["es_bg_therapy","es_screening_details","es_bg_placeholder"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"获取项目背景治疗方案文件，明确钙剂与维生素D具体制剂、规格、依从性记录方式及合并用药限制","category":"source_missing","gap_id":"gap_bg_001","missing_source_classes":["背景治疗方案文件"],"target":"6.6.3 必须使用的背景治疗"}],"heading":"必须使用的背景治疗","missing_source_classes":["背景治疗方案文件（含制剂规格、依从性监测方法、合并/禁限用抗骨质疏松药物清单）"],"proposal_text":"本研究所有受试者在整个研究期间须接受钙剂与维生素D补充作为必需背景治疗。钙剂每日口服剂量为500至1000毫克，维生素D每日口服剂量为600至800国际单位，自随机化前筛选期起持续至研究结束。筛选期25-羟基维生素D水平低于20纳克每毫升的受试者，须在筛选期内完成维生素D预补充并达到上述阈值后方可进入随机化。背景治疗的具体制剂规格、依从性记录方式及合并用药限制等实施细节，将在项目实施方案文件中另行规定。","rationale":"项目已确认研究事实中试验干预与剂量给药方案均明确列出钙500~1000mg/日与维生素D600~800IU/日作为背景补充，排除标准中亦规定筛选期25(OH)D≥20ng/mL及预补充复筛机制。章节当前正文为legacy占位符，缺少具体背景治疗方案文件（制剂、依从性监测、合并用药规则），故标记为partial。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5770a077009c_43e77329a5176f29","section_number":"6.6.3","source_ids":["protocol_full_draft_selection:5ba98fe77eb1d6e36a9f4e14","current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","company_corpus:cms_cn_protocol_corpus_20260715_v1:6b24da94f33534","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb9c14bf455dec","company_corpus:cms_cn_protocol_corpus_20260715_v1:6eab08a4bddb3d","company_corpus:cms_cn_protocol_corpus_20260715_v1:f24b1a78f9c3f8"]},{"ai_run_id":"airun_20261005021644_69b8e320","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"研究时期：筛选期（最长6周，含维生素D预补充）；双盲治疗期（12个月，每月给药）；开放序贯期（12个月，地舒单抗每6个月）；安全随访期（末次给药后6个月）","quote_sha256":"79607c5c58c80bca5f1d97cffd38e58717d3606fdebe30300b4323fa51b2e078","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_study_periods"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"访视策略：筛选访视（D-42~D-1，胸腰椎X线、DXA、骨转换标志物、心电图、实验室）","quote_sha256":"925b9e0d0dcd93331a28984f2ffa5ab9213ceab4ade261eaa7af08a5f39a9d29","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_visit_strategy"}],"evidence_review_advisories":[],"evidence_span_ids":["es_study_periods","es_visit_strategy"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"获取各访视评估项目完整清单及访视流程图，确认DXA、X线、骨转换标志物、心电图、实验室检查在各访视的分配","category":"source_missing","gap_id":"gap_proc_001","missing_source_classes":["访视评估项目清单","访视流程图"],"target":"7 研究程序和评估"}],"heading":"研究程序和评估","missing_source_classes":["各访视完整评估项目清单（含DXA、胸腰椎X线、骨转换标志物、心电图、实验室检查的逐访视分配）","研究程序总览表或访视流程图"],"proposal_text":"本研究为随机、双盲、双模拟、安慰剂对照、平行组、事件驱动确证性III期临床研究，总体研究时期划分为四个阶段：筛选期最长6周（含维生素D预补充）；双盲治疗期12个月，试验组接受KZ301注射液105毫克皮下注射每月一次共12次，对照组接受匹配安慰剂皮下注射每月一次共12次；开放序贯期12个月，两组均接受地舒单抗60毫克皮下注射每6个月一次；安全随访期为末次给药后6个月。访视安排包括筛选访视（D-42至D-1，含胸腰椎X线、DXA、骨转换标志物、心电图及实验室检查）、基线与随机访视（第0月）、每月给药访视（第1至11月）、第12月访视（揭盲前影像与DXA）、第18月与第24月访视（影像评估，第24月加做DXA）以及骨折事件即时评估访视。各访视具体评估项目清单、操作规范及数据采集要求详见后续各子章节。","rationale":"项目已确认研究事实中总体研究设计、研究时期划分与访视策略均明确列出上述四个时期及六类访视节点。本章节作为研究程序与评估的总纲，仅写入已确认的时期框架与访视节点名称；各访视的完整评估项目清单尚未在来源中逐访视列明，故标记为partial。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5770a077009c_2f9fcffb767a76a4","section_number":"7","source_ids":["protocol_full_draft_selection:5ba98fe77eb1d6e36a9f4e14","current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","company_corpus:cms_cn_protocol_corpus_20260715_v1:6b24da94f33534","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb9c14bf455dec","company_corpus:cms_cn_protocol_corpus_20260715_v1:6eab08a4bddb3d","company_corpus:cms_cn_protocol_corpus_20260715_v1:f24b1a78f9c3f8"]},{"ai_run_id":"airun_20261005021644_69b8e320","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"研究时期：筛选期（最长6周，含维生素D预补充）；双盲治疗期（12个月，每月给药）；开放序贯期（12个月，地舒单抗每6个月）；安全随访期（末次给药后6个月）","quote_sha256":"79607c5c58c80bca5f1d97cffd38e58717d3606fdebe30300b4323fa51b2e078","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_study_periods"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"筛选期25(OH)D≥20ng/mL（不足者预补充维生素D后复筛）","quote_sha256":"4ed3c70872a88a9ea298fded5a88af95fd79d305e4ce1164a0bdefc5db2ec82c","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_screening_details"}],"evidence_review_advisories":[],"evidence_span_ids":["es_study_periods","es_screening_details"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"获取各阶段操作规范文件，明确DXA、X线、骨转换标志物、心电图、实验室检查的具体项目、操作标准与采集时点","category":"source_missing","gap_id":"gap_proc_002","missing_source_classes":["操作规范文件","实验室检查项目清单"],"target":"7.1 研究程序"}],"heading":"研究程序","missing_source_classes":["各阶段操作规范（DXA操作标准、X线阅片流程、实验室检查项目清单与采血时点）","研究程序总览表"],"proposal_text":"研究程序按筛选期、双盲治疗期、开放序贯期和安全随访期四个阶段依次推进。筛选期最长6周，完成入排标准评估、胸腰椎X线、DXA骨密度测定、骨转换标志物（P1NP、sCTX、OSTEOCALCIN）检测、心电图及实验室检查；25-羟基维生素D低于20纳克每毫升者须完成预补充并复筛达标。双盲治疗期12个月，受试者按1:1随机分配至KZ301组或安慰剂组，每月一次皮下注射给药，分层因素为研究中心、既往椎体骨折有无及基线腰椎T值（≤-3.0与>-3.0）。开放序贯期12个月，两组均接受地舒单抗60毫克皮下注射每6个月一次。安全随访期6个月，自末次给药起算。主要终点为治疗24个月时新发椎体骨折发生率，由影像判定并经双侧裁定。","rationale":"项目已确认研究事实中研究时期、访视策略、随机分层因素、主要终点定义及骨转换标志物名称均有明确记载。本章节写入已确认的阶段划分与关键程序节点；各阶段内具体操作规范（如DXA操作标准、X线阅片流程、实验室检查具体项目与采血时点）尚未在来源中逐条列明，故标记为partial。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5770a077009c_569b0cf6a54edfef","section_number":"7.1","source_ids":["protocol_full_draft_selection:5ba98fe77eb1d6e36a9f4e14","current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","company_corpus:cms_cn_protocol_corpus_20260715_v1:6b24da94f33534","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb9c14bf455dec","company_corpus:cms_cn_protocol_corpus_20260715_v1:6eab08a4bddb3d","company_corpus:cms_cn_protocol_corpus_20260715_v1:f24b1a78f9c3f8"]},{"ai_run_id":"airun_20261005021644_69b8e320","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"研究时期：筛选期（最长6周，含维生素D预补充）；双盲治疗期（12个月，每月给药）；开放序贯期（12个月，地舒单抗每6个月）；安全随访期（末次给药后6个月）","quote_sha256":"79607c5c58c80bca5f1d97cffd38e58717d3606fdebe30300b4323fa51b2e078","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_study_periods"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"筛选期25(OH)D≥20ng/mL（不足者预补充维生素D后复筛）","quote_sha256":"4ed3c70872a88a9ea298fded5a88af95fd79d305e4ce1164a0bdefc5db2ec82c","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_screening_details"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"访视策略：筛选访视（D-42~D-1，胸腰椎X线、DXA、骨转换标志物、心电图、实验室）","quote_sha256":"925b9e0d0dcd93331a28984f2ffa5ab9213ceab4ade261eaa7af08a5f39a9d29","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_visit_strategy"}],"evidence_review_advisories":[],"evidence_span_ids":["es_study_periods","es_screening_details","es_visit_strategy"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"获取筛选期实验室检查项目清单、DXA操作规范、X线阅片流程及筛选失败与重新筛选规则","category":"source_missing","gap_id":"gap_scr_001","missing_source_classes":["实验室检查项目清单","DXA操作规范","X线阅片流程","筛选失败与重新筛选规则"],"target":"7.1.1 筛选期与基线"}],"heading":"筛选期与基线","missing_source_classes":["筛选期实验室检查具体项目清单","DXA操作规范与质控要求","胸腰椎X线阅片流程与判定标准","筛选失败与重新筛选规则"],"proposal_text":"筛选期最长6周，自签署知情同意书起至随机化前结束。筛选访视安排在D-42至D-1之间，评估内容包括胸腰椎X线、DXA骨密度测定、骨转换标志物（P1NP、sCTX、OSTEOCALCIN）检测、心电图及实验室检查。入选要求受试者为55至90岁绝经后女性，腰椎总评分或全髋或股骨颈BMD的T值≤-2.5，且存在椎体影像骨折史、既往脆性骨折史或FRAX（含BMD）10年主要骨质疏松性骨折风险≥20%或髋部骨折风险≥3%；能够行走（允许辅助器具）；筛选期25-羟基维生素D≥20纳克每毫升。25-羟基维生素D不足者须在筛选期内完成维生素D预补充后复筛，复筛达标方可进入随机化。基线与随机访视安排在第0月，完成随机化及首次给药前评估。","rationale":"项目已确认研究事实中筛选期时长（最长6周）、筛选访视时间窗（D-42至D-1）、筛选评估项目（胸腰椎X线、DXA、骨转换标志物、心电图、实验室）、入选标准（年龄、BMD T值、高骨折风险定义、行走能力、25(OH)D阈值）及预补充复筛机制均有明确记载。本章节写入上述已确认内容；筛选期具体实验室检查项目清单、DXA操作规范、X线阅片流程、筛选失败与重新筛选规则等实施细节尚未在来源中列明，故标记为partial。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5770a077009c_9b019046918027b4","section_number":"7.1.1","source_ids":["protocol_full_draft_selection:5ba98fe77eb1d6e36a9f4e14","current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","company_corpus:cms_cn_protocol_corpus_20260715_v1:6b24da94f33534","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb9c14bf455dec","company_corpus:cms_cn_protocol_corpus_20260715_v1:6eab08a4bddb3d","company_corpus:cms_cn_protocol_corpus_20260715_v1:f24b1a78f9c3f8"]}],"source_bindings":[{"content_sha256":"79b9b3cabf7a0e2319bc55eec6f377aae9fa32b454dabea886621f22a9a0597e","locator":"document:mwdoc_greenfield_proj_user_5770a077009c_18fe1eae94fe0c67:full-draft:5ba98fe77eb1d6e36a9f4e14","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:5ba98fe77eb1d6e36a9f4e14","source_type":"protocol_full_draft_selection","source_version":"full-draft:f76e34e427c2bf7e9b3e07e