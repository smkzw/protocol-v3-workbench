5f9","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_003"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"安全性终点：裁定MACE（心血管死亡/非致死性心梗/非致死性卒中）；全因死亡；注射部位反应；ADA与中和抗体；颌骨骨坏死与非典型股骨骨折监测","quote_sha256":"d8e023068ea025ed864c57323b704863bc757353615cdf8861074059278f6afa","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_004"},{"locator":"section:不良事件的随访|block:831|chunk:1","quote":"研究期间，应在参与者病历和eCRF不良事件上记录不良事件的结局（包括日期），便于源数据查验。","quote_sha256":"fb19c2ad5f927a50f004bee304bfbe959f7a785d574e16c34667a405918f27c3","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","span_id":"es_005"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"每月给药访视（第1~11月）","quote_sha256":"8f86bc391a0cbd892cc481407b8f147cbea4b5212c5fac3cb59ce69d40e61c6b","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_006"}],"evidence_review_advisories":[],"evidence_span_ids":["es_001","es_002","es_003","es_004","es_005","es_006"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":5},"gap_items":[{"action":"补充项目AE随访终止标准文件，明确未解决事件随访至何种状态可停止、安全随访期内非计划访视的触发条件","category":"source_missing","gap_id":"gap_87_01","missing_source_classes":["项目AE/SAE/SUSAR定义与报告流程文件"],"target":"不良事件随访终止标准与随访频率"},{"action":"补充项目安全性报告流程文件，明确AE/SAE/SUSAR从发现到上报申办者药物警戒部门及伦理委员会的时限与路径","category":"source_missing","gap_id":"gap_87_02","missing_source_classes":["项目AE/SAE/SUSAR定义与报告流程文件"],"target":"不良事件报告时限与上报路径"},{"action":"补充MACE裁定委员会章程，明确事件提交时限、裁定标准、盲态维护及结果反馈机制","category":"source_missing","gap_id":"gap_87_03","missing_source_classes":["心血管事件裁决委员会章程"],"target":"心血管事件裁决委员会章程与提交流程"},{"action":"补充ONJ/AFF监测方案，明确筛查频率、可疑病例转诊路径、报告时限及随访要求","category":"source_missing","gap_id":"gap_87_04","missing_source_classes":["颌骨骨坏死与非典型股骨骨折监测与报告细则"],"target":"颌骨骨坏死与非典型股骨骨折监测与报告细则"}],"heading":"不良事件的随访","missing_source_classes":["项目AE/SAE/SUSAR定义与报告流程文件","项目安全性随访终止标准文件","心血管事件裁决委员会章程","颌骨骨坏死与非典型股骨骨折监测与报告细则"],"proposal_text":"研究期间发生的所有不良事件，无论严重程度、与研究药物的因果关系或预期性如何，均应在参与者病历和电子病例报告表中记录其结局及发生与结束日期，以便源数据核查。不良事件的随访贯穿双盲治疗期（12个月）、开放序贯期（12个月）及末次给药后6个月安全随访期，研究者应在每次计划访视时评估既往未解决不良事件的转归，对未解决事件持续追踪至事件恢复、稳定或达到方案规定的随访终止条件。对于骨折事件，受试者应在事件发生后接受即时评估访视，由研究者完成影像学确认和临床分类，并将结果录入电子病例报告表。心血管事件（包括心血管死亡、非致死性心肌梗死和非致死性卒中）由独立心血管事件裁决委员会进行裁定，研究者负责在事件发生后及时收集原始资料并提交裁定委员会。颌骨骨坏死与非典型股骨骨折作为重点监测安全性事件，研究者应在每次访视时询问相关症状，发现可疑病例时安排专科评估并记录转归。独立数据安全监查委员会按照既定章程定期审阅安全性数据，必要时向申办者提出安全性建议。","rationale":"项目已确认安全随访期为末次给药后6个月、骨折事件即时评估访视、MACE由裁定委员会裁定、ONJ与AFF为监测终点、DMC计划设置。公司语料提供不良事件结局记录于病历和eCRF的结构参照。但AE/SAE/SUSAR具体定义、报告时限、随访终止标准及SUSAR上报流程缺少项目文件，需医学经理确认后方可定稿。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5770a077009c_d4bf71f8d3e02f5d","section_number":"8.7","source_ids":["protocol_full_draft_selection:9c5952e59e976abea97250a0","current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:152c1e08c78e76","company_corpus:cms_cn_protocol_corpus_20260715_v1:30fd7cd8503aae","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976"]},{"ai_run_id":"airun_20261005030847_e9a219b4","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"55~90岁绝经后女性","quote_sha256":"ee99ecaf217a707dfe6cffea9dfb9c69e74b5e29f109e89e04432f760557a1e4","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_007"},{"locator":"section:妊娠、哺乳与避孕|block:779|chunk:1","quote":"签署ICF至用药后6个月内如果研究者发现女性试验参与者怀孕或男性试验参与者的伴侣怀孕，研究者必须填写《妊娠报告表》，并在24小时内提供给申办者药物警戒部门或其代表、本中心的伦理委员会（如适用）。","quote_sha256":"c10db508093dbb2a9340fa245b4cb4e727bd5ca3832390c2efe6564f6f511d72","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83","span_id":"es_008"},{"locator":"section:6.3.4 妊娠|block:1004|chunk:1","quote":"妊娠本身并不被视为一个 AE，但是，受试者或其伴侣在签署 ICF 至末次给药后6 个月期间发生的妊娠，研究者应在获知妊娠事件的 24 小时内，填写《妊娠事件报告表》","quote_sha256":"e0d1d082a62772e4c618c8776c623542c3309b02d40e37c71f55763260f63a74","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:152c1e08c78e76","span_id":"es_009"},{"locator":"section:妊娠事件的报告要求|block:839|chunk:1","quote":"妊娠既不是AE也不是SAE，不应记录在eCRF的不良事件上，除非怀疑研究药物可能干扰了避孕药物或避孕方法的有效性，以及除非发生妊娠相关并发症","quote_sha256":"bb9bbf66f3591978bef14815e89e871d0dc17e5bb103a81671e22b7b50c50fc1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976","span_id":"es_010"},{"locator":"section:妊娠、哺乳与避孕|block:1005|chunk:1","quote":"所有的先天畸形/出生缺陷为 SAE。自然流产也应视为 SAE","quote_sha256":"7dda96bf6478e57bc64eb5054e81d2838ad78e6b9ded48f8bea733e3f59a6d27","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:30fd7cd8503aae","span_id":"es_011"},{"locator":"section:不良事件的随访|block:831|chunk:1","quote":"研究期间报告的所有妊娠均应随访至妊娠结局。","quote_sha256":"86f5a8896b59ad76996d88eb43c9e6fdc549b0447d19f2bb48789cf2fd7cbdb8","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","span_id":"es_012"}],"evidence_review_advisories":[],"evidence_span_ids":["es_007","es_008","es_009","es_010","es_011","es_012"],"evidence_summary":{"corpus_spans":5,"project_fact_spans":1},"gap_items":[{"action":"确认本项目是否保留妊娠报告条款（鉴于人群为绝经后女性），若保留则补充项目妊娠报告流程文件，明确报告时限、报告对象及随访终止条件","category":"source_missing","gap_id":"gap_88_01","missing_source_classes":["项目妊娠报告与随访流程文件"],"target":"妊娠事件报告流程与适用性"},{"action":"确认本项目是否设置避孕要求条款及男性受试者伴侣妊娠报告要求；若设置则补充项目避孕方法文件","category":"source_missing","gap_id":"gap_88_02","missing_source_classes":["项目避孕要求文件"],"target":"避孕要求与伴侣妊娠报告"},{"action":"确认是否需要对意外妊娠的新生儿进行出生后随访及随访期限；若需要则补充新生儿随访方案","category":"source_missing","gap_id":"gap_88_03","missing_source_classes":["项目新生儿随访方案"],"target":"新生儿随访期限与报告要求"}],"heading":"妊娠事件的报告与随访","missing_source_classes":["项目妊娠报告与随访流程文件","项目避孕要求文件","项目新生儿随访方案"],"proposal_text":"本研究对象为55~90岁绝经后女性，妊娠事件预期发生率极低，但方案仍保留妊娠事件报告与随访条款以覆盖极罕见意外妊娠情形。若研究期间研究者获知女性受试者发生妊娠，应在获知后24小时内填写妊娠事件报告表，向申办者药物警戒部门及其指定联系人报告，同时通知本中心伦理委员会（如适用）。妊娠本身不作为不良事件记录于电子病例报告表，但妊娠相关并发症（包括自然流产、因医学或健康原因导致的人工流产、死胎、新生儿严重不良事件如先天性异常或出生缺陷）应按严重不良事件流程报告。确定妊娠后，研究者应告知受试者目前已知的潜在风险及现有替代治疗选择，受试者退出研究。妊娠事件应随访至妊娠结局（自发流产、人工流产、正常分娩或先天畸形），随访信息记录于妊娠事件报告表并报告申办者。","rationale":"项目已确认研究人群为55~90岁绝经后女性，妊娠事件预期极低。公司语料提供妊娠报告24小时时限、妊娠非AE原则、妊娠相关并发症按SAE报告及随访至妊娠结局的结构参照，但上述条款为跨项目通用内容，不可直接作为本项目已确认实施规则。本项目是否保留妊娠报告条款、是否涉及男性受试者伴侣妊娠报告、避孕要求及新生儿随访期限需医学经理确认。","review_advisories":["本节复述高影响研究设计（妊娠事件的报告与随访）；请在合并设计摘要中统一核对。","本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5770a077009c_59269e64900557f5","section_number":"8.8","source_ids":["protocol_full_draft_selection:9c5952e59e976abea97250a0","current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:152c1e08c78e76","company_corpus:cms_cn_protocol_corpus_20260715_v1:30fd7cd8503aae","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976"]},{"ai_run_id":"airun_20261005030847_e9a219b4","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"主要终点采用Cox比例风险模型（协变量：分层因素），自随机化至首次新发椎体骨折","quote_sha256":"97ca0dc79b021d9599890ef563e8376652bcf63aecc25bfa14af686336048252","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_013"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"关键次要终点按层级检验（临床椎体与非椎体骨折→腰椎BMD百分比变化）","quote_sha256":"7db1aa0ef8170f5b6778f57602872810730196b891a9691865bed2d511a76a0b","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_014"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"期中分析于50%事件数时由独立DMC执行（O'Brien-Fleming型α消耗，α=0.005）","quote_sha256":"f9cd8cf5d64179857908fad9ad717acee0b35442b39ebd3c702b4eae2da1baba","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_015"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"MACE按裁定委员会结果做组间点估计与95%CI比较；骨转换标志物与BMD采用MMRM","quote_sha256":"01611203ddacc622b1aca5ddd2d6191949341f82e730485c531d60b407e63c6d","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_016"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"主要估计目标：治疗策略（treatment policy）——无论是否中止KZ301或使用补救性抗骨质疏松治疗，评价至第24个月新发椎体骨折的发生。伴发事件：中止治疗者保留于mITT分析；开启补救性抗骨质疏松治疗记录为伴发事件并汇总，不做排除；死亡作为竞争风险处理。","quote_sha256":"fb5cad9570da0840c4fdaa1741e9872d98a292612d64fa491e8055fa7a3f2ad9","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_017"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"事件驱动设计：预计安慰剂序贯组24个月新发椎体骨折率约4.8%，KZ301组HR=0.62，双侧α=0.05、把握度90%，需约130例确证性椎体骨折事件；考虑约10%退出与竞争风险，计划入组4200例（每组2100例），国内约60家中心。","quote_sha256":"9d9f22be7fedd625d440af71b327806a654c47a412c1508ab1e970dca07fcc79","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_018"}],"evidence_review_advisories":[],"evidence_span_ids":["es_013","es_014","es_015","es_016","es_017","es_018"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"补充项目统计分析计划，明确全分析集、修正意向治疗集、符合方案集及安全性分析集的纳入排除标准","category":"source_missing","gap_id":"gap_9_01","missing_source_classes":["项目统计分析计划","项目分析集定义文件"],"target":"分析集定义"},{"action":"补充项目统计分析计划，明确主要终点及次要终点中缺失数据的插补或敏感性分析方法","category":"source_missing","gap_id":"gap_9_02","missing_source_classes":["项目统计分析计划","项目缺失数据处理方案"],"target":"缺失数据处理方法"},{"action":"补充项目统计分析计划，明确预设亚组分析维度、多重性调整策略及期中分析后剩余α分配","category":"source_missing","gap_id":"gap_9_03","missing_source_classes":["项目统计分析计划","项目亚组分析与多重性调整方案"],"target":"亚组分析与多重性调整"}],"heading":"统计分析","missing_source_classes":["项目统计分析计划","项目分析集定义文件","项目缺失数据处理方案","项目亚组分析与多重性调整方案"],"proposal_text":"本研究为事件驱动设计，预计安慰剂序贯组24个月新发椎体骨折率约4.8%，KZ301组风险比为0.62，双侧显著性水平0.05、把握度90%条件下需约130例确证性椎体骨折事件；考虑约10%退出与竞争风险，计划入组4200例（每组2100例），国内约60家中心。主要终点新发椎体骨折采用Cox比例风险模型分析，以分层因素（研究中心、既往椎体骨折有无、基线腰椎T值≤-3.0与>-3.0）为协变量，时间起点为随机化，终点事件为首次新发椎体骨折。关键次要终点按层级检验顺序依次评价：首先检验12个月临床椎体与非椎体骨折累计发生率，其次检验12个月腰椎骨密度较基线百分比变化。骨密度与骨转换标志物（P1NP、sCTX、OSTEOCALCIN）采用混合效应模型重复测量分析。主要估计目标为治疗策略，无论是否中止KZ301或使用补救性抗骨质疏松治疗均纳入分析；中止治疗者保留于修正意向治疗分析集；开启补救性抗骨质疏松治疗记录为伴发事件并汇总，不做排除；死亡作为竞争风险处理。期中分析于累计事件数达到50%时由独立数据安全监查委员会执行，采用O'Brien-Fleming型α消耗函数，期中分析显著性水平为0.005。","rationale":"项目已确认事件驱动设计参数（4.8%基线率、HR=0.62、130例事件、4200例入组）、Cox PH模型及分层协变量、层级检验顺序、MMRM方法、DMC期中分析（50%事件、O'Brien-Fleming、α=0.005）、治疗策略估计目标及伴发事件处理规则。但分析集定义（FAS、mITT、PP、SS的具体纳入排除标准）、缺失数据插补方法、亚组分析维度及多重性调整策略缺少项目文件，需医学经理与统计师确认。","review_advisories":["本节复述高影响研究设计（统计分析）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（α、主要终点、估计目标、伴发事件、期中分析、计划入组）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5770a077009c_ed6699a19ca3982a","section_number":"9","source_ids":["protocol_full_draft_selection:9c5952e59e976abea97250a0","current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:152c1e08c78e76","company_corpus:cms_cn_protocol_corpus_20260715_v1:30fd7cd8503aae","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976"]},{"ai_run_id":"airun_20261005030847_e9a219b4","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"安全性终点：裁定MACE（心血管死亡/非致死性心梗/非致死性卒中）；全因死亡；注射部位反应；ADA与中和抗体；颌骨骨坏死与非典型股骨骨折监测","quote_sha256":"d8e023068ea025ed864c57323b704863bc757353615cdf8861074059278f6afa","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_019"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"评价安全性与耐受性（重点：心血管事件裁决委员会裁定的MACE、注射部位反应、免疫原性）","quote_sha256":"65e3290e920c739f28261c60e8276e9986443d28799f39018656b656982b1cae","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_020"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"MACE按裁定委员会结果做组间点估计与95%CI比较","quote_sha256":"9ed9ab966bf911868783a44c0f8c0af039200edc0a23598748ea269cd4d5ad78","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_021"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"安全随访期（末次给药后6个月）","quote_sha256":"0359d102c5d0f7510b2df8ef6db9d86afb3dd2dfb6d74599cb8ddf9fabe46ccf","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_022"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"第18/24月访视（影像；24月加DXA）","quote_sha256":"5b92eaf4f1b77906eb3c096fb6bca526aadb57695fd654777755935f961a8b9e","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_023"}],"evidence_review_advisories":[],"evidence_span_ids":["es_019","es_020","es_021","es_022","es_023"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"补充项目安全性数据分析细则，明确安全性分析集范围、TEAE定义窗口（从首次给药至末次给药后多长时间）及不良事件采集与分类规则","category":"source_missing","gap_id":"gap_95_01","missing_source_classes":["项目安全性数据分析细则（含TEAE定义与采集窗口）"],"target":"安全性分析集定义与TEAE采集窗口"},{"action":"补充心血管事件裁决委员会章程，明确裁定标准、事件提交时限、盲态维护、裁定结果反馈及统计汇总方法","category":"source_missing","gap_id":"gap_95_02","missing_source_classes":["心血管事件裁决委员会章程"],"target":"MACE裁定委员会章程与操作流程"},{"action":"补充项目免疫原性分析方案，明确ADA与中和抗体检测方法、采样时间点、阳性判定阈值及免疫原性对疗效和安全性的影响分析策略","category":"source_missing","gap_id":"gap_95_03","missing_source_classes":["项目免疫原性分析方案"],"target":"免疫原性分析方案"},{"action":"补充颌骨骨坏死与非典型股骨骨折监测方案，明确筛查频率、可疑病例转诊路径、报告时限及随访要求","category":"source_missing","gap_id":"gap_95_04","missing_source_classes":["项目ONJ/AFF监测与报告细则"],"target":"ONJ与AFF监测与报告细则"}],"heading":"安全性数据分析","missing_source_classes":["项目安全性数据分析细则（含TEAE定义与采集窗口）","心血管事件裁决委员会章程","项目免疫原性分析方案","项目ONJ/AFF监测与报告细则"],"proposal_text":"安全性分析涵盖双盲治疗期（12个月）、开放序贯期（12个月）及末次给药后6个月安全随访期内收集的全部安全性数据。心血管事件（心血管死亡、非致死性心肌梗死、非致死性卒中）由独立心血管事件裁决委员会裁定后，按组间点估计与95%置信区间进行比较。注射部位反应按发生频率和严重程度进行描述性汇总。免疫原性分析包括抗药抗体和中和抗体的发生率及滴度变化。颌骨骨坏死与非典型股骨骨折作为重点监测事件，按发生例数和发生率进行描述性汇总，并记录转归。全因死亡按组别汇总并计算发生率。安全性数据的收集与随访贯穿整个研究期间，包括每次计划访视及骨折事件即时评估访视中记录的不良事件。","rationale":"项目已确认安全性终点包括裁定MACE、全因死亡、注射部位反应、ADA与中和抗体、ONJ与AFF监测；MACE按裁定委员会结果做组间点估计与95%CI比较；安全随访期为末次给药后6个月；访视策略含骨折事件即时评估访视。但安全性分析集定义、TEAE采集窗口与定义、MACE裁定委员会章程、免疫原性分析阈值与方法、ONJ/AFF监测与报告流程缺少项目文件，需医学经理与统计师确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5770a077009c_035efd28d93a7d42","section_number":"9.5","source_ids":["protocol_full_draft_selection:9c5952e59e976abea97250a0","current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","company_corpus:cms_cn_protocol_corpus_20260715_v1:ac6ee929ab7d83","company_corpus:cms_cn_protocol_corpus_20260715_v1:f386be5d8f9bc2","company_corpus:cms_cn_protocol_corpus_20260715_v1:152c1e08c78e76","company_corpus:cms_cn_protocol_corpus_20260715_v1:30fd7cd8503aae","company_corpus:cms_cn_protocol_corpus_20260715_v1:5cb5f7385bb976"]}],"source_bindings":[{"content_sha256":"1f9e19154530ff453bbcf7a7317d89cfc2094b8018939484