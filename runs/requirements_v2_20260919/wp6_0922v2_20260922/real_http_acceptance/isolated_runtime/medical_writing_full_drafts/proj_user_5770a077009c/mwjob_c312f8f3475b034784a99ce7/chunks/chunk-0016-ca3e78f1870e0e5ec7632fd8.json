9","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_003"},{"locator":"document:mwdoc_greenfield_proj_user_5770a077009c_18fe1eae94fe0c67:full-draft:ca3e78f1870e0e5ec7632fd8","quote":"SECTION_ID=mwsec_greenfield_proj_user_5770a077009c_544b48bb8a1e3441\n章节编号=10.4\n章节标题=资料保存与数据保护\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"dba4edccaf814d25e080487e80926de92dd9f8bbac2e44c8ad34c647f19fd0f2","source_id":"protocol_full_draft_selection:ca3e78f1870e0e5ec7632fd8","span_id":"es_004"}],"evidence_review_advisories":[],"evidence_span_ids":["es_001","es_002","es_003","es_004"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":1},"gap_items":[{"action":"确认试验结束后原始资料及电子数据的最低保存年限及销毁触发条件","category":"source_missing","gap_id":"gap_10_4_retention_period","missing_source_classes":["项目级数据管理计划","申办者数据保存与销毁SOP"],"target":"资料保存年限条款"},{"action":"确认是否存在数据出境需求及相应安全评估审批路径","category":"source_missing","gap_id":"gap_10_4_cross_border","missing_source_classes":["项目级数据管理计划","跨境数据传输合规评估文件"],"target":"数据跨境传输条款"},{"action":"确认影像数据、基因检测数据的去标识化标准及再识别风险评估方法","category":"source_missing","gap_id":"gap_10_4_deidentification","missing_source_classes":["项目级数据管理计划"],"target":"去标识化与再识别防护细则"}],"heading":"资料保存与数据保护","missing_source_classes":["项目级数据管理计划","项目级数据保护影响评估文件","申办者数据保存与销毁SOP"],"proposal_text":"本研究所有原始资料、病例报告表、影像资料、实验室检测数据及电子数据库的所有权归申办者所有。除国家药品监督管理局依法要求查阅或调取外，未经申办者事先书面同意，研究者及研究中心不得以任何方式将上述资料提供给第三方。申办者有权将研究中收集的数据用于药品注册申报、全球范围内的科学产品记录及学术出版物发表。本研究在中国境内开展，受试者个人信息的收集、存储、使用、加工、传输、提供、公开及删除等处理活动应遵守《中华人民共和国个人信息保护法》《中华人民共和国数据安全法》及国家药品监督管理局关于药物临床试验数据管理的相关要求。研究中心应建立受试者身份编码与原始医疗记录之间的可追溯映射关系，确保在满足监管核查与审计的前提下，对受试者直接标识符实施去标识化处理。电子数据采集系统应具备访问权限分级控制、操作日志审计及数据完整性校验功能，纸质文件应存放于具备防火、防潮、防非授权接触条件的专用档案柜中。","rationale":"数据所有权与发表条款来源于公司语料通用模板，已适配本III期中国多中心研究的监管语境。具体保存年限、数据销毁触发条件、跨境传输审批流程及个人信息保护影响评估方案尚无项目级来源支持，需医学经理与数据管理部门确认后补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5770a077009c_544b4