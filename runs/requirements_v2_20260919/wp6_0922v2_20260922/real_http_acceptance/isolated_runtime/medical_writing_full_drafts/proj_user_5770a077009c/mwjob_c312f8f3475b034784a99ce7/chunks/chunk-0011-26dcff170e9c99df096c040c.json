单抗每6个月）；安全随访期（末次给药后6个月）","quote_sha256":"79607c5c58c80bca5f1d97cffd38e58717d3606fdebe30300b4323fa51b2e078","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es12"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"颌骨骨坏死与非典型股骨骨折监测","quote_sha256":"5b3fa4f3be7dcf59bd5af7450c0fe84a58d5b3ee7342b76b0929172fbb8f480a","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es13"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"注射部位反应","quote_sha256":"c30b999c9d8644f317b2da6ea05e6fe0fcf49d46da20e63f786a84f7e14d8497","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es14"}],"evidence_review_advisories":[],"evidence_span_ids":["es3","es4","es5","es6","es7","es8","es12","es13","es14"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":9},"gap_items":[{"action":"获取项目安全性管理规程，确认TEAE采集窗口（如末次给药后30天）、SAE报告时限（如24小时）及SUSAR上报流程","category":"source_missing","gap_id":"gap_safety_01","missing_source_classes":["项目安全性管理规程","适用法规报告要求"],"target":"AE/SAE/SUSAR定义、TEAE采集窗口与报告时限"},{"action":"获取DMC章程，确认期中分析触发条件、安全性信号沟通路径及紧急揭盲流程","category":"source_missing","gap_id":"gap_safety_02","missing_source_classes":["DMC章程","期中分析计划"],"target":"DMC具体职责与沟通机制"},{"action":"确认是否设置口腔检查、股骨X线等专项监测及监测频率","category":"source_missing","gap_id":"gap_safety_03","missing_source_classes":["项目安全性监测方案","KZ301 IB安全性章节"],"target":"颌骨骨坏死与非典型股骨骨折监测方法"}],"heading":"安全性评价","missing_source_classes":["项目安全性管理规程（含AE/SAE/SUSAR定义与报告）","DMC章程","KZ301研究者手册安全性章节","颌骨骨坏死与非典型股骨骨折监测方案"],"proposal_text":"本研究安全性评价覆盖筛选期、双盲治疗期（12个月）、开放序贯期（12个月）及安全随访期（末次给药后6个月），合计最长约36个月。安全性评估重点包括：由独立心血管事件裁决委员会裁定的主要不良心血管事件（MACE，含心血管死亡、非致死性心肌梗死、非致死性卒中）；全因死亡；注射部位反应；抗药抗体与中和抗体；颌骨骨坏死与非典型股骨骨折监测。研究设置独立数据安全监查委员会（DMC），在50%事件数时执行期中分析（O'Brien-Fleming型α消耗，α=0.005），对安全性数据进行独立审阅。安全性数据的采集、分类、报告时限及严重不良事件与可疑非预期严重不良反应的上报流程，由申办方依据项目安全性管理规程及适用法规确定后写入方案。","rationale":"已确认事实支持：安全性终点明确列出MACE、全因死亡、注射部位反应、ADA与中和抗体、颌骨骨坏死与非典型股骨骨折监测；研究时期含安全随访期（末次给药后6个月）；DMC已计划；内在研究目的包含进一步刻画心血管安全性；排除标准含12个月内心肌梗死、卒中、冠脉血运重建及未控制高血压。允许来源未提供AE/SAE/SUSAR定义、TEAE采集窗口、报告时限及安全性评估操作细则。医学经理需确认：安全性评估是否在每个访视均实施、TEAE采集窗口起止、DMC具体职责与沟通机制、颌骨骨坏死与非典型股骨骨折的监测方法。","review_advisories":["本节提及高影响设计信息（α、期中分析）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5770a077009c_82192d5b82efcbf0","section_number":"8","source_ids":["protocol_full_draft_selection:26dcff170e9c99df096c040c","current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c"]},{"ai_run_id":"airun_20261005025555_63a26ad4","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"安全性终点：裁定MACE（心血管死亡/非致死性心梗/非致死性卒中）；全因死亡；注射部位反应；ADA与中和抗体；颌骨骨坏死与非典型股骨骨折监测","quote_sha256":"d8e023068ea025ed864c57323b704863bc757353615cdf8861074059278f6afa","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es3"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"评价安全性与耐受性（重点：心血管事件裁决委员会裁定的MACE、注射部位反应、免疫原性）","quote_sha256":"65e3290e920c739f28261c60e8276e9986443d28799f39018656b656982b1cae","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es4"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"安全随访期（末次给药后6个月）","quote_sha256":"0359d102c5d0f7510b2df8ef6db9d86afb3dd2dfb6d74599cb8ddf9fabe46ccf","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es5"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"DMC是否计划：是","quote_sha256":"9967a9a75297ced2326ab733fa3b16934acdef641fa765dd50c1cd58219f4aa5","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es6"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"研究时期：筛选期（最长6周，含维生素D预补充）；双盲治疗期（12个月，每月给药）；开放序贯期（12个月，地舒单抗每6个月）；安全随访期（末次给药后6个月）","quote_sha256":"79607c5c58c80bca5f1d97cffd38e58717d3606fdebe30300b4323fa51b2e078","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es12"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"颌骨骨坏死与非典型股骨骨折监测","quote_sha256":"5b3fa4f3be7dcf59bd5af7450c0fe84a58d5b3ee7342b76b0929172fbb8f480a","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es13"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"注射部位反应","quote_sha256":"c30b999c9d8644f317b2da6ea05e6fe0fcf49d46da20e63f786a84f7e14d8497","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es14"}],"evidence_review_advisories":[],"evidence_span_ids":["es3","es4","es5","es6","es12","es13","es14"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":7},"gap_items":[{"action":"确认双盲期盲态覆盖人员（受试者、研究者、影像评估人员、安全性评估人员、DMC）及紧急揭盲流程","category":"source_missing","gap_id":"gap_general_01","missing_source_classes":["项目盲态管理SOP","DMC章程"],"target":"盲态范围具体人员清单"},{"action":"确认安全性评估是否在每个访视实施、TEAE采集窗口、颌骨骨坏死与非典型股骨骨折的专项监测方法","category":"source_missing","gap_id":"gap_general_02","missing_source_classes":["项目安全性管理规程","访视操作手册"],"target":"安全性数据收集操作细则"}],"heading":"总则","missing_source_classes":["项目安全性管理规程","DMC章程","盲态管理SOP","KZ301研究者手册安全性章节"],"proposal_text":"本研究为随机、双盲、双模拟、安慰剂对照、平行组、事件驱动确证性III期临床研究，安全性评价贯穿筛选期、双盲治疗期（12个月）、开放序贯期（12个月）及安全随访期（末次给药后6个月）。安全性评价的总体原则为：在双盲治疗期，安全性数据的收集与初步分类在盲态下完成；主要不良心血管事件由独立心血管事件裁决委员会进行盲态裁定；免疫原性评估（ADA与中和抗体）及注射部位反应作为安全性终点纳入常规监测；颌骨骨坏死与非典型股骨骨折作为与抗骨吸收及抗骨形成治疗相关的已知风险信号进行主动监测。安全性数据的最终分析与报告在揭盲后由申办方统计团队完成，DMC在期中分析节点对安全性数据进行独立审阅。","rationale":"已确认事实支持：研究设计为随机、双盲、双模拟、安慰剂对照、平行组、事件驱动确证性III期；安全性终点含MACE（由心血管事件裁决委员会裁定）、注射部位反应、ADA与中和抗体、颌骨骨坏死与非典型股骨骨折监测；DMC已计划；研究时期含安全随访期（末次给药后6个月）。允许来源未提供盲态范围的具体人员清单、安全性数据收集操作细则、TEAE采集窗口及DMC沟通机制。医学经理需确认：盲态范围是否涵盖受试者、研究者、影像评估人员及安全性评估人员；颌骨骨坏死与非典型股骨骨折的监测是否作为独立安全性评估项目还是纳入AE常规采集。","review_advisories":["本节提及高影响设计信息（期中分析）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5770a077009c_d7609614a3bef16f","section_number":"8.1","source_ids":["protocol_full_draft_selection:26dcff170e9c99df096c040c","current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c"]}],"source_bindings":[{"content_sha256":"24488754cb50bcb74e9dc95b7c12886b6cf55ed6c15160e4054b2826bbd0a8a8","locator":"document:mwdoc_greenfield_proj_user_5770a077009c_18fe1eae94fe0c67:full-draft:26dcff170e9c99df096c040c","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:26dcff170e9c99df096c040c","source_type":"protocol_full_draft_selection","source_version":"full-draft:f76e34e427c2bf7e9b3e07e700402957ffd416b32bc3e9419860340778492bfd:26dcff170e9c99df096c040c","text_sha256":"24488754cb50bcb74e9dc95b7c12886b6cf55ed6c15160e4054b2826bbd0a8a8"},{"content_sha256":"f3a67b638aca3f31ae0829c6fa150ad367ae59178944e5cf4b5983f0b9d837cf","locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","source_type":"current_project_study_definition","source_version":"mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","text_sha256":"f3a67b638aca3f31ae0829c6fa150ad367ae59178944e5cf4b5983f0b9d837cf"}]}