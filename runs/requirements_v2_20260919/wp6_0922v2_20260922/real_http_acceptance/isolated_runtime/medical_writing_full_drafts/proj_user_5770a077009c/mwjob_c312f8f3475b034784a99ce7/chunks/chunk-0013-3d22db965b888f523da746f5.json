"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5770a077009c_bac77e1c962c495a","section_number":"8.3","source_ids":["protocol_full_draft_selection:3d22db965b888f523da746f5","current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","company_corpus:cms_cn_protocol_corpus_20260715_v1:100e0300d2949b","company_corpus:cms_cn_protocol_corpus_20260715_v1:455161bcd6a708","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:da3d46a6971245","company_corpus:cms_cn_protocol_corpus_20260715_v1:be5d06fd3b46ad"]},{"ai_run_id":"airun_20261005030603_0036ad19","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:不良事件的收集与记录|block:713|chunk:1","quote":"本研究过程中出现的任何不良事件，无论其严重性，或是否与试验用药品有关，研究者都必须记录在eCRF的不良事件页面中，包括其发生日期、结束日期、症状、严重程度（根据NCI-CTCAE 6.0版），对不良事件进行评估和分级、持续时间、处理措施和转归等，并且在综合考虑合并症、合并药物/非药物治疗基础上，评价其与试验药物的相关性，签名并注明日期。","quote_sha256":"62b23c1b9900cdfba6f0f8631ac476fe8b532541b400f2aae84d672a167caa23","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:100e0300d2949b","span_id":"es_002"},{"locator":"section:治疗期出现的不良事件（TEAE）|block:671|chunk:1","quote":"诊断性或治疗性的侵入性（如手术）、非侵入性操作不应作为不良事件报告。但导致此项操作的疾病状况符合不良事件的定义时，应予以报告。","quote_sha256":"b8ca9b735b7da34ac64b21970ffbe46050de94ad9a27446dad5c3e8b36175687","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:455161bcd6a708","span_id":"es_003"},{"locator":"section:不良事件的采集与记录|block:678|chunk:1","quote":"研究者负责确保所有不良事件记录在参与者病历和eCRF的不良事件页中，并根据本节和第8.6节","quote_sha256":"de949166dd937bd8c8724d92628ec61969ec0e21255e0b1640719938de4e34b3","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:da3d46a6971245","span_id":"es_004"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"安全性终点：裁定MACE（心血管死亡/非致死性心梗/非致死性卒中）；全因死亡；注射部位反应；ADA与中和抗体；颌骨骨坏死与非典型股骨骨折监测","quote_sha256":"d8e023068ea025ed864c57323b704863bc757353615cdf8861074059278f6afa","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_005"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003","es_004","es_005"],"evidence_summary":{"corpus_spans":3,"project_fact_spans":1},"gap_items":[{"action":"由医学经理确认TEAE采集窗口（如末次给药后30天或60天），确认后写入本章节","category":"source_missing","gap_id":"gap_84_teae_window","missing_source_classes":["本项目安全性评估窗口定义"],"target":"8.4节TEAE采集窗口定义"},{"action":"确认是否采用NCI-CTCAE 6.0或其他分级标准","category":"source_missing","gap_id":"gap_84_ctcae","missing_source_classes":["本项目安全性评估工具指定"],"target":"8.4节严重程度分级工具"}],"heading":"不良事件的采集与记录","missing_source_classes":["本项目TEAE采集窗口定义","严重程度分级工具确认"],"proposal_text":"研究过程中出现的任何不良事件，无论其严重程度或是否与试验用药品相关，研究者均须记录于参与者病历及电子病例报告表（eCRF）的不良事件页面。记录内容包括不良事件的发生日期、结束日期、症状描述、严重程度分级、持续时间、处理措施及转归。诊断性或治疗性的侵入性操作（如手术）及非侵入性操作本身不作为不良事件报告，但导致该操作的疾病状况若符合不良事件定义则须予以报告，操作本身记录为该不良事件的处理方法。研究者应使用简洁的医学术语报告不良事件，尽可能给出疾病诊断而非仅罗列症状与体征。本研究安全性监测重点关注以下事件：经心血管事件裁定委员会裁定的主要不良心血管事件（心血管死亡、非致死性心肌梗死、非致死性卒中）、全因死亡、注射部位反应、抗药抗体及中和抗体、颌骨骨坏死及非典型股骨骨折。上述事件在采集时须同时记录于eCRF不良事件页面及对应的专项安全性采集表。","rationale":"采集与记录框架依据公司语料中不良事件收集与记录条款（eCRF记录要求、侵入性操作排除规则、医学术语报告要求）及本项目已确认安全性终点（MACE、注射部位反应、免疫原性、颌骨骨坏死、非典型股骨骨折）。TEAE采集窗口（从首次给药至末次给药后具体天数）及严重程度分级工具（是否采用NCI-CTCAE 6.0）在本项目来源中未明确，需医学经理确认后方可写入。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5770a077009c_377e191b484092b6","section_number":"8.4","source_ids":["protocol_full_draft_selection:3d22db965b888f523da746f5","current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","company_corpus:cms_cn_protocol_corpus_20260715_v1:100e0300d2949b","company_corpus:cms_cn_protocol_corpus_20260715_v1:455161bcd6a708","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:da3d46a6971245","company_corpus:cms_cn_protocol_corpus_20260715_v1:be5d06fd3b46ad"]},{"ai_run_id":"airun_20261005030603_0036ad19","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:8.4.9.2 不良事件|block:1136|chunk:1","quote":"所有 AE 将依据《监管活动医学词典》（MedDRA）编码进行分类。","quote_sha256":"31d771dfe04aeda1bc1169d6823343fd60d9ebdbf804e471686d62133a2cc334","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","span_id":"es_006"},{"locator":"section:8.4.9.2 不良事件|block:1136|chunk:1","quote":"治疗期出现的不良事件[TEAE ，定义为从首次给药治疗开始至完成研究（或提前退出）期间出现的任何 AE ，包括研究期间新出现的 AE 或治疗前已出现但治疗后 CTCAE 等级加重的 AE]进行统计分析。","quote_sha256":"1793d5281f8b37b645fc8eb0c5d20d7997076123f7915361d3c463619a25df76","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","span_id":"es_007"},{"locator":"study_definition:mwdefinition_b4be7d43168c8c1c861f:revision:9","quote":"安全性终点：裁定MACE（心血管死亡/非致死性心梗/非致死性卒中）；全因死亡；注射部位反应；ADA与中和抗体；颌骨骨坏死与非典型股骨骨折监测","quote_sha256":"d8e023068ea025ed864c57323b704863bc757353615cdf8861074059278f6afa","source_id":"current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","span_id":"es_005"}],"evidence_review_advisories":[],"evidence_span_ids":["es_006","es_007","es_005"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":1},"gap_items":[{"action":"确认因果关系判定采用几级分类及各级定义","category":"source_missing","gap_id":"gap_85_causality","missing_source_classes":["本项目安全性评估标准"],"target":"8.5节因果关系判定类别"},{"action":"获取裁定委员会章程或确认其组成与裁定流程","category":"source_missing","gap_id":"gap_85_mace_committee","missing_source_classes":["心血管事件裁定委员会章程"],"target":"8.5节心血管事件裁定委员会"}],"heading":"不良事件的评估","missing_source_classes":["因果关系判定类别定义","TEAE采集窗口具体天数","心血管事件裁定委员会章程"],"proposal_text":"所有不良事件将依据《监管活动医学词典》（MedDRA）进行编码分类。研究者须对每例不良事件评估其严重程度、与研究药物的因果关系及转归。因果关系判定在综合考虑合并症、合并用药及非药物治疗的基础上进行。治疗期出现的不良事件（TEAE）定义为从首次给药开始至完成研究（或提前退出）期间出现的任何不良事件，包括研究期间新出现的不良事件或治疗前已存在但治疗后严重程度等级加重的不良事件。本研究对心血管事件（心血管死亡、非致死性心肌梗死、非致死性卒中）由独立心血管事件裁定委员会进行裁定，裁定结果用于安全性终点分析。注射部位反应、抗药抗体及中和抗体、颌骨骨坏死及非典型股骨骨折由研究者初步评估后提交申办者医学监查员复核。","rationale":"MedDRA编码及TEAE定义框架依据公司语料中不良事件评估条款。心血管事件裁定委员会及安全性终点（MACE、注射部位反应、免疫原性、颌骨骨坏死、非典型股骨骨折）为项目已确认设计事实。因果关系判定类别（如五级分类）及TEAE采集窗口的具体天数在本项目来源中未明确指定，需医学经理确认。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5770a077009c_b0da35a4ce5dc2a1","section_number":"8.5","source_ids":["protocol_full_draft_selection:3d22db965b888f523da746f5","current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9:ec699b5be8be783c","company_corpus:cms_cn_protocol_corpus_20260715_v1:100e0300d2949b","company_corpus:cms_cn_protocol_corpus_20260715_v1:455161bcd6a708","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:da3d46a6971245","company_corpus:cms_cn_protocol_corpus_20260715_v1:be5d06fd3b46ad"]},{"ai_run_id":"airun_20261005030603_0036ad19","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"确认SAE报告时限（24小时/7天/15天）、SUSAR报告路径及伦理委员会/药监部门报告要求","category":"source_missing","gap_id":"gap_86_sae_reporting","missing_source_classes":["本项目安全性报告规程"],"target":"8.6节SAE/SUSAR报告时限与路径"},{"action":"获取DMC章程或确认其组成、会议频率及与申办者的沟通机制","category":"source_missing","gap_id":"gap_86_dmc_charter","missing_source_classes":["DMC章程"],"target":"8.6节DMC运作细节"}],"heading":"不良事件的报告","missing_source_classes":["SAE/SUSAR报告时限与路径","紧急安全性事件沟通机制","DMC章程"],"proposal_text":"","rationale":"死亡事件24小时报告要求及研究者报告职责依据公司语料中不良事件采集与记录条款。DMC设置及期中分析设计（50%事件数、O'Brien-Fleming α消耗）为项目已确认研究事实。SAE/SUSAR具体报告时限（如24小时/7天/15天）、报告路径（申办者→伦理委员会→药监部门）及紧急安全性事件沟通机制在本项目来源中未明确，需医学经理确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_5770a077009c_aab5a6a3009c3281","section_number":"8.6","source_ids":["protocol_full_draft_selection:3d22db965b888f523da746f5","current_project_study_definition:mwdefinition_b4be7d43168c8c1c861f:r9: