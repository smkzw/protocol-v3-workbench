b350249cad_945712cd35cafa46","section_number":"7.3.2","source_ids":["protocol_full_draft_selection:be753189c7206cfa9811b9c1","current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3"]},{"ai_run_id":"airun_20260929234932_35c3e3ad","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_87b350249cad_dcedb3760172c9fc:full-draft:be753189c7206cfa9811b9c1","quote":"章节编号=7.3.3\n章节标题=实验室检查","quote_sha256":"f2a32e4091ca815a4a31f129ac364069d71efed4c140b509ed122d611602769d","source_id":"protocol_full_draft_selection:be753189c7206cfa9811b9c1","span_id":"ev_sec_lab"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"筛选（V-6~0周）：IPSS/QoL、尿流率、前列腺体积（MRI/B超）、PSA、实验室；基线（V0）：随机、首次给药；治疗期每12周访视（V1-V5）：IPSS/QoL、给药依从性、AE；第26与52周加测尿流率与PVR；安全性随访（末次给药后4周）。","quote_sha256":"61efb9ad54d50ffaa1eeed63dd6e24c011c2b11fb09a4ffe3d91c8eb13a99f77","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_visits"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"eGFR<30、肝功能显著异常（ALT/AST>2×ULN）、未控制的高血压或糖尿病。","quote_sha256":"1c5f10346e5ef0b4c3bb5ca909e32cb9912aacbea23375bb2731cdd2936ca3b8","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_exclusions"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"前列腺癌病史或PSA>4.0 ng/mL且需进一步排查者。","quote_sha256":"66df868ebcbc5b8c8115aa99cbcea8e21ffc5d282947f9c0753cc0ce443f78c9","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_psa"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"TEAE/SAE发生率与严重程度；实验室、心电图与生命体征；性功能相关AE（射精功能障碍、性欲减退）","quote_sha256":"a2bd6c6a75d4f174a8eb7f9ba36f47b11cb49e8a3323c8a630f159ae98122d68","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_safety_endpoints"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"安全性按Safety集描述","quote_sha256":"6e4742b6ff8da4c59faec213b835355bbff98c24a5b0608953a79b3fc0e96718","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_safety_analysis"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"50-85岁男性BPH伴LUTS患者，IPSS症状评分≥13分且QoL≥3分；既往未接受BPH手术治疗，未使用或已停用α1阻滞剂/5α还原酶抑制剂足够洗脱期。","quote_sha256":"2604fba5dd3e8f7013a55d58e599b8b2c2c9157fbd5be111d5bf18899d956a90","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_pop"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"R3A-BPH101（口服β3肾上腺素受体激动剂）50mg QD连续52周；维持稳定基础护理与定期前列腺监测。","quote_sha256":"b1141a9a418073c4b001af6bd47898d01954d7c3681c1f008052951c3eb0ddbc","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_treatment"}],"evidence_review_advisories":[],"evidence_span_ids":["ev_sec_lab","ev_visits","ev_exclusions","ev_psa","ev_safety_endpoints","ev_safety_analysis","ev_pop","ev_treatment"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":7},"gap_items":[{"action":"获取实验室操作文件，明确筛选期之后实验室检查的复查时点与频次。","category":"source_missing","gap_id":"gap_lab_schedule","missing_source_classes":["实验室操作文件"],"target":"7.3.3 实验室检查"},{"action":"获取实验室操作文件，明确检验项目组合、样本处理、参考范围及异常值处理流程。","category":"source_missing","gap_id":"gap_lab_panel","missing_source_classes":["实验室操作文件"],"target":"7.3.3 实验室检查"}],"heading":"实验室检查","missing_source_classes":["实验室操作文件"],"proposal_text":"本研究实验室检查在筛选期（V-6~0周）实施，检查结果用于评价受试者是否符合入选与排除标准。具体而言，筛选期实验室检查支持对肾功能（eGFR<30者排除）、肝功能（ALT或AST>2×ULN者排除）及前列腺特异性抗原（PSA>4.0 ng/mL且需进一步排查者排除）等排除标准的判定。实验室指标同时属于安全性终点，将与心电图、生命体征及性功能相关不良事件一并纳入安全性分析，按安全性集进行描述性总结。受试者为50-85岁男性良性前列腺增生伴中重度下尿路症状患者，接受R3A-BPH101 50mg每日一次口服治疗52周。","rationale":"依据已确认的筛选期实验室检查、入选排除标准、安全性终点及安全性集分析撰写。实验室检查在筛选后的复查安排、项目组合、参考范围及异常值处理需医学作者核实补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_87b350249cad_3be3044c6d4e2870","section_number":"7.3.3","source_ids":["protocol_full_draft_selection:be753189c7206cfa9811b9c1","current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3"]},{"ai_run_id":"airun_20260929234932_35c3e3ad","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_87b350249cad_dcedb3760172c9fc:full-draft:be753189c7206cfa9811b9c1","quote":"章节编号=7.3.4\n章节标题=妊娠检查和避孕问询","quote_sha256":"75b639c910a64012ed0e81790f0dd82b93094dc94cc1d8797af7c0e7b9bc8367","source_id":"protocol_full_draft_selection:be753189c7206cfa9811b9c1","span_id":"ev_sec_preg"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"50-85岁男性BPH伴LUTS患者，IPSS症状评分≥13分且QoL≥3分；既往未接受BPH手术治疗，未使用或已停用α1阻滞剂/5α还原酶抑制剂足够洗脱期。","quote_sha256":"2604fba5dd3e8f7013a55d58e599b8b2c2c9157fbd5be111d5bf18899d956a90","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_pop"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"R3A-BPH101（口服β3肾上腺素受体激动剂）50mg QD连续52周；维持稳定基础护理与定期前列腺监测。","quote_sha256":"b1141a9a418073c4b001af6bd47898d01954d7c3681c1f008052951c3eb0ddbc","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_treatment"}],"evidence_review_advisories":[],"evidence_span_ids":["ev_sec_preg","ev_pop","ev_treatment"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"获取项目妊娠与避孕管理文件，明确男性受试者及其伴侣的避孕措施问询、妊娠报告及伴侣妊娠后处理与随访要求。","category":"source_missing","gap_id":"gap_preg_contraception","missing_source_classes":["项目妊娠与避孕管理文件"],"target":"7.3.4 妊娠检查和避孕问询"}],"heading":"妊娠检查和避孕问询","missing_source_classes":["项目妊娠与避孕管理文件"],"proposal_text":"妊娠检查和避孕问询的对象为50-85岁男性受试者及其伴侣。本研究目标人群为50-85岁男性良性前列腺增生伴中重度下尿路症状患者，研究治疗为R3A-BPH101 50mg每日一次口服连续52周。由于研究不纳入女性受试者，不设置女性受试者的妊娠检查。","rationale":"依据已确认的男性研究人群和治疗周期撰写。男性受试者及其伴侣的避孕措施、妊娠报告及伴侣妊娠后处理与随访需医学作者核实补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_87b350249cad_0e4f2f4f2342d952","section_number":"7.3.4","source_ids":["protocol_full_draft_selection:be753189c7206cfa9811b9c1","current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3"]},{"ai_run_id":"airun_20260929234932_35c3e3ad","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_87b350249cad_dcedb3760172c9fc:full-draft:be753189c7206cfa9811b9c1","quote":"章节编号=8\n章节标题=安全性评价","quote_sha256":"3ff161f4933ee3f7f658c4ec2f350776528971594de4dce073030dafb9175560","source_id":"protocol_full_draft_selection:be753189c7206cfa9811b9c1","span_id":"ev_sec_safety"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"TEAE/SAE发生率与严重程度；实验室、心电图与生命体征；性功能相关AE（射精功能障碍、性欲减退）","quote_sha256":"a2bd6c6a75d4f174a8eb7f9ba36f47b11cb49e8a3323c8a630f159ae98122d68","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_safety_endpoints"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"筛选期（最长6周）；双盲治疗期（52周，每日口服一次）；安全性随访（末次给药后4周）","quote_sha256":"6853ec69b4e67ea2604e1f26a650ee19e8069b0aa73a232f2b266d2d0eafb556","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_periods"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"筛选（V-6~0周）：IPSS/QoL、尿流率、前列腺体积（MRI/B超）、PSA、实验室；基线（V0）：随机、首次给药；治疗期每12周访视（V1-V5）：IPSS/QoL、给药依从性、AE；第26与52周加测尿流率与PVR；安全性随访（末次给药后4周）。","quote_sha256":"61efb9ad54d50ffaa1eeed63dd6e24c011c2b11fb09a4ffe3d91c8eb13a99f77","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_visits"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"安全性按Safety集描述","quote_sha256":"6e4742b6ff8da4c59faec213b835355bbff98c24a5b0608953a79b3fc0e96718","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_safety_analysis"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"DMC是否计划：是","quote_sha256":"9967a9a75297ced2326ab733fa3b16934acdef641fa765dd50c1cd58219f4aa5","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_dmc"}],"evidence_review_advisories":[],"evidence_span_ids":["ev_sec_safety","ev_safety_endpoints","ev_periods","ev_visits","ev_safety_analysis","ev_dmc"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"获取安全性管理文件，明确AE/SAE/SUSAR定义、因果关系判断、报告对象、报告时限及数据处理流程。","category":"source_missing","gap_id":"gap_ae_definitions","missing_source_classes":["安全性管理文件（含AE/SAE/SUSAR定义与报告流程）"],"target":"8 安全性评价"},{"action":"获取研究者手册等研究药物风险资料，明确具体风险、剂量调整、合并用药限制及安全性监测要求。","category":"source_missing","gap_id":"gap_drug_risk","missing_source_classes":["研究者手册等研究药物风险资料"],"target":"8 安全性评价"},{"action":"获取安全性随访操作文件，明确末次给药后4周安全性随访的评估项目和数据收集要求。","category":"source_missing","gap_id":"gap_safety_followup","missing_source_classes":["安全性随访操作文件"],"target":"8 安全性评价"},{"action":"获取数据监查委员会章程，明确其组成、职责、审阅频率和决策权限。","category":"source_missing","gap_id":"gap_dmc_charter","missing_source_classes":["数据监查委员会章程"],"target":"8 安全性评价"}],"heading":"安全性评价","missing_source_classes":["安全性管理文件（含AE/SAE/SUSAR定义与报告流程）","研究者手册等研究药物风险资料","安全性随访操作文件","数据监查委员会章程"],"proposal_text":"本研究安全性评价基于安全性集进行描述性分析。安全性终点包括治疗期间出现的不良事件（TEAE）和严重不良事件（SAE）的发生率与严重程度，实验室检查、心电图与生命体征，以及性功能相关不良事件（射精功能障碍、性欲减退）。研究包括筛选期（最长6周）、双盲治疗期（52周）和末次给药后4周的安全性随访。双盲治疗期每12周访视（V1至V5）收集不良事件并评估给药依从性。研究计划设立数据监查委员会（DMC）。","rationale":"依据已确认的安全性终点、安全性集分析、研究时期、访视中的不良事件收集及DMC计划撰写。AE/SAE/SUSAR定义、报告流程、研究药物具体风险及安全性管理要求需医学作者核实补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_87b350249cad_53cdd9a9b7ca22e4","section_number":"8","source_ids":["protocol_full_draft_selection:be753189c7206cfa9811b9c1","current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3"]}],"source_bindings":[{"content_sha256":"4eb1ed583c39bd1bb6bfa9cbd821659f10a004e7c6ddabb5b8f420dab312d273","locator":"document:mwdoc_greenfield_proj_user_87b350249cad_dcedb3760172c9fc:full-draft:be753189c7206cfa9811b9c1","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:be753189c7206cfa9811b9c1","source_type":"protocol_full_draft_selection","source_version":"full-draft:f94942df2b54539a7bb61ed3d77887d5d31e6dfd7ae9f01e5fbb9073f52d3970:be753189c7206cfa9811b9c1","text_sha256":"4eb1ed583c39bd1bb6bfa9cbd821659f10a004e7c6ddabb5b8f420dab312d273"},{"content_sha256":"7d3e402d3cc3463c846cf6c10bdb2cccb5427e7182652e8266fbdf266f23755b","locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","source_type":"current_project_study_definition","source_version":"mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","text_sha256":"7d3e402d3cc3463c846cf6c10bdb2cccb5427e7182652e8266fbdf266f23755b"}]}