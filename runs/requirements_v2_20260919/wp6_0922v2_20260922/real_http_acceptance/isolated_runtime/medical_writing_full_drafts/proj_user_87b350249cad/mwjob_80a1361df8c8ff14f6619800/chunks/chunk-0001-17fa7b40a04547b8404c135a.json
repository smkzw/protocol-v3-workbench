8590875:r4:41c849f3ebaa5aa3","span_id":"ev_safety"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"筛选期（最长6周）；双盲治疗期（52周，每日口服一次）；安全性随访（末次给药后4周）","quote_sha256":"6853ec69b4e67ea2604e1f26a650ee19e8069b0aa73a232f2b266d2d0eafb556","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_periods"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"筛选（V-6~0周）：IPSS/QoL、尿流率、前列腺体积（MRI/B超）、PSA、实验室；基线（V0）：随机、首次给药；治疗期每12周访视（V1-V5）：IPSS/QoL、给药依从性、AE；第26与52周加测尿流率与PVR；安全性随访（末次给药后4周）。","quote_sha256":"61efb9ad54d50ffaa1eeed63dd6e24c011c2b11fb09a4ffe3d91c8eb13a99f77","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_visits"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"治疗策略（treatment policy）：mITT人群第52周IPSS总评分较基线的变化，不因依从性、合并BPH用药或脱落改变归属；缺失值主分析采用MMRM。","quote_sha256":"488833ef9a0ab4b300179c2cbb097a199b1e955231167830a594234b7a1f24e0","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_estimand"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"假设第52周IPSS较基线变化组间差异2.0分（SD 5.0），α=0.05双侧、把握度90%，每组290例可评价；按20%脱落率入组726例（每组363例）。","quote_sha256":"a614ad49604f64d0a6b1dc2f7b9bb1abc98cfd8f78605df604976f42b255c4e8","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_sample"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"主要终点ANCOVA（协变量：基线IPSS、中心分层），mITT主分析集；关键次要终点按固定顺序控制多重性；安全性按Safety集描述；补充混合模型与插补敏感性分析。","quote_sha256":"f9c8430d29555995e39fa34f1d7ff3f5250083ec500ab283321a153156add6dc","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_analysis"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"自适应设计是否计划：否\n样本量再估计是否计划：否\n期中分析是否计划：否\nSRC是否计划：否\nDMC是否计划：是","quote_sha256":"e10a8d8a6f45953940dc44db993ce4fb5844ebb3a5b49c85365d79e0b89c8c97","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_dmc"}],"evidence_review_advisories":[],"evidence_span_ids":["ev_pkt_s1","ev_protocol_no","ev_title","ev_phase_region","ev_design","ev_population","ev_inclusion","ev_washout","ev_intervention","ev_dose","ev_placebo","ev_arms","ev_primary","ev_safety","ev_periods","ev_visits","ev_estimand","ev_sample","ev_analysis","ev_dmc"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":19},"gap_items":[],"heading":"方案概要","missing_source_classes":[],"proposal_text":"本研究为R3A-BPH101（口服β3肾上腺素受体激动剂）用于治疗良性前列腺增生的III期确证性临床研究，方案编号MW-III-E2E15AAA-DRAFT，方案版本为草案，开发区域为中国。研究采用随机、双盲、安慰剂对照、平行组、多中心设计，计划入组726例受试者，以相等例数随机分配至R3A-BPH101 50mg组或安慰剂组，每组363例。目标人群为50-85岁男性良性前列腺增生（BPH）伴中重度下尿路症状（LUTS）患者，IPSS总评分≥13且QoL≥3，前列腺体积30-80mL；既往未接受BPH手术治疗，未使用α1阻滞剂/5α还原酶抑制剂或已停用足够洗脱期（α1阻滞剂与抗毒蕈碱类药物停用≥4周，5α还原酶抑制剂停用≥12周）。试验组接受R3A-BPH101 50mg薄膜衣片每日一次（QD）整片吞服，连续52周，漏服当日不补服；对照组接受安慰剂薄膜衣片QD×52周双盲双模拟给药；两组均维持稳定基础护理与定期前列腺监测。主要终点为治疗第52周IPSS总评分较基线的变化，其估计目标采用治疗策略（treatment policy），在mITT人群中分析，缺失值主分析采用MMRM。安全性终点包括TEAE/SAE发生率与严重程度、实验室检查、心电图与生命体征，以及性功能相关AE（射精功能障碍、性欲减退）。研究设筛选期（最长6周）、双盲治疗期（52周，每日口服一次）和安全性随访（末次给药后4周）；筛选期（V-6~0周）采集IPSS/QoL、尿流率、前列腺体积（MRI/B超）、PSA及实验室检查，基线（V0）进行随机与首次给药，治疗期每12周访视（V1-V5）评估IPSS/QoL、给药依从性与AE，第26周与第52周加测尿流率与PVR。样本量基于第52周IPSS较基线变化组间差异2.0分（SD 5.0）的假设，采用α=0.05双侧检验、把握度90%，每组290例可评价，按20%脱落率入组726例（每组363例）；主要分析采用以基线IPSS和中心分层为协变量的ANCOVA（mITT主分析集），关键次要终点按固定顺序控制多重性，安全性按Safety集描述，并补充混合模型与插补敏感性分析。研究设数据监查委员会（DMC），不计划自适应设计、样本量再估计、期中分析与SRC。","rationale":"该章节内容由当前项目已确认研究事实支持，覆盖研究题目与方案编号、III期确证性随机双盲安慰剂对照平行组多中心设计、50-85岁BPH伴中重度LUTS人群及洗脱要求、50mg QD×52周给药与安慰剂双盲双模拟、第52周IPSS较基线变化主要终点、安全性终点、筛选期/双盲治疗期/安全性随访及V1-V5访视安排、726例样本量与统计分析和DMC计划。医学作者需核对方案编号与版本状态、样本量假设参数的最终数值以及统计分析方法。","review_advisories":["本节复述高影响研究设计（方案概要）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（α、主要终点、估计目标、期中分析、样本量、计划入组）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_87b350249cad_0850b563dc378ad9","section_number":"1","source_ids":["protocol_full_draft_selection:17fa7b40a04547b8404c135a","current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:8906e921bf8a9f","company_corpus:cms_cn_protocol_corpus_20260715_v1:367cbc36976ba5"]},{"ai_run_id":"airun_20260929203601_f4180621","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"补充BPH流行病学与疾病负担来源并关联至本项目后，再完成该部分正文","category":"source_missing","gap_id":"gap_disease_epi_burden","missing_source_classes":["流行病学数据来源","疾病负担数据来源"],"target":"2.1疾病背景及治疗现状正文中流行病学与疾病负担内容"},{"action":"补充BPH临床指南或共识及治疗现状来源并关联至本项目后，再完成该部分正文","category":"source_missing","gap_id":"gap_disease_guideline_treatment","missing_source_classes":["临床指南或专家共识","治疗现状与标准治疗资料"],"target":"2.1疾病背景及治疗现状正文中指南与治疗现状内容"}],"heading":"疾病背景及治疗现状","missing_source_classes":["流行病学数据来源","疾病负担数据来源","临床指南或专家共识","治疗现状与标准治疗资料"],"proposal_text":"","rationale":"该章节缺少流行病学、疾病负担、临床指南与治疗现状来源，无法形成有实质依据的正文；在补充相应来源并关联到本项目前，该章节保留为空，以免以通用背景表述替代项目事实。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_87b350249cad_abe2e008e559679f","section_number":"2.1","source_ids":["protocol_full_draft_selection:17fa7b40a04547b8404c135a","current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:8906e921bf8a9f","company_corpus:cms_cn_protocol_corpus_20260715_v1:367cbc36976ba5"]},{"ai_run_id":"airun_20260929203601_f4180621","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_87b350249cad_dcedb3760172c9fc:full-draft:17fa7b40a04547b8404c135a","quote":"SECTION_ID=mwsec_greenfield_proj_user_87b350249cad_69e32293ffb3dedd\n章节编号=2.3\n章节标题=研究药物简介\n章节类型=section\n当前正文=R3A-BPH101（口服β3肾上腺素受体激动剂）","quote_sha256":"1e057d20d2fd1b46be97d0f47a675bf07c021d59499921fdaf358e96bb8be3ba","source_id":"protocol_full_draft_selection:17fa7b40a04547b8404c135a","span_id":"ev_pkt_s3"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"研究题目：R3A-BPH101（口服β3肾上腺素受体激动剂）用于治疗良性前列腺增生的III期临床研究","quote_sha256":"8e081cdb75d5586227968e1e5f62b7f8b92f6d22568d5a2e5343645b3e9c6cb3","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_title"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"药物技术类型：small_molecule\n给药途径：口服\n剂型：口服固体制剂\n局部/系统暴露范围：systemic","quote_sha256":"93d70823288385813f38b773b8c6e7bba227a7ed893796844d8834e9f3bae884","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_tech"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"R3A-BPH101（口服β3肾上腺素受体激动剂）：50mg薄膜衣片QD整片吞服，连续52周；漏服当日不补服。","quote_sha256":"0d53d7658f382a00f08939d199bcfbf4b7a6d1531d5fa626d5279d5072456002","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_dose"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"R3A-BPH101（口服β3肾上腺素受体激动剂）50mg QD连续52周；维持稳定基础护理与定期前列腺监测。","quote_sha256":"b1141a9a418073c4b001af6bd47898d01954d7c3681c1f008052951c3eb0ddbc","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_intervention"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"安慰剂薄膜衣片QD×52周双盲双模拟；主要比较R3A-BPH101 50mg组 vs 安慰剂组第52周IPSS较基线变化。","quote_sha256":"e81e4ce8fda7d6251ddfcb3babaea0b23efe2179810564e4cf02f9879e6d9dd9","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_placebo"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"试验组与对照组：R3A-BPH101 50mg组；安慰剂组","quote_sha256":"0c9d63cd3e0dc9a7384b59d4751f963d57ba8e043db6524addbe016c55028e27","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_arms"}],"evidence_review_advisories":[],"evidence_span_ids":["ev_pkt_s3","ev_title","ev_tech","ev_dose","ev_intervention","ev_placebo","ev_arms"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"补充研究者手册及既往临床研究资料并关联至本项目后，再完成相应内容","category":"source_missing","gap_id":"gap_drug_ib_clinical","missing_source_classes":["研究者手册（IB）","研究药物既往临床研究资料","药代动力学资料"],"target":"2.3研究药物简介正文中既往临床研究经验与药代动力学内容"},{"action":"补充研究药物具体风险来源（如研究者手册安全性部分）并关联至本项目后，再完成相应内容","category":"source_missing","gap_id":"gap_drug_specific_risk","missing_source_classes":["研究药物安全性/风险资料","研究者手册安全性部分"],"target":"2.3研究药物简介正文中研究药物具体风险内容"}],"heading":"研究药物简介","missing_source_classes":["研究者手册（IB）","研究药物既往临床研究资料","药代动力学资料","研究药物具体风险资料"],"proposal_text":"R3A-BPH101是一种口服β3肾上腺素受体激动剂，属于小分子药物，剂型为口服固体制剂，经口服途径给药后产生全身暴露，用于良性前列腺增生的治疗。在本研究中，R3A-BPH101的规格为50mg薄膜衣片，给药方案为每日一次（QD）整片吞服，连续给药52周，漏服当日不补服。对照组使用安慰剂薄膜衣片，按QD×52周给药，采用双盲双模拟设计。两组受试者均维持稳定的基础护理与定期前列腺监测，主要比较R3A-BPH101 50mg组与安慰剂组第52周IPSS总评分较基线的变化。","rationale":"研究药物名称、β3肾上腺素受体激动剂类别、小分子属性、口服途径、口服固体制剂剂型、50mg薄膜衣片QD×52周给药方案及安慰剂双盲双模拟设置均由已确认研究事实支持。既往人体研究经验、药代动力学特征与具体风险缺少研究者手册等来源，医学作者需在获得相应资料后补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_87b350249cad_69e32293ffb3dedd","section_number":"2.3","source_ids":["protocol_full_draft_selection:17fa7b40a04547b8404c135a","current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:8906e921bf8a9f","company_corpus:cms_cn_protocol_corpus_20260715_v1:367cbc36976ba5"]},{"ai_run_id":"airun_20260929203601_f4180621","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"补充非临床药理学、毒理学与药代动力学研究资料或研究者手册非临床部分并关联至本项目后，再完成该章节正文","category":"source_missing","gap_id":"gap_nonclinical_results","missing_source_classes":["非临床药理学研究报告","毒理学研究报告","药代动力学/毒代动力学资料","研究者手册非临床部分"],"target":"2.3.1非临床研究结果全章正文"}],"heading":"非临床研究结果","missing_source_classes":["非临床药理学研究报告","毒理学研究报告","药代动力学/毒代动力学资料","研究者手册非临床部分"],"proposal_text":"","rationale":"该章节缺少非临床药理学、毒理学与药代动力学研究资料或研究者手册非临床部分，无法形成有实质依据的正文；在补充相应来源并关联到本项目前保留为空。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_87b350249cad_92f15861daed59bd","section_number":"2.3.1","source_ids":["protocol_full_draft_selection:17fa7b40a04547b8404c135a","current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:8906e921bf8a9f","company_corpus:cms_cn_protocol_corpus_20260715_v1:367cbc36976ba5"]}],"source_bindings":[{"content_sha256":"f86047c3fd42a12c6f0455b2cec9