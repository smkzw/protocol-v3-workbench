ote_sha256":"828399b9c46dfa4a3d4d76ca2adb0bbf23f0a0487ab8410f4b48650e6d18aab0","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_b_stats_order"},{"locator":"study_definition:mwdefinition_c8f522c6663608590875:revision:4","quote":"筛选期（最长6周）；双盲治疗期（52周，每日口服一次）；安全性随访（末次给药后4周）","quote_sha256":"6853ec69b4e67ea2604e1f26a650ee19e8069b0aa73a232f2b266d2d0eafb556","source_id":"current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","span_id":"ev_b_periods"}],"evidence_review_advisories":[],"evidence_span_ids":["ev_a_sec32_title","ev_b_safety","ev_b_stats_order","ev_b_periods"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"补充当前项目关键次要终点清单及其多重性检验顺序后，更新本章节正文","category":"source_missing","gap_id":"gap_sec32_secondary_endpoints","missing_source_classes":["当前项目关键次要终点清单及其定义","统计分析计划或统计设计文档（含多重性检验顺序）"],"target":"3.2 次要目的和次要终点——关键次要疗效终点条目、定义与固定顺序检验次序"}],"heading":"次要目的和次要终点","missing_source_classes":["当前项目关键次要终点清单及其定义","统计分析计划或统计设计文档（含多重性检验顺序）"],"proposal_text":"本研究的次要目的包括评价R3A-BPH101治疗的安全性与耐受性，以及在主要终点评价的基础上评价关键次要终点；关键次要终点按固定顺序控制多重性。安全性评价内容包括治疗期不良事件（TEAE）与严重不良事件（SAE）的发生率与严重程度、实验室检查、心电图与生命体征，以及性功能相关不良事件（射精功能障碍、性欲减退）。上述评价覆盖双盲治疗期，并延续至末次给药后4周的安全性随访。","rationale":"本段依据已确认研究事实撰写：关键次要终点按固定顺序控制多重性；安全性终点包括TEAE/SAE发生率与严重程度、实验室检查、心电图与生命体征及性功能相关AE；安全性随访于末次给药后4周进行。关键次要疗效终点的具体条目、定义与检验次序未在已确认来源中列明，已作为待补来源列出；医学作者还需核定安全性数据采集时点表述与访视安排的一致性。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_87b350249cad_33f28732ca32531a","section_number":"3.2","source_ids":["protocol_full_draft_selection:a7a27e32dfeb8cbec16b2e8d","current_project_study_definition:mwdefinition_c8f522c6663608590875:r4:41c849f3ebaa5aa3","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715