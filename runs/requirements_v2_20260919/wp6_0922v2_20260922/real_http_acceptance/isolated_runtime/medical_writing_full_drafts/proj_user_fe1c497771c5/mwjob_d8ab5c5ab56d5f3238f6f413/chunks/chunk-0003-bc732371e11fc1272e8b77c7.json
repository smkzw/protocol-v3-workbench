s"},{"locator":"document:mwdoc_greenfield_proj_user_fe1c497771c5_9d1504b5410e545a:full-draft:bc732371e11fc1272e8b77c7","quote":"SECTION_ID=mwsec_greenfield_proj_user_fe1c497771c5_66b9d154678f483a\n章节编号=4\n章节标题=研究设计\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"2b03c8de61c07cc5b48952aefa764dfec935ebfdcd3fbd8497879accc07f3b1c","source_id":"protocol_full_draft_selection:bc732371e11fc1272e8b77c7","span_id":"sp_sel_4"}],"evidence_review_advisories":[],"evidence_span_ids":["sp_def_design","sp_def_dev_region","sp_def_population2","sp_def_inclusion","sp_def_arms","sp_def_dosing","sp_def_placebo","sp_def_periods","sp_def_visits","sp_def_estimand","sp_def_sample","sp_def_stats","sp_sel_4"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":12},"gap_items":[{"action":"补充随机化方法、盲法实施和揭盲流程的项目来源或职能确认。","category":"source_missing","gap_id":"gap_sec4_randomization_blinding","missing_source_classes":["随机化与盲法实施相关项目文件"],"target":"4 研究设计"},{"action":"补充FAS与SS等分析集定义及缺失数据处理规则的项目来源。","category":"source_missing","gap_id":"gap_sec4_analysis_sets","missing_source_classes":["统计分析计划或分析集定义文件"],"target":"4 研究设计"},{"action":"补充剂量调整、暂停、恢复或永久停药规则的项目来源。","category":"source_missing","gap_id":"gap_sec4_dose_modification","missing_source_classes":["研究药物给药与剂量调整相关项目文件"],"target":"4 研究设计"},{"action":"补充AE/SAE定义、采集与报告时限、妊娠报告等安全性实施规则的项目来源。","category":"source_missing","gap_id":"gap_sec4_safety_reporting","missing_source_classes":["安全性报告与妊娠处理相关项目文件"],"target":"4 研究设计"}],"heading":"研究设计","missing_source_classes":["随机化与盲法实施相关项目文件","统计分析计划或分析集定义文件","研究药物给药与剂量调整相关项目文件","安全性报告与妊娠处理相关项目文件"],"proposal_text":"本研究为随机、双盲、安慰剂对照、平行组、多中心II期剂量探索研究，开发区域为中国。受试者为年龄18-75岁、LVEF≤40%、NYHA II-III级、在稳定剂量GDMT至少4周基础上仍有症状的慢性HFrEF成人患者。受试者按1:1:1随机分配至SGC-R22低剂量组2.5mg每日一次、SGC-R22高剂量组5mg每日一次或安慰剂组每日一次；安慰剂为口服片，外观与频次与试验药一致，双盲治疗12周。研究时期包括筛选期（最长14天）、双盲治疗期（12周）和安全性随访期（末次给药后14天）；访视包括筛选（D-14至D-1）、随机（D0）、W4/W8/W12访视、治疗结束与安全性随访。主要估计目标为随机化人群第12周NT-proBNP较基线百分比变化，死亡或心衰住院退出按治疗策略处理。样本量假设安慰剂组NT-proBNP平均降15%、试验组降30%、SD=25%，双侧α=0.05、把握度80%，每组约60例，三组180例，考虑10%脱落约200例。主要终点采用ANCOVA分析，包含基线协变量和组别固定效应；安全性采用描述统计；FAS与SS分别定义。","rationale":"正文依据当前项目已确认研究事实中的总体设计、开发区域、受试人群、试验组与对照组、剂量与给药方案、研究时期、访视策略、估计目标、样本量和统计分析策略撰写。随机化方法、盲法实施、揭盲流程、分析集定义、缺失数据处理、剂量调整和安全性报告等实施细节未在允许来源中提供，已列入待确认项；请医学作者确认样本量假设和统计方法是否与最终统计分析计划一致。","review_advisories":["本节复述高影响研究设计（研究设计）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（α、主要终点、估计目标、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_fe1c497771c5_66b9d154678f483a","section_number":"4","source_ids":["protocol_full_draft_selection:bc732371e11fc1272e8b77c7","current_project_study_definition:mwdefinition_2de134b50e0bce848347:r4:5f6c0d0d89036c7e"]}],"source_bindings":[{"content_sha256":"c5def89e1c343691ecd55691b798be7f0bce94cdc4bbc29c8a8e904adfb78933","locator":"document:mwdoc_greenfield_proj_user_fe1c497771c5_9d1504b5410e545a:full-draft:bc732371e11fc1272e8b77c7","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:bc732371e11fc1272e8b77c7","source_type":"protocol_full_draft_selection","source_version":"full-draft:b2fad76b695bf897b4e04ce3505081473b5300c0c367ca70655b286de53d9ad1:bc732371e11fc1272e8b77c7","text_sha256":"c5def89e1c343691ecd55691b798be7f0bce94cdc4bbc29c8a8e904adfb78933"},{"content_sha256":"cdd5a150f7cda98ee48b97371d97169298a9052ee8304fb7640781c76b58e16e","locator":"study_definition:mwdefinition_2de134b50e0bce848347:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_2de134b50e0bce848347:r4:5f6c0d0d89036c7e","source_type":"current_project_study_definition","source_version":"mwdefinition_2de134b50e0bce848347:r4:5f6c0d0d89036c7e","text_sha256":"cdd5a150f7cda98ee48b97371d97169298a9052ee8304fb7640781c76b58e16e"}]}