管理及安全性报告等全部研究活动须遵循《中华人民共和国药品管理法》《药物临床试验质量管理规范》及国家药品监督管理局发布的相关技术指导原则。申办方及研究者应确保研究在伦理委员会批准和药品监督管理部门许可或备案的框架内实施，任何方案修改、严重不良事件报告及研究提前终止均须按法规要求向相应监管部门报告。研究期间产生的全部数据应可追溯、可核查，接受药品监督管理部门的检查与审计。","rationale":"依据项目研究定义确认开发区域为中国、研究分期为III期、内在研究目的为确证性研究，据此确定适用中国药品监管法规体系。具体适用的法规清单、申报路径及备案要求需医学经理根据项目注册策略补充确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_9c471afb8c57b7a4","section_number":"11.1","source_ids":["protocol_full_draft_selection:8b4e4507d1d1fedc1f8b586f","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","company_corpus:cms_cn_protocol_corpus_20260715_v1:42d49ba7a285ce","company_corpus:cms_cn_protocol_corpus_20260715_v1:582cc728dae6fe","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:3d4fa32554415b","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc98aacc7e06ca"]},{"ai_run_id":"airun_20261005000447_2a99c251","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:试验参与者知情同意书|block:906|chunk:1","quote":"知情同意书分为成年人、未成年人及监护人版本，经过伦理委员会的审批之后方可使用。","quote_sha256":"2acebffe2bcacc2b4c22948a73b66ff040ee70fcbe02b33a6a441bde4fe38204","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:42d49ba7a285ce","span_id":"es_002"},{"locator":"section:试验参与者知情同意书|block:908|chunk:1","quote":"知情同意书的任何修改需经所在临床研究医院伦理委员会批准后执行，未出组患者必须重新签署新版知情同意书。","quote_sha256":"bb9c04474a3b8ea11eb6af9fde69b3f838645f116f0588d9a5fe4887129d2a78","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:582cc728dae6fe","span_id":"es_003"},{"locator":"section:4.1.1 筛选期|block:677|chunk:1","quote":"知情同意并签署 ICF；","quote_sha256":"289780804af814a372538eb298054487fa0ba1d93be6500affa63d01db7a2b2b","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:fc98aacc7e06ca","span_id":"es_004"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"自愿签署知情同意","quote_sha256":"074c0c70e960a8bc458530ca9dbdadf3bf6b4f184543d29bf772c5307ba5f3b1","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_005"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003","es_004","es_005"],"evidence_summary":{"corpus_spans":3,"project_fact_spans":1},"gap_items":[{"action":"检索并确认本项目知情同意书具体版本编号、语言版本及是否采用电子知情同意","category":"source_not_retrieved","gap_id":"gap_11_2_icf_version","missing_source_classes":["知情同意书版本文件"],"target":"11.2 知情同意"},{"action":"确认入组年龄下限18岁条件下是否保留未成年人/监护人版本条款","category":"decision_pending","gap_id":"gap_11_2_minor","missing_source_classes":[],"target":"11.2 知情同意"}],"heading":"知情同意","missing_source_classes":["知情同意书版本编号及语言版本","电子知情同意采用说明","未成年人版本适用性确认（入组年龄下限18岁）"],"proposal_text":"本研究的知情同意书分为成年人版本及监护人版本，须经所在临床研究医院伦理委员会审批后方可使用。受试者须在筛选期完成知情同意签署，签署后方可进行任何研究相关操作。本研究的入选标准要求受试者自愿签署知情同意，研究者须向受试者充分说明研究目的、试验干预（KZ-6210 162 mg皮下注射每4周一次或匹配安慰剂）、预期获益与风险、替代治疗选择及受试者权利。知情同意书的任何修改须经所在临床研究医院伦理委员会批准后执行，未出组受试者必须重新签署新版知情同意书。知情同意过程及受试者签署日期须完整记录于原始病历及病例报告表中。","rationale":"依据公司语料确认知情同意书分版本及伦理审批要求、修改后重新签署要求及筛选期签署时点；依据项目研究定义确认入组年龄18–70岁、自愿签署知情同意及试验干预方案。本研究入组年龄下限为18岁，是否实际使用未成年人/监护人版本需医学经理确认；知情同意书具体版本编号、语言版本及电子知情同意采用情况需补充项目级来源。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_99826205ef9b9270","section_number":"11.2","source_ids":["protocol_full_draft_selection:8b4e4507d1d1fedc1f8b586f","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","company_corpus:cms_cn_protocol_corpus_20260715_v1:42d49ba7a285ce","company_corpus:cms_cn_protocol_corpus_20260715_v1:582cc728dae6fe","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:3d4fa32554415b","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc98aacc7e06ca"]},{"ai_run_id":"airun_20261005000447_2a99c251","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:试验参与者知情同意书|block:906|chunk:1","quote":"知情同意书分为成年人、未成年人及监护人版本，经过伦理委员会的审批之后方可使用。","quote_sha256":"2acebffe2bcacc2b4c22948a73b66ff040ee70fcbe02b33a6a441bde4fe38204","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:42d49ba7a285ce","span_id":"es_002"},{"locator":"section:试验参与者知情同意书|block:908|chunk:1","quote":"知情同意书的任何修改需经所在临床研究医院伦理委员会批准后执行，未出组患者必须重新签署新版知情同意书。","quote_sha256":"bb9c04474a3b8ea11eb6af9fde69b3f838645f116f0588d9a5fe4887129d2a78","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:582cc728dae6fe","span_id":"es_003"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":0},"gap_items":[{"action":"补充各参与中心伦理委员会名称、主审/备案层级及多中心伦理协调安排","category":"source_missing","gap_id":"gap_11_3_ec_names","missing_source_classes":["伦理委员会批件","多中心伦理协调文件"],"target":"11.3 伦理委员会"}],"heading":"伦理委员会","missing_source_classes":["伦理委员会名称及审查层级","多中心伦理协调机制","年度跟踪审查安排"],"proposal_text":"本研究为多中心设计，各参与中心在启动前须获得所在临床研究医院伦理委员会的书面批准。知情同意书及本方案须经伦理委员会审批后方可使用。知情同意书的任何修改需经所在临床研究医院伦理委员会批准后执行。伦理委员会的审查范围涵盖研究方案、知情同意书、受试者招募材料、安全性报告及年度跟踪审查。研究者须按照伦理委员会批准的方案实施研究，任何偏离须经伦理委员会事先批准或事后报告。","rationale":"依据公司语料确认知情同意书须经伦理委员会审批、修改须经伦理委员会批准的结构要求；依据项目研究定义确认多中心设计。具体伦理委员会名称、主审与备案层级、多中心伦理协调机制及年度跟踪审查频率需医学经理根据各中心实际情况补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_69c23bddb75e17bc","section_number":"11.3","source_ids":["protocol_full_draft_selection:8b4e4507d1d1fedc1f8b586f","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","company_corpus:cms_cn_protocol_corpus_20260715_v1:42d49ba7a285ce","company_corpus:cms_cn_protocol_corpus_20260715_v1:582cc728dae6fe","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:3d4fa32554415b","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc98aacc7e06ca"]},{"ai_run_id":"airun_20261005000447_2a99c251","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:文档开头|block:4|chunk:1","quote":"本方案中所包含的所有信息归申办方所有，因此，仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构进行审阅。在未得到申办方书面批准的情况下，除了在与可能参加本研究的受试者签署知情同意书时，向其做必要的解释外，严禁将任何信息告知与本研究无关的第三方。","quote_sha256":"dfc9fceb41db9d941df0e3715483adaa069da4f1953600a6a37a56d7f81373dd","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","span_id":"es_006"}],"evidence_review_advisories":[],"evidence_span_ids":["es_006"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":0},"gap_items":[{"action":"补充数据脱敏标准、电子数据系统合规认证及跨境数据传输安排","category":"source_missing","gap_id":"gap_11_4_data_protection","missing_source_classes":["数据管理计划","电子数据系统合规文件"],"target":"11.4 保密与隐私"}],"heading":"保密与隐私","missing_source_classes":["数据管理计划","电子数据系统合规文件","跨境数据传输安排","数据保留期限规定"],"proposal_text":"本方案中所包含的所有信息归申办方所有，仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构进行审阅。在未得到申办方书面批准的情况下，除在与可能参加本研究的受试者签署知情同意书时向其做必要的解释外，严禁将任何信息告知与本研究无关的第三方。受试者的个人身份识别信息须按照《中华人民共和国个人信息保护法》及《药物临床试验质量管理规范》的要求予以保护，研究记录中应以受试者编号替代直接标识符。各研究中心须建立受试者隐私保护的操作规程，确保原始病历、电子数据采集系统及数据传输过程中的保密性。","rationale":"依据公司语料确认方案信息归属及保密条款的通用结构；依据项目研究定义确认开发区域为中国，据此引用个人信息保护法及GCP隐私要求。具体数据脱敏标准、电子数据系统合规认证、跨境数据传输安排及数据保留期限需医学经理根据项目数据管理计划补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_fc48dc9350815fb8","section_number":"11.4","source_ids":["protocol_full_draft_selection:8b4e4507d1d1fedc1f8b586f","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","company_corpus:cms_cn_protocol_corpus_20260715_v1:42d49ba7a285ce","company_corpus:cms_cn_protocol_corpus_20260715_v1:582cc728dae6fe","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:3d4fa32554415b","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc98aacc7e06ca"]}],"source_bindings":[{"content_sha256":"a89672357eb87c25698d2fff5aeefe43bbbe8e740308028610df61