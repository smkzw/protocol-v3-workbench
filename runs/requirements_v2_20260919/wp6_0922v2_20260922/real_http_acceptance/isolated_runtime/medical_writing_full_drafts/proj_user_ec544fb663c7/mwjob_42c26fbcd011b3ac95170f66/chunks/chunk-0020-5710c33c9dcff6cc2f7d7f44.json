cdef641fa765dd50c1cd58219f4aa5","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_dmc"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"随机、双盲、安慰剂对照、平行分组、多中心III期设计","quote_sha256":"08797acd53fefc42a0066be9565f4700830f8281528c2c4868807cbebf70d95a","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_design"}],"evidence_review_advisories":[],"evidence_span_ids":["es_audit_corpus","es_monitoring_corpus","es_dmc","es_design"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":2},"gap_items":[{"action":"补充项目级监查计划或稽查SOP","category":"source_missing","gap_id":"gap_audit_01","missing_source_classes":["项目级监查计划","稽查SOP"],"target":"稽查频率、稽查团队组成及报告路径"},{"action":"确认DMC章程是否另行制定及本章节是否需引用","category":"source_missing","gap_id":"gap_audit_02","missing_source_classes":["独立数据监查委员会章程"],"target":"独立数据监查委员会章程引用及本章节与章程的衔接"}],"heading":"稽查和核查","missing_source_classes":["项目级监查计划","独立数据监查委员会章程","研究中心稽查SOP"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂对照、平行分组III期设计，开发区域为中国，计划设立独立数据监查委员会。申办者依据中国药物临床试验质量管理规范及ICH GCP指导原则，对研究中心实施监查与稽查。监查员或其代表定期拜访各研究中心进行现场监查，评价方案依从性、受试者安全与隐私保护、病例报告表数据录入的完整性与准确性、病例报告表数据与原始文件的核对以及不良事件的发生与报告情况。研究者须向监查员提供访问所有原始资料和研究文件的权限。申办者或其代表有权对研究中心进行稽查，稽查范围包括但不限于研究药物供应管理、必备文件是否齐全、知情同意过程的合规性、电子病例报告表与原始文件的比对。研究者同意并配合在合理时间、以合理方式开展的稽查活动。独立数据监查委员会依据其章程对研究进行定期安全性与有效性审阅，其职能、组成及沟通机制在独立数据监查委员会章程中另行规定。各研究中心应接受国家药品监督管理部门及其委托机构依法开展的核查与检查，研究者有义务配合并提供所需文件与记录。","rationale":"已确认事实：多中心III期设计、DMC计划设立、中国开发区域。稽查与监查条款参照公司语料中监管共性结构（GCP监查与稽查权利），未迁移其他项目具体实施细节。DMC章程是否另行制定及本章节引用方式需医学经理确认。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_ff879ed4c2cd1efb","section_number":"12.3","source_ids":["protocol_full_draft_selection:5710c33c9dcff6cc2f7d7f44","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","company_corpus:cms_cn_protocol_corpus_20260715_v1:c93339b665f89a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67"]},{"ai_run_id":"airun_20261005001102_d7e4f341","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"补充项目级方案偏离管理SOP或申办者质量管理体系文件","category":"source_missing","gap_id":"gap_deviation_01","missing_source_classes":["项目级方案偏离管理SOP","申办者质量管理系统文件"],"target":"方案偏离分类标准及报告时限"},{"action":"补充伦理委员会偏离报告流程及研究中心SOP","category":"source_missing","gap_id":"gap_deviation_02","missing_source_classes":["伦理委员会偏离报告流程","研究中心SOP"],"target":"伦理委员会通知流程及纠正预防措施要求"}],"heading":"方案偏离","missing_source_classes":["项目级方案偏离管理SOP","伦理委员会偏离报告流程","申办者质量管理系统偏离分类标准"],"proposal_text":"","rationale":"方案偏离章节需要项目级来源明确偏离分类标准（重大偏离与一般偏离）、报告时限、伦理委员会通知流程、纠正与预防措施要求及偏离对数据分析的影响。当前允许来源中无对应项目文件，公司语料亦未提供可迁移的偏离管理条款。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_2e767ca9009895ab","section_number":"12.4","source_ids":["protocol_full_draft_selection:5710c33c9dcff6cc2f7d7f44","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","company_corpus:cms_cn_protocol_corpus_20260715_v1:c93339b665f89a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67"]},{"ai_run_id":"airun_20261005001102_d7e4f341","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"随机、双盲、安慰剂对照、平行分组、多中心III期设计","quote_sha256":"08797acd53fefc42a0066be9565f4700830f8281528c2c4868807cbebf70d95a","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_design"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"DMC是否计划：是","quote_sha256":"9967a9a75297ced2326ab733fa3b16934acdef641fa765dd50c1cd58219f4aa5","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_dmc"},{"locator":"section:文档开头|block:4|chunk:1","quote":"本方案中所包含的所有信息归申办方所有，因此，仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构进行审阅。","quote_sha256":"a95f171292054da4c0e730a5808f9cf1db173b3e9368862f63a2a3c3172a88c6","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","span_id":"es_confidentiality"},{"locator":"section:统计分析单位签字页|block:56|chunk:1","quote":"努力并严格按照方案、现行的ICH GCP和NMPA GCP指导原则以及适用的法规和指导方针进行本试验的临床监查、数据管理和统计分析工作，认真履行第三方职责","quote_sha256":"b3e8bed69acbb36cf5f1bc801490adb41fe30158fe8be82197d12a8e796744f1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","span_id":"es_third_party_duty"}],"evidence_review_advisories":[],"evidence_span_ids":["es_design","es_dmc","es_confidentiality","es_third_party_duty"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":2},"gap_items":[{"action":"补充研究管理计划或项目组织架构图","category":"source_missing","gap_id":"gap_roles_01","missing_source_classes":["研究管理计划","项目组织架构图"],"target":"申办者、CRO、研究中心、DMC各自具体职责及汇报关系"},{"action":"确认DMC章程是否另行制定","category":"source_missing","gap_id":"gap_roles_02","missing_source_classes":["独立数据监查委员会章程"],"target":"独立数据监查委员会章程及本章节引用方式"}],"heading":"关键角色和研究管理","missing_source_classes":["研究管理计划","各参与方职责分工文件","独立数据监查委员会章程"],"proposal_text":"本研究为多中心、随机、双盲、安慰剂对照、平行分组III期设计，开发区域为中国，计划设立独立数据监查委员会。研究由申办者发起并负责整体管理，委托合同研究组织承担临床监查、数据管理和统计分析等第三方职能，相关方须严格按照方案、现行ICH GCP和NMPA GCP指导原则及适用法规履行职责，保证受试者权益受到保障，确保研究记录与报告的数据真实、准确、完整。各研究中心由主要研究者负责本中心研究的实施与受试者安全管理，研究者须向监查员提供访问所有原始资料和研究文件的权限。独立数据监查委员会依据其章程对研究进行定期安全性与有效性审阅。本方案中所包含的所有信息归申办方所有，仅提供给研究者、合作研究者、伦理委员会和监督管理部门等相关机构进行审阅，未经申办方书面批准不得向与本研究无关的第三方披露。各参与方的具体职责分工、汇报关系及研究管理架构在研究管理计划中另行规定。","rationale":"已确认事实：多中心III期设计、DMC计划设立、中国开发区域。第三方职责及保密条款参照公司语料中监管共性结构。各参与方具体职责分工、汇报关系及研究管理架构缺少项目级来源，仅描述框架性要求。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_6a7b2f1234c0d4c4","section_number":"12.5","source_ids":["protocol_full_draft_selection:5710c33c9dcff6cc2f7d7f44","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","company_corpus:cms_cn_protocol_corpus_20260715_v1:d4bef81ce83416","company_corpus:cms_cn_protocol_corpus_20260715_v1:c93339b665f89a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67"]},{"ai_run_id":"airun_20261005001102_d7e4f341","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"补充项目级研究中心关闭SOP","category":"source_missing","gap_id":"gap_closure_01","missing_source_classes":["项目级研究中心关闭SOP"],"target":"研究中心关闭触发条件及关闭前程序"},{"action":"补充文件保存与归档政策及数据库锁定流程","category":"source_missing","gap_id":"gap_closure_02","missing_source_classes":["文件保存与归档政策","数据库锁定流程","试验用药品回收与销毁规程"],"target":"文件保存期限、数据库锁定及药物回收流程"}],"heading":"研究和研究中心的关闭","missing_source_classes":["项目级研究中心关闭SOP","文件保存与归档政策","数据库锁定流程","试验用药品回收与销毁规程"],"proposal_text":"","rationale":"研究中心关闭章节需要项目级来源明确关闭触发条件（如入组完成、安全性事件、监管要求）、关闭前程序（数据库锁定、药物回收、文件归档）、文件保存期限、受试者后续随访安排及关闭通知流程。当前允许来源中无对应项目文件，公司语料亦未提供可迁移的关闭管理条款。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_ddb3fcbff644c102","section_number":"12.6","source_ids":["protocol_full_draft_selection:5710