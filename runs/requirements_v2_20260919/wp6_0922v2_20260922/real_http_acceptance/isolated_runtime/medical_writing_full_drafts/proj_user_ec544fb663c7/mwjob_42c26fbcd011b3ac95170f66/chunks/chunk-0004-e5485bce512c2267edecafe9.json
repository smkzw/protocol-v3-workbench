orpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"由统计团队依据样本量估算和主要终点分析需求确定随机化比例及分层因素后写入","category":"source_missing","gap_id":"gap_rand_01","missing_source_classes":["统计分析计划","随机化方法学文件"],"target":"随机化比例与分层因素"},{"action":"确认采用区组随机或动态随机，明确IWRS/IRT系统或中心药房分配方式","category":"source_missing","gap_id":"gap_rand_02","missing_source_classes":["随机化方法学文件","IWRS/IRT系统说明"],"target":"随机化实施方法与系统"}],"heading":"随机化","missing_source_classes":["随机化方法学文件","统计分析计划"],"proposal_text":"本研究采用随机、平行分组、多中心设计。受试者在基线访视完成筛选评估后，通过随机化程序分配至KZ-6210组或安慰剂组。KZ-6210组接受背景免疫抑制联合KZ-6210 162 mg皮下注射每4周一次，安慰剂组接受背景免疫抑制联合匹配安慰剂皮下注射每4周一次。两组均维持标准背景免疫抑制方案，按临床需要调整背景用药并完整记录。随机化在基线访视时完成，分配在各参与中心间实施。","rationale":"随机、平行分组、多中心及两组干预方案来源于当前项目已确认研究事实。随机化比例、分层因素、具体随机化方法及实施主体在允许来源中未给出，需医学经理与统计团队确认后补入。","review_advisories":["本节复述高影响研究设计（随机化）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_eff7e4cb3cf8c8f9","section_number":"4.3","source_ids":["protocol_full_draft_selection:e5485bce512c2267edecafe9","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266"]},{"ai_run_id":"airun_20261004231823_2c062eb0","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"总体研究设计：随机、双盲、安慰剂对照、平行分组、多中心III期设计","quote_sha256":"4d1bfbf57db63c22474808111e7c7f451396868b5fa32181c0286ed30850383d","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_03"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"对照组给予匹配安慰剂（给药途径、频次及外观与试验组保持盲态一致），两组均维持标准背景免疫抑制","quote_sha256":"895259fc0319c175480c6e95bba3006a841efbc550bada51832f98a62c041e1f","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_04"}],"evidence_review_advisories":[],"evidence_span_ids":["es_03","es_04"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"明确受试者、研究者、评价者、DMC成员及统计师的盲态范围","category":"source_missing","gap_id":"gap_blind_01","missing_source_classes":["盲态管理SOP","DMC章程"],"target":"盲态维持人员范围"},{"action":"制定紧急揭盲触发条件、操作流程、记录要求及揭盲后数据处理规则","category":"source_missing","gap_id":"gap_blind_02","missing_source_classes":["揭盲程序文件","安全性管理SOP"],"target":"紧急揭盲与计划性揭盲程序"}],"heading":"盲法与揭盲","missing_source_classes":["揭盲程序文件","盲态管理SOP"],"proposal_text":"本研究采用双盲设计。对照组给予匹配安慰剂，其给药途径、注射频次及外观与试验组保持盲态一致，以维持受试者和研究中心人员的盲态。两组均维持标准背景免疫抑制方案。盲态维持贯穿双盲主治疗期12个月及安全随访12个月。","rationale":"双盲设计及匹配安慰剂（给药途径、频次、外观一致）来源于当前项目已确认研究事实。盲态维持的具体人员范围、紧急揭盲程序及揭盲后数据处理规则在允许来源中未给出，需医学经理与安全性团队确认后补入。","review_advisories":["本节复述高影响研究设计（盲法与揭盲）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_79915848410489c1","section_number":"4.4","source_ids":["protocol_full_draft_selection:e5485bce512c2267edecafe9","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266"]},{"ai_run_id":"airun_20261004231823_2c062eb0","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"DMC是否计划：是","quote_sha256":"9967a9a75297ced2326ab733fa3b16934acdef641fa765dd50c1cd58219f4aa5","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_05"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"期中分析是否计划：否","quote_sha256":"31ef70e7f5cd03d6c17b90802e7352c6e81b5fdc853989b74ea1499901f514a4","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_06"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"安全性终点：描述感染及其他重要风险；严重及机会性感染；BK病毒再激活；胃肠道穿孔风险信号；肝酶升高；血脂异常；中性粒细胞减少；注射部位反应","quote_sha256":"d670accdc119b83acd6ad30622848231143ff6b0cc4254ae90ac2b46954d47d5","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_09"}],"evidence_review_advisories":[],"evidence_span_ids":["es_05","es_06","es_09"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"制定DMC章程，明确组成、审查频率、审查内容、沟通路径及独立统计中心安排","category":"source_missing","gap_id":"gap_dmc_01","missing_source_classes":["DMC章程","独立统计中心安排文件"],"target":"DMC章程与审查安排"},{"action":"明确安全性信号触发DMC审查的条件、紧急会议召集程序及向监管机构的报告路径","category":"source_missing","gap_id":"gap_dmc_02","missing_source_classes":["安全性管理SOP","DMC章程"],"target":"DMC审查触发条件与报告路径"}],"heading":"安全性审评/数据监查委员会","missing_source_classes":["DMC章程","独立统计中心安排文件","安全性审查SOP"],"proposal_text":"本研究设置独立数据监查委员会（DMC），对研究期间受试者安全性数据进行定期审查。本研究不计划期中有效性分析，DMC的审查以安全性监测为主要职能，关注范围涵盖感染及其他重要风险、严重及机会性感染、BK病毒再激活、胃肠道穿孔风险信号、肝酶升高、血脂异常、中性粒细胞减少及注射部位反应等安全性终点。","rationale":"DMC设置及不计划期中分析来源于当前项目已确认研究事实；安全性终点关注范围来源于同一来源的安全性终点描述。DMC章程、审查频率、审查内容、沟通路径及独立统计中心安排在允许来源中未给出，需医学经理与DMC筹备团队确认后补入。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_8e9e7827a7c02a85","section_number":"4.5","source_ids":["protocol_full_draft_selection:e5485bce512c2267edecafe9","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266"]},{"ai_run_id":"airun_20261004231823_2c062eb0","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"研究时期：双盲主治疗期12个月；安全随访12个月","quote_sha256":"abde817822f8ff518ff59c0488831533ffdcdf5956a4b389cbc557cdb39d2b80","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_07"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"筛选期完成入排、感染筛查与知情同意；基线随机化，治疗期每4周给药及安全评估，第12个月协议活检、DSA和肾功能评价；结束治疗后继续12个月安全随访。每次记录血常规、肝肾功能、感染及合并用药，定期血脂与BK病毒检测。","quote_sha256":"e9ef60b570ff4b67cad14172b5c88fb476adeb154662e178b6b795b53ce7ceb5","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_08"}],"evidence_review_advisories":[],"evidence_span_ids":["es_07","es_08"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"明确研究提前终止的触发条件、决策主体、通知程序及已入组受试者的后续处理","category":"source_missing","gap_id":"gap_dur_01","missing_source_classes":["研究终止条件文件","安全性管理SOP"],"target":"研究提前终止条件与程序"},{"action":"确认研究结束以最后一例受试者完成随访为标志，明确筛选期时长及总研究周期上限","category":"source_missing","gap_id":"gap_dur_02","missing_source_classes":["访视操作手册","项目管理计划"],"target":"研究结束判定与总周期"}],"heading":"研究结束与研究持续时间","missing_source_classes":["研究终止条件文件","访视操作手册"],"proposal_text":"本研究的研究时期由双盲主治疗期和安全随访期组成。双盲主治疗期为12个月，治疗期每4周给药一次并进行安全性评估，第12个月进行协议活检、DSA及肾功能评价。结束双盲主治疗期后，受试者进入12个月安全随访期。筛选期完成入排标准评估、感染筛查与知情同意；基线访视完成随机化。治疗期及随访期每次访视记录血常规、肝肾功能、感染事件及合并用药，定期进行血脂与BK病毒检测。","rationale":"双盲主治疗期12个月、安全随访12个月、每4周给药及安全评估、第12个月协议活检与DSA评价、随访期检查项目来源于当前项目已确认研究事实。研究提前终止条件、研究结束具体判定标准及总研究周期上限在允许来源中未明确，需医学经理确认后补入。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_b84f3bcdc640cbc5","section_number":"4.6","source_ids":["protocol_full_draft_selection:e5485bce512c2267edecafe9","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266"]}],"source_bindings":[{"content_sha256":"bdbefbf71a9a9fb557de50d3d0354d563147caf0bd4dce85902462740dbaf799","locator":"document:mwdoc_greenfield_proj_user_ec544fb663c7_3754772d209fc17b:full-draft:e5485bce512c2267edecafe9","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:e5485bce512c2267edecafe9","source_type":"protocol_full_draft_selection","source_version":"full-draft:65721db521c9622e4b49eecc2f74d1a8ce14c48d593688962b7312b74b6fd9d2:e5485bce512c2267edecafe9","text_sha256":"bdbefbf71a9a9fb557de50d3d0354d563147caf0bd4dce85902462740dbaf799"},{"content_sha256":"39d5e2592d7b4f9c44083a7979cbd4731c2223ad66c721c81ae6e6ef1cbd4be6","locator":"study_definit