_20260715_v1:342cfc57d67b67","source_type":"company_protocol_reference_corpus","source_version":"342cfc57d67b67","text_sha256":"dfc9fceb41db9d941df0e3715483adaa069da4f1953600a6a37a56d7f81373dd"}]}