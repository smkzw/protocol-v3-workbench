number":"2.3.2","source_ids":["protocol_full_draft_selection:18d9208cdfeaef91e078ca58","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:367cbc36976ba5","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","company_corpus:cms_cn_protocol_corpus_20260715_v1:b77374359659b7","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67"]},{"ai_run_id":"airun_20261004223905_e843ac35","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"靶点/作用机制：阻断IL-6通路、抑制B细胞活化，降低供体特异性抗体介导的慢性移植物损伤","quote_sha256":"fadcdbc29ad767fbdf26ab1a568826a68e7b56527ab5c97d9384d12b2cbd1e15","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_002"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"内在研究目的：确证性研究","quote_sha256":"9910bf06ee75c8853c143b11ec7df385f95306b1d5f76e729515dd9609db0a9c","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_003"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"目标研究人群：肾移植受者，移植后3–12个月，存在DSA或高免疫学风险，聚焦慢性活动性排斥的预防，不将已经确诊且需抢救治疗的排斥作为目标人群","quote_sha256":"5864a2991bfd209de7542ccb6fd829fe10663f444b8337f398cad0f01031dcd9","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_009"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"研究时期：双盲主治疗期12个月；安全随访12个月","quote_sha256":"abde817822f8ff518ff59c0488831533ffdcdf5956a4b389cbc557cdb39d2b80","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_010"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"适应症：慢性移植肾排斥反应的预防","quote_sha256":"1e3198e43b6a093e91926d4c8e44a7dc3e0fd1eaa718b7301b73bb8b00b23691","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_012"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"试验药物：KZ-6210","quote_sha256":"b1f4356ea3e7c8fd33294e9328ff7bbe34304b4d046c1bc0615bbac8d8ea658d","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_013"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"研究分期：III期","quote_sha256":"5ac919b18530a35e6df200dbf04b4bc9fbd8d00da2c279aa58a1ff849584b451","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_014"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"总体研究设计：随机、双盲、安慰剂对照、平行分组、多中心III期设计","quote_sha256":"4d1bfbf57db63c22474808111e7c7f451396868b5fa32181c0286ed30850383d","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_015"}],"evidence_review_advisories":[],"evidence_span_ids":["es_002","es_003","es_009","es_010","es_012","es_013","es_014","es_015"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":8},"gap_items":[{"action":"补充慢性移植肾排斥反应的流行病学数据、当前标准治疗方案的局限性证据及指南推荐","category":"source_missing","gap_id":"gap_24_01","missing_source_classes":["流行病学文献","临床指南","治疗现状综述"],"target":"2.4节第一段疾病背景及未满足需求描述"},{"action":"补充IL-6通路在移植后B细胞活化及DSA产生中的非临床或转化医学证据","category":"source_missing","gap_id":"gap_24_02","missing_source_classes":["非临床研究报告","转化医学文献","同类药物机制综述"],"target":"2.4节第二段作用机制的深入阐述"}],"heading":"本研究的理论基础","missing_source_classes":["慢性移植肾排斥反应流行病学及疾病负担数据","当前标准免疫抑制方案在慢性排斥预防中的局限性证据","IL-6通路在移植排斥中作用的非临床或转化医学研究","同类IL-6R抑制剂在移植领域的已发表文献"],"proposal_text":"慢性移植肾排斥反应是肾移植长期存活的主要威胁之一，其中供体特异性抗体（DSA）介导的慢性活动性排斥在移植后数月至数年内逐步发展，导致移植物功能进行性下降乃至丧失。当前标准背景免疫抑制方案虽可抑制急性排斥，但对已建立的DSA产生及慢性移植物损伤的预防效果有限，存在明确的未满足治疗需求。\n\nKZ-6210为靶向IL-6受体的单克隆抗体，其作用机制为阻断IL-6信号通路、抑制B细胞活化，从而降低供体特异性抗体介导的慢性移植物损伤。IL-6在移植后B细胞分化为抗体分泌细胞及浆母细胞的过程中发挥关键促炎作用，阻断该通路有望从上游减少DSA的产生与持续，进而减轻抗体介导的慢性移植物损伤。\n\n本研究为确证性III期试验，采用随机、双盲、安慰剂对照、平行分组、多中心设计，在标准背景免疫抑制之上比较KZ-6210与匹配安慰剂对慢性活动性排斥的预防效果。目标人群为移植后3至12个月、存在DSA或高免疫学风险的肾移植受者，聚焦慢性活动性排斥的预防，不将已经确诊且需抢救治疗的排斥作为目标人群。该人群选择基于以下考量：移植后早期为DSA产生及慢性损伤启动的关键窗口，在此阶段干预有望阻断排斥级联反应的进展；排除已确诊需抢救治疗的排斥，旨在评估预防性干预而非治疗性干预的效果。\n\n双盲主治疗期设定为12个月，以覆盖慢性活动性排斥从亚临床损伤向组织学可检出病变发展的典型时间窗；治疗期结束后继续12个月安全随访，以监测感染、BK病毒再激活、胃肠道穿孔等长期安全性信号。","rationale":"作用机制描述（阻断IL-6通路、抑制B细胞活化、降低DSA介导的慢性移植物损伤）及研究类型（确证性III期）直接来源于当前项目已确认研究事实。目标人群定义、研究时期（12个月治疗+12个月随访）及设计要素（随机、双盲、安慰剂对照、多中心）亦来自同一来源。疾病背景中关于慢性移植肾排斥流行病学、当前标准治疗局限性的表述为基于项目事实的合理推断，缺少独立流行病学或指南来源支撑，需医学经理核实或补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_31cf90b20c9d979a","section_number":"2.4","source_ids":["protocol_full_draft_selection:18d9208cdfeaef91e078ca58","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:367cbc36976ba5","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","company_corpus:cms_cn_protocol_corpus_20260715_v1:b77374359659b7","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67"]},{"ai_run_id":"airun_20261004223905_e843ac35","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"主要研究目的：比较KZ-6210与安慰剂在标准背景免疫抑制之上，预防第12个月协议活检证实的慢性活动性排斥的效果","quote_sha256":"5d543541e28e71deca05c4d82dd826158e1672858ebe3346f8c093b5059cb435","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_004"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"主要终点：第12个月协议活检证实的慢性活动性排斥发生率，按Banff标准定义复合终点并在完整方案中锁定组成项与判定流程","quote_sha256":"69e8a5141f8c112ee821dc7ead6f7782f65afd738a8080d6b888ff05e537125d","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_005"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"次要研究目的：评估DSA变化、肾功能趋势和移植物存活","quote_sha256":"21c2f5ec7e71b4f3222bbec00c3aab3d0e322438d4dc1ab348ca2892739cd6ef","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_006"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"其他次要终点：DSA平均荧光强度（MFI）相对基线变化；eGFR斜率；移植物存活；24小时尿蛋白；BK病毒再激活；血脂；注射部位反应","quote_sha256":"e75704e825e2071db0ed7f72dc96ea171ed2d96d534346d17cc0d668080cbad1","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_007"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"安全性终点：描述感染及其他重要风险；严重及机会性感染；BK病毒再激活；胃肠道穿孔风险信号；肝酶升高；血脂异常；中性粒细胞减少；注射部位反应","quote_sha256":"d670accdc119b83acd6ad30622848231143ff6b0cc4254ae90ac2b46954d47d5","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_008"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"研究时期：双盲主治疗期12个月；安全随访12个月","quote_sha256":"abde817822f8ff518ff59c0488831533ffdcdf5956a4b389cbc557cdb39d2b80","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_010"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"研究分期：III期","quote_sha256":"5ac919b18530a35e6df200dbf04b4bc9fbd8d00da2c279aa58a1ff849584b451","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_014"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"总体研究设计：随机、双盲、安慰剂对照、平行分组、多中心III期设计","quote_sha256":"4d1bfbf57db63c22474808111e7c7f451396868b5fa32181c0286ed30850383d","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_015"}],"evidence_review_advisories":[],"evidence_span_ids":["es_004","es_005","es_006","es_007","es_008","es_010","es_014","es_015"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":8},"gap_items":[],"heading":"研究目的和终点","missing_source_classes":[],"proposal_text":"本研究的主要研究目的为比较KZ-6210与安慰剂在标准背景免疫抑制之上，预防第12个月协议活检证实的慢性活动性排斥的效果。主要终点为第12个月协议活检证实的慢性活动性排斥发生率，按Banff标准定义复合终点，具体组成项与判定流程在完整方案中锁定。\n\n次要研究目的为评估DSA变化、肾功能趋势和移植物存活。次要终点包括：DSA平均荧光强度（MFI）相对基线变化；eGFR斜率；移植物存活；24小时尿蛋白；BK病毒再激活；血脂；注射部位反应。\n\n安全性终点旨在描述感染及其他重要风险，具体关注严重及机会性感染、BK病毒再激活、胃肠道穿孔风险信号、肝酶升高、血脂异常、中性粒细胞减少及注射部位反应。\n\n本研究为确证性III期试验，采用随机、双盲、安慰剂对照、平行分组、多中心设计。双盲主治疗期12个月，治疗期结束后继续12个月安全随访。主要分析集为修正意向治疗集（mITT），主要比较采用双侧α=0.05，目标把握度80%。","rationale":"主要研究目的、主要终点（含Banff标准框架）、次要研究目的、全部次要终点及安全性终点均直接来源于当前项目已确认研究事实。研究设计要素（随机、双盲、安慰剂对照、多中心、III期）、研究时期（12+12个月）及统计分析框架（mITT、双侧α=0.05、80%把握度）亦来自同一来源。Banff复合终点的具体组成项与判定流程、eGFR斜率计算窗口、BK病毒再激活阈值等操作定义需在完整方案中进一步锁定。","review_advisories":["本节复述高影响研究设计（研究目的和终点）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（α、主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_9698d5d27c615d27","section_number":"3","source_ids":["protocol_full_draft_selection:18d9208cdfeaef91e078ca58","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:367cbc36976ba5","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","company_corpus:cms_cn_protocol_corpus_20260715_v1:b77374359659b7","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67"]},{"ai_run_id":"airun_20261004223905_e843ac35","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"次要研究目的：评估DSA变化、肾功能趋势和移植物存活","quote_sha256":"21c2f5ec7e71b4f3222bbec00c3aab3d0e322438d4dc1ab348ca2892739cd6ef","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_006"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"其他次要终点：DSA平均荧光强度（MFI）相对基线变化；eGFR斜率；移植物存活；24小时尿蛋白；BK病毒再激活；血脂；注射部位反应","quote_sha256":"e75704e825e2071db0ed7f72dc96ea171ed2d96d534346d17cc0d668080cbad1","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_007"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"研究时期：双盲主治疗期12个月；安全随访12个月","quote_sha256":"abde817822f8ff518ff59c0488831533ffdcdf5956a4b389cbc557cdb39d2b80","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_010"},{"locator":"document:mwdoc_greenfield_proj_user_ec544fb663c7_3754772d209fc17b:full-draft:18d9208cdfeaef91e078ca58","quote":"评估DSA变化、肾功能趋势和移植物存活\nDSA平均荧光强度（MFI）相对基线变化；eGFR斜率；移植物存活；24小时尿蛋白；BK病毒再激活；血脂；注射部位反应","quote_sha256":"f4a530887ae5eaa0d2efa08d986f0f447321d5a6140b41fb1f4f8bd9aefaf3c0","source_id":"protocol_full_draft_selection:18d9208cdfeaef91e078ca58","span_id":"es_011"}],"evidence_review_advisories":[],"evidence_span_ids":["es_006","es_007","es_010","es_011"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"补充eGFR斜率计算窗口、BK病毒再激活判定阈值、注射部位反应分级标准及各终点的具体采集访视时间点","category":"source_missing","gap_id":"gap_32_01","missing_source_classes":["统计分析计划","安全性评估标准","访视操作手册"],"target":"3.2节各次要终点的操作定义与采集频率"}],"heading":"次要目的和次要终点","missing_source_classes":["统计分析计划","安全性评估标准","访视操作手册"],"proposal_text":"本研究的次要研究目的为评估DSA变化、肾功能趋势和移植物存活。\n\n次要终点具体包括以下各项：DSA平均荧光强度（MFI）相对基线变化，用于反映供体特异性抗体水平的动态变化；eGFR斜率，用于评估肾功能随时间的变化趋势；移植物存活，作为整体移植物功能维持的终点；24小时尿蛋白，作为肾小球损伤的辅助指标；BK病毒再激活，作为免疫抑制相关感染风险的监测指标；血脂，作为代谢安全性指标；注射部位反应，作为局部耐受性指标。\n\n上述次要终点在双盲主治疗期12个月及安全随访12个月期间进行采集与评估。DSA平均荧光强度相对基线变化以基线值为参照计算变化量；eGFR斜率基于系列eGFR测量值拟合计算；移植物存活以移植物功能丧失或受试者死亡为事件终点；24小时尿蛋白、BK病毒再激活、血脂及注射部位反应按预设访视时间点采集，具体采集频率与判定标准在完整方案中明确。","rationale":"次要研究目的（评估DSA变化、肾功能趋势和移植物存活）及全部次要终点名称（DSA MFI相对基线变化、eGFR斜率、移植物存活、24小时尿蛋白、BK病毒再激活、血脂、注射部位反应）直接来源于当前项目已确认研究事实及章节包中已确认的当前正文。研究时期（12个月治疗+12个月随访）来自同一来源。各终点的操作定义（如eGFR斜率计算窗口、BK病毒再激活阈值、注射部位反应分级）及具体采集频率未在允许来源中给出，需医学经理在完整方案中补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_a973ddeec2282b44","section_number":"3.2","source_ids":["protocol_full_draft_selection:18d9208cdfeaef91e078ca58","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","company_corpus:cms_cn_protocol_corpus_20260715_v1:fb714bc3c01de1","company_corpus:cms_cn_protocol_corpus_20260715_v1:367cbc36976ba5","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","company_corpus:cms_cn_protocol_corpus_20260715_v1:b77374359659b7","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67"]}],"source_bindings":[{"content_sha256":"29633891d7c70d3709a084ec32126905fec7ddbac91583495dd1502e7539664a","locator":"document:mwdoc_greenfield_proj_user_ec544fb663c7_3754772d209fc17b:full-draft:18d9208cdfeaef91e078ca58","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:18d9208cdfeaef91e078ca58","source_type":"protocol_full_draft_selection","source_version":"full-draft:65721db521c9622e4b49eecc2f74d1a8ce14c48d593688962b7312b74b6fd9d2:18d9208cdfeaef91e078ca58","text_sha256":"29633891d7c70d3709a084ec32126905fec7ddbac91583495dd1502e7539664a"},{"content_sha256":"39d5e2592d7b4f9c44083a7979cbd4731c2223ad66c721c81ae6e6ef1cbd4be6","locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","source_type":"current_project_study_definition","source_version":"mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","