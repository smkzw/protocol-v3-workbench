7","source_ids":["protocol_full_draft_selection:52f9a5aeeb02c0a9ebb34dc8","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","company_corpus:cms_cn_protocol_corpus_20260715_v1:8ef346dbad9216","company_corpus:cms_cn_protocol_corpus_20260715_v1:254debb4f1732c","company_corpus:cms_cn_protocol_corpus_20260715_v1:53ffcb794b6e30","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8","company_corpus:cms_cn_protocol_corpus_20260715_v1:8d28b2ee22d99d"]},{"ai_run_id":"airun_20261004232240_7e7c901f","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"目标研究人群：肾移植受者，移植后3–12个月，存在DSA或高免疫学风险，聚焦慢性活动性排斥的预防，不将已经确诊且需抢救治疗的排斥作为目标人群","quote_sha256":"5864a2991bfd209de7542ccb6fd829fe10663f444b8337f398cad0f01031dcd9","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_population_def"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"研究人群概述：18–70岁肾移植受者，移植后3–12个月，eGFR≥30 mL/min/1.73m²，背景免疫抑制稳定，存在DSA或高免疫学风险，并自愿签署知情同意。排除活动性严重感染、未控制的结核或病毒感染、近期需强化治疗的排斥、显著肝功能异常、严重中性粒细胞减少、已知胃肠道穿孔高风险、妊娠或哺乳以及无法完成随访者。","quote_sha256":"dc7848df40003bf23f7a9b18b4ecab8c0a40dc264767303d7722c28e81026b43","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_pop_full"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"总体研究设计：随机、双盲、安慰剂对照、平行分组、多中心III期设计","quote_sha256":"4d1bfbf57db63c22474808111e7c7f451396868b5fa32181c0286ed30850383d","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_study_design"}],"evidence_review_advisories":[],"evidence_span_ids":["es_population_def","es_pop_full","es_study_design"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"确认高免疫学风险是否需给出DSA MFI阈值、既往排斥次数或其他可操作判定标准","category":"source_missing","gap_id":"gap_5_high_immune_risk_def","missing_source_classes":["项目级入排标准操作定义文件"],"target":"5节正文中'高免疫学风险'的操作性定义"},{"action":"确认背景免疫抑制稳定的判定标准，包括稳定时长、允许药物种类及剂量范围","category":"source_missing","gap_id":"gap_5_stable_immune_def","missing_source_classes":["项目级入排标准操作定义文件"],"target":"5节正文中'背景免疫抑制稳定'的操作性定义"}],"heading":"研究人群","missing_source_classes":[],"proposal_text":"本研究的目标人群为接受肾移植术后3至12个月、存在供体特异性抗体或高免疫学风险的成年受试者，研究聚焦于慢性活动性排斥反应的预防，不将已经确诊且需抢救治疗的排斥作为目标人群。计划入组18至70岁肾移植受者，要求移植后肾功能估算肾小球滤过率不低于30 mL/min/1.73m²，背景免疫抑制方案稳定，存在供体特异性抗体或经研究者判定为高免疫学风险，并自愿签署知情同意书。研究采用随机、双盲、安慰剂对照、平行分组、多中心III期设计，在标准背景免疫抑制之上比较KZ-6210与匹配安慰剂皮下注射每4周一次对第12个月协议活检证实的慢性活动性排斥的预防效果。双盲主治疗期持续12个月，治疗结束后继续12个月安全随访。","rationale":"目标人群定义、年龄范围、移植后时间窗、eGFR阈值、DSA或高免疫学风险条件、研究聚焦方向及双盲治疗期与安全随访时长均由当前项目已确认研究事实直接给出。'高免疫学风险'的操作性定义及'背景免疫抑制稳定'的具体判定标准尚未在来源中明确，需医学经理确认后方可在正式文本中补充。","review_advisories":["本节复述高影响研究设计（研究人群）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（计划入组）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_f6f7a7616d63cc7b","section_number":"5","source_ids":["protocol_full_draft_selection:52f9a5aeeb02c0a9ebb34dc8","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","company_corpus:cms_cn_protocol_corpus_20260715_v1:8ef346dbad9216","company_corpus:cms_cn_protocol_corpus_20260715_v1:254debb4f1732c","company_corpus:cms_cn_protocol_corpus_20260715_v1:53ffcb794b6e30","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8","company_corpus:cms_cn_protocol_corpus_20260715_v1:8d28b2ee22d99d"]},{"ai_run_id":"airun_20261004232240_7e7c901f","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_ec544fb663c7_3754772d209fc17b:full-draft:52f9a5aeeb02c0a9ebb34dc8","quote":"双侧α=0.05，目标把握度80%；依据预计事件率、两组临床有意义差异及脱落比例估算样本量。目前事件率证据未确定，不填写虚构最终例数；完成外部依据审阅后锁定。","quote_sha256":"5d2c2a60533053d000c7560816888b217c36f4599f487a52fa266f1f5fd9af1d","source_id":"protocol_full_draft_selection:52f9a5aeeb02c0a9ebb34dc8","span_id":"es_51_text"}],"evidence_review_advisories":[],"evidence_span_ids":["es_51_text"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"完成预计事件率外部依据审阅后锁定最终样本量并写入正文","category":"source_not_retrieved","gap_id":"gap_51_final_n","missing_source_classes":["预计事件率外部依据审阅报告"],"target":"5.1节最终入组例数"}],"heading":"计划入组人数","missing_source_classes":[],"proposal_text":"本研究样本量依据双侧显著性水平α=0.05、目标统计把握度80%进行估算，估算参数包括预计事件率、两组间临床有意义差异及脱落比例。目前预计事件率证据尚未确定，最终入组例数不预先填写虚构数值；待完成外部依据审阅后锁定最终样本量。","rationale":"双侧α=0.05、目标把握度80%、估算依据（预计事件率、两组临床有意义差异、脱落比例）及'事件率证据未确定、不填写虚构最终例数、完成外部依据审阅后锁定'的表述均由当前项目已确认研究事实直接给出。最终样本量数值依赖预计事件率的外部依据审阅结果，当前无法写入具体例数。","review_advisories":["本节提及高影响设计信息（α、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_155a3df6b57f3535","section_number":"5.1","source_ids":["protocol_full_draft_selection:52f9a5aeeb02c0a9ebb34dc8","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","company_corpus:cms_cn_protocol_corpus_20260715_v1:8ef346dbad9216","company_corpus:cms_cn_protocol_corpus_20260715_v1:254debb4f1732c","company_corpus:cms_cn_protocol_corpus_20260715_v1:53ffcb794b6e30","company_corpus:cms_cn_protocol_corpus_20260715_v1:0eebb4939327b8","company_corpus:cms_cn_protocol_corpus_20260715_v1:8d28b2ee22d99d"]},{"ai_run_id":"airun_20261004232240_7e7c901f","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"入选标准模块：18–70岁肾移植受者；移植后3–12个月；eGFR≥30 mL/min/1.73m²；背景免疫抑制稳定；存在DSA或高免疫学风险；自愿签署知情同意","quote_sha256":"565bc997d56f635051572fde8fa7c6b7c4ebc605401794e4d330e31368392e63","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_inclusion_def"},{"locator":"document:mwdoc_greenfield_proj_user_ec544fb663c7_3754772d209fc17b:full-draft:52f9a5aeeb02