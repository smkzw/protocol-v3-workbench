gy"},{"locator":"section:8 统计学考虑|block:1056|chunk:1","quote":"有效性评价、安全性评价、PK 评价、PD 评价、免疫原性评价以及其他分析将在本研究的统计分析计划（SAP）中详细规定，数据库锁定前将最终确定 SAP。","quote_sha256":"a635fe9c51c78cbc66090c3553c488cd453e807e61608a97e0767740d5088a03","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","span_id":"es_sap_timing"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"DMC是否计划：是","quote_sha256":"9967a9a75297ced2326ab733fa3b16934acdef641fa765dd50c1cd58219f4aa5","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_dmc"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"双盲主治疗期12个月；安全随访12个月","quote_sha256":"04a82aa7b63e73a12eb368e0c6d1a9bd64a6c9af10e1cac8f52c03c3ebd95413","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_study_periods"}],"evidence_review_advisories":[],"evidence_span_ids":["es_safety_endpoints","es_stat_strategy","es_sap_timing","es_dmc","es_study_periods"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":4},"gap_items":[{"action":"由统计团队在SAP中预先定义安全性分析集纳入与排除标准","category":"source_missing","gap_id":"gap_safety_01","missing_source_classes":["统计分析计划草案"],"target":"安全性分析集精确定义及排除条件"},{"action":"由医学经理确认TEAE采集窗口（如末次给药后30天或至安全随访结束）","category":"source_missing","gap_id":"gap_safety_02","missing_source_classes":["安全性评估时间窗定义"],"target":"TEAE采集窗口起止时点"},{"action":"由医学经理与DMC主席在DMC章程中确定","category":"source_missing","gap_id":"gap_safety_03","missing_source_classes":["DMC章程"],"target":"DMC审查频率与触发标准"},{"action":"由药物安全团队确认编码版本","category":"source_missing","gap_id":"gap_safety_04","missing_source_classes":["药物安全编码规范"],"target":"MedDRA编码版本及安全性编码规范"}],"heading":"安全性数据分析","missing_source_classes":["安全性分析计划或SAP草案","DMC章程","MedDRA编码规范","TEAE采集窗口定义文件"],"proposal_text":"安全性数据分析以描述性统计为主，辅以组间比较。安全性分析集纳入至少接受一次研究药物或安慰剂给药的随机化受试者，按实际接受的治疗分组进行分析。安全性终点涵盖感染事件（含严重及机会性感染）、BK病毒再激活、胃肠道穿孔风险信号、肝酶升高、血脂异常、中性粒细胞减少及注射部位反应。上述终点按治疗期（12个月双盲主治疗期）和安全随访期（12个月）分别汇总，报告各组事件发生率、组间率差及95%置信区间。对于连续型安全性指标（如肝酶、血脂、中性粒细胞计数），报告基线至各访视的变化值及异常比例。安全性数据的统计检验方法、多重性调整策略及缺失数据处理方式在统计分析计划中详细规定，统计分析计划在数据库锁定前最终确定。本研究设立独立数据安全监查委员会，对累积安全性数据进行定期审查，审查频率及触发标准由数据安全监查委员会章程另行规定。安全性分析的具体变量定义、编码标准及分析集排除条件在统计分析计划中预先锁定。","rationale":"安全性终点清单、双盲治疗期12个月加安全随访12个月、mITT分析集、双侧α=0.05、报告发生率与组间差异及置信区间、SAP在数据库锁定前确定、DMC已计划设立，均来自当前项目已确认研究事实。安全性分析集的精确定义、TEAE采集窗口起止、安全性评估时间窗、DMC审查频率及触发标准、编码版本等实施细节缺少对应项目文件，需医学经理与统计团队确认。公司语料中SAP在数据库锁定前确定的表述为监管共性结构参照，用于本章节措辞，不构成本项目已确认实施规则。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_5621335b86cf901b","section_number":"9.5","source_ids":["protocol_full_draft_selection:ee0a7596701f8fc82ea18de4","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","company_corpus:cms_cn_protocol_corpus_20260715_v1:df51ff33eb77d6","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5acd10ce8e436","company_corpus:cms_cn_protocol_corpus_20260715_v1:df064f51d3d147","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc2af7591dc952"]},{"ai_run_id":"airun_20261004235442_2a3b95e0","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"每次记录血常规、肝肾功能、感染及合并用药，定期血脂与BK病毒检测。","quote_sha256":"e2a2f4ef6e0b95c23c24ad0eb231b7bc32d9c67b520f44cbd0852cee0586cfb6","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_visit_strategy"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"双盲主治疗期12个月；安全随访12个月","quote_sha256":"04a82aa7b63e73a12eb368e0c6d1a9bd64a6c9af10e1cac8f52c03c3ebd95413","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_study_periods"},{"locator":"section:7.3.7 严重不良事件一致性比对|block:1049|chunk:1","quote":"EDC 中 SAE 关键数据点应与安全性数据库进行一致性比对。","quote_sha256":"89137f59a7a4b6b574df06af2472181735de0125de055f6939636b33ffcf7e2c","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:df51ff33eb77d6","span_id":"es_edc_sae"},{"locator":"section:8 统计学考虑|block:1056|chunk:1","quote":"有效性评价、安全性评价、PK 评价、PD 评价、免疫原性评价以及其他分析将在本研究的统计分析计划（SAP）中详细规定，数据库锁定前将最终确定 SAP。","quote_sha256":"a635fe9c51c78cbc66090c3553c488cd453e807e61608a97e0767740d5088a03","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","span_id":"es_sap_timing"}],"evidence_review_advisories":[],"evidence_span_ids":["es_visit_strategy","es_study_periods","es_edc_sae","es_sap_timing"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":2},"gap_items":[{"action":"由数据管理部门确认本项目使用的EDC系统及版本","category":"source_missing","gap_id":"gap_data_01","missing_source_classes":["EDC系统规格说明"],"target":"EDC系统名称及版本"},{"action":"由数据管理部门制定数据管理计划，明确逻辑核查规则、质疑管理流程及数据锁定标准","category":"source_missing","gap_id":"gap_data_02","missing_source_classes":["数据管理计划（含数据核查规则）"],"target":"数据管理计划及数据核查规则"},{"action":"由数据管理部门与医学团队共同确定源数据核查范围","category":"source_missing","gap_id":"gap_data_03","missing_source_classes":["源数据验证策略"],"target":"源数据核查范围与策略"},{"action":"由数据管理部门确定数据监查频率","category":"source_missing","gap_id":"gap_data_04","missing_source_classes":["数据监查频率文件"],"target":"数据监查频率"}],"heading":"数据采集与管理","missing_source_classes":["数据管理计划（含数据核查规则）","EDC系统规格说明","源数据验证策略","数据监查频率文件"],"proposal_text":"本研究采用电子数据采集系统收集全部研究数据。数据采集范围覆盖筛选期、双盲主治疗期（12个月，每4周一次给药及安全评估访视）和安全随访期（12个月）。每次访视记录血常规、肝肾功能、感染事件及合并用药信息，并按方案规定的时间节点进行血脂与BK病毒检测。第12个月协议活检结果、DSA检测及肾功能评价数据在相应访视采集。严重不良事件的关键数据点应在电子数据采集系统中与安全性数据库进行一致性比对，确保数据完整性和准确性。数据管理流程包括数据录入、逻辑核查、质疑管理、数据清理及数据库锁定。统计分析计划在数据库锁定前最终确定，届时所有数据核查与清理工作应已完成。数据监查、源数据核查及数据管理的具体操作规程由申办者数据管理部门制定，并在研究启动前向各研究中心传达。","rationale":"数据采集范围（每4周给药及安全评估、每次记录血常规/肝肾功能/感染/合并用药、定期血脂与BK病毒检测、第12个月协议活检/DSA/肾功能评价）及双盲治疗期12个月加安全随访12个月来自当前项目已确认研究事实。EDC中SAE关键数据点与安全性数据库一致性比对、SAP在数据库锁定前确定来自公司语料，作为监管共性结构参照。本项目EDC系统名称、数据管理计划（含数据核查规则）、源数据验证策略及数据监查频率等实施细节缺少对应项目文件。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_ec68176b64a29e6e","section_number":"10","source_ids":["protocol_full_draft_selection:ee0a7596701f8fc82ea18de4","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","company_corpus:cms_cn_protocol_corpus_20260715_v1:df51ff33eb77d6","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5acd10ce8e436","company_corpus:cms_cn_protocol_corpus_20260715_v1:df064f51d3d147","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc2af7591dc952"]},{"ai_run_id":"airun_20261004235442_2a3b95e0","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"安全性终点：描述感染及其他重要风险；严重及机会性感染；BK病毒再激活；胃肠道穿孔风险信号；肝酶升高；血脂异常；中性粒细胞减少；注射部位反应","quote_sha256":"d670accdc119b83acd6ad30622848231143ff6b0cc4254ae90ac2b46954d47d5","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_safety_endpoints"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"每次记录血常规、肝肾功能、感染及合并用药，定期血脂与BK病毒检测。","quote_sha256":"e2a2f4ef6e0b95c23c24ad0eb231b7bc32d9c67b520f44cbd0852cee0586cfb6","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_visit_strategy"},{"locator":"section:7.3.7 严重不良事件一致性比对|block:1049|chunk:1","quote":"EDC 中 SAE 关键数据点应与安全性数据库进行一致性比对。","quote_sha256":"89137f59a7a4b6b574df06af2472181735de0125de055f6939636b33ffcf7e2c","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:df51ff33eb77d6","span_id":"es_edc_sae"},{"locator":"section:8 统计学考虑|block:1056|chunk:1","quote":"有效性评价、安全性评价、PK 评价、PD 评价、免疫原性评价以及其他分析将在本研究的统计分析计划（SAP）中详细规定，数据库锁定前将最终确定 SAP。","quote_sha256":"a635fe9c51c78cbc66090c3553c488cd453e807e61608a97e0767740d5088a03","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","span_id":"es_sap_timing"}],"evidence_review_advisories":[],"evidence_span_ids":["es_safety_endpoints","es_visit_strategy","es_edc_sae","es_sap_timing"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":2},"gap_items":[{"action":"由数据管理部门根据方案数据采集需求设计CRF，经医学团队审核","category":"source_missing","gap_id":"gap_crf_01","missing_source_classes":["CRF设计文件"],"target":"CRF设计文件及字段清单"},{"action":"由数据管理部门建立CRF字段与源数据的映射关系","category":"source_missing","gap_id":"gap_crf_02","missing_source_classes":["CRF与源数据对应关系"],"target":"CRF与源数据对应关系"},{"action":"由数据管理部门制定CRF版本管理规程","category":"source_missing","gap_id":"gap_crf_03","missing_source_classes":["CRF版本管理流程"],"target":"CRF版本管理流程"}],"heading":"病例报告表","missing_source_classes":["CRF设计文件","eCRF字段清单","CRF与源数据对应关系","CRF版本管理流程"],"proposal_text":"本研究采用电子病例报告表收集受试者数据。病例报告表的设计应完整覆盖方案规定的数据采集需求，包括但不限于：人口学及基线特征、入排标准核查、研究药物给药记录（实际剂量、给药时间、注射部位及漏用情况）、安全性事件（含感染、BK病毒再激活、胃肠道穿孔风险信号、肝酶升高、血脂异常、中性粒细胞减少、注射部位反应）、合并用药、实验室检查（血常规、肝肾功能、血脂、BK病毒）、DSA检测、协议活检结果、肾功能评价及随访信息。病例报告表应设置逻辑核查规则，对关键数据点进行范围校验和交叉校验。严重不良事件的关键数据点应在电子数据采集系统中与安全性数据库进行一致性比对。病例报告表的最终版本在数据库锁定前完成定稿，统计分析计划在数据库锁定前最终确定。","rationale":"数据采集需求（给药记录含实际剂量/时间/部位/漏用、安全性终点清单、实验室检查项目、DSA、协议活检、肾功能评价）来自当前项目已确认研究事实。EDC中SAE关键数据点与安全性数据库一致性比对、SAP在数据库锁定前确定来自公司语料，作为监管共性结构参照。本项目CRF设计文件、eCRF字段清单、CRF与源数据对应关系及CRF版本管理流程缺少对应项目文件。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_5336217795b5bf0b","section_number":"10.1","source_ids":["protocol_full_draft_selection:ee0a7596701f8fc82ea18de4","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","company_corpus:cms_cn_protocol_corpus_20260715_v1:df51ff33eb77d6","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5acd10ce8e436","company_corpus:cms_cn_protocol_corpus_20260715_v1:df064f51d3d147","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc2af7591dc952"]},{"ai_run_id":"airun_20261004235442_2a3b95e0","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"每次记录血常规、肝肾功能、感染及合并用药，定期血脂与BK病毒检测。","quote_sha256":"e2a2f4ef6e0b95c23c24ad0eb231b7bc32d9c67b520f44cbd0852cee0586cfb6","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_visit_strategy"},{"locator":"section:7.3.7 严重不良事件一致性比对|block:1049|chunk:1","quote":"EDC 中 SAE 关键数据点应与安全性数据库进行一致性比对。","quote_sha256":"89137f59a7a4b6b574df06af2472181735de0125de055f6939636b33ffcf7e2c","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:df51ff33eb77d6","span_id":"es_edc_sae"},{"locator":"section:8 统计学考虑|block:1056|chunk:1","quote":"有效性评价、安全性评价、PK 评价、PD 评价、免疫原性评价以及其他分析将在本研究的统计分析计划（SAP）中详细规定，数据库锁定前将最终确定 SAP。","quote_sha256":"a635fe9c51c78cbc66090c3553c488cd453e807e61608a97e0767740d5088a03","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","span_id":"es_sap_timing"}],"evidence_review_advisories":[],"evidence_span_ids":["es_visit_strategy","es_edc_sae","es_sap_timing"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":1},"gap_items":[{"action":"由数据管理部门与医学团队共同确定本项目源数据类型清单","category":"source_missing","gap_id":"gap_source_01","missing_source_classes":["源数据类型清单"],"target":"源数据类型清单及界定"},{"action":"由数据管理部门确定源数据核查范围、方法及频率","category":"source_missing","gap_id":"gap_source_02","missing_source_classes":["源数据验证策略"],"target":"源数据核查范围与策略"},{"action":"由数据管理部门制定数据溯源规则","category":"source_missing","gap_id":"gap_source_03","missing_source_classes":["数据溯源规则"],"target":"数据溯源规则"}],"heading":"数据源的定义","missing_source_classes":["源数据类型清单","源数据核查范围与策略","数据溯源规则","电子源数据与纸质源数据界定文件"],"proposal_text":"本研究的源数据是指记录在研究中心原始文件中的、用于支持病例报告表中所填数据的第一手记录。源数据类型包括但不限于：受试者病历、实验室检查原始报告、影像学及病理报告（含协议活检病理切片及报告）、给药记录、合并用药处方或医嘱、知情同意书、不良事件记录及随访记录。电子数据采集系统中录入的数据应与源数据保持一致。严重不良事件的关键数据点应在电子数据采集系统中与安全性数据库进行一致性比对，确保安全性信息的完整传递。源数据核查的范围、方法及频率由申办者数据管理部门在研究启动前确定，并向各研究中心传达。统计分析计划在数据库锁定前最终确定，届时源数据核查与数据清理工作应已完成。","rationale":"数据采集需求中涉及的实验室检查、DSA检测、协议活检、肾功能评价等数据类型来自当前项目已确认研究事实。EDC中SAE关键数据点与安全性数据库一致性比对、SAP在数据库锁定前确定来自公司语料，作为监管共性结构参照。本项目源数据类型清单、电子源数据与纸质源数据的界定、源数据核查范围及数据溯源规则缺少对应项目文件。源数据类型清单中列出的具体类型（病历、实验室报告、病理报告等）为监管共性结构参照，需医学经理确认是否适用于本项目。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_b55fee77e2f15443","section_number":"10.2","source_ids":["protocol_full_draft_selection:ee0a7596701f8fc82ea18de4","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","company_corpus:cms_cn_protocol_corpus_20260715_v1:df51ff33eb77d6","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5acd10ce8e436","company_corpus:cms_cn_protocol_corpus_20260715_v1:df064f51d3d147","company_corpus:cms_cn_protocol_corpus_20260715_v1:fc2af7591dc952"]}],"source_bindings":[{"content_sha256":"16ba65f283bfab0fb41b1158fde2567e6c65e5e0f120ae7259a1799f3f983c49","locator":"document:mwdoc_greenfield_proj_user_ec544fb663c7_3754772d209fc17b:full-draft:ee0a7596701f8fc82ea18de4","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:ee0a7596701f8fc82ea18de4","source_type":"protocol_full_draft_selection","source_version":"full-draft:65721db521c9622e4b49eecc2f74d1a8ce14c48d593688962b7312b74b6fd9d2:ee0a7596701f8fc82ea18de4","text_sha256":"16ba65f283bfab0fb41b1158fde2567e6c65e5e0f120ae7259a1799f3f983c49"},{"content_sha256":"39d5e2592d7b4f9c44083a7979cbd4731c2223ad66c721c81ae6e6ef1cbd4be6","locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0fa