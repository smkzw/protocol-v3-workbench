3c4564d8f742043095c031e5d9b9d0f745cdc61932e22cfe55444b538c","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es5"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"自适应设计是否计划：否\n样本量再估计是否计划：否\n期中分析是否计划：否\nSRC是否计划：否\nDMC是否计划：是","quote_sha256":"e10a8d8a6f45953940dc44db993ce4fb5844ebb3a5b49c85365d79e0b89c8c97","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es6"}],"evidence_review_advisories":[],"evidence_span_ids":["es1","es2","es3","es4","es5","es6"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[],"heading":"研究设计","missing_source_classes":[],"proposal_text":"本研究为随机、双盲、安慰剂对照、平行分组、多中心III期确证性研究，旨在评价KZ-6210在标准背景免疫抑制之上预防慢性移植肾排斥反应的疗效与安全性。研究采用1:1随机分配，试验组接受KZ-6210 162 mg皮下注射每4周一次，对照组接受给药途径、频次及外观与试验组保持盲态一致的匹配安慰剂皮下注射每4周一次，两组均维持标准背景免疫抑制。双盲主治疗期持续12个月，结束后进入12个月安全随访期。研究设置独立数据监查委员会对安全性与有效性数据进行定期审阅。本研究不采用自适应设计，不进行样本量再估计，不安排期中分析，亦不设置独立安全审查委员会。主要分析集为修正意向治疗集，主要比较采用双侧α=0.05，目标把握度80%。","rationale":"本段正文依据项目已确认研究事实中的总体研究设计、试验组与对照组方案、研究时期、DMC设置、自适应/期中/样本量再估计排除声明及统计分析策略编写。医学负责人需核实：Banff复合终点具体组成项与判定流程；样本量最终数值待事件率外部依据审阅后锁定；次要终点多重性策略在统计分析计划中明确。","review_advisories":["本节复述高影响研究设计（研究设计）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（α、期中分析、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_2538f83e63078001","section_number":"4","source_ids":["protocol_full_draft_selection:c0922e5a1c4b5e1438c61f63","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca"]},{"ai_run_id":"airun_20261004231515_ab9771e3","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"总体研究设计：随机、双盲、安慰剂对照、平行分组、多中心III期设计","quote_sha256":"4d1bfbf57db63c22474808111e7c7f451396868b5fa32181c0286ed30850383d","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es1"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"研究时期：双盲主治疗期12个月；安全随访12个月","quote_sha256":"abde817822f8ff518ff59c0488831533ffdcdf5956a4b389cbc557cdb39d2b80","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es3"}],"evidence_review_advisories":[],"evidence_span_ids":["es1","es3"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[],"heading":"总体设计","missing_source_classes":[],"proposal_text":"本研究总体设计为随机、双盲、安慰剂对照、平行分组、多中心III期设计，设置独立数据监查委员会。随机化采用1:1分配，试验组与对照组在给药途径、给药频次及药物外观上保持盲态一致。研究包含双盲主治疗期12个月及安全随访期12个月，总研究周期为24个月。筛选期完成入排标准评估、感染筛查与知情同意；基线时完成随机化；治疗期每4周进行一次给药及安全性评估；第12个月进行协议活检、DSA及肾功能评价；结束治疗后继续12个月安全随访。每次访视记录血常规、肝肾功能、感染事件及合并用药，定期进行血脂与BK病毒检测。","rationale":"本段正文依据项目已确认研究事实中的总体研究设计、研究时期、访视策略及DMC设置编写。访视频率与检查项目来源于已确认的访视策略描述。医学负责人需核实：'定期'血脂与BK病毒检测的具体频次与时间点；协议活检的Banff判定流程与中心病理阅片安排；安全随访期各访视的具体检查项目是否与治疗期完全一致。","review_advisories":["本节复述高影响研究设计（总体设计）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_ec540f0c8d12c28a","section_number":"4.1","source_ids":["protocol_full_draft_selection:c0922e5a1c4b5e1438c61f63","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca"]},{"ai_run_id":"airun_20261004231515_ab9771e3","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"主要终点：第12个月协议活检证实的慢性活动性排斥发生率，按Banff标准定义复合终点并在完整方案中锁定组成项与判定流程","quote_sha256":"69e8a5141f8c112ee821dc7ead6f7782f65afd738a8080d6b888ff05e537125d","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es4"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"样本量策略：双侧α=0.05，目标把握度80%；依据预计事件率、两组临床有意义差异及脱落比例估算样本量。目前事件率证据未确定，不填写虚构最终例数；完成外部依据审阅后锁定。","quote_sha256":"e316f53c4564d8f742043095c031e5d9b9d0f745cdc61932e22cfe55444b538c","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es5"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"估计目标策略：目标人群为符合入排的随机化肾移植受者；比较背景免疫抑制上加载KZ-6210与安慰剂的12个月慢性活动性排斥发生率差异。死亡、移植物丢失作为不利复合事件；救援治疗采用治疗策略，缺失活检采用预设敏感性分析，主要分析mITT。","quote_sha256":"b3c986819eb072e4ea90b2e48aa88cede5bcc10377b968e6bd3732cf1ffb3c0b","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es8"}],"evidence_review_advisories":[],"evidence_span_ids":["es4","es5","es8"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"gap_items":[{"action":"需项目病理判定方案或Banff 2019/2023分类文件，明确复合终点包含的病理亚组分及中心阅片流程。","category":"source_missing","gap_id":"gap_4_2_1_banff","missing_source_classes":["项目病理判定方案","Banff分类文件"],"target":"4.2.1 确证性设计与假设依据——Banff复合终点组成项"},{"action":"待外部事件率依据审阅完成后锁定最终例数；当前不填写虚构数值。","category":"source_missing","gap_id":"gap_4_2_1_sample_size","missing_source_classes":["外部流行病学/历史对照数据"],"target":"4.2.1 确证性设计与假设依据——样本量最终数值"},{"action":"需统计分析计划或方案附录明确mITT集的具体排除条件定义。","category":"source_missing","gap_id":"gap_4_2_1_mitt","missing_source_classes":["统计分析计划"],"target":"4.2.1 确证性设计与假设依据——mITT排除条件"}],"heading":"确证性设计与假设依据","missing_source_classes":["项目病理判定方案","Banff分类文件","外部流行病学/历史对照数据","统计分析计划"],"proposal_text":"本研究为确证性III期研究，主要研究目的为比较KZ-6210与安慰剂在标准背景免疫抑制之上预防第12个月协议活检证实的慢性活动性排斥的效果。主要终点为第12个月协议活检证实的慢性活动性排斥发生率，按Banff标准定义复合终点，具体组成项与判定流程在完整方案中锁定。估计目标策略以符合入排标准的随机化肾移植受者为目标人群，比较背景免疫抑制上加载KZ-6210与安慰剂的12个月慢性活动性排斥发生率差异。死亡与移植物丢失作为不利复合事件纳入主要终点判定；救援治疗采用治疗策略处理；缺失活检数据采用预设敏感性分析。主要分析集为修正意向治疗集，其排除条件需预先定义并保留随机化完整性。主要比较采用双侧α=0.05，目标把握度80%，依据预计事件率、两组临床有意义差异及脱落比例估算样本量；目前事件率证据未确定，不填写虚构最终例数，完成外部依据审阅后锁定。","rationale":"本段正文依据项目已确认研究事实中的主要研究目的、主要终点定义、估计目标策略、统计分析策略及样本量策略编写。Banff复合终点框架、mITT分析集、双侧α=0.05与80%把握度、死亡/移植物丢失复合事件处理及救援治疗策略均为已确认事实。医学负责人需核实：Banff复合终点具体组成项及中心病理判定流程；mITT排除条件的具体定义；样本量最终数值待事件率外部依据审阅后确定；次要终点多重性策略。","review_advisories":["本节复述高影响研究设计（确证性设计与假设依据）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（α、主要终点、估计目标、样本量）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_c0ebae1daadbb0aa","section_number":"4.2.1","source_ids":["protocol_full_draft_selection:c0922e5a1c4b5e1438c61f63","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","company_corpus:cms_cn_protocol_corpus_20260715_v1:21fb7445eed9f6","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca"]}],"source_bindings":[{"content_sha256":"537fc299a40c2f6f8269dd653f7f81581ca5fa6f8fb9e90023e64356f800008d","locator":"document:mwdoc_greenfield_proj_user_ec544fb663c7_3754772d209fc17b:full-draft:c0922e5a1c4b5e1438c61f63","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:c0922e5a1c4b5e1438c61f63","source_type":"protocol_full_draft_selection","source_version":"full-draft:65721db521c9622e4b49eecc2f74d1a8ce14c48d593688962b7312b74b6fd9d2:c0922e5a1c4b5e1438c61f63","text_sha256":"537fc299a40c2f6f8269dd653f7f81581ca5fa6f8fb9e90023e64356f800008d"},{"content