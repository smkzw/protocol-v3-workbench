797e1be266","span_id":"es_placebo_blind"}],"evidence_review_advisories":[],"evidence_span_ids":["es_drug_identity","es_placebo_blind"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[],"heading":"研究药物信息","missing_source_classes":[],"proposal_text":"本研究的试验药物为KZ-6210，系一种靶向IL-6受体的单克隆抗体，通过阻断IL-6信号通路、抑制B细胞活化，降低供体特异性抗体介导的慢性移植物损伤，用于慢性移植肾排斥反应的预防。KZ-6210以注射剂形式提供，经皮下途径给药，属全身性暴露。试验组受试者接受KZ-6210 162 mg皮下注射，每4周一次；对照组接受匹配安慰剂皮下注射，给药途径、频次及外观与试验组保持盲态一致。两组均维持标准背景免疫抑制方案。注射操作在研究中心按规范完成，每次给药须记录实际剂量、注射时间、注射部位及漏用情况。双盲主治疗期持续12个月，治疗期每4周进行一次给药及安全评估。","rationale":"药物名称、技术类型、给药途径、剂型、暴露范围、作用机制、剂量、给药频次、安慰剂盲态一致要求、背景免疫抑制维持及注射记录要求均来源于当前项目已确认研究事实。医学负责人需核实：KZ-6210的完整制剂处方与辅料、具体规格（预充针或西林瓶）、储存温度与有效期、注射部位轮换规则，以及每4周一次是否允许±2天给药窗口。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_5edb3d7989daaa55","section_number":"6.1.1","source_ids":["protocol_full_draft_selection:326b5a2689b260f5a5b6bea5","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266"]},{"ai_run_id":"airun_20261004232829_b52f712e","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取KZ-6210及匹配安慰剂的制剂处方、规格、包装形式、标签模板、储存条件（温度、湿度、光照）、有效期、运输条件及中心药房接收与储存操作规范","category":"source_missing","gap_id":"gap_packaging_storage","missing_source_classes":["研究者手册药学章节","药物管理SOP","中心药房操作手册"],"target":"6.1.2 制备、包装、标签、储存与管理"}],"heading":"制备、包装、标签、储存与管理","missing_source_classes":["研究者手册药学章节","药物管理SOP","中心药房操作手册","制剂稳定性与储存条件文件"],"proposal_text":"","rationale":"当前允许来源仅确认KZ-6210为单克隆抗体注射剂、皮下给药、全身性暴露，但未提供制剂处方、辅料组成、具体规格、包装形式、标签内容要求、储存温度与湿度条件、有效期、运输条件、开封后稳定性、中心药房接收与储存操作规范等项目级实施细节。上述内容需查阅研究者手册药学章节、药物管理SOP或中心药房操作手册后方可撰写。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_4c7b8969b2546804","section_number":"6.1.2","source_ids":["protocol_full_draft_selection:326b5a2689b260f5a5b6bea5","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266"]},{"ai_run_id":"airun_20261004232829_b52f712e","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取试验药与安慰剂的发放流程（含随机化后药物分配方式）、逐次发放与回收记录要求、未使用及过期药物清点与退回程序、销毁方式及药物追踪系统操作规范","category":"source_missing","gap_id":"gap_distribution_recycling","missing_source_classes":["药物管理SOP","中心药房操作手册","药物追踪与清点规程"],"target":"6.1.3 发放、回收与清点"}],"heading":"发放、回收与清点","missing_source_classes":["药物管理SOP","中心药房操作手册","药物追踪与清点规程"],"proposal_text":"","rationale":"当前允许来源未包含试验药与安慰剂从申办方或中心药房向研究中心发放的流程、受试者用药的逐次发放与回收规则、未使用或过期药物的清点与退回程序、销毁方式及记录要求等项目级规定。上述内容需查阅药物管理SOP、中心药房操作手册或药物追踪系统说明后方可撰写。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_60d6087cf7981e5b","section_number":"6.1.3","source_ids":["protocol_full_draft_selection:326b5a2689b260f5a5b6bea5","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266"]},{"ai_run_id":"airun_20261004232829_b52f712e","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"严重感染或重要实验室异常时暂停研究药，恢复给药需研究者结合风险获益判断，不预设无证据的减量方案","quote_sha256":"939388f53516720e3e79aa181b7d92d002d834d21341adfc5f4259eedce52e90","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_dose_pause"},{"locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","quote":"两组均维持标准背景免疫抑制，按临床需要调整背景药并完整记录","quote_sha256":"dfae17afc5812c5d86b5b34521f6c519cc15c9d897173bd334f0f317cab42d4e","source_id":"current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266","span_id":"es_background_immune"}],"evidence_review_advisories":[],"evidence_span_ids":["es_dose_pause","es_background_immune"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"确认重要实验室异常的具体判定阈值及暂停后恢复给药的观察期","category":"source_missing","gap_id":"gap_dose_threshold","missing_source_classes":["安全性管理SOP","剂量调整操作指引"],"target":"6.3 剂量调整、暂停、恢复与永久停药"}],"heading":"剂量调整、暂停、恢复与永久停药","missing_source_classes":["安全性管理SOP","剂量调整操作指引"],"proposal_text":"本研究不预设剂量减量方案。当受试者出现严重感染或重要实验室异常时，研究者应暂停KZ-6210或安慰剂给药。恢复给药须由研究者结合受试者个体风险与获益进行判断，在确认感染控制或实验室指标恢复至可接受水平后方可恢复原剂量皮下注射。两组均维持标准背景免疫抑制方案，背景免疫抑制药物按临床需要调整并完整记录调整原因、剂量及时间。研究期间不预设因研究药物引起的剂量下调路径；若研究者判断继续给药的风险超过获益，可永久停用研究药物，同时继续背景免疫抑制及安全性随访。","rationale":"暂停触发条件（严重感染或重要实验室异常）、恢复给药由研究者判断、不预设减量方案、背景免疫抑制按临床需要调整并记录等规则来源于当前项目已确认研究事实。医学负责人需核实：重要实验室异常的具体判定阈值（如中性粒细胞绝对值下限、ALT/AST倍数上限）、暂停后恢复给药的观察期长度、永久停药后是否继续安全随访及随访时长、背景免疫抑制调整的具体操作指引。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_ec544fb663c7_aef0405eee7578ed","section_number":"6.3","source_ids":["protocol_full_draft_selection:326b5a2689b260f5a5b6bea5","current_project_study_definition:mwdefinition_f655b7539c8d072baaef:r8:0facf5797e1be266"]}],"source_bindings":[{"content_sha256":"a91617639d4308c4fe7a8d9d073ddf1dc96efd16fe253eb9450b02c220f320c6","locator":"document:mwdoc_greenfield_proj_user_ec544fb663c7_3754772d209fc17b:full-draft:326b5a2689b260f5a5b6bea5","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:326b5a2689b260f5a5b6bea5","source_type":"protocol_full_draft_selection","source_version":"full-draft:65721db521c9622e4b49eecc2f74d1a8ce14c48d593688962b7312b74b6fd9d2:326b5a2689b260f5a5b6bea5","text_sha256":"a91617639d4308c4fe7a8d9d073ddf1dc96efd16fe253eb9450b02c220f320c6"},{"content_sha256":"39d5e2592d7b4f9c44083a7979cbd4731c2223ad66c721c81ae6e6ef1cbd4be6","locator":"study_definition:mwdefinition_f655b7539c8d072baaef:revision:8","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwde