tor":"study_definition:mwdefinition_326dd2a3e5a7f06de283:revision:4","quote":"FAS主分析：缓解率比较用CMH检验/logistic回归（双侧α=0.10，探索性）；连续终点ANCOVA/MMRM；安全性SS描述汇总；SAP另行制定。","quote_sha256":"54ebae8a148c04d798c8590356368a9bf1295f9d718766a2bd2833779be7217d","source_id":"current_project_study_definition:mwdefinition_326dd2a3e5a7f06de283:r4:e8d978fc84842e5b","span_id":"es_003"}],"evidence_review_advisories":[],"evidence_span_ids":["es_001","es_002","es_003"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":2},"gap_items":[{"action":"补充PK采血时间点、样本采集流程及生物分析方法","category":"source_missing","gap_id":"gap_pk_sampling","missing_source_classes":["PK采样方案","实验室操作手册"],"target":"9.6 PK数据分析"},{"action":"在SAP中明确PK分析模型、参数清单及暴露-效应分析策略","category":"source_missing","gap_id":"gap_pk_method","missing_source_classes":["统计分析计划"],"target":"9.6 PK数据分析"}],"heading":"PK数据分析","missing_source_classes":["PK采样方案（采血时间点、样本量、分析方法）","PK分析具体方法学（房室模型、群体PK、暴露-效应建模）","PD终点（VNN1抑制率）是否纳入本研究的确认文件"],"proposal_text":"本研究为IIa期概念验证与剂量探索研究，药代动力学分析旨在支持160mg BID与80mg BID两个活性剂量组的暴露-效应关系评估及候选RP2D确认。既往I期及Ib期数据显示MY009212A血浆半衰期约7至8小时，单次给药80mg及以上剂量后24小时VNN1抑制率超过80%，多次给药160mg稳态给药间隔内抑制率接近100%并达到量效平台，上述数据支持每日两次给药方案。PK分析的具体方法学，包括房室模型选择、非房室与房室参数清单、群体药代动力学建模策略、暴露-效应及暴露-安全性分析框架，以及是否纳入VNN1抑制率作为PD终点进行PK/PD联合建模，将在统计分析计划中详细规定并于数据库锁定前最终确定。PK样本的采集时间点、分析方法及生物分析实验室资质要求将在方案附件或实验室操作手册中另行规定。","rationale":"本项目已确认研究事实中'药理/PK/PD考虑'段落提供了既往PK/PD背景数据（半衰期7-8h、BID方向、量效平台），'统计分析策略'段落明确PK评价归入SAP。公司语料中MG-K10方案确认PK评价在SAP中详细规定的结构惯例。但本项目来源未给出PK采血时间点、具体PK参数清单及建模方法，因此正文仅写入已确认背景事实与SAP归属声明，具体方法学待SAP制定后补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3f4f11edbdf4_028aa81e26877c8f","section_number":"9.6","source_ids":["protocol_full_draft_selection:6e0c62dc0c5a2fd44b547fb3","current_project_study_definition:mwdefinition_326dd2a3e5a7f06de283:r4:e8d978fc84842e5b","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","company_corpus:cms_cn_protocol_corpus_20260715_v1:7450f8d809500d","company_c