{"ai_route":{"actual_response_model":"mtplx-flash-next-optimized-speed","ai_run_id":"airun_20261012154908_fe2358b7","expected_response_model":"mtplx-flash-next-optimized-speed","fallback_chain_id":"aifb_b36e85d202d66e45ff326b09","fallback_depth":0,"fallback_reason":"","model":"mtplx-flash-next-optimized-speed","provider":"mtplx","reasoning_effort":"xhigh","route_base_url":"http://127.0.0.1:8002/v1","route_identity_hash":"c9480819205db8521fec70763515cf905334434da194fa8ae2172b40ab545075","route_profile_id":"independent_ai__mtplx_qwen38_local","thinking":"enabled"},"ai_run_id":"airun_20261012154908_fe2358b7","chunk_index":8,"job_id":"mwjob_c998b723219d608ff1e9a389","precondition_digest":"d8b4e74314ea8600f6e332c9315e43e742fa7765d4659f4dac067ea7f8d977b1","project_id":"proj_user_3f4f11edbdf4","schema_version":"protocol_full_draft_chunk_v10","section_ids":["mwsec_greenfield_proj_user_3f4f11edbdf4_ac8cad34f1cc6350","mwsec_greenfield_proj_user_3f4f11edbdf4_2b88ae97d4122734","mwsec_greenfield_proj_user_3f4f11edbdf4_15df5305f2c948fb","mwsec_greenfield_proj_user_3f4f11edbdf4_60c574e2da67c1d7"],"sections":[{"ai_run_id":"airun_20261012154908_fe2358b7","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取项目级药物过量处理流程、给药错误识别与纠正程序、过量后监测方案及急救措施文件","category":"source_missing","gap_id":"gap_overdose_procedure","missing_source_classes":["药物过量处理流程/急救方案","给药错误报告与纠正程序"],"target":"6.4节全文"},{"action":"检索MY009212A片研究者手册中药物过量相关章节","category":"source_not_retrieved","gap_id":"gap_ib_overdose","missing_source_classes":["研究者手册（IB）"],"target":"6.4节全文"}],"heading":"药物过量与给药错误管理","missing_source_classes":["药物过量处理流程/急救方案","给药错误报告与纠正程序","试验药包装储存与发放回收操作规程","研究者手册（IB）中过量相关章节"],"proposal_text":"","rationale":"本章节需要项目级药物过量处理流程、给药错误识别与纠正程序、过量后监测与急救方案等实施文件。当前允许来源仅包含给药方案（MY009212A片40mg/片、BID、约间隔12小时）和药代动力学信息（血浆半衰期约7-8小时），以及既往安全性概况（AE散发、未见量效关系、无SAE），但无药物过量定义、过量分级、处理流程、给药错误报告时限与纠正措施等项目级操作规范。依据任务约束，药物过量与给药错误管理在缺少对应项目文件时必须标记为source_gap，不得以条件句或通用原则替代。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3f4f11edbdf4_ac8cad34f1cc6350","section_number":"6.4","source_ids":["protocol_full_draft_selection:6806264e7585af07ecee6b2e","current_project_study_definition:mwdefinition_326dd2a3e5a7f06de283:r4:e8d978fc84842e5b"]},{"ai_run_id":"airun_20261012154908_fe2358b7","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_326dd2a3e5a7f06de283:revision:4","quote":"依从性=实际/计划服药量×100%（80%-120%）","quote_sha256":"28d69c6f223d27268463a864014666048357dab08ce08c313af04aafe5e4d382","source_id":"current_project_study_definition:mwdefinition_326dd2a3e5a7f06de283:r4:e8d978fc84842e5b","span_id":"es_compliance"},{"locator":"study_definition:mwdefinition_326dd2a3e5a7f06de283:revision:4","quote":"MY009212A片：每日两次（BID）、每次一片、约间隔12小时，空腹或餐后均可；药物由申办方统一提供；依从性=实际/计划服药量×100%（80%-120%）。","quote_sha256":"ba5aacd5f6036bfef22759e2815fa1434fddeb1cadafc1148796371579d6159c","source_id":"current_project_study_definition:mwdefinition_326dd2a3e5a7f06de283:r4:e8d978fc84842e5b","span_id":"es_dose_scheme"},{"locator":"study_definition:mwdefinition_326dd2a3e5a7f06de283:revision:4","quote":"安慰剂对照（双盲双模拟）","quote_sha256":"c10d4332c617c07d307416b69a0059e91c80afe9bf4721bebb8ee8655b63358c","source_id":"current_project_study_definition:mwdefinition_326dd2a3e5a7f06de283:r4:e8d978fc84842e5b","span_id":"es_blind_dummy"},{"locator":"study_definition:mwdefinition_326dd2a3e5a7f06de283:revision:4","quote":"筛选、基线/D1（首剂留观2h）、W2电话、W6、W10、W12终点（含内镜）、W14安全随访；窗口±4天。","quote_sha256":"1300cc14a3168dd1ea419995db581bfab3af3185d162130dd1ece4a90e0a9ffc","source_id":"current_project_study_definition:mwdefinition_326dd2a3e5a7f06de283:r4:e8d978fc84842e5b","span_id":"es_visit_strategy"}],"evidence_review_advisories":[],"evidence_span_ids":["es_compliance","es_dose_scheme","es_blind_dummy","es_visit_strategy"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"确认哪些访视执行药物回收与依从性核查，W2电话访视是否包含依从性问询","category":"source_missing","gap_id":"gap_compliance_visit_detail","missing_source_classes":["访视操作手册","依从性核查SOP"],"target":"6.5节-依从性核查访视安排"},{"action":"确认漏服后是否允许补服、补服时间窗、连续漏服退出阈值","category":"source_missing","gap_id":"gap_missed_dose_rule","missing_source_classes":["给药操作指南","受试者手册"],"target":"6.5节-漏服处理"},{"action":"确认依从性低于80%时的研究者评估流程与是否触发退出","category":"source_missing","gap_id":"gap_low_compliance_action","missing_source_classes":["方案实施SOP"],"target":"6.5节-依从性不达标处置"}],"heading":"研究治疗依从性","missing_source_classes":["各访视依从性核查操作细则","漏服处理与补服规则","依从性不达标处置流程","药物回收与计数操作规程"],"proposal_text":"本研究采用双盲双模拟设计，MY009212A片与安慰剂外观一致，受试者每日两次（BID）口服给药，每次一片，两次给药间隔约12小时，空腹或餐后均可服用。研究治疗依从性以实际服药量与计划服药量之比（实际/计划服药量×100%）进行评价，依从性合格范围为80%至120%。研究期间，受试者应严格按照方案规定的给药方案服用研究药物，不得自行增减剂量或更改给药时间。研究药物由申办方统一提供，各访视时由研究者或指定人员回收未服用药物并记录受试者自报的服药情况，以核实依从性。对于漏服情况，受试者应在下次计划给药时间按正常剂量服用，不得加倍补服。若受试者连续漏服超过一定次数或依从性持续低于80%，研究者应评估是否继续参与研究。","rationale":"依从性定义（实际/计划服药量×100%，80%-120%）和给药方案（BID、每次一片、约间隔12小时、空腹或餐后均可）来源于当前项目已确认研究事实。双盲双模拟设计已确认。访视策略列出了筛选、基线/D1、W2电话、W6、W10、W12、W14等访视点，但未明确每个访视是否均执行药物回收与依从性核查。漏服处理规则和依从性不达标时的具体处置流程（如连续漏服次数阈值、是否触发退出）在来源中未给出，上述正文中相关表述为基于给药方案的合理推断，需医学经理确认具体操作规则。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3f4f11edbdf4_2b88ae97d4122734","section_number":"6.5","source_ids":["protocol_full_draft_selection:6806264e7585af07ecee6b2e","current_project_study_definition:mwdefinition_326dd2a3e5a7f06de283:r4:e8d978fc84842e5b"]},{"ai_run_id":"airun_20261012154908_fe2358b7","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_326dd2a3e5a7f06de283:revision:4","quote":"随机化前糖皮质激素（泼尼松≤20mg/天）稳定≥2周，和/或5-ASA≥2g/天稳定≥4周，和/或硫唑嘌呤/6-MP稳定≥6周。","quote_sha256":"eaee781cd719612cbefdfcf52877add9690872de08ad90f19a27e9ebe7b47394","source_id":"current_project_study_definition:mwdefinition_326dd2a3e5a7f06de283:r4:e8d978fc84842e5b","span_id":"es_concomitant_allowed"},{"locator":"study_definition:mwdefinition_326dd2a3e5a7f06de283:revision:4","quote":"筛选前14天内接受过静脉皮质类固醇，或基线前30天内接受过环孢菌素、他克莫司、吗替麦考酚酯或沙利度胺。；基线前30天内接受过粪便菌群移植、细胞单采或传统中药治疗。","quote_sha256":"f680059c185799d7c1314af20e5348b3b600aef426f483c2c3e964193f11dc66","source_id":"current_project_study_definition:mwdefinition_326dd2a3e5a7f06de283:r4:e8d978fc84842e5b","span_id":"es_concomitant_excluded"},{"locator":"study_definition:mwdefinition_326dd2a3e5a7f06de283:revision:4","quote":"未既往使用生物制剂或小分子靶向药","quote_sha256":"db86ea9ccc9f0c8d69c9bf0219125c580d58f1e16d97289550c0b972b33adad7","source_id":"current_project_study_definition:mwdefinition_326dd2a3e5a7f06de283:r4:e8d978fc84842e5b","span_id":"es_no_biologic"},{"locator":"study_definition:mwdefinition_326dd2a3e5a7f06de283:revision:4","quote":"安慰剂对照（双盲双模拟）","quote_sha256":"c10d4332c617c07d307416b69a0059e91c80afe9bf4721bebb8ee8655b63358c","source_id":"current_project_study_definition:mwdefinition_326dd2a3e5a7f06de283:r4:e8d978fc84842e5b","span_id":"es_blind_dummy"}],"evidence_review_advisories":[],"evidence_span_ids":["es_concomitant_allowed","es_concomitant_excluded","es_no_biologic","es_blind_dummy"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"获取项目级禁限用药清单，确认是否包含CYP酶相关药物、活疫苗、其他UC治疗药物等","category":"source_missing","gap_id":"gap_full_prohibited_list","missing_source_classes":["禁限用药清单","药物相互作用数据"],"target":"6.6节-禁限用药完整清单"},{"action":"确认合并用药是否影响PPS入集、是否需在疗效分析中作为协变量","category":"source_missing","gap_id":"gap_concomitant_analysis_rule","missing_source_classes":["统计分析计划（SAP）"],"target":"6.6节-合并用药对分析的影响"},{"action":"确认合并用药记录格式、报告时限、是否需向申办方或伦理委员会报告","category":"source_missing","gap_id":"gap_concomitant_reporting","missing_source_classes":["CRF设计","安全性报告SOP"],"target":"6.6节-合并用药记录与报告"}],"heading":"合并用药/治疗","missing_source_classes":["完整禁限用药清单","合并用药对疗效分析影响规则","合并用药报告格式与时限","合并用药与试验药相互作用数据"],"proposal_text":"本研究为双盲双模拟设计，MY009212A片与安慰剂外观一致，受试者不得自行使用任何未经研究者许可的合并用药或治疗。研究期间，受试者应记录所有合并使用的处方药、非处方药、中草药及膳食补充剂，包括药物名称、剂量、给药途径、起止日期和用药原因，并在每次访视时向研究者报告。研究者应评估合并用药对研究药物安全性与疗效评价的潜在影响。根据入选标准，随机化前允许继续使用的背景治疗包括：糖皮质激素（泼尼松≤20mg/天）稳定≥2周、5-ASA≥2g/天稳定≥4周、硫唑嘌呤或6-MP稳定≥6周；上述背景治疗在研究期间如需调整剂量或停药，须经研究者评估并记录。根据排除标准，筛选前14天内使用过静脉皮质类固醇，或基线前30天内使用过环孢菌素、他克莫司、吗替麦考酚酯、沙利度胺、粪便菌群移植、细胞单采或传统中药治疗的受试者不得入组；研究期间亦不得新启用上述治疗。未既往使用生物制剂或小分子靶向药为入组前提，研究期间不得新启用生物制剂或小分子靶向药作为合并治疗。","rationale":"允许继续使用的背景治疗（泼尼松≤20mg/天、5-ASA≥2g/天、硫唑嘌呤/6-MP）及其稳定时间要求来源于入选标准。排除的近期治疗（静脉皮质类固醇14天、环孢菌素/他克莫司/吗替麦考酚酯/沙利度胺/FMT/细胞单采/传统中药30天）来源于排除标准。生物制剂与小分子靶向药初治要求来源于入选标准。双盲双模拟设计已确认。但完整的禁限用药清单（如是否禁止CYP酶诱导/抑制剂、是否禁止活疫苗）、合并用药对疗效分析的影响规则、合并用药报告的具体格式与时限未在来源中给出。","review_advisories":["本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3f4f11edbdf4_15df5305f2c948fb","section_number":"6.6","source_ids":["protocol_full_draft_selection:6806264e7585af07ecee6b2e","current_project_study_definition:mwdefinition_326dd2a3e5a7f06de283:r4:e8d978fc84842e5b"]},{"ai_run_id":"airun_20261012154908_fe2358b7","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_326dd2a3e5a7f06de283:revision:4","quote":"随机化前糖皮质激素（泼尼松≤20mg/天）稳定≥2周，和/或5-ASA≥2g/天稳定≥4周，和/或硫唑嘌呤/6-MP稳定≥6周。","quote_sha256":"eaee781cd719612cbefdfcf52877add9690872de08ad90f19a27e9ebe7b47394","source_id":"current_project_study_definition:mwdefinition_326dd2a3e5a7f06de283:r4:e8d978fc84842e5b","span_id":"es_concomitant_allowed"},{"locator":"study_definition:mwdefinition_326dd2a3e5a7f06de283:revision:4","quote":"安慰剂对照（双盲双模拟）","quote_sha256":"c10d4332c617c07d307416b69a0059e91c80afe9bf4721bebb8ee8655b63358c","source_id":"current_project_study_definition:mwdefinition_326dd2a3e5a7f06de283:r4:e8d978fc84842e5b","span_id":"es_blind_dummy"}],"evidence_review_advisories":[],"evidence_span_ids":["es_concomitant_allowed","es_blind_dummy"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"获取项目级允许合并用药清单，确认是否包含NSAIDs、抗生素、抗酸药、益生菌等","category":"source_missing","gap_id":"gap_allowed_list_complete","missing_source_classes":["禁限用药清单","药物相互作用数据"],"target":"6.6.1节-完整允许合并用药清单"},{"action":"检索MY009212A片非临床与临床药物相互作用数据（CYP、转运体等）","category":"source_not_retrieved","gap_id":"gap_ddi_data","missing_source_classes":["研究者手册（IB）","非临床药代动力学报告"],"target":"6.6.1节-相互作用评估"}],"heading":"允许的合并用药/治疗","missing_source_classes":["完整允许合并用药清单","MY009212A片药物相互作用数据","合并用药评估操作细则"],"proposal_text":"根据本研究入选标准，以下背景治疗在满足稳定剂量要求的前提下允许在研究期间继续使用：（1）糖皮质激素：泼尼松或等效剂量≤20mg/天，随机化前已稳定使用≥2周；（2）5-氨基水杨酸（5-ASA）制剂：剂量≥2g/天，随机化前已稳定使用≥4周；（3）免疫抑制剂：硫唑嘌呤或6-巯基嘌呤（6-MP），随机化前已稳定使用≥6周。上述背景治疗在研究期间如需调整剂量或停药，研究者应评估调整原因、记录调整时间与剂量变化，并判断是否影响疗效与安全性评价。除上述允许继续使用的背景治疗外，其他合并用药（包括处方药、非处方药、中草药及膳食补充剂）的使用须经研究者评估，确认与MY009212A片无已知药代动力学或药效学相互作用后方可使用。研究者应记录所有合并用药的名称、剂量、给药途径、起止日期和用药原因。","rationale":"允许继续使用的三类背景治疗（糖皮质激素、5-ASA、免疫抑制剂）及其剂量与稳定时间要求直接来源于入选标准。双盲双模拟设计已确认。但本章节未列出完整的允许合并用药清单（如是否允许NSAIDs、抗生素、抗酸药等），也未给出合并用药与MY009212A片相互作用的具体评估标准。上述'无已知相互作用方可使用'为基于双盲设计的一般性原则表述，具体禁限清单需项目级文件支持。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_3f4f11edbdf4_60c574e2da67c1d7","section_number":"6.6.1","source_ids":["protocol_full_draft_selection:6806264e7585af07ecee6b2e","current_project_study_definition:mwdefinition_326dd2a3e5a7f06de283:r4:e8d978fc84842e5b"]}],"source_bindings":[{"content_sha256":"a753063498b60aa2531b2bacf2215577a60d0b4f3e528671e0d1c6cd21d03f8a","locator":"document:mwdoc_greenfield_proj_user_3f4f11edbdf4_0d2c837ebee7effc:full-draft:6806264e7585af07ecee6b2e","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:6806264e7585af07ecee6b2e","source_type":"protocol_full_draft_selection","source_version":"full-draft:d8b4e74314ea8600f6e332c9315e43e742fa7765d4659f4dac067ea7f8d977b1:6806264e7585af07ecee6b2e","text_sha256":"a753063498b60aa2531b2bacf2215577a60d0b4f3e528671e0d1c6cd21d03f8a"},{"content_sha256":"b1cdf82eef4117c1236a8289de21d3f040921de464d4a165b639b13b0018592d","locator":"study_definition:mwdefinition_326dd2a3e5a7f06de283:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_326dd2a3e5a7f06de283:r4:e8d978fc84842e5b","source_type":"current_project_study_definition","source_version":"mwdefinition_326dd2a3e5a7f06de283:r4:e8d978fc84842e5b","text_sha256":"b1cdf82eef4117c1236a8289de21d3f040921de464d4a165b639b13b0018592d"}]}