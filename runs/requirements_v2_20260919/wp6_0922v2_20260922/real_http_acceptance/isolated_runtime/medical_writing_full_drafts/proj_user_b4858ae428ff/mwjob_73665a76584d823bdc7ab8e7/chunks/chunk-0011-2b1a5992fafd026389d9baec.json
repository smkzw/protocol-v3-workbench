nition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"研究时期：筛选期（≤21天）；双盲治疗期（12周）；安全性随访期（2周）","quote_sha256":"b917445cd74c1520405340b57a64c05ed3bf5a2a32344c9c6c15845a7bf0731a","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es_study_period"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"内在研究目的：首次患者试验（first-in-patient）；药理/药效探索；概念验证（PoC）；剂量探索","quote_sha256":"9446f688f9a59b8b0a2b67d283cbeebbe441b61cfbcc1bbce6aac72d65128458","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es_fip"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"试验药物：KZ-HA501（口服选择性缓激肽B2受体拮抗剂薄膜衣片）","quote_sha256":"ce64b557a2ecf0d76ffb92b81794ded6485ac70ea5e73e12bd707655ed7e3204","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es_drug_info"}],"evidence_review_advisories":[],"evidence_span_ids":["es_safety_endpoint","es_visit_strategy","es_study_period","es_fip","es_drug_info"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"gap_items":[{"action":"依据IB v3.1及非临床数据确认生命体征测量项目（血压、心率、体温、呼吸频率等）、各访视是否均实施及异常处理阈值","category":"source_missing","gap_id":"gap_vital_sign_detail","missing_source_classes":["研究者手册","非临床安全性报告"],"target":"7.3.1节生命体征具体测量项目与各访视实施频次"},{"action":"确认体格检查项目范围（全身或系统回顾）、各访视实施安排及异常记录要求","category":"source_missing","gap_id":"gap_physical_exam_detail","missing_source_classes":["研究者手册","项目访视操作手册"],"target":"7.3.1节体格检查范围与实施时点"}],"heading":"生命体征和体格检查","missing_source_classes":["研究者手册（IB v3.1）中生命体征监测方案","非临床安全性研究报告","各访视具体评估项目清单"],"proposal_text":"本研究为首次患者试验，KZ-HA501为口服选择性缓激肽B2受体拮抗剂薄膜衣片，经全身暴露，安全性监测为研究核心组成部分。生命体征与体格检查作为安全性终点之一，以较基线变化为评价维度，贯穿筛选期（不超过21天）、双盲治疗期（12周）及安全性随访期（2周）。访视安排包括筛选访视（V1）、基线随机访视（V2）、治疗期第4周（V3）、第8周（V4）、第12周（V5）及安全性随访访视（V6），评估窗口为正负3天。生命体征与体格检查的具体测量项目、各访视实施频次、正常参考范围界定及异常值处理流程，依据KZ-HA501内部研究者手册v3.1第5.2节推荐剂量方案及非临床安全性数据确定。","rationale":"安全性终点明确列出生命体征较基线变化，访视策略给出V1至V6框架及评估窗口，研究时期为筛选期加12周治疗加2周随访。但各访视是否均实施生命体征与体格检查、具体测量项目（如血压、心率、体温、呼吸频率等）及体格检查范围未在允许来源中逐项列出，需医学经理结合IB及非临床数据确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_b4858ae428ff_7d8fcd8f71d1d06b","section_number":"7.3.1","source_ids":["protocol_full_draft_selection:2b1a5992fafd026389d9baec","current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5"]},{"ai_run_id":"airun_20261009164800_972b25b5","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"安全性终点：TEAE发生率与严重程度（CTCAE 5.0）；生命体征、12导联心电图、临床实验室检查较基线变化；肝酶升高与qt间期延长的特别监测。","quote_sha256":"06515ac1078dcbcf7bd2f61558fc6fffce2a42041de93032bc15aa02cbcfb787","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es_safety_endpoint"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"特别关注的不良事件：肝功能异常（ALT/AST>3×ULN伴胆红素升高）；QTcF>500ms或较基线延长>60ms；严重过敏/超敏反应。","quote_sha256":"1d4cf10bbbb48b2944356ffdf4112d6296fd00423d2bc13c456b2bd96c94121b","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es_special_monitoring"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"内在研究目的：首次患者试验（first-in-patient）；药理/药效探索；概念验证（PoC）；剂量探索","quote_sha256":"9446f688f9a59b8b0a2b67d283cbeebbe441b61cfbcc1bbce6aac72d65128458","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es_fip"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"试验药物：KZ-HA501（口服选择性缓激肽B2受体拮抗剂薄膜衣片）","quote_sha256":"ce64b557a2ecf0d76ffb92b81794ded6485ac70ea5e73e12bd707655ed7e3204","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es_drug_info"}],"evidence_review_advisories":[],"evidence_span_ids":["es_safety_endpoint","es_special_monitoring","es_fip","es_drug_info"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[{"action":"确认心电图在哪些访视实施、是否包含给药后特定时间点采集、评估窗口","category":"source_missing","gap_id":"gap_ecg_timing","missing_source_classes":["研究者手册","项目访视操作手册"],"target":"7.3.2节心电图采集时点与各访视安排"},{"action":"确认QTcF计算公式、判读由中心实验室还是现场完成、异常复查触发条件及停药规则","category":"source_missing","gap_id":"gap_ecg_method","missing_source_classes":["研究者手册","非临床心脏安全性报告"],"target":"7.3.2节心电图判读方法与异常处理"}],"heading":"心电图检查","missing_source_classes":["研究者手册（IB v3.1）中心电图监测方案","非临床心脏安全性研究报告","心电图判读操作规范"],"proposal_text":"本研究安全性终点包含12导联心电图较基线变化，并将QTcF大于500毫秒或较基线延长超过60毫秒列为特别关注的不良事件。KZ-HA501为口服选择性缓激肽B2受体拮抗剂薄膜衣片，经全身暴露，本研究为首次患者试验，心电图监测用于评估药物对心脏复极的潜在影响。心电图检查在筛选期、双盲治疗期及安全性随访期内实施，具体采集时点、判读方法（包括QTcF计算公式）、中心实验室或现场判读安排、异常值复查触发条件及与给药暂停或永久停药相关的处理规则，依据KZ-HA501内部研究者手册v3.1及非临床心脏安全性数据确定。","rationale":"安全性终点明确列出12导联心电图较基线变化，特别关注事件明确列出QTcF大于500毫秒或较基线延长超过60毫秒。但允许来源未给出心电图具体采集时点（是否每个访视均做）、判读标准细节、QTcF计算公式确认、中心实验室安排及异常处理流程，需医学经理结合IB及非临床心脏安全性数据确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_b4858ae428ff_21b6c0a2f4022633","section_number":"7.3.2","source_ids":["protocol_full_draft_selection:2b1a5992fafd026389d9baec","current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5"]},{"ai_run_id":"airun_20261009164800_972b25b5","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"安全性终点：TEAE发生率与严重程度（CTCAE 5.0）；生命体征、12导联心电图、临床实验室检查较基线变化；肝酶升高与qt间期延长的特别监测。","quote_sha256":"06515ac1078dcbcf7bd2f61558fc6fffce2a42041de93032bc15aa02cbcfb787","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es_safety_endpoint"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"特别关注的不良事件：肝功能异常（ALT/AST>3×ULN伴胆红素升高）；QTcF>500ms或较基线延长>60ms；严重过敏/超敏反应。","quote_sha256":"1d4cf10bbbb48b2944356ffdf4112d6296fd00423d2bc13c456b2bd96c94121b","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es_special_monitoring"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"排除标准模块：妊娠或哺乳期；筛选前3个月内使用血管紧张素转换酶抑制剂；存在除HAE外其他原因的血管性水肿（如获得性C1-INH缺乏、ACEI相关水肿）；ALT/AST>2.5×ULN或eGFR<60。","quote_sha256":"22218a8b597d9a870d4c4c95b9e70e33a0c92fce70c70584bdaa31268e8b8c75","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es_exclusion_pregnancy"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"访视策略：筛选（V1）、基线随机（V2）、治疗期第4/8/12周（V3-V5，含发作日记核查与实验室）、安全性随访（V6）；电子日记每日填写，评估窗口±3天。","quote_sha256":"a06c5bfb727d2eed775fcc2c9358264207fc26fc370ac17d2f189dcf4286c897","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es_visit_strategy"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"内在研究目的：首次患者试验（first-in-patient）；药理/药效探索；概念验证（PoC）；剂量探索","quote_sha256":"9446f688f9a59b8b0a2b67d283cbeebbe441b61cfbcc1bbce6aac72d65128458","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es_fip"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"试验药物：KZ-HA501（口服选择性缓激肽B2受体拮抗剂薄膜衣片）","quote_sha256":"ce64b557a2ecf0d76ffb92b81794ded6485ac70ea5e73e12bd707655ed7e3204","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es_drug_info"}],"evidence_review_advisories":[],"evidence_span_ids":["es_safety_endpoint","es_special_monitoring","es_exclusion_pregnancy","es_visit_strategy","es_fip","es_drug_info"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[{"action":"依据IB v3.1及非临床毒理学数据确认实验室检查项目（血常规、肝肾功能、电解质、凝血、尿常规等）及各访视采集安排","category":"source_missing","gap_id":"gap_lab_items","missing_source_classes":["研究者手册","非临床毒理学报告"],"target":"7.3.3节实验室检查具体项目清单"},{"action":"确认异常值复查触发条件、与给药暂停或永久停药相关的阈值及处理流程","category":"source_missing","gap_id":"gap_lab_abnormal_handling","missing_source_classes":["研究者手册","项目安全性管理方案"],"target":"7.3.3节实验室异常值处理与停药规则"}],"heading":"实验室检查","missing_source_classes":["研究者手册（IB v3.1）中实验室监测方案","非临床毒理学研究报告","中心实验室项目清单及参考范围"],"proposal_text":"本研究安全性终点包含临床实验室检查较基线变化，并将肝功能异常（ALT或AST超过3倍正常值上限伴胆红素升高）列为特别关注的不良事件。排除标准中ALT或AST超过2.5倍正常值上限或估算肾小球滤过率低于60毫升每分钟者不得入组。访视策略中治疗期第4周（V3）、第8周（V4）及第12周（V5）访视明确包含实验室检查。KZ-HA501为口服选择性缓激肽B2受体拮抗剂薄膜衣片，经全身暴露，本研究为首次患者试验，实验室监测用于评估药物对肝脏、肾脏、血液学及代谢系统的潜在影响。实验室检查的具体项目清单（如血常规、肝肾功能、电解质、凝血功能、尿常规等）、各访视采集时点、正常参考范围、异常值复查触发条件、与给药暂停或永久停药相关的处理规则以及中心实验室选择，依据KZ-HA501内部研究者手册v3.1及非临床毒理学数据确定。","rationale":"安全性终点列出临床实验室检查较基线变化，特别关注事件列出肝功能异常，排除标准含ALT/AST大于2.5倍ULN及eGFR小于60，访视策略明确V3至V5含实验室。但具体实验室项目清单、各访视是否均采集、复查触发条件及停药规则未在允许来源中逐项列出，需医学经理结合IB及非临床数据确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_b4858ae428ff_01c53cd621570ccf","section_number":"7.3.3","source_ids":["protocol_full_draft_selection:2b1a5992fafd026389d9baec","current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5"]},{"ai_run_id":"airun_20261009164800_972b25b5","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"依据IB v3.1生殖毒性数据确认妊娠检查方法（尿HCG或血清HCG）、筛选期及治疗期各访视是否实施、阳性处理流程","category":"source_missing","gap_id":"gap_pregnancy_test","missing_source_classes":["研究者手册","非临床生殖毒性报告"],"target":"7.3.4节妊娠检查方法、频率与时点"},{"action":"确认育龄期受试者避孕方法要求、避孕起始与终止时点、伴侣妊娠报告流程及新生儿随访安排","category":"source_missing","gap_id":"gap_contraception","missing_source_classes":["项目安全性管理方案","研究者手册"],"target":"7.3.4节避孕方法要求与伴侣妊娠报告"},{"action":"确认治疗期间意外妊娠的报告时限、随访安排、是否影响继续给药及数据记录要求","category":"source_missing","gap_id":"gap_pregnancy_handling","missing_source_classes":["项目安全性管理方案","研究者手册"],"target":"7.3.4节意外妊娠处理程序"}],"heading":"妊娠检查和避孕问询","missing_source_classes":["研究者手册（IB v3.1）中生殖毒性与妊娠监测方案","项目安全性管理方案中妊娠报告与避孕要求","非临床生殖毒性研究报告"],"proposal_text":"","rationale":"允许来源仅在排除标准中列出妊娠或哺乳期，研究人群为成人（12岁及以上）HAE I/II型患者，但未提供妊娠检查方法（尿液或血清HCG）、检查频率与时点、避孕方法要求、伴侣妊娠报告流程、意外妊娠处理程序或新生儿随访安排。本研究为首次患者试验，KZ-HA501为非临床及临床安全性数据有限的新型小分子，妊娠相关监测与避孕要求需依据IB v3.1中生殖毒性数据及项目安全性管理方案确定，当前允许来源不足以形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_b4858ae428ff_550b94a952f1df33","section_number":"7.3.4","source_ids":["protocol_full_draft_selection:2b1a5992fafd026389d9baec","current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5"]}],"source_bindings":[{"content_sha256":"68b44f5bc9b4cb94c013ed016dda79f26ef078a1823ced7057b007952bd662b8","locator":"document:mwdoc_greenfield_proj_user_b4858ae428ff_ba44e26131af2bef:full-draft:2b1a5992fafd026389d9baec","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:2b1a5992fafd026389d9baec","source_type":"protocol_full_draft_selection","source_version":"full-draft:3ffd7d1e98990c139aa2d6cbabe6e9a477954c19ec7cf663f4e63eb18dca0f45:2b1a5992fafd026389d9baec","text_sha256":"68b44f5bc9b4cb94c013ed016dda79f26ef078a1823ced7057b007952bd662b8"},{"content_sha256":"1ccc46e2501752c77ea7f706de0b7d5cf123985689cad4de02d210504a1bf602","locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","source_type":"current_project_study_definition","source_version":"mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","text_sha256":"1ccc46e2501752c77ea7f706de0b7d5cf123985689cad4de02d210504a1bf602"}]}