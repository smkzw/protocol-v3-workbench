te_sha256":"666b358ca244b2d09af7434ea98067d42dd1e767ec37ce212c4942b5b9956fb1","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es3"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"至首次发作的时间；需要急性治疗的发作率；每周血管性水肿相关疼痛NRS评分较基线变化；12周内中重度发作占比","quote_sha256":"e6ef17257b76b17a053806393b551a5fba884af2599f4232f5aa1128f4df8a16","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es4"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"治疗期第4/8/12周（V3-V5，含发作日记核查与实验室）","quote_sha256":"22b212f51d346ae5a4faa25bcf87409de1175057ff41d6a1816cbbe3a01a8908","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es5"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"FAS为主要分析集，PPS敏感性；主要终点采用负二项回归（对数随访时间偏移）比较两组确认发作率","quote_sha256":"40162e74725d37453a0187ac86cbf56534944d72ec20f90443448d7a907e78b9","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es6"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"由不参与评估的药师发放维持盲态","quote_sha256":"8e31d286fcfac9ca640ca1ac6f220269a006f6297b1b73b3323e073eaf02bddd","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es7"}],"evidence_review_advisories":[],"evidence_span_ids":["es1","es2","es3","es4","es5","es6","es7"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":7},"gap_items":[{"action":"需获取完整访视计划表以确认实验室检查、心电图、生命体征等是否每次访视均实施","category":"source_missing","gap_id":"gap_10_2_01","missing_source_classes":["访视计划表"],"target":"各数据源在每个访视的具体采集时点与频率"},{"action":"需确认日记数据传递至研究者审核的时限、争议裁决机制及数据锁定规则","category":"source_missing","gap_id":"gap_10_2_02","missing_source_classes":["数据管理操作规程","电子日记系统操作手册"],"target":"电子日记与研究者审核确认的协作流程与时限"},{"action":"需获取统计分析计划中PPS成员排除的量化标准","category":"source_not_retrieved","gap_id":"gap_10_2_03","missing_source_classes":["统计分析计划"],"target":"PPS中重大方案偏离的具体判定标准"}],"heading":"数据源的定义","missing_source_classes":["访视计划表（各访视具体检查项目与频率）","电子数据采集系统（EDC）功能规格说明","统计分析计划（SAP）中PPS排除细则"],"proposal_text":"本研究的数据采集来源包括以下类别。第一，受试者每日通过电子日记记录HAE发作事件，包括发作时间、部位、严重程度及是否使用急性发作救援药物，评估窗口为±3天；该电子日记数据与研究者审核确认共同构成主要终点（第1至12周经研究者确认的HAE发作率）的判定依据。第二，研究者依据电子日记记录及受试者主诉，对发作事件进行确认或排除，确认后的发作数据进入主要分析。第三，安全性数据来源包括：不良事件按CTCAE 5.0标准进行严重程度分级；生命体征、12导联心电图及临床实验室检查用于监测肝酶升高与QTcF间期延长等特别关注的安全性信号。第四，次要终点数据来源包括：至首次发作的时间、需要急性治疗的发作率、每周血管性水肿相关疼痛NRS评分较基线变化以及12周内中重度发作占比。第五，治疗期第4、8、12周访视（V3至V5）包含发作日记核查与实验室检查。第六，统计分析以全分析集（FAS）为主要分析集，符合方案集（PPS）用于敏感性分析；FAS纳入所有随机化受试者，PPS排除存在重大方案偏离且未完成关键评估的受试者。第七，试验药物与安慰剂由不参与评估的药师发放以维持盲态，药物发放与回收记录作为依从性数据来源。上述各数据源的具体采集时点、频率及是否在每个访视均实施，以方案访视计划表为准。","rationale":"本段正文依据当前项目已确认研究事实中关于电子日记、研究者确认、CTCAE 5.0、NRS评分、12导联心电图、实验室检查、FAS/PPS定义及药师发放盲态维护的描述撰写。各数据源是否在每个访视均采集、电子日记与研究者审核的具体协作时限、PPS中重大方案偏离的具体判定标准等实施细节未在来源中明确，需医学经理结合访视计划表与统计分析计划核实。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_b4858ae428ff_17529225fbe76e8d","section_number":"10.2","source_ids":["protocol_full_draft_selection:ce5647208918390918a65ba2","current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5"]},{"ai_run_id":"airun_20261009170619_94611cbb","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"需获取数据管理计划与监查计划以撰写具体质量保证条款","category":"source_missing","gap_id":"gap_10_3_01","missing_source_classes":["数据管理计划","监查计划"],"target":"数据质量保证程序（监查频率、源数据验证、核查规则、质疑管理）"},{"action":"需获取DMC章程以明确其数据审查范围、频率及安全性信号触发标准","category":"source_missing","gap_id":"gap_10_3_02","missing_source_classes":["DMC章程"],"target":"DMC数据审查职责与触发条件"},{"action":"需获取电子日记系统操作手册及数据管理计划中关于日记数据校验的条款","category":"source_missing","gap_id":"gap_10_3_03","missing_source_classes":["电子日记系统操作手册","数据管理计划"],"target":"电子日记数据完整性校验与缺失数据处理规则"}],"heading":"数据质量保证","missing_source_classes":["数据管理计划","监查计划","DMC章程","电子数据采集系统验证文件"],"proposal_text":"","rationale":"本章节需要描述数据质量保证的具体程序，包括监查计划与频率、源数据验证方法、数据核查规则、质疑管理与关闭流程、独立数据监查委员会（DMC）的数据审查职责、电子日记数据完整性校验规则、以及数据锁定前的质量审核步骤。当前允许来源仅确认本研究计划设立DMC，但未提供上述任何具体质量保证程序、监查频率、核查规则或数据管理流程。缺少数据管理计划、监查计划、DMC章程及电子数据采集系统验证文件等核心来源，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_b4858ae428ff_cf83b154d95adde2","section_number":"10.3","source_ids":["protocol_full_draft_selection:ce5647208918390918a65ba2","current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5"]},{"ai_run_id":"airun_20261009170619_94611cbb","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"需获取档案管理规定及申办方资料保存政策以确认保存年限与介质要求","category":"source_missing","gap_id":"gap_10_4_01","missing_source_classes":["档案管理规定","申办方资料保存政策"],"target":"研究资料保存期限与归档方式"},{"action":"需获取信息安全管理制度及数据保护影响评估以撰写具体保护措施","category":"source_missing","gap_id":"gap_10_4_02","missing_source_classes":["信息安全管理制度","数据保护影响评估"],"target":"受试者个人信息保护技术措施与访问权限分级"},{"action":"需确认本研究是否存在数据出境需求及相应合规评估","category":"source_missing","gap_id":"gap_10_4_03","missing_source_classes":["数据跨境传输合规评估"],"target":"数据跨境传输合规安排"}],"heading":"资料保存与数据保护","missing_source_classes":["数据保护影响评估","信息安全管理制度","档案管理规定","伦理委员会数据保护审查意见"],"proposal_text":"","rationale":"本章节需要描述研究资料的保存期限与方式、电子数据与纸质资料的归档要求、受试者个人信息的保护技术措施与访问权限分级、数据跨境传输合规安排、以及研究结束后资料销毁或移交的条件。当前允许来源未提供任何关于资料保存期限、数据保护技术措施、个人信息保护合规安排或数据访问权限分级的具体条款。缺少数据保护影响评估、信息安全管理制度、档案管理规定及伦理委员会对数据保护的具体要求等核心来源，无法形成有实质信息的正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_b4858ae428ff_bde015159