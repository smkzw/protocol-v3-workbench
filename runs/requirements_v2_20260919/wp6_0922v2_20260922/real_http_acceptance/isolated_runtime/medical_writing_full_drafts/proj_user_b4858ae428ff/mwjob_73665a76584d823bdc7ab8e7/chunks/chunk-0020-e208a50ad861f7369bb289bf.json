:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261009171737_2d6ac006","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:12.2 方案偏离|block:952|chunk:1","quote":"申办者将审查所有方案偏离，并评估是否有严重违背GCP，以及是否要求向卫生主管部门报告。根据申办者的要求或SOP，偏离方案的前瞻性请求，包括放弃方案合格性标准的请求将不会被允许。","quote_sha256":"643056aa94c1285201b5f63d6801971893fb90935354b44c77e0839ffc32b390","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","span_id":"es_deviation_review"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"多中心、随机、双盲、安慰剂平行对照II期发作预防研究；受试者1:1随机至KZ-HA501组或安慰剂组，治疗期12周","quote_sha256":"ee5b391a388afe4915e8d470fcc8143300bbb0ee9dcb487d0391933d87dd2a71","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es_study_design"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"筛选（V1）、基线随机（V2）、治疗期第4/8/12周（V3-V5，含发作日记核查与实验室）、安全性随访（V6）；电子日记每日填写，评估窗口±3天。","quote_sha256":"416c6f4f95926560954e1889bf67d561c153c22fd01f268c905128fb494f5cfd","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es_visit_strategy"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"安全性终点：TEAE发生率与严重程度（CTCAE 5.0）；生命体征、12导联心电图、临床实验室检查较基线变化；肝酶升高与qt间期延长的特别监测。","quote_sha256":"06515ac1078dcbcf7bd2f61558fc6fffce2a42041de93032bc15aa02cbcfb787","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es_safety_monitoring"}],"evidence_review_advisories":[],"evidence_span_ids":["es_deviation_review","es_study_design","es_visit_strategy","es_safety_monitoring"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":3},"gap_items":[{"action":"确认本项目方案偏离重大/非重大分类标准的具体判定细则及报告时限","category":"source_missing","gap_id":"gap_deviation_classification","missing_source_classes":["项目方案偏离分类标准","方案偏离报告SOP"],"target":"12.4 方案偏离"},{"action":"确认是否设置紧急情况下方案偏离的例外处理程序（如受试者安全紧急需要时的偏离处理）","category":"source_missing","gap_id":"gap_deviation_urgent","missing_source_classes":["项目方案偏离SOP"],"target":"12.4 方案偏离"}],"heading":"方案偏离","missing_source_classes":["项目方案偏离分类标准","方案偏离报告时限与流程","伦理委员会报告SOP"],"proposal_text":"申办者将审查所有方案偏离，并评估是否存在严重违背药物临床试验质量管理规范（GCP）的情形，以及是否要求向卫生主管部门报告。根据申办者的要求或标准操作规程，偏离方案的前瞻性请求，包括放弃方案合格性标准的请求，将不被允许。本研究中，方案偏离指任何有意或无意地未遵循研究方案、GCP或相关法规要求的事件，包括但不限于：未满足入选或排除标准而随机入组、未按方案规定的访视时间窗完成评估、未按方案规定的剂量或给药频率使用研究药物、未按要求完成电子日记记录或实验室检查、违反洗脱期要求入组、以及合并使用方案禁止的药物等。方案偏离由研究中心在发现后及时记录于电子数据采集系统，并通知申办者监查员；申办者对偏离进行分级评估，区分重大方案偏离与非重大方案偏离。重大方案偏离是指可能影响受试者安全、权益或数据完整性的偏离，包括但不限于：严重违反知情同意程序、严重违反入选排除标准、严重违反给药方案、影响主要终点评估完整性的偏离等。重大方案偏离由申办者评估后决定是否向伦理委员会和卫生主管部门报告。符合方案集（PPS）的成员判定采用方案偏离排除条款：无重大方案偏离且完成关键评估的受试者纳入符合方案集，存在重大方案偏离者排除出符合方案集。","rationale":"公司语料（CMD-D001-AD II期方案12.2节）提供了'申办者审查所有方案偏离、评估GCP严重违背、不允许前瞻性偏离请求'的监管共性结构。项目研究定义确认了电子日记每日填写、评估窗口±3天、洗脱期要求、剂量方案（40mg每日两次）、FAS为主要分析集且PPS为敏感性分析集等事实，为偏离类型举例和PPS排除条款提供了项目级依据。但方案偏离的具体分类标准（重大/非重大判定细则）、报告时限、伦理委员会报告流程、以及本项目是否设置紧急偏离例外程序等实施细节缺少项目级来源，需医学经理确认。","review_advisories":["本节提及高影响设计信息（主要终点）；系统未把重复提及升级为强制确认。","本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_b4858ae428ff_778e87e7ead26c60","section_number":"12.4","source_ids":["protocol_full_draft_selection:e208a50ad861f7369bb289bf","current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]},{"ai_run_id":"airun_20261009171737_2d6ac006","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:12.4 管理结构|block:957|chunk:1","quote":"可使用IWRS进行参与者筛查和随机分组，以及研究药物申请和运输的管理。研究中心将负责生物样品在运输至申办者或其指定分析单位之前的保存。数据将使用eCRFs通过EDC系统记录，或以电子方式转发给申办者（例如，药代动力学数据）。","quote_sha256":"4cfe639a26124187ed661654b28a04c5759f3da872955ea4e8e4ba2608b51a01","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","span_id":"es_roles_iwrs_edc"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"多中心、随机、双盲、安慰剂平行对照II期发作预防研究；受试者1:1随机至KZ-HA501组或安慰剂组，治疗期12周","quote_sha256":"ee5b391a388afe4915e8d470fcc8143300bbb0ee9dcb487d0391933d87dd2a71","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es_study_design"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"DMC是否计划：是","quote_sha256":"9967a9a75297ced2326ab733fa3b16934acdef641fa765dd50c1cd58219f4aa5","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es_dmc_planned"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"安全性终点：TEAE发生率与严重程度（CTCAE 5.0）；生命体征、12导联心电图、临床实验室检查较基线变化；肝酶升高与qt间期延长的特别监测。","quote_sha256":"06515ac1078dcbcf7bd2f61558fc6fffce2a42041de93032bc15aa02cbcfb787","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es_safety_monitoring"}],"evidence_review_advisories":[],"evidence_span_ids":["es_roles_iwrs_edc","es_study_design","es_dmc_planned","es_safety_monitoring"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":3},"gap_items":[{"action":"确认本项目是否使用IWRS进行随机分组和药物管理，以及系统验证状态","category":"source_not_retrieved","gap_id":"gap_iwrs_confirmation","missing_source_classes":["IWRS系统确认文件","系统验证报告"],"target":"12.5 关键角色和研究管理"},{"action":"获取项目组织架构图及各角色（申办者、研究者、监查员、数据管理员、统计师、DMC成员等）的具体职责分工文件","category":"source_missing","gap_id":"gap_role_definitions","missing_source_classes":["项目组织架构与角色职责文件"],"target":"12.5 关键角色和研究管理"},{"action":"确认供应商管理范围（中心实验室、影像中心、电子日记供应商等）及供应商资质审核流程","category":"source_missing","gap_id":"gap_vendor_management","missing_source_classes":["供应商管理合同","供应商资质文件"],"target":"12.5 关键角色和研究管理"}],"heading":"关键角色和研究管理","missing_source_classes":["项目组织架构与角色职责文件","IWRS系统确认文件","供应商管理合同","统计团队独立性声明"],"proposal_text":"本研究的整体管理由申办者负责。申办者或其委托的临床试验机构执行项目管理、研究管理、监查、供应商管理和统计编程等职能。研究中心负责受试者的筛选、入组、治疗实施、安全性评估及数据记录。研究中心负责生物样品在运输至申办者或其指定分析单位之前的保存。研究数据通过电子数据采集系统记录，或以电子方式转发给申办者。本研究的随机分组和药物管理通过交互式网络应答系统实现，由不参与疗效评估的药师负责研究药物与安慰剂的发放以维持盲态。数据管理、统计编程和统计分析由申办者委托的独立统计团队完成。主要分析集为全分析集，符合方案集用于敏感性分析。安全性数据由申办者药物安全团队持续监测，数据监察委员会按计划对安全性数据进行审阅。","rationale":"公司语料（CMD-D001-AD II期方案12.4节）提供了'申办者或其代理人执行项目管理、研究管理、监查、供应商管理和统计编程'及'IWRS用于筛查随机和药物管理''EDC记录数据''研究中心负责生物样品保存'的监管共性结构。项目研究定义确认了DMC计划、FAS为主要分析集且PPS为敏感性分析集、由不参与评估的药师发放药物维持盲态、电子日记每日填写等事实。但本项目是否实际使用IWRS（项目定义未明确提及）、各角色的具体职责分工文件、供应商管理合同、统计团队独立性声明等实施细节缺少项目级来源，需医学经理确认。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_b4858ae428ff_5ff1a5559caf4228","section_number":"12.5","source_ids":["protocol_full_draft_selection:e208a50ad861f7369bb289bf","current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","company_corpus:cms_cn_protocol_corpus_20260715_v1:ec8b4a462fef49","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:371c2c1c6a800d","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b"]}],"source_bindings":[{"content_sha256":"b98bbf889ef7a6be1a73aeb0ca9ccd3bda8f7ebd88afbed439f683c8fcb16b59","locator":"document:mwdoc_greenfield_proj_user_b4858ae428ff_ba44e26131af2bef:full-draft:e208a50ad861f7369bb289bf","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:e208a50ad861f7369bb2