us_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:3152bfe8bf762f","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8"]},{"ai_run_id":"airun_20261009171248_1350343c","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"获取本项目临床试验责任险保单或保险条款，明确承保范围、免赔额及理赔程序","category":"source_missing","gap_id":"gap_ins_01","missing_source_classes":["临床试验保险保单","保险条款"],"target":"保险类型与承保范围"},{"action":"获取申办者与研究中心赔偿协议，明确受试者因研究相关伤害获得赔偿的申请路径、时限及争议解决机制","category":"source_missing","gap_id":"gap_ins_02","missing_source_classes":["赔偿协议","知情同意书中赔偿条款"],"target":"赔偿程序与责任划分"}],"heading":"保险与赔偿","missing_source_classes":["本项目临床试验保险保单或保险条款","申办者与研究中心赔偿协议","中国临床试验保险相关法规适用性说明"],"proposal_text":"","rationale":"保险与赔偿章节需要本项目专属的保险类型（如临床试验责任险）、赔偿范围、赔偿申请程序、责任划分及争议解决机制等来源。当前允许来源中无本项目保险条款、赔偿协议或相关法规适用性说明；公司语料中亦无对应保险条款可供结构参照。不得以通用原则或条件句替代项目已确认的保险与赔偿安排。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_b4858ae428ff_7c675c65eee27dd0","section_number":"11.5","source_ids":["protocol_full_draft_selection:dc1b14b8b70c5d5fc2d0eec0","current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:3152bfe8bf762f","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8"]},{"ai_run_id":"airun_20261009171248_1350343c","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:12.2 方案偏离|block:950|chunk:1","quote":"研究方案中规定的所有要求，必须严格执行。任何有意或无意偏离或违背研究方案和GCP原则的行为，均视为偏离方案或违背方案。监查员在监查过程中，如果发现偏离或违背方案，应由研究者或监查员填写偏离方案记录，详细记录事件发生的时间及过程、原因及相应的处理措施，由研究者签字，并根据研究中心相关规定通报伦理委员会及申办者。","quote_sha256":"5835023d355adeb7381fab0ec44d0b5dae2b454a729a4902b3cd66da6650dacc","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8","span_id":"es_mon_01"},{"locator":"section:12.2 方案偏离|block:950|chunk:1","quote":"当发生重大方案违背时，应由研究者和申办者进行评估。必要时，申办者可以提前终止本研究。","quote_sha256":"cb43263e1207068b84230afa2f47365dfe8f536ad703783b076e320022b824a0","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8","span_id":"es_comp_01"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"开发区域：中国","quote_sha256":"cff843d358ea50e7e53ede8d1eba9b9d23baa740d2cd2134679e6483c3e50b76","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es_proj_01"}],"evidence_review_advisories":[],"evidence_span_ids":["es_mon_01","es_comp_01","es_proj_01"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":1},"gap_items":[{"action":"获取本项目监查计划，明确各阶段监查频率、监查报告模板及问题跟踪机制","category":"source_not_retrieved","gap_id":"gap_mon_01","missing_source_classes":["监查计划","监查报告模板"],"target":"监查频率与监查报告格式"},{"action":"确认本项目是否安排独立稽查及稽查范围、频率","category":"source_not_retrieved","gap_id":"gap_mon_02","missing_source_classes":["稽查计划"],"target":"稽查安排"},{"action":"确认电子日记及电子数据采集所用平台是否满足21 CFR Part 11或中国电子数据管理要求","category":"source_not_retrieved","gap_id":"gap_mon_03","missing_source_classes":["电子数据管理计划","系统验证文件"],"target":"电子数据管理平台与数据完整性保障"}],"heading":"研究文件、监查和管理","missing_source_classes":["本项目监查计划","稽查计划","电子数据管理具体平台说明","文件保存期限协议"],"proposal_text":"本项目的研究文件管理、监查与稽查安排遵循《药物临床试验质量管理规范》及国家药品监督管理局相关指导原则的要求。申办者应指定监查员对各研究中心进行定期监查，监查内容包括受试者知情同意签署情况、电子日记数据的完整性与准确性、KZ-HA501及安慰剂的发放与回收记录、不良事件及严重不良事件的报告及时性、方案偏离的识别与记录，以及各访视（筛选V1、基线随机V2、治疗期第4/8/12周V3至V5、安全性随访V6）中实验室检查、12导联心电图和生命体征数据的采集与记录是否符合方案要求。监查员在监查过程中发现偏离或违背方案的情况，应由研究者或监查员填写方案偏离记录，详细记录事件发生的时间及过程、原因及相应处理措施，由研究者签字确认，并根据研究中心相关规定通报伦理委员会及申办者。所有可能严重违背方案的情况须立即报告申办者。当发生重大方案违背时，由研究者和申办者共同评估其对受试者安全及数据完整性的影响；必要时，申办者可提前终止本研究。各研究中心应保存完整的原始文件，包括知情同意书、电子日记原始数据、实验室检查报告、心电图记录、药物发放与回收记录、不良事件报告表及监查报告，保存期限和方式按申办者与研究中心协议执行。申办者保留在研究期间及研究结束后对研究中心进行稽查的权利，稽查范围涵盖数据真实性、方案依从性及文件完整性。","rationale":"监查与文件管理章节的监管共性结构参照公司语料中方案偏离记录与报告流程的写法，已适配本项目多中心设计、电子日记每日采集、V1至V6访视策略及安全性随访期等已确认事实。具体监查频率、监查报告模板、稽查计划及文件保存年限需按本项目监查计划及研究中心SOP确认。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_b4858ae428ff_c0ac617752639259","section_number":"12","source_ids":["protocol_full_draft_selection:dc1b14b8b70c5d5fc2d0eec0","current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20260715_v1:3152bfe8bf762f","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8"]},{"ai_run_id":"airun_20261009171248_1350343c","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"section:12.2 方案偏离|block:950|chunk:1","quote":"当发生重大方案违背时，应由研究者和申办者进行评估。必要时，申办者可以提前终止本研究。","quote_sha256":"cb43263e1207068b84230afa2f47365dfe8f536ad703783b076e320022b824a0","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8","span_id":"es_comp_01"},{"locator":"section:12.2 方案偏离|block:950|chunk:1","quote":"研究方案中规定的所有要求，必须严格执行。任何有意或无意偏离或违背研究方案和GCP原则的行为，均视为偏离方案或违背方案。监查员在监查过程中，如果发现偏离或违背方案，应由研究者或监查员填写偏离方案记录，详细记录事件发生的时间及过程、原因及相应的处理措施，由研究者签字，并根据研究中心相关规定通报伦理委员会及申办者。","quote_sha256":"5835023d355adeb7381fab0ec44d0b5dae2b454a729a4902b3cd66da6650dacc","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:f124dc45ec3cd8","span_id":"es_mon_01"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"开发区域：中国","quote_sha256":"cff843d358ea50e7e53ede8d1eba9b9d23baa740d2cd2134679e6483c3e50b76","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es_proj_01"}],"evidence_review_advisories":[],"evidence_span_ids":["es_comp_01","es_mon_01","es_proj_01"],"evidence_summary":{"corpus_spans":2,"project_fact_spans":1},"gap_items":[{"action":"确认各研究中心对方案偏离报告的具体时限要求及伦理委员会通报路径","category":"source_not_retrieved","gap_id":"gap_comp_01","missing_source_classes":["研究中心SOP","伦理委员会操作规范"],"target":"方案偏离报告时限"},{"action":"确认本项目对重大方案违背的具体判定标准及申办者评估流程","category":"source_not_retrieved","gap_id":"gap_comp_02","missing_source_classes":["方案偏离管理计划","申办者SOP"],"target":"重大方案违背的判定标准"}],"heading":"研究方案的依从","missing_source_classes":["各研究中心方案偏离报告SOP","伦理委员会偏离通报时限要求"],"proposal_text":"研究方案中规定的所有要求，研究者及研究中心工作人员必须严格执行。任何有意或无意偏离或违背研究方案和药物临床试验质量管理规范原则的行为，均视为方案偏离或方案违背。方案偏离包括但不限于：未按方案规定的访视时间窗（评估窗口正负3天）完成访视、未按方案要求完成电子日记每日填写或日记核查、未按方案规定的洗脱期（入组前28天内C1-INH预防治疗、达那唑、拉那珠单抗等须完成洗脱）即给予随机化给药、未按方案规定的剂量方案（KZ-HA501 40 mg每日两次，早晚各一次间隔约12小时）给药、漏服处理未按方案执行（漏服距下次服药不足6小时应跳过）、随机前24小时内发作未缓解满48小时即入组、以及未按方案要求记录急性发作救援治疗（艾替班特或伊卡替兰特）的使用情况。监查员在监查过程中发现方案偏离或违背方案时，应由研究者或监查员填写方案偏离记录，详细记录事件发生的时间及过程、原因及相应处理措施，由研究者签字，并根据研究中心相关规定通报伦理委员会及申办者。所有可能严重违背方案的情况须立即报告申办者。当发生重大方案违背时，由研究者和申办者共同评估其对受试者安全和研究数据完整性的影响；必要时，申办者可提前终止本研究。研究者应在首次获知方案偏离后及时记录并报告，不得延迟。","rationale":"方案依从章节的偏离定义与报告流程参照公司语料中监管共性结构，已适配本项目已确认的访视窗口（正负3天）、洗脱期（28天）、剂量方案（40 mg每日两次间隔约12小时）、漏服规则（距下次服药不足6小时跳过）、随机前发作缓解要求（24小时内发作需已缓解满48小时）及救援药物（艾替班特/伊卡替兰特）等具体事实。具体偏离报告时限、伦理通报路径及研究中心内部SOP需按各中心规定确认。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_b4858ae428ff_0406ad275d95a2f7","section_number":"12.1","source_ids":["protocol_full_draft_selection:dc1b14b8b70c5d5fc2d0eec0","current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","company_corpus:cms_cn_protocol_corpus_20260715_v1:665025df83658b","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67","company_corpus:cms_cn_protocol_corpus_20