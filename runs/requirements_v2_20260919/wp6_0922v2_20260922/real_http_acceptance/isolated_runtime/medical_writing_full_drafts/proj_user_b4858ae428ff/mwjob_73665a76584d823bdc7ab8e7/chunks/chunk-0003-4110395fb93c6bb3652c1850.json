ck:57|chunk:1","role":"company_sop_or_protocol_reference","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0","source_type":"company_protocol_reference_corpus","source_version":"abb423601f76d0","text_sha256":"288c4151aa03e0bb0feffeb19ae4b67d399ea214ab90d8f02d3dd67800bdd070"}]}