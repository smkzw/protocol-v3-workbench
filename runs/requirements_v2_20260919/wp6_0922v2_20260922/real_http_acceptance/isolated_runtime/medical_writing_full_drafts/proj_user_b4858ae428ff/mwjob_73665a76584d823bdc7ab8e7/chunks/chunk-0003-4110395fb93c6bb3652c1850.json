:r4:6c27867cac9764f5","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0"]},{"ai_run_id":"airun_20261009162126_bba077bf","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"多中心、随机、双盲、安慰剂平行对照II期发作预防研究；受试者1:1随机至KZ-HA501组或安慰剂组，治疗期12周，以第1-12周经 investigator 确认的HAE发作率为主要评价基础。","quote_sha256":"42cdbf14b140cc9d01ee9454bc53be4720be9b6521fca7e226061ba7b9fa8e6c","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es1"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"主要终点：第1-12周 investigator 确认的HAE发作率（次/月，经电子日记与研究者审核确认）；评价时间：治疗期全程（第1周至第12周），以12周为分析窗口；与安慰剂比较。","quote_sha256":"abe163a3126aa749ed01f3fe29b6f2a8ca17d846077a890cc10c761e7f5dd60e","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es4"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"研究时期：筛选期（≤21天）；双盲治疗期（12周）；安全性随访期（2周）","quote_sha256":"b917445cd74c1520405340b57a64c05ed3bf5a2a32344c9c6c15845a7bf0731a","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es7"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"分层因素为基线3个月内发作次数（1-3次 vs ≥4次）与是否12-17岁青少年；安慰剂外观与KZ-HA501一致，由不参与评估的药师发放维持盲态。","quote_sha256":"8abb1b304ddae989d4f13438af533de0353804bb96d90e0d53241a4a82c2eec5","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es8"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"主要估计目标采用治疗策略：无论是否使用急性发作救援治疗或恢复背景预防，均按随机分组分析第1-12周确认发作率；提前退出者发作数据按观察期归一化并采用负二项模型处理。","quote_sha256":"a36027d6ac0d7d379ba011cad61c3f87d43cc726ce0dea433ceca65720874a40","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es9"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"安全性终点：TEAE发生率与严重程度（CTCAE 5.0）；生命体征、12导联心电图、临床实验室检查较基线变化；肝酶升高与qt间期延长的特别监测。","quote_sha256":"06515ac1078dcbcf7bd2f61558fc6fffce2a42041de93032bc15aa02cbcfb787","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es10"},{"locator":"document:mwdoc_greenfield_proj_user_b4858ae428ff_ba44e26131af2bef:full-draft:4110395fb93c6bb3652c1850","quote":"随机化；双盲；安慰剂对照；平行组；多中心；设置独立数据监查委员会（DMC）","quote_sha256":"6450935204c952de9a1386cd7302806bc0614ad879abfc9cd9bee935286169c3","source_id":"protocol_full_draft_selection:4110395fb93c6bb3652c1850","span_id":"es12"}],"evidence_review_advisories":[],"evidence_span_ids":["es1","es4","es7","es8","es9","es10","es12"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":6},"gap_items":[],"heading":"研究设计","missing_source_classes":[],"proposal_text":"本研究为多中心、随机、双盲、安慰剂平行对照的II期发作预防研究，旨在评价口服选择性缓激肽B2受体拮抗剂KZ-HA501薄膜衣片在遗传性血管性水肿（HAE）I/II型患者中预防发作的有效性与安全性。符合入选标准的受试者按1:1比例随机分配至KZ-HA501组（40 mg口服每日两次）或安慰剂组，随机化采用分层区组方法，分层因素为基线3个月内HAE发作次数（1至3次与4次及以上）以及是否为12至17岁青少年。双盲治疗期共12周，治疗期结束后进入2周安全性随访期。研究全程设置独立数据监查委员会（DMC）对安全性数据进行定期审阅。本研究不采用自适应设计，不计划期中分析，不设置安全审查委员会（SRC）。主要疗效评价以第1至第12周经研究者确认的HAE发作率（次/月）为基础，与安慰剂组进行比较；关键次要终点包括至首次发作的时间、需要急性治疗的发作率、每周血管性水肿相关疼痛NRS评分较基线变化以及12周内中重度发作占比。安全性评价涵盖治疗期出现的不良事件发生率与严重程度（按CTCAE 5.0分级）、生命体征、12导联心电图及临床实验室检查较基线变化，并对肝功能异常（ALT或AST超过3倍正常值上限伴胆红素升高）、QTcF超过500毫秒或较基线延长超过60毫秒以及严重过敏或超敏反应进行特别监测。主要估计目标采用治疗策略，即无论受试者是否使用急性发作救援治疗或恢复背景预防用药，均按随机分组进行分析；提前退出者的发作数据按实际观察期归一化后纳入负二项模型处理。","rationale":"本段正文依据项目研究定义中已确认的总体设计要素（多中心、随机、双盲、安慰剂平行对照、1:1分配、12周治疗期、分层因素、DMC设置、无自适应/无期中分析/无SRC）、主要与关键次要终点定义、安全性终点与特别关注不良事件、估计目标策略及研究时期划分。医学经理需核实：（1）分层因素中青少年亚组的定义是否需进一步限定为12至17岁且体重≥40 kg；（2）DMC审阅频率与触发标准是否在本章或独立DMC章程中另行规定；（3）治疗策略估计目标中提前退出者归一化方法是否需在统计分析计划中进一步细化。","review_advisories":["本节复述高影响研究设计（研究设计）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（估计目标、期中分析）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_b4858ae428ff_bd58d4510adb5100","section_number":"4","source_ids":["protocol_full_draft_selection:4110395fb93c6bb3652c1850","current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0"]},{"ai_run_id":"airun_20261009162126_bba077bf","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"多中心、随机、双盲、安慰剂平行对照II期发作预防研究；受试者1:1随机至KZ-HA501组或安慰剂组，治疗期12周，以第1-12周经 investigator 确认的HAE发作率为主要评价基础。","quote_sha256":"42cdbf14b140cc9d01ee9454bc53be4720be9b6521fca7e226061ba7b9fa8e6c","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es1"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"筛选（V1）、基线随机（V2）、治疗期第4/8/12周（V3-V5，含发作日记核查与实验室）、安全性随访（V6）；电子日记每日填写，评估窗口±3天。","quote_sha256":"416c6f4f95926560954e1889bf67d561c153c22fd01f268c905128fb494f5cfd","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es3"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"研究时期：筛选期（≤21天）；双盲治疗期（12周）；安全性随访期（2周）","quote_sha256":"b917445cd74c1520405340b57a64c05ed3bf5a2a32344c9c6c15845a7bf0731a","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es7"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"分层因素为基线3个月内发作次数（1-3次 vs ≥4次）与是否12-17岁青少年；安慰剂外观与KZ-HA501一致，由不参与评估的药师发放维持盲态。","quote_sha256":"8abb1b304ddae989d4f13438af533de0353804bb96d90e0d53241a4a82c2eec5","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es8"},{"locator":"document:mwdoc_greenfield_proj_user_b4858ae428ff_ba44e26131af2bef:full-draft:4110395fb93c6bb3652c1850","quote":"随机化；双盲；安慰剂对照；平行组；多中心；设置独立数据监查委员会（DMC）","quote_sha256":"6450935204c952de9a1386cd7302806bc0614ad879abfc9cd9bee935286169c3","source_id":"protocol_full_draft_selection:4110395fb93c6bb3652c1850","span_id":"es12"}],"evidence_review_advisories":[],"evidence_span_ids":["es1","es3","es7","es8","es12"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"gap_items":[],"heading":"总体设计","missing_source_classes":[],"proposal_text":"本研究采用多中心、随机、双盲、安慰剂平行对照设计，共设两个治疗组：KZ-HA501组与安慰剂组，受试者按1:1比例随机分配。随机化采用分层区组方法，分层因素为基线3个月内HAE发作次数（1至3次与4次及以上）以及是否为12至17岁青少年。双盲维持方式为：安慰剂在外观、气味及包装上与KZ-HA501薄膜衣片完全一致，由不参与疗效评估的药师负责发放与记录，受试者、研究者及疗效评价人员均不知晓分组信息。研究时期划分为三个阶段：筛选期不超过21天，双盲治疗期12周，安全性随访期2周。访视安排如下：V1为筛选访视，V2为基线随机访视，V3至V5分别位于治疗期第4周、第8周和第12周（含发作日记核查与实验室检查），V6为安全性随访访视。电子日记由受试者每日填写，评估窗口为计划访视日前后各3天。研究设置独立数据监查委员会（DMC），对累积安全性数据进行定期审阅，但不进行期中疗效分析，不采用自适应设计，不设置安全审查委员会（SRC）。","rationale":"本段正文依据项目研究定义中已确认的分配模型（平行组、1:1）、盲法维持方式（安慰剂外观一致、由不参与评估的药师发放）、研究时期划分（筛选≤21天、治疗12周、随访2周）、访视策略（V1至V6及评估窗口±3天）以及DMC/无自适应/无期中分析/无SRC的确认信息。医学经理需核实：（1）各访视具体检查项目清单（如V3至V5是否均包含12导联心电图与全套实验室检查）需与访视流程图对齐；（2）电子日记评估窗口±3天是否适用于所有访视还是仅适用于特定访视；（3）DMC审阅频率与提前终止标准是否在本章或独立章程中规定。","review_advisories":["本节复述高影响研究设计（总体设计）；请在合并设计摘要中统一核对。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_b4858ae428ff_22d07296f37d4683","section_number":"4.1","source_ids":["protocol_full_draft_selection:4110395fb93c6bb3652c1850","current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0"]},{"ai_run_id":"airun_20261009162126_bba077bf","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"KZ-HA501（口服选择性缓激肽B2受体拮抗剂薄膜衣片）：KZ-HA501 40 mg 口服每日两次（早晚各一次，间隔约12小时），连续12周；漏服距下次服药<6小时则跳过；剂量出处：内部IB v3.1 §5.2（立项剂量方案）。","quote_sha256":"b0549a2e4c64fd071f996ac7a5584ceae186df90ffb77d5f1c81143e7e2aff0d","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es2"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"内在研究目的：首次患者试验（first-in-patient）；药理/药效探索；概念验证（PoC）；剂量探索","quote_sha256":"9446f688f9a59b8b0a2b67d283cbeebbe441b61cfbcc1bbce6aac72d65128458","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es11"}],"evidence_review_advisories":[],"evidence_span_ids":["es2","es11"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":2},"gap_items":[{"action":"检索并提取内部IB v3.1 §5.2中支持40 mg BID剂量的非临床暴露-效应关系、受体占有率、安全窗及既往人体数据","category":"source_not_retrieved","gap_id":"gap_4_2_1_ib_content","missing_source_classes":["非临床药理学与毒理学数据","药代动力学/药效学建模数据"],"target":"4.2.1 剂量选择依据"}],"heading":"剂量选择依据","missing_source_classes":["非临床药理学与毒理学数据（IB v3.1 §5.2具体内容）","既往人体安全性数据（如有）","药代动力学/药效学建模数据"],"proposal_text":"本研究KZ-HA501的推荐剂量为40 mg口服每日两次（早晚各一次，间隔约12小时），连续给药12周。该剂量方案依据内部研究者手册（IB）v3.1第5.2节推荐的剂量方案设定，属于本项目立项阶段确定的剂量探索方案。KZ-HA501为口服选择性缓激肽B2受体拮抗剂薄膜衣片，属小分子化合物，经口服给药后产生全身性暴露。给药方案中规定：若漏服距下次计划服药时间不足6小时，则跳过本次漏服剂量，按原计划时间服用下一次剂量，不得加倍补服。安慰剂组接受与KZ-HA501外观一致的安慰剂片，给药频率与疗程相同。急性发作救援治疗（艾替班特或伊卡替兰特）在研究期间允许按需使用并须记录，但随机化前24小时内发生的发作须已缓解至少48小时方可进入随机化。本研究为首次人体试验（first-in-patient），剂量选择同时服务于概念验证与剂量探索目的；40 mg每日两次为本次II期研究拟评价的唯一活性剂量，未设置多个活性剂量组。","rationale":"本段正文依据项目研究定义中已确认的剂量方案（40 mg BID、间隔约12小时、12周）、剂量出处（内部IB v3.1 §5.2）、漏服规则、药物技术类型（small_molecule、口服、全身暴露）、急性救援药物允许使用规则以及首次人体试验与剂量探索的内在研究目的。医学经理需核实：（1）IB v3.1 §5.2中支持40 mg BID的非临床毒理学暴露量、受体占有率数据及既往人体安全性数据的具体内容，以便在本章补充剂量选择的药理学依据；（2）是否需在正文中引用IB版本号以外的非临床文献或既往研究数据；（3）漏服规则中6小时阈值的药代动力学依据是否需在正文中说明。","review_advisories":["本节复述高影响研究设计（剂量选择依据）；请在合并设计摘要中统一核对。","本节提及高影响设计信息（剂量选择）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_b4858ae428ff_f94392e5371d3b01","section_number":"4.2.1","source_ids":["protocol_full_draft_selection:4110395fb93c6bb3652c1850","current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","company_corpus:cms_cn_protocol_corpus_20260715_v1:46d82ed9e2e3ef","company_corpus:cms_cn_protocol_corpus_20260715_v1:3809927f2ae07b","company_corpus:cms_cn_protocol_corpus_20260715_v1:0f7f6cabfa781e","company_corpus:cms_cn_protocol_corpus_20260715_v1:a5f4a227d6404a","company_corpus:cms_cn_protocol_corpus_20260715_v1:abb423601f76d0"]}],"source_bindings":[{"content_sha256":"3116a11afdf24243874dca0152b80808b321fef8a049b3a66593b623469fe934","locator":"document:mwdoc_greenfield_proj_user_b4858ae428ff_ba44e26131af2bef:full-draft:4110395fb93c6bb3652c1850","role":"current_working_draft_packet","source_id":"protocol_full_draft_selection:4110395fb93c6bb3652c1850","source_type":"protocol_full_draft_selection","source_version":"full-draft:3ffd7d1e98990c139aa2d6cbabe6e9a477954c19ec7cf663f4e63eb18dca0f45:4110395fb93c6bb3652c1850","text_sha256":"3116a11afdf24243874dca0152b80808b321fef8a049b3a66593b623469fe934"},{"content_sha256":"1ccc46e2501752c77ea7f706de0b7d5cf123985689cad4de02d210504a1bf602","locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","role":"confirmed_project_facts","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","source_type":"c