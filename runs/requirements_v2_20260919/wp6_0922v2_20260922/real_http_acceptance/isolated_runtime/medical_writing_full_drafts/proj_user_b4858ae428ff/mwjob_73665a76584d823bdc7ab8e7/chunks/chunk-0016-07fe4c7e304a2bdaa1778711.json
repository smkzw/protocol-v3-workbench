e4c7e304a2bdaa1778711","current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","company_corpus:cms_cn_protocol_corpus_20260715_v1:20561fabeffbb0","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","company_corpus:cms_cn_protocol_corpus_20260715_v1:256bd99fe3c436","company_corpus:cms_cn_protocol_corpus_20260715_v1:df51ff33eb77d6"]},{"ai_run_id":"airun_20261009170231_eb806209","content_status":"partial","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"访视策略：筛选（V1）、基线随机（V2）、治疗期第4/8/12周（V3-V5，含发作日记核查与实验室）、安全性随访（V6）；电子日记每日填写，评估窗口±3天。","quote_sha256":"a06c5bfb727d2eed775fcc2c9358264207fc26fc370ac17d2f189dcf4286c897","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es_visit_strategy"},{"locator":"study_definition:mwdefinition_fb006498b840cdaaa8e2:revision:4","quote":"研究时期：筛选期（≤21天）；双盲治疗期（12周）；安全性随访期（2周）","quote_sha256":"b917445cd74c1520405340b57a64c05ed3bf5a2a32344c9c6c15845a7bf0731a","source_id":"current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","span_id":"es_study_periods"},{"locator":"section:7.3.7 严重不良事件一致性比对|block:1049|chunk:1","quote":"EDC 中 SAE 关键数据点应与安全性数据库进行一致性比对。","quote_sha256":"89137f59a7a4b6b574df06af2472181735de0125de055f6939636b33ffcf7e2c","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:df51ff33eb77d6","span_id":"es_edc_sae"},{"locator":"section:8 统计学考虑|block:1056|chunk:1","quote":"有效性评价、安全性评价、PK 评价、PD 评价、免疫原性评价以及其他分析将在本研究的统计分析计划（SAP）中详细规定，数据库锁定前将最终确定 SAP。","quote_sha256":"a635fe9c51c78cbc66090c3553c488cd453e807e61608a97e0767740d5088a03","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","span_id":"es_sap_timing"},{"locator":"section:14 附录 100|block:198|chunk:1","quote":"本研究将符合ICH E2A指导原则（临床安全性数据管理：加速报告的定义和标准）。","quote_sha256":"9908eb4a8fed928d8aa7d67e712c4e13f7bc64dc32e6e258fe166d44632170ba","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:20561fabeffbb0","span_id":"es_e2a"}],"evidence_review_advisories":[],"evidence_span_ids":["es_visit_strategy","es_study_periods","es_edc_sae","es_sap_timing","es_e2a"],"evidence_summary":{"corpus_spans":3,"project_fact_spans":2},"gap_items":[{"action":"确认本项目使用的EDC系统名称、版本及配置，补充数据管理计划","category":"source_missing","gap_id":"gap_edc_system","missing_source_classes":["数据管理计划","EDC系统验证文件"],"target":"数据采集与管理-EDC系统"},{"action":"确认数据清理频率、质疑关闭时限、数据库锁定程序及解锁条件","category":"source_missing","gap_id":"gap_data_cleaning","missing_source_classes":["数据管理计划","数据管理SOP"],"target":"数据采集与管理-数据清理与锁定"},{"action":"确认源数据验证策略（100% SDV或基于风险的SDV）及监查频率","category":"source_missing","gap_id":"gap_sdv","missing_source_classes":["监查计划","数据管理计划"],"target":"数据采集与管理-源数据验证"}],"heading":"数据采集与管理","missing_source_classes":["项目数据管理计划","EDC系统规格与配置说明","数据核查与清理SOP","源数据验证策略"],"proposal_text":"本研究采用电子数据采集系统进行临床数据的录入、核查与管理。数据采集范围覆盖筛选期（不超过21天）、双盲治疗期（12周）及安全性随访期（2周）的全部访视数据，包括筛选（V1）、基线随机（V2）、治疗期第4周（V3）、第8周（V4）、第12周（V5）及安全性随访（V6）各访视中采集的人口学、病史、合并用药、HAE发作日记核查、生命体征、12导联心电图、临床实验室检查、不良事件及研究药物给药记录。受试者每日通过电子日记记录HAE发作事件，评估窗口为计划访视前后各3天。电子数据采集系统中严重不良事件的关键数据点应与安全性数据库进行一致性比对，确保两处记录在事件名称、严重程度、因果关系判定及转归等字段上保持一致。数据管理活动包括数据录入、逻辑核查、质疑管理、数据清理及数据库锁定；统计分析计划于数据库锁定前最终确定。本研究的数据管理遵循ICH E6及我国药物临床试验质量管理规范的要求。","rationale":"访视结构（V1-V6）、研究时期（筛选≤21天、治疗12周、随访2周）、电子日记每日填写及评估窗口±3天来源于当前项目已确认研究事实；EDC中SAE一致性比对要求来源于公司共享语料，仅作为数据管理结构参照；SAP锁定前确定及ICH E6合规来源于公司共享语料。EDC系统具体名称、数据核查频率、源数据验证策略、数据清理时间表及数据库锁定程序未在允许来源中提供，需项目数据管理计划补充。","review_advisories":["本节引用公司语料形成共性表述；定稿时请用本项目权威文件复核适用性。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_b4858ae428ff_ca4a34665d7cd543","section_number":"10","source_ids":["protocol_full_draft_selection:07fe4c7e304a2bdaa1778711","current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","company_corpus:cms_cn_protocol_corpus_20260715_v1:20561fabeffbb0","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","company_corpus:cms_cn_protocol_corpus_20260715_v1:256bd99fe3c436","company_corpus:cms_cn_protocol_corpus_20260715_v1:df51ff33eb77d6"]},{"ai_run_id":"airun_20261009170231_eb806209","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_review_advisories":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"gap_items":[{"action":"由数据管理部门提供本项目CRF设计文件，明确电子/纸质形式、字段清单及各访视采集项目","category":"source_missing","gap_id":"gap_crf_design","missing_source_classes":["CRF设计文件","数据管理计划"],"target":"病例报告表-整体设计"},{"action":"确认CRF完成时限（如访视后多少天内完成录入）、监查核查方式及质疑管理流程","category":"source_missing","gap_id":"gap_crf_completion","missing_source_classes":["监查计划","数据管理SOP"],"target":"病例报告表-完成时限与核查"}],"heading":"病例报告表","missing_source_classes":["病例报告表设计文件","数据管理计划","访视操作手册","CRF填写指南"],"proposal_text":"","rationale":"当前允许来源中未提供本项目病例报告表的具体设计信息，包括CRF形式（电子或纸质）、字段清单、各访视需记录的评估项目明细、CRF完成时限、监查员核查方式及CRF与源文件对应关系。公司共享语料中关于AE记录规则及EDC一致性比对仅为通用结构参照，不构成本项目CRF设计的来源。在缺少CRF设计文件、数据管理计划及访视操作手册的情况下，无法形成有实质信息的CRF章节正文。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_b4858ae428ff_c9b91b6b11592ea4","section_number":"10.1","source_ids":["protocol_full_draft_selection:07fe4c7e304a2bdaa1778711","current_project_study_definition:mwdefinition_fb006498b840cdaaa8e2:r4:6c27867cac9764f5","company_corpus:cms_cn_protocol_corpus_20260715_v1:20561fabeffbb0","company_corpus:cms_cn_protocol_corpus_20260715_v1:04ac0381ef4b49","company_corpus:cms_cn_protocol_corpus_20260715_v1:a3cf98aab983c7","company_corpus:cms_cn_protocol_corpus_20260715_v1:256bd99fe3c436","company_corpus:cms_cn_protocol_corpus_20260715_v1:df51ff33eb77d6"]}],"source_bindings":[{"content_sha256":"91fd6e78e9b941d927135aa86c80706938988126d98f5f222966cf36a5b5e776","locator":"document:mwdoc_greenfield_proj_