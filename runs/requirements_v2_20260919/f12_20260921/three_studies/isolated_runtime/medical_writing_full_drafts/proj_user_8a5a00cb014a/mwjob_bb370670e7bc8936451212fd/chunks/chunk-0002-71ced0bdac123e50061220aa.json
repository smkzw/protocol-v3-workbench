airun_20260922052056_c3aa4a4c","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:71ced0bdac123e50061220aa","quote":"SECTION_ID=mwsec_greenfield_proj_user_8a5a00cb014a_650a3ed48fbc8ff8\n章节编号=2.4\n章节标题=本研究的理论基础\n章节类型=section\n当前正文=确证性研究","quote_sha256":"f1c0d8ce634235ab59d1baddc2168c38e330d7f154ca33c19bc93417a0dd3687","source_id":"protocol_full_draft_selection:71ced0bdac123e50061220aa","span_id":"span_sel_24"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究题目：合成试验药A用于治疗成人中重度斑块状银屑病的III期临床研究","quote_sha256":"39f86855784611b541acfcdc9bde1954b606955366139902ea030dd2587d715e","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_sd_title"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究分期：III期\n开发区域：中国\n内在研究目的：确证性研究","quote_sha256":"90beed36d92a466e3479b43c777a7fe39351a15faa72f5164361cf3a0b937352","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_sd_phase"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究人群概述：确诊为斑块状银屑病、疾病严重程度为中重度的成人受试者。","quote_sha256":"a8e79e0e0422cd44b88dc3e21e985b80d8a582156f8af354719235edcd236224","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_sd_population"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"入选标准模块：年龄≥18岁；确诊斑块状银屑病≥6个月；筛选及基线时PASI≥12、受累体表面积≥10%、sPGA≥3；适合接受系统治疗或光疗。","quote_sha256":"3e9ca06af65f6aeb7e28df97f2a93f40d8966553fa5faff3f806e43f762999dd","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_sd_inclusion"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"总体研究设计：平行组（parallel assignment）、双盲、安慰剂对照、随机","quote_sha256":"671a62a354113705569b311f82cdff13e6dc35ab5faac84b8993f18ac7fe7ebc","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_sd_design"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"中心模式：多中心","quote_sha256":"2cfa68bc992967c797bbd3113b5e0d0844d660a2050095a31f08358c5e40311f","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_sd_center"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"对照：匹配安慰剂对照；试验组与安慰剂组按1:1随机分配，双盲治疗16周。","quote_sha256":"bcf69f1343deaa3b4cd6b8ab0fd4fbac84bf974c3118292b17999b1ba93aa172","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_sd_blinding"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"主要研究目的：评价合成试验药A相较安慰剂治疗成人中重度斑块状银屑病的疗效。","quote_sha256":"91f9668c833c01c737e00948c18613521366f596752872eef9fc69a09e681b8f","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_sd_primary_obj"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"次要研究目的：评价合成试验药A对皮损清除程度及皮肤病相关生活质量的影响。","quote_sha256":"f60b7980df919c77b6b4674e5a8a1013c4753590e096ca6566a70adbd1e9b6e4","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_sd_secondary_obj"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"主要终点：第16周达到PASI 75应答（较基线PASI评分改善≥75%）的受试者比例。","quote_sha256":"0726a50bb0c8f1c5ec79b9e21b343bfd08fddc0a595315a5c8e3769df01ce9a7","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_sd_primary_ep"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"关键次要终点：第16周sPGA达到0或1且较基线改善≥2级的受试者比例。；第16周达到PASI 90应答的受试者比例。","quote_sha256":"9ebc192fbc05715cf7f717f7f5899cd368f8790a1c880b7a2bff3665ad9ac302","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_sd_key_sec_ep"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"其他次要终点：第16周PASI评分较基线的变化。；第16周DLQI评分较基线的变化。","quote_sha256":"1f739c14310a6a5f292991854360290460a4b501e71c36ec724647d8123a4023","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_sd_other_sec_ep"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"样本量策略：假设第16周PASI 75应答率试验组为60%、安慰剂组为30%，双侧α=0.05、把握度90%、1:1随机，并考虑15%脱落，共计划入组132例（每组66例）。","quote_sha256":"2088842f2548655845b43f017bb904dc2663a94d1a5c7a802e7adf8daa68b0d2","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_sd_sample"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"统计分析策略：全分析集按随机分组采用CMH方法比较主要终点，报告应答率差、95%置信区间和P值，以优效性为目标。主要缺失处理采用无应答填补，并以多重插补和观察病例分析进行敏感性分析；安全性集按实际治疗分析。不开展期中分析。","quote_sha256":"ccd7b348358b71793f3761994bf0e928e73abcd319f577b74f5285d5c99e3b7c","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_sd_analysis"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"样本量再估计是否计划：否\n期中分析是否计划：否","quote_sha256":"3deb9bac879bd9b7640c483aa2f9818610b5e6e19c4e8c1bbbc26a05016a1863","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_sd_no_interim"}],"evidence_span_ids":["span_sel_24","span_sd_title","span_sd_phase","span_sd_population","span_sd_inclusion","span_sd_design","span_sd_center","span_sd_blinding","span_sd_primary_obj","span_sd_secondary_obj","span_sd_primary_ep","span_sd_key_sec_ep","span_sd_other_sec_ep","span_sd_sample","span_sd_analysis","span_sd_no_interim"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":15},"heading":"本研究的理论基础","missing_source_classes":[],"proposal_text":"本研究为确证性III期临床研究，目标人群为确诊为斑块状银屑病、疾病严重程度为中重度的成人受试者，年龄≥18岁。研究采用多中心、随机、双盲、安慰剂对照的平行组设计，受试者按1:1随机分配接受合成试验药A或匹配安慰剂，双盲治疗16周，主要及关键次要疗效终点均在第16周评价，以在控制偏倚的条件下支持对疗效的确证性评价。主要研究目的为评价合成试验药A相较安慰剂治疗成人中重度斑块状银屑病的疗效，与之对应，主要终点为第16周达到PASI 75应答（较基线PASI评分改善≥75%）的受试者比例；关键次要终点为第16周sPGA达到0或1且较基线改善≥2级的受试者比例以及第16周达到PASI 90应答的受试者比例，用于评价皮损清除程度；其他次要终点为第16周PASI评分较基线的变化和第16周DLQI评分较基线的变化，用于评价皮损改善及皮肤病相关生活质量的影响。样本量基于第16周PASI 75应答率试验组60%、安慰剂组30%，双侧α=0.05、把握度90%、1:1随机，并考虑15%脱落进行估计，计划入组132例（每组66例），以支持主要终点的优效性检验。本研究不计划期中分析，也不计划样本量再估计；主要分析在全分析集中按随机分组采用CMH方法比较主要终点，报告应答率差、95%置信区间和P值，缺失数据采用无应答填补，并以多重插补和观察病例分析进行敏感性分析。","rationale":"正文依据已确认研究事实：确证性III期研究、成人中重度斑块状银屑病目标人群、多中心随机双盲安慰剂对照平行组设计、1:1随机、双盲治疗16周；主要终点（第16周PASI 75应答比例）与主要研究目的对应，关键次要终点（第16周sPGA达到0或1且较基线改善≥2级、第16周PASI 90应答）与其他次要终点（第16周PASI评分、DLQI评分较基线变化）对应次要研究目的；样本量基于第16周PASI 75应答率60%对30%、双侧α=0.05、把握度90%、1:1随机及15%脱落的假设，计划入组132例（每组66例）；不计划期中分析与样本量再估计；主要分析在全分析集中采用CMH方法、以优效性为目标并采用无应答填补及敏感性分析。医学作者需核对疗效假设的效应量依据、终点选择与相关监管沟通情况，并确认本章是否需补充疾病背景、药物作用机制及非临床与既往临床资料；现有可用证据未包含该类来源。","review_advisories":["本节提及高影响设计信息（α、主要终点、期中分析、样本量、计划入组）；系统未把重复提及升级为强制确认。","本节重复了多项总体设计事实；建议压缩为与本节直接相关的信息。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_650a3ed48fbc8ff8","section_number":"2.4","source_ids":["protocol_full_draft_selection:71ced0bdac123e50061220aa","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","company_corpus:cms_cn_protocol_corpus_20260715_v1:367cbc36976ba5","company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","company_corpus:cms_cn_protocol_corpus_20260715_v1:d84680fc442c0c"]}],"source_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:71ced0bdac123e50061220aa","source_id":"protocol_full_draft_selection:71ced0bdac123e50061220aa","source_type":"protocol_full_draft_selection","text_sha256":"97d014fb8606cbd66b6b61b1c6d22e1f2f4a827bd24db42d4a3e3d23092232ae"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","source_type":"current_project_study_definition","text_sha256":"787313a6f081b1c9afdf03800feb1c50c317aa4aa4f0c3884e924b0594e666da"},{"locator":"section:3.6.3.3 研究药物的计数|block:620|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:b5cb8043e0359e","source_type":"company_protocol_reference_corpus","text_sha256":"5d7954edffb46be99638e2135e77631b0c5d64bf28fd8aeb9376a387c2a93b8f"},{"locator":"section:文档开头|block:26|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:63ce4061f946ca","source_type":"company_protocol_reference_corpus","text_sha256":"33118fc6958419e645c6a0a19471c78f80e0c4c28be03b46f2b3e61d287e0305"},{"locator":"section:独立数据监查委员会|block:792|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:367cbc36976ba5","source_type":"company_protocol_reference_corpus","text_sha256":"26824e050825b072ae0a7dd2eee48a5657c0d43ba2c463b531efc0feabf1a014"},{"locator":"section:文档开头|block:25|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:7252de902642cb","source_type":"company_protocol_reference_corpus","text_sha256":"68663fd612a1770f44cc3c20e025cf77d568a22b8c10c9a906d5ceb40702d87e"},{"locator":"section:11.4 研究数据记录|block:1218|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:d84680fc442c0c","source_type":"company_protocol_reference_corpus","text_sha256":"f7aafa4178dd21690460dacca369e7f10ae2fcf13e0a791098b68b6758b2984d"}]}