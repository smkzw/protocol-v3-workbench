nt_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]},{"ai_run_id":"airun_20260922053355_1c139975","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:39d211847f2495c61efec199","quote":"SECTION_ID=mwsec_greenfield_proj_user_8a5a00cb014a_3edc6ed0268a0557\n章节编号=6.5\n章节标题=研究治疗依从性\n章节类型=section\n当前正文=（当前为空，需生成实质正文）","quote_sha256":"cffc86387e26b123b16fddf2bb5111f83fdb540d4a3ceec9ece76068e1e74874","source_id":"protocol_full_draft_selection:39d211847f2495c61efec199","span_id":"span_sec_65"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"试验干预：试验组接受合成试验药A 100 mg口服，每日一次，连续16周；对照组接受匹配安慰剂。","quote_sha256":"f3eff5ef57b4691ff025db695140e4ead682562786c0dec621edcd256ef28af3","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_dosing"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"剂量与给药方案：合成试验药A：100 mg，每日一次（QD）（口服）；第1天至第16周。依从：通过药品计数及受试者日记评价依从性\n匹配安慰剂：每日一次（QD）（口服）；第1天至第16周双盲治疗期。依从：通过药品计数及受试者日记评价依从性","quote_sha256":"94fb65afc774da062ed601e6f161a821a0ac0ae3a448c3184db20ac0caba0782","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_dose_adherence"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究时期：筛选期：最长4周。；双盲治疗期：16周。；安全性随访期：4周。","quote_sha256":"1df9f3c36a7060d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_study_period"}],"evidence_span_ids":["span_sec_65","span_dosing","span_dose_adherence","span_study_period"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":3},"heading":"研究治疗依从性","missing_source_classes":[],"proposal_text":"本研究双盲治疗期为16周，试验组受试者接受合成试验药A 100 mg口服、每日一次，对照组受试者接受匹配安慰剂口服、每日一次，给药自第1天持续至第16周。研究治疗依从性通过药品计数及受试者日记评价，试验组与对照组均采用该评价方式。依从性评价覆盖双盲治疗期，用于反映受试者对研究治疗的执行情况，并为描述研究治疗暴露提供依据。","rationale":"已确认事实支持试验药和安慰剂的给药方案、双盲治疗期16周以及通过药品计数和受试者日记评价依从性。依从性阈值、未依从的处理、日记与药品计数的具体记录方式仍需医学作者核对。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_3edc6ed0268a0557","section_number":"6.5","source_ids":["protocol_full_draft_selection:39d211847f2495c61efec199","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]},{"ai_run_id":"airun_20260922053355_1c139975","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"heading":"合并用药/治疗","missing_source_classes":["合并用药与禁止用药的项目规定","救援治疗定义与启用条件","背景治疗及洗脱规则","合并用药记录与管理要求"],"proposal_text":"","rationale":"已确认研究事实包含停药或使用救援治疗按复合策略判定为无应答，以及入选人群适合接受系统治疗或光疗、排除活动性严重感染及妊娠或哺乳期；但未提供合并用药/治疗的允许与禁止范围、救援治疗定义、背景治疗或洗脱规则，需医学作者依据对应项目文件核对后补充。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_f2862d79759a5299","section_number":"6.6","source_ids":["protocol_full_draft_selection:39d211847f2495c61efec199","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]}],"source_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:39d211847f2495c61efec199","source_id":"protocol_full_draft_selection:39d211847f2495c61efec199","source_type":"protocol_full_draft_selection","text_sha256":"e800064dc1ffdae25304180895952d64bb2b88c2233db9c95a9842d184fedb1c"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","source_type":"current_project_study_definition","text_sha256":"787313a6f081b1c9afdf03800feb1c50c317aa4aa4f0c3884e924b0594e666da"}]}