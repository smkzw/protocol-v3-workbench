rent_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_003"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究时期：筛选期：最长4周。；双盲治疗期：16周。；安全性随访期：4周。","quote_sha256":"1df9f3c36a7060d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_004"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"安全性集按实际治疗分析。","quote_sha256":"1268001c52aab5587c60c4485ee589055e72f4636f7ca620998567b780d17001","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_006"}],"evidence_span_ids":["span_001","span_003","span_004","span_006"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"heading":"安全性评价","missing_source_classes":[],"proposal_text":"本研究的安全性评价涵盖治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件的发生率，以及实验室检查、生命体征及12导联心电图具有临床意义的变化。上述安全性终点用于评价合成试验药A在成人中重度斑块状银屑病患者中的安全性。双盲治疗期为16周，安全性随访期为4周。安全性分析采用安全性集，按受试者实际接受的治疗进行分组。","rationale":"支持依据为已确认的目标人群、安全性终点、双盲治疗期16周与安全性随访期4周的研究时期设置，以及安全性集按实际治疗分析的安排。医学作者需核对安全性评价在各研究访视中的具体实施安排。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_7693d868c98988a2","section_number":"8","source_ids":["protocol_full_draft_selection:17482aa685024937cb7ec314","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]},{"ai_run_id":"airun_20260922054244_8386f5ef","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究人群概述：确诊为斑块状银屑病、疾病严重程度为中重度的成人受试者。","quote_sha256":"a8e79e0e0422cd44b88dc3e21e985b80d8a582156f8af354719235edcd236224","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_001"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"安全性终点：治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件发生率。；实验室检查、生命体征及12导联心电图具有临床意义的变化。","quote_sha256":"99133b9298d6b094501b14430ac89a3b690a9aa9acb4bb1df325ea3196a44236","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_003"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"访视策略：筛选后于基线/第1天随机；第2、4、8、12、16周进行治疗期访视，第20周进行安全性随访。","quote_sha256":"63eabad83df6668ab707ddc556cc8da06b6cd29646215ef8e6dab242db644044","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_005"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"安全性集按实际治疗分析。","quote_sha256":"1268001c52aab5587c60c4485ee589055e72f4636f7ca620998567b780d17001","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"span_006"}],"evidence_span_ids":["span_001","span_003","span_005","span_006"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"heading":"总则","missing_source_classes":[],"proposal_text":"本研究为确证性III期临床研究，安全性评价旨在描述合成试验药A在成人中重度斑块状银屑病患者中的安全性特征。安全性终点为治疗期间出现的不良事件（TEAE）、严重不良事件及导致停药的不良事件的发生率，以及实验室检查、生命体征及12导联心电图具有临床意义的变化。安全性分析采用安全性集，按受试者实际接受的治疗进行分组；第20周安排安全性随访访视。","rationale":"支持依据为已确认的研究分期与内在研究目的、目标人群、安全性终点、安全性集分组方式及第20周安全性随访访视安排。医学作者需核对安全性评价的实施流程、评估时点与职责分工。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_384005122a9ff626","section_number":"8.1","source_ids":["protocol_full_draft_selection:17482aa685024937cb7ec314","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]},{"ai_run_id":"airun_20260922054244_8386f5ef","content_status":"source_gap","decision_items":[],"evidence_bindings":[],"evidence_span_ids":[],"evidence_summary":{"corpus_spans":0,"project_fact_spans":0},"heading":"定义","missing_source_classes":["不良事件、严重不良事件及可疑且非预期严重不良反应定义与判定标准的项目文件","不良事件与严重不良事件采集及报告流程文件","研究者手册或研究药物安全性参考资料"],"proposal_text":"","rationale":"现有来源列出了安全性终点，但未提供不良事件、严重不良事件及可疑且非预期严重不良反应的定义、判定标准与采集报告要求；该章节需在取得项目安全性管理文件与研究者手册等来源后由医学作者确认。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_893db0e17b2da155","section_number":"8.2","source_ids":["protocol_full_draft_selection:17482aa685024937cb7ec314","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914"]}],"source_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:17482aa685024937cb7ec314","source_id":"protocol_full_draft_selection:17482aa685024937cb7ec314","source_type":"protocol_full_draft_selection","text_sha256":"cea1dd8d5ff563ac02bcffc02ebbd03507d94f79f3eac5044fad9404a0e6aa36"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","source_type":"current_project_study_definition","text_sha256":"787313a6f081b1c9afdf03800feb1c50c317aa4aa4f0c3884e924b0594e666da"}]}