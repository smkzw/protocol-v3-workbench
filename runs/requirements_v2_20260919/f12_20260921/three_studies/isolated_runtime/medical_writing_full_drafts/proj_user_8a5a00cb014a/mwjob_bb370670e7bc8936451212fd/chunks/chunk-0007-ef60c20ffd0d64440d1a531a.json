bddcff0","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es-def-dosing-a"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"匹配安慰剂：每日一次（QD）（口服）；第1天至第16周双盲治疗期。依从：通过药品计数及受试者日记评价依从性","quote_sha256":"6e161fdc710a0a80dfd37e8087ba89849d7bfdb2aa6b1f8d9a2466c304e8fae9","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es-def-dosing-b"}],"evidence_span_ids":["es-sel-61","es-def-type","es-def-intervention","es-def-dosing-a","es-def-dosing-b"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":4},"heading":"试验用药品","missing_source_classes":[],"proposal_text":"本研究设置的试验用药品为合成试验药A，并设置与合成试验药A匹配的安慰剂作为对照。合成试验药A为小分子药物，剂型为口服固体制剂，经口服途径给药，暴露范围为全身性。试验组给药方案为100 mg、每日一次（QD），自第1天至第16周连续给药；对照组受试者接受匹配安慰剂，每日一次（QD）口服，给药期与试验组相同。","rationale":"正文依据已确认研究事实：试验用药品为合成试验药A（小分子、口服固体制剂、口服给药、全身暴露），并设置匹配安慰剂对照；试验组给药方案为100 mg、每日一次、自第1天至第16周。医学作者需与研究者手册及药学资料核对药品名称、剂型、给药途径与给药方案的一致性，并复核本章与6.1.1之间的内容分工。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_fc00c21a15e837a8","section_number":"6.1","source_ids":["protocol_full_draft_selection:ef60c20ffd0d64440d1a531a","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","company_corpus:cms_cn_protocol_corpus_20260715_v1:6b24da94f33534","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb9c14bf455dec","company_corpus:cms_cn_protocol_corpus_20260715_v1:6eab08a4bddb3d","company_corpus:cms_cn_protocol_corpus_20260715_v1:f24b1a78f9c3f8"]},{"ai_run_id":"airun_20260922053132_a70608b0","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:ef60c20ffd0d64440d1a531a","quote":"SECTION_ID=mwsec_greenfield_proj_user_8a5a00cb014a_469d7df8436f