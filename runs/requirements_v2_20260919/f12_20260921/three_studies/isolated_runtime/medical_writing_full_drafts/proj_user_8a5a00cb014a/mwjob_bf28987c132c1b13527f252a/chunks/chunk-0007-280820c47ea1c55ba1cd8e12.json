{"ai_run_id":"airun_20260921215707_f967188d","chunk_index":7,"job_id":"mwjob_bf28987c132c1b13527f252a","precondition_digest":"67d537499c47fe4ae0d786ec4ac18714b2af7d64fc584e8f1b34e1d9f712899a","project_id":"proj_user_8a5a00cb014a","schema_version":"protocol_full_draft_chunk_v5","section_ids":["mwsec_greenfield_proj_user_8a5a00cb014a_fc00c21a15e837a8","mwsec_greenfield_proj_user_8a5a00cb014a_469d7df8436fa4a2","mwsec_greenfield_proj_user_8a5a00cb014a_503d4369748f76ae","mwsec_greenfield_proj_user_8a5a00cb014a_5cffa5a750f97bfc"],"sections":[{"ai_run_id":"airun_20260921215707_f967188d","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"试验药物：合成试验药A","quote_sha256":"440dfb2db7c1171034de6b03458950cfe5fe614603e9413d729b90a6de1aa1a4","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"esp_002"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"试验干预：试验组接受合成试验药A 100 mg口服，每日一次，连续16周；对照组接受匹配安慰剂。","quote_sha256":"f3eff5ef57b4691ff025db695140e4ead682562786c0dec621edcd256ef28af3","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"esp_008"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"剂量与给药方案：合成试验药A：100 mg，每日一次（QD）（口服）；第1天至第16周。依从：通过药品计数及受试者日记评价依从性","quote_sha256":"e97da70f0c9a5d6f604a29b6c054d0ed03fc9fd60470293f55ab4afbebddcff0","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"esp_009"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"匹配安慰剂：每日一次（QD）（口服）；第1天至第16周双盲治疗期。依从：通过药品计数及受试者日记评价依从性","quote_sha256":"6e161fdc710a0a80dfd37e8087ba89849d7bfdb2aa6b1f8d9a2466c304e8fae9","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"esp_010"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"总体研究设计：平行组（parallel assignment）、双盲、安慰剂对照、随机","quote_sha256":"671a62a354113705569b311f82cdff13e6dc35ab5faac84b8993f18ac7fe7ebc","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"esp_011"},{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:280820c47ea1c55ba1cd8e12","quote":"章节编号=6.1\n章节标题=试验用药品\n章节类型=section\n当前正文=合成试验药A","quote_sha256":"552478800b6360c7170183bc78a328ff1f5bfd9220c22c1e7579fabe6e1d8fa7","source_id":"protocol_full_draft_selection:280820c47ea1c55ba1cd8e12","span_id":"esp_013"}],"evidence_span_ids":["esp_002","esp_008","esp_009","esp_010","esp_011","esp_013"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":5},"heading":"试验用药品","missing_source_classes":[],"proposal_text":"本研究的试验用药品为合成试验药A，对照药品为与试验药匹配的安慰剂。合成试验药A的给药剂量为100 mg，每日一次（QD），经口服给药，给药期间为第1天至第16周；匹配安慰剂同样经口服给药，每日一次（QD），于第1天至第16周的双盲治疗期内使用。研究期间，试验用药品的储存、发放、回收与清点应保证药品质量稳定和流转可追溯，并避免对双盲设计造成影响。","rationale":"正文仅采用已确认研究事实：试验用药品为合成试验药A，100 mg、每日一次、口服，给药期间为第1天至第16周；对照为匹配的安慰剂，同一给药频率，用于16周双盲治疗期。医学作者需核对：试验药与安慰剂的规格表述及供应包装形式是否与药学资料一致。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_fc00c21a15e837a8","section_number":"6.1","source_ids":["protocol_full_draft_selection:280820c47ea1c55ba1cd8e12","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","company_corpus:cms_cn_protocol_corpus_20260715_v1:6b24da94f33534","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb9c14bf455dec","company_corpus:cms_cn_protocol_corpus_20260715_v1:6eab08a4bddb3d","company_corpus:cms_cn_protocol_corpus_20260715_v1:f24b1a78f9c3f8"]},{"ai_run_id":"airun_20260921215707_f967188d","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"适应症：成人中重度斑块状银屑病","quote_sha256":"dea7d22754107be0e06f2a8925034c9cf46e7a270521c79bf1c536d94b1cb3ae","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"esp_003"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究分期：III期","quote_sha256":"5ac919b18530a35e6df200dbf04b4bc9fbd8d00da2c279aa58a1ff849584b451","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"esp_004"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"药物技术类型：small_molecule","quote_sha256":"d8ca21a7e62cbca0e65228c7147e2ce5e59273b60f0d0cc55ed216f48e27710c","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"esp_005"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"给药途径：口服","quote_sha256":"404b058b755608a73d13b54521a28c02b129df449774d0671b1c3f8b8a5ce42c","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"esp_006"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"剂型：口服固体制剂","quote_sha256":"2c22ee80756bfd178af43cee3c8a0a1b4058aaecb83d264b4107972a334b5bf4","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"esp_007"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"试验干预：试验组接受合成试验药A 100 mg口服，每日一次，连续16周；对照组接受匹配安慰剂。","quote_sha256":"f3eff5ef57b4691ff025db695140e4ead682562786c0dec621edcd256ef28af3","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"esp_008"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"剂量与给药方案：合成试验药A：100 mg，每日一次（QD）（口服）；第1天至第16周。依从：通过药品计数及受试者日记评价依从性","quote_sha256":"e97da70f0c9a5d6f604a29b6c054d0ed03fc9fd60470293f55ab4afbebddcff0","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"esp_009"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"匹配安慰剂：每日一次（QD）（口服）；第1天至第16周双盲治疗期。依从：通过药品计数及受试者日记评价依从性","quote_sha256":"6e161fdc710a0a80dfd37e8087ba89849d7bfdb2aa6b1f8d9a2466c304e8fae9","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"esp_010"},{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:280820c47ea1c55ba1cd8e12","quote":"章节编号=6.1.1\n章节标题=研究药物信息\n章节类型=section","quote_sha256":"62d9456efea0a19629547d49c4fdc4ec400beeaf1fa236c1d5c223ad87822b0e","source_id":"protocol_full_draft_selection:280820c47ea1c55ba1cd8e12","span_id":"esp_014"}],"evidence_span_ids":["esp_003","esp_004","esp_005","esp_006","esp_007","esp_008","esp_009","esp_010","esp_014"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":8},"heading":"研究药物信息","missing_source_classes":[],"proposal_text":"合成试验药A为本研究的研究药物，为小分子药物，剂型为口服固体制剂，经口服途径给药并产生系统性暴露。其给药方案为100 mg、每日一次（QD），给药期间为第1天至第16周。本研究的对照药品为与合成试验药A匹配的安慰剂，经口服给药，每日一次（QD），在为期16周的双盲治疗期内与试验药同步使用。合成试验药A用于成人中重度斑块状银屑病的治疗，本研究为III期临床研究。","rationale":"正文直接采用已确认事实：研究药物名称、适应症（成人中重度斑块状银屑病）、分期（III期）、技术类型（小分子）、剂型（口服固体制剂）、给药途径（口服）、系统性暴露、剂量与频率（100 mg、每日一次）及给药期间（第1天至第16周），并说明匹配安慰剂的口服给药与同期使用。医学作者需核对：药物规格命名、安慰剂描述方式，以及是否需依据药学资料补充成分或作用机制表述。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_469d7df8436fa4a2","section_number":"6.1.1","source_ids":["protocol_full_draft_selection:280820c47ea1c55ba1cd8e12","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","company_corpus:cms_cn_protocol_corpus_20260715_v1:6b24da94f33534","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb9c14bf455dec","company_corpus:cms_cn_protocol_corpus_20260715_v1:6eab08a4bddb3d","company_corpus:cms_cn_protocol_corpus_20260715_v1:f24b1a78f9c3f8"]},{"ai_run_id":"airun_20260921215707_f967188d","content_status":"decision_required","decision_items":[{"blocking_section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_503d4369748f76ae","fact_path":"framing.product_profile.dosage_forms","options":[{"label":"按稳定性资料确定储存条件与有效期","option_id":"opt_stability_based","summary":"依据药物稳定性研究资料确定温度、湿度等储存条件及有效期，并在方案中写明具体参数与超限处置原则。"},{"label":"以药品标签标示条件为准","option_id":"opt_label_based","summary":"方案不列具体参数，统一以试验用药品标签标示的储存条件与有效期为准，由研究中心按标签执行并记录。"},{"label":"引用药品管理文件规定","option_id":"opt_manual_reference","summary":"在方案中引用试验用药品管理手册或相应药品管理文件，由该文件规定储存条件、有效期及超限处置。"}],"question":"合成试验药A（口服固体制剂）在研究中心内的储存条件与有效期管理应如何在方案中规定？","rationale":"已确认本品为口服固体制剂、经口服给药，但现有项目事实未给出储存条件、有效期及超限处置参数；该项直接影响药品质量与受试者安全，属需项目层面确认的实施规则，不在正文中预设。","recommended_option_id":"opt_stability_based"},{"blocking_section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_503d4369748f76ae","fact_path":"design.blinding","options":[{"label":"包装与标签完全一致","option_id":"opt_uniform_packaging","summary":"试验药与安慰剂采用相同包装形式、标签样式与文字，除盲底编盲信息外外观不可区分，以维持双盲。"},{"label":"标签一致、包装规格按需设定","option_id":"opt_label_identical","summary":"标签样式与信息保持一致，包装规格可按剂量或供应需要分别设定，但外观不得提示分组。"},{"label":"由包装与标签文件统一规定","option_id":"opt_sponsor_document","summary":"一致性要求由申办者包装与标签文件规定，方案仅提出维持盲态的目的性要求。"}],"question":"试验药与匹配安慰剂的包装与标签一致性要求应如何规定？","rationale":"本研究为双盲、匹配安慰剂对照设计，包装与标签一致性直接影响盲态维持；现有项目事实未规定其实现方式，故列为需项目层面确认的事项而非既定要求。","recommended_option_id":"opt_uniform_packaging"}],"evidence_bindings":[{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"剂型：口服固体制剂","quote_sha256":"2c22ee80756bfd178af43cee3c8a0a1b4058aaecb83d264b4107972a334b5bf4","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"esp_007"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"总体研究设计：平行组（parallel assignment）、双盲、安慰剂对照、随机","quote_sha256":"671a62a354113705569b311f82cdff13e6dc35ab5faac84b8993f18ac7fe7ebc","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"esp_011"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"对照措施：匹配安慰剂","quote_sha256":"1cafd7b3b8755010d178eb3fa7d8660de3d2c9f3a15eedfd1f8bbf4194f91a9b","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"esp_012"},{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:280820c47ea1c55ba1cd8e12","quote":"章节编号=6.1.2\n章节标题=制备、包装、标签、储存与管理\n章节类型=section","quote_sha256":"8af5b4b48e67d2bb5d9b1e18608a32e4142c7985eb1537dc8be739ffdb0d5a65","source_id":"protocol_full_draft_selection:280820c47ea1c55ba1cd8e12","span_id":"esp_015"},{"locator":"section:IMP的储存、管理与发放|block:483|chunk:1","quote":"研究中心收到IMP，核实无误后签署药物接收单和药物出入库记录单。IMP要求按规定的贮存条件保存。","quote_sha256":"738974884e97c974b97a8c5620183331113e58eb03c78f31a55dd1436045e293","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:f24b1a78f9c3f8","span_id":"esp_017"}],"evidence_span_ids":["esp_007","esp_011","esp_012","esp_015","esp_017"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":3},"heading":"制备、包装、标签、储存与管理","missing_source_classes":[],"proposal_text":"本章节说明合成试验药A及其匹配安慰剂在研究期间的制备、包装、标签、储存与管理要求。合成试验药A为口服固体制剂，本研究采用双盲、安慰剂对照设计，试验用药品与匹配安慰剂的包装和标签应能够支持双盲实施，并满足研究中心对试验用药品进行识别、储存和管理的需要。试验用药品在研究中心内应存放于适宜条件，保证药品质量稳定并防止环境因素产生不利影响，所用储存条件应与其口服固体制剂的特性相适应。试验用药品的接收与储存等环节应保持完整记录，以保证试验期间药品流转可追溯。","rationale":"正文采用已确认事实：合成试验药A为口服固体制剂，研究采用双盲、匹配安慰剂对照设计，据此提出包装与标签应支持双盲实施、储存应保证药品质量稳定的目的性要求，并说明接收与储存记录应保持完整；上述表述不含具体参数、时限与角色分工。接收与储存记录的结构性表述参照既往方案文件，仅作结构参照。医学作者需核对：储存条件与有效期管理、包装规格与标签具体内容、药品处置安排，以及需项目层面确认的储存条件与有效期管理、包装与标签一致性实现方式的最终选择。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_503d4369748f76ae","section_number":"6.1.2","source_ids":["protocol_full_draft_selection:280820c47ea1c55ba1cd8e12","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","company_corpus:cms_cn_protocol_corpus_20260715_v1:6b24da94f33534","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb9c14bf455dec","company_corpus:cms_cn_protocol_corpus_20260715_v1:6eab08a4bddb3d","company_corpus:cms_cn_protocol_corpus_20260715_v1:f24b1a78f9c3f8"]},{"ai_run_id":"airun_20260921215707_f967188d","content_status":"complete","decision_items":[],"evidence_bindings":[{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"剂量与给药方案：合成试验药A：100 mg，每日一次（QD）（口服）；第1天至第16周。依从：通过药品计数及受试者日记评价依从性","quote_sha256":"e97da70f0c9a5d6f604a29b6c054d0ed03fc9fd60470293f55ab4afbebddcff0","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"esp_009"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"匹配安慰剂：每日一次（QD）（口服）；第1天至第16周双盲治疗期。依从：通过药品计数及受试者日记评价依从性","quote_sha256":"6e161fdc710a0a80dfd37e8087ba89849d7bfdb2aa6b1f8d9a2466c304e8fae9","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"esp_010"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"总体研究设计：平行组（parallel assignment）、双盲、安慰剂对照、随机","quote_sha256":"671a62a354113705569b311f82cdff13e6dc35ab5faac84b8993f18ac7fe7ebc","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"esp_011"},{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:280820c47ea1c55ba1cd8e12","quote":"章节编号=6.1.3\n章节标题=发放、回收与清点\n章节类型=section","quote_sha256":"51ed39ef2cc788c50248f398a1e6015d4ccd53e0165997318a048a35f9541630","source_id":"protocol_full_draft_selection:280820c47ea1c55ba1cd8e12","span_id":"esp_016"},{"locator":"section:表3. 研究药物给药方案|block:478|chunk:1","quote":"每一份药物的发放及回收均应在专门记录单上及时记录。","quote_sha256":"5ea3e8a88632ca17af43501e9bd9fdd56ead29195b87adf184cfe7715dbb0d31","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:6eab08a4bddb3d","span_id":"esp_018"}],"evidence_span_ids":["esp_009","esp_010","esp_011","esp_016","esp_018"],"evidence_summary":{"corpus_spans":1,"project_fact_spans":3},"heading":"发放、回收与清点","missing_source_classes":[],"proposal_text":"试验用药品的发放、回收与清点应支持双盲设计的实施，并在试验期间保持药品流转的可追溯性。受试者的用药依从性通过药品计数并结合受试者日记进行评价，回收药品的计数结果应与发放记录相互核对，以支持依从性评价的完整与可靠。试验用药品的发放与回收过程应保持记录；回收的药品应单独管理，不得再次发放给受试者，其后续处理应符合临床试验用药品管理的适用要求。","rationale":"正文依据已确认事实：受试者用药依从性通过药品计数及受试者日记评价，且研究为双盲设计，据此说明发放、回收与清点需保持可追溯并支持盲态。发放与回收记录要求仅为结构性通用表述，未引入其他项目的系统、表单或职责安排。医学作者需核对：回收药品的处置、记录表格与职责划分及清点差异的处理方式。","review_advisories":[],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_5cffa5a750f97bfc","section_number":"6.1.3","source_ids":["protocol_full_draft_selection:280820c47ea1c55ba1cd8e12","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","company_corpus:cms_cn_protocol_corpus_20260715_v1:6b24da94f33534","company_corpus:cms_cn_protocol_corpus_20260715_v1:bb9c14bf455dec","company_corpus:cms_cn_protocol_corpus_20260715_v1:6eab08a4bddb3d","company_corpus:cms_cn_protocol_corpus_20260715_v1:f24b1a78f9c3f8"]}],"source_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:280820c47ea1c55ba1cd8e12","source_id":"protocol_full_draft_selection:280820c47ea1c55ba1cd8e12","source_type":"protocol_full_draft_selection","text_sha256":"f89e31a51efcb308010497c7200dc062518355307a7be411059d582b784eec16"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","source_type":"current_project_study_definition","text_sha256":"787313a6f081b1c9afdf03800feb1c50c317aa4aa4f0c3884e924b0594e666da"},{"locator":"section:研究者签字页|block:32|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:544d5795fdc791","source_type":"company_protocol_reference_corpus","text_sha256":"9d5bb308153441df0cf0a282e48e71b5918f97f81ec06babdf8e969557541291"},{"locator":"section:5. AD 部位拍照：将在预设访视点对受试者 AD 皮损部位进行拍照，具体拍摄要求详见《特应性皮炎皮损部位拍照流程及要求》。如受试者因特殊情况|block:225|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:6b24da94f33534","source_type":"company_protocol_reference_corpus","text_sha256":"5b666f365d97c08cc0b89f4385d4c2eae4c9a88144f60a3b1524e66c86391897"},{"locator":"section:治疗药物|block:103|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:bb9c14bf455dec","source_type":"company_protocol_reference_corpus","text_sha256":"7375ac7241c2627eeb54b287a15f75832e33a6fc655f40545738b9f13c31a384"},{"locator":"section:表3. 研究药物给药方案|block:478|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:6eab08a4bddb3d","source_type":"company_protocol_reference_corpus","text_sha256":"397548cdd2222ca606599d07a45451fb1f6330b576d8c186d50126d7e8737a90"},{"locator":"section:IMP的储存、管理与发放|block:483|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:f24b1a78f9c3f8","source_type":"company_protocol_reference_corpus","text_sha256":"6bd1543fac3d184ef68f0f4e5c2eb8c382829bbbefe6cce8f9627ca1008b66cb"}]}