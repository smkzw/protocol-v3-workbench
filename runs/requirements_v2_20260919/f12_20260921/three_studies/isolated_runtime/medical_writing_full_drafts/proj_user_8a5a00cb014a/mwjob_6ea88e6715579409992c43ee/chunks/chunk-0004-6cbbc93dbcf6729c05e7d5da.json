ef9a6db54129aefdb157084e23f8cc6b089099b16a"},{"locator":"section:6.3.3 揭盲|block:490|chunk:1","source_id":"company_corpus:cms_cn_protocol_corpus_20260715_v1:dbed66cc1d7b3a","source_type":"company_protocol_reference_corpus","text_sha256":"561c757e6967fae66f0f9d1043dba3e313bd0ee60a03f2c3c8da5efe892b0128"}]}