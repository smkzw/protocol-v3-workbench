9d5932b5271d28b4bcce906ff03ae3a5294d59ff9147c","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_pj_age"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"研究时期：筛选期：最长4周。；双盲治疗期：16周。；安全性随访期：4周。","quote_sha256":"1df9f3c36a7060d2c1dfbc24b66dd9be14f4efacd4868bd85df3940f627371af","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_pj_periods"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"访视策略：筛选后于基线/第1天随机；第2、4、8、12、16周进行治疗期访视，第20周进行安全性随访。PASI和sPGA于基线及第4、8、12、16周评价。","quote_sha256":"8c7a570d51b842be51c8689066b3d6fe50030b8229d96708644c920d085e82c5","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_pj_visits"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"依从：通过药品计数及受试者日记评价依从性","quote_sha256":"bae98d5756fc33d2dec389859c413b44261174683ee2abd68620571e65357c06","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_pj_adherence"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"期中分析是否计划：否","quote_sha256":"31ef70e7f5cd03d6c17b90802e7352c6e81b5fdc853989b74ea1499901f514a4","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_pj_no_interim"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"样本量再估计是否计划：否","quote_sha256":"913a62236e4f4332a7188562f2625d53aa7f770cea155664564c5fb821a98efd","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_pj_no_ssr"},{"locator":"study_definition:mwdefinition_1ded2281210281a3b8a0:revision:8","quote":"共计划入组132例（每组66例）","quote_sha256":"fd9422f6d86f966c3368aabe8f3e00ebb2476b6a1f09850f633e4d0184eea278","source_id":"current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","span_id":"es_pj_sample"}],"evidence_span_ids":["es_sec_12","es_pj_phase","es_pj_area","es_pj_multicenter","es_pj_population","es_pj_age","es_pj_periods","es_pj_visits","es_pj_adherence","es_pj_no_interim","es_pj_no_ssr","es_pj_sample"],"evidence_summary":{"corpus_spans":0,"project_fact_spans":11},"heading":"研究文件、监查和管理","missing_source_classes":[],"proposal_text":"本研究为在中国开展的多中心III期临床研究，计划入组132例（每组66例）成人中重度斑块状银屑病受试者。研究实施期间涵盖筛选期（最长4周）、治疗期（16周）和安全性随访期（4周）；受试者于基线/第1天、第2、4、8、12、16周进行访视，并在第20周进行安全性随访，PASI和sPGA于基线及第4、8、12、16周评价；研究期间通过药品计数及受试者日记评价依从性。本研究的文件与监查管理工作涵盖研究方案及其修订版本、研究者相关文件、源数据与源文件以及上述访视和依从性评价记录等研究文件的构成与管理，多中心研究实施中的监查目的、监查内容与监查记录管理，以及研究过程中管理沟通与问题处理的安排。本研究不计划开展期中分析，也不计划进行样本量再估计，研究文件与监查工作围绕研究启动、实施和结束的完整过程开展。","rationale":"依据已确认研究设计信息：多中心、计划入组132例（每组66例）、筛选期最长4周、治疗期16周、安全性随访期4周、第2/4/8/12/16周治疗期访视、第20周安全性随访、PASI与sPGA于基线及第4/8/12/16周评价、依从性通过药品计数及受试者日记评价、不开展期中分析、不进行样本量再估计。医学作者需核对：研究文件的构成与保存要求、源数据与源文件记录要求、监查的目的与实施安排，以及研究管理沟通机制。","review_advisories":["本节提及高影响设计信息（期中分析、样本量、计划入组）；系统未把重复提及升级为强制确认。"],"review_level":"standard","review_reasons":[],"section_id":"mwsec_greenfield_proj_user_8a5a00cb014a_df24f522766abc57","section_number":"12","source_ids":["protocol_full_draft_selection:87b90b572171e110cee6e00f","current_project_study_definition:mwdefinition_1ded2281210281a3b8a0:r8:3989470f61c21914","company_corpus:cms_cn_protocol_corpus_20260715_v1:2db65207908661","company_corpus:cms_cn_protocol_corpus_20260715_v1:72548c417a8f5c","company_corpus:cms_cn_protocol_corpus_20260715_v1:4e86a5ea954c95","company_corpus:cms_cn_protocol_corpus_20260715_v1:df064f51d3d147","company_corpus:cms_cn_protocol_corpus_20260715_v1:342cfc57d67b67"]}],"source_bindings":[{"locator":"document:mwdoc_greenfield_proj_user_8a5a00cb014a_d2ecb6f405c5f941:full-draft:87b90b572171e110cee6e00f","source_id":"protocol_full_draft_selection:87b90b572171e110cee6e00f","source_type":"protocol_full_draft_selection","text_sha256"